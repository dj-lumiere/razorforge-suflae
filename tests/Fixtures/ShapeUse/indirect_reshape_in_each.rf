module Tests/ShapeUse/IndirectReshapeInEach

# `grow` adds to the list the loop is visiting. The build cannot see it (the add is inside another
# routine), so the shape use the loop opens makes `add_last` crash with ReshapingWhileInUseError.

import IO/Console

routine grow(xs: Modifying[List[S64]])
  xs.add_last(value: 99)
  return

routine start()
  var nums = List[S64]()
  nums.add_last(value: 1)
  nums.add_last(value: 2)
  each x in nums
    show(f"visiting {x}")
    grow(xs: nums.modify())
  show("not reached")
  return
