module Tests/StdlibSf/PatternMatchingApi
import IO/Console

# `when` patterns: literal, type, range, else fallthrough, binding.
choice Color
  RED
  GREEN
  BLUE

routine classify(n: S64) -> Text
  when n
    == 0       => return "zero"
    < 0        => return "negative"
    > 100      => return "huge"
    else       => return "positive"

routine name_color(c: Color) -> Text
  when c
    is Color.RED   => return "red"
    is Color.GREEN => return "green"
    else           => return "blue"

routine start()
  show(classify(n: 0))
  show(classify(n: -5))
  show(classify(n: 50))
  show(classify(n: 200))

  show(name_color(c: Color.RED))
  show(name_color(c: Color.GREEN))
  show(name_color(c: Color.BLUE))

  # Pattern binding via `else v` form
  var m: Maybe[S64] = 42_s64
  when m
    is None => show("m is None")
    else v  => show(f"m bound: {v}")

  show("DONE")
  return
