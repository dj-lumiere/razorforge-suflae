module Tests/StdlibSf/BytesApi
import IO/Console
import BuilderQuery

routine start()
  var b = "hello".encode_as_utf8()
  show(f"b type: {b.type_name()}")
  show(f"b size: {b.count()}")
  show(f"b[0]: {b[0_u64]}")  # 'h' = 0x68 = 104
  show(f"b[4]: {b[4_u64]}")  # 'o' = 0x6f = 111

  # is_empty
  show(f"empty bytes is_empty: {"".encode_as_utf8().is_empty()}")

  show("DONE")
  return
