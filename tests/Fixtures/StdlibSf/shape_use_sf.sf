module Tests/StdlibSf/ShapeUseSf
import IO/Console

# Suflae containers are shared handles, so a change hidden behind a call cannot be traced at build time: an
# `each` loop marks its list's shape as in use and a change during the loop crashes at runtime
# (tests/Meta/ContainerShapeUseTests.cs). These are the paths that must NOT crash: a change after a loop,
# after `break`, and after a `return` out of a loop (the return closes the use).

routine first_big(xs: List[Integer]) -> Integer
  each x in xs
    if x > 5
      return x
  return 0

routine start()
  var nums = List[Integer]()
  nums.add_last(value: 1)
  nums.add_last(value: 7)
  var total = 0
  each x in nums
    total = total + x
  nums.add_last(value: 10)
  each x in nums
    if x == 7
      break
  nums.add_last(value: 11)
  var big = first_big(xs: nums)
  nums.add_last(value: 12)
  show(f"total={total} big={big} count={nums.count()}")
  show("DONE")
  return
