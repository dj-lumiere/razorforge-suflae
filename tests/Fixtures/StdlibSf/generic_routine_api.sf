module Tests/StdlibSf/GenericRoutineApi
import Numerics
import IO/Console

# Free generic functions with type constraints.

routine identity[T](x: T) -> T
  return x

routine min_of[T](a: T, b: T) -> T
needs T obeys Ordered
  if a < b
    return a
  return b

routine pair_eq[T](a: T, b: T) -> Bool
needs T obeys Equatable
  return a == b

routine start()
  # identity: same in, same out, different T's
  show(f"identity(42): {identity(x: 42_s64)}")
  show(f"identity(\"hi\"): {identity(x: "hi")}")
  show(f"identity(true): {identity(x: true)}")

  # min_of with ordered types
  show(f"min_of(3, 7): {min_of(a: 3_s64, b: 7_s64)}")
  show(f"min_of(1.5, 0.5): {min_of(a: 1.5_f64, b: 0.5_f64)}")
  show(f"min_of(\"abc\", \"abd\"): {min_of(a: "abc", b: "abd")}")

  # pair_eq across types
  show(f"pair_eq(1, 1): {pair_eq(a: 1_s64, b: 1_s64)}")
  show(f"pair_eq(1, 2): {pair_eq(a: 1_s64, b: 2_s64)}")
  show(f"pair_eq(\"x\", \"x\"): {pair_eq(a: "x", b: "x")}")

  show("DONE")
  return
