module Tests/StdlibSf/ChoiceApi
import IO/Console

choice Color
  RED
  GREEN
  BLUE

choice HttpStatus
  OK: 200
  NOT_FOUND: 404
  ERROR: 500

routine start()
  var c = Color.RED
  show(f"c: {c}")
  show(f"c (diagnose): {c:?}")
  show(f"c is RED: {c is Color.RED}")
  show(f"c is GREEN: {c is Color.GREEN}")
  show(f"c isnot BLUE: {c isnot Color.BLUE}")

  # Switching via when
  when c
    is Color.RED   => show("  matched RED")
    is Color.GREEN => show("  matched GREEN")
    else           => show("  matched BLUE")

  # Numeric-valued choice
  var s = HttpStatus.OK
  show(f"s: {s}")
  show(f"s == OK: {s is HttpStatus.OK}")

  show("DONE")
  return
