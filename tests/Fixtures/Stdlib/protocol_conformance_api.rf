module Tests/Stdlib/ProtocolConformanceApi
import IO/Console

# User-defined protocol + record conformance via `obeys`.
protocol Greetable
  routine Me.greet() -> Text

record Cat obeys Greetable, Equatable
  name: Text

routine Cat.greet() -> Text
  return "Meow, I am " + me.name

routine Cat.eq(you: Cat) -> Bool
  return me.name == you.name

record Dog obeys Greetable
  name: Text

routine Dog.greet() -> Text
  return "Woof, I am " + me.name

# Generic free function constrained by the protocol.
routine introduce[T](thing: T) -> Text
needs T obeys Greetable
  return thing.greet()

routine start()
  var c = Cat(name: "Whiskers")
  var d = Dog(name: "Rex")

  show(c.greet())
  show(d.greet())

  # Protocol-constrained generic
  show(introduce(thing: c))
  show(introduce(thing: d))

  # Equality via the record's hand-written eq (records don't auto-derive Equatable)
  var c2 = Cat(name: "Whiskers")
  show(f"c == c2: {c == c2}")
  var c3 = Cat(name: "Felix")
  show(f"c == c3: {c == c3}")

  show("DONE")
  return
