module Tests/Stdlib/ChoiceApi
import IO/Console

choice Color
  RED
  GREEN
  BLUE

choice HttpStatus
  OK: 200
  NOT_FOUND: 404
  ERROR: 500

routine start()
  var c = Color.RED
  show(f"c: {c}")
  show(f"c (diagnose): {c:?}")
  show(f"c == RED: {c == Color.RED}")
  show(f"c == GREEN: {c == Color.GREEN}")
  show(f"c != BLUE: {c != Color.BLUE}")

  # Switching via when
  when c
    is Color.RED   => show("  matched RED")
    is Color.GREEN => show("  matched GREEN")
    else           => show("  matched BLUE")

  # Numeric-valued choice
  var s = HttpStatus.OK
  show(f"s: {s}")
  show(f"s == OK: {s == HttpStatus.OK}")

  show("DONE")
  return
