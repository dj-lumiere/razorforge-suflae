module Tests/Stdlib/FastIoApi
import IO/Console
import IO/BytesIO

# Bytes-direct integer parsing + formatting (FastIO). Bypasses Text and the
# UTF-8↔UTF-32 roundtrip. Critical for CP-style stdin/stdout.
# All FastIO routines are `!` (in-range narrowing inside `to_digit_bytes!`);
# happy-path calls use `!!` to force-unwrap, error paths go through `try_*`.

routine start()
  # --- S64 parse: happy paths ---
  show(f"parse '42': {try_S64_from_digit_bytes(bytes: "42".bytes()) !!}")
  show(f"parse '-42': {try_S64_from_digit_bytes(bytes: "-42".bytes()) !!}")
  show(f"parse '+42': {try_S64_from_digit_bytes(bytes: "+42".bytes()) !!}")
  show(f"parse '0': {try_S64_from_digit_bytes(bytes: "0".bytes()) !!}")
  show(f"parse '1234567890': {try_S64_from_digit_bytes(bytes: "1234567890".bytes()) !!}")

  # Leading whitespace
  show(f"parse '   42': {try_S64_from_digit_bytes(bytes: "   42".bytes()) !!}")
  show(f"parse '\\t-7': {try_S64_from_digit_bytes(bytes: "\t-7".bytes()) !!}")

  # Lenient: stops at first non-digit, doesn't fail
  show(f"parse '42abc' (stops at 'a'): {try_S64_from_digit_bytes(bytes: "42abc".bytes()) !!}")
  show(f"parse '42 99' (stops at ' '): {try_S64_from_digit_bytes(bytes: "42 99".bytes()) !!}")

  # --- S64 parse failures ---
  show(f"try empty: {try_S64_from_digit_bytes(bytes: "".bytes())}")
  show(f"try 'abc': {try_S64_from_digit_bytes(bytes: "abc".bytes())}")
  show(f"try '+': {try_S64_from_digit_bytes(bytes: "+".bytes())}")
  show(f"try '   ': {try_S64_from_digit_bytes(bytes: "   ".bytes())}")

  # --- Streaming parse (from_digit_bytes_at) ---
  var stream = "10 20 -30 40".bytes()
  var i: U64 = 0_u64
  var sum: S64 = 0_s64
  loop
    var t = try_S64_from_digit_bytes_at(bytes: stream, start: i)
    when t
      is None => break
      else pair =>
        sum = sum + pair.f0
        i = pair.f1
  show(f"streaming sum: {sum}")

  # --- to_digit_bytes (formatting) ---
  show(f"format 0: {try_to_digit_bytes_s64(v: S64(0)) !!}")
  show(f"format 42: {try_to_digit_bytes_s64(v: S64(42)) !!}")
  show(f"format -42: {try_to_digit_bytes_s64(v: S64(-42)) !!}")
  show(f"format S64_MIN: {try_to_digit_bytes_s64(v: S64_MIN) !!}")
  show(f"format S64_MAX: {try_to_digit_bytes_s64(v: S64_MAX) !!}")

  # --- U64 ---
  show(f"U64 parse '42': {try_U64_from_digit_bytes(bytes: "42".bytes()) !!}")
  show(f"U64 parse '+42': {try_U64_from_digit_bytes(bytes: "+42".bytes()) !!}")
  show(f"U64 try '-42' (must fail): {try_U64_from_digit_bytes(bytes: "-42".bytes())}")

  show(f"U64 format 0: {try_to_digit_bytes_u64(v: U64(0)) !!}")
  show(f"U64 format U64_MAX: {try_to_digit_bytes_u64(v: U64_MAX) !!}")

  # --- Round-trip property: parse(format(x)) == x for many values ---
  var ok = true
  for x in -100 to 100
    var bytes_opt = try_to_digit_bytes_s64(v: S64(from: x))
    when bytes_opt
      is None => ok = false
      else b =>
        var parsed_opt = try_S64_from_digit_bytes(bytes: b)
        when parsed_opt
          is None => ok = false
          else parsed =>
            if parsed != S64(from: x)
              ok = false
  show(f"S64 round-trip [-100..100]: {ok}")

  show("DONE")
  return

# Helpers so we can call the failable `to_digit_bytes!` from a non-failable
# routine via the auto-generated `try_*` variant.
routine to_digit_bytes_s64!(v: S64) -> Owned[Bytes]
  return v.to_digit_bytes!()

routine to_digit_bytes_u64!(v: U64) -> Owned[Bytes]
  return v.to_digit_bytes!()
