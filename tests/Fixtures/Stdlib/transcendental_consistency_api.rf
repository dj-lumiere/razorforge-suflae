module Tests/Stdlib/TranscendentalConsistencyApi

import IO/Console

# Cross-platform consistency check for the software F128/D64 transcendentals. These are pure
# integer softfloat (the UnpackedFloat engine — no libm, no long double), so EVERY platform must
# produce identical bits. On macOS/ARM64 some paths (exp/log/cos) currently diverge to NaN; this
# fixture surfaces the exact divergent set in CI (the macOS job's failure diff pinpoints which
# engine functions break), and becomes a permanent regression guard once the ARM bug is fixed.

routine start()
  var x1 = 1.0_f128
  var x2 = 2.0_f128
  show(f"f128 sqrt(2)  : {x2.sqrt_unchecked().$represent()}")
  show(f"f128 cbrt(2)  : {x2.cbrt().$represent()}")
  show(f"f128 sin(1)   : {x1.sin().$represent()}")
  show(f"f128 cos(1)   : {x1.cos().$represent()}")
  show(f"f128 tan(1)   : {x1.tan().$represent()}")
  show(f"f128 exp(1)   : {x1.exp_unchecked().$represent()}")
  show(f"f128 exp2(1)  : {x1.exp2_unchecked().$represent()}")
  show(f"f128 log(2)   : {x2.log_unchecked().$represent()}")
  show(f"f128 log2(2)  : {x2.log2_unchecked().$represent()}")
  show(f"f128 atan(1)  : {x1.atan().$represent()}")
  show(f"f128 sinh(1)  : {x1.sinh_unchecked().$represent()}")
  show(f"f128 cosh(1)  : {x1.cosh_unchecked().$represent()}")
  show(f"f128 asinh(1) : {x1.asinh().$represent()}")
  show(f"d64  sin(1)   : {(1.0_d64).sin().$represent()}")
  show(f"d64  cos(1)   : {(1.0_d64).cos().$represent()}")
  show(f"d64  exp(1)   : {(1.0_d64).exp_unchecked().$represent()}")
  return
