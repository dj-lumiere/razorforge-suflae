module Tests/Stdlib/TcheckF512Engine

import IO/Console

# Merged direct U512-engine regressions (was tcheck_f512_{sub_pp,sub_nn,add_nn,mul_nn,neg};
# consolidated post-fix). a=9876, b=1234 shared across all ops.
routine start()
  var a = UnpackedFloat[U512, U1024, 512].from_s64(src: 9876_s64)
  var b = UnpackedFloat[U512, U1024, 512].from_s64(src: 1234_s64)
  show(a.sub(you: b).to_f512a().to_bits())
  show(a.neg().sub(you: b.neg()).to_f512a().to_bits())
  show(a.neg().add(you: b.neg()).to_f512a().to_bits())
  show(a.neg().mul(you: b.neg()).to_f512a().to_bits())
  show(a.neg().to_f512a().to_bits())
  return
