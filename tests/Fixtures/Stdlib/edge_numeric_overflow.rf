module Tests/Stdlib/EdgeNumericOverflow
import IO/Console

# Boundary values for fixed-width integers. Wrap-arithmetic operators (add_wrap)
# expose unchecked wrap; default `+` on integer types is checked / clamping per spec.
routine start()
  # S8 boundaries: [-128, 127]
  show(f"S8 max: {127_s8}")
  show(f"S8 min: {-128_s8}")
  show(f"S8 max + 1 (wrap): {127_s8.add_wrap(you: 1_s8)}")
  show(f"S8 min - 1 (wrap): {(-128_s8).sub_wrap(you: 1_s8)}")

  # U8 boundaries: [0, 255]
  show(f"U8 max: {255_u8}")
  show(f"U8 min: {0_u8}")
  show(f"U8 max + 1 (wrap): {255_u8.add_wrap(you: 1_u8)}")
  show(f"U8 0 - 1 (wrap): {0_u8.sub_wrap(you: 1_u8)}")

  # S64 boundaries
  show(f"S64 max + 1 (wrap): {9_223_372_036_854_775_807_s64.add_wrap(you: 1_s64)}")

  # U64 boundaries
  show(f"U64 max: {18_446_744_073_709_551_615_u64}")
  show(f"U64 0 - 1 (wrap): {0_u64.sub_wrap(you: 1_u64)}")

  show("DONE")
  return
