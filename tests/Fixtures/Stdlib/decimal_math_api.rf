module Tests/Stdlib/DecimalMathApi
import IO/Console

# Decimal transcendentals are correctly rounded via tiered TLFloat routing:
# D32 -> binary64, D64 -> quad, D128 -> octuple. Each intermediate's slack
# dwarfs the target's precision, so results are exact to the last decimal
# digit and byte-identical across platforms.

routine start()
  var one32 = 1.0_d32
  var half32 = 0.5_d32
  var two32 = 2.0_d32
  var ten32 = 10.0_d32
  var eight32 = 8.0_d32
  var cube32 = 27.0_d32
  var three32 = 3.0_d32
  var four32 = 4.0_d32
  show(f"d32 sin(1): {one32.sin()}")
  show(f"d32 cos(1): {one32.cos()}")
  show(f"d32 tan(1): {one32.tan()}")
  show(f"d32 asin(0.5): {half32.asin()}")
  show(f"d32 acos(0.5): {half32.acos()}")
  show(f"d32 atan(1): {one32.atan()}")
  show(f"d32 atan2(1,1): {one32.atan2(x: one32)}")
  show(f"d32 sinh(1): {one32.sinh()}")
  show(f"d32 cosh(1): {one32.cosh()}")
  show(f"d32 tanh(1): {one32.tanh()}")
  show(f"d32 asinh(1): {one32.asinh()}")
  show(f"d32 acosh(2): {two32.acosh()}")
  show(f"d32 atanh(0.5): {half32.atanh()}")
  show(f"d32 exp(1): {one32.exp()}")
  show(f"d32 exp2(10): {ten32.exp2()}")
  show(f"d32 expm1(0.5): {half32.expm1()}")
  show(f"d32 log(10): {ten32.log()}")
  show(f"d32 log2(8): {eight32.log2()}")
  show(f"d32 log10(2): {two32.log10()}")
  show(f"d32 log1p(0.5): {half32.log1p()}")
  show(f"d32 pow(2,10): {two32 ** ten32}")
  show(f"d32 cbrt(27): {cube32.cbrt()}")
  show(f"d32 hypot(3,4): {three32.hypot(you: four32)}")
  show(f"d32 sqrt(2): {two32.sqrt()}")

  var one64 = 1.0_d64
  var half64 = 0.5_d64
  var two64 = 2.0_d64
  var ten64 = 10.0_d64
  var eight64 = 8.0_d64
  var cube64 = 27.0_d64
  var three64 = 3.0_d64
  var four64 = 4.0_d64
  show(f"d64 sin(1): {one64.sin()}")
  show(f"d64 cos(1): {one64.cos()}")
  show(f"d64 tan(1): {one64.tan()}")
  show(f"d64 asin(0.5): {half64.asin()}")
  show(f"d64 acos(0.5): {half64.acos()}")
  show(f"d64 atan(1): {one64.atan()}")
  show(f"d64 atan2(1,1): {one64.atan2(x: one64)}")
  show(f"d64 sinh(1): {one64.sinh()}")
  show(f"d64 cosh(1): {one64.cosh()}")
  show(f"d64 tanh(1): {one64.tanh()}")
  show(f"d64 asinh(1): {one64.asinh()}")
  show(f"d64 acosh(2): {two64.acosh()}")
  show(f"d64 atanh(0.5): {half64.atanh()}")
  show(f"d64 exp(1): {one64.exp()}")
  show(f"d64 exp2(10): {ten64.exp2()}")
  show(f"d64 expm1(0.5): {half64.expm1()}")
  show(f"d64 log(10): {ten64.log()}")
  show(f"d64 log2(8): {eight64.log2()}")
  show(f"d64 log10(2): {two64.log10()}")
  show(f"d64 log1p(0.5): {half64.log1p()}")
  show(f"d64 pow(2,10): {two64 ** ten64}")
  show(f"d64 cbrt(27): {cube64.cbrt()}")
  show(f"d64 hypot(3,4): {three64.hypot(you: four64)}")
  show(f"d64 sqrt(2): {two64.sqrt()}")

  var one128 = 1.0_d128
  var half128 = 0.5_d128
  var two128 = 2.0_d128
  var ten128 = 10.0_d128
  var eight128 = 8.0_d128
  var cube128 = 27.0_d128
  var three128 = 3.0_d128
  var four128 = 4.0_d128
  show(f"d128 sin(1): {one128.sin()}")
  show(f"d128 cos(1): {one128.cos()}")
  show(f"d128 tan(1): {one128.tan()}")
  show(f"d128 asin(0.5): {half128.asin()}")
  show(f"d128 acos(0.5): {half128.acos()}")
  show(f"d128 atan(1): {one128.atan()}")
  show(f"d128 atan2(1,1): {one128.atan2(x: one128)}")
  show(f"d128 sinh(1): {one128.sinh()}")
  show(f"d128 cosh(1): {one128.cosh()}")
  show(f"d128 tanh(1): {one128.tanh()}")
  show(f"d128 asinh(1): {one128.asinh()}")
  show(f"d128 acosh(2): {two128.acosh()}")
  show(f"d128 atanh(0.5): {half128.atanh()}")
  show(f"d128 exp(1): {one128.exp()}")
  show(f"d128 exp2(10): {ten128.exp2()}")
  show(f"d128 expm1(0.5): {half128.expm1()}")
  show(f"d128 log(10): {ten128.log()}")
  show(f"d128 log2(8): {eight128.log2()}")
  show(f"d128 log10(2): {two128.log10()}")
  show(f"d128 log1p(0.5): {half128.log1p()}")
  show(f"d128 pow(2,10): {two128 ** ten128}")
  show(f"d128 cbrt(27): {cube128.cbrt()}")
  show(f"d128 hypot(3,4): {three128.hypot(you: four128)}")
  show(f"d128 sqrt(2): {two128.sqrt()}")

  show("DONE")
  return
