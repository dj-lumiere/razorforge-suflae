module Tests/Stdlib/TupleInLoopsApi
import IO/Console
import IterTools

# Tuple destructuring inside for-in headers — common in zip/enumerate iteration.
routine start()
  # Iterate with index via enumerate (Tuple[U64, T])
  var labels: List[Text] = ["a", "b", "c"]
  each (i, label) in labels.enumerate()
    show(f"  {i}: {label}")

  # zip yields Tuple[T, U]
  var nums: List[S64] = [10, 20, 30]
  each (lbl, n) in zip(a: labels, b: nums)
    show(f"  {lbl} -> {n}")

  # Iterate pairs in a Dict (dict iter yields DictEntry[K, V])
  var d: Dict[S64, S64] = {1: 100, 2: 200, 3: 300}
  var keys_sum = 0_s64
  var vals_sum = 0_s64
  each entry in d
    keys_sum = keys_sum + entry.key
    vals_sum = vals_sum + entry.value
  show(f"keys sum: {keys_sum}")
  show(f"vals sum: {vals_sum}")

  show("DONE")
  return
