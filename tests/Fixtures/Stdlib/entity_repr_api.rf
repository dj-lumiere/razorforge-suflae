module Tests/Stdlib/EntityReprApi
import IO/Console

# A user entity rendered via f-string must show its fields, not the wrapper type. In Suflae the
# `Point` local is promoted to `Roamed[Point]`, yet `f"{p}"` must still read the INNER entity — the
# .sf twin of this fixture shares this snapshot to lock that RF-bare and SF-Roamed render identically.
entity Point
  x: S64
  y: S64

routine start()
  var p = Point(x: 3, y: 4)
  show(f"p: {p}")
  show(f"fields: {p.x}, {p.y}")

  var q = Point(x: -5, y: 42)
  show(f"q: {q}")

  show("DONE")
  return
