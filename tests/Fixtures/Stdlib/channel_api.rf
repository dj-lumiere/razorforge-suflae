module Tests/Stdlib/ChannelApi

# v0.3.0 channels — first end-to-end smoke test (single-threaded, buffered, no parking yet). A Feeder
# sends three values into a capacity-4 Hopper; after close, the `for` loop drains the buffer in order
# then ends when the channel is closed-and-empty. Exercises make_hopper, feed!, close, and the
# Iterable receive path (Hopper.$iter -> ChannelDrain.$next!) through real codegen.

import IO/Console

routine start()
  var (feeder, hop) = make_hopper[S64](capacity: 4)
  danger!
    feeder.feed!(item: 10)
    feeder.feed!(item: 20)
    feeder.feed!(item: 30)
  feeder.close()

  var total = 0_s64
  var seen = 0_s64
  for v in hop
    total = total + v
    seen = seen + 1
  show(f"count={seen} sum={total}")
  return
