module Tests/Stdlib/SecureSetApi
import IO/Console
import Collections.SecureSet

# SecureSet uses SipHash but still iterates in insertion order.
routine start()
  var s = SecureSet[S64]()
  show(f"new size: {s.count()}")
  show(f"is_empty (new): {s.is_empty()}")

  discard s.add(value: 10)
  discard s.add(value: 20)
  discard s.add(value: 30)
  discard s.add(value: 20)  # duplicate, no-op
  show(f"size after add 10/20/30/20: {s.count()}")
  show(f"contents: {s}")

  show(f"contains 20: {20 in s}")
  show(f"contains 99: {99 in s}")

  discard s.remove(value: 10)
  show(f"size after remove(10): {s.count()}")
  show(f"contents after remove: {s}")
  show(f"contains 10: {10 in s}")

  show(f"diagnose: {s.$diagnose()}")

  show("DONE")
  return
