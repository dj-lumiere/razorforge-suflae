module Tests/Stdlib/NumericConstantsApi
import IO/Console

# Stdlib `preset` constants for numeric bounds + abs/min/max instance methods.
routine start()
  show(f"S64_MIN: {S64_MIN}")
  show(f"S64_MAX: {S64_MAX}")
  show(f"S8_MIN: {S8_MIN}")
  show(f"S8_MAX: {S8_MAX}")
  show(f"U8_MIN: {U8_MIN}")
  show(f"U8_MAX: {U8_MAX}")
  show(f"U64_MAX: {U64_MAX}")

  show(f"F64_EPSILON: {F64_EPSILON}")
  show(f"F64_MIN: {F64_MIN}")
  show(f"F64_MAX: {F64_MAX}")

  # abs / min / max instance methods
  show(f"abs(-5): {(-5_s64).abs()}")
  show(f"abs(5): {(5_s64).abs()}")
  show(f"abs(0): {(0_s64).abs()}")

  show(f"min(3, 7): {(3_s64).min(you: 7_s64)}")
  show(f"max(3, 7): {(3_s64).max(you: 7_s64)}")

  show(f"abs(-3.14): {(-3.14_f64).abs()}")
  show(f"F64 min(2.0, 5.0): {(2.0_f64).min(you: 5.0_f64)}")

  show("DONE")
  return
