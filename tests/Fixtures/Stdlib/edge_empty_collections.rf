module Tests/Stdlib/EdgeEmptyCollections
import IO/Console
import Collections

# Empty-container probes — all queries must return sane values without crashing.
routine start()
  var l: List[S64] = []
  show(f"list count: {l.count()}")
  show(f"list is_empty: {l.is_empty()}")
  show(f"list contains 1: {1_s64 in l}")
  show(f"list represent: {l}")

  var s: Set[S64] = Set[S64]()
  show(f"set count: {s.count()}")
  show(f"set is_empty: {s.is_empty()}")
  show(f"set contains 1: {1_s64 in s}")

  var d: Dict[S64, S64] = Dict[S64, S64]()
  show(f"dict count: {d.count()}")
  show(f"dict is_empty: {d.is_empty()}")
  show(f"dict contains_key 1: {1_s64 in d}")

  # Iteration over empty containers — should produce zero side-effects
  var counter = 0_s64
  for x in l
    counter = counter + 1
  show(f"empty list iter count: {counter}")

  for x in s
    counter = counter + 1
  show(f"after empty set iter: {counter}")

  for k in d
    counter = counter + 1
  show(f"after empty dict iter: {counter}")

  show("DONE")
  return
