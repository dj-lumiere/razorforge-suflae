module Tests/Stdlib/MultiConstraintGenericApi
import IO/Console

# Generics with multiple protocol constraints — `T obeys A + B` style (whatever
# the actual syntax is). Tests that the routine sees both protocol surfaces.

routine in_set_and_max[T](items: List[T], target: T) -> Bool
needs T obeys Equatable, Hashable
  # Hashable lets us build a Set; Equatable lets us check contains
  var s: Set[T] = Set[T]()
  for x in items
    discard s.add(value: x)
  return s.contains(value: target)

routine min_of_three[T](a: T, b: T, c: T) -> T
needs T obeys Ordered
  return a.min(you: b).min(you: c)

routine start()
  var nums: List[S64] = [10, 20, 30, 40]
  show(f"in_set 20: {in_set_and_max(items: nums, target: 20_s64)}")
  show(f"in_set 99: {in_set_and_max(items: nums, target: 99_s64)}")

  var words: List[Owned[Text]] = ["alpha", "bravo", "charlie"]
  show(f"in_set 'bravo': {in_set_and_max(items: words, target: "bravo")}")
  show(f"in_set 'delta': {in_set_and_max(items: words, target: "delta")}")

  show(f"min of (5, 3, 7) S64: {min_of_three(a: 5_s64, b: 3_s64, c: 7_s64)}")
  show(f"min of (1.5, 0.5, 2.5) F64: {min_of_three(a: 1.5_f64, b: 0.5_f64, c: 2.5_f64)}")

  show("DONE")
  return
