module Tests/Stdlib/DurationApi
import IO/Console

routine start()
  var zero = Duration.zero()
  show(f"zero: {zero}")

  var one_sec = Duration.from_seconds(s: 1_s64)
  var one_ms = Duration.from_milliseconds(ms: 1_s64)
  var one_us = Duration.from_microseconds(us: 1_s64)
  var one_ns = Duration.from_nanoseconds(ns: 1_s64)

  show(f"1s: {one_sec}")
  show(f"1ms: {one_ms}")
  show(f"1us: {one_us}")
  show(f"1ns: {one_ns}")

  # Arithmetic
  var two_sec = one_sec + one_sec
  show(f"1s + 1s: {two_sec}")
  show(f"2s - 1s: {two_sec - one_sec}")
  show(f"-1s: {-one_sec}")

  # Larger units
  var hour = Duration.from_hours(h: 1_s64)
  var day = Duration.from_days(d: 1_s64)
  show(f"1h: {hour}")
  show(f"1d: {day}")

  # Ordering
  show(f"1ns < 1us: {one_ns < one_us}")
  show(f"1us < 1ms: {one_us < one_ms}")
  show(f"1ms < 1s: {one_ms < one_sec}")
  show(f"1s == 1s: {one_sec == Duration.from_seconds(s: 1_s64)}")

  # Multi-component formatting (space-separated)
  var hms = hour + Duration.from_minutes(m: 2_s64) + Duration.from_seconds(s: 3_s64)
  show(f"1h+2m+3s: {hms}")

  var full = day + hour + Duration.from_minutes(m: 2_s64) + Duration.from_seconds(s: 3_s64) + one_ms + one_us + one_ns
  show(f"all units: {full}")

  show(f"negative all units: {-full}")

  show("DONE")
  return
