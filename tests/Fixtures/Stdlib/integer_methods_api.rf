module Tests/Stdlib/IntegerMethodsApi
import IO/Console

# Integer-specific methods: bit ops, classification, signum, parse from text.
routine start()
  # Classification
  show(f"5 is_positive: {(5_s64).is_positive()}")
  show(f"-5 is_negative: {(-5_s64).is_negative()}")
  show(f"0 is_zero: {(0_s64).is_zero()}")
  show(f"4 is_even: {(4_s64).is_even()}")
  show(f"5 is_odd: {(5_s64).is_odd()}")
  show(f"8 is_power_of_two: {(8_s64).is_power_of_two()}")
  show(f"6 is_power_of_two: {(6_s64).is_power_of_two()}")

  # Sign
  show(f"signum(-7): {(-7_s64).signum()}")
  show(f"signum(0): {(0_s64).signum()}")
  show(f"signum(7): {(7_s64).signum()}")

  # Bit ops on S64
  show(f"count_ones(0b1101): {(0b1101_s64).count_ones()}")
  show(f"count_zeros(0b0000): {(0_s64).count_zeros()}")
  show(f"leading_zeros(1): {(1_s64).leading_zeros()}")
  show(f"trailing_zeros(8): {(8_s64).trailing_zeros()}")

  # Parse from text
  var ok = try_S64_from_text(text: "12345")
  var neg = try_S64_from_text(text: "-42")
  var bad = try_S64_from_text(text: "abc")
  show(f"parse '12345': {ok}")
  show(f"parse '-42': {neg}")
  show(f"parse 'abc': {bad}")

  show("DONE")
  return

# Wrapper to expose the failable creator for try_/check_ generation.
routine S64_from_text!(text: Text) -> S64
  return S64(from_text: text)!
