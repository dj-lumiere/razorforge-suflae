module Tests/Stdlib/RangeApi
import IO/Console

# Range expressions: `to` (inclusive) and `til` (exclusive), with optional `by`.
routine print_range(label: Text, r: Iterable[S64])
  var out = f"{label}: "
  for x in r
    out = out + f"{x} "
  show(out)
  return

routine start()
  # Inclusive ascending
  print_range(label: "1 to 5", r: 1 to 5)
  # Inclusive descending
  print_range(label: "5 to 1", r: 5 to 1)
  # Exclusive ascending
  print_range(label: "1 til 5", r: 1 til 5)
  # Exclusive descending
  print_range(label: "5 til 1", r: 5 til 1)

  # With step
  print_range(label: "1 to 10 by 2", r: 1 to 10 by 2)
  print_range(label: "1 til 10 by 2", r: 1 til 10 by 2)
  print_range(label: "10 to 1 by 2", r: 10 to 1 by 2)
  print_range(label: "10 til 1 by 2", r: 10 til 1 by 2)

  # Single-element range
  print_range(label: "5 to 5", r: 5 to 5)
  # Empty range
  print_range(label: "5 til 5", r: 5 til 5)

  # Sum via IterTools
  var s = 0_s64
  for x in 1 to 100
    s = s + x
  show(f"sum 1..100: {s}")

  show("DONE")
  return
