module Tests/Stdlib/BackIndexApi
import IO/Console

# Back-indexing — `^N` (or whatever the syntax is) for indexing from the end.
# Stdlib signatures show `$getitem!(index: BackIndex)` on List/Text/Bytes/Array.
routine start()
  var l: List[S64] = [10, 20, 30, 40, 50]
  show(f"l[^1]: {l[^1]}")    # last
  show(f"l[^2]: {l[^2]}")    # second-to-last
  show(f"l[^5]: {l[^5]}")    # first via back index

  # Text back-index (Character)
  var t = "hello"
  show(f"t[^1]: {t[^1]}")
  show(f"t[^5]: {t[^5]}")

  # Bytes back-index (Byte)
  var b = "hello".bytes()
  show(f"b[^1]: {b[^1]}")

  # Slice with back-index (range form)
  show(f"l[^3 to ^1]: {l[^3 to ^1]}")
  show(f"t[^3 to ^1]: {t[^3 to ^1]}")

  show("DONE")
  return
