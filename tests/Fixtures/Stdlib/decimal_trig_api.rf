module Tests/Stdlib/DecimalTrigApi
import IO/Console
import Numerics.[Decimal]

# Fixed 70-digit Decimal (BID softfloat) trig/hyperbolic/constants. pi/e are the
# DECIMAL_PI / DECIMAL_E presets (Decimal is fixed-precision, so they are constants,
# not precision-parameterized routines).

routine start()
  var one = 1dn
  var half = 0.5dn

  show(f"pi: {DECIMAL_PI}")
  show(f"e: {DECIMAL_E}")

  show(f"sin(1): {one.sin()}")
  show(f"cos(1): {one.cos()}")
  show(f"tan(1): {one.tan()}")
  show(f"asin(0.5): {half.try_asin()!!}")
  show(f"acos(0.5): {half.try_acos()!!}")
  show(f"atan(1): {one.atan()}")
  show(f"atan2(1,1): {one.atan2(x: one)}")

  show(f"sinh(1): {one.sinh()}")
  show(f"cosh(1): {one.cosh()}")
  show(f"tanh(1): {one.tanh()}")

  show("DONE")
  return
