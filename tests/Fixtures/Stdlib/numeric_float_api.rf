module Tests/Stdlib/NumericFloatApi
import IO/Console

# Exercises F16, F32, F64, F128 — basic arithmetic, special values, comparison.
routine start()
  var f32: F32 = 3.14_f32
  var f64: F64 = 2.71828_f64

  show(f"F32: {f32}")
  show(f"F64: {f64}")

  # Arithmetic
  show(f"F32 add: {f32 + 1.0_f32}")
  show(f"F64 sub: {f64 - 1.0_f64}")
  show(f"F32 mul: {f32 * 2.0_f32}")
  show(f"F64 div: {f64 / 2.0_f64}")

  # Comparison
  show(f"F64 1.0 < 2.0: {1.0_f64 < 2.0_f64}")
  show(f"F64 1.0 == 1.0: {1.0_f64 == 1.0_f64}")
  show(f"F64 NaN == NaN: {F64.nan() == F64.nan()}")

  # Special values
  show(f"F64 inf: {F64.infinity()}")
  show(f"F64 -inf: {-F64.infinity()}")
  show(f"F64 isnan(nan): {F64.nan().is_nan()}")
  show(f"F64 isnan(1.0): {1.0_f64.is_nan()}")

  # Conversion
  var to_int: S64 = S64(from: 3.7_f64)
  show(f"F64->S64 3.7: {to_int}")

  show("DONE")
  return
