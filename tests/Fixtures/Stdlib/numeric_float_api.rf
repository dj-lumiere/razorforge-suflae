module Tests/Stdlib/NumericFloatApi
import IO/Console

# Exercises B16, B32, B64, B128 — basic arithmetic, special values, comparison.
routine start()
  var b32: B32 = 3.14_b32
  var b64: B64 = 2.71828_b64

  show(f"B32: {b32}")
  show(f"B64: {b64}")

  # Arithmetic
  show(f"B32 add: {b32 + 1.0_b32}")
  show(f"B64 sub: {b64 - 1.0_b64}")
  show(f"B32 mul: {b32 * 2.0_b32}")
  show(f"B64 div: {b64 / 2.0_b64}")

  # Comparison
  show(f"B64 1.0 < 2.0: {1.0_b64 < 2.0_b64}")
  show(f"B64 1.0 == 1.0: {1.0_b64 == 1.0_b64}")
  show(f"B64 NaN == NaN: {B64_NAN == B64_NAN}")

  # Special values
  show(f"B64 inf: {B64_INFINITY}")
  show(f"B64 -inf: {-B64_INFINITY}")
  show(f"B64 isnan(nan): {B64_NAN.is_nan()}")
  show(f"B64 isnan(1.0): {1.0_b64.is_nan()}")

  # Conversion
  var to_int: S64 = S64(from: 3.7_b64)
  show(f"B64->S64 3.7: {to_int}")

  show("DONE")
  return
