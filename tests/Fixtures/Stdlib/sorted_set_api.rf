module Tests/Stdlib/SortedSetApi
import IO/Console
import Collections

# SortedSet HAS deterministic iteration (sorted order), so direct output is safe.
routine start()
  var ss = SortedSet[S64]()
  show(f"new size: {ss.count()}")

  discard ss.add(value: 30)
  discard ss.add(value: 10)
  discard ss.add(value: 20)
  discard ss.add(value: 10)  # duplicate
  show(f"after 30/10/20/10, size: {ss.count()}")

  # iteration is sorted -> deterministic
  for x in ss
    show(f"  iter: {x}")

  show(f"contains 20: {20 in ss}")
  show(f"contains 99: {99 in ss}")

  # Rank access (O(log n) — named to signal cost)
  show(f"ss.get_by_rank(0): {ss.try_get_by_rank(rank: 0_u64)!!}")
  show(f"ss.get_by_rank(1): {ss.try_get_by_rank(rank: 1_u64)!!}")
  show(f"ss.get_by_rank(2): {ss.try_get_by_rank(rank: 2_u64)!!}")

  show("DONE")
  return
