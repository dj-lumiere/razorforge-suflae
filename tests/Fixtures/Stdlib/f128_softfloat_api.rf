module Tests/Stdlib/B128SoftfloatApi
import IO/Console

# Covers the software B128 engine: arithmetic, comparison, and libm all run through
# the pure-integer UnpackedFloat engine (no TLFloat FFI, no LLVM fp128). Integer
# constructors (S64/U64/S128/U128) and float widen/narrow are pure-RF too.

routine start()
  var a = B128(from: 2_s64)
  var b = B128(from: 3_s64)
  show(f"2+3 = {a + b}")
  show(f"2-3 = {a - b}")
  show(f"2*3 = {a * b}")
  show(f"3/2 = {b / a}")
  show(f"sqrt(2) = {a.sqrt_unchecked()}")
  show(f"exp(1) = {B128(from: 1_s64).exp_unchecked()}")
  show(f"log(2) = {a.log_unchecked()}")
  show(f"2<3 = {a < b}")
  show(f"2==2 = {a == B128(from: 2_s64)}")
  show(f"max(2,3) = {a.max(you: b)}")
  show(f"clamp(3,0,2) = {b.clamp(min_val: B128(from: 0_s64), max_val: a)}")

  # Integer constructors through the engine.
  var big = B128(from: 1000000000000000000_s64)
  show(f"from s64 1e18 = {big}")
  var u = B128(from: 18446744073709551615_u64)
  show(f"from u64 max = {u}")
  var s128v = B128(from: 170141183460469231731687303715884105727_s128)
  show(f"from s128 max = {s128v}")

  # Float widen (B64 -> B128, exact) and narrow (B128 -> B64, correctly rounded).
  var w = B128(from: 1.5_b64)
  show(f"from b64 1.5 = {w}")
  show(f"to b64 1.5 = {w.B64()}")
  show(f"3/2 to b64 = {(b / a).B64()}")
  show(f"pi to b64 = {B128_PI.B64()}")
  show(f"to b32 = {w.B32()}")
  return
