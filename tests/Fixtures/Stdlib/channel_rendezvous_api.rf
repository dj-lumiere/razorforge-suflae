module Tests/Stdlib/ChannelRendezvousApi

# v0.3.0 channels — rendezvous (capacity 0). With no buffer, every feed! is hand-to-hand: it parks
# until a consumer takes that exact item, so a completed feed means the hand-off happened. Here a
# coroutine producer and a coroutine consumer cooperatively rendezvous three times on this thread's
# scheduler. Proves the capacity-0 path (feed waits for a taker, not for buffer space).

import IO/Console

suspended routine produce(out: Feeder[S64]) -> S64
  danger!
    out.feed!(item: 7)     # each parks until the consumer takes it
    out.feed!(item: 8)
    out.feed!(item: 9)
  return 3

suspended routine consume(inbox: Hopper[S64]) -> S64
  var total = 0_s64
  for v in inbox
    total = total + v
  return total

routine start()
  var (feeder, hop) = make_hopper[S64](capacity: 0)   # rendezvous: no buffered slots

  var p = produce(out: steal feeder)
  var c = consume(inbox: steal hop)

  danger!
    var sum = c.retrieve!()
    discard p.retrieve!()
    show(f"sum={sum}")
  return
