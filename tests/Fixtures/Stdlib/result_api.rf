module Tests/Stdlib/ResultApi
import IO/Console
import Core/Errors/Common
import Core/Errors/DivisionByZeroError

# Failable routine using throw only -> exposes check_ variant returning Result[T]
routine divide!(a: S64, b: S64) -> S64
  if b == 0
    throw DivisionByZeroError()
  return a // b

routine start()
  var r_ok = check_divide(a: 10, b: 2)
  var r_err = check_divide(a: 10, b: 0)

  show(f"ok type: {r_ok.type_name()}")
  show(f"ok present: {r_ok}")
  show(f"err present: {r_err}")
  show(f"ok diagnose: {r_ok:?}")
  show(f"err diagnose: {r_err:?}")

  when r_ok
    is DivisionByZeroError => show("  r_ok => error")
    else v => show(f"  r_ok => ok: {v}")
  when r_err
    is DivisionByZeroError => show("  r_err => caught DivisionByZeroError")
    else v => show(f"  r_err => ok: {v}")

  show("DONE")
  return
