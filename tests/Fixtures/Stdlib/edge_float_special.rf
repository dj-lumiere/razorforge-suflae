module Tests/Stdlib/EdgeFloatSpecial
import IO/Console

# IEEE 754 special values: NaN, ±Infinity, signed zero.
routine start()
  var nan = B64_NAN
  var inf = B64_INFINITY
  var ninf = -B64_INFINITY
  var pz: B64 = 0.0_b64
  var nz: B64 = -0.0_b64

  show(f"nan: {nan}")
  show(f"inf: {inf}")
  show(f"-inf: {ninf}")
  show(f"+0: {pz}")
  show(f"-0: {nz}")

  # NaN propagation (unchecked: arithmetic with NaN yields NaN, not error)
  danger
    show(f"nan + 1: {nan.add_unchecked(you: 1.0_b64)}")
  show(f"nan == nan: {nan == nan}")
  show(f"nan != nan: {nan != nan}")
  show(f"nan.is_nan(): {nan.is_nan()}")
  show(f"1.0.is_nan(): {1.0_b64.is_nan()}")

  # Infinity arithmetic (unchecked: inf+inf=inf, inf-inf=NaN)
  danger
    show(f"inf + inf: {inf.add_unchecked(you: inf)}")
    show(f"inf - inf: {inf.sub_unchecked(you: inf).is_nan()}")
  danger
    show(f"1.0 / 0.0: {1.0_b64.truediv_unchecked(you: 0.0_b64)}")
    show(f"-1.0 / 0.0: {(-1.0_b64).truediv_unchecked(you: 0.0_b64)}")

  # Signed zero
  show(f"+0 == -0: {pz == nz}")
  danger
    show(f"1.0 / +0: {1.0_b64.truediv_unchecked(you: pz)}")
    show(f"1.0 / -0: {1.0_b64.truediv_unchecked(you: nz)}")

  # An exact zero from x - x or x + (-x) is +0 (round to nearest), and -0 - 0 / -0 + -0 stay -0.
  # B128 is software arithmetic, so it is checked against the hardware B64 rule too.
  var m2: B128 = -2.0_b128
  var d128 = m2 - m2
  show(f"B128 -2 - (-2): {d128} bits={d128.to_bits().hex()}")
  var s128 = m2 + 2.0_b128
  show(f"B128 -2 + 2: {s128} bits={s128.to_bits().hex()}")
  var nz128: B128 = -0.0_b128
  show(f"B128 -0 - 0: {nz128 - 0.0_b128}")
  show(f"B128 -0 + -0: {nz128 + nz128}")
  var m2_64: B64 = -2.0_b64
  show(f"B64 -2 - (-2): {m2_64 - m2_64}")
  show(f"B64 -0 - 0: {nz - pz}")

  show("DONE")
  return
