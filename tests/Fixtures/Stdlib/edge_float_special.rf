module Tests/Stdlib/EdgeFloatSpecial
import IO/Console

# IEEE 754 special values: NaN, ±Infinity, signed zero.
routine start()
  var nan = F64_NAN
  var inf = F64_INFINITY
  var ninf = -F64_INFINITY
  var pz: F64 = 0.0_f64
  var nz: F64 = -0.0_f64

  show(f"nan: {nan}")
  show(f"inf: {inf}")
  show(f"-inf: {ninf}")
  show(f"+0: {pz}")
  show(f"-0: {nz}")

  # NaN propagation (unchecked: arithmetic with NaN yields NaN, not error)
  danger
    show(f"nan + 1: {nan.add_unchecked(you: 1.0_f64)}")
  show(f"nan == nan: {nan == nan}")
  show(f"nan != nan: {nan != nan}")
  show(f"nan.is_nan(): {nan.is_nan()}")
  show(f"1.0.is_nan(): {1.0_f64.is_nan()}")

  # Infinity arithmetic (unchecked: inf+inf=inf, inf-inf=NaN)
  danger
    show(f"inf + inf: {inf.add_unchecked(you: inf)}")
    show(f"inf - inf: {inf.sub_unchecked(you: inf).is_nan()}")
  danger
    show(f"1.0 / 0.0: {1.0_f64.truediv_unchecked(you: 0.0_f64)}")
    show(f"-1.0 / 0.0: {(-1.0_f64).truediv_unchecked(you: 0.0_f64)}")

  # Signed zero
  show(f"+0 == -0: {pz == nz}")
  danger
    show(f"1.0 / +0: {1.0_f64.truediv_unchecked(you: pz)}")
    show(f"1.0 / -0: {1.0_f64.truediv_unchecked(you: nz)}")

  show("DONE")
  return
