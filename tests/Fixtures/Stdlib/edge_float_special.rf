module Tests/Stdlib/EdgeFloatSpecial
import IO/Console

# IEEE 754 special values: NaN, ±Infinity, signed zero.
routine start()
  var nan = F64_NAN
  var inf = F64_INFINITY
  var ninf = -F64_INFINITY
  var pz: F64 = 0.0_f64
  var nz: F64 = -0.0_f64

  show(f"nan: {nan}")
  show(f"inf: {inf}")
  show(f"-inf: {ninf}")
  show(f"+0: {pz}")
  show(f"-0: {nz}")

  # NaN propagation
  show(f"nan + 1: {nan + 1.0_f64}")
  show(f"nan == nan: {nan == nan}")
  show(f"nan != nan: {nan != nan}")
  show(f"nan.is_nan(): {nan.is_nan()}")
  show(f"1.0.is_nan(): {1.0_f64.is_nan()}")

  # Infinity arithmetic
  show(f"inf + inf: {inf + inf}")
  show(f"inf - inf: {(inf - inf).is_nan()}")
  show(f"1.0 / 0.0: {1.0_f64 / 0.0_f64}")
  show(f"-1.0 / 0.0: {-1.0_f64 / 0.0_f64}")

  # Signed zero
  show(f"+0 == -0: {pz == nz}")
  show(f"1.0 / +0: {1.0_f64 / pz}")
  show(f"1.0 / -0: {1.0_f64 / nz}")

  show("DONE")
  return
