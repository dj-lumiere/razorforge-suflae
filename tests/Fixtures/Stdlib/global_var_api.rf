module Tests/Stdlib/GlobalVarApi
import IO/Console

# Module-level `global var` — repurposed for entity-only globals per memory notes.
# Records/primitives at module scope follow the same shape but aren't entity.
global counter: S64 = 0

routine inc()
  counter = counter + 1
  return

routine start()
  show(f"initial counter: {counter}")
  inc()
  inc()
  inc()
  show(f"after 3 inc(): {counter}")

  counter = 100
  show(f"after assign 100: {counter}")

  # Use inside a loop
  for x in 1 to 5
    counter = counter + x
  show(f"after summing 1..5: {counter}")  # 100 + 15 = 115

  show("DONE")
  return
