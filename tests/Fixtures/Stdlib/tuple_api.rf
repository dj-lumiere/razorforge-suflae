module Tests/Stdlib/TupleApi
import IO/Console

routine start()
  var t = (1, "hello", true)
  show(f"t: {t}")
  show(f"t (diagnose): {t:?}")

  # field access
  show(f"t.item0: {t.item0}")
  show(f"t.item1: {t.item1}")
  show(f"t.item2: {t.item2}")

  # Destructuring (value-copy semantics)
  var (a, b, c) = t
  show(f"a: {a}")
  show(f"b: {b}")
  show(f"c: {c}")

  # Equality (record semantics)
  var t2 = (1, "hello", true)
  show(f"t == t2: {t == t2}")
  var t3 = (1, "hello", false)
  show(f"t == t3: {t == t3}")

  show("DONE")
  return
