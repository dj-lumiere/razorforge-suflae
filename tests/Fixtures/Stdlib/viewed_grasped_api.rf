module Tests/Stdlib/ViewedGraspedApi
import IO/Console

entity Box
  value: S64

routine Box.$create(value: S64) -> Box
  return Box(value: value)

routine Box.set(value: S64)
  me.value = value
  return

routine start()
  var b = Box(value: 7)

  # Viewed: read-only borrow
  var v = b.view()
  show(f"v type: {v.type_name()}")
  show(f"v.value via forward: {v.value}")

  # Grasped: mutable borrow inside a using scope
  using b.grasp() as g
    g.set(value: 42)
  show(f"after grasp.set(42): {b.value}")

  # T.view() peels — directly Viewed[Box] not Viewed[Box]
  var another = Box(value: 100)
  var v2 = another.view()
  show(f"v2 type: {v2.type_name()}")
  show(f"v2.value: {v2.value}")

  show("DONE")
  return
