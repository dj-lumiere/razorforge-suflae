module Tests/Stdlib/ComparisonOpsApi
import IO/Console

# Compiler-generated $lt/$le/$gt/$ge from $cmp on types that obey Ordered.
record Score
  value: S64

# Score auto-derives Equatable/Hashable; we expose $cmp manually so $lt/$le/$gt/$ge
# can be derived from it.
routine Score.$cmp(you: Score) -> ComparisonSign
  if me.value < you.value
    return ComparisonSign.ME_SMALL
  if me.value > you.value
    return ComparisonSign.ME_LARGE
  return ComparisonSign.ME_EQUAL

routine start()
  var a = Score(value: 10)
  var b = Score(value: 20)
  var c = Score(value: 10)

  show(f"a < b: {a < b}")
  show(f"a <= b: {a <= b}")
  show(f"a == c: {a == c}")
  show(f"a != b: {a != b}")
  show(f"a >= c: {a >= c}")
  show(f"b > a: {b > a}")

  # Numeric chain
  show(f"1 < 2 < 3: {1_s64 < 2_s64 and 2_s64 < 3_s64}")
  show(f"max chain: {(3_s64).max(you: 7_s64).max(you: 5_s64)}")

  # Text ordering
  show(f"'abc' < 'abd': {"abc" < "abd"}")
  show(f"'abc' < 'abcd': {"abc" < "abcd"}")
  show(f"'A' < 'a': {"A" < "a"}")

  show("DONE")
  return
