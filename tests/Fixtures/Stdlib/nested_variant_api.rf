module Tests/Stdlib/NestedVariantApi

import IO/Console

# Nested variants: a variant may appear as a member type of another variant.
# Also exercises the `none` value literal in carrier/variant-with-None slots.

variant Inner
  S32
  None

variant Outer
  Inner
  Text
  None

@readonly
routine describe_inner(i: Inner) -> Text
  when i
    is S32 v => return f"inner-s32:{v}"
    is None  => return "inner-none"

@readonly
routine describe(o: Outer) -> Text
  when o
    is Inner i => return describe_inner(i: i)
    is Text t  => return f"text:{t}"
    is None    => return "outer-none"

routine start()
  var a: Outer = Inner(7_s32)
  var b: Outer = Inner(none)
  var c: Outer = "hi"
  var d: Outer = none

  show(describe(o: a))
  show(describe(o: b))
  show(describe(o: c))
  show(describe(o: d))
  return
