module Tests/Stdlib/ArrayApi
import IO/Console
import Collections

# Fixed-size array Array[T, N] — N is a const-generic length.
entity Cell
  v: S64

routine start()
  var a = Array[S64, 4]()
  a[0] = 10
  a[1] = 20
  a[2] = 30
  a[3] = 40

  show(f"a: {a}")
  show(f"a (diagnose): {a:?}")
  show(f"count: {a.count()}")
  show(f"is_empty: {a.is_empty()}")

  # Indexing
  show(f"a[0]: {a[0]}")
  show(f"a[3]: {a[3]}")

  # first/last (failable)
  show(f"first: {a.first()}")
  show(f"last: {a.last()}")

  # contains / index_of
  show(f"contains 20: {a have 20}")
  show(f"contains 99: {a have 99}")
  show(f"index_of 30: {a.index_of(value: 30)}")

  # Iteration (deterministic — array order is fixed)
  var sum = 0_s64
  each x in a
    sum = sum + x
  show(f"sum: {sum}")

  # Equality
  var b = Array[S64, 4]()
  b[0] = 10
  b[1] = 20
  b[2] = 30
  b[3] = 40
  show(f"a == b: {a == b}")

  # Built from its elements: `Array[N](...)` takes T from the elements, so element types with no zero
  # value (entities, reference-counted handles) get an array with no null slot.
  var built = Array[3](7, 8, 9)
  var words = Array[2]("x", "y")
  var nodes = Array[2](Cell(v: 1), Cell(v: 2))
  nodes[0].v = 5
  var shared = Array[2](Retained[Cell](from: Cell(v: 3)), Retained[Cell](from: Cell(v: 4)))
  show(f"built: {built[0] + built[2]} {words[1]} {nodes[0].v} {nodes[1].v} {shared.count()}")

  show("DONE")
  return
