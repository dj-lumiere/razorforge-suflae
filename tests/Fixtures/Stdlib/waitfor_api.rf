module Tests/Stdlib/WaitforApi

# Standalone `waitfor(d)` — a timed wait. Currently a `threaded routine` (the wait runs on a
# worker thread, joined by `retrieve!`); it becomes a `suspended routine` when the scheduler
# lands, with identical call sites. Uncolored: prefer this over a raw sleep.

import IO/Console

routine start()
  show(value: "before")
  var waited = waitfor(10ms).retrieve!()
  show(f"waited {waited.total_nanoseconds() >= 10000000_s64}")
  show(value: "after")
  return
