module Tests/Stdlib/WideDivisionApi

import IO/Console

# Cross-checks the Knuth-D-backed U128/S128 division operators against the raw
# intrinsics over deterministic LCG cases. Exercises single-limb and multi-limb
# divisors (U128) and all four sign combinations + floor rounding (S128).

routine s128_floor_ref(a: S128, b: S128) -> S128
  var q = LLVM::signed_div[S128](a: a, b: b)
  var r = LLVM::signed_rem[S128](a: a, b: b)
  if r < 0_s128
    if b > 0_s128
      return q - 1_s128
    return q + 1_s128
  return q

routine s128_mod_ref(a: S128, b: S128) -> S128
  var r = LLVM::signed_rem[S128](a: a, b: b)
  if r < 0_s128
    if b > 0_s128
      return r + b
    return r - b
  return r

routine start()
  var s = 0x2545F4914F6CDD1D_u64
  var u_mis = 0_s64
  var s_mis = 0_s64
  var i = 0_s64
  while LLVM::signed_lt[S64](a: i, b: 50000_s64)
    s = s *% 6364136223846793005_u64 +% 1442695040888963407_u64
    var ah = s
    s = s *% 6364136223846793005_u64 +% 1442695040888963407_u64
    var al = s
    s = s *% 6364136223846793005_u64 +% 1442695040888963407_u64
    var bh = s
    s = s *% 6364136223846793005_u64 +% 1442695040888963407_u64
    var bl = s
    # half the time use a single-limb divisor
    if LLVM::int_eq[U64](a: LLVM::bit_and[U64](a: s, b: 1_u64), b: 0_u64)
      bh = 0_u64
    if LLVM::int_eq[U64](a: LLVM::bit_or[U64](a: bh, b: bl), b: 0_u64)
      bl = 1_u64
    var au = LLVM::bit_or[U128](a: LLVM::shift_left[U128](LLVM::zero_extend[U64, U128](ah), 64_u128), b: LLVM::zero_extend[U64, U128](al))
    var bu = LLVM::bit_or[U128](a: LLVM::shift_left[U128](LLVM::zero_extend[U64, U128](bh), 64_u128), b: LLVM::zero_extend[U64, U128](bl))
    if LLVM::int_ne[U128](a: au // bu, b: LLVM::unsigned_div[U128](a: au, b: bu))
      u_mis = LLVM::add[S64](a: u_mis, b: 1_s64)
    if LLVM::int_ne[U128](a: au % bu, b: LLVM::unsigned_rem[U128](a: au, b: bu))
      u_mis = LLVM::add[S64](a: u_mis, b: 1_s64)
    var asg = LLVM::reinterpret_bits[U128, S128](au)
    var bsg = LLVM::reinterpret_bits[U128, S128](bu)
    if LLVM::int_ne[S128](a: asg // bsg, b: s128_floor_ref(a: asg, b: bsg))
      s_mis = LLVM::add[S64](a: s_mis, b: 1_s64)
    if LLVM::int_ne[S128](a: asg % bsg, b: s128_mod_ref(a: asg, b: bsg))
      s_mis = LLVM::add[S64](a: s_mis, b: 1_s64)
    i = LLVM::add[S64](a: i, b: 1_s64)
  show("U128 //,%: " + f"{u_mis}" + " mismatch")
  show("S128 //,%: " + f"{s_mis}" + " mismatch")
  return
