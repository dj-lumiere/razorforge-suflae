module Tests/Stdlib/BuilderQueryApi
import IO/Console
import BuilderQuery

record Point
  x: S64
  y: S64

entity Counter
  value: S64

routine start()
  # Primitive reflection
  var n: S64 = 42
  show(f"S64 type_name: {n.type_name()}")
  show(f"S64 is_generic: {n.is_generic()}")
  show(f"S64 annotations count: {n.annotations().count()}")

  # Record reflection
  var p = Point(x: 1, y: 2)
  show(f"Point type_name: {p.type_name()}")
  show(f"Point full_type_name: {p.full_type_name()}")
  show(f"Point member_variable_count: {p.member_variable_count()}")
  show(f"Point is_generic: {p.is_generic()}")

  # Entity reflection
  var c = Counter(value: 99)
  show(f"Counter type_name: {c.type_name()}")
  show(f"Counter member_variable_count: {c.member_variable_count()}")

  # Generic instance
  var list: List[S64] = [1, 2, 3]
  show(f"List[S64] type_name: {list.type_name()}")

  # Structured member variable info
  each f in p.member_variable_info()
    show(f"Point field: {f.name}: {f.type_name} @{f.offset}")

  # Structured protocol info (populated, incl. nested routine_names list)
  each pi in p.protocol_info()
    show(f"Point protocol: {pi.name} routines={pi.routine_names.count()} gen={pi.is_generated}")

  # Structured routine info — spot-check the universal represent() member
  each r in p.routine_info()
    if r.name == "represent"
      show(f"Point routine represent: return={r.return_type} crashable={r.is_crashable} params={r.param_types.count()}")

  # Module dependencies + annotations
  each d in p.dependencies()
    show(f"Point dep: {d}")
  show(f"Point annotations count: {p.annotations().count()}")

  show("DONE")
  return
