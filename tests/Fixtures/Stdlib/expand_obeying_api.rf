module Tests/Stdlib/ExpandObeyingApi
import IO/Console

# `m.obeying(Protocol)` — the comptime expand-handle capability probe. It folds per member to a Bool
# (does the member's type conform to the protocol, structurally OR by declaration), and the enclosing
# comptime `if` PRUNES the untaken branch at monomorphization — so a call that is only valid for an
# obeyer (here `.cmp()`, which only Comparable types have) never reaches codegen for a non-obeyer.
# (`obeying` — not the `obeys` keyword — so it parses as an ordinary member name.)

record Blob
  v: S32

record Probe
  n: S32
  b: Blob

# Every field's type has a synthesized `serialize()`, so all obey Serializable structurally.
routine ser_report[T](value: T) -> Text
  var out = ""
  expand m in memvarof(T)
    if m.obeying(Serializable)
      out = out + m.name + ":ser "
    else
      out = out + m.name + ":raw "
  return out

# `S32` obeys Comparable; the plain record `Blob` does not (no `cmp`). The `.cmp()` call in the THEN
# branch is comptime-pruned for `Blob` — if pruning failed, `Blob.cmp` would be an undefined-symbol
# codegen error. Compiling at all proves the prune.
routine cmp_report[T](value: T) -> Text
  var out = ""
  expand m in memvarof(T)
    if m.obeying(Comparable)
      discard value.${m.name}.cmp(you: value.${m.name})
      out = out + m.name + ":cmp "
    else
      out = out + m.name + ":nocmp "
  return out

routine start()
  var p = Probe(n: 7s32, b: Blob(v: 9s32))
  show(ser_report[Probe](value: p))
  show(cmp_report[Probe](value: p))
  show("DONE")
  return
