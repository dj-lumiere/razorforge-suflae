module Tests/Stdlib/SharedAccessApi
import IO/Console
import BuilderService

entity Counter
  value: S64

routine Counter.bump(inc: S64)
  me.value = me.value + inc
  return

routine start()
  var s = Counter(value: 10).share[MultiRead]()

  # shared (multi-reader) access
  using s.inspect() as v
    show(f"inspect value: {v.value}")

  # exclusive (read/write) access
  using s.claim() as c
    c.bump(inc: 5)

  using s.inspect() as v2
    show(f"after bump: {v2.value}")

  show("DONE")
  return