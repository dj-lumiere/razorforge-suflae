module Tests/Stdlib/GenericParamNameCollisionApi
import IO/Console

# Regression lock ([[generic-parameter identity = SLOT]]): a user type NAMED like ANY generic parameter
# used in the stdlib must never be confused with that parameter — not in the universal derives, not in
# numeric width helpers, not in channel/buffer `data_size` folds, and not in generic-ROUTINE signatures
# resolved cross-module (a `record U` must not hijack the `U` in `Iterable[T].accumulate[U]`, a `record K`
# the `K` in Dict routines, etc.). Defining these records is enough to trigger every collision path when
# the rest of the harness (IterTools / Dict / channels / d128) is compiled alongside.

record T
  a: S32
record K
  x: Text
record U
  a: S32
record V
  a: S32
record N
  a: S32
record M
  a: S32
record SE
  a: S32
record Pair[X, Y]
  first: X
  second: Y
record mydict[k, v]
  key: k
  val: v

routine start()
  show(T(a: 1).represent())
  show(K(x: "k").represent())
  show(U(a: 2).represent())
  show(Pair[Text, S32](first: "p", second: 7).represent())
  show(mydict[Text, S32](key: "a", val: 42).represent())
  show((1.0_d128).erf().represent())
  return
