module Tests/Stdlib/TextApi
import IO/Console

routine start()
  var s = "hello, world"
  show(f"s: {s}")
  show(f"size: {s.count()}")
  show(f"is_empty: {s.is_empty()}")

  # contains / starts_with / ends_with
  show(f"contains 'world': {s.contains(value: "world")}")
  show(f"contains 'absent': {s.contains(value: "absent")}")
  show(f"starts_with 'hello': {s.starts_with(value: "hello")}")
  show(f"ends_with 'world': {s.ends_with(value: "world")}")

  # Concatenation
  var a = "foo"
  var b = "bar"
  var c = a + b
  show(f"concat: {c}")

  # Equality
  show(f"'abc' == 'abc': {"abc" == "abc"}")
  show(f"'abc' == 'abd': {"abc" == "abd"}")

  # Empty
  var empty = ""
  show(f"empty is_empty: {empty.is_empty()}")
  show(f"empty count: {empty.count()}")

  show("DONE")
  return
