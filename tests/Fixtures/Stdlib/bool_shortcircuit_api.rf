module Tests/Stdlib/BoolShortCircuitApi
import IO/Console

# `and` / `or` short-circuit: the right operand is not evaluated when the left
# already determines the result. Observable via a side-effecting probe.

var probe_count = 0_s64

routine probe(label: Text, value: Bool) -> Bool
  probe_count = probe_count + 1
  show(f"  probe({label})={value}, count={probe_count}")
  return value

routine reset()
  probe_count = 0_s64
  return

routine start()
  show("--- `and` short-circuit on false ---")
  reset()
  var r1 = probe(label: "a", value: false) and probe(label: "b", value: true)
  show(f"r1 = {r1}, probe_count={probe_count}")

  show("--- `and` full evaluation when both true ---")
  reset()
  var r2 = probe(label: "a", value: true) and probe(label: "b", value: true)
  show(f"r2 = {r2}, probe_count={probe_count}")

  show("--- `or` short-circuit on true ---")
  reset()
  var r3 = probe(label: "a", value: true) or probe(label: "b", value: false)
  show(f"r3 = {r3}, probe_count={probe_count}")

  show("--- `or` full evaluation when first false ---")
  reset()
  var r4 = probe(label: "a", value: false) or probe(label: "b", value: true)
  show(f"r4 = {r4}, probe_count={probe_count}")

  show("DONE")
  return
