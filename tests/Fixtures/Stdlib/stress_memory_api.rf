module Tests/Stdlib/StressMemoryApi
import IO/Console

# Stress test: large add/remove loop should leave the container in a clean state.
# No memory-leak instrumentation here — we verify behavior invariants only:
#   * after add N + remove N, count == 0
#   * intermediate counts are correct
#   * lookups for removed keys return false
routine start()
  var l = []
  var i = 0_s64
  loop
    if i >= 10_000_s64
      break
    l.add_last(value: i)
    i = i + 1_s64
  show(f"after 10000 add_last, list count: {l.count()}")

  # Pop them all
  i = 0_s64
  loop
    if i >= 10_000_s64
      break
    discard l.remove_first!()
    i = i + 1_s64
  show(f"after 10000 remove_first!, list count: {l.count()}")
  show(f"is_empty: {l.is_empty()}")

  # Set: add N, remove N
  var s: Set[S64] = Set[S64]()
  i = 0_s64
  loop
    if i >= 1_000_s64
      break
    discard s.add(value: i)
    i = i + 1_s64
  show(f"set after 1000 add: {s.count()}")

  i = 0_s64
  loop
    if i >= 1_000_s64
      break
    discard s.remove(value: i)
    i = i + 1_s64
  show(f"set after 1000 remove: {s.count()}")
  show(f"set contains 500 after clear: {500_s64 in s}")

  show("DONE")
  return
