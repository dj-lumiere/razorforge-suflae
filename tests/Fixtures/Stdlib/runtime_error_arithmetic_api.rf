module Tests/Stdlib/RuntimeErrorArithmeticApi
import IO/Console

# Runtime arithmetic errors caught via the stdlib `try_*` family
# (`try_add`/`try_sub`/`try_mul`/`try_pow` etc.) and `try_*` on division/abs.
# These are the safe (`try_`) variants of the failable operator methods
# (`add!`/`sub!`/`mul!`/`floordiv!`/`mod!`/`pow!`/`neg!`/`abs!`), so they
# are called in method form on the receiver.
routine start()
  # --- Checked overflow ---
  show(f"try_add S64_MAX + 1: {try S64_MAX.add(you: 1_s64)}")
  show(f"try_add S64_MAX + 0: {try S64_MAX.add(you: 0_s64)}")
  show(f"try_sub S64_MIN - 1: {try S64_MIN.sub(you: 1_s64)}")
  show(f"try_mul S64_MAX * 2: {try S64_MAX.mul(you: 2_s64)}")
  show(f"try_mul S64_MAX * 1: {try S64_MAX.mul(you: 1_s64)}")
  show(f"try_pow 2 ** 62: {try (2_s64).pow(exp: 62_s64)}")
  show(f"try_pow 2 ** 63: {try (2_s64).pow(exp: 63_s64)}")

  # --- U64 unsigned underflow ---
  show(f"try_sub 0u64 - 1: {try (0_u64).sub(you: 1_u64)}")
  show(f"try_sub 5u64 - 3: {try (5_u64).sub(you: 3_u64)}")

  # --- Division: by zero throws ---
  show(f"try_div 10 / 0: {try (10_s64).floordiv(you: 0_s64)}")
  show(f"try_div 10 / 2: {try (10_s64).floordiv(you: 2_s64)}")
  show(f"try_mod 10 % 0: {try (10_s64).mod(you: 0_s64)}")
  show(f"try_mod 10 % 3: {try (10_s64).mod(you: 3_s64)}")

  # --- Unary -: S64_MIN negation overflows ---
  show(f"try_neg S64_MIN: {try S64_MIN.neg()}")
  show(f"try_neg 5: {try (5_s64).neg()}")

  # --- abs on S64_MIN ---
  show(f"try_abs S64_MIN: {try S64_MIN.abs()}")
  show(f"try_abs -5: {try (-5_s64).abs()}")

  # --- Operator-form recovery: `try a + b` ≡ `try a.add(you: b)` (checked-arith operator
  #     overflow is recovered as a whole-expression composition, not just the method form) ---
  show(f"try + overflow: {try S64_MAX + 1_s64}")
  show(f"try + ok: {try S64_MAX + 0_s64}")
  show(f"try * overflow: {try S64_MAX * 2_s64}")
  show(f"try // by zero: {try 10_s64 // 0_s64}")
  show(f"try // ok: {try 10_s64 // 2_s64}")
  show(f"try % by zero: {try 10_s64 % 0_s64}")
  # nested checked-arith composition: (S64_MAX + 1) overflows before the divide
  show(f"try nested: {try (S64_MAX + 1_s64) // 2_s64}")
  # grab keeps the caught crashable
  var g = grab S64_MAX * 2_s64
  when g
    is IntegerOverflowError => show("grab *: caught IntegerOverflowError")
    is S64 n                => show(f"grab *: {n}")
    else e                  => show("grab *: other")

  show("DONE")
  return
