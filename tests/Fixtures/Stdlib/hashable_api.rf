module Tests/Stdlib/HashableApi
import IO/Console

# Records hand-write Equatable/Hashable (auto-derivation is reserved for tuple/choice/flags).
# We can't observe raw hash bytes (xxHash64 implementation detail), but we can check the invariants:
#   * equal values have equal hashes
#   * unequal values typically differ (probabilistic, but ours are simple)
# and that Set/Dict keyed by records work end-to-end (covered elsewhere).

record Point obeys Equatable, Hashable
  x: S64
  y: S64

routine Point.eq(you: Point) -> Bool
  return me.x == you.x and me.y == you.y

routine Point.hash(k0: U64, k1: U64) -> U64
  return LLVM::reinterpret_bits[S64, U64](me.x) ^ LLVM::reinterpret_bits[S64, U64](me.y)

routine start()
  var p = Point(x: 1, y: 2)
  var q = Point(x: 1, y: 2)
  var r = Point(x: 3, y: 4)

  show(f"p == q: {p == q}")
  show(f"p == r: {p == r}")
  show(f"p.hash() == q.hash(): {p.hash(k0: 0_u64, k1: 0_u64) == q.hash(k0: 0_u64, k1: 0_u64)}")
  show(f"p.hash() == r.hash(): {p.hash(k0: 0_u64, k1: 0_u64) == r.hash(k0: 0_u64, k1: 0_u64)}")

  # Records can be used as Dict/Set keys
  var s = {p}
  show(f"set contains p: {p in s}")
  show(f"set contains q (equal to p): {q in s}")
  show(f"set contains r: {r in s}")

  show("DONE")
  return
