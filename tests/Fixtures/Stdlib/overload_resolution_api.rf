module Tests/Stdlib/OverloadResolutionApi
import IO/Console

# Same-name routines with different param types/counts. Resolution picks by
# argument types.
routine describe(n: S64) -> Text
  return f"int:{n}"

routine describe(t: Text) -> Text
  return f"text:{t}"

routine describe(b: Bool) -> Text
  return f"bool:{b}"

routine describe(a: S64, b: S64) -> Text
  return f"pair:{a},{b}"

routine start()
  show(describe(n: 42))
  show(describe(t: "hello"))
  show(describe(b: true))
  show(describe(a: 1, b: 2))

  # Generic vs specific
  show(describe(n: 0))
  show(describe(t: ""))

  show("DONE")
  return
