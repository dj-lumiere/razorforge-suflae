module Tests/Stdlib/B16Api

import IO/Console

# B16 (half-precision) end-to-end coverage. The transcendental-across-a-call loop below is the
# case that previously miscompiled on x86-64 without B16C (the half accumulator decayed to 0);
# the toolchain now emits `-mf16c` on x86-64, so the sum must be the correct ~120, never 0/NaN.

routine start()
  # Exact conversions and arithmetic (hand-verifiable, no rounding).
  show(B32(from: B16(from: 1.5_b32)))                          # 1.5
  show(B32(from: B16(from: 0.5_b32) + B16(from: 0.25_b32)))    # 0.75
  show(B32(from: B16(from: 2.0_b32) * B16(from: 3.0_b32)))     # 6
  show(B32(from: B16(from: 10.0_b32) - B16(from: 4.0_b32)))    # 6
  show(B32(from: B16_MAX))                                     # 65504
  show(B32(from: B16(from: 4.0_b32).sqrt_unchecked()))         # 2

  # Transcendental called in a loop with a live B16 accumulator (the regression case).
  var base = B16(from: 3.0_b32)
  var tsum = B16(from: 0.0_b32)
  var i = 0_s64
  while i < 6_s64
    tsum = tsum + base.exp_unchecked()
    i = i + 1_s64
  show(B32(from: tsum))                                        # ~120 (6 * B16(exp 3)), NOT 0
  return
