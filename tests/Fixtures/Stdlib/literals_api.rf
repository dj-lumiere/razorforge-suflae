module Tests/Stdlib/LiteralsApi
import IO/Console
import Numerics.[Integer, Decimal, Complex, Real, C64, C128, C256]

# Exercises every literal token form the tokenizer produces (see src/01.Tokenizer/TokenType.cs):
# signed/unsigned fixed-width integers, Address, arbitrary-precision Integer (`n`),
# number bases + digit separators, floats, fixed + arbitrary-precision Decimal (`dn`),
# Bool, Text, Character, and ByteLetter literals.
routine start()
  # --- Signed integers (S8..S128) ---
  show(f"s8: {42_s8}")
  show(f"s16: {1000_s16}")
  show(f"s32: {100000_s32}")
  show(f"s64: {10000000000_s64}")
  show(f"s128: {170141183460469231731687303715884105727_s128}")
  show(f"s64 neg: {-42_s64}")

  # --- Unsigned integers (U8..U128) ---
  show(f"u8: {255_u8}")
  show(f"u16: {65535_u16}")
  show(f"u32: {4000000000_u32}")
  show(f"u64: {18000000000000000000_u64}")
  show(f"u128: {340282366920938463463374607431768211455_u128}")

  # --- Address ---
  show(f"addr: {4096_addr}")

  # --- Arbitrary-precision Integer (n) ---
  show(f"n: {42n}")
  show(f"n big: {123456789012345678901234567890n}")
  show(f"n grouped: {1_000_000n}")

  # --- Number bases + separators ---
  show(f"hex: {0xFF_u32}")
  show(f"hex mixed: {0xDEAD_BEEF_u32}")
  show(f"binary: {0b1010_u8}")
  show(f"sep: {1_234_567_s64}")

  # --- Floats (B16..B128) ---
  show(f"b16: {1.5_b16}")
  show(f"b32: {3.14_b32}")
  show(f"b64: {2.5_b64}")
  show(f"b128: {1.25_b128}")
  show(f"sci: {1.5e3_b64}")

  # --- Decimals (D32..D128) ---
  show(f"d32: {3.5_d32}")
  show(f"d64: {2.5_d64}")
  show(f"d128: {1.25_d128}")

  # --- Arbitrary-precision Decimal (dn) ---
  show(f"dn: {3.14dn}")
  show(f"dn exact: {0.1dn + 0.2dn}")

  # --- Imaginary literal (width-less `i`) -> pure-imaginary complex ---
  # No context -> defaults to C128 (2xB64). The `_i` spelling is accepted too.
  show(f"i default: {2.0i}")
  show(f"i sep: {4.0_i}")
  # Natural `real + imag*i` construction: the real literal fills the real part, `i` the imaginary,
  # and the type comes from context (default C128).
  var c_default = 3 + 4i
  show(f"c default: {c_default}")
  var c64: C64 = 1 + 3i
  show(f"c in C64: {c64}")
  var c256: C256 = 2 + 5i
  show(f"c in C256: {c256}")
  var carb: Complex = 3 + 6i
  show(f"c in Complex: {carb}")

  # --- Bool ---
  show(f"true: {true}")
  show(f"false: {false}")

  # --- Text / Character / ByteLetter / Bytes ---
  var t: Text = "hello"
  show(f"text: {t}")
  show(f"char: {'A'}")
  show(f"byte: {b'x'}")
  var bv: Bytes = b"hi"
  show(f"bytes: {bv}")

  # --- Duration literals (w/d/h/m/s/ms/us/ns) ---
  show(f"dur_w: {2w}")
  show(f"dur_d: {3d}")
  show(f"dur_h: {4h}")
  show(f"dur_m: {5m}")
  show(f"dur_s: {6s}")
  show(f"dur_ms: {7ms}")
  show(f"dur_us: {8us}")
  show(f"dur_ns: {9ns}")

  # --- ByteSize literals (b/kb/kib/mb/mib/gb/gib) ---
  show(f"bs_b: {100b}")
  show(f"bs_kb: {8kb}")
  show(f"bs_kib: {8kib}")
  show(f"bs_mb: {2mb}")
  show(f"bs_mib: {2mib}")
  show(f"bs_gb: {1gb}")
  show(f"bs_gib: {1gib}")

  show("DONE")
  return
