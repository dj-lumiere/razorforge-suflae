module Tests/Stdlib/RealEngineApi

import IO/Console
import Numerics.[Real]

# Broad coverage of the Real surface: construction, parsing, exact and rounded arithmetic, the
# transcendentals, the precision variants, rounding to integers, B64 round trips and the decimal
# rendering (plain, 0.x, trailing zeros and exponential forms).
routine start()
  var two = Real(value: 2_s64)
  var three = Real(value: 3_s64)
  var half = Real(value: 1_s64) / two
  var neg_seven = Real(value: -7_s64)
  var big = Real(value: 9_223_372_036_854_775_807_s64)

  show("-- construction / parsing --")
  show(f"s64 max: {big}")
  show(f"b64 0.1: {Real(value: 0.1_b64)}")
  show(f"b64 -2.5e-310: {Real(value: -2.5e-310_b64)}")
  show(f"literal 0.1: {Real.from_literal(text: "0.1")}")
  show(f"literal 6.02214076e23: {Real.from_literal(text: "6.02214076e23")}")
  show(f"parse 2.5: {Real!(text: "2.5")}")
  show(f"parse -0.75: {Real!(text: "-0.75")}")
  show(f"parse 1e3: {Real!(text: "1e3")}")
  show(f"parse ff (16): {Real!(text: "ff", radix: 16_s32)}")
  show(f"parse 101.1 (2): {Real!(text: "101.1", radix: 2_s32)}")

  show("-- arithmetic --")
  show(f"big*big: {big * big}")
  show(f"big+half: {big + half}")
  show(f"1/3: {Real(value: 1_s64) / three}")
  show(f"-7/2: {neg_seven / two}")
  show(f"1/0: {Real(value: 1_s64) / Real()}")
  show(f"-1/0: {Real(value: -1_s64) / Real()}")
  show(f"0/0: {Real() / Real()}")
  show(f"neg: {neg_seven.neg()}")
  show(f"abs: {neg_seven.abs()}")
  show(f"divide 20 digits: {Real(value: 2_s64).divide(you: three, precision: 20_s32)}")

  show("-- roots / exp / log / pow --")
  show(f"sqrt 2: {two.sqrt()}")
  show(f"sqrt -1: {Real(value: -1_s64).sqrt()}")
  show(f"sqrt 2 (30): {two.sqrt(precision: 30_s32)}")
  show(f"exp 1 (40): {Real.one().exp(precision: 40_s32)}")
  show(f"log 10 (40): {Real(value: 10_s64).log(precision: 40_s32)}")
  show(f"log 0: {Real().log()}")
  show(f"pow 2^10: {two.pow!(exp: Real(value: 10_s64))}")
  show(f"pow 2^-3: {two.pow!(exp: Real(value: -3_s64))}")
  show(f"pow 3^0.5 (25): {three.pow(exp: half, precision: 25_s32)}")
  show(f"pow 4^0.5: {Real(value: 4_s64).pow!(exp: half)}")
  show(f"pow -2^3: {Real(value: -2_s64).pow!(exp: three)}")
  show(f"pow 10^-2: {Real(value: 10_s64).pow!(exp: Real(value: -2_s64))}")
  show(f"exp2 10: {Real(value: 10_s64).exp2()}")
  show(f"exp10 3: {three.exp10()}")
  show(f"cbrt 27: {Real(value: 27_s64).cbrt(precision: 30_s32)}")
  show(f"cbrt -2 (30): {Real(value: -2_s64).cbrt(precision: 30_s32)}")

  show("-- trig --")
  show(f"sin 1 (30): {Real.one().sin(precision: 30_s32)}")
  show(f"cos 1 (30): {Real.one().cos(precision: 30_s32)}")
  show(f"tan 1 (30): {Real.one().tan(precision: 30_s32)}")
  show(f"sin 100 (30): {Real(value: 100_s64).sin(precision: 30_s32)}")
  show(f"asin 0.5 (30): {half.asin(precision: 30_s32)}")
  show(f"acos 0.5 (30): {half.acos(precision: 30_s32)}")
  show(f"acos 1: {Real.one().acos()}")
  show(f"atan 2 (30): {two.atan(precision: 30_s32)}")
  show(f"atan2 q1 (30): {atan2(y: Real.one(), x: two, precision: 30_s32)}")
  show(f"atan2 q2 (30): {atan2(y: Real.one(), x: two.neg(), precision: 30_s32)}")
  show(f"atan2 q3 (30): {atan2(y: Real.one().neg(), x: two.neg(), precision: 30_s32)}")
  show(f"atan2 0,1: {atan2(y: Real(), x: Real.one())}")
  show(f"pi (50): {Real.pi(precision: 50_s32)}")
  show(f"e (50): {Real.e(precision: 50_s32)}")

  show("-- hyperbolic / log bases / hypot --")
  show(f"sinh 1 (30): {Real.one().sinh(precision: 30_s32)}")
  show(f"cosh 1 (30): {Real.one().cosh(precision: 30_s32)}")
  show(f"tanh 1 (30): {Real.one().tanh(precision: 30_s32)}")
  show(f"asinh 1 (30): {Real.one().asinh(precision: 30_s32)}")
  show(f"acosh 2 (30): {two.acosh(precision: 30_s32)}")
  show(f"atanh 0.5 (30): {half.atanh(precision: 30_s32)}")
  show(f"log2 10 (30): {Real(value: 10_s64).log2(precision: 30_s32)}")
  show(f"log10 2 (30): {two.log10(precision: 30_s32)}")
  show(f"log2 1024: {Real(value: 1024_s64).log2()}")
  show(f"hypot 3,4: {hypot(x: three, y: Real(value: 4_s64))}")
  show(f"hypot 1,1 (30): {hypot(x: Real.one(), y: Real.one(), precision: 30_s32)}")

  show("-- rounding to integers --")
  var p25 = Real!(text: "2.5")
  var m25 = Real!(text: "-2.5")
  var m05 = Real!(text: "-0.5")
  show(f"floor 2.5 / -2.5: {p25.floor()} {m25.floor()}")
  show(f"ceil 2.5 / -2.5: {p25.ceil()} {m25.ceil()}")
  show(f"trunc 2.5 / -2.5: {p25.trunc()} {m25.trunc()}")
  show(f"round 2.5 / -2.5: {p25.round()} {m25.round()}")
  show(f"rint 2.5 / -2.5 / 3.5: {p25.rint()} {m25.rint()} {Real!(text: "3.5").rint()}")
  show(f"rint -0.5: {m05.rint()}")
  show(f"frac -2.5: {m25.frac()}")

  show("-- B64 / rendering --")
  show(f"to_b64 1/3: {(Real(value: 1_s64) / three).to_b64()}")
  show(f"to_b64 big*big: {(big * big).to_b64()}")
  show(f"to_b64 -2.5e-310: {Real(value: -2.5e-310_b64).to_b64()}")
  show(f"1e400: {Real(value: 10_s64).pow!(exp: Real(value: 400_s64))}")
  show(f"1e-7: {Real(value: 10_s64).pow!(exp: Real(value: -7_s64))}")
  show(f"1e-5: {Real(value: 10_s64).pow!(exp: Real(value: -5_s64))}")
  show(f"1000: {Real(value: 1000_s64)}")
  show(f"-0.001: {Real(value: -1_s64) / Real(value: 1000_s64)}")
  show(f"places 2 of 1/3: {(Real(value: 1_s64) / three).represent_with_places(decimal_places: 2_s32)}")
  show(f"places 0 of -2.5: {m25.represent_with_places(decimal_places: 0_s32)}")

  show("-- comparison --")
  show(f"cmp: {half < two} {two > three} {half == Real!(text: "0.5")}")
  show(f"min/max: {two.min(you: three)} {two.max(you: three)}")
  show(f"is_zero/negative/positive: {Real().is_zero()} {neg_seven.is_negative()} {neg_seven.is_positive()}")
  show("DONE")
  return
