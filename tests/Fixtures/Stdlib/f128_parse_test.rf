module Tests/Stdlib/B128ParseTest
import IO/Console

# Covers Text -> B128 parse (pure RF: parse_float_components + b128_from_ratio,
# exact rational rounded once to binary128).

routine start()
  var a = B128!("3.14")
  var b = B128!("2.718281828459045")
  var c = B128!("0")
  var d = B128!("-1.5e10")
  show(f"3.14 -> {a}")
  show(f"e     -> {b}")
  show(f"0     -> {c}")
  show(f"-1.5e10 -> {d}")
  return