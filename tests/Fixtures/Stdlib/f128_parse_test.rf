module Tests/Stdlib/B128ParseTest
import IO/Console

# Covers Text -> B128 parse via rf_parse_B128. The native function uses an
# out-param ABI (void f(const char*, b128_t*)) to sidestep the Windows x64
# sret/xmm0 mismatch that would otherwise make a returned b128_t silently zero.

routine start()
  var a = B128!("3.14")
  var b = B128!("2.718281828459045")
  var c = B128!("0")
  var d = B128!("-1.5e10")
  show(f"3.14 -> {a}")
  show(f"e     -> {b}")
  show(f"0     -> {c}")
  show(f"-1.5e10 -> {d}")
  return