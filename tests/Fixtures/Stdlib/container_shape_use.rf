module Tests/Stdlib/ContainerShapeUse

import IO/Console

# While an `each` loop goes through a container, or a statement works on one of its entity elements, the
# builder rejects anything that could add to or remove from that container (RF-S625, RF-S639). These are
# the paths that must still build and run: a change after a loop, after `break`, after a `return` out of a
# loop, a loop handing its list to a routine that only reads it, and statements that reach elements.

entity Box
  n: S64

routine first_big(xs: Modifying[List[S64]]) -> S64
  each x in xs
    if x > 5
      return x
  return 0

routine start()
  var nums = List[S64]()
  nums.add_last(value: 1)
  nums.add_last(value: 7)
  nums.add_last(value: 3)
  var total = 0
  each x in nums
    total = total + x
  nums.add_last(value: 10)
  each x in nums
    if x == 7
      break
  nums.add_last(value: 11)
  show(f"loops: total={total} count={nums.count()}")

  var big = first_big(xs: nums.modify())
  nums.add_last(value: 12)
  show(f"after return in loop: big={big} count={nums.count()}")

  var boxes = List[Box]()
  boxes.add_last(value: Box(n: 1))
  boxes[0].n = 5
  var seen = boxes[0].n
  if boxes[0].n > 3
    boxes.add_last(value: Box(n: 2))
  boxes.add_last(value: Box(n: 3))
  show(f"element access: seen={seen} count={boxes.count()}")
  show("DONE")
  return
