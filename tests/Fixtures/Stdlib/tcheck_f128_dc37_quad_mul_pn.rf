module Tests/Stdlib/TcheckF128Dc37QuadMulPn

import IO/Console

# Sign-matrix coverage for the macOS octuple sub=add miscompile: quad (+A)*(-B) mixed-sign (contrast).
# Prints the U128 bit pattern of the result (bit-perfect).
routine start()
  show((9.876543210987654321098765432109876_f128).to_uf().mul(you: (1.234567890123456789012345678901234_f128).to_uf().neg()).to_f128().to_bits())
  return
