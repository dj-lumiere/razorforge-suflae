module Tests/Stdlib/ChannelTryFeedApi

# v0.3.0 channels — graceful (non-throwing) send. Because `send!` is failable, the builder auto-
# generates `try_send` (returns Bool: true on success, false instead of throwing ChannelClosedError).
# This is the channel half of the fallible send/receive surface (the receive half is `try_emit` on the
# drain iterator, used by for-loops). No hand-written variant needed.

import IO/Console

routine start()
  var (feeder, hop) = make_channel[S64](capacity: 4)
  danger
    discard feeder.try_send(item: 7)         # ok -> true
    discard feeder.try_send(item: 8)
  feeder.close()
  var after_close = feeder.try_send(item: 9)  # closed -> false, no throw
  show(f"after_close={after_close}")

  var total = 0_s64
  each v in hop
    total = total + v
  show(f"drained={total}")                    # 7 + 8 = 15 (the post-close send was rejected)
  return
