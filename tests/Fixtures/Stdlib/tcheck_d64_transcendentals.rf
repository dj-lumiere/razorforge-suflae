module Tests/Stdlib/TcheckD64Transcendentals

import IO/Console

# Merged D64 softfloat checks (was tcheck_d64_{sin,cos,exp}; consolidated post-fix).
# Extended to cover the composite transcendentals (cos/tan/hyperbolic/log2/log10)
# whose internal exp/log/expm1/log1p iteration counts are sized to D64's 54-bit
# target rather than F128's full 113-bit. Expected values are the correctly-rounded
# D64 results (captured from the full-count build); reduced counts must reproduce them.
routine start()
  show((1.0_d64).sin().represent())
  show((1.0_d64).cos().represent())
  show((1.0_d64).exp_unchecked().represent())
  show((1.0_d64).tan().represent())
  show((1.0_d64).sinh_unchecked().represent())
  show((1.0_d64).cosh_unchecked().represent())
  show((1.0_d64).tanh().represent())
  show((0.5_d64).atanh_unchecked().represent())
  show((7.0_d64).log2_unchecked().represent())
  show((7.0_d64).log10_unchecked().represent())
  show((2.5_d64).asinh().represent())
  show((2.5_d64).acosh_unchecked().represent())
  show((0.25_d64).exp2_unchecked().represent())
  show((0.25_d64).exp10_unchecked().represent())
  # erf/erfc run the continued fraction at F128 width with reduced levels (lm=50/lt=64); these
  # cover the mid branch (|z|<3.1) and the tail branch (|z|>=3.1) and must match the octuple result.
  show((1.0_d64).erf().represent())
  show((0.5_d64).erf().represent())
  show((3.5_d64).erf().represent())
  show((1.0_d64).erfc().represent())
  show((4.0_d64).erfc().represent())
  # tgamma/lgamma run the octuple Stirling core at reduced degrees (sdeg=12/logn=10/sinn=9/expn=10);
  # cover small-arg augmentation, large arg, and the reflection path (negative non-integer).
  show((0.5_d64).tgamma_unchecked().represent())
  show((5.0_d64).tgamma_unchecked().represent())
  show((-2.5_d64).tgamma_unchecked().represent())
  show((10.0_d64).lgamma().represent())
  show((-2.5_d64).lgamma().represent())
  # atan/asin/acos run atan2 at reduced degree/depth (deg=12/depth=2); cover large-arg atan and
  # near-1 asin/acos (the octant-folded reduction stress points).
  show((100.0_d64).atan().represent())
  show((-2.0_d64).atan().represent())
  show((0.9_d64).asin_unchecked().represent())
  show((0.99_d64).acos_unchecked().represent())
  return
