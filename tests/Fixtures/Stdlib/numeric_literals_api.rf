module Tests/Stdlib/NumericLiteralsApi
import IO/Console

# Numeric literal forms — decimal, hex, binary, octal (if any), with type suffixes
# and digit separators.
routine start()
  # Decimal
  show(f"decimal: {12345_s64}")
  show(f"decimal with separator: {1_234_567_s64}")
  show(f"negative: {-42_s64}")

  # Hex
  show(f"hex 0xff: {0xff_u32}")
  show(f"hex 0xDEAD_BEEF: {0xDEAD_BEEF_u32}")
  show(f"hex (mixed case): {0xAbCd_u32}")

  # Binary
  show(f"binary 0b1010: {0b1010_u8}")
  show(f"binary with separator: {0b1100_1100_u8}")

  # Same value, different bases
  show(f"255 == 0xff: {255_u32 == 0xff_u32}")
  show(f"255 == 0b1111_1111: {255_u32 == 0b1111_1111_u32}")

  # Float literals
  show(f"float: {3.14_f64}")
  show(f"scientific: {1.5e3_f64}")
  show(f"neg scientific: {2.5e-2_f64}")

  # Bool
  show(f"true: {true}")
  show(f"false: {false}")

  show("DONE")
  return
