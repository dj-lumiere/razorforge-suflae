module Tests/Stdlib/SortedListApi
import IO/Console
import Collections

# SortedList iterates in sorted order -> deterministic output.
# Unlike SortedSet, duplicates are preserved.
routine start()
  var sl = SortedList[S64]()
  show(f"new size: {sl.count()}")
  show(f"is_empty: {sl.is_empty()}")

  discard sl.add(value: 30)
  discard sl.add(value: 10)
  discard sl.add(value: 20)
  discard sl.add(value: 10)  # duplicate -> preserved
  show(f"after 30/10/20/10, size: {sl.count()}")

  # iteration is sorted
  each x in sl
    show(f"  iter: {x}")

  # Rank access (O(log n) — named to signal cost)
  show(f"sl[0]: {(try sl.get_by_rank(rank: 0_u64))!!}")
  show(f"sl[1]: {(try sl.get_by_rank(rank: 1_u64))!!}")
  show(f"sl[2]: {(try sl.get_by_rank(rank: 2_u64))!!}")
  show(f"sl[3]: {(try sl.get_by_rank(rank: 3_u64))!!}")

  show(f"contains 20: {sl have 20}")
  show(f"contains 99: {sl have 99}")

  show("DONE")
  return
