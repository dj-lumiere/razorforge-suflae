module Tests/Stdlib/UfEngineBits

import IO/Console

# Exact-output regression lock for every consumer of the UnpackedFloat soft-float engine
# (B128 at W=192/W=128, D128 via the W=192 bridge, D64 via the W=128 bridge). B128 prints raw
# bits so a one-ulp drift fails. Captured from the pre-limb engine (U128/U192 mantissas) — must stay bit-identical.
routine start()
  show(f"b128 sin(0.3) = {(0.3_b128).sin().to_bits()}")
  show(f"b128 sin(1.7) = {(1.7_b128).sin().to_bits()}")
