module Tests/Stdlib/NumericDecimalApi
import IO/Console

# Exercises D32, D64, D128 — IEEE 754 decimal arithmetic (no binary FP rounding).
routine start()
  var d32: D32 = 1.10_d32
  var d64: D64 = 0.1_d64 + 0.2_d64
  var d128: D128 = 1.0_d128 / 3.0_d128

  show(f"D32: {d32}")
  show(f"D64 0.1 + 0.2: {d64}")
  show(f"D128 1/3: {d128}")

  # Comparison & arithmetic
  show(f"D64 0.1 + 0.2 == 0.3: {(0.1_d64 + 0.2_d64) == 0.3_d64}")
  show(f"D64 add: {0.5_d64 + 0.5_d64}")
  show(f"D64 mul: {2.0_d64 * 3.0_d64}")
  show(f"D64 div: {1.0_d64 / 4.0_d64}")

  show("DONE")
  return
