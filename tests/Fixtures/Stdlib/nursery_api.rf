module Tests/Stdlib/NurseryApi

# v0.2.x structured concurrency — Nursery[T]. A Nursery is a named scope that OWNS a set of in-flight
# Agents; its children cannot outlive it. Exit default is RF-native abandon-all (dropping the scope
# abandons in-flight children); waiting for results is opt-in via harvest!(); cooperative cancellation
# is via cancel() + the cancellation_requested() poll. This fixture exercises all three.

import IO/Console

# Coroutine child: parks `x` ms, then returns x*10.
suspended routine compute(x: S64) -> S64
  waitfor(Duration.from_milliseconds(ms: x))
  return x * 10

# Thread child: parks `x` ms on its own OS thread, then returns x+100.
threaded routine twork(x: S64) -> S64
  waitfor(Duration.from_milliseconds(ms: x))
  return x + 100

# Cooperative worker: spins, polling for cancellation, and returns -1 the moment it is asked to stop.
# The bound is only a safety ceiling — in practice it exits at the first poll after cancel().
threaded routine cancellable() -> S64
  var i = 0_s64
  while i < 1000000000
    if cancellation_requested()
      return -1
    i = i + 1
  return i

# Builds a scope, adopts a long-running child, and returns WITHOUT harvesting. At this routine's
# return the Nursery is torn down and the un-awaited child is abandoned cleanly (no orphan, no
# double-free) — the no-orphans guarantee, enforced by ownership alone.
routine spawn_and_abandon()
  var pool = Nursery[S64]()
  pool.add(agent: compute(x: 100000))
  return

routine start()
  # 1. Abandon-on-exit: the scope drops a never-awaited child cleanly.
  spawn_and_abandon()
  show("abandon => ok")

  # 2. harvest! over an all-coroutine scope: results come back in ADOPTION order even though the
  #    middle child finishes first.
  var coros = Nursery[S64]()
  coros.add(agent: compute(x: 30))
  coros.add(agent: compute(x: 5))
  coros.add(agent: compute(x: 15))
  danger!
    var rs = coros.harvest!()
    show(f"coros => {rs[0]} {rs[1]} {rs[2]}")

  # 3. harvest! over a mixed coroutine + thread scope: both run at once, gathered in order.
  var mixed = Nursery[S64]()
  mixed.add(agent: compute(x: 10))
  mixed.add(agent: twork(x: 20))
  danger!
    var rs2 = mixed.harvest!()
    show(f"mixed => {rs2[0]} {rs2[1]}")

  # 4. cancel(): a worker observes the cooperative request and stops early, returning -1.
  var jobs = Nursery[S64]()
  jobs.add(agent: cancellable())
  waitfor(Duration.from_milliseconds(ms: 20))
  jobs.cancel()
  danger!
    var rc = jobs.harvest!()
    show(f"cancel => {rc[0]}")
  return
