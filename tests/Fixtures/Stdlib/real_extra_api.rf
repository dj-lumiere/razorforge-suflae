module Tests/Stdlib/RealExtraApi

import IO/Console
import Numerics.[Real]

# Regression coverage for the Real (libbf) selection/sign/exp API added in the numeric arc.
routine start()
  var r = Real(355_s64) / Real(113_s64)
  show(f"is_positive: {r.is_positive()}")
  show(f"signum: {r.signum()}")
  show(f"copysign(-1): {r.copysign(you: Real(-1_s64))}")
  show(f"min(_,3): {r.min(you: Real(3_s64))}")
  show(f"max(_,3): {r.max(you: Real(3_s64))}")
  show("DONE")
  return
