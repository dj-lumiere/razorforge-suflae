module Tests/Stdlib/ChannelWorkerPoolApi

# v0.3.0 channels — worker pool over a SharedReceiver (multi-consumer). One producer feeds 6 jobs onto a
# capacity-2 SharedReceiver; two LineWorkers (clones) draw from it — any free worker takes the next job
# (consumer fan-out, NOT broadcast: each job goes to exactly one worker). The split between workers is
# nondeterministic, but the TOTAL jobs processed is deterministic. When the producer's Sender drops,
# the channel auto-closes and both workers' `for` loops end.

import IO/Console

suspended routine feed_jobs(out: Sender[S64], n: S64) -> S64
  var i = 1_s64
  danger
    while i <= n
      out.send(item: i)
      i = i + 1
  return n

# Counts how many jobs this worker handled (sum of all workers' counts == jobs fed).
suspended routine worker(belt: SharedReceiver[S64]) -> S64
  var done = 0_s64
  each job in belt
    done = done + 1
  return done

routine start()
  var (feeder, belt) = make_shared_channel[S64](capacity: 2)

  danger
    # LAZY model: the feeder runs in the BACKGROUND (`execute`); the two workers are launched TOGETHER
    # and awaited via `gather` so they run CONCURRENTLY and split the jobs (driving them one-by-one
    # would let the first worker drain the whole belt before the second ever started). The split is
    # nondeterministic; the total is not.
    feed_jobs(out: steal feeder, n: 6).execute()
    var counts = [worker(belt: steal belt.duplicate()), worker(belt: steal belt)].gather()
    show(f"total={counts[0] + counts[1]}")
  return
