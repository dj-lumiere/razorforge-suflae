module Tests/Stdlib/RecordInplaceApi
import IO/Console

# Locks the v0.0.4 by-ref-`me` boundary across all three record representations:
#   - @llvm-type record  -> me is BY VALUE (the raw primitive), value semantics
#   - single-field record -> me is BY REF, in-place mutation propagates
#   - multi-field record  -> me is BY REF, in-place mutation propagates
# plus a nested record-field receiver (`me.inner.incr(...)`), which exercises the
# by-ref address recursion through a field chain.

# (1) @llvm-type record: HasDirectBackendType -> stays by-value. `me` is the raw i64.
@llvm("i64")
record Tagged
  pass

routine Tagged.$create(from: S64) -> Tagged
  return reinterpret_bits[S64, Tagged](from)

@readonly
routine Tagged.value() -> S64
  return reinterpret_bits[Tagged, S64](me)

@readonly
routine Tagged.with_added(n: S64) -> Tagged
  return Tagged(from: me.value() + n)

# (2) single-field struct record: by-ref, mutation propagates.
record Counter
  posted value: S64

routine Counter.bump()
  me.value += 1
  return

routine Counter.add(n: S64)
  me.value += n
  return

# (3) multi-field struct record: by-ref, mutation propagates.
record Point
  posted x: S64
  posted y: S64

routine Point.move_by(dx: S64, dy: S64)
  me.x += dx
  me.y += dy
  return

# (4) nested record field mutation, two ways the by-ref address recursion is exercised:
#     - direct nested assignment `me.inner.n = ...` (LHS address GEP-chains me -> .inner -> .n)
#     - a method call on the nested field `me.inner.incr(...)` (receiver address GEP-chains me -> .inner)
record Inner
  posted n: S64

routine Inner.incr(amount: S64)
  me.n += amount
  return

record Outer
  posted inner: Inner
  posted tag: S64

routine Outer.bump_inner()
  me.inner.n += 1
  return

routine Outer.incr_inner(amount: S64)
  me.inner.incr(amount: amount)
  return

# (5) hijack: a method writes through `me.value.hijack()`. Because `me` is by reference,
#     hijacking the field yields the caller's storage address — the injected write is visible
#     after the call (the original `=> 99` probe, now a committed regression guard).
record Box
  posted value: S64

routine Box.set_via_hijack(v: S64)
  danger!
    me.value.hijack().inject(v)
  return

routine start()
  var t = Tagged(from: 40_s64)
  var t2 = t.with_added(2_s64)
  show(f"tagged: {t.value()} {t2.value()}")

  var c = Counter(value: 0_s64)
  c.bump()
  c.bump()
  c.add(n: 10_s64)
  show(f"counter: {c.value}")

  var p = Point(x: 1_s64, y: 2_s64)
  p.move_by(dx: 3_s64, dy: 4_s64)
  show(f"point: {p.x},{p.y}")

  var o = Outer(inner: Inner(n: 5_s64), tag: 0_s64)
  o.bump_inner()
  o.incr_inner(amount: 10_s64)
  o.inner.incr(amount: 100_s64)
  show(f"nested: {o.inner.n} tag {o.tag}")

  var b = Box(value: 0_s64)
  b.set_via_hijack(v: 99_s64)
  show(f"hijack: {b.value}")
  return
