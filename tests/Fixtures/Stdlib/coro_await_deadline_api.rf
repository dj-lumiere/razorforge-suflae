module Tests/Stdlib/CoroAwaitDeadlineApi

# v0.2.0 non-blocking timed await. Inside a scheduler-driven coroutine, `task.waitfor(d).retrieve!()`
# races the worker thread against the deadline WITHOUT blocking: the coroutine parks on a deadline
# timer that is also wakeable by the worker's completion, and resumes on whichever wins. If the task
# finishes first the value comes back; if the deadline wins it throws TaskTimeoutError (here caught
# via the graceful `try_retrieve` -> None). Same call blocks with a deadline on a plain thread.

import IO/Console

threaded routine quick(x: S64) -> S64
  return x + 1

threaded routine slow(x: S64) -> S64
  waitfor(150ms)          # on the worker thread this just sleeps; outlives the 20ms deadline below
  return x + 1

suspended routine in_time() -> S64
  # Worker returns immediately, well within the 5s deadline -> parks briefly, then the value.
  return quick(x: 41).waitfor(5s).retrieve!()

suspended routine times_out() -> S64
  # Worker takes 150ms but the deadline is 20ms -> the timer wins; try_retrieve yields None.
  var r = slow(x: 41).waitfor(20ms).try_retrieve()
  when r
    is None => return 99       # timed out, as expected
    is S64 v => return v        # would be 42 if it had not timed out

routine start()
  show(f"in-time => {in_time().retrieve!()}")
  show(f"timed-out => {times_out().retrieve!()}")
  return
