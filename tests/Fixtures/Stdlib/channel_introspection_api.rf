module Tests/Stdlib/ChannelIntrospectionApi

# v0.3.0 introspection — racy snapshot queries on channels and agents. These never make a
# synchronization DECISION (the state can change the instant after you read it); they are for
# diagnostics, logging, and heuristics.

import IO/Console

suspended routine quick(x: S64) -> S64
  return x * 2

routine start()
  var (feeder, hop) = make_channel[S64](capacity: 4)
  danger
    feeder.send(item: 10)
    feeder.send(item: 20)
  show(f"cap={hop.capacity()} count={hop.count()} empty={hop.is_empty()} closed={hop.is_closed()}")

  feeder.close()
  show(f"closed_after={hop.is_closed()}")

  var total = 0_s64
  each v in hop
    total = total + v
  show(f"drained={total} empty_now={hop.is_empty()}")

  # Agent introspection: is_done flips from false (spawned, not driven) to true (after retrieve!).
  var a = quick(x: 21)
  danger
    var v = a.retrieve()
    show(f"agent_after={a.is_done()} val={v}")
  return
