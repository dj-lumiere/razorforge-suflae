module Tests/Stdlib/DpdApi
import IO/Console

# DPD (densely-packed-decimal) interchange encode/decode for D32/D64/D128. The canonical words
# below are the IEEE/Speleotrove reference encodings (e.g. decimal64 -7.50 = 0xA2300000000003D0);
# the round-trip lines confirm from_dpd(to_dpd(x)) reproduces the exact BID storage.

routine rt32(x: D32) -> Bool
  return int_eq[U32](a: D32.from_dpd(bits: x.to_dpd()).to_bits(), b: x.to_bits())
routine rt64(x: D64) -> Bool
  return int_eq[U64](a: D64.from_dpd(bits: x.to_dpd()).to_bits(), b: x.to_bits())
routine rt128(x: D128) -> Bool
  return int_eq[U128](a: D128.from_dpd(bits: x.to_dpd()).to_bits(), b: x.to_bits())

routine start()
  # canonical DPD words (shown as raw unsigned interchange values)
  show(f"d32 +0    {D32.from_components(sign: false, coeff: 0_u64, exp: 0_s64).to_dpd()}")
  show(f"d32 +1    {D32.from_components(sign: false, coeff: 1_u64, exp: 0_s64).to_dpd()}")
  show(f"d32 -7.50 {D32.from_components(sign: true, coeff: 750_u64, exp: -2_s64).to_dpd()}")
  show(f"d64 +0    {D64.from_components(sign: false, coeff: 0_u64, exp: 0_s64).to_dpd()}")
  show(f"d64 -7.50 {D64.from_components(sign: true, coeff: 750_u64, exp: -2_s64).to_dpd()}")
  show(f"d128 +0   {D128.from_components(sign: false, coeff: zero_extend[U64, U128](0_u64), exp: 0_s64).to_dpd()}")
  # round-trips across cohorts, signs, exponents, and specials
  show(f"rt d32 big   {rt32(x: D32.from_components(sign: true, coeff: 9999999_u64, exp: 90_s64))}")
  show(f"rt d32 inf   {rt32(x: D32.infinity(sign: true))}")
  show(f"rt d32 nan   {rt32(x: D32.quiet_nan())}")
  show(f"rt d64 big   {rt64(x: D64.from_components(sign: true, coeff: 9999999999999999_u64, exp: 369_s64))}")
  show(f"rt d64 frac  {rt64(x: (123.45_d64))}")
  show(f"rt d64 inf   {rt64(x: D64.infinity(sign: false))}")
  show(f"rt d128 big  {rt128(x: D128.from_components(sign: false, coeff: zero_extend[U64, U128](1234567890123456_u64), exp: -5_s64))}")
  show(f"rt d128 frac {rt128(x: (2.5_d128))}")
  show(f"rt d128 nan  {rt128(x: D128.quiet_nan())}")
  show("DONE")
  return
