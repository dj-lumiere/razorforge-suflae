module Tests/Stdlib/TcheckF128Dc36QuadAddNp

import IO/Console

# Sign-matrix coverage for the macOS octuple sub=add miscompile: quad (-A)+(+B) sub-branch (contrast).
# Prints the U128 bit pattern of the result (bit-perfect).
routine start()
  show((9.876543210987654321098765432109876_f128).to_uf().neg().add(you: (1.234567890123456789012345678901234_f128).to_uf()).to_f128().to_bits())
  return
