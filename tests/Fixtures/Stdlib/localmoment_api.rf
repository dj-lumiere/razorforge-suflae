module Tests/Stdlib/LocalMomentApi
import IO/Console

# LocalMoment: a Moment plus a UTC offset (timezone-aware wall clock).
routine start()
  var utc_offset = Duration.zero()
  var lm = LocalMoment.from_local(year: 2026, month: 1, day: 15,
                                  hour: 12, minute: 30, second: 0,
                                  offset: utc_offset)
  show(f"lm: {lm}")
  show(f"lm year: {lm.year()}")
  show(f"lm month: {lm.month()}")
  show(f"lm day: {lm.day()}")
  show(f"lm hour: {lm.hour()}")

  # Conversion to absolute Moment
  var abs_m = lm.to_moment()
  show(f"abs_m year: {abs_m.year()}")
  show(f"abs_m month: {abs_m.month()}")

  # Different offset
  var plus9 = Duration.from_hours(h: 9_s64)
  var lm_jp = LocalMoment.from_local(year: 2026, month: 1, day: 15,
                                     hour: 21, minute: 30, second: 0,
                                     offset: plus9)
  show(f"lm_jp == lm (same instant, different zone): {lm_jp.to_moment() == lm.to_moment()}")

  show("DONE")
  return
