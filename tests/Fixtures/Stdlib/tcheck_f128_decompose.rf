module Tests/Stdlib/TcheckF128Decompose

import IO/Console

# Merged softfloat-decomposition + sign-matrix probes (was tcheck_f128_dc01..dc37, split for the
# macOS/ARM hunt; consolidated post-fix to cut CI time). Bit-perfect U128 patterns, one show each.
routine start()
  show((1.234567890123456789012345678901234_f128).to_bits())
  show((1.234567890123456789012345678901234_f128).to_uf().to_f128().to_bits())
  show((1.234567890123456789012345678901234_f128).to_oct().to_f128().to_bits())
  show((1.234567890123456789012345678901234_f128).to_uf().add(you: (9.876543210987654321098765432109876_f128).to_uf()).to_f128().to_bits())
  show((1.234567890123456789012345678901234_f128).to_uf().mul(you: (9.876543210987654321098765432109876_f128).to_uf()).to_f128().to_bits())
  show((1.234567890123456789012345678901234_f128).to_uf().ldexp(e: 1_s64).to_f128().to_bits())
  show((1.234567890123456789012345678901234_f128).to_oct().add(you: (9.876543210987654321098765432109876_f128).to_oct()).to_f128().to_bits())
  show((9.876543210987654321098765432109876_f128).to_oct().sub(you: (1.234567890123456789012345678901234_f128).to_oct()).to_f128().to_bits())
  show((1.234567890123456789012345678901234_f128).to_oct().mul(you: (9.876543210987654321098765432109876_f128).to_oct()).to_f128().to_bits())
  show((9.876543210987654321098765432109876_f128).to_oct().div(you: (1.234567890123456789012345678901234_f128).to_oct()).to_f128().to_bits())
  show((1.234567890123456789012345678901234_f128).to_oct().ldexp(e: 1_s64).to_f128().to_bits())
  show((1.234567890123456789012345678901234_f128).to_oct().ldexp(e: 200_s64).to_f128().to_bits())
  show((1.234567890123456789012345678901234_f128).to_oct().rint().to_f128().to_bits())
  show((1.234567890123456789012345678901234_f128).to_oct().fma(b: (9.876543210987654321098765432109876_f128).to_oct(), c: (3.141592653589793238462643383279503_f128).to_oct()).to_f128().to_bits())
  show((1.0_f128).exp2_unchecked().to_bits())
  show(if (false).xor(you: true) then 1_s64 else 0_s64)
  show(if (false != true) then 1_s64 else 0_s64)
  show((1.234567890123456789012345678901234_f128).to_oct().neg().to_f128().to_bits())
  show((9.876543210987654321098765432109876_f128).to_oct().add(you: (1.234567890123456789012345678901234_f128).to_oct().neg()).to_f128().to_bits())
  show((9.876543210987654321098765432109876_f128).to_oct().neg().add(you: (1.234567890123456789012345678901234_f128).to_oct()).to_f128().to_bits())
  show((9.876543210987654321098765432109876_f128).to_oct().add(you: (1.234567890123456789012345678901234_f128).to_oct()).to_f128().to_bits())
  show((9.876543210987654321098765432109876_f128).to_oct().neg().add(you: (1.234567890123456789012345678901234_f128).to_oct().neg()).to_f128().to_bits())
  show((9.876543210987654321098765432109876_f128).to_oct().sub(you: (1.234567890123456789012345678901234_f128).to_oct().neg()).to_f128().to_bits())
  show((9.876543210987654321098765432109876_f128).to_oct().neg().sub(you: (1.234567890123456789012345678901234_f128).to_oct()).to_f128().to_bits())
  show((9.876543210987654321098765432109876_f128).to_oct().neg().sub(you: (1.234567890123456789012345678901234_f128).to_oct().neg()).to_f128().to_bits())
  show((1.234567890123456789012345678901234_f128).to_oct().sub(you: (9.876543210987654321098765432109876_f128).to_oct()).to_f128().to_bits())
  show((1.234567890123456789012345678901234_f128).to_oct().add(you: (9.876543210987654321098765432109876_f128).to_oct().neg()).to_f128().to_bits())
  show((1.234567890123456789012345678901234_f128).to_oct().neg().add(you: (9.876543210987654321098765432109876_f128).to_oct()).to_f128().to_bits())
  show((1.234567890123456789012345678901234_f128).to_oct().neg().sub(you: (9.876543210987654321098765432109876_f128).to_oct()).to_f128().to_bits())
  show((9.876543210987654321098765432109876_f128).to_oct().mul(you: (1.234567890123456789012345678901234_f128).to_oct().neg()).to_f128().to_bits())
  show((9.876543210987654321098765432109876_f128).to_oct().neg().mul(you: (1.234567890123456789012345678901234_f128).to_oct().neg()).to_f128().to_bits())
  show((9.876543210987654321098765432109876_f128).to_oct().neg().mul(you: (1.234567890123456789012345678901234_f128).to_oct()).to_f128().to_bits())
  show((9.876543210987654321098765432109876_f128).to_oct().div(you: (1.234567890123456789012345678901234_f128).to_oct().neg()).to_f128().to_bits())
  show((9.876543210987654321098765432109876_f128).to_oct().neg().div(you: (1.234567890123456789012345678901234_f128).to_oct().neg()).to_f128().to_bits())
  show((9.876543210987654321098765432109876_f128).to_uf().sub(you: (1.234567890123456789012345678901234_f128).to_uf()).to_f128().to_bits())
  show((9.876543210987654321098765432109876_f128).to_uf().neg().add(you: (1.234567890123456789012345678901234_f128).to_uf()).to_f128().to_bits())
  show((9.876543210987654321098765432109876_f128).to_uf().mul(you: (1.234567890123456789012345678901234_f128).to_uf().neg()).to_f128().to_bits())
  return
