module Tests/Stdlib/ByvalComplexRecord
import IO/Console

# Case #4 of the struct-ABI byval coverage: Cxx (C64/C128) float-aggregate records
# passed BY VALUE and returned by value. Phase 3 (HFA handling) was deliberately
# deferred as a justified no-op; this fixture is the runtime guard backing that
# assumption — float-aggregate args/returns must not regress at -O3.

@positional
routine cnorm_sq(c: C128) -> B64
  return c.real * c.real + c.imag * c.imag

@positional
routine cadd(a: C128, b: C128) -> C128
  return C128(real: a.real + b.real, imag: a.imag + b.imag)

@positional
routine c32_real(c: C64) -> B32
  return c.real

routine start()
  var c = C128(real: 3.0_b64, imag: 4.0_b64)
  show(f"norm_sq: {cnorm_sq(c)}")

  var s = cadd(c, C128(real: 1.0_b64, imag: 1.0_b64))
  show(f"cadd: {s.real} {s.imag}")
  show(f"c unchanged: {c.real} {c.imag}")

  var c32 = C64(real: 1.0_b32, imag: 2.0_b32)
  show(f"c32 real: {c32_real(c32)}")
  return
