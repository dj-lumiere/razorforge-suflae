module Tests/Stdlib/ExpandMtypeExprApi
import IO/Console
import BuilderService

# Exercises `${m.type}` in EXPRESSION position: inside an `expand m in memvarof(T)` loop, the comptime
# member type splices into a typewise receiver for a static/universal method — here `${m.type}.data_size()`
# (a `@innate` BuilderService constant). Each field's type folds to its concrete byte size at
# monomorphization (S64 -> 8, F32 -> 4, Bool -> 1, U16 -> 2).

record Mixed
  a: S64
  b: F32
  c: Bool
  d: U16

routine field_sizes[T]() -> Text
  var out = ""
  expand m in memvarof(T)
    if m.id > 0u64
      out = out + ", "
    out = out + m.name + "=" + ${m.type}.data_size().represent()
  return out

routine start()
  show(field_sizes[Mixed]())
  show("DONE")
  return
