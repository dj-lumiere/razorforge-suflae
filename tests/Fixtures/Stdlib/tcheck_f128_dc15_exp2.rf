module Tests/Stdlib/TcheckF128Dc15Exp2

import IO/Console

# Isolated BIT-PERFECT probe: full exp2(1). Prints the U128 bit pattern of the result so the
# macOS/ARM comparison is exact (no decimal-formatting in the loop). Full-width F128 operands
# (113 mantissa bits) make a dropped/misplaced 128-bit half visible. x86 baseline in .expected.txt.
routine start()
  show((1.0_f128).exp2_unchecked().to_bits())
  return
