module Tests/Stdlib/ExpandMtypeTypeargApi
import IO/Console
import BuilderService
import Collections

# Exercises `${m.type}` in TYPE-ARGUMENT position (the sibling of the expression-position splice): inside
# `expand m in memvarof(T)`, the comptime member type splices into a generic argument — `Hijacked[${m.type}]`
# and `hijacked_from[${m.type}]` — folding to the field's concrete type at monomorphization ($Col ->
# S64/F32/Bool). Allocates a 1-slot typed raw buffer per field, pokes the field value in, peeks it back.

record Trio
  a: S64
  b: F32
  c: Bool

routine roundtrip[T](value: T) -> Text
  var out = ""
  expand m in memvarof(T)
    if m.id > 0u64
      out = out + ", "
    danger
      var buf = hijacked_from[${m.type}](rf_allocate_dynamic_uninit(${m.type}.data_size()))
      buf.poke(value.${m.name})
      out = out + m.name + "=" + buf.peek().represent()
  return out

routine start()
  show(roundtrip[Trio](value: Trio(a: 42_s64, b: 3.5f32, c: true)))
  show("DONE")
  return
