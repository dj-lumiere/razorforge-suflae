module Tests/Stdlib/NumericSignedApi
import IO/Console

# Exercises S8, S16, S32, S64, S128 — arithmetic, conversion, comparison, $represent.
routine start()
  var s8: S8 = 100_s8
  var s16: S16 = 1000_s16
  var s32: S32 = 1_000_000_s32
  var s64: S64 = 1_000_000_000_000_s64
  var s128: S128 = 123_456_789_123_456_789_s128

  show(f"S8:   {s8}")
  show(f"S16:  {s16}")
  show(f"S32:  {s32}")
  show(f"S64:  {s64}")
  show(f"S128: {s128}")

  # Arithmetic (same-width)
  show(f"S8 add: {s8 + 5_s8}")
  show(f"S16 sub: {s16 - 1_s16}")
  show(f"S32 mul: {s32 * 2_s32}")
  show(f"S64 div: {s64 // 1000_s64}")
  show(f"S64 mod: {s64 % 7_s64}")

  # Comparison
  show(f"S64 100 < 200: {100_s64 < 200_s64}")
  show(f"S64 200 > 100: {200_s64 > 100_s64}")
  show(f"S64 50 == 50: {50_s64 == 50_s64}")
  show(f"S64 50 != 51: {50_s64 != 51_s64}")

  # Negation
  show(f"-S8 42: {-42_s8}")
  show(f"-S64 1000: {-1000_s64}")

  # Conversions
  var n: S64 = S64(from: 42_s8)
  show(f"S8->S64 42: {n}")
  var n2: S32 = S32(from: 12345_s64)
  show(f"S64->S32 12345: {n2}")

  show("DONE")
  return
