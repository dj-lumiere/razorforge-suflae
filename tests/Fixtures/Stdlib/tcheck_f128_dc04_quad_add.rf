module Tests/Stdlib/TcheckF128Dc04QuadAdd

import IO/Console

# Isolated BIT-PERFECT probe: quad add (i256). Prints the U128 bit pattern of the result so the
# macOS/ARM comparison is exact (no decimal-formatting in the loop). Full-width F128 operands
# (113 mantissa bits) make a dropped/misplaced 128-bit half visible. x86 baseline in .expected.txt.
routine start()
  show((1.234567890123456789012345678901234_f128).to_uf().add(you: (9.876543210987654321098765432109876_f128).to_uf()).to_f128().to_bits())
  return
