module IterTools

### Represents a lazy adapter that discards the first `count` elements from a sequence.
### :typeparam T: The element type produced by the source sequence.
### :typeparam S: The concrete source iterable type (borrowed; enables build-time dispatch).
entity SkipIterator[T, S] obeys Iterable[T]
needs S obeys Iterable[T]
relates SkipEmitter[T, S/Iter] as Iter
  ### Stores the source iterable (borrowed, not owned).
  secret source: Hijacked[S]
  ### Stores how many leading values should be skipped.
  secret count: U64

### Returns the stateful iterator that discards the configured prefix lazily.
### The returned emitter defers the actual skipping until iteration begins.
### :returns: The resulting `SkipEmitter[T, S/Iter]` value.
@readonly
routine SkipIterator[T, S].$iter() -> SkipEmitter[T, S/Iter]
  danger!
    return SkipEmitter[T, S/Iter](source: me.source.as_entity().$iter(), remaining: me.count)

### Iterates over a source sequence after discarding an initial prefix.
### :typeparam T: The element type produced by the source sequence.
### :typeparam SE: The concrete source iterator type (borrowed).
entity SkipEmitter[T, SE] obeys Iterator[T]
needs SE obeys Iterator[T]
  ### Stores the underlying source iterator (borrowed).
  secret source: Hijacked[SE]
  ### Stores how many items still need to be discarded.
  secret remaining: U64

### Returns the next value after any remaining skipped prefix has been consumed.
### Values are discarded only until `remaining` reaches zero.
### :returns: The resulting `T` value.
routine SkipEmitter[T, SE].$next!() -> T
  danger!
    while me.remaining > 0u64
      me.source.as_entity().$next!()
      me.remaining = me.remaining - 1u64
    return me.source.as_entity().$next!()

### Returns a lazy adapter that skips the first `count` values.
### :param count: The number of leading values to discard.
### :returns: The resulting `SkipIterator[T, Me]` value.
@readonly
routine Iterable[T].skip(count: U64) -> SkipIterator[T, Me]
  danger!
    return SkipIterator[T, Me](source: me.hijack(), count: count)
