module IterTools

### Represents a lazy adapter that pairs elements from two sources into tuples.
### Iteration stops as soon as either source is exhausted.
### :typeparam T: The element type of the first source sequence.
### :typeparam U: The element type of the second source sequence.
### :typeparam S1: The concrete first source iterable type (borrowed).
### :typeparam S2: The concrete second source iterable type (borrowed).
entity ZipIterable[T, U, S1, S2] obeys Iterable[Tuple[T, U]]
needs S1 obeys Iterable[T]
needs S2 obeys Iterable[U]
relates ZipEmittable[T, U, S1/Iter, S2/Iter] as Iter
  ### Stores the first source iterable (borrowed, not owned).
  secret first: Hijacked[S1]
  ### Stores the second source iterable (borrowed, not owned).
  secret second: Hijacked[S2]

### Returns the stateful iterator that produces paired tuples lazily.
### :returns: The resulting `ZipEmittable[T, U, S1/Iter, S2/Iter]` value.
@readonly
routine ZipIterable[T, U, S1, S2].iter() -> ZipEmittable[T, U, S1/Iter, S2/Iter]
  danger
    return ZipEmittable[T, U, S1/Iter, S2/Iter](first: me.first.as_entity().iter(), second: me.second.as_entity().iter())

### Iterates over two source sequences simultaneously, pairing one element from each.
### Iteration ends when either source is exhausted.
### :typeparam T: The element type of the first source.
### :typeparam U: The element type of the second source.
### :typeparam SE1: The concrete first source iterator type (borrowed).
### :typeparam SE2: The concrete second source iterator type (borrowed).
entity ZipEmittable[T, U, SE1, SE2] obeys Emittable[Tuple[T, U]]
needs SE1 obeys Emittable[T]
needs SE2 obeys Emittable[U]
  ### Stores the iterator for the first source (borrowed).
  secret first: Hijacked[SE1]
  ### Stores the iterator for the second source (borrowed).
  secret second: Hijacked[SE2]

### Returns the next paired tuple from both source iterators.
### Propagates absence as soon as either source is exhausted.
### :returns: The resulting `Tuple[T, U]` value.
routine ZipEmittable[T, U, SE1, SE2].emit!() -> Tuple[T, U]
  danger
    var a = me.first.as_entity().emit()
    var b = me.second.as_entity().emit()
    return (a, b)

### Returns a lazy adapter that pairs each element of this iterable with an element from `other`.
### Stops when either source is exhausted.
### :param you: The second source iterable to zip with.
### :returns: The resulting `ZipIterable[T, U, Me, S2]` value.
@readonly
routine Iterable[T].zip[U, S2](you: Referring[S2]) -> ZipIterable[T, U, Me, S2]
needs S2 obeys Iterable[U]
  danger
    return ZipIterable[T, U, Me, S2](first: me.hijack(), second: you.hijack())
