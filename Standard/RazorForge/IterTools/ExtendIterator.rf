module IterTools

### Represents a lazy adapter that yields one iterable after another.
### The second sequence is not touched until the first one is exhausted.
### :typeparam T: The element type produced by both source sequences.
### :typeparam S1: The concrete first source iterable type (borrowed).
### :typeparam S2: The concrete second source iterable type (borrowed).
entity ExtendIterator[T, S1, S2] obeys Iterable[T]
needs S1 obeys Iterable[T]
needs S2 obeys Iterable[T]
relates ExtendEmitter[T, S1/Iter, S2/Iter] as Iter
  ### Stores the first source iterable (borrowed, not owned).
  secret first: Hijacked[S1]
  ### Stores the second source iterable (borrowed, not owned).
  secret second: Hijacked[S2]

### Returns the stateful iterator that concatenates the two source sequences.
### The returned emitter walks `first` to completion before switching to `second`.
### :returns: The resulting `ExtendEmitter[T, S1/Iter, S2/Iter]` value.
@readonly
routine ExtendIterator[T, S1, S2].$iter() -> ?ExtendEmitter[T, S1/Iter, S2/Iter]
  danger!
    return ExtendEmitter[T, S1/Iter, S2/Iter](first: me.first.as_entity().$iter(), second: me.second.as_entity().$iter(), in_second: false)

### Iterates over an `ExtendIterator` by exhausting the first source before moving to the second.
### :typeparam T: The element type produced by the concatenated sequence.
### :typeparam SE1: The concrete first source iterator type (borrowed).
### :typeparam SE2: The concrete second source iterator type (borrowed).
entity ExtendEmitter[T, SE1, SE2] obeys Iterator[T]
needs SE1 obeys Iterator[T]
needs SE2 obeys Iterator[T]
  ### Stores the iterator for the first source (borrowed).
  secret first: Hijacked[SE1]
  ### Stores the iterator for the second source (borrowed).
  secret second: Hijacked[SE2]
  ### Stores whether iteration has already advanced into the second source.
  secret in_second: Bool

### Returns the next value from the concatenated sequence.
### Once the first iterator is exhausted, all remaining values come from the second iterator.
### :returns: The resulting `T` value.
routine ExtendEmitter[T, SE1, SE2].$next!() -> ?T
  danger!
    if not me.in_second
      var result = me.first.as_entity().try_next()
      when result
        is None => me.in_second = true
        else item =>
          return item
    return me.second.as_entity().$next!()

### Returns a lazy concatenation of this iterable and `other`.
### :param other: The iterable to consume after `me`.
### :returns: The resulting `ExtendIterator[T, Me, S2]` value.
@readonly
routine Iterable[T].extend[S2](other: Referring[S2]) -> ?ExtendIterator[T, Me, S2]
needs S2 obeys Iterable[T]
  danger!
    return ExtendIterator[T, Me, S2](first: me.hijack(), second: other.hijack())
