module IterTools

### Represents a lazy adapter that yields one iterable after another.
### The second sequence is not touched until the first one is exhausted.
### :typeparam T: The element type produced by both source sequences.
entity ExtendIterator[T] obeys Iterable[T]
  ### Stores the first source iterable.
  secret first: Iterable[T]
  ### Stores the second source iterable.
  secret second: Iterable[T]

### Returns the stateful iterator that concatenates the two source sequences.
### The returned emitter walks `first` to completion before switching to `second`.
### :returns: The resulting `ExtendEmitter[T]` value.
@readonly
routine ExtendIterator[T].$iter() -> ExtendEmitter[T]
  return ExtendEmitter[T](first: me.first.$iter(), second: me.second.$iter(), in_second: false)

### Iterates over an `ExtendIterator[T]` by exhausting the first source before moving to the second.
### :typeparam T: The element type produced by the concatenated sequence.
entity ExtendEmitter[T] obeys Iterator[T]
  ### Stores the iterator for the first source.
  secret first: Iterator[T]
  ### Stores the iterator for the second source.
  secret second: Iterator[T]
  ### Stores whether iteration has already advanced into the second source.
  secret in_second: Bool

### Returns the next value from the concatenated sequence.
### Once the first iterator is exhausted, all remaining values come from the second iterator.
### :returns: The resulting `T` value.
routine ExtendEmitter[T].$next!() -> T
  if not me.in_second
    var result = me.first.try_next()
    when result
      is None => me.in_second = true
      else item =>
        return item
  return me.second.$next!()

### Returns a lazy concatenation of this iterable and `other`.
### :param other: The iterable to consume after `me`.
### :returns: The resulting `ExtendIterator[T]` value.
@readonly
routine Iterable[T].extend(other: Iterable[T]) -> ExtendIterator[T]
  return ExtendIterator[T](first: me, second: other)
