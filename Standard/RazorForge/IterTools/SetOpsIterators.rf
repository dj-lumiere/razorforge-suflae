module IterTools

### Represents a lazy adapter that yields elements present in both this iterable and another.
### The second iterable is fully materialized into a set when iteration begins.
### :typeparam T: The element type of both source sequences.
### :typeparam S: The concrete primary source iterable type (borrowed).
### :typeparam SO: The concrete membership-test iterable type (borrowed).
entity IntersectIterator[T, S, SO] obeys Iterable[T]
needs S obeys Iterable[T]
needs SO obeys Iterable[T]
relates IntersectEmitter[T, S/Iter] as Iter
  ### Stores the primary source iterable (borrowed, not owned).
  secret source: Hijacked[S]
  ### Stores the membership-test iterable to materialize at iteration start (borrowed).
  secret other: Hijacked[SO]

### Materializes `other` into a set and returns an iterator that filters `source` against it.
### :returns: The resulting `IntersectEmitter[T, S/Iter]` value.
@readonly
routine IntersectIterator[T, S, SO].$iter() -> ?IntersectEmitter[T, S/Iter]
needs T obeys Hashable, Comparable
  danger!
    var other_set = me.other.as_entity().Set()
    return IntersectEmitter[T, S/Iter](source: me.source.as_entity().$iter(), other: steal other_set)

### Iterates over a source sequence and keeps only elements that appear in the membership set.
### :typeparam T: The element type of the filtered sequence.
### :typeparam SE: The concrete source iterator type (borrowed).
entity IntersectEmitter[T, SE] obeys Iterator[T]
needs SE obeys Iterator[T]
  ### Stores the underlying source iterator (borrowed).
  secret source: Hijacked[SE]
  ### Stores the pre-materialized membership set.
  secret other: Set[T]

### Returns the next source element that is also present in the membership set.
### Source elements not found in the set are consumed and discarded.
### :returns: The resulting `T` value.
routine IntersectEmitter[T, SE].$next!() -> ?T
needs T obeys Hashable, Comparable
  danger!
    loop
      var item = me.source.as_entity().$next!()
      if me.other.contains(item)
        return item

### Returns a lazy adapter that keeps only elements also present in `other`.
### :param other: The iterable that defines the membership set.
### :returns: The resulting `IntersectIterator[T, Me, SO]` value.
@readonly
routine Iterable[T].intersect[SO](other: Referring[SO]) -> ?IntersectIterator[T, Me, SO]
needs SO obeys Iterable[T]
needs T obeys Hashable, Comparable
  danger!
    return IntersectIterator[T, Me, SO](source: me.hijack(), other: other.hijack())

### Represents a lazy adapter that suppresses elements present in another iterable.
### The exclusion iterable is fully materialized into a set when iteration begins.
### :typeparam T: The element type of both source sequences.
### :typeparam S: The concrete primary source iterable type (borrowed).
### :typeparam SO: The concrete exclusion iterable type (borrowed).
entity ExcludeIterator[T, S, SO] obeys Iterable[T]
needs S obeys Iterable[T]
needs SO obeys Iterable[T]
relates ExcludeEmitter[T, S/Iter] as Iter
  ### Stores the primary source iterable (borrowed, not owned).
  secret source: Hijacked[S]
  ### Stores the exclusion iterable to materialize at iteration start (borrowed).
  secret other: Hijacked[SO]

### Materializes `other` into a set and returns an iterator that removes matching elements.
### :returns: The resulting `ExcludeEmitter[T, S/Iter]` value.
@readonly
routine ExcludeIterator[T, S, SO].$iter() -> ?ExcludeEmitter[T, S/Iter]
needs T obeys Hashable, Comparable
  danger!
    var other_set = me.other.as_entity().Set()
    return ExcludeEmitter[T, S/Iter](source: me.source.as_entity().$iter(), other: steal other_set)

### Iterates over a source sequence and suppresses elements found in the exclusion set.
### :typeparam T: The element type of the filtered sequence.
### :typeparam SE: The concrete source iterator type (borrowed).
entity ExcludeEmitter[T, SE] obeys Iterator[T]
needs SE obeys Iterator[T]
  ### Stores the underlying source iterator (borrowed).
  secret source: Hijacked[SE]
  ### Stores the pre-materialized exclusion set.
  secret other: Set[T]

### Returns the next source element that is not present in the exclusion set.
### Source elements found in the set are consumed and discarded.
### :returns: The resulting `T` value.
routine ExcludeEmitter[T, SE].$next!() -> ?T
needs T obeys Hashable, Comparable
  danger!
    loop
      var item = me.source.as_entity().$next!()
      if not me.other.contains(item)
        return item

### Returns a lazy adapter that suppresses all elements also found in `other`.
### :param other: The iterable that defines the exclusion set.
### :returns: The resulting `ExcludeIterator[T, Me, SO]` value.
@readonly
routine Iterable[T].exclude[SO](other: Referring[SO]) -> ?ExcludeIterator[T, Me, SO]
needs SO obeys Iterable[T]
needs T obeys Hashable, Comparable
  danger!
    return ExcludeIterator[T, Me, SO](source: me.hijack(), other: other.hijack())

### Returns a lazy adapter that yields all distinct elements from this iterable followed by `other`.
### Duplicate values across both sources are suppressed.
### :param other: The iterable to concatenate before deduplication.
### :returns: The resulting `DistinctIterator[T, ExtendIterator[T, Me, SO]]` value.
@readonly
routine Iterable[T].union[SO](other: Referring[SO]) -> ?DistinctIterator[T, ExtendIterator[T, Me, SO]]
needs SO obeys Iterable[T]
needs T obeys Hashable, Comparable
  return me.extend(other).distinct()
