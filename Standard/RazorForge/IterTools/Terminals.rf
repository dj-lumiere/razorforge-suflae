module IterTools

### Materializes this iterable into a `List[T]`.
### Values are consumed eagerly in iteration order.
### :returns: The resulting `List[T]` value.
@readonly
routine Iterable[T].List() -> ?List[T]
  var result = List[T]()
  for item in me
    result.add_last(item)
  return result

### Materializes this iterable into a `Set[T]`.
### Duplicate values collapse according to the set's equality and ordering semantics.
### :returns: The resulting `Set[T]` value.
@readonly
routine Iterable[T].Set() -> ?Set[T]
needs T obeys Hashable, Comparable
  var result = Set[T]()
  for item in me
    result.add(item)
  return result

### Counts how many values this iterable produces.
### This consumes the iterable from start to finish.
### :returns: The resulting `U64` value.
@readonly
routine Iterable[T].get_count() -> U64
  var n = 0u64
  for _ in me
    n = n + 1u64
  return n

### Returns the first value produced by this iterable.
### This is a convenience terminal operation over the first iterator element.
### :returns: The resulting `T` value.
@readonly
routine Iterable[T].first!() -> ?T
  var emitter = me.$iter()
  return emitter.$next!()

### Returns the last value produced by this iterable.
### The iterable is consumed fully in order to find the final element.
### :returns: The resulting `T` value.
@readonly
routine Iterable[T].last!() -> ?T
  var emitter = me.$iter()
  var latest = emitter.$next!()
  loop
    var item = emitter.try_next()
    when item
      is None => return latest
      else value => latest = value

### Returns `true` when any produced value satisfies `predicate`.
### Iteration stops as soon as a matching value is found.
### :param predicate: The predicate to test against each item.
### :returns: The resulting `Bool` value.
@readonly
routine Iterable[T].any(predicate: Routine[(T,), Bool]) -> Bool
  for item in me
    if predicate(item)
      return true
  return false

### Returns `true` when every produced value satisfies `predicate`.
### Iteration stops as soon as a failing value is found.
### :param predicate: The predicate to test against each item.
### :returns: The resulting `Bool` value.
@readonly
routine Iterable[T].all(predicate: Routine[(T,), Bool]) -> Bool
  for item in me
    if not predicate(item)
      return false
  return true

### Folds this iterable into a single result value.
### The combiner receives the current accumulator and the next item in iteration
### order.
### :param start: The initial accumulator value.
### :param combiner: The routine used to produce the next accumulator value.
### :returns: The resulting `U` value.
@readonly
routine Iterable[T].accumulate[U](start: U, combiner: Routine[(U, T), U]) -> ?U
  var result = start
  for item in me
    result = combiner(result, item)
  return result

### Returns the sum of all values in this iterable.
### The first element is used as the initial accumulator; subsequent elements are added to it.
### :returns: The resulting `T` value.
@readonly
routine Iterable[T].sum!() -> ?T
needs T obeys Addable
  var emitter = me.$iter()
  var result = emitter.$next!()
  loop
    var item = emitter.try_next()
    when item
      is None => return result
      else value => result = result + value

### Returns the smallest value in this iterable.
### :returns: The resulting `T` value.
@readonly
routine Iterable[T].min!() -> ?T
needs T obeys Comparable
  var emitter = me.$iter()
  var result = emitter.$next!()
  loop
    var item = emitter.try_next()
    when item
      is None => return result
      else value =>
        if value < result
          result = value

### Returns the largest value in this iterable.
### :returns: The resulting `T` value.
@readonly
routine Iterable[T].max!() -> ?T
needs T obeys Comparable
  var emitter = me.$iter()
  var result = emitter.$next!()
  loop
    var item = emitter.try_next()
    when item
      is None => return result
      else value =>
        if value > result
          result = value

### Returns the element for which `selector` returns the smallest key.
### :param selector: The routine that extracts a comparable key from each element.
### :returns: The resulting `T` value.
@readonly
routine Iterable[T].min_by![U](selector: Routine[(T,), U]) -> ?T
needs U obeys Comparable
  var emitter = me.$iter()
  var best = emitter.$next!()
  var best_key = selector(best)
  loop
    var item = emitter.try_next()
    when item
      is None => return best
      else value =>
        var k = selector(value)
        if k < best_key
          best = value
          best_key = k

### Returns the element for which `selector` returns the largest key.
### :param selector: The routine that extracts a comparable key from each element.
### :returns: The resulting `T` value.
@readonly
routine Iterable[T].max_by![U](selector: Routine[(T,), U]) -> ?T
needs U obeys Comparable
  var emitter = me.$iter()
  var best = emitter.$next!()
  var best_key = selector(best)
  loop
    var item = emitter.try_next()
    when item
      is None => return best
      else value =>
        var k = selector(value)
        if k > best_key
          best = value
          best_key = k

### Counts how many values satisfy `predicate`.
### :param predicate: The test applied to each element.
### :returns: The resulting `U64` value.
@readonly
routine Iterable[T].get_count(predicate: Routine[(T,), Bool]) -> U64
  var n = 0u64
  for item in me
    if predicate(item)
      n = n + 1u64
  return n

### Returns the first value produced by this iterable, or `default` when the iterable is empty.
### :param default: The value to return when the iterable yields nothing.
### :returns: The resulting `T` value.
@readonly
routine Iterable[T].first_or_default(default: T) -> ?T
  var emitter = me.$iter()
  var result = emitter.try_next()
  when result
    is None => return default
    else item => return item

### Returns the last value produced by this iterable, or `default` when the iterable is empty.
### :param default: The value to return when the iterable yields nothing.
### :returns: The resulting `T` value.
@readonly
routine Iterable[T].last_or_default(default: T) -> ?T
  var latest = default
  for item in me
    latest = item
  return latest

### Joins the produced `Text` values into a single `Text`, inserting `separator`
### between successive parts. The separator is not added before the first or
### after the last element.
### :param separator: The text inserted between successive parts.
### :returns: The resulting `Text` value.
@readonly
routine Iterable[Text].join(separator: Text) -> Text
  var result = List[Character]()
  var first = true
  for part in me
    if not first
      for i in 0u64 til separator.count()
        result.add_last(separator[i])
    for i in 0u64 til part.count()
      result.add_last(part[i])
    first = false
  return Text(from_list: steal result)
