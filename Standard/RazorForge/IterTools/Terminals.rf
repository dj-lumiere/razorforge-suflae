module IterTools

### Materializes this iterable into a `List[T]`.
### Values are consumed eagerly in iteration order.
### :returns: The resulting `List[T]` value.
@readonly
routine Iterable[T].List() -> List[T]
  var result = List[T]()
  for item in me
    result.add_last(item)
  return result

### Materializes this iterable into a `Set[T]`.
### Duplicate values collapse according to the set's equality and ordering semantics.
### :returns: The resulting `Set[T]` value.
@readonly
routine Iterable[T].Set() -> Set[T]
needs T obeys Hashable, Comparable
  var result = Set[T]()
  for item in me
    result.add(item)
  return result

### Counts how many values this iterable produces.
### This consumes the iterable from start to finish.
### :returns: The resulting `U64` value.
@readonly
routine Iterable[T].get_count() -> U64
  var n = 0u64
  for _ in me
    n = n + 1u64
  return n

### Returns the first value produced by this iterable.
### This is a convenience terminal operation over the first iterator element.
### :returns: The resulting `T` value.
@readonly
routine Iterable[T].first!() -> T
  var emitter = me.$iter()
  return emitter.$next!()

### Returns the last value produced by this iterable.
### The iterable is consumed fully in order to find the final element.
### :returns: The resulting `T` value.
@readonly
routine Iterable[T].last!() -> T
  var emitter = me.$iter()
  var latest = emitter.$next!()
  loop
    var item = emitter.try_next()
    when item
      is None => return latest
      else value => latest = value

### Returns `true` when any produced value satisfies `predicate`.
### Iteration stops as soon as a matching value is found.
### :param predicate: The predicate to test against each item.
### :returns: The resulting `Bool` value.
@readonly
routine Iterable[T].any(predicate: Routine[(T,), Bool]) -> Bool
  for item in me
    if predicate(item)
      return true
  return false

### Returns `true` when every produced value satisfies `predicate`.
### Iteration stops as soon as a failing value is found.
### :param predicate: The predicate to test against each item.
### :returns: The resulting `Bool` value.
@readonly
routine Iterable[T].all(predicate: Routine[(T,), Bool]) -> Bool
  for item in me
    if not predicate(item)
      return false
  return true

### Folds this iterable into a single result value.
### The combiner receives the current accumulator and the next item in iteration
### order.
### :param start: The initial accumulator value.
### :param combiner: The routine used to produce the next accumulator value.
### :returns: The resulting `U` value.
@readonly
routine Iterable[T].accumulate[U](start: U, combiner: Routine[(U, T), U]) -> U
  var result = start
  for item in me
    result = combiner(result, item)
  return result
