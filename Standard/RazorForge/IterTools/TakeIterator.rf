module IterTools

### Represents a lazy adapter that yields at most `limit` elements from a source sequence.
### :typeparam T: The element type produced by the source sequence.
entity TakeIterator[T] obeys Iterable[T]
  ### Stores the source iterable.
  secret source: Iterable[T]
  ### Stores the maximum number of values to yield.
  secret limit: U64

### Returns the stateful iterator that enforces the configured take limit.
### The emitted iterator decrements its remaining budget on each successful
### yield.
### :returns: The resulting `TakeEmitter[T]` value.
routine TakeIterator[T].$iter() -> TakeEmitter[T]
  return TakeEmitter[T](source: me.source.$iter(), remaining: me.limit)

### Iterates over at most the configured number of values from the source sequence.
### :typeparam T: The element type produced by the source sequence.
entity TakeEmitter[T] obeys Iterator[T]
  ### Stores the underlying source iterator.
  secret source: Iterator[T]
  ### Stores how many values may still be yielded.
  secret remaining: U64

### Returns the next value while the remaining take budget is still positive.
### Iteration stops once the configured limit has been reached, even if the
### source still has more values available.
### :returns: The resulting `T` value.
### :absent: Returns absent when the take limit has been exhausted or the source ends first.
routine TakeEmitter[T].$next!() -> T
  if me.remaining == 0u64
    absent
  var _result = me.source.$next!()
  me.remaining = me.remaining - 1u64
  return _result

### Returns a lazy adapter that yields at most `count` values.
### This is useful for truncating potentially long or infinite iterables.
### :param count: The maximum number of values to take.
### :returns: The resulting `TakeIterator[T]` value.
routine Iterable[T].take(count: U64) -> TakeIterator[T]
  return TakeIterator[T](source: me, limit: count)
