module Core

# ============================================================================
# Memory Operations
# ============================================================================

### Loads a value of type `T` from `address`.
### This is the direct wrapper for the LLVM `load` instruction.
### :param address: The source address to load from.
### :returns: The resulting `T` value.
@llvm_ir("{result} = load {T}, ptr {address}")
external("llvm") routine load[T](address: Hijacked[T]) -> ?T
### Stores `value` to `address`.
### This is the direct wrapper for the LLVM `store` instruction.
### :param address: The destination address.
### :param value: The value to write.
@llvm_ir("store {T} {value}, ptr {address}")
dangerous external("llvm") routine store[T](address: Hijacked[T], value: T)

# ============================================================================
# Type Conversions
# ============================================================================

### Sign-extends `value` from `From` to `To`.
### :param value: The source integer value.
### :returns: The resulting `To` value.
@llvm_ir("{result} = sext {From} {value} to {To}")
external("llvm") routine sign_extend[From, To](value: From) -> To
### Zero-extends `value` from `From` to `To`.
### :param value: The source integer value.
### :returns: The resulting `To` value.
@llvm_ir("{result} = zext {From} {value} to {To}")
external("llvm") routine zero_extend[From, To](value: From) -> To
### Truncates an integer value from `From` to `To`.
### :param value: The source integer value.
### :returns: The resulting `To` value.
@llvm_ir("{result} = trunc {From} {value} to {To}")
external("llvm") routine int_truncate[From, To](value: From) -> To
### Reinterprets the bit pattern of `value` as `To` without changing the underlying bits.
### :param value: The source value to reinterpret.
### :returns: The resulting `To` value.
@llvm_ir("{result} = bitcast {From} {value} to {To}")
external("llvm") routine reinterpret_bits[From, To](value: From) -> To
### Converts a pointer value to an integer value.
### :param value: The pointer to convert.
### :returns: The resulting `To` value.
@llvm_ir("{result} = ptrtoint ptr {value} to {To}")
external("llvm") routine pointer_to_int[From, To](value: Hijacked[From]) -> To
### Converts an integer value to a typed pointer.
### :param value: The integer address value to reinterpret.
### :returns: The resulting `Hijacked[To]` value.
@llvm_ir("{result} = inttoptr {From} {value} to ptr")
external("llvm") routine int_to_pointer[From, To](value: From) -> Hijacked[To]
### Returns the entity reference stored in a Hijacked pointer, without dereferencing.
### Use only when T is an entity type and the Hijacked holds the entity pointer directly.
### :param value: The raw pointer value.
### :returns: The resulting `T` entity reference.
@llvm_ir("{result} = getelementptr i8, ptr {value}, i64 0")
dangerous external("llvm") routine entity_from_hijacked[T](value: Hijacked[T]) -> ?T
### Steps a pointer forward by {count} elements of type {T} (element-sized stride).
### :param ptr: The base pointer.
### :param count: Number of elements to advance (may be negative to step backward).
### :returns: The resulting `Hijacked[T]` value.
@llvm_ir("{result} = getelementptr {T}, ptr {ptr}, i64 {count}")
dangerous external("llvm") routine element_pointer[T](ptr: Hijacked[T], count: S64) -> Hijacked[T]
### Converts a signed integer value to floating point.
### :param value: The source integer value.
### :returns: The resulting `To` value.
@llvm_ir("{result} = sitofp {From} {value} to {To}")
external("llvm") routine signed_to_float[From, To](value: From) -> To
### Converts an unsigned integer value to floating point.
### :param value: The source integer value.
### :returns: The resulting `To` value.
@llvm_ir("{result} = uitofp {From} {value} to {To}")
external("llvm") routine unsigned_to_float[From, To](value: From) -> To
### Converts a floating-point value to a signed integer.
### :param value: The source floating-point value.
### :returns: The resulting `To` value.
@llvm_ir("{result} = fptosi {From} {value} to {To}")
external("llvm") routine float_to_signed[From, To](value: From) -> To
### Converts a floating-point value to an unsigned integer.
### :param value: The source floating-point value.
### :returns: The resulting `To` value.
@llvm_ir("{result} = fptoui {From} {value} to {To}")
external("llvm") routine float_to_unsigned[From, To](value: From) -> To
### Widens a floating-point value to a larger floating-point type.
### :param value: The source floating-point value.
### :returns: The resulting `To` value.
@llvm_ir("{result} = fpext {From} {value} to {To}")
external("llvm") routine float_extend[From, To](value: From) -> To
### Narrows a floating-point value to a smaller floating-point type.
### :param value: The source floating-point value.
### :returns: The resulting `To` value.
@llvm_ir("{result} = fptrunc {From} {value} to {To}")
external("llvm") routine float_narrow[From, To](value: From) -> To

# ============================================================================
# Optimization Barrier
# ============================================================================

### Returns `value` unchanged but opaque to the optimizer — an empty `sideeffect` inline-asm
### identity. A benchmarked op whose result is fed through this cannot be folded, hoisted,
### strength-reduced, narrowed, or dead-code-eliminated, so a micro-benchmark loop measures the
### real op instead of whichever optimization the harness shape happened to trigger. Zero machine
### cost (the asm string is empty); it is purely a barrier. Like Rust's `black_box` / Google
### Benchmark's `DoNotOptimize`.
###
### ONLY valid for types that fit a general-register class (≤ 128 bits, plus float/double). The
### `=r` constraint has no register class for wider integers, so on x86 i256 CRASHES instruction
### selection — use `do_not_optimize_wide` for `S256`/`U256`/`F256`.
### :param value: The value to keep live and opaque.
### :returns: `value`, bit-for-bit unchanged.
@llvm_ir("{result} = call {T} asm sideeffect \"\", \"=r,0\"({T} {value})")
external("llvm") routine do_not_optimize[T](value: T) -> T

### Optimizer barrier for i256-carrier types (`S256`/`U256`/`F256`) — `do_not_optimize`'s `=r`
### constraint has no register class for i256 and CRASHES instruction selection. This makes only the
### low 64 bits opaque (an `=r,0` register barrier on the truncated limb) and ORs them back with the
### untouched high 192 bits: the whole i256 becomes opaque to the optimizer (it can't prove the low
### limb, so `a OP a` can't be folded or hoisted) with NO memory traffic — no `alloca` (the earlier
### volatile/alloca version allocated per loop iteration and overflowed the stack). The `sideeffect`
### asm can't be hoisted out of a loop, so the value is recomputed each iteration. A few i256
### bit-ops of overhead (and/trunc/zext/or) — calibrate it out with a `*_null` baseline if needed.
### i256-WIDTH ONLY (the i256/i64 widths are hardcoded). :param value: kept live and opaque.
### :returns: `value`, bit-for-bit unchanged.
@llvm_ir("{result} = and i256 {value}, -18446744073709551616\n  {result} = trunc i256 {value} to i64\n  {result} = call i64 asm sideeffect \"\", \"=r,0\"(i64 {prev})\n  {result} = zext i64 {prev} to i256\n  {result} = or i256 {prev}, {first}")
external("llvm") routine do_not_optimize_wide[T](value: T) -> T

# ============================================================================
# Integer Arithmetic Instructions
# ============================================================================

### Adds `a` and `b` using LLVM integer addition.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The resulting `T` value.
@llvm_ir("{result} = add {T} {a}, {b}")
external("llvm") routine add[T](a: T, b: T) -> ?T
### Returns the result of `signed_add_exact` (no signed wrap — UB on signed overflow).
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The resulting `T` value.
@llvm_ir("{result} = add nsw {T} {a}, {b}")
dangerous external("llvm") routine signed_add_exact[T](a: T, b: T) -> ?T
### Returns the result of `unsigned_add_exact` (no unsigned wrap — UB on unsigned overflow).
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The resulting `T` value.
@llvm_ir("{result} = add nuw {T} {a}, {b}")
dangerous external("llvm") routine unsigned_add_exact[T](a: T, b: T) -> ?T
### Subtracts `b` from `a` using LLVM integer subtraction.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The arithmetic difference.
@llvm_ir("{result} = sub {T} {a}, {b}")
external("llvm") routine sub[T](a: T, b: T) -> ?T
### Returns the result of `signed_sub_exact` (no signed wrap — UB on signed overflow).
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The resulting `T` value.
@llvm_ir("{result} = sub nsw {T} {a}, {b}")
dangerous external("llvm") routine signed_sub_exact[T](a: T, b: T) -> ?T
### Returns the result of `unsigned_sub_exact` (no unsigned wrap — UB on unsigned overflow).
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The resulting `T` value.
@llvm_ir("{result} = sub nuw {T} {a}, {b}")
dangerous external("llvm") routine unsigned_sub_exact[T](a: T, b: T) -> ?T
### Multiplies `a` and `b` using LLVM integer multiplication.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The arithmetic product.
@llvm_ir("{result} = mul {T} {a}, {b}")
external("llvm") routine mul[T](a: T, b: T) -> ?T
### Returns the result of `signed_mul_exact` (no signed wrap — UB on signed overflow).
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The resulting `T` value.
@llvm_ir("{result} = mul nsw {T} {a}, {b}")
dangerous external("llvm") routine signed_mul_exact[T](a: T, b: T) -> ?T
### Returns the result of `unsigned_mul_exact` (no unsigned wrap — UB on unsigned overflow).
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The resulting `T` value.
@llvm_ir("{result} = mul nuw {T} {a}, {b}")
dangerous external("llvm") routine unsigned_mul_exact[T](a: T, b: T) -> ?T
### Divides `a` by `b` using signed integer division.
### :param a: The dividend.
### :param b: The divisor.
### :returns: The signed quotient.
@llvm_ir("{result} = sdiv {T} {a}, {b}")
external("llvm") routine signed_div[T](a: T, b: T) -> ?T
### Divides `a` by `b` using unsigned integer division.
### :param a: The dividend.
### :param b: The divisor.
### :returns: The unsigned quotient.
@llvm_ir("{result} = udiv {T} {a}, {b}")
external("llvm") routine unsigned_div[T](a: T, b: T) -> ?T
### Returns the signed remainder of dividing `a` by `b`.
### :param a: The dividend.
### :param b: The divisor.
### :returns: The signed remainder.
@llvm_ir("{result} = srem {T} {a}, {b}")
external("llvm") routine signed_rem[T](a: T, b: T) -> ?T
### Returns the unsigned remainder of dividing `a` by `b`.
### :param a: The dividend.
### :param b: The divisor.
### :returns: The unsigned remainder.
@llvm_ir("{result} = urem {T} {a}, {b}")
external("llvm") routine unsigned_rem[T](a: T, b: T) -> ?T

# ============================================================================
# Float Arithmetic Instructions
# ============================================================================

### Adds two floating-point values using LLVM `fadd`.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The floating-point sum.
@llvm_ir("{result} = fadd {T} {a}, {b}")
external("llvm") routine float_add[T](a: T, b: T) -> ?T
### Subtracts one floating-point value from another using LLVM `fsub`.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The floating-point difference.
@llvm_ir("{result} = fsub {T} {a}, {b}")
external("llvm") routine float_sub[T](a: T, b: T) -> ?T
### Multiplies two floating-point values using LLVM `fmul`.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The floating-point product.
@llvm_ir("{result} = fmul {T} {a}, {b}")
external("llvm") routine float_mul[T](a: T, b: T) -> ?T
### Divides one floating-point value by another using LLVM `fdiv`.
### :param a: The dividend.
### :param b: The divisor.
### :returns: The floating-point quotient.
@llvm_ir("{result} = fdiv {T} {a}, {b}")
external("llvm") routine float_div[T](a: T, b: T) -> ?T
### Returns the result of `float_div_fast` (no NaN/inf checks — UB if result is non-finite).
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The resulting `T` value.
@llvm_ir("{result} = fdiv fast {T} {a}, {b}")
dangerous external("llvm") routine float_div_fast[T](a: T, b: T) -> ?T
### Returns the floating-point remainder of dividing `a` by `b`.
### :param a: The dividend.
### :param b: The divisor.
### :returns: The floating-point remainder.
@llvm_ir("{result} = frem {T} {a}, {b}")
external("llvm") routine float_rem[T](a: T, b: T) -> ?T
### Negates a floating-point value with LLVM `fneg`.
### :param value: The value to negate.
### :returns: The additive inverse of `value`.
@llvm_ir("{result} = fneg {T} {value}")
external("llvm") routine float_neg[T](value: T) -> ?T

# ============================================================================
# Bitwise Instructions (and/or are RF keywords, prefixed with bit_)
# ============================================================================

### Applies a bitwise AND to `a` and `b`.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The bitwise intersection.
@llvm_ir("{result} = and {T} {a}, {b}")
external("llvm") routine bit_and[T](a: T, b: T) -> ?T
### Applies a bitwise OR to `a` and `b`.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The bitwise union.
@llvm_ir("{result} = or {T} {a}, {b}")
external("llvm") routine bit_or[T](a: T, b: T) -> ?T
### Applies a bitwise XOR to `a` and `b`.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The bitwise exclusive-or result.
@llvm_ir("{result} = xor {T} {a}, {b}")
external("llvm") routine bit_xor[T](a: T, b: T) -> ?T

# ============================================================================
# Shift Instructions
# ============================================================================

### Shifts `value` left by `bits`.
### :param value: The value to shift.
### :param bits: The shift amount.
### :returns: The shifted result.
@llvm_ir("{result} = shl {T} {value}, {bits}")
external("llvm") routine shift_left[T](value: T, bits: T) -> ?T
### Shifts `value` right with sign extension.
### :param value: The value to shift.
### :param bits: The shift amount.
### :returns: The arithmetic right-shift result.
@llvm_ir("{result} = ashr {T} {value}, {bits}")
external("llvm") routine shift_right_signed[T](value: T, bits: T) -> ?T
### Shifts `value` right with zero fill.
### :param value: The value to shift.
### :param bits: The shift amount.
### :returns: The logical right-shift result.
@llvm_ir("{result} = lshr {T} {value}, {bits}")
external("llvm") routine shift_right_unsigned[T](value: T, bits: T) -> ?T

# ============================================================================
# Integer Comparison Instructions
# ============================================================================

### Returns whether two integer-like values are bitwise equal.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: `true` when `a` and `b` are equal.
@llvm_ir("{result} = icmp eq {T} {a}, {b}")
external("llvm") routine int_eq[T](a: T, b: T) -> Bool
### Returns whether two integer-like values differ.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: `true` when `a` and `b` are not equal.
@llvm_ir("{result} = icmp ne {T} {a}, {b}")
external("llvm") routine int_ne[T](a: T, b: T) -> Bool
### Returns whether `a` is less than `b` under signed integer ordering.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: `true` when `a < b`.
@llvm_ir("{result} = icmp slt {T} {a}, {b}")
external("llvm") routine signed_lt[T](a: T, b: T) -> Bool
### Returns whether `a` is less than or equal to `b` under signed integer ordering.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: `true` when `a <= b`.
@llvm_ir("{result} = icmp sle {T} {a}, {b}")
external("llvm") routine signed_le[T](a: T, b: T) -> Bool
### Returns whether `a` is greater than `b` under signed integer ordering.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: `true` when `a > b`.
@llvm_ir("{result} = icmp sgt {T} {a}, {b}")
external("llvm") routine signed_gt[T](a: T, b: T) -> Bool
### Returns whether `a` is greater than or equal to `b` under signed integer ordering.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: `true` when `a >= b`.
@llvm_ir("{result} = icmp sge {T} {a}, {b}")
external("llvm") routine signed_ge[T](a: T, b: T) -> Bool
### Returns whether `a` is less than `b` under unsigned integer ordering.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: `true` when `a < b`.
@llvm_ir("{result} = icmp ult {T} {a}, {b}")
external("llvm") routine unsigned_lt[T](a: T, b: T) -> Bool
### Returns whether `a` is less than or equal to `b` under unsigned integer ordering.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: `true` when `a <= b`.
@llvm_ir("{result} = icmp ule {T} {a}, {b}")
external("llvm") routine unsigned_le[T](a: T, b: T) -> Bool
### Returns whether `a` is greater than `b` under unsigned integer ordering.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: `true` when `a > b`.
@llvm_ir("{result} = icmp ugt {T} {a}, {b}")
external("llvm") routine unsigned_gt[T](a: T, b: T) -> Bool
### Returns whether `a` is greater than or equal to `b` under unsigned integer ordering.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: `true` when `a >= b`.
@llvm_ir("{result} = icmp uge {T} {a}, {b}")
external("llvm") routine unsigned_ge[T](a: T, b: T) -> Bool

# ============================================================================
# Float Comparison Instructions
# ============================================================================

### Returns whether two floating-point values are ordered and equal.
### Comparisons against NaN return `false`.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: `true` when both operands are ordered and equal.
@llvm_ir("{result} = fcmp oeq {T} {a}, {b}")
external("llvm") routine float_eq[T](a: T, b: T) -> Bool
### Returns whether two floating-point values are ordered and not equal.
### Comparisons against NaN return `false`.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: `true` when both operands are ordered and differ.
@llvm_ir("{result} = fcmp one {T} {a}, {b}")
external("llvm") routine float_ne[T](a: T, b: T) -> Bool
### Returns whether `a` is ordered and strictly less than `b`.
### Comparisons against NaN return `false`.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: `true` when both operands are ordered and `a < b`.
@llvm_ir("{result} = fcmp olt {T} {a}, {b}")
external("llvm") routine float_lt[T](a: T, b: T) -> Bool
### Returns whether `a` is ordered and less than or equal to `b`.
### Comparisons against NaN return `false`.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: `true` when both operands are ordered and `a <= b`.
@llvm_ir("{result} = fcmp ole {T} {a}, {b}")
external("llvm") routine float_le[T](a: T, b: T) -> Bool
### Returns whether `a` is ordered and strictly greater than `b`.
### Comparisons against NaN return `false`.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: `true` when both operands are ordered and `a > b`.
@llvm_ir("{result} = fcmp ogt {T} {a}, {b}")
external("llvm") routine float_gt[T](a: T, b: T) -> Bool
### Returns whether `a` is ordered and greater than or equal to `b`.
### Comparisons against NaN return `false`.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: `true` when both operands are ordered and `a >= b`.
@llvm_ir("{result} = fcmp oge {T} {a}, {b}")
external("llvm") routine float_ge[T](a: T, b: T) -> Bool

# ============================================================================
# Saturating Arithmetic (@llvm.s/u{add,sub}.sat)
# ============================================================================

### Adds two signed integers with saturation instead of wraparound.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The saturated signed sum.
@llvm_ir("{result} = call {T} @llvm.sadd.sat.{T}({T} {a}, {T} {b})")
external("llvm") routine signed_add_sat[T](a: T, b: T) -> ?T
### Adds two unsigned integers with saturation instead of wraparound.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The saturated unsigned sum.
@llvm_ir("{result} = call {T} @llvm.uadd.sat.{T}({T} {a}, {T} {b})")
external("llvm") routine unsigned_add_sat[T](a: T, b: T) -> ?T
### Subtracts two signed integers with saturation instead of wraparound.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The saturated signed difference.
@llvm_ir("{result} = call {T} @llvm.ssub.sat.{T}({T} {a}, {T} {b})")
external("llvm") routine signed_sub_sat[T](a: T, b: T) -> ?T
### Subtracts two unsigned integers with saturation at zero.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: The saturated unsigned difference.
@llvm_ir("{result} = call {T} @llvm.usub.sat.{T}({T} {a}, {T} {b})")
external("llvm") routine unsigned_sub_sat[T](a: T, b: T) -> ?T

# ============================================================================
# Overflow Detection (@llvm.s/u{add,sub,mul}.with.overflow)
# ============================================================================

### Adds two signed integers and reports whether overflow occurred.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: A tuple of the wrapped result and an overflow flag.
@llvm_ir("{result} = call { {T}, i1 } @llvm.sadd.with.overflow.{T}({T} {a}, {T} {b})")
external("llvm") routine signed_add_checked[T](a: T, b: T) -> (T, Bool)
### Adds two unsigned integers and reports whether overflow occurred.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: A tuple of the wrapped result and an overflow flag.
@llvm_ir("{result} = call { {T}, i1 } @llvm.uadd.with.overflow.{T}({T} {a}, {T} {b})")
external("llvm") routine unsigned_add_checked[T](a: T, b: T) -> (T, Bool)
### Subtracts two signed integers and reports whether overflow occurred.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: A tuple of the wrapped result and an overflow flag.
@llvm_ir("{result} = call { {T}, i1 } @llvm.ssub.with.overflow.{T}({T} {a}, {T} {b})")
external("llvm") routine signed_sub_checked[T](a: T, b: T) -> (T, Bool)
### Subtracts two unsigned integers and reports whether underflow occurred.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: A tuple of the wrapped result and an overflow flag.
@llvm_ir("{result} = call { {T}, i1 } @llvm.usub.with.overflow.{T}({T} {a}, {T} {b})")
external("llvm") routine unsigned_sub_checked[T](a: T, b: T) -> (T, Bool)
### Multiplies two signed integers and reports whether overflow occurred.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: A tuple of the wrapped result and an overflow flag.
@llvm_ir("{result} = call { {T}, i1 } @llvm.smul.with.overflow.{T}({T} {a}, {T} {b})")
external("llvm") routine signed_mul_checked[T](a: T, b: T) -> (T, Bool)
### Multiplies two unsigned integers and reports whether overflow occurred.
### :param a: The left-hand value.
### :param b: The right-hand value.
### :returns: A tuple of the wrapped result and an overflow flag.
@llvm_ir("{result} = call { {T}, i1 } @llvm.umul.with.overflow.{T}({T} {a}, {T} {b})")
external("llvm") routine unsigned_mul_checked[T](a: T, b: T) -> (T, Bool)

# ============================================================================
# Integer Bit Manipulation (@llvm.ctpop, @llvm.ctlz, etc.)
# ============================================================================

### Counts the number of one bits in `value`.
### :param value: The integer input.
### :returns: The population count.
@llvm_ir("{result} = call {T} @llvm.ctpop.{T}({T} {value})")
external("llvm") routine count_ones[T](value: T) -> ?T
### Counts the number of leading zero bits in `value`.
### :param value: The integer input.
### :returns: The count of zero bits before the first one bit.
@llvm_ir("{result} = call {T} @llvm.ctlz.{T}({T} {value}, i1 false)")
external("llvm") routine leading_zeros[T](value: T) -> ?T
### Counts the number of trailing zero bits in `value`.
### :param value: The integer input.
### :returns: The count of zero bits after the least-significant one bit.
@llvm_ir("{result} = call {T} @llvm.cttz.{T}({T} {value}, i1 false)")
external("llvm") routine trailing_zeros[T](value: T) -> ?T
### Reverses the bit order of `value`.
### :param value: The integer input.
### :returns: The bit-reversed result.
@llvm_ir("{result} = call {T} @llvm.bitreverse.{T}({T} {value})")
external("llvm") routine reverse_bits[T](value: T) -> ?T
### Reverses the byte order of `value`.
### :param value: The integer input.
### :returns: The byte-swapped result.
@llvm_ir("{result} = call {T} @llvm.bswap.{T}({T} {value})")
external("llvm") routine byte_swap[T](value: T) -> ?T
### Returns the absolute value.
### :param value: The value to use.
### :returns: The resulting `T` value.
@llvm_ir("{result} = call {T} @llvm.abs.{T}({T} {value}, i1 false)")
external("llvm") routine int_abs[T](value: T) -> ?T

# ============================================================================
# Float Math (@llvm.sqrt, @llvm.fabs, etc.)
# ============================================================================

### Returns the square root of `value`.
### :param value: The floating-point input.
### :returns: The intrinsic square-root result.
@llvm_ir("{result} = call {T} @llvm.sqrt.{T}({T} {value})")
external("llvm") routine sqrt[T](value: T) -> ?T
### Returns the absolute value of a floating-point input.
### :param value: The floating-point input.
### :returns: The input magnitude with a non-negative sign.
@llvm_ir("{result} = call {T} @llvm.fabs.{T}({T} {value})")
external("llvm") routine float_abs[T](value: T) -> ?T
### Rounds a floating-point input toward negative infinity.
### :param value: The floating-point input.
### :returns: The floor result.
@llvm_ir("{result} = call {T} @llvm.floor.{T}({T} {value})")
external("llvm") routine floor[T](value: T) -> ?T
### Rounds a floating-point input toward positive infinity.
### :param value: The floating-point input.
### :returns: The ceiling result.
@llvm_ir("{result} = call {T} @llvm.ceil.{T}({T} {value})")
external("llvm") routine ceil[T](value: T) -> ?T
### Rounds a floating-point input to the nearest integral value.
### :param value: The floating-point input.
### :returns: The rounded result.
@llvm_ir("{result} = call {T} @llvm.round.{T}({T} {value})")
external("llvm") routine round[T](value: T) -> ?T
### Truncates a floating-point input toward zero.
### :param value: The floating-point input.
### :returns: The truncated result.
@llvm_ir("{result} = call {T} @llvm.trunc.{T}({T} {value})")
external("llvm") routine float_truncate[T](value: T) -> ?T
### Returns the sine of `value`, interpreting it as radians.
### :param value: The floating-point input.
### :returns: The intrinsic sine result.
@llvm_ir("{result} = call {T} @llvm.sin.{T}({T} {value})")
external("llvm") routine sin[T](value: T) -> ?T
### Returns the cosine of `value`, interpreting it as radians.
### :param value: The floating-point input.
### :returns: The intrinsic cosine result.
@llvm_ir("{result} = call {T} @llvm.cos.{T}({T} {value})")
external("llvm") routine cos[T](value: T) -> ?T
### Returns `e` raised to `value`.
### :param value: The floating-point input.
### :returns: The intrinsic exponential result.
@llvm_ir("{result} = call {T} @llvm.exp.{T}({T} {value})")
external("llvm") routine exp[T](value: T) -> ?T
### Returns the natural logarithm of `value`.
### :param value: The floating-point input.
### :returns: The intrinsic natural-log result.
@llvm_ir("{result} = call {T} @llvm.log.{T}({T} {value})")
external("llvm") routine log[T](value: T) -> ?T
### Returns the base-10 logarithm of `value`.
### :param value: The floating-point input.
### :returns: The intrinsic common-log result.
@llvm_ir("{result} = call {T} @llvm.log10.{T}({T} {value})")
external("llvm") routine log10[T](value: T) -> ?T
### Raises `base` to the floating-point power `exp`.
### :param base: The base value.
### :param exp: The exponent value.
### :returns: The intrinsic power result.
@llvm_ir("{result} = call {T} @llvm.pow.{T}({T} {base}, {T} {exp})")
external("llvm") routine pow[T](base: T, exp: T) -> ?T
### Returns `value` with its sign bit replaced by the sign of `sign`.
### :param value: The magnitude source.
### :param sign: The sign source.
### :returns: A value combining the magnitude of `value` and the sign of `sign`.
@llvm_ir("{result} = call {T} @llvm.copysign.{T}({T} {value}, {T} {sign})")
external("llvm") routine copysign[T](value: T, sign: T) -> ?T

# ============================================================================
# Atomic Operations
# ============================================================================

### Loads a value atomically with sequentially consistent ordering.
### :param ptr: The address of the atomic storage.
### :returns: The value observed at `ptr`.
@llvm_ir("{result} = load atomic {T}, ptr {ptr} seq_cst, align {sizeof T}")
external("llvm") routine atomic_load[T](ptr: Hijacked[T]) -> ?T
### Stores a value atomically with sequentially consistent ordering.
### :param ptr: The address of the atomic storage.
### :param value: The replacement value to write.
@llvm_ir("store atomic {T} {value}, ptr {ptr} seq_cst, align {sizeof T}")
external("llvm") routine atomic_store[T](ptr: Hijacked[T], value: T)
### Adds `value` atomically and returns the previous contents.
### :param ptr: The address of the atomic storage.
### :param value: The increment to apply.
### :returns: The value stored before the addition.
@llvm_ir("{result} = atomicrmw add ptr {ptr}, {T} {value} seq_cst")
external("llvm") routine atomic_add[T](ptr: Hijacked[T], value: T) -> ?T
### Subtracts `value` atomically and returns the previous contents.
### :param ptr: The address of the atomic storage.
### :param value: The decrement to apply.
### :returns: The value stored before the subtraction.
@llvm_ir("{result} = atomicrmw sub ptr {ptr}, {T} {value} seq_cst")
external("llvm") routine atomic_sub[T](ptr: Hijacked[T], value: T) -> ?T
### Applies a bitwise AND atomically and returns the previous contents.
### :param ptr: The address of the atomic storage.
### :param value: The bit mask to apply.
### :returns: The value stored before the update.
@llvm_ir("{result} = atomicrmw and ptr {ptr}, {T} {value} seq_cst")
external("llvm") routine atomic_and[T](ptr: Hijacked[T], value: T) -> ?T
### Applies a bitwise OR atomically and returns the previous contents.
### :param ptr: The address of the atomic storage.
### :param value: The bit mask to apply.
### :returns: The value stored before the update.
@llvm_ir("{result} = atomicrmw or ptr {ptr}, {T} {value} seq_cst")
external("llvm") routine atomic_or[T](ptr: Hijacked[T], value: T) -> ?T
### Applies a bitwise XOR atomically and returns the previous contents.
### :param ptr: The address of the atomic storage.
### :param value: The bit mask to apply.
### :returns: The value stored before the update.
@llvm_ir("{result} = atomicrmw xor ptr {ptr}, {T} {value} seq_cst")
external("llvm") routine atomic_xor[T](ptr: Hijacked[T], value: T) -> ?T
### Replaces the atomic value and returns the previous contents.
### :param ptr: The address of the atomic storage.
### :param value: The new value to install.
### :returns: The value stored before the exchange.
@llvm_ir("{result} = atomicrmw xchg ptr {ptr}, {T} {value} seq_cst")
external("llvm") routine atomic_exchange[T](ptr: Hijacked[T], value: T) -> ?T
### Performs an atomic compare-and-exchange with sequentially consistent ordering.
### :param ptr: The address of the atomic storage.
### :param expected: The value that must already be present.
### :param desired: The replacement value written on success.
### :returns: A tuple of the observed old value and a success flag.
@llvm_ir("{result} = cmpxchg ptr {ptr}, {T} {expected}, {T} {desired} seq_cst seq_cst")
external("llvm") routine atomic_compare_and_exchange[T](ptr: Hijacked[T], expected: T, desired: T) -> (T, Bool)

# ============================================================================
# Array element access (alloca + GEP pattern for [N x T] record types)
# ============================================================================

### Returns the raw byte at `index` from an aggregate value.
### This helper materializes the aggregate in stack storage, then indexes into
### the underlying byte representation.
### :param array: The aggregate value to inspect.
### :param index: The zero-based byte offset.
### :returns: The byte stored at `index`.
@llvm_ir("{result} = alloca [{N} x i8]\nstore [{N} x i8] {array}, ptr {prev}\n{result} = getelementptr [{N} x i8], ptr {prev}, i32 0, i64 {index}\n{result} = load i8, ptr {prev}")
external("llvm") routine byte_at[N](array: Array[Byte, N], index: U64) -> U8

### Sets the byte at component.
### :param array: The `array` value.
### :param index: The zero-based position to use.
### :param value: The value to use.
### :returns: The resulting `Array[Byte, N]` value.
@llvm_ir("{result} = alloca [{N} x i8]\nstore [{N} x i8] {array}, ptr {prev}\n{result} = getelementptr [{N} x i8], ptr {prev}, i32 0, i64 {index}\nstore i8 {value}, ptr {prev}\n{result} = load [{N} x i8], ptr {first}")
external("llvm") routine set_byte_at[N](array: Array[Byte, N], index: U64, value: U8) -> Array[Byte, N]

### Returns the element at `index` from an aggregate value.
### Like `byte_at`, this helper materializes the aggregate in temporary storage
### and then indexes to the requested typed element.
### :param array: The `array` value.
### :param index: The zero-based position to use.
### :returns: The resulting `T` value.
@llvm_ir("{result} = alloca {Array}\nstore {Array} {array}, ptr {prev}\n{result} = getelementptr {Array}, ptr {prev}, i32 0, i64 {index}\n{result} = load {T}, ptr {prev}")
external("llvm") routine element_at[Array, T](array: Array, index: U64) -> ?T

### Loads the element at `index` from contiguous storage addressed by `ptr`.
### Unlike {element_at}, this reads in place through the pointer — no whole-aggregate copy. The
### pointer is typically `me.hijack()` of an inline-backed collection (`Array`, `BitArray`).
### :param ptr: A pointer to the collection's element storage.
### :param index: The zero-based element position (strided by `sizeof(T)`).
### :returns: The element value at `index`.
@llvm_ir("{result} = getelementptr {T}, ptr {ptr}, i64 {index}\n{result} = load {T}, ptr {prev}")
external("llvm") routine load_element_ref[Coll, T](ptr: Hijacked[Coll], index: U64) -> T

### Stores `value` into the element at `index` of contiguous storage addressed by `ptr`.
### Writes a single element in place through the pointer (no whole-aggregate copy); the mutation is
### visible to the pointer's owner. The pointer is typically `me.hijack()` of an inline-backed
### collection (`Array`, `BitArray`) whose `$setitem!` receives `me` by reference.
### :param ptr: A pointer to the collection's element storage.
### :param index: The zero-based element position (strided by `sizeof(T)`).
### :param value: The element value to store.
@llvm_ir("{result} = getelementptr {T}, ptr {ptr}, i64 {index}\nstore {T} {value}, ptr {prev}")
external("llvm") routine store_element_ref[Coll, T](ptr: Hijacked[Coll], index: U64, value: T)

### Returns a zero-initialized value of type T.
### :returns: The resulting `T` value.
@llvm_ir("{result} = alloca {T}\nstore {T} zeroinitializer, ptr {prev}\n{result} = load {T}, ptr {prev}")
external("llvm") routine zero_value[T]() -> ?T

### Returns whether two pointer-backed values refer to the same address.
### Intended for entity and crashable identity comparison (`===`).
### :param a: The left-hand reference.
### :param b: The right-hand reference.
### :returns: `true` when both point to the same memory location.
@llvm_ir("{result} = icmp eq ptr {a}, {b}")
external("llvm") routine ptr_same[T](a: T, b: T) -> Bool
