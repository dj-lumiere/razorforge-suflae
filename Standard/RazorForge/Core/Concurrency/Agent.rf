module Core

# TaskSpawnError / TaskTimeoutError are defined in Core/Errors/Common.rf (alongside the other
# Core crashables) so their synthesized $represent/$diagnose resolve crash_message correctly.

### Which substrate runs an `Agent[T]`. One concrete handle backs both so a heterogeneous set can be
### raced from a single `List[Agent[T]]`.
choice AgentKind
  ### Backed by a stackful coroutine on this thread's implicit scheduler (a `suspended routine`).
  CORO
  ### Backed by an OS worker thread (a `threaded routine`).
  THREAD

### A handle to in-flight work whose result you can fetch with `retrieve!()`. One concrete type backs
### BOTH kinds of asynchrony so a heterogeneous set can be raced from a `List[Agent[T]]`:
###   * a `suspended routine` call yields a coroutine-backed Agent (kind CORO) — runs on this thread's
###     implicit scheduler, parks (never blocks) at `waitfor`/await points;
###   * a `threaded routine` call yields a thread-backed Agent (kind THREAD) — runs on an OS thread.
### `retrieve!()` and `waitfor()` branch on `kind`, reusing the coroutine-park and thread-wait paths.
### The metaphor: you delegate to an agent, it runs on its own, you only fetch the result.
###
### Teardown is status-based (NOT done in `retrieve!`): a completed Agent is freed; one still in
### flight is abandoned — a parked coroutine runs its cancellation shadow stack, while a running
### worker thread (which cannot be killed) is joined before its block is freed, so the worker never
### writes into freed memory. `retrieve!` only extracts the value; `$destroy` always does the freeing.
record Agent[T]
  ### CORO = coroutine-backed (suspended routine); THREAD = thread-backed (threaded routine).
  secret kind: AgentKind
  ### The opaque coroutine handle (rf_coro*), valid only for kind CORO.
  secret coro: CPtr
  ### The task control block holding the produced value: the coroutine's result block (CORO) or the
  ### worker's rf_task* handle (THREAD).
  secret agent: Address
  ### The wait deadline; only meaningful when `has_deadline` is true (THREAD).
  secret deadline: Duration
  ### Whether a deadline has been attached via `waitfor`.
  secret has_deadline: Bool
  ### Whether the OS thread was spawned successfully (THREAD).
  secret spawned: Bool

### Whether this Agent is coroutine-backed (kind CORO). Internal plumbing for `race!`, which dispatches
### on kind while reading List elements as temporaries (a direct `agent.kind` field read on a generic
### List element miscompiles today; going through a member routine monomorphizes the receiver cleanly).
### :returns: true if coroutine-backed, false if thread-backed.
routine Agent[T].is_coro() -> Bool
  return me.kind is AgentKind.CORO

### The raw coroutine handle (valid for kind CORO). Internal plumbing for `race!`.
### :returns: the rf_coro* as a CPtr.
routine Agent[T].coro_handle() -> CPtr
  return me.coro

### The raw task/result control block (both kinds box their produced value here). Internal `race!`
### plumbing; also where the winner's value is read from.
### :returns: the rf_task* as an Address.
routine Agent[T].task_handle() -> Address
  return me.agent

### Whether the work has finished (its value is ready to `retrieve!` without waiting). A racy snapshot
### for polling/heuristics, not a synchronization decision — it can flip to true the instant after you
### read it. Branches on kind: a coroutine is done at status COMPLETED (3); a thread at COMPLETED (4).
### :returns: `true` if the work has completed.
routine Agent[T].is_done() -> Bool
  if me.kind is AgentKind.CORO
    if me.coro.is_none()
      return true
    danger!
      return rf_coro_status_get(coro: me.coro) == 3_u32
  if not me.spawned
    return false
  danger!
    return rf_task_status_get(task: me.agent) == 4_u32

### Whether the work was spawned and has not yet finished. Racy snapshot (see `is_done`).
### :returns: `true` if still in flight.
routine Agent[T].is_running() -> Bool
  return not me.is_done()

### Requests cooperative cancellation of this agent — sets a flag in NATIVE memory (reached through
### the handle) and returns; it NEVER frees or unwinds (teardown stays in `$destroy`, the sole
### freer). A coroutine observes the request at its next suspend point (`waitfor` returns early) or
### via `cancellation_requested()`; a worker thread observes it only by polling
### `cancellation_requested()` (a thread cannot be killed). Internal plumbing for `Nursery[T].cancel`,
### read through a member routine so it works on a `List[Agent[T]]` element accessed as a temporary
### (the flag persists in C even though the RF `Agent` copy does not).
dangerous routine Agent[T].request_cancel()
  if me.kind is AgentKind.CORO
    if not me.coro.is_none()
      rf_coro_request_cancel(coro: me.coro)
    return
  if me.spawned
    rf_task_request_cancel(task: me.agent)
  return

### Attaches a deadline and returns the updated handle, enabling `agent.waitfor(5s).retrieve!()` on a
### thread-backed Agent. The returned value is a TEMPORARY copy aliasing the same worker — use it
### inline (never bind it to a name alongside the original, or both would tear the worker down).
### :param deadline: The maximum time `retrieve!` will wait.
### :returns: A copy of this handle carrying the deadline.
routine Agent[T].waitfor(deadline: Duration) -> Agent[T]
  return Agent[T](kind: me.kind, coro: me.coro, agent: me.agent,
                  deadline: deadline, has_deadline: true, spawned: me.spawned)

### Drives the work to completion and returns its produced value. UNCOLORED: a thread-backed Agent
### awaited inside a scheduler-driven coroutine PARKS (siblings run meanwhile) instead of blocking;
### on a plain thread it blocks. A coroutine-backed Agent drives this thread's implicit scheduler
### until THIS coroutine finishes (siblings spawned earlier progress concurrently). A deadline
### (`agent.waitfor(d).retrieve!()`) races completion against the timer and throws {TaskTimeoutError}
### if the deadline wins. `retrieve!` only reads the value out; freeing happens later in `$destroy`.
### :throws: {TaskSpawnError} if the work could not be spawned.
### :throws: {TaskTimeoutError} if a deadline was set and elapsed before completion.
### :returns: The value the routine returned.
routine Agent[T].retrieve!() -> T
  if me.kind is AgentKind.CORO
    if me.coro.is_none()
      throw TaskSpawnError()
    danger!
      rf_sched_run_until_default(coro: me.coro)
      var payload = rf_task_result_payload(task: me.agent)
      var value = Hijacked[T](from: payload).peek()
      rf_invalidate(ptr: payload)
      return value

  if not me.spawned
    throw TaskSpawnError()
  danger!
    if me.has_deadline
      var total = me.deadline.total_nanoseconds()
      if rf_in_coroutine() != 0_u32
        # Inside a scheduler-driven coroutine: race the worker against the deadline WITHOUT
        # blocking. Park on a deadline timer that is also externally wakeable; siblings run.
        # 0 => the deadline elapsed first (timeout); 1 => completed. Do NOT free here — $destroy
        # joins the still-running worker before freeing (the timeout does not stop it).
        var outcome = rf_task_await_coro_deadline(task: me.agent, timeout_ns: U64(total))
        if outcome == 0_u32
          throw TaskTimeoutError()
      else
        var secs = total // 1000000000
        var nanos = U32(total - secs * 1000000000)
        var kind = rf_task_wait_within(task: me.agent, secs: secs, ns: nanos)
        if kind != 1
          throw TaskTimeoutError()
    else
      if rf_in_coroutine() != 0_u32
        # Inside a scheduler-driven coroutine: park instead of blocking. Register as the task's
        # awaiter and yield; the worker wakes us (cross-thread) on completion. The loop re-checks
        # under the lock so no wake is lost, and tolerates spurious wakes.
        while rf_task_await_coro(task: me.agent) == 0_u32
          rf_sched_park_external()
      else
        discard rf_task_wait(task: me.agent)

    var payload = rf_task_result_payload(task: me.agent)
    var value = Hijacked[T](from: payload).peek()
    rf_invalidate(ptr: payload)
    return value

### Teardown. A completed Agent is freed; one still in flight is abandoned. For a coroutine: a
### parked one is detached from the scheduler and its cancellation shadow stack is run; a completed
### one is deleted; the result block is always released. For a thread: a still-running worker is
### JOINED before the block is freed (a thread cannot be killed, and the worker keeps writing into
### the block until it finishes) — abandoning a thread therefore means detach-and-discard-the-result,
### not stop-the-thread.
dangerous routine Agent[T].$destroy()
  if me.kind is AgentKind.CORO
    if not me.coro.is_none()
      var status = rf_coro_status_get(coro: me.coro)
      if status == 3_u32                # RF_CORO_COMPLETED
        # Detach from the scheduler BEFORE freeing, exactly like the not-completed branch below. A
        # completed coroutine can STILL sit in a worker's ready deque: a wake that raced its completion
        # re-queued it after it finished (see coro_runtime.c rf_sched_run_coro — "the owner frees it
        # later"). Freeing without unscheduling leaves that deque entry dangling; a worker then pops the
        # freed pointer and rf_coro_resume reads freed memory + co_switch()es a freed stack → jump to
        # NULL → SIGSEGV (the libco M:N work-stealing crash). Unschedule first purges the stray entry.
        discard rf_sched_unschedule_default(coro: me.coro)
        rf_coro_delete(coro: me.coro)
      else
        # Never retrieved: detach from the implicit scheduler (drop its ready/live reference) BEFORE
        # abandoning, so the scheduler does not dangle on freed memory.
        discard rf_sched_unschedule_default(coro: me.coro)
        rf_coro_abandon(coro: me.coro)
      rf_task_destroy(task: me.agent)
    return

  if me.spawned
    var tstatus = rf_task_status_get(task: me.agent)
    if tstatus != 4_u32               # not RF_TASK_COMPLETED: worker still running
      discard rf_task_wait(task: me.agent)
    rf_task_destroy(task: me.agent)
  return

# --- Structured concurrency over a set of Agents -----------------------------------------------
# A `List[Agent[T]]` bound to a name IS the structured-concurrency scope: ownership already
# guarantees no child outlives it (the list's teardown abandons every still-running Agent). So the
# scope operations are MEMBER routines on that list — `race!` / `gather!` / `cancel_all` — read as
# `agents.gather!()`. They BORROW the list (`me` is by-reference): they never consume or free it, so
# there is no hidden ownership transfer; cleanup stays with the list's own teardown at scope exit.
# Each Agent is read only as a temporary (`me[i]`), so nothing aliases an Agent or double-frees.

### Races the Agents, driving them CONCURRENTLY until the FIRST one finishes, and returns that
### winner's value. BORROWS the list — call it `agents.race!()`. The losers are not freed here; they
### are ABANDONED when the list itself tears down at the enclosing scope's return (a parked coroutine
### runs its cancellation shadow stack; a still-running worker thread is joined then discarded). To
### drop the losers promptly, race inside a routine that returns the winner, so the list tears down
### right after. Mixed coroutine/thread sets are supported.
### :throws: {TaskSpawnError} if the set is empty (there is nothing to race).
### :returns: The value produced by the first Agent to finish.
routine List[Agent[V]].race!() -> V
  danger!
    var n = me.count()
    if n == 0_u64
      throw TaskSpawnError()

    var race = rf_race_begin()
    var i = 0_u64
    while i < n
      if me[i].is_coro()
        rf_race_add_coro(race: race, coro: me[i].coro_handle())
      else
        rf_race_add_task(race: race, task: me[i].task_handle())
      i = i + 1

    # Drive until the first competitor completes; `winner` indexes the List in add order. Both kinds
    # box their produced value into a task block referenced by `agent`, so extraction is uniform.
    var winner = rf_race_wait(race: race)
    rf_race_end(race: race)
    var w = U64(winner)
    var payload = rf_task_result_payload(task: me[w].task_handle())
    var value = Hijacked[V](from: payload).peek()
    rf_invalidate(ptr: payload)
    return value

### Drives the Agents CONCURRENTLY and waits for ALL of them to finish, returning their results in
### INPUT order. The twin of `race!` (first finisher); `gather!` returns every finisher. BORROWS the
### list — call it `agents.gather!()`. Each Agent is driven with the same uncolored `retrieve!` logic,
### so coroutine children progress on this thread's scheduler and thread children run on their OS
### threads; total wait is the SLOWEST child, not the sum. FAIL-FAST: if any Agent's routine throws,
### that throw propagates out and the remaining children are abandoned when the list tears down at
### scope exit. An empty set yields an empty list.
### :returns: The values produced by every Agent, in the order they appear in the list.
routine List[Agent[V]].gather!() -> List[V]
  danger!
    var n = me.count()
    var results = List[V]()
    var i = 0_u64
    while i < n
      var value = me[i].retrieve!()
      results.add_last(value: value)
      i = i + 1
    return results

### Requests cooperative cancellation of EVERY Agent in the set, then waits out the wind-down,
### returning each Agent's final value in input order (a cooperative worker returns its own sentinel
### when it observes the request). BORROWS the list — call it `agents.cancel_all!()`. It sets a cancel
### flag on each Agent (in native memory, through the handle), then drives them to completion with the
### same uncolored logic as `gather!`: a worker thread observes the flag via `cancellation_requested()`
### (the only way to halt one — a thread cannot be killed) and returns; a coroutine observes it at its
### next `waitfor` returning early. `!` because the wind-down join can surface a child's throw. To
### cancel WITHOUT waiting, simply let the list tear down at scope exit (abandon-all).
### :returns: Each Agent's final value, in input order.
routine List[Agent[V]].cancel_all!() -> List[V]
  danger!
    var n = me.count()
    var i = 0u64
    while i < n
      me[i].request_cancel()
      i = i + 1
    # Wait out the wind-down (same uncolored drive as gather!), collecting each final value.
    var results = List[V]()
    i = 0u64
    while i < n
      var value = me[i].retrieve!()
      results.add_last(value: value)
      i = i + 1
    return results

### Waits for `duration` to elapse. UNCOLORED: inside a scheduler-driven coroutine it PARKS — the
### scheduler runs other coroutines meanwhile and resumes this one when the timer fires — so it
### costs no thread; on a plain thread it sleeps the thread. The same `waitfor(5s)` does the right
### thing in either context, which is why it is preferable to a raw `sleep`.
### :param duration: How long to wait.
routine waitfor(duration: Duration)
  # Interruptible: once cancellation has been requested for this agent, waitfor is a no-op so a
  # cooperative loop (`while ...: waitfor(...); if cancellation_requested(): return`) exits promptly
  # instead of sleeping out the full duration.
  if rf_cancel_requested() != 0_u32
    return
  danger!
    var total = duration.total_nanoseconds()
    if rf_in_coroutine() != 0_u32
      rf_sched_park_timer(delay_ns: U64(total))
    else
      var secs = total // 1000000000
      var nanos = U32(total - secs * 1000000000)
      rf_waitfor_duration(secs: secs, ns: nanos)
  return

### Cooperatively hands the current turn back to the scheduler, then immediately re-queues this
### coroutine as READY — the scheduler runs the other ready coroutines once before resuming here on
### the next tick. Unlike `waitfor`, it waits for NOTHING: it gives up the turn but stays runnable, so
### resumption is unconditional (no timer, no event). Use it to interleave a long yield-free stretch
### of CPU work with siblings; prefer `waitfor` or a channel op when there is an actual event to await.
### UNCOLORED: outside a scheduler-driven coroutine (a plain thread) there is no turn to yield, so it
### is a no-op.
routine yield_now()
  danger!
    if rf_in_coroutine() != 0_u32
      rf_coro_yield()
  return

### Whether cooperative cancellation has been requested for the currently-running agent — a
### `suspended` coroutine or a `threaded` worker. An agent body polls this and returns early to stop
### cooperatively; this is the ONLY way to halt a CPU-bound worker thread (a thread cannot be killed).
### A coroutine's `waitfor` also honors the request by returning early. Outside any agent it is always
### false. :returns: true if cancellation was requested for this agent.
routine cancellation_requested() -> Bool
  return rf_cancel_requested() != 0_u32