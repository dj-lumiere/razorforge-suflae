module Core

# TaskSpawnError / TaskTimeoutError are defined in Core/Errors/Common.rf (alongside the other
# Core crashables) so their synthesized $represent/$diagnose resolve crash_message correctly.

### Handle to an in-flight `threaded routine`. Calling a `threaded routine` runs its body on
### an OS thread and yields one of these handles. Read the produced value with `retrieve!()`,
### optionally bounding the wait first with `waitfor(deadline)`. Single-use.
record Task[T]
  ### The opaque `rf_task*` handle returned by the runtime.
  secret task_handle: Address
  ### The wait deadline; only meaningful when `has_deadline` is true.
  secret deadline: Duration
  ### Whether a deadline has been attached via `waitfor`.
  secret has_deadline: Bool
  ### Whether the OS thread was spawned successfully.
  secret spawned: Bool

### Attaches a deadline and returns the updated handle, enabling `task.waitfor(5s).retrieve!()`.
### :param deadline: The maximum time `retrieve!` will block.
### :returns: A copy of this handle carrying the deadline.
routine Task[T].waitfor(deadline: Duration) -> Task[T]
  return Task[T](task_handle: me.task_handle, deadline: deadline,
                 has_deadline: true, spawned: me.spawned)

### Waits for the worker to finish and returns its produced value. UNCOLORED: inside a
### scheduler-driven coroutine it PARKS — the scheduler runs other coroutines while this one awaits
### the worker thread — instead of blocking; on a plain thread it blocks. A deadline
### (`task.waitfor(d).retrieve!()`) races completion against the timer the same way: it parks inside
### a coroutine, blocks on a plain thread, and throws {TaskTimeoutError} if the deadline wins.
### :throws: {TaskSpawnError} if the task could not be spawned.
### :throws: {TaskTimeoutError} if a deadline was set and elapsed before completion.
### :returns: The value produced by the threaded routine.
routine Task[T].retrieve!() -> ?T
  if not me.spawned
    throw TaskSpawnError()

  danger!
    if me.has_deadline
      var total = me.deadline.total_nanoseconds()
      if rf_in_coroutine() != 0_u32
        # Inside a scheduler-driven coroutine: race the worker against the deadline WITHOUT
        # blocking. The coroutine parks on a deadline timer that is also externally wakeable;
        # siblings run meanwhile. 0 => the deadline elapsed first (timeout); 1 => completed.
        var outcome = rf_task_await_coro_deadline(task: me.task_handle, timeout_ns: U64(total))
        if outcome == 0_u32
          rf_task_destroy(task: me.task_handle)
          throw TaskTimeoutError()
      else
        var secs = total // 1000000000
        var nanos = U32(total - secs * 1000000000)
        var kind = rf_task_wait_within(task: me.task_handle, secs: secs, ns: nanos)
        if kind != 1
          rf_task_destroy(task: me.task_handle)
          throw TaskTimeoutError()
    else
      if rf_in_coroutine() != 0_u32
        # Inside a scheduler-driven coroutine: park instead of blocking the thread. Register as the
        # task's awaiter and yield; the worker wakes us (cross-thread) on completion. The loop
        # re-checks under the lock so no wake is lost, and tolerates spurious wakes.
        while rf_task_await_coro(task: me.task_handle) == 0_u32
          rf_sched_park_external()
      else
        discard rf_task_wait(task: me.task_handle)

    var payload = rf_task_result_payload(task: me.task_handle)
    var value = Hijacked[T](from: payload).extract()
    rf_invalidate(ptr: payload)
    rf_task_destroy(task: me.task_handle)
    return value

### Waits for `duration` to elapse. UNCOLORED: inside a scheduler-driven coroutine it PARKS — the
### scheduler runs other coroutines meanwhile and resumes this one when the timer fires — so it
### costs no thread; on a plain thread it sleeps the thread. The same `waitfor(5s)` does the right
### thing in either context, which is why it is preferable to a raw `sleep`.
### :param duration: How long to wait.
routine waitfor(duration: Duration)
  danger!
    var total = duration.total_nanoseconds()
    if rf_in_coroutine() != 0_u32
      rf_sched_park_timer(delay_ns: U64(total))
    else
      var secs = total // 1000000000
      var nanos = U32(total - secs * 1000000000)
      rf_waitfor_duration(secs: secs, ns: nanos)
  return
