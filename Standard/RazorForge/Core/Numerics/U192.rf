module Core

import Collections

# ============================================================================
# U192 — raw 192-bit unsigned integer. Engine-only intermediate: the mantissa (M)
# of the binary192 float engine (UnpackedFloat[U192, U384, 192], the D128 scratch).
# Not user-facing, so it carries only the minimal surface the engine needs:
# FloorDivisible (knuth-D, the `//` the divide core calls) + value semantics. No literal
# suffix (like U512/U1024, constants are assembled from U64 limbs via `asm192`).
# ============================================================================

@llvm("i192")
record U192 obeys FloorDivisible, Assignable, Copyable
  pass

### Assemble 3 U64 limbs (little-endian) into a U192.
@inline
routine asm192(q0: U64, q1: U64, q2: U64) -> U192
  var r = LLVM::zero_extend[U64, U192](q0)
  r = LLVM::bit_or(a: r, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U192](q1), bits: U192.to_width(s: 64_s64)))
  r = LLVM::bit_or(a: r, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U192](q2), bits: U192.to_width(s: 128_s64)))
  return r

### nth U64 limb of a U192.
@inline
routine limb192(x: U192, i: S64) -> U64
  return LLVM::int_truncate[U192, U64](LLVM::shift_right_unsigned(x, U192.to_width(s: LLVM::mul(a: i, b: 64_s64))))

### Returns me // you via the base-2⁶⁴ Knuth-D kernel (`knuth_divide[3]`).
routine U192.floordiv(you: U192) -> U192
  var av = me
  var bv = you
  var rem = Array[U64, 3]()
  danger
    var q = knuth_divide[3](
      a: LLVM::reinterpret_bits[Hijacked[U192], Hijacked[Array[U64, 3]]](av.hijack()),
      b: LLVM::reinterpret_bits[Hijacked[U192], Hijacked[Array[U64, 3]]](bv.hijack()),
      rem: rem.hijack())
    return LLVM::reinterpret_bits[Hijacked[Array[U64, 3]], Hijacked[U192]](q.hijack()).peek()

### Returns me % you (remainder from the same Knuth-D kernel).
routine U192.mod(you: U192) -> U192
  var av = me
  var bv = you
  var rem = Array[U64, 3]()
  danger
    var q = knuth_divide[3](
      a: LLVM::reinterpret_bits[Hijacked[U192], Hijacked[Array[U64, 3]]](av.hijack()),
      b: LLVM::reinterpret_bits[Hijacked[U192], Hijacked[Array[U64, 3]]](bv.hijack()),
      rem: rem.hijack())
    return LLVM::reinterpret_bits[Hijacked[Array[U64, 3]], Hijacked[U192]](rem.hijack()).peek()

### Quotient of `num // den` with the round-sticky baked into bit 0 (set iff the division
### left a nonzero remainder). One Knuth-D call — no separate %/mul-back.
routine udiv192_sticky(num: U192, den: U192) -> U192
  var av = num
  var bv = den
  var rem = Array[U64, 3]()
  danger
    var qa = knuth_divide[3](
      a: LLVM::reinterpret_bits[Hijacked[U192], Hijacked[Array[U64, 3]]](av.hijack()),
      b: LLVM::reinterpret_bits[Hijacked[U192], Hijacked[Array[U64, 3]]](bv.hijack()),
      rem: rem.hijack())
    var q = LLVM::reinterpret_bits[Hijacked[Array[U64, 3]], Hijacked[U192]](qa.hijack()).peek()
    var r = LLVM::reinterpret_bits[Hijacked[Array[U64, 3]], Hijacked[U192]](rem.hijack()).peek()
    if LLVM::int_ne[U192](a: r, b: 0)
      return LLVM::bit_or(a: q, b: LLVM::zero_extend[U64, U192](1_u64))
    return q

### Diagnostic name (raw wide intermediate; not decimal-formatted).
@override
routine U192.represent() -> Text
  return wide_dec[U192](me)

### Diagnostic representation tagged with the type name.
@override
routine U192.diagnose() -> Text
  return "U192"
