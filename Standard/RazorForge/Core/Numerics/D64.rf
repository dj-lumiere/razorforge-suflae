module Core

import Collections

### Represents a 64-bit IEEE 754 decimal floating-point value.
### `D64` is the general-purpose decimal type for calculations that need more
### range and precision than `D32` while preserving decimal semantics.
@llvm("i64")
record D64 obeys Numeric, Ordered
  pass

# Constants for D64
preset D64_ZERO: D64 = 0.0_d64
preset D64_ONE: D64 = 1.0_d64

# ============================================================================
# Creators
# ============================================================================

### Converts an `S8` into decimal64 form.
### :param from: The signed 8-bit integer to convert.
### :returns: The corresponding `D64` value.
routine D64.$create(from: S8) -> D64
  var bits = rf_d64_from_s32(S32(from))
  return reinterpret_bits[U64, D64](bits)

### Converts an `S16` into decimal64 form.
### :param from: The signed 16-bit integer to convert.
### :returns: The corresponding `D64` value.
routine D64.$create(from: S16) -> D64
  var bits = rf_d64_from_s32(S32(from))
  return reinterpret_bits[U64, D64](bits)

### Converts an `S32` into decimal64 form.
### :param from: The signed 32-bit integer to convert.
### :returns: The corresponding `D64` value.
routine D64.$create(from: S32) -> D64
  var bits = rf_d64_from_s32(from)
  return reinterpret_bits[U64, D64](bits)

### Converts an `S64` into decimal64 form.
### :param from: The signed 64-bit integer to convert.
### :returns: The corresponding `D64` value.
routine D64.$create(from: S64) -> D64
  var bits = rf_d64_from_s64(from)
  return reinterpret_bits[U64, D64](bits)

### Converts an `S128` into decimal64 form through the supported integer path.
### :param from: The signed 128-bit integer to convert.
### :returns: The closest representable `D64` value.
routine D64.$create(from: S128) -> D64
  # Convert through S64 - may lose precision
  return from.S64!().D64()

### Converts a `U8` into decimal64 form.
### :param from: The unsigned 8-bit integer to convert.
### :returns: The corresponding `D64` value.
routine D64.$create(from: U8) -> D64
  var bits = rf_d64_from_u32(U32(from))
  return reinterpret_bits[U64, D64](bits)

### Converts a `U16` into decimal64 form.
### :param from: The unsigned 16-bit integer to convert.
### :returns: The corresponding `D64` value.
routine D64.$create(from: U16) -> D64
  var bits = rf_d64_from_u32(U32(from))
  return reinterpret_bits[U64, D64](bits)

### Converts a `U32` into decimal64 form.
### :param from: The unsigned 32-bit integer to convert.
### :returns: The corresponding `D64` value.
routine D64.$create(from: U32) -> D64
  var bits = rf_d64_from_u32(from)
  return reinterpret_bits[U64, D64](bits)

### Converts a `U64` into decimal64 form.
### :param from: The unsigned 64-bit integer to convert.
### :returns: The corresponding `D64` value.
routine D64.$create(from: U64) -> D64
  var bits = rf_d64_from_u64(from)
  return reinterpret_bits[U64, D64](bits)

### Converts a `U128` into decimal64 form through the supported integer path.
### :param from: The unsigned 128-bit integer to convert.
### :returns: The closest representable `D64` value.
routine D64.$create(from: U128) -> D64
  # Convert through U64 - may lose precision
  return from.U64!().D64()

### Converts a half-precision binary float to decimal64.
### :param from: The binary floating-point input.
### :returns: The closest representable `D64` value.
routine D64.$create(from: F16) -> D64
  return from.F32().D64()

### Converts a single-precision binary float to decimal64.
### :param from: The binary floating-point input.
### :returns: The closest representable `D64` value.
routine D64.$create(from: F32) -> D64
  var bits = rf_f32_to_d64(from)
  return reinterpret_bits[U64, D64](bits)

### Converts a double-precision binary float to decimal64.
### :param from: The binary floating-point input.
### :returns: The closest representable `D64` value.
routine D64.$create(from: F64) -> D64
  var bits = rf_f64_to_d64(from)
  return reinterpret_bits[U64, D64](bits)

### Converts a quadruple-precision binary float to decimal64 through the supported runtime path.
### :param from: The binary floating-point input.
### :returns: The closest representable `D64` value.
routine D64.$create(from: F128) -> D64
  return from.F64!().D64()

### Widens a decimal32 value to decimal64.
### :param from: The decimal floating-point input.
### :returns: The corresponding `D64` value.
routine D64.$create(from: D32) -> D64
  var bits = from.to_bits()
  var result_bits = rf_d32_to_d64(bits)
  return reinterpret_bits[U64, D64](result_bits)

### Returns an existing `D64` unchanged.
### :param from: The decimal64 value to forward.
### :returns: `from`.
routine D64.$create(from: D64) -> D64
  return from

### Narrows a decimal128 value to decimal64.
### :param from: The decimal floating-point input.
### :returns: The closest representable `D64` value.
routine D64.$create(from: D128) -> D64
  var result_bits = rf_d128_to_d64(low: from.low_bits(), high: from.high_bits())
  return reinterpret_bits[U64, D64](result_bits)

# ============================================================================
# Arithmetic Operations
# ============================================================================

### Returns the decimal sum `me + you`, throwing if the result is non-finite.
### :param you: The addend.
### :returns: The resulting `D64` value.
### :throws: {NumericOverflowError} if the result is non-finite.
routine D64.$add!(you: D64) -> D64
  var a_bits = reinterpret_bits[D64, U64](me)
  var b_bits = reinterpret_bits[D64, U64](you)
  var result = rf_d64_add(a: a_bits, b: b_bits)
  if rf_d64_isfinite(result) == 0_s32
    throw NumericOverflowError(description: f"D64 addition produced non-finite result: {me} + {you}")
  return reinterpret_bits[U64, D64](result)

### Returns the decimal difference `me - you`, throwing if the result is non-finite.
### :param you: The value to subtract.
### :returns: The resulting `D64` value.
### :throws: {NumericOverflowError} if the result is non-finite.
routine D64.$sub!(you: D64) -> D64
  var a_bits = reinterpret_bits[D64, U64](me)
  var b_bits = reinterpret_bits[D64, U64](you)
  var result = rf_d64_sub(a: a_bits, b: b_bits)
  if rf_d64_isfinite(result) == 0_s32
    throw NumericOverflowError(description: f"D64 subtraction produced non-finite result: {me} - {you}")
  return reinterpret_bits[U64, D64](result)

### Returns the decimal product `me * you`, throwing if the result is non-finite.
### :param you: The multiplier.
### :returns: The resulting `D64` value.
### :throws: {NumericOverflowError} if the result is non-finite.
routine D64.$mul!(you: D64) -> D64
  var a_bits = reinterpret_bits[D64, U64](me)
  var b_bits = reinterpret_bits[D64, U64](you)
  var result = rf_d64_mul(a: a_bits, b: b_bits)
  if rf_d64_isfinite(result) == 0_s32
    throw NumericOverflowError(description: f"D64 multiplication produced non-finite result: {me} * {you}")
  return reinterpret_bits[U64, D64](result)

### Returns the decimal quotient `me / you`, throwing if the result is non-finite.
### :param you: The divisor.
### :returns: The resulting `D64` value.
### :throws: {NumericOverflowError} if the result is non-finite (including division by zero).
routine D64.$truediv!(you: D64) -> D64
  var a_bits = reinterpret_bits[D64, U64](me)
  var b_bits = reinterpret_bits[D64, U64](you)
  var result = rf_d64_div(a: a_bits, b: b_bits)
  if rf_d64_isfinite(result) == 0_s32
    throw NumericOverflowError(description: f"D64 division produced non-finite result: {me} / {you}")
  return reinterpret_bits[U64, D64](result)

### Adds `me + you` without finiteness checking (raw IEEE 754-2008 decimal).
dangerous routine D64.$add_unchecked(you: D64) -> D64
  var a_bits = reinterpret_bits[D64, U64](me)
  var b_bits = reinterpret_bits[D64, U64](you)
  return reinterpret_bits[U64, D64](rf_d64_add(a: a_bits, b: b_bits))

### Subtracts `me - you` without finiteness checking (raw IEEE 754-2008 decimal).
dangerous routine D64.$sub_unchecked(you: D64) -> D64
  var a_bits = reinterpret_bits[D64, U64](me)
  var b_bits = reinterpret_bits[D64, U64](you)
  return reinterpret_bits[U64, D64](rf_d64_sub(a: a_bits, b: b_bits))

### Multiplies `me * you` without finiteness checking (raw IEEE 754-2008 decimal).
dangerous routine D64.$mul_unchecked(you: D64) -> D64
  var a_bits = reinterpret_bits[D64, U64](me)
  var b_bits = reinterpret_bits[D64, U64](you)
  return reinterpret_bits[U64, D64](rf_d64_mul(a: a_bits, b: b_bits))

### Divides `me / you` without finiteness checking (raw IEEE 754-2008 decimal).
dangerous routine D64.$truediv_unchecked(you: D64) -> D64
  var a_bits = reinterpret_bits[D64, U64](me)
  var b_bits = reinterpret_bits[D64, U64](you)
  return reinterpret_bits[U64, D64](rf_d64_div(a: a_bits, b: b_bits))

### Returns `true` when this decimal value is finite.
### :returns: Whether the runtime encoding represents a finite number.
routine D64.is_finite() -> Bool
  return rf_d64_isfinite(me.to_bits()) != 0_s32

### Returns the additive inverse of this decimal value.
### :returns: The resulting `D64` value.
routine D64.$neg() -> D64
  var zero_bits = reinterpret_bits[D64, U64](D64_ZERO)
  var me_bits = reinterpret_bits[D64, U64](me)
  var result = rf_d64_sub(a: zero_bits, b: me_bits)
  return reinterpret_bits[U64, D64](result)

# ============================================================================
# Comparison Operations
# ============================================================================

### Returns whether both values are equal.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
routine D64.$eq(you: D64) -> Bool
  var a_bits = reinterpret_bits[D64, U64](me)
  var b_bits = reinterpret_bits[D64, U64](you)
  return rf_d64_cmp(a: a_bits, b: b_bits) == 0

### Compares this value with the other value.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
routine D64.$cmp(you: D64) -> ComparisonSign
  var a_bits = reinterpret_bits[D64, U64](me)
  var b_bits = reinterpret_bits[D64, U64](you)
  var cmp = rf_d64_cmp(a: a_bits, b: b_bits)
  if cmp < 0
    return ME_SMALL
  if cmp > 0
    return ME_LARGE
  return SAME

# ============================================================================
# Math Operations
# ============================================================================

### Returns the decimal square root of this value.
### :returns: The resulting `D64` value.
routine D64.sqrt() -> D64
  var bits = reinterpret_bits[D64, U64](me)
  var result = rf_d64_sqrt(bits)
  return reinterpret_bits[U64, D64](result)

### Returns the absolute value.
### :returns: The resulting `D64` value.
routine D64.abs() -> D64
  var bits = reinterpret_bits[D64, U64](me)
  var result = rf_d64_abs(bits)
  return reinterpret_bits[U64, D64](result)

### Rounds this decimal value toward positive infinity.
### :returns: The resulting `D64` value.
routine D64.ceil() -> D64
  var bits = reinterpret_bits[D64, U64](me)
  var result = rf_d64_ceil(bits)
  return reinterpret_bits[U64, D64](result)

### Rounds this decimal value toward negative infinity.
### :returns: The resulting `D64` value.
routine D64.floor() -> D64
  var bits = reinterpret_bits[D64, U64](me)
  var result = rf_d64_floor(bits)
  return reinterpret_bits[U64, D64](result)

### Rounds this decimal value to the nearest integral decimal value.
### :returns: The resulting `D64` value.
routine D64.round() -> D64
  var bits = reinterpret_bits[D64, U64](me)
  var result = rf_d64_round(bits)
  return reinterpret_bits[U64, D64](result)

### Truncates this decimal value toward zero.
### :returns: The resulting `D64` value.
routine D64.int_truncate() -> D64
  var bits = reinterpret_bits[D64, U64](me)
  var result = rf_d64_trunc(bits)
  return reinterpret_bits[U64, D64](result)

# ============================================================================
# Utility Methods
# ============================================================================

### Returns the smaller of this value and `you`.
### :param you: The other value to compare against.
### :returns: The resulting `D64` value.
routine D64.min(you: D64) -> D64
  var a_bits = reinterpret_bits[D64, U64](me)
  var b_bits = reinterpret_bits[D64, U64](you)
  return (if rf_d64_cmp(a: a_bits, b: b_bits) <= 0 then me else you)

### Returns the larger of this value and `you`.
### :param you: The other value to compare against.
### :returns: The resulting `D64` value.
routine D64.max(you: D64) -> D64
  var a_bits = reinterpret_bits[D64, U64](me)
  var b_bits = reinterpret_bits[D64, U64](you)
  return (if rf_d64_cmp(a: a_bits, b: b_bits) >= 0 then me else you)

### Restricts this value to the closed interval `[min_val, max_val]`.
### :param min_val: The lower bound to enforce.
### :param max_val: The upper bound to enforce.
### :returns: The resulting `D64` value.
@positional
routine D64.clamp(min_val: D64, max_val: D64) -> D64
  return me.min(max_val).max(min_val)

### Returns `true` when this decimal value is greater than zero.
### :returns: The resulting `Bool` value.
routine D64.is_positive() -> Bool
  var me_bits = reinterpret_bits[D64, U64](me)
  var zero_bits = reinterpret_bits[D64, U64](D64_ZERO)
  return rf_d64_cmp(a: me_bits, b: zero_bits) > 0

### Returns `true` when this decimal value is less than zero.
### :returns: The resulting `Bool` value.
routine D64.is_negative() -> Bool
  var me_bits = reinterpret_bits[D64, U64](me)
  var zero_bits = reinterpret_bits[D64, U64](D64_ZERO)
  return rf_d64_cmp(a: me_bits, b: zero_bits) < 0

### Returns `true` when this decimal value compares equal to zero.
### :returns: The resulting `Bool` value.
routine D64.is_zero() -> Bool
  var me_bits = reinterpret_bits[D64, U64](me)
  var zero_bits = reinterpret_bits[D64, U64](D64_ZERO)
  return rf_d64_cmp(a: me_bits, b: zero_bits) == 0

### Returns the sign of this value as `-1d64`, `0d64`, or `1d64`.
### :returns: The resulting `D64` value.
routine D64.signum() -> D64
  var me_bits = reinterpret_bits[D64, U64](me)
  var zero_bits = reinterpret_bits[D64, U64](D64_ZERO)
  var cmp = rf_d64_cmp(a: me_bits, b: zero_bits)
  return when
    cmp > 0 => D64_ONE
    cmp < 0 => me.$neg()
    else => D64_ZERO

### Returns the raw decimal64 encoding of this value.
### :returns: The resulting `U64` value.
routine D64.to_bits() -> U64
  return reinterpret_bits[D64, U64](me)

### Reinterprets a raw decimal64 bit pattern as `D64`.
### :param bits: The encoded bit pattern.
### :returns: The resulting `D64` value.
common routine D64.from_bits(bits: U64) -> D64
  return reinterpret_bits[U64, D64](bits)

# ============================================================================
# Text Representation and Parsing
# ============================================================================

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
routine D64.$represent() -> Text
  var bits = reinterpret_bits[D64, U64](me)
  var cstr_result = rf_d64_to_string(bits)
  return Text(from: CStr(from_ptr: cstr_result))

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
routine D64.$diagnose() -> Text
  return "D64(" + me.$represent() + ")"

### Parses a decimal literal into a `D64`.
### :param from_text: The text to parse. Accepts standard decimal notation and
###   the special values `nan`, `inf`, and `infinity` (case-insensitive, with
###   optional leading sign).
### :returns: The `D64` value parsed from the input.
### :throws: {InvalidValueError} if the text is not a valid decimal literal.
routine D64.$create!(from_text: Text) -> D64
  var len = from_text.count()
  if len == 0u64
    throw InvalidValueError(input: from_text, target: "D64")
  var i = 0u64
  var first = from_text[0u64]
  if first == Character(0x002Bu32) or first == Character(0x002Du32)
    i = 1u64
    if i >= len
      throw InvalidValueError(input: from_text, target: "D64")
  var special = false
  var rest = len - i
  if rest >= 3u64
    var c0 = from_text[i].to_lowercase()
    var c1 = from_text[i + 1u64].to_lowercase()
    var c2 = from_text[i + 2u64].to_lowercase()
    if rest == 3u64 and c0 == Character(0x006Eu32) and c1 == Character(0x0061u32) and c2 == Character(0x006Eu32)
      special = true
    if rest == 3u64 and c0 == Character(0x0069u32) and c1 == Character(0x006Eu32) and c2 == Character(0x0066u32)
      special = true
    if not special and rest == 8u64 and c0 == Character(0x0069u32) and c1 == Character(0x006Eu32) and c2 == Character(0x0066u32)
      var c3 = from_text[i + 3u64].to_lowercase()
      var c4 = from_text[i + 4u64].to_lowercase()
      var c5 = from_text[i + 5u64].to_lowercase()
      var c6 = from_text[i + 6u64].to_lowercase()
      var c7 = from_text[i + 7u64].to_lowercase()
      if c3 == Character(0x0069u32) and c4 == Character(0x006Eu32) and c5 == Character(0x0069u32) and c6 == Character(0x0074u32) and c7 == Character(0x0079u32)
        special = true
  if not special
    var has_digit = false
    var has_dot = false
    var has_exp = false
    while i < len
      var ch = from_text[i]
      if ch.is_numeric()
        has_digit = true
      elseif ch == Character(0x002Eu32)
        if has_dot or has_exp
          throw InvalidValueError(input: from_text, target: "D64")
        has_dot = true
      elseif ch == Character(0x0065u32) or ch == Character(0x0045u32)
        if has_exp or not has_digit
          throw InvalidValueError(input: from_text, target: "D64")
        has_exp = true
        has_digit = false
        if i + 1u64 < len
          var next_ch = from_text[i + 1u64]
          if next_ch == Character(0x002Bu32) or next_ch == Character(0x002Du32)
            i = i + 1u64
      else
        throw InvalidValueError(input: from_text, target: "D64")
      i = i + 1u64
    if not has_digit
      throw InvalidValueError(input: from_text, target: "D64")
  var cstr_val = CStr(from: from_text)
  var bits = rf_d64_from_string(cstr_val)
  return reinterpret_bits[U64, D64](bits)

# ============================================================================
# Hashing
# ============================================================================

### Returns an xxHash64-based hash of this value, derived from its raw bit pattern.
### :returns: A `U64` hash of the decimal64 encoding.
routine D64.$fast_hash() -> U64
  return __hash_leaf(v: reinterpret_bits[D64, U64](me))

# ============================================================================
# Byte Representation
# ============================================================================

### Returns the raw bytes of this value in little-endian order.
### :returns: The resulting `Array[Byte, 8]` value.
routine D64.to_bytes_le() -> Array[Byte, 8]
  var raw = reinterpret_bits[D64, U64](me)
  var result = Array[Byte, 8]()
  result = set_byte_at(array: result, index: 0u64, value: int_truncate[U64, U8](raw))
  result = set_byte_at(array: result, index: 1_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](raw, 8_u64)))
  result = set_byte_at(array: result, index: 2_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](raw, 16_u64)))
  result = set_byte_at(array: result, index: 3_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](raw, 24_u64)))
  result = set_byte_at(array: result, index: 4_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](raw, 32_u64)))
  result = set_byte_at(array: result, index: 5_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](raw, 40u64)))
  result = set_byte_at(array: result, index: 6_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](raw, 48_u64)))
  result = set_byte_at(array: result, index: 7_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](raw, 56_u64)))
  return result

### Returns the raw bytes of this value in big-endian order.
### :returns: The resulting `Array[Byte, 8]` value.
routine D64.to_bytes_be() -> Array[Byte, 8]
  var raw = byte_swap[U64](reinterpret_bits[D64, U64](me))
  var result = Array[Byte, 8]()
  result = set_byte_at(array: result, index: 0u64, value: int_truncate[U64, U8](raw))
  result = set_byte_at(array: result, index: 1_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](raw, 8_u64)))
  result = set_byte_at(array: result, index: 2_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](raw, 16_u64)))
  result = set_byte_at(array: result, index: 3_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](raw, 24_u64)))
  result = set_byte_at(array: result, index: 4_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](raw, 32_u64)))
  result = set_byte_at(array: result, index: 5_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](raw, 40u64)))
  result = set_byte_at(array: result, index: 6_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](raw, 48_u64)))
  result = set_byte_at(array: result, index: 7_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](raw, 56_u64)))
  return result

### Returns a keyed hash of this value using SipHash-2-4.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: The resulting `U64` value.
routine D64.$hash(k0: U64, k1: U64) -> U64
  return __secure_hash_u64(v: reinterpret_bits[D64, U64](me), k0: k0, k1: k1)
