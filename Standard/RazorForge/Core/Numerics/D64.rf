module Core

import Collections

# CREDITS: the BID (Binary-Integer-Decimal) encoding, rounding, and exponent rules of
# this decimal64 engine are a port and extension of Intel's Decimal Floating-Point
# Math Library ("libbid", © Intel Corporation, BSD 3-Clause). See THIRD-PARTY-NOTICES.md.


# ============================================================================
# D64 — software IEEE 754-2008 decimal64 (BID). Operands are U64 (decimal64's
# coefficient has <= 16 digits, < 2^54); products/sums widen to U128 only where
# needed. Real BID64 storage: Form 1 (coeff < 2^53), Form 2 (large coeff, implicit
# 2^53), plus inf/NaN via the combination prefix.
#
# Pmax=16, Emax=384, Emin=-383, bias=398, stored exponent q in [-398, 369].
# Decodes to a narrow U64-coefficient D64Parts; converts to D128Parts only for the
# cold special-value / formatter paths. (64-bit storage shifts use direct U64
# literals — uf_amt[U64] is not width-safe.)
# ============================================================================


### A software decimal64 value in BID storage.
@llvm("i64")
record D64 obeys Numeric, Ordered
  pass

### Narrow decoded fields (U64 coefficient — decimal64 has <= 16 digits).
record D64Parts
  sign: Bool
  special: U64
  exp: S64
  coeff: U64

### Widen to D128Parts for the shared special-value rules / decimal formatter.
routine d64parts_to_d128(p: D64Parts) -> D128Parts
  return D128Parts(sign: p.sign, special: p.special, exp: p.exp, coeff: zero_extend[U64, U128](p.coeff))

### Narrow a D128Parts back (special-rule results are inf/NaN/zero, coeff 0 — lossless).
routine d128_to_d64parts(p: D128Parts) -> D64Parts
  return D64Parts(sign: p.sign, special: p.special, exp: p.exp, coeff: int_truncate[U128, U64](p.coeff))

### 10^k as a U128 (k <= 38), via the U256 pow10 table truncated.
routine p10_u128(k: S64) -> U128
  return int_truncate[U256, U128](pow10_tbl(k: k))

### 10^k as a U64 (k <= 19).
routine p10_u64_d(k: S64) -> U64
  return int_truncate[U256, U64](pow10_tbl(k: k))

# ---- raw bits ----
routine D64.to_bits() -> U64
  return reinterpret_bits[D64, U64](me)

common routine D64.from_bits(bits: U64) -> D64
  return reinterpret_bits[U64, D64](bits)

### BID64 decode -> narrow parts.
routine D64.decode() -> D64Parts
  var bits = me.to_bits()
  var sign = int_ne[U64](a: bit_and[U64](a: shift_right_unsigned[U64](bits, 63_u64), b: 1_u64), b: 0_u64)
  var top5 = bit_and[U64](a: shift_right_unsigned[U64](bits, 58_u64), b: 0x1F_u64)
  if int_eq[U64](a: top5, b: 0x1E_u64)
    return D64Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: 0_u64)
  if int_eq[U64](a: top5, b: 0x1F_u64)
    var sp = 2_u64
    if int_ne[U64](a: bit_and[U64](a: shift_right_unsigned[U64](bits, 57_u64), b: 1_u64), b: 0_u64)
      sp = 3_u64
    return D64Parts(sign: sign, special: sp, exp: 0_s64, coeff: 0_u64)
  var biased = 0_u64
  var c64 = 0_u64
  if int_eq[U64](a: shift_right_unsigned[U64](top5, 3_u64), b: 3_u64)
    # Form 2: exp bits 60:51, coeff = (bits 50:0) | 2^53
    biased = bit_and[U64](a: shift_right_unsigned[U64](bits, 51_u64), b: 0x3FF_u64)
    c64 = bit_or[U64](a: bit_and[U64](a: bits, b: 0x7FFFFFFFFFFFF_u64), b: 0x20000000000000_u64)
  else
    # Form 1: exp bits 62:53, coeff bits 52:0
    biased = bit_and[U64](a: shift_right_unsigned[U64](bits, 53_u64), b: 0x3FF_u64)
    c64 = bit_and[U64](a: bits, b: 0x1FFFFFFFFFFFFF_u64)
  return D64Parts(sign: sign, special: 0_u64, exp: sub[S64](a: reinterpret_bits[U64, S64](biased), b: 398_s64), coeff: c64)

### Narrow parts -> BID64 (Form 1 / Form 2 / special). Finite parts must already be
### rounded to <= 16 digits and in the decimal64 exponent range (decfin64 guarantees it).
routine d64_of_parts(p: D64Parts) -> D64
  var sbit = shift_left[U64](value: if p.sign then 1_u64 else 0_u64, bits: 63_u64)
  if int_ne[U64](a: p.special, b: 0_u64)
    var top5 = if int_eq[U64](a: p.special, b: 1_u64) then 0x1E_u64 else 0x1F_u64
    var bb = bit_or[U64](a: sbit, b: shift_left[U64](value: top5, bits: 58_u64))
    if int_eq[U64](a: p.special, b: 3_u64)
      bb = bit_or[U64](a: bb, b: shift_left[U64](value: 1_u64, bits: 57_u64))
    return D64.from_bits(bits: bb)
  var biased = bit_and[U64](a: add[U64](a: reinterpret_bits[S64, U64](p.exp), b: 398_u64), b: 0x3FF_u64)
  var c64 = p.coeff
  if unsigned_lt[U64](a: c64, b: 0x20000000000000_u64)
    # Form 1: exp bits 62:53, coeff bits 52:0
    return D64.from_bits(bits: bit_or[U64](a: bit_or[U64](a: sbit, b: shift_left[U64](value: biased, bits: 53_u64)), b: c64))
  # Form 2: bits 62:61 = 11, exp bits 60:51, coeff low 51 bits (implicit 2^53)
  var g2 = shift_left[U64](value: 0x3_u64, bits: 61_u64)
  var ebits = shift_left[U64](value: biased, bits: 51_u64)
  var clow = bit_and[U64](a: c64, b: 0x7FFFFFFFFFFFF_u64)
  return D64.from_bits(bits: bit_or[U64](a: bit_or[U64](a: sbit, b: g2), b: bit_or[U64](a: ebits, b: clow)))

### Builds a finite D64 from a signed coefficient and base-10 exponent (rounded/ranged).
common routine D64.from_components(sign: Bool, coeff: U64, exp: S64) -> D64
  return d64_of_parts(p: decfin64(sign: sign, coeff: zero_extend[U64, U128](coeff), exp: exp, pref: exp))

### Builds a D64 from a 64-bit signed integer (exponent 0).
common routine D64.from_int64(value: S64) -> D64
  var neg = signed_lt[S64](a: value, b: 0_s64)
  var mag = if neg then sub[S64](a: 0_s64, b: value) else value
  return D64.from_components(sign: neg, coeff: reinterpret_bits[S64, U64](mag), exp: 0_s64)

### Infinity / quiet NaN.
common routine D64.infinity(sign: Bool) -> D64
  return d64_of_parts(p: D64Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: 0_u64))
common routine D64.quiet_nan() -> D64
  return d64_of_parts(p: D64Parts(sign: false, special: 2_u64, exp: 0_s64, coeff: 0_u64))

routine D64.is_finite() -> Bool
  return int_eq[U64](a: me.decode().special, b: 0_u64)
routine D64.is_infinite() -> Bool
  return int_eq[U64](a: me.decode().special, b: 1_u64)
routine D64.is_nan() -> Bool
  return unsigned_ge[U64](a: me.decode().special, b: 2_u64)

# ============================================================================
# Finalize: round a U128 working coeff to Pmax=16, clamp exponent to [-398, 369]
# (overflow -> inf, underflow -> round-off / zero), strip/pad toward pref; the
# rounded result fits U64.
# ============================================================================
routine decfin64(sign: Bool, coeff: U128, exp: S64, pref: S64) -> D64Parts
  if int_eq[U128](a: coeff, b: 0)
    var ez = pref
    if signed_lt[S64](a: ez, b: -398_s64)
      ez = -398_s64
    if signed_gt[S64](a: ez, b: 369_s64)
      ez = 369_s64
    return D64Parts(sign: sign, special: 0_u64, exp: ez, coeff: 0_u64)
  var c = coeff
  var e = exp
  var nd = digits10_u128(c: c)
  if signed_gt[S64](a: nd, b: 16_s64)
    var drop = sub[S64](a: nd, b: 16_s64)
    var divv = p10_u128(k: drop)
    var q = div_pow10_u128(x: c, k: drop)
    var r = sub[U128](a: c, b: mul[U128](a: q, b: divv))
    var twice = mul[U128](a: r, b: 2)
    if unsigned_gt[U128](a: twice, b: divv)
      q = add[U128](a: q, b: 1)
    elseif int_eq[U128](a: twice, b: divv) and int_ne[U128](a: bit_and[U128](a: q, b: 1), b: 0)
      q = add[U128](a: q, b: 1)
    c = q
    e = add[S64](a: e, b: drop)
    if unsigned_ge[U128](a: c, b: p10_u128(k: 16_s64))
      c = div_pow10_u128(x: c, k: 1_s64)
      e = add[S64](a: e, b: 1_s64)
  # overflow: pad up to 16 digits, then saturate to inf
  while signed_gt[S64](a: e, b: 369_s64) and unsigned_lt[U128](a: c, b: p10_u128(k: 15_s64))
    c = mul[U128](a: c, b: 10_u128)
    e = sub[S64](a: e, b: 1_s64)
  if signed_gt[S64](a: e, b: 369_s64)
    return D64Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: 0_u64)
  # underflow: round off low digits until e reaches the minimum
  while signed_lt[S64](a: e, b: -398_s64) and int_ne[U128](a: c, b: 0)
    var rd = unsigned_rem[U128](a: c, b: 10_u128)
    c = unsigned_div[U128](a: c, b: 10_u128)
    e = add[S64](a: e, b: 1_s64)
    if unsigned_gt[U128](a: rd, b: 5) or (int_eq[U128](a: rd, b: 5) and int_ne[U128](a: bit_and[U128](a: c, b: 1), b: 0))
      c = add[U128](a: c, b: 1)
  if int_eq[U128](a: c, b: 0)
    var ez2 = if signed_lt[S64](a: e, b: -398_s64) then -398_s64 else e
    return D64Parts(sign: sign, special: 0_u64, exp: ez2, coeff: 0_u64)
  # strip trailing zeros toward pref (raise e); pad toward pref (lower e) within 16 digits
  while signed_lt[S64](a: e, b: pref) and int_eq[U128](a: unsigned_rem[U128](a: c, b: 10_u128), b: 0)
    c = unsigned_div[U128](a: c, b: 10_u128)
    e = add[S64](a: e, b: 1_s64)
  while signed_gt[S64](a: e, b: pref) and unsigned_lt[U128](a: c, b: p10_u128(k: 15_s64)) and signed_le[S64](a: e, b: 369_s64)
    c = mul[U128](a: c, b: 10_u128)
    e = sub[S64](a: e, b: 1_s64)
  return D64Parts(sign: sign, special: 0_u64, exp: e, coeff: int_truncate[U128, U64](c))

# ============================================================================
# Arithmetic (U64 operands, U128 intermediates)
# ============================================================================
routine d64_mul(a: D64, b: D64) -> D64
  var pa = a.decode()
  var pb = b.decode()
  if int_ne[U64](a: pa.special, b: 0_u64) or int_ne[U64](a: pb.special, b: 0_u64)
    return d64_of_parts(p: d128_to_d64parts(mul_special_parts(pa: d64parts_to_d128(p: pa), pb: d64parts_to_d128(p: pb))))
  var sign = pa.sign != pb.sign
  # 64x64 -> 128 widening product (both operands fit U64).
  var prod = mul[U128](a: zero_extend[U64, U128](pa.coeff), b: zero_extend[U64, U128](pb.coeff))
  return d64_of_parts(p: decfin64(sign: sign, coeff: prod, exp: add[S64](a: pa.exp, b: pb.exp), pref: add[S64](a: pa.exp, b: pb.exp)))

routine d64_add(a: D64, b: D64) -> D64
  var pa = a.decode()
  var pb = b.decode()
  if int_ne[U64](a: pa.special, b: 0_u64) or int_ne[U64](a: pb.special, b: 0_u64)
    return d64_of_parts(p: d128_to_d64parts(add_special_parts(pa: d64parts_to_d128(p: pa), pb: d64parts_to_d128(p: pb))))
  var eh = pa.exp
  var ch = pa.coeff
  var sh = pa.sign
  var el = pb.exp
  var cl = pb.coeff
  var sl = pb.sign
  if signed_lt[S64](a: pa.exp, b: pb.exp)
    eh = pb.exp
    ch = pb.coeff
    sh = pb.sign
    el = pa.exp
    cl = pa.coeff
    sl = pa.sign
  var pref = el
  var shift = sub[S64](a: eh, b: el)
  var ew = el
  var chw = zero_extend[U64, U128](0_u64)
  var clw = zero_extend[U64, U128](0_u64)
  if signed_le[S64](a: shift, b: 18_s64)
    # 64x64 -> 128 widening align (10^shift fits U64 for shift <= 18).
    chw = mul[U128](a: zero_extend[U64, U128](ch), b: zero_extend[U64, U128](p10_u64_d(k: shift)))
    clw = zero_extend[U64, U128](cl)
  else
    chw = mul[U128](a: zero_extend[U64, U128](ch), b: zero_extend[U64, U128](p10_u64_d(k: 18_s64)))
    ew = sub[S64](a: eh, b: 18_s64)
    # keep the low operand's in-window digits (down to ew) in U64; sticky only below.
    var drop = sub[S64](a: shift, b: 18_s64)
    if signed_ge[S64](a: drop, b: 16_s64)
      clw = if int_ne[U64](a: cl, b: 0_u64) then zero_extend[U64, U128](1_u64) else zero_extend[U64, U128](0_u64)
    else
      var q = div_pow10_u64(x: cl, k: drop)
      var rem = sub[U64](a: cl, b: mul[U64](a: q, b: p10_u64_d(k: drop)))
      clw = zero_extend[U64, U128](if int_ne[U64](a: rem, b: 0_u64) then bit_or[U64](a: q, b: 1_u64) else q)
  var rc = zero_extend[U64, U128](0_u64)
  var rsign = sh
  if sh == sl
    rc = add[U128](a: chw, b: clw)
  elseif unsigned_ge[U128](a: chw, b: clw)
    rc = sub[U128](a: chw, b: clw)
  else
    rc = sub[U128](a: clw, b: chw)
    rsign = sl
  if int_eq[U128](a: rc, b: 0)
    # IEEE 754: a zero sum keeps the common sign ((-0)+(-0) = -0); opposite-sign
    # cancellation gives +0 (roundTiesToEven).
    rsign = if sh == sl then sh else false
  return d64_of_parts(p: decfin64(sign: rsign, coeff: rc, exp: ew, pref: pref))

### Negation: flip the sign bit.
routine d64_neg(a: D64) -> D64
  return D64.from_bits(bits: bit_xor[U64](a: a.to_bits(), b: shift_left[U64](value: 1_u64, bits: 63_u64)))

routine d64_sub(a: D64, b: D64) -> D64
  return d64_add(a: a, b: d64_neg(a: b))

routine d64_div(a: D64, b: D64) -> D64
  var pa = a.decode()
  var pb = b.decode()
  if int_ne[U64](a: pa.special, b: 0_u64) or int_ne[U64](a: pb.special, b: 0_u64)
    return d64_of_parts(p: d128_to_d64parts(div_special_parts(pa: d64parts_to_d128(p: pa), pb: d64parts_to_d128(p: pb))))
  var sign = pa.sign != pb.sign
  var azero = int_eq[U64](a: pa.coeff, b: 0_u64)
  var bzero = int_eq[U64](a: pb.coeff, b: 0_u64)
  if bzero
    if azero
      return d64_of_parts(p: D64Parts(sign: false, special: 2_u64, exp: 0_s64, coeff: 0_u64))
    return d64_of_parts(p: D64Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: 0_u64))
  var pref = sub[S64](a: pa.exp, b: pb.exp)
  if azero
    return d64_of_parts(p: decfin64(sign: sign, coeff: zero_extend[U64, U128](0_u64), exp: pref, pref: pref))
  var num = zero_extend[U64, U128](pa.coeff)
  var den = zero_extend[U64, U128](pb.coeff)
  # scale numerator to ~Pmax+2 quotient digits, divide, sticky, round to 16
  var target = add[S64](a: digits10_u128(c: den), b: 18_s64)
  var shift = sub[S64](a: target, b: digits10_u128(c: num))
  if signed_lt[S64](a: shift, b: 0_s64)
    shift = 0_s64
  num = mul[U128](a: num, b: p10_u128(k: shift))
  var q = ((num) // (den))
  var rem = sub[U128](a: num, b: mul[U128](a: q, b: den))
  if int_ne[U128](a: rem, b: 0)
    q = bit_or[U128](a: q, b: 1)
  var exp = sub[S64](a: sub[S64](a: pa.exp, b: pb.exp), b: shift)
  return d64_of_parts(p: decfin64(sign: sign, coeff: q, exp: exp, pref: pref))

# ---- wired operators + represent ----
routine D64.$add(you: D64) -> D64
  return d64_add(a: me, b: you)
routine D64.$sub(you: D64) -> D64
  return d64_sub(a: me, b: you)
routine D64.$mul(you: D64) -> D64
  return d64_mul(a: me, b: you)
routine D64.$truediv(you: D64) -> D64
  return d64_div(a: me, b: you)

### Decimal value equality (NaN never equal; infinities equal only with the same sign;
### finite values compare by value, so different cohorts of the same number are equal).
routine D64.$eq(you: D64) -> Bool
  if me.is_nan() or you.is_nan()
    return false
  if me.is_infinite() or you.is_infinite()
    var pa = me.decode()
    var pb = you.decode()
    return int_eq[U64](a: pa.special, b: pb.special) and pa.sign == pb.sign
  return int_eq[U64](a: d64_sub(a: me, b: you).decode().coeff, b: 0_u64)

### Three-way decimal comparison (NaN unordered -> SAME; finite by sign of me - you).
routine D64.$cmp(you: D64) -> ComparisonSign
  if me.is_nan() or you.is_nan()
    return SAME
  if me.is_infinite() or you.is_infinite()
    var pa = me.decode()
    var pb = you.decode()
    if int_eq[U64](a: pa.special, b: pb.special) and pa.sign == pb.sign
      return SAME
    if int_eq[U64](a: pa.special, b: 1_u64)
      return if pa.sign then ME_SMALL else ME_LARGE
    return if pb.sign then ME_LARGE else ME_SMALL
  var d = d64_sub(a: me, b: you).decode()
  if int_eq[U64](a: d.coeff, b: 0_u64)
    return SAME
  return if d.sign then ME_SMALL else ME_LARGE

### Raises this value to the `you` power (IEEE semantics: inf/NaN on overflow/domain error).
routine D64.$pow(you: D64) -> D64
  return me.pow(you: you)

routine D64.$represent() -> Text
  return d128_represent(p: d64parts_to_d128(p: me.decode()))
routine D64.$diagnose() -> Text
  return "D64(" + me.$represent() + ")"

# ============================================================================
# Public surface — creators / presets / parser / hash / bytes
#
# The construction/conversion web, presets, byte/hash views, and the decimal-text
# parser. Storage, arithmetic, comparison, libm, and formatting are the software BID
# engine above (`@llvm("i64") record D64 obeys Numeric, Ordered`). Pure RF.
# ============================================================================

# ============================================================================
# Constants
# ============================================================================

preset D64_ZERO: D64 = 0.0_d64
preset D64_ONE: D64 = 1.0_d64

# ============================================================================
# Creators — integers
# ============================================================================

routine D64.$create(from: S8) -> D64
  return D64.from_int64(value: S64(from))
routine D64.$create(from: S16) -> D64
  return D64.from_int64(value: S64(from))
routine D64.$create(from: S32) -> D64
  return D64.from_int64(value: S64(from))
routine D64.$create(from: S64) -> D64
  return D64.from_int64(value: from)
routine D64.$create(from: S128) -> D64
  return D64(from: D128(from: from))

routine D64.$create(from: U8) -> D64
  return D64.from_components(sign: false, coeff: U64(from), exp: 0_s64)
routine D64.$create(from: U16) -> D64
  return D64.from_components(sign: false, coeff: U64(from), exp: 0_s64)
routine D64.$create(from: U32) -> D64
  return D64.from_components(sign: false, coeff: U64(from), exp: 0_s64)
routine D64.$create(from: U64) -> D64
  return D64.from_components(sign: false, coeff: from, exp: 0_s64)
routine D64.$create(from: U128) -> D64
  return D64(from: D128(from: from))

# ============================================================================
# Creators — binary floats (matched width is F128)
# ============================================================================

routine D64.$create(from: F16) -> D64
  return D64(from: F64(from))
routine D64.$create(from: F32) -> D64
  return D64(from: F64(from))
routine D64.$create(from: F64) -> D64
  return f128_to_d64(x: F128(from: from))
routine D64.$create(from: F128) -> D64
  return f128_to_d64(x: from)

# ============================================================================
# Creators — decimal <-> decimal
# ============================================================================

routine D64.$create(from: D32) -> D64
  return d64_of_parts(p: d128_to_d64parts(p: d32parts_to_d128(p: from.decode())))
routine D64.$create(from: D64) -> D64
  return from
routine D64.$create(from: D128) -> D64
  return d64_of_parts(p: d128_to_d64parts(p: from.decode()))

# ============================================================================
# Text parsing — shared D128 scanner, narrowed to D64.
# ============================================================================

### Parses a decimal literal into a `D64`.
### :throws: {InvalidValueError} if the text is not a valid decimal literal.
routine D64.$create!(from_text: Text) -> D64
  return D64(from: parse_decimal_d128!(from_text: from_text))

# ============================================================================
# Hashing
# ============================================================================

### Returns an xxHash64-based hash of the raw decimal64 encoding.
routine D64.$fast_hash() -> U64
  return __hash_u128(v: zero_extend[U64, U128](me.to_bits()))

# ============================================================================
# Byte Representation
# ============================================================================

### Returns the raw bytes of this value in little-endian order.
routine D64.to_bytes_le() -> Array[Byte, 8]
  var raw = me.to_bits()
  var result = Array[Byte, 8]()
  var i = 0_u64
  while unsigned_lt[U64](a: i, b: 8_u64)
    var b = int_truncate[U64, U8](shift_right_unsigned[U64](raw, mul[U64](a: i, b: 8_u64)))
    result = set_byte_at(array: result, index: i, value: b)
    i = add[U64](a: i, b: 1_u64)
  return result

### Returns the raw bytes of this value in big-endian order.
routine D64.to_bytes_be() -> Array[Byte, 8]
  var raw = me.to_bits()
  var result = Array[Byte, 8]()
  var i = 0_u64
  while unsigned_lt[U64](a: i, b: 8_u64)
    var b = int_truncate[U64, U8](shift_right_unsigned[U64](raw, mul[U64](a: sub[U64](a: 7_u64, b: i), b: 8_u64)))
    result = set_byte_at(array: result, index: i, value: b)
    i = add[U64](a: i, b: 1_u64)
  return result
