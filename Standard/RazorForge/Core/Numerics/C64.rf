module Core

### A complex number with single-precision real and imaginary components.
### `C64` stores two `B32` values and provides standard complex arithmetic,
### including the Gaussian identity for multiplication and polar-form construction.
### Use `C128` or `C256` when higher precision is needed.
record C64 obeys Numeric, Equatable
  ### The real part.
  real: B32
  ### The imaginary part.
  imag: B32

# Math routines use the component B32's `_unchecked` ops (raw IEEE, no overflow
# checks); NaN/±inf therefore propagate through the complex result per IEEE 754.

# Complex constants. `common routine` factories (not `preset`s): a `C64` value is a two-`B32` record, not
# a compile-time scalar constant, so inlining it at every use (what a `preset` does) leaves the
# construction unresolved / emits an undefined creator symbol at codegen.
### The complex zero value (0 + 0i). :returns: The resulting `C64` value.
common routine C64.zero() -> C64
  return C64(real: 0.0_b32, imag: 0.0_b32)
### The complex unit value (1 + 0i). :returns: The resulting `C64` value.
common routine C64.one() -> C64
  return C64(real: 1.0_b32, imag: 0.0_b32)
### The imaginary unit (0 + 1i). :returns: The resulting `C64` value.
common routine C64.i() -> C64
  return C64(real: 0.0_b32, imag: 1.0_b32)

# ============================================================================
# Creators
# ============================================================================

### Constructs a `C64` with the given real component and zero imaginary part.
### :param from: The real-axis value.
### :returns: The corresponding `C64` value.
routine C64(from: B32) -> C64
  return C64(real: from, imag: 0.0_b32)

### Narrows a `C128` to `C64` by truncating each component to `B32`.
### :param from: The double-precision complex value to narrow.
### :returns: The nearest representable `C64`.
routine C64(from: C128) -> C64
  return C64(real: B32(from.real), imag: B32(from.imag))

### Narrows a `C256` to `C64` by truncating each component to `B32`.
### :param from: The quadruple-precision complex value to narrow.
### :returns: The nearest representable `C64`.
routine C64(from: C256) -> C64
  return C64(real: B32(from.real), imag: B32(from.imag))

### Real scalar -> `C64` (imaginary part 0), routing the value through `B32`.
### :param from: A real integer or float value.
### :returns: `from + 0i` in single precision.
routine C64(from: S8) -> C64
  return C64(real: B32(from: from), imag: 0.0_b32)

### Real `S16` scalar -> `C64` (imaginary part 0), value routed through `B32`.
### :param from: A real integer value.
### :returns: `from + 0i` in single precision.
routine C64(from: S16) -> C64
  return C64(real: B32(from: from), imag: 0.0_b32)

### Real `S32` scalar -> `C64` (imaginary part 0), value routed through `B32`.
### :param from: A real integer value.
### :returns: `from + 0i` in single precision.
routine C64(from: S32) -> C64
  return C64(real: B32(from: from), imag: 0.0_b32)

### Real `S64` scalar -> `C64` (imaginary part 0), value routed through `B32`.
### :param from: A real integer value.
### :returns: `from + 0i` in single precision.
routine C64(from: S64) -> C64
  return C64(real: B32(from: from), imag: 0.0_b32)

### Real `S128` scalar -> `C64` (imaginary part 0), value routed through `B32`.
### :param from: A real integer value.
### :returns: `from + 0i` in single precision.
routine C64(from: S128) -> C64
  return C64(real: B32(from: from), imag: 0.0_b32)

### Real `S256` scalar -> `C64` (imaginary part 0), value routed through `B32`.
### :param from: A real integer value.
### :returns: `from + 0i` in single precision.
routine C64(from: S256) -> C64
  return C64(real: B32(from: from), imag: 0.0_b32)

### Real `U8` scalar -> `C64` (imaginary part 0), value routed through `B32`.
### :param from: A real integer value.
### :returns: `from + 0i` in single precision.
routine C64(from: U8) -> C64
  return C64(real: B32(from: from), imag: 0.0_b32)

### Real `U16` scalar -> `C64` (imaginary part 0), value routed through `B32`.
### :param from: A real integer value.
### :returns: `from + 0i` in single precision.
routine C64(from: U16) -> C64
  return C64(real: B32(from: from), imag: 0.0_b32)

### Real `U32` scalar -> `C64` (imaginary part 0), value routed through `B32`.
### :param from: A real integer value.
### :returns: `from + 0i` in single precision.
routine C64(from: U32) -> C64
  return C64(real: B32(from: from), imag: 0.0_b32)

### Real `U64` scalar -> `C64` (imaginary part 0), value routed through `B32`.
### :param from: A real integer value.
### :returns: `from + 0i` in single precision.
routine C64(from: U64) -> C64
  return C64(real: B32(from: from), imag: 0.0_b32)

### Real `U128` scalar -> `C64` (imaginary part 0), value routed through `B32`.
### :param from: A real integer value.
### :returns: `from + 0i` in single precision.
routine C64(from: U128) -> C64
  return C64(real: B32(from: from), imag: 0.0_b32)

### Real `U256` scalar -> `C64` (imaginary part 0), value routed through `B32`.
### :param from: A real integer value.
### :returns: `from + 0i` in single precision.
routine C64(from: U256) -> C64
  return C64(real: B32(from: from), imag: 0.0_b32)

### Real `B16` scalar -> `C64` (imaginary part 0), value widened to `B32`.
### :param from: A real float value.
### :returns: `from + 0i` in single precision.
routine C64(from: B16) -> C64
  return C64(real: B32(from: from), imag: 0.0_b32)

### Real `B64` scalar -> `C64` (imaginary part 0), value narrowed to `B32`.
### :param from: A real float value.
### :returns: `from + 0i` in single precision.
routine C64(from: B64) -> C64
  return C64(real: B32(from: from), imag: 0.0_b32)

### Real `B128` scalar -> `C64` (imaginary part 0), value narrowed to `B32`.
### :param from: A real float value.
### :returns: `from + 0i` in single precision.
routine C64(from: B128) -> C64
  return C64(real: B32(from: from), imag: 0.0_b32)

### Constructs a `C64` from polar coordinates: `r·cos(θ) + r·sin(θ)·i`.
### :param r: The modulus (distance from origin).
### :param theta: The argument (angle in radians).
### :returns: The complex value at that polar position.
routine C64.from_polar(r: B32, theta: B32) -> C64
  # Polar -> rectangular: z = r·e^(iθ) = r·cos θ + i·r·sin θ.
  return C64(real: r * theta.cos(), imag: r * theta.sin())

# ============================================================================
# Arithmetic Operations
# ============================================================================

### Returns the complex sum `me + you` (component-wise addition).
### :param you: The addend.
### :returns: A `C64` whose components are the sums of the corresponding components.
routine C64.add(you: C64) -> C64
  return C64(real: me.real + you.real, imag: me.imag + you.imag)

### Returns the complex difference `me - you` (component-wise subtraction).
### :param you: The value to subtract.
### :returns: A `C64` whose components are the differences of the corresponding components.
routine C64.sub(you: C64) -> C64
  return C64(real: me.real - you.real, imag: me.imag - you.imag)

### Returns `me + you`, promoting the real `you` to complex (imaginary part 0). Only `+`/`-` allow
### real↔complex mixing; the component width must match (B32 pairs with C64).
### :param you: The real addend.
### :returns: The complex sum.
routine C64.add(you: B32) -> C64
  return me.add(C64(from: you))

### Returns `me - you`, promoting the real `you` to complex (imaginary part 0).
### :param you: The real value to subtract.
### :returns: The complex difference.
routine C64.sub(you: B32) -> C64
  return me.sub(C64(from: you))

### Returns the complex product `me * you` using the formula `(ac−bd) + (ad+bc)i`.
### :param you: The right operand.
### :returns: The Gaussian product.
routine C64.mul(you: C64) -> C64
  # (a+bi)(c+di) = (ac − bd) + (ad + bc)i.
  return C64(real: me.real * you.real - me.imag * you.imag, imag: me.real * you.imag + me.imag * you.real)

### Returns the complex quotient `me / you`.
### Divides by the squared modulus of `you`.
### :param you: The divisor.
### :returns: The complex quotient.
routine C64.truediv(you: C64) -> C64
  # (a+bi)/(c+di) = (a+bi)(c−di)/|c+di|², with d = |denom|² = c²+d².
  var d = you.real * you.real + you.imag * you.imag
  # Real = (ac+bd)/d, imag = (bc−ad)/d.
  return C64(real: (me.real * you.real + me.imag * you.imag) / d, imag: (me.imag * you.real - me.real * you.imag) / d)

### Returns the arithmetic negation of this value.
### :returns: A `C64` with both components negated.
routine C64.neg() -> C64
  return C64(real: -me.real, imag: -me.imag)

# ============================================================================
# Comparison
# ============================================================================

### Returns `true` if both components compare equal.
### :param you: The value to compare against.
### :returns: `true` if `me.real == you.real` and `me.imag == you.imag`.
routine C64.eq(you: C64) -> Bool
  return me.real == you.real and me.imag == you.imag

# ============================================================================
# Components and Properties
# ============================================================================

### Returns the modulus (absolute value) of this complex number.
### :returns: `√(real² + imag²)`.
routine C64.abs() -> B32
  # |z| = √(re² + im²); uses raw IEEE sqrt_unchecked on the B32 sum.
  return (me.real * me.real + me.imag * me.imag).sqrt_unchecked()

### Returns the phase angle of this complex value in radians.
### :returns: `atan2(imag, real)`, in the range (−π, π].
routine C64.arg() -> B32
  # arg(z) = atan2(im, re); two-arg atan2 picks the correct quadrant.
  return atan2(y: me.imag, x: me.real)

### Returns the complex conjugate (negates the imaginary part).
### :returns: `real - imag·i`.
routine C64.conjugate() -> C64
  return C64(real: me.real, imag: -me.imag)

### Returns the squared modulus (avoids the square root of `abs`).
### :returns: `real² + imag²`.
routine C64.norm() -> B32
  # norm = re² + im² = |z|²; skips the sqrt that abs() performs.
  return me.real * me.real + me.imag * me.imag

# ============================================================================
# Trigonometric (sinh/cosh computed from exp since B32 lacks native versions)
# ============================================================================

### Returns the complex sine using the identity `sin(a+bi) = sin(a)cosh(b) + i·cos(a)sinh(b)`.
### :returns: The complex sine of this value.
routine C64.sin() -> C64
  # cosh(b)=(eᵇ+e⁻ᵇ)/2, sinh(b)=(eᵇ−e⁻ᵇ)/2 from raw exp (B32 has no native hyperbolics).
  var ep = me.imag.exp_unchecked()
  var em = (-me.imag).exp_unchecked()
  var ch = (ep + em) / 2.0_b32
  var sh = (ep - em) / 2.0_b32
  # sin(a+bi) = sin a·cosh b + i·cos a·sinh b.
  return C64(real: me.real.sin() * ch, imag: me.real.cos() * sh)

### Returns the complex cosine using the identity `cos(a+bi) = cos(a)cosh(b) − i·sin(a)sinh(b)`.
### :returns: The complex cosine of this value.
routine C64.cos() -> C64
  # cosh(b)=(eᵇ+e⁻ᵇ)/2, sinh(b)=(eᵇ−e⁻ᵇ)/2 from raw exp (B32 has no native hyperbolics).
  var ep = me.imag.exp_unchecked()
  var em = (-me.imag).exp_unchecked()
  var ch = (ep + em) / 2.0_b32
  var sh = (ep - em) / 2.0_b32
  # cos(a+bi) = cos a·cosh b − i·sin a·sinh b.
  return C64(real: me.real.cos() * ch, imag: -(me.real.sin() * sh))

### Returns the complex tangent of this value.
### :returns: The complex tangent.
routine C64.tan() -> C64
  # Double-angle form: a2 = 2a, b2 = 2b.
  var a2 = me.real + me.real
  var b2 = me.imag + me.imag
  var ep = b2.exp_unchecked()
  var em = (-b2).exp_unchecked()
  # d = cos(2a) + cosh(2b) is the shared denominator.
  var d = a2.cos() + (ep + em) / 2.0_b32
  # tan(a+bi) = sin(2a)/d + i·sinh(2b)/d.
  return C64(real: a2.sin() / d, imag: (ep - em) / 2.0_b32 / d)

### Returns the complex arcsine of this value.
### :returns: The principal value of `arcsin(me)`.
routine C64.asin() -> C64
  # asin(z) = −i·log(iz + √(1 − z²)); iz = (−im, re).
  var iz = C64(real: -me.imag, imag: me.real)
  var w = iz + (C64.one() - me * me).sqrt_unchecked()
  var v = w.log_unchecked()
  # Multiply log(w) by −i: (re, im) -> (im, −re).
  return C64(real: v.imag, imag: -v.real)

### Returns the complex arccosine of this value.
### :returns: The principal value of `arccos(me)`.
routine C64.acos() -> C64
  # acos(z) = −i·log(z + i·√(1 − z²)); i·s = (−s.im, s.re).
  var s = (C64.one() - me * me).sqrt_unchecked()
  var w = me + C64(real: -s.imag, imag: s.real)
  var v = w.log_unchecked()
  # Multiply log(w) by −i: (re, im) -> (im, −re).
  return C64(real: v.imag, imag: -v.real)

### Returns the complex arctangent of this value.
### :returns: The principal value of `arctan(me)`.
routine C64.atan() -> C64
  # atan(z) = (i/2)·log((i+z)/(i−z)); num = z+i, den = i−z.
  var num = C64(real: me.real, imag: me.imag + 1.0_b32)
  var den = C64(real: -me.real, imag: 1.0_b32 - me.imag)
  var v = (num / den).log_unchecked()
  # Multiply log by i/2: (re, im) -> (−im/2, re/2).
  return C64(real: -v.imag / 2.0_b32, imag: v.real / 2.0_b32)

# ============================================================================
# Hyperbolic (sinh/cosh computed from exp since B32 lacks native versions)
# ============================================================================

### Returns the complex hyperbolic sine of this value.
### :returns: The complex hyperbolic sine.
routine C64.sinh_unchecked() -> C64
  # sinh(a)=(eᵃ−e⁻ᵃ)/2, cosh(a)=(eᵃ+e⁻ᵃ)/2 from raw exp on the real part.
  var ep = me.real.exp_unchecked()
  var em = (-me.real).exp_unchecked()
  var sh = (ep - em) / 2.0_b32
  var ch = (ep + em) / 2.0_b32
  # sinh(a+bi) = sinh a·cos b + i·cosh a·sin b.
  return C64(real: sh * me.imag.cos(), imag: ch * me.imag.sin())

### Returns the complex hyperbolic cosine of this value.
### :returns: The complex hyperbolic cosine.
routine C64.cosh_unchecked() -> C64
  # sinh(a)=(eᵃ−e⁻ᵃ)/2, cosh(a)=(eᵃ+e⁻ᵃ)/2 from raw exp on the real part.
  var ep = me.real.exp_unchecked()
  var em = (-me.real).exp_unchecked()
  var sh = (ep - em) / 2.0_b32
  var ch = (ep + em) / 2.0_b32
  # cosh(a+bi) = cosh a·cos b + i·sinh a·sin b.
  return C64(real: ch * me.imag.cos(), imag: sh * me.imag.sin())

### Returns the complex hyperbolic tangent of this value.
### :returns: The complex hyperbolic tangent.
routine C64.tanh() -> C64
  # Double-angle form: a2 = 2a, b2 = 2b.
  var a2 = me.real + me.real
  var b2 = me.imag + me.imag
  var ep = a2.exp_unchecked()
  var em = (-a2).exp_unchecked()
  # d = cosh(2a) + cos(2b) is the shared denominator.
  var d = (ep + em) / 2.0_b32 + b2.cos()
  # tanh(a+bi) = sinh(2a)/d + i·sin(2b)/d.
  return C64(real: (ep - em) / 2.0_b32 / d, imag: b2.sin() / d)

### Returns the complex inverse hyperbolic sine of this value.
### :returns: The principal value of `arcsinh(me)`.
routine C64.asinh() -> C64
  # asinh(z) = log(z + √(z² + 1)).
  return (me + (me * me + C64.one()).sqrt_unchecked()).log_unchecked()

### Returns the complex inverse hyperbolic cosine of this value.
### :returns: The principal value of `arccosh(me)`.
routine C64.acosh() -> C64
  # acosh(z) = log(z + √(z² − 1)).
  return (me + (me * me - C64.one()).sqrt_unchecked()).log_unchecked()

### Returns the complex inverse hyperbolic tangent of this value.
### :returns: The principal value of `arctanh(me)`.
routine C64.atanh() -> C64
  # atanh(z) = ½·log((1 + z)/(1 − z)).
  var v = ((C64.one() + me) / (C64.one() - me)).log_unchecked()
  return C64(real: v.real / 2.0_b32, imag: v.imag / 2.0_b32)

# ============================================================================
# Exponential, Logarithmic, and Square Root
# ============================================================================

### Returns `e` raised to this complex value using `exp(a+bi) = eᵃ(cos(b) + i·sin(b))`.
### :returns: The complex exponential.
routine C64.exp_unchecked() -> C64
  # exp(a+bi) = eᵃ·(cos b + i·sin b); ea = eᵃ scales the unit phasor.
  var ea = me.real.exp_unchecked()
  return C64(real: ea * me.imag.cos(), imag: ea * me.imag.sin())

### Returns the principal natural logarithm of this complex value.
### :returns: `log(|me|) + i·arg(me)`.
routine C64.log_unchecked() -> C64
  # log(z) = ln|z| + i·arg(z); principal branch from atan2.
  return C64(real: me.abs().log_unchecked(), imag: me.arg())

### Returns the base-10 logarithm of this complex value.
### :returns: `log(me) / ln(10)`.
routine C64.log10() -> C64
  # log10(z) = ln(z)/ln(10); divide both components by the constant ln 10.
  var v = me.log_unchecked()
  return C64(real: v.real / B32_LN_10, imag: v.imag / B32_LN_10)

### Returns the base-2 logarithm of this complex value.
### :returns: `log(me) / ln(2)`.
routine C64.log2() -> C64
  var v = me.log_unchecked()
  return C64(real: v.real / B32_LN_2, imag: v.imag / B32_LN_2)

### Returns the multiplicative inverse `1/me` (conjugate over the squared modulus).
### :returns: `conj(me) / |me|²`.
routine C64.reciprocal() -> C64
  var d = me.real * me.real + me.imag * me.imag
  return C64(real: me.real / d, imag: -me.imag / d)

### Returns the polar form `(magnitude, angle-in-radians)` — the inverse of `from_polar`.
### :returns: A tuple `(abs, arg)`.
routine C64.to_polar() -> (B32, B32)
  return (me.abs(), me.arg())

### Returns the complex square root, choosing the root with non-negative real part.
### :returns: The principal square root of this value.
routine C64.sqrt_unchecked() -> C64
  # Half-magnitude formula: with r = |z|, re' = √((r+re)/2), im' = √((r−re)/2).
  var r = me.abs()
  if r == 0.0_b32
    return C64.zero()
  var rp = ((r + me.real) / 2.0_b32).sqrt_unchecked()
  var ip = ((r - me.real) / 2.0_b32).sqrt_unchecked()
  # Imag part takes the sign of the input's imag (principal root, re' ≥ 0).
  if me.imag < 0.0_b32
    ip = -ip
  return C64(real: rp, imag: ip)

### Returns this complex value raised to the complex power `you`.
### :param you: The complex exponent.
### :returns: `me ** you`, computed as `exp(you · log(me))`.
routine C64.pow(you: C64) -> C64
  # z^w = exp(w·log z); principal branch via log_unchecked.
  return (you * me.log_unchecked()).exp_unchecked()

# ============================================================================
# Query Routines
# ============================================================================

### Returns `true` if both the real and imaginary parts are exactly zero.
### :returns: `true` if `me == C64.zero()`.
routine C64.is_zero() -> Bool
  return me.real == 0.0_b32 and me.imag == 0.0_b32

### Returns `true` if the imaginary part is exactly zero (the value lies on the real axis).
### :returns: `true` if `me.imag == 0.0`.
routine C64.is_real() -> Bool
  return me.imag == 0.0_b32

### Returns `true` if the real part is exactly zero (the value lies on the imaginary axis).
### :returns: `true` if `me.real == 0.0`.
routine C64.is_imaginary() -> Bool
  return me.real == 0.0_b32

# ============================================================================
# Text Representation
# ============================================================================

### Formats this value compactly as `a+bi` / `a-bi` (e.g. `1.5+2i`). The `i`
### spelling matches the imaginary literal suffixes, so output is valid
### literal syntax. Standard `represent` shape (no args) for f-string dispatch.
### :returns: The resulting `Text` value.
@override
routine C64.represent() -> Text
  var real_text = me.real.represent()
  var imag_abs = me.imag.abs().represent()
  if me.imag < 0.0_b32
    return real_text + "-" + imag_abs + "i"
  return real_text + "+" + imag_abs + "i"

### Returns the real component (mirrors `Complex.real_part`; the `real` field is also public).
### :returns: The real part as `B32`.
routine C64.real_part() -> B32
  return me.real

### Returns the imaginary component (mirrors `Complex.imag_part`; the `imag` field is also public).
### :returns: The imaginary part as `B32`.
routine C64.imag_part() -> B32
  return me.imag

### Returns a diagnostic string wrapping the value with its type name (e.g. `C64(1.5+2i)`).
### Standard `diagnose` shape (no args) for f-string dispatch.
### :returns: The resulting `Text` value.
@override
routine C64.diagnose() -> Text
  return "C64(" + me.represent() + ")"

# ============================================================================
# Hashing
# ============================================================================

### Returns a SipHash-2-4 keyed hash of this complex value.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash suitable for denial-of-service-resistant hash tables.
routine C64.hash(k0: U64, k1: U64) -> U64
  var acc = __hash_round(acc: 0u64, h: me.real.hash(k0: k0, k1: k1))
  acc = __hash_round(acc: acc, h: me.imag.hash(k0: k0, k1: k1))
  return __hash_finalize(h: acc)
