module Core

# ============================================================================
# D32Trans — decimal32 (Pmax=7) transcendentals + libm surface via the DoubleDouble (DD) engine
# (~31 decimal digits >> 7). A D32 value is decoded into DD, run through DD's pure-RF method surface,
# and rounded back to 7 digits — deterministic (no platform libm) with ~24 guard digits, matching the
# decimal ladder D64->F128 / D128->F192 / Decimal->F320. (DD's own seeds may call an F64 libm routine,
# but its DD-precision refinement converges to a platform-independent result.)
#
# The dec<->bin conversions are HAND-ROLLED on our tabled-BID parts (binary-coefficient encoding);
# F64<->D32 (below) rounds through DD too, since raw F64's ~9 guard digits are not enough for 7.
# ============================================================================

# ============================================================================
# Hand-rolled radix conversions (our BID parts <-> F64). value = coeff * 10^exp.
# ============================================================================

# ----------------------------------------------------------------------------
# 10^e as an F64 (hardware double) — two-level sqrt-decomposition table lookup.
#
# Engine width W = 53 (F64 significand). Decimal32 quantum exponent range is
# [-101, +101] (MAXE = 101). With S = ceil(sqrt(101)) = 11, any |e| <= 101
# splits as e = sign * (S*hi + lo), 0 <= lo < S, 0 <= hi <= ceil(101/S) = 10.
# Then 10^e = HIGH[hi] * LOW[lo] — ONE double multiply, zero division, zero
# binary-exponentiation loop.
#
# Each table stores the nearest F64 (round-half-even) to the true 10^k, as its
# raw 64-bit IEEE pattern (loaded via F64.from_bits). The NEGATIVE powers are
# stored directly (nearest double of 10^-k) — NOT computed by dividing 1/HIGH.
# Entries with |k| <= 22 are exact in F64; the rest are the correctly-rounded
# nearest double. Reconstruction error over e in [-101,101] is <= 1 ULP
# (worst 2.14e-16 at e=-34), so the single multiply is essentially correctly
# rounded — matching the old binary-exp path but branch-free and loop-free.
#
# Tables generated by a throwaway Python 3 script (decimal.Decimal, prec=200,
# float() = correctly-rounded nearest double). See the task log for the script
# and spot-checks (10^0 -> 0x3FF0000000000000; 10^1 -> 0x4024000000000000;
# 10^-1 -> 0x3FB999999999999A).
# ----------------------------------------------------------------------------
preset D32_POW10_HIGH_POS: Array[U64, 11] = [0x3FF0000000000000_u64, 0x42374876E8000000_u64, 0x4480F0CF064DD592_u64, 0x46C8A6E32246C99C_u64, 0x4911EFC659CF7D4C_u64, 0x4B5A19E96A19FC41_u64, 0x4DA2FDBB0E39FB47_u64, 0x4FEBA2BFD0D5FF5B_u64, 0x52341B8EBE2EF1C7_u64, 0x547D42AEA2879F2E_u64, 0x56C54A3047C694FE_u64]
preset D32_POW10_LOW_POS: Array[U64, 11] = [0x3FF0000000000000_u64, 0x4024000000000000_u64, 0x4059000000000000_u64, 0x408F400000000000_u64, 0x40C3880000000000_u64, 0x40F86A0000000000_u64, 0x412E848000000000_u64, 0x416312D000000000_u64, 0x4197D78400000000_u64, 0x41CDCD6500000000_u64, 0x4202A05F20000000_u64]
preset D32_POW10_HIGH_NEG: Array[U64, 11] = [0x3FF0000000000000_u64, 0x3DA5FD7FE1796495_u64, 0x3B5E392010175EE6_u64, 0x3914C4E977BA1F5C_u64, 0x36CC8B8218854567_u64, 0x34839DAE6F76D883_u64, 0x323AF5BF109550F2_u64, 0x2FF286D80EC190DC_u64, 0x2DA97683DF2F268D_u64, 0x2B617F7D4ED8C33E_u64, 0x29180C903F7379F2_u64]
preset D32_POW10_LOW_NEG: Array[U64, 11] = [0x3FF0000000000000_u64, 0x3FB999999999999A_u64, 0x3F847AE147AE147B_u64, 0x3F50624DD2F1A9FC_u64, 0x3F1A36E2EB1C432D_u64, 0x3EE4F8B588E368F1_u64, 0x3EB0C6F7A0B5ED8D_u64, 0x3E7AD7F29ABCAF48_u64, 0x3E45798EE2308C3A_u64, 0x3E112E0BE826D695_u64, 0x3DDB7CDFD9D7BDBB_u64]

### 10^e as an F64 via the two-level sqrt-split power-of-ten table (one multiply, no division).
routine f64_pow10(e: S64) -> F64
  var neg = LLVM::signed_lt(a: e, b: 0_s64)
  var a = if neg then LLVM::sub(a: 0_s64, b: e) else e
  var hi = LLVM::signed_div(a: a, b: 11_s64)
  var lo = LLVM::signed_rem(a: a, b: 11_s64)
  if neg
    var hn = F64.from_bits(bits: D32_POW10_HIGH_NEG[hi])
    var ln = F64.from_bits(bits: D32_POW10_LOW_NEG[lo])
    return LLVM::float_mul[F64](a: hn, b: ln)
  var hp = F64.from_bits(bits: D32_POW10_HIGH_POS[hi])
  var lp = F64.from_bits(bits: D32_POW10_LOW_POS[lo])
  return LLVM::float_mul[F64](a: hp, b: lp)

### True if the F64 sign bit is set (handles -0).
routine f64_signbit(v: F64) -> Bool
  return LLVM::int_ne(a: LLVM::bit_and(a: v.to_bits(), b: 0x8000000000000000_u64), b: 0_u64)

### dec -> bin: D32 value as an F64. The idiomatic conversion `someD32.F64()`.
routine F64(from: D32) -> F64
  var p = from.decode()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    var ib = if p.sign then 0xFFF0000000000000_u64 else 0x7FF0000000000000_u64
    return F64.from_bits(bits: ib)
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return F64.from_bits(bits: 0x7FF8000000000000_u64)
  # value = coeff (exact, <=7 digits) * 10^exp; widen coeff to F64 then scale, apply sign
  var cf = p.coeff.F64()
  var v = LLVM::float_mul[F64](a: cf, b: f64_pow10(e: p.exp))
  if p.sign
    return LLVM::float_neg[F64](v)
  return v

### bin -> dec: F64 value as a D32 (`someF64.D32()`) via the DoubleDouble engine — mirrors
### `dd_to_d64` but rounds to D32's 7 digits. A single raw-F64 scale is NOT correctly rounded here:
### f64_pow10 is only ~1 ULP-accurate for |e|>22, and with just ~9 guard digits over D32's 7 that
### error crosses the 7th-digit rounding boundary for a large fraction of the domain (a full-domain
### D32->F64->D32 audit failed on 40% of finite values, concentrated where the decimal exponent is
### extreme so there is no headroom to absorb the pow10 error). DD carries ~31 digits, so scaling |x|
### into a ~16-digit integer with dd_pow10 (the same table dd_to_d64 uses) and letting decfin32 do the
### final round-half-even 16->7 is correctly rounded across the whole D32 range. This replaces the old
### detour through the full 34-digit D128 machinery (F64->F128->192-bit engine->decimal128->truncate),
### which was correctly rounded but cost ~26x its inverse; DD is correctly rounded at a fraction of that.
routine D32(from: F64) -> D32
  if from.is_nan()
    return D32.quiet_nan()
  if from.is_infinite()
    return D32.infinity(sign: f64_signbit(v: from))
  if LLVM::float_eq[F64](a: from, b: 0.0_f64)
    return d32_of_parts(p: D32Parts(sign: f64_signbit(v: from), special: 0_u64, exp: 0_s64, coeff: 0_u64))
  var sign = f64_signbit(v: from)
  var ax = dd_of(x: from).abs()
  # est. decimal exponent from the BINARY exponent: floor(ilogb * log10(2)), log10(2) ~ 315653/2^20
  # (integer mul + shift, no libm log10). The +-1 error is absorbed by decfin32's renormalization.
  var decexp = LLVM::signed_div(a: LLVM::mul(a: C::rf_f64_ilogb(value: from), b: 315653_s64), b: 1048576_s64)
  # scale so the coefficient lands as a ~16-digit integer (15 - decexp) in DD precision, round to U64,
  # then decfin32 rounds 16 -> 7 digits round-half-even (pref = 90 strips trailing zeros).
  var q = LLVM::sub(a: 15_s64, b: decexp)
  var coeff = dd_to_u64_round(u: ax.mul(you: dd_pow10(e: q)))
  return d32_of_parts(p: decfin32(sign: sign, coeff: coeff, exp: LLVM::sub(a: 0_s64, b: q), pref: 90_s64))

### dec -> DD: D32 value as a DD (coeff exact <=7 digits, scaled by 10^exp). The DD engine (~31
### digits) is D32's transcendental scratch — pure-RF (no platform libm), deterministic, with ~24
### guard digits over decimal32's 7, matching the D64->F128 / D128->F192 / Decimal->F320 ladder.
routine d32_to_dd(x: D32) -> DD
  var p = x.decode()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    var inf = dd_of(x: 1.0_f64).div(you: dd_of(x: 0.0_f64))
    return if p.sign then inf.neg() else inf
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return dd_of(x: 0.0_f64).div(you: dd_of(x: 0.0_f64))
  if LLVM::int_eq(a: p.coeff, b: 0_u64)
    return if p.sign then dd_of(x: 0.0_f64).neg() else dd_of(x: 0.0_f64)
  var mag = dd_of(x: p.coeff.F64()).mul(you: dd_pow10(e: p.exp))
  return if p.sign then mag.neg() else mag

### bin -> dec: DD value as a D32, rounded to <=7 digits (decfin32 does the final round-half-even
### 16 -> 7). Decimal exponent estimated from the hi limb's BINARY exponent (integer mul+shift, no
### libm log10); the +-1 error is absorbed by decfin32.
routine dd_to_d32(x: DD) -> D32
  var f = x.to_f64()
  if f.is_nan()
    return D32.quiet_nan()
  if f.is_infinite()
    return D32.infinity(sign: LLVM::float_lt[F64](a: x.hi, b: 0.0_f64))
  if LLVM::float_eq[F64](a: x.hi, b: 0.0_f64)
    return d32_of_parts(p: D32Parts(sign: LLVM::float_lt[F64](a: LLVM::copysign[F64](value: 1.0_f64, sign: x.hi), b: 0.0_f64), special: 0_u64, exp: 0_s64, coeff: 0_u64))
  var sign = LLVM::float_lt[F64](a: x.hi, b: 0.0_f64)
  var ax = x.abs()
  var decexp = LLVM::signed_div(a: LLVM::mul(a: C::rf_f64_ilogb(value: ax.hi), b: 315653_s64), b: 1048576_s64)
  var q = LLVM::sub(a: 15_s64, b: decexp)
  var coeff = dd_to_u64_round(u: ax.mul(you: dd_pow10(e: q)))
  return d32_of_parts(p: decfin32(sign: sign, coeff: coeff, exp: LLVM::sub(a: 0_s64, b: q), pref: 90_s64))

# ============================================================================
# Transcendentals — all delegate to the DD (double-double) engine surface: decode D32 -> DD,
# evaluate, round DD -> D32. Pure-RF and deterministic (no platform libm), ~31-digit scratch for
# decimal32's 7 — mirrors D64->F128 / D128->F192 / Decimal->F320.
# ============================================================================

### e^me via hardware libm (F64). Crashes on a non-finite result.
### :returns: The exponential of `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D32.exp!() -> D32
  var r = me.exp_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### e^me via libm double, raw IEEE: may return ±inf or NaN. Never crashes.
### :returns: The exponential of `me`, possibly non-finite.
routine D32.exp_unchecked() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).exp())

### e^me - 1 (accurate near 0) via libm. Crashes on a non-finite result.
### :returns: `exp(me) - 1`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D32.expm1!() -> D32
  var r = me.expm1_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `exp(me) - 1` via libm double, raw IEEE: may return ±inf or NaN. Never crashes.
### :returns: `exp(me) - 1`, possibly non-finite.
routine D32.expm1_unchecked() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).expm1())

### 2^me via libm. Crashes on a non-finite result.
### :returns: Two raised to the power `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D32.exp2!() -> D32
  var r = me.exp2_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### 2^me via libm double, raw IEEE: may return ±inf or NaN. Never crashes.
### :returns: Two raised to the power `me`, possibly non-finite.
routine D32.exp2_unchecked() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).exp2())

### 10^me via libm. Crashes on a non-finite result.
### :returns: Ten raised to the power `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D32.exp10!() -> D32
  var r = me.exp10_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### 10^me via libm pow(10, me), raw IEEE: may return ±inf or NaN. Never crashes.
### :returns: Ten raised to the power `me`, possibly non-finite.
routine D32.exp10_unchecked() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).exp10())

### Natural log ln(me) via libm. Crashes on a non-finite result (me<=0).
### :returns: The natural logarithm of `me`.
### :throws: {NumericDomainError} on NaN (me<0); {NumericOverflowError} on ±inf (me=0).
routine D32.log!() -> D32
  var r = me.log_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### ln(me) via libm double, raw IEEE: NaN for me<0, -inf for me=0. Never crashes.
### :returns: The natural logarithm of `me`, possibly non-finite.
routine D32.log_unchecked() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).log())

### ln(1+me) (accurate near 0) via libm. Crashes on a non-finite result (me<=-1).
### :returns: `ln(1 + me)`.
### :throws: {NumericDomainError} on NaN (me<-1); {NumericOverflowError} on ±inf (me=-1).
routine D32.log1p!() -> D32
  var r = me.log1p_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `ln(1 + me)` via libm double, raw IEEE: NaN for me<-1, -inf for me=-1. Never crashes.
### :returns: `ln(1 + me)`, possibly non-finite.
routine D32.log1p_unchecked() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).log1p())

### Base-2 log log2(me) via libm. Crashes on a non-finite result (me<=0).
### :returns: The base-2 logarithm of `me`.
### :throws: {NumericDomainError} on NaN (me<0); {NumericOverflowError} on ±inf (me=0).
routine D32.log2!() -> D32
  var r = me.log2_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### log2(me) via libm double, raw IEEE: NaN for me<0, -inf for me=0. Never crashes.
### :returns: The base-2 logarithm of `me`, possibly non-finite.
routine D32.log2_unchecked() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).log2())

### Base-10 log log10(me) via libm. Crashes on a non-finite result (me<=0).
### :returns: The base-10 logarithm of `me`.
### :throws: {NumericDomainError} on NaN (me<0); {NumericOverflowError} on ±inf (me=0).
routine D32.log10!() -> D32
  var r = me.log10_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### log10(me) via libm double, raw IEEE: NaN for me<0, -inf for me=0. Never crashes.
### :returns: The base-10 logarithm of `me`, possibly non-finite.
routine D32.log10_unchecked() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).log10())

### Square root sqrt(me) via libm. Crashes on a non-finite result (me<0).
### :returns: The square root of `me`.
### :throws: {NumericDomainError} on NaN (me<0); {NumericOverflowError} on ±inf.
routine D32.sqrt!() -> D32
  var r = me.sqrt_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### sqrt(me) via libm double, raw IEEE: NaN for me<0. Never crashes.
### :returns: The square root of `me`, possibly NaN.
routine D32.sqrt_unchecked() -> D32
  # DD.sqrt clamps every non-positive input to 0; preserve IEEE by mapping a strictly negative
  # operand to NaN (me<0) while a signed zero still yields +0 through DD.sqrt.
  if me.is_negative() and not me.is_zero()
    return D32.quiet_nan()
  return dd_to_d32(x: d32_to_dd(x: me).sqrt())

### Cube root cbrt(me) via libm (defined for all reals). Never crashes.
### :returns: The cube root of `me`.
routine D32.cbrt() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).cbrt())

### me^you (general power) via libm, raw IEEE: may return ±inf or NaN. Never crashes.
### :param you: The exponent.
### :returns: `me` raised to the power `you`, possibly non-finite.
routine D32.pow_unchecked(you: D32) -> D32
  # DD.pow computes exp(you * ln|me|) — the POSITIVE-base power. A negative base is only real for an
  # integer exponent: restore |me|^you and set the sign from the exponent's parity (odd -> negative);
  # a non-integer exponent is a domain NaN.
  var r = dd_to_d32(x: d32_to_dd(x: me.abs()).pow(you: d32_to_dd(x: you)))
  if not (me.is_negative() and not me.is_zero())
    return r
  var yint = you.trunc()
  if you.cmp(you: yint) isnot SAME
    return D32.quiet_nan()
  var parity = yint - D32(from: 2_s64) * (yint / D32(from: 2_s64)).trunc()
  if parity.is_zero()
    return r
  return r.neg()

### sqrt(x^2 + y^2) (without spurious overflow) via libm. Crashes if non-finite.
### :param x: The first leg.
### :param y: The second leg.
### :returns: The Euclidean length `hypot(x, y)`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine hypot!(x: D32, y: D32) -> D32
  var r = hypot_unchecked(x: x, y: y)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `hypot(x, y)` via libm double, raw IEEE: may return +inf. Never crashes.
### :param x: The first leg.
### :param y: The second leg.
### :returns: The Euclidean length, possibly +inf.
routine hypot_unchecked(x: D32, y: D32) -> D32
  return dd_to_d32(x: d32_to_dd(x: x).hypot(you: d32_to_dd(x: y)))

### Fused multiply-add me*b + c, single rounding, via libm. Crashes if non-finite.
### :param b: The multiplier.
### :param c: The addend.
### :returns: `me * b + c` rounded once.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D32.fma!(b: D32, c: D32) -> D32
  var r = me.fma_unchecked(b: b, c: c)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me * b + c` (single rounding) via libm, raw IEEE: may return ±inf or NaN. Never crashes.
### :param b: The multiplier.
### :param c: The addend.
### :returns: `me * b + c`, possibly non-finite.
routine D32.fma_unchecked(b: D32, c: D32) -> D32
  return dd_to_d32(x: d32_to_dd(x: me).fma(b: d32_to_dd(x: b), c: d32_to_dd(x: c)))

### Sine sin(me) (radians) via libm. Never crashes (NaN for non-finite input).
### :returns: The sine of `me`.
routine D32.sin() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).sin())

### Cosine cos(me) (radians) via libm. Never crashes (NaN for non-finite input).
### :returns: The cosine of `me`.
routine D32.cos() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).cos())

### Tangent tan(me) (radians) via libm. Never crashes (NaN for non-finite input).
### :returns: The tangent of `me`.
routine D32.tan() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).tan())

### Arcsine asin(me) via libm. Crashes if non-finite (|me|>1).
### :returns: The arcsine of `me` in radians.
### :throws: {NumericDomainError} on NaN (|me|>1); {NumericOverflowError} on ±inf.
routine D32.asin!() -> D32
  var r = me.asin_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### asin(me) via libm double, raw IEEE: NaN for |me|>1. Never crashes.
### :returns: The arcsine of `me`, possibly NaN.
routine D32.asin_unchecked() -> D32
  # DD.asin = atan(me/sqrt(1-me^2)); for |me|>1 that sqrt clamps to 0 (wrong ±pi/2 instead of NaN),
  # so guard the domain here to preserve IEEE (asin NaN for |me|>1).
  if me.abs().cmp(you: D32(from: 1_s64)) is ME_LARGE
    return D32.quiet_nan()
  return dd_to_d32(x: d32_to_dd(x: me).asin())

### Arccosine acos(me) via libm. Crashes if non-finite (|me|>1).
### :returns: The arccosine of `me` in radians.
### :throws: {NumericDomainError} on NaN (|me|>1); {NumericOverflowError} on ±inf.
routine D32.acos!() -> D32
  var r = me.acos_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### acos(me) via libm double, raw IEEE: NaN for |me|>1. Never crashes.
### :returns: The arccosine of `me`, possibly NaN.
routine D32.acos_unchecked() -> D32
  # acos = pi/2 - asin; same |me|>1 domain guard (DD.sqrt clamp would otherwise mask the NaN).
  if me.abs().cmp(you: D32(from: 1_s64)) is ME_LARGE
    return D32.quiet_nan()
  return dd_to_d32(x: d32_to_dd(x: me).acos())

### Arctangent atan(me) via libm (defined for all reals). Never crashes.
### :returns: The arctangent of `me` in radians.
routine D32.atan() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).atan())

### Two-argument arctangent atan2(y, x), quadrant-aware, via libm. Never crashes.
### :param y: The y-coordinate.
### :param x: The x-coordinate.
### :returns: The angle of (x, y) in radians, in (-pi, pi].
routine atan2(y: D32, x: D32) -> D32
  return dd_to_d32(x: d32_to_dd(x: y).atan2(x: d32_to_dd(x: x)))

### Hyperbolic sine sinh(me) via libm. Crashes if non-finite (overflow for large |me|).
### :returns: The hyperbolic sine of `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D32.sinh!() -> D32
  var r = me.sinh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### sinh(me) via libm double, raw IEEE: ±inf on overflow. Never crashes.
### :returns: The hyperbolic sine of `me`, possibly ±inf.
routine D32.sinh_unchecked() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).sinh())

### Hyperbolic cosine cosh(me) via libm. Crashes if non-finite (overflow for large |me|).
### :returns: The hyperbolic cosine of `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D32.cosh!() -> D32
  var r = me.cosh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### cosh(me) via libm double, raw IEEE: +inf on overflow. Never crashes.
### :returns: The hyperbolic cosine of `me`, possibly +inf.
routine D32.cosh_unchecked() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).cosh())

### Hyperbolic tangent tanh(me) via libm (defined for all reals). Never crashes.
### :returns: The hyperbolic tangent of `me`.
routine D32.tanh() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).tanh())

### Inverse hyperbolic sine asinh(me) via libm (defined for all reals). Never crashes.
### :returns: The inverse hyperbolic sine of `me`.
routine D32.asinh() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).asinh())

### Inverse hyperbolic cosine acosh(me) via libm. Crashes if non-finite (me<1).
### :returns: The inverse hyperbolic cosine of `me`.
### :throws: {NumericDomainError} on NaN (me<1); {NumericOverflowError} on ±inf.
routine D32.acosh!() -> D32
  var r = me.acosh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### acosh(me) via libm double, raw IEEE: NaN for me<1. Never crashes.
### :returns: The inverse hyperbolic cosine of `me`, possibly NaN.
routine D32.acosh_unchecked() -> D32
  # DD.acosh = log(me + sqrt(me^2-1)); for me<1 that sqrt clamps to 0 (finite garbage instead of
  # NaN), so guard the domain here to preserve IEEE (acosh NaN for me<1).
  if me.cmp(you: D32(from: 1_s64)) is ME_SMALL
    return D32.quiet_nan()
  return dd_to_d32(x: d32_to_dd(x: me).acosh())

### Inverse hyperbolic tangent atanh(me) via libm. Crashes if non-finite (|me|>=1).
### :returns: The inverse hyperbolic tangent of `me`.
### :throws: {NumericDomainError} on NaN (|me|>1); {NumericOverflowError} on ±inf (|me|=1).
routine D32.atanh!() -> D32
  var r = me.atanh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### atanh(me) via libm double, raw IEEE: NaN for |me|>1, ±inf for |me|=1. Never crashes.
### :returns: The inverse hyperbolic tangent of `me`, possibly non-finite.
routine D32.atanh_unchecked() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).atanh())

### Error function erf(me) via libm. Never crashes (saturates to ±1).
### :returns: The error function of `me`.
routine D32.erf() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).erf())

### Complementary error function erfc(me) = 1 - erf(me) via libm. Never crashes.
### :returns: The complementary error function of `me`.
routine D32.erfc() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).erfc())

### Gamma function tgamma(me) via libm. Crashes if non-finite (poles at 0 and neg ints).
### :returns: The gamma function of `me`.
### :throws: {NumericDomainError} on NaN (neg int poles); {NumericOverflowError} on ±inf.
routine D32.tgamma!() -> D32
  var r = me.tgamma_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### tgamma(me) via libm, raw IEEE: ±inf at poles, NaN for neg-int poles, overflow. Never crashes.
### :returns: The gamma function of `me`, possibly non-finite.
routine D32.tgamma_unchecked() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).tgamma())

### Log-gamma lgamma(me) = ln(|gamma(me)|) via libm. Never crashes (+inf at poles).
### :returns: The natural log of the absolute gamma of `me`.
routine D32.lgamma() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).lgamma())

# ============================================================================
# libm manipulation / classification — decimal-native on D32Parts (coeff U64).
# ============================================================================

### IEEE 754 signBit: true when the sign bit is set (includes -0 and -NaN). Never crashes.
### :returns: Whether `me`'s sign bit is set.
routine D32.signbit() -> Bool
  return me.decode().sign

### True if me is negative (sign bit set; includes -0 and -NaN).
routine D32.is_negative() -> Bool
  return me.decode().sign

### True if me is strictly positive (not signed, not zero).
routine D32.is_positive() -> Bool
  var p = me.decode()
  return not p.sign and LLVM::int_eq(a: p.special, b: 0_u64) and LLVM::int_ne(a: p.coeff, b: 0_u64)

### True if me is a finite, nonzero subnormal: quantum exponent at the minimum (-101)
### with a coefficient below 10^6 (fewer than the full 7 significant digits).
routine D32.is_subnormal() -> Bool
  var p = me.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64) or LLVM::int_eq(a: p.coeff, b: 0_u64)
    return false
  return LLVM::int_eq(a: p.exp, b: -101_s64) and LLVM::unsigned_lt(a: p.coeff, b: 1000000_u64)

### Splits into integer and fractional parts (C modf); both carry me's sign.
routine D32.modf() -> (D32, D32)
  if me.is_nan()
    return (me, me)
  var p = me.decode()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return (me, d32_of_parts(p: D32Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: 0_u64)))
  var ip = me.trunc()
  return (ip, me - ip)

### True if me is finite and nonzero (a normal or subnormal number, not zero/inf/NaN).
### :returns: Whether `me` is a finite nonzero value.
routine D32.is_normal() -> Bool
  var p = me.decode()
  return LLVM::int_eq(a: p.special, b: 0_u64) and LLVM::int_ne(a: p.coeff, b: 0_u64)

### True if me is ±0 (finite with a zero coefficient).
### :returns: Whether `me` is zero.
routine D32.is_zero() -> Bool
  var p = me.decode()
  return LLVM::int_eq(a: p.special, b: 0_u64) and LLVM::int_eq(a: p.coeff, b: 0_u64)

### IEEE 754 fpClassify: bucket me into signaling/quiet NaN, infinite, zero, subnormal, normal.
### :returns: The floating-point class of `me`.
routine D32.fpclassify() -> FpClass
  var p = me.decode()
  if LLVM::int_eq(a: p.special, b: 3_u64)
    return SIGNALING_NAN
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return NAN
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return INFINITE
  if LLVM::int_eq(a: p.coeff, b: 0_u64)
    return ZERO
  if me.is_subnormal()
    return SUBNORMAL
  return NORMAL

### Absolute value |me| (clears the sign bit, cohort preserved). Never crashes.
### :returns: The magnitude of `me`.
routine D32.abs() -> D32
  var p = me.decode()
  return d32_of_parts(p: D32Parts(sign: false, special: p.special, exp: p.exp, coeff: p.coeff))

### IEEE 754 totalOrder for decimals (see `D128.total_order`). Orders signed zeros, cohorts,
### and NaNs into one total ranking; never crashes.
### :param you: The value to compare against.
### :returns: Whether `me` precedes or equals `you` in the total order.
routine D32.total_order(you: D32) -> Bool
  var pa = me.decode()
  var pb = you.decode()
  if LLVM::unsigned_ge(a: pa.special, b: 2_u64) or LLVM::unsigned_ge(a: pb.special, b: 2_u64)
    return decimal_order_band(sign: pa.sign, special: pa.special) <= decimal_order_band(sign: pb.sign, special: pb.special)
  var c = me.cmp(you: you)
  if c isnot SAME
    return c is ME_SMALL
  if pa.sign != pb.sign
    return pa.sign
  if pa.sign
    return LLVM::signed_ge(a: pa.exp, b: pb.exp)
  return LLVM::signed_le(a: pa.exp, b: pb.exp)

### IEEE 754 totalOrderMag for decimals: `total_order` on the magnitudes.
### :param you: The value whose magnitude to compare against.
### :returns: Whether `|me|` precedes or equals `|you|` in the total order.
routine D32.total_order_mag(you: D32) -> Bool
  return me.abs().total_order(you: you.abs())

### Unary negation -me (flips the sign bit, cohort preserved). Never crashes.
### :returns: `me` with its sign flipped.
routine D32.neg() -> D32
  var p = me.decode()
  return d32_of_parts(p: D32Parts(sign: not p.sign, special: p.special, exp: p.exp, coeff: p.coeff))

### IEEE 754 copySign: me's magnitude with you's sign bit. Never crashes.
### :param you: The value supplying the sign.
### :returns: `|me|` carrying `you`'s sign.
routine D32.copysign(you: D32) -> D32
  var p = me.decode()
  return d32_of_parts(p: D32Parts(sign: you.decode().sign, special: p.special, exp: p.exp, coeff: p.coeff))

### Returns -1, 0, or +1 indicating the sign of `me`; NaN propagates; ±0 -> +0.
routine D32.signum() -> D32
  if me.is_nan()
    return D32.quiet_nan()
  if me.is_zero()
    return d32_of_parts(p: D32Parts(sign: false, special: 0_u64, exp: 0_s64, coeff: 0_u64))
  return if me.decode().sign then D32(from: -1_s64) else D32(from: 1_s64)

### Throws when `me` is non-finite (inf or NaN).
@crash_only
routine D32.finite!() -> D32
  if not me.is_finite()
    if me.is_nan()
      throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")
  return me

### C99 fmod: me - trunc(me/you)*you (truncated-division remainder).
routine D32.fmod(you: D32) -> D32
  if me.is_nan() or you.is_nan()
    return D32.quiet_nan()
  if me.is_infinite() or you.is_zero()
    return D32.quiet_nan()
  if you.is_infinite()
    return me
  var n = me.truediv_unchecked(you: you).trunc()
  return me.sub_unchecked(you: you.mul_unchecked(you: n))

### C99 fmax: the larger of me and you, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The larger operand, or the non-NaN one.
routine D32.fmax(you: D32) -> D32
  if me.is_nan()
    return you
  if you.is_nan()
    return me
  if (me - you).decode().sign
    return you
  return me

### C99 fmin: the smaller of me and you, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The smaller operand, or the non-NaN one.
routine D32.fmin(you: D32) -> D32
  if me.is_nan()
    return you
  if you.is_nan()
    return me
  if (me - you).decode().sign
    return me
  return you

### C99 fdim: the positive difference max(me - you, 0). NaN propagates. Never crashes.
### :param you: The value to subtract.
### :returns: `me - you` if positive, else +0.
routine D32.fdim(you: D32) -> D32
  if me.is_nan() or you.is_nan()
    return D32.quiet_nan()
  var d = me - you
  if d.decode().sign
    return d32_of_parts(p: D32Parts(sign: false, special: 0_u64, exp: 0_s64, coeff: 0_u64))
  return d

### IEEE 754 scaleB: `me * 10^n`. Checked: crashes if a finite `me` overflows to ±infinity.
### :param n: The power-of-ten exponent to apply.
### :returns: `me` scaled by `10^n`.
routine D32.scaleb!(n: S64) -> D32
  var r = me.scaleb_unchecked(n: n)
  if r.is_finite() or not me.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me * 10^n` with raw propagation (overflow -> ±infinity, underflow -> 0).
### :param n: The power-of-ten exponent to apply.
### :returns: `me` scaled by `10^n`.
routine D32.scaleb_unchecked(n: S64) -> D32
  var p = me.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64) or LLVM::int_eq(a: p.coeff, b: 0_u64)
    return me
  var ne = LLVM::add(a: p.exp, b: n)
  if LLVM::signed_gt(a: ne, b: 90_s64)
    return D32.infinity(sign: p.sign)
  if LLVM::signed_lt(a: ne, b: -101_s64)
    return d32_of_parts(p: D32Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: 0_u64))
  return d32_of_parts(p: D32Parts(sign: p.sign, special: 0_u64, exp: ne, coeff: p.coeff))

# ============================================================================
# IEEE 754 Tier 2 — exponent extraction, selection, rounding
# (decimal next_up/next_down deferred — cohort/ULP stepping not yet implemented)
# ============================================================================

### IEEE 754 logb: the base-10 exponent of `me` as a decimal integer (logb(0)=-inf,
### logb(±inf)=+inf, logb(NaN)=NaN). Propagating; never crashes.
### :returns: The radix-10 exponent of `me`.
routine D32.logb() -> D32
  var p = me.decode()
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return D32.quiet_nan()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return D32.infinity(sign: false)
  if LLVM::int_eq(a: p.coeff, b: 0_u64)
    return D32.infinity(sign: true)
  return D32(from: LLVM::add(a: p.exp, b: LLVM::sub(a: digits10_u64(c: p.coeff), b: 1_s64)))

### IEEE 754-2008 minNum: the smaller operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, ignoring NaN.
routine D32.min_num(you: D32) -> D32
  return me.fmin(you: you)

### IEEE 754-2008 maxNum: the larger operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, ignoring NaN.
routine D32.max_num(you: D32) -> D32
  return me.fmax(you: you)

### IEEE 754-2019 minimum: the smaller operand, propagating NaN, ordering -0 below +0.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, NaN if either is NaN.
routine D32.minimum(you: D32) -> D32
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  var c = me.cmp(you: you)
  if c is ME_SMALL
    return me
  if c is ME_LARGE
    return you
  if me.is_zero()
    return if me.signbit() then me else you
  return me

### IEEE 754-2019 maximum: the larger operand, propagating NaN, ordering +0 above -0.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, NaN if either is NaN.
routine D32.maximum(you: D32) -> D32
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  var c = me.cmp(you: you)
  if c is ME_LARGE
    return me
  if c is ME_SMALL
    return you
  if me.is_zero()
    return if me.signbit() then you else me
  return me

### IEEE 754 roundToIntegralTiesToAway: rounds to nearest integer, halves away from zero
### (alias of `round`). Never crashes.
### :returns: `me` rounded to an integral value with ties away from zero.
routine D32.round_ties_away() -> D32
  return me.round()

# ============================================================================
# IEEE 754 Tier 3 — decimal-specific (quantize, same_quantum, remainder)
# ============================================================================

### IEEE 754 sameQuantum: `true` when `me` and `you` share an exponent, or are both infinite,
### or both NaN. Never crashes.
### :param you: The value whose quantum to compare against.
### :returns: Whether the two share a quantum.
routine D32.same_quantum(you: D32) -> Bool
  var pa = me.decode()
  var pb = you.decode()
  if LLVM::unsigned_ge(a: pa.special, b: 2_u64) or LLVM::unsigned_ge(a: pb.special, b: 2_u64)
    return LLVM::unsigned_ge(a: pa.special, b: 2_u64) and LLVM::unsigned_ge(a: pb.special, b: 2_u64)
  if LLVM::int_eq(a: pa.special, b: 1_u64) or LLVM::int_eq(a: pb.special, b: 1_u64)
    return LLVM::int_eq(a: pa.special, b: 1_u64) and LLVM::int_eq(a: pb.special, b: 1_u64)
  return LLVM::int_eq(a: pa.exp, b: pb.exp)

### IEEE 754 quantize: `me`'s value re-expressed with `you`'s exponent (half-even when dropping
### digits). NaN if the result needs more than 7 significand digits, or for incompatible specials.
### :param you: The value supplying the target exponent.
### :returns: `me` quantized to `you`'s exponent, or NaN if not representable.
routine D32.quantize(you: D32) -> D32
  var pa = me.decode()
  var pb = you.decode()
  if LLVM::unsigned_ge(a: pa.special, b: 2_u64) or LLVM::unsigned_ge(a: pb.special, b: 2_u64)
    return D32.quiet_nan()
  var ainf = LLVM::int_eq(a: pa.special, b: 1_u64)
  var binf = LLVM::int_eq(a: pb.special, b: 1_u64)
  if ainf or binf
    if ainf and binf
      return me
    return D32.quiet_nan()
  var target = pb.exp
  if LLVM::int_eq(a: pa.exp, b: target)
    return me
  if LLVM::signed_gt(a: pa.exp, b: target)
    var shift = LLVM::sub(a: pa.exp, b: target)
    if LLVM::int_ne(a: pa.coeff, b: 0_u64) and LLVM::signed_gt(a: LLVM::add(a: digits10_u64(c: pa.coeff), b: shift), b: 7_s64)
      return D32.quiet_nan()
    var scaled = LLVM::mul(a: LLVM::zero_extend[U64, U256](pa.coeff), b: pow10b(k: shift))
    return d32_of_parts(p: D32Parts(sign: pa.sign, special: 0_u64, exp: target, coeff: LLVM::int_truncate[U256, U64](scaled)))
  var drop = LLVM::sub(a: target, b: pa.exp)
  if LLVM::signed_gt(a: drop, b: 7_s64)
    return d32_of_parts(p: D32Parts(sign: pa.sign, special: 0_u64, exp: target, coeff: 0_u64))
  var cw = LLVM::zero_extend[U64, U256](pa.coeff)
  var divp = pow10b(k: drop)
  var q = div_pow10b(x: cw, k: drop)
  var r = LLVM::sub(a: cw, b: LLVM::mul(a: q, b: divp))
  var twice = LLVM::mul(a: r, b: LLVM::zero_extend[U64, U256](2_u64))
  if LLVM::unsigned_gt(a: twice, b: divp)
    q = LLVM::add(a: q, b: LLVM::zero_extend[U64, U256](1_u64))
  elseif LLVM::int_eq(a: twice, b: divp) and LLVM::int_ne(a: LLVM::bit_and(a: q, b: LLVM::zero_extend[U64, U256](1_u64)), b: LLVM::zero_extend[U64, U256](0_u64))
    q = LLVM::add(a: q, b: LLVM::zero_extend[U64, U256](1_u64))
  return d32_of_parts(p: D32Parts(sign: pa.sign, special: 0_u64, exp: target, coeff: LLVM::int_truncate[U256, U64](q)))

### IEEE 754 remainder: `me - you * n` with `n` the nearest integer to `me / you` (ties even).
### NaN if `me` infinite or `you` zero; `me` if `you` infinite. Never crashes.
### :param you: The divisor.
### :returns: The IEEE remainder of `me / you`.
routine D32.remainder(you: D32) -> D32
  if me.is_nan() or you.is_nan()
    return D32.quiet_nan()
  if me.is_infinite() or you.is_zero()
    return D32.quiet_nan()
  if you.is_infinite()
    return me
  var n = me.truediv_unchecked(you: you).rint()
  return me.sub_unchecked(you: you.mul_unchecked(you: n))

### IEEE 754 normalize (the `reduce` operation): trailing zeros stripped to the simplest cohort
### member (`3.00` -> `3`, `1.50` -> `1.5`, `100` -> `1E+2`, `0.00` -> `0`). Specials pass through.
### Never crashes. Arithmetic stays cohort-preserving (IEEE); this is the opt-in to shortest form.
### :returns: `me` normalized to its simplest cohort member.
routine D32.normalize() -> D32
  var p = me.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64)
    return me
  if LLVM::int_eq(a: p.coeff, b: 0_u64)
    return d32_of_parts(p: D32Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: 0_u64))
  return d32_of_parts(p: decfin32(sign: p.sign, coeff: p.coeff, exp: p.exp, pref: 90_s64))

### Rounds to integral. mode: 0 trunc, 1 floor, 2 ceil, 3 round (half away), 4 rint (half even).
routine d32_round_int(x: D32, mode: S64) -> D32
  var p = x.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64)
    return x
  if LLVM::int_eq(a: p.coeff, b: 0_u64)
    return x
  if LLVM::signed_ge(a: p.exp, b: 0_s64)
    return x
  var ndrop = LLVM::sub(a: 0_s64, b: p.exp)
  var cw = LLVM::zero_extend[U64, U256](p.coeff)
  var q = LLVM::zero_extend[U64, U256](0_u64)
  var rnz = true
  var half = false
  var gthalf = false
  if LLVM::signed_le(a: ndrop, b: 7_s64)
    var divp = pow10b(k: ndrop)
    q = div_pow10b(x: cw, k: ndrop)
    var r = LLVM::sub(a: cw, b: LLVM::mul(a: q, b: divp))
    rnz = LLVM::int_ne[U256](a: r, b: 0)
    var twice = LLVM::mul(a: r, b: LLVM::zero_extend[U64, U256](2_u64))
    half = LLVM::int_eq(a: twice, b: divp)
    gthalf = LLVM::unsigned_gt(a: twice, b: divp)
  var inc = false
  if LLVM::int_eq(a: mode, b: 1_s64)
    inc = p.sign and rnz
  elseif LLVM::int_eq(a: mode, b: 2_s64)
    inc = (not p.sign) and rnz
  elseif LLVM::int_eq(a: mode, b: 3_s64)
    inc = gthalf or half
  elseif LLVM::int_eq(a: mode, b: 4_s64)
    if gthalf
      inc = true
    elseif half
      inc = LLVM::int_ne(a: LLVM::bit_and(a: q, b: LLVM::zero_extend[U64, U256](1_u64)), b: LLVM::zero_extend[U64, U256](0_u64))
  var qq = q
  if inc
    qq = LLVM::add(a: q, b: LLVM::zero_extend[U64, U256](1_u64))
  return d32_of_parts(p: D32Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: LLVM::int_truncate[U256, U64](qq)))

### Truncates toward zero to an integral value. Never crashes.
### :returns: `me` with its fractional part discarded.
routine D32.trunc() -> D32
  return d32_round_int(x: me, mode: 0_s64)

### Rounds down (toward -inf) to an integral value. Never crashes.
### :returns: The largest integer <= `me`.
routine D32.floor() -> D32
  return d32_round_int(x: me, mode: 1_s64)

### Rounds up (toward +inf) to an integral value. Never crashes.
### :returns: The smallest integer >= `me`.
routine D32.ceil() -> D32
  return d32_round_int(x: me, mode: 2_s64)

### Rounds to nearest integer, ties away from zero. Never crashes.
### :returns: `me` rounded with ties away.
routine D32.round() -> D32
  return d32_round_int(x: me, mode: 3_s64)

### IEEE 754 roundToIntegral, ties to even. Never crashes.
### :returns: `me` rounded with ties to even.
routine D32.rint() -> D32
  return d32_round_int(x: me, mode: 4_s64)

### Fractional part me - trunc(me) (carries me's sign). NaN/inf -> NaN/±0. Never crashes.
### :returns: The signed fractional part of `me`.
routine D32.frac() -> D32
  if me.is_nan()
    return me
  var p = me.decode()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return d32_of_parts(p: D32Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: 0_u64))
  return me - me.trunc()
