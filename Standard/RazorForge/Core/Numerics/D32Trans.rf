module Core

# ============================================================================
# D32Trans — decimal32 (Pmax=7) transcendentals + libm surface via the DoubleDouble (DD) engine
# (~31 decimal digits >> 7). A D32 value is decoded into DD, run through DD's pure-RF method surface,
# and rounded back to 7 digits — deterministic (no platform libm) with ~24 guard digits, matching the
# decimal ladder D64->B128 / D128->F192 / Decimal->F320. (DD's own seeds may call an B64 libm routine,
# but its DD-precision refinement converges to a platform-independent result.)
#
# The dec<->bin conversions (B16/B32/B64/B128 <-> D32) are the integer bridge in D64Trans.rf
# (decimal_to_binary_bits / b128_to_d32), correctly rounded in one step.
# ============================================================================

### dec -> bin: D32 value as a B64, correctly rounded (see decimal_to_binary_bits).
routine B64(from: D32) -> B64
  var d = from.decode()
  return B64.from_bits(bits: LLVM::int_truncate[U128, U64](decimal_to_binary_bits(sign: d.sign, special: d.special, coeff: d.coeff, exp: d.exp, p: 53_s64, emin: -1022_s64, emax: 1023_s64)))

### bin -> dec: B64 value as a D32, correctly rounded (exact widening to B128, then b128_to_d32).
routine D32(from: B64) -> D32
  return b128_to_d32(x: B128(from: from))

### dec -> DD: D32 value as a DD (coeff exact <=7 digits, scaled by 10^exp). The DD engine (~31
### digits) is D32's transcendental scratch — pure-RF (no platform libm), deterministic, with ~24
### guard digits over decimal32's 7, matching the D64->B128 / D128->F192 / Decimal->F320 ladder.
routine d32_to_dd(x: D32) -> DD
  var p = x.decode()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    var inf = dd_of(x: 1.0_b64).div(you: dd_of(x: 0.0_b64))
    return if p.sign then inf.neg() else inf
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return dd_of(x: 0.0_b64).div(you: dd_of(x: 0.0_b64))
  if LLVM::int_eq(a: p.coeff, b: 0_u64)
    return if p.sign then dd_of(x: 0.0_b64).neg() else dd_of(x: 0.0_b64)
  var mag = dd_of(x: p.coeff.B64()).mul(you: dd_pow10(e: p.exp))
  return if p.sign then mag.neg() else mag

### bin -> dec: DD value as a D32, rounded to <=7 digits (decfin32 does the final round-half-even
### 16 -> 7). Decimal exponent estimated from the hi limb's BINARY exponent (integer mul+shift, no
### libm log10); the +-1 error is absorbed by decfin32.
routine dd_to_d32(x: DD) -> D32
  var f = x.to_b64()
  if f.is_nan()
    return D32.quiet_nan()
  if f.is_infinite()
    return D32.infinity(sign: LLVM::float_lt[B64](a: x.hi, b: 0.0_b64))
  if LLVM::float_eq[B64](a: x.hi, b: 0.0_b64)
    return d32_of_parts(p: D32Parts(sign: LLVM::float_lt[B64](a: LLVM::copysign[B64](value: 1.0_b64, sign: x.hi), b: 0.0_b64), special: 0_u64, exp: 0_s64, coeff: 0_u64))
  var sign = LLVM::float_lt[B64](a: x.hi, b: 0.0_b64)
  var ax = x.abs()
  var decexp = LLVM::signed_div(a: LLVM::mul(a: C::rf_b64_ilogb(value: ax.hi), b: 315653_s64), b: 1048576_s64)
  var q = LLVM::sub(a: 15_s64, b: decexp)
  var coeff = dd_to_u64_sticky(u: ax.mul(you: dd_pow10(e: q)))
  return d32_of_parts(p: decfin32(sign: sign, coeff: coeff, exp: LLVM::sub(a: 0_s64, b: q), pref: 90_s64))

# ============================================================================
# Transcendentals — all delegate to the DD (double-double) engine surface: decode D32 -> DD,
# evaluate, round DD -> D32. Pure-RF and deterministic (no platform libm), ~31-digit scratch for
# decimal32's 7 — mirrors D64->B128 / D128->F192 / Decimal->F320.
# ============================================================================

### e^me via hardware libm (B64). Crashes on a non-finite result.
### :returns: The exponential of `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D32.exp!() -> D32
  var r = me.exp_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### e^me via libm double, raw IEEE: may return ±inf or NaN. Never crashes.
### :returns: The exponential of `me`, possibly non-finite.
routine D32.exp_unchecked() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).exp())

### e^me - 1 (accurate near 0) via libm. Crashes on a non-finite result.
### :returns: `exp(me) - 1`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D32.expm1!() -> D32
  var r = me.expm1_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `exp(me) - 1` via libm double, raw IEEE: may return ±inf or NaN. Never crashes.
### :returns: `exp(me) - 1`, possibly non-finite.
routine D32.expm1_unchecked() -> D32
  return dd_to_d32(x: d32_to_dd(x: me).expm1())

