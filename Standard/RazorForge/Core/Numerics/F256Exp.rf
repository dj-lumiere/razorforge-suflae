### Exact F256 -> F512 widen (normal + zero). Same sign; exp rebias +3932160
### (4194303 - 262143); mantissa <<252 (488 - 236).
routine f256_widen(x: F256) -> F512
  var sign = 0_u64
  if x.is_negative()
    sign = 1_u64
  var exp = x.raw_exponent()
  var mant = x.raw_mantissa()
  var sbit = LLVM::shift_left(value: LLVM::zero_extend[U64, U512](sign), bits: U512.to_width(s: 511_s64))
  if LLVM::int_eq[U64](a: exp, b: 0_u64) and LLVM::int_eq[U256](a: mant, b: 0)
    return F512.from_bits(bits: sbit)
  var biased512 = LLVM::add(a: exp, b: 3932160_u64)
  var ebits = LLVM::shift_left(value: LLVM::zero_extend[U64, U512](biased512), bits: U512.to_width(s: 488_s64))
  var mant512 = LLVM::shift_left(value: LLVM::zero_extend[U256, U512](mant), bits: U512.to_width(s: 252_s64))
  return F512.from_bits(bits: LLVM::bit_or(a: LLVM::bit_or(a: sbit, b: ebits), b: mant512))

### Small-integer F256 constant via the engine (for thresholds).
routine f256_intval(n: S64) -> F256
  return UnpackedFloat[U256, U512, 256].from_s64(src: n).to_f256a()

### Correctly-rounded-ish binary256 exp. Specials per IEEE/C99: exp(NaN)=NaN,
### exp(+inf)=+inf, exp(-inf)=+0, overflow->+inf (x > ln(maxfinite) ~ 181704.9)
### and underflow->+0 (x < ln(min_subnormal) ~ -181867.9).
routine f256_exp_cr(x: F256) -> F256
  if x.is_nan()
    return F256.from_bits(bits: f256a_qnan())
  if x.is_infinite()
    if x.is_negative()
      return F256.from_bits(bits: LLVM::zero_extend[U64, U256](0_u64))
    return F256.from_bits(bits: f256a_inf(sign: 0_u64))
  if x > f256_intval(n: 181705_s64)
    return F256.from_bits(bits: f256a_inf(sign: 0_u64))
  if x < f256_intval(n: -181868_s64)
    return F256.from_bits(bits: LLVM::zero_extend[U64, U256](0_u64))
  var xw = f256_widen(x: x)
  var kf = (xw * expc512_invln2()).round()
  var k = kf.to_uf().to_s64()
  var r = xw - kf * expc512_ln2()
  var p = expc512_poly(r: r)
  return p.to_uf().ldexp(e: k).to_f512a().to_f256a()
