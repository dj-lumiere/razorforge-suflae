module Core

# Correctly-rounded-ish binary256 exp: range-reduce x = k*ln2 + r (r in [-ln2/2,
# ln2/2]) in F512, evaluate the degree-44 Remez minimax polynomial for exp(r) via
# FMA-Horner in F512 (poly error 2^-299), scale by 2^k, round F512->F256.
# Constants are F512 bit patterns from playground/remez/remez.py (run: remez.py 512 44).

### ln(2) as an F512 constant (used for exp range-reduction). :returns: ln(2).
routine expc512_ln2() -> F512
  return F512.from_bits(bits: asm512(q0: 8089177752226648611_u64, q1: 17597289815749716866_u64, q2: 15517487502794815125_u64, q3: 6193671936005652699_u64, q4: 3561321547239962391_u64, q5: 16568002516177276133_u64, q6: 11453594569550540807_u64, q7: 4611684244139274147_u64))

### 1/ln(2) as an F512 constant (used for exp range-reduction). :returns: 1/ln(2).
routine expc512_invln2() -> F512
  return F512.from_bits(bits: asm512(q0: 10745940045662652072_u64, q1: 15546821553746594840_u64, q2: 3375918828216052610_u64, q3: 4784106742739365546_u64, q4: 15182954953064634787_u64, q5: 4214544440044638650_u64, q6: 3450170168565407954_u64, q7: 4611685405664105144_u64))

### Degree-44 Remez minimax exp on the reduced interval, FMA-Horner in F512.
routine expc512_poly(r: F512) -> F512
  var p = F512.from_bits(bits: asm512(q0: 1153956548576988756_u64, q1: 34157563845953657_u64, q2: 16036580274796947693_u64, q3: 11646725863641531012_u64, q4: 3730863043476890030_u64, q5: 1447379237970063371_u64, q6: 3627763773981566029_u64, q7: 4611486076402683211_u64))
  p = p.fma(b: r, c: F512.from_bits(bits: asm512(q0: 4707684848662164051_u64, q1: 11370192198996552583_u64, q2: 17998530146105714497_u64, q3: 17628935714415640464_u64, q4: 13154840993966661585_u64, q5: 17967574305705689851_u64, q6: 4703681833285180161_u64, q7: 4611492049688164107_u64)))
  p = p.fma(b: r, c: F512.from_bits(bits: asm512(q0: 3515568026466139986_u64, q1: 2429884944853906792_u64, q2: 6625369501841313675_u64, q3: 6452936097702145680_u64, q4: 11184611421056474112_u64, q5: 17257007589232675980_u64, q6: 8467454843141522814_u64, q7: 4611498073599653030_u64)))
