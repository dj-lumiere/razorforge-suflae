module Core

### Fixed-size single-precision Euclidean vectors: `Vector2D`, `Vector3D`, and
### `Vector4D`. Each stores plain `F32` components, so a vector is a trivially
### copyable value record. These are the geometry-facing companions to the
### complex types in this directory; for arbitrary-length elementwise math use
### the SIMD `Vector[T, N]` type instead.
###
### Vectors are NOT a field, so they obey only the arithmetic protocols that are
### mathematically well defined for them: `Addable`, `Subtractable`, `Negatable`
### (component-wise), plus `Equatable`. Scaling, dot, cross, length, and
### normalization are exposed as named routines rather than through `*`/`/`,
### which have no canonical vector meaning.

# Math routines use the component F32's `_unchecked` ops (raw IEEE, no overflow
# checks); NaN/±inf therefore propagate through the vector result per IEEE 754.

# ============================================================================
# Vector2D
# ============================================================================

### A two-dimensional vector with `F32` components.
record Vector2D obeys Addable, Subtractable, Negatable, Equatable
  ### The x component.
  x: F32
  ### The y component.
  y: F32

# Vector2D constants
preset VECTOR2D_ZERO: Vector2D = Vector2D(x: 0.0_f32, y: 0.0_f32)
preset VECTOR2D_UNIT_X: Vector2D = Vector2D(x: 1.0_f32, y: 0.0_f32)
preset VECTOR2D_UNIT_Y: Vector2D = Vector2D(x: 0.0_f32, y: 1.0_f32)

### Returns the component-wise sum `me + you`.
### :param you: The addend.
### :returns: A `Vector2D` whose components are the sums.
routine Vector2D.add(you: Vector2D) -> Vector2D
  return Vector2D(x: me.x + you.x, y: me.y + you.y)

### Returns the component-wise difference `me - you`.
### :param you: The value to subtract.
### :returns: A `Vector2D` whose components are the differences.
routine Vector2D.sub(you: Vector2D) -> Vector2D
  return Vector2D(x: me.x - you.x, y: me.y - you.y)

### Returns the arithmetic negation of this vector.
### :returns: A `Vector2D` with both components negated.
routine Vector2D.neg() -> Vector2D
  return Vector2D(x: -me.x, y: -me.y)

### Returns this vector scaled by a scalar `factor`.
### :param factor: The scalar multiplier.
### :returns: `factor · me`, component-wise.
routine Vector2D.scale(factor: F32) -> Vector2D
  return Vector2D(x: me.x * factor, y: me.y * factor)

### Returns the dot product `me · you`.
### :param you: The right operand.
### :returns: `me.x·you.x + me.y·you.y`.
routine Vector2D.dot(you: Vector2D) -> F32
  return me.x * you.x + me.y * you.y

### Returns the z component of the 2D cross product (a scalar).
### :param you: The right operand.
### :returns: `me.x·you.y − me.y·you.x`.
routine Vector2D.cross(you: Vector2D) -> F32
  return me.x * you.y - me.y * you.x

### Returns the squared Euclidean length (avoids the square root of `length`).
### :returns: `me · me`.
routine Vector2D.length_squared() -> F32
  return me.x * me.x + me.y * me.y

### Returns the Euclidean length (magnitude) of this vector.
### :returns: `√(x² + y²)`.
routine Vector2D.length() -> F32
  return me.length_squared().sqrt_unchecked()

### Returns the unit vector pointing in the same direction. A zero vector is
### returned unchanged (its length is zero).
### :returns: `me / |me|`, or `me` when `|me| == 0`.
routine Vector2D.normalize() -> Vector2D
  var len = me.length()
  if len == 0.0_f32
    return me
  return me.scale(factor: 1.0_f32 / len)

### Returns the Euclidean distance between this vector and `you`.
### :param you: The other point.
### :returns: `|me − you|`.
routine Vector2D.distance(you: Vector2D) -> F32
  return (me - you).length()

### Returns the linear interpolation between `me` (at `t = 0`) and `you` (at `t = 1`).
### :param you: The endpoint.
### :param t: The interpolation parameter (unclamped).
### :returns: `me + t·(you − me)`.
routine Vector2D.lerp(you: Vector2D, t: F32) -> Vector2D
  return me + (you - me).scale(factor: t)

### Returns `true` if both components compare equal.
### :param you: The value to compare against.
### :returns: `true` if `me.x == you.x` and `me.y == you.y`.
routine Vector2D.eq(you: Vector2D) -> Bool
  return me.x == you.x and me.y == you.y

### Formats this vector as `(x, y)`.
### :returns: The resulting `Text` value.
routine Vector2D.represent() -> Text
  return "(" + me.x.represent() + ", " + me.y.represent() + ")"

### Returns a diagnostic string wrapping the value with its type name.
### :returns: The resulting `Text` value.
routine Vector2D.diagnose() -> Text
  return "Vector2D" + me.represent()

### Returns an xxHash64-based hash of this vector.
### :returns: A `U64` hash combining both components.
routine Vector2D.fast_hash() -> U64
  var acc = __hash_round(acc: 0u64, h: me.x.fast_hash())
  acc = __hash_round(acc: acc, h: me.y.fast_hash())
  return __hash_finalize(h: acc)

### Returns a SipHash-2-4 keyed hash of this vector.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash.
routine Vector2D.hash(k0: U64, k1: U64) -> U64
  var acc = __hash_round(acc: 0u64, h: me.x.hash(k0: k0, k1: k1))
  acc = __hash_round(acc: acc, h: me.y.hash(k0: k0, k1: k1))
  return __hash_finalize(h: acc)

# ============================================================================
# Vector3D
# ============================================================================

### A three-dimensional vector with `F32` components.
record Vector3D obeys Addable, Subtractable, Negatable, Equatable
  ### The x component.
  x: F32
  ### The y component.
  y: F32
  ### The z component.
  z: F32

# Vector3D constants
preset VECTOR3D_ZERO: Vector3D = Vector3D(x: 0.0_f32, y: 0.0_f32, z: 0.0_f32)
preset VECTOR3D_UNIT_X: Vector3D = Vector3D(x: 1.0_f32, y: 0.0_f32, z: 0.0_f32)
preset VECTOR3D_UNIT_Y: Vector3D = Vector3D(x: 0.0_f32, y: 1.0_f32, z: 0.0_f32)
preset VECTOR3D_UNIT_Z: Vector3D = Vector3D(x: 0.0_f32, y: 0.0_f32, z: 1.0_f32)

### Returns the component-wise sum `me + you`.
### :param you: The addend.
### :returns: A `Vector3D` whose components are the sums.
routine Vector3D.add(you: Vector3D) -> Vector3D
  return Vector3D(x: me.x + you.x, y: me.y + you.y, z: me.z + you.z)

### Returns the component-wise difference `me - you`.
### :param you: The value to subtract.
### :returns: A `Vector3D` whose components are the differences.
routine Vector3D.sub(you: Vector3D) -> Vector3D
  return Vector3D(x: me.x - you.x, y: me.y - you.y, z: me.z - you.z)

### Returns the arithmetic negation of this vector.
### :returns: A `Vector3D` with all components negated.
routine Vector3D.neg() -> Vector3D
  return Vector3D(x: -me.x, y: -me.y, z: -me.z)

### Returns this vector scaled by a scalar `factor`.
### :param factor: The scalar multiplier.
### :returns: `factor · me`, component-wise.
routine Vector3D.scale(factor: F32) -> Vector3D
  return Vector3D(x: me.x * factor, y: me.y * factor, z: me.z * factor)

### Returns the dot product `me · you`.
### :param you: The right operand.
### :returns: `me.x·you.x + me.y·you.y + me.z·you.z`.
routine Vector3D.dot(you: Vector3D) -> F32
  return me.x * you.x + me.y * you.y + me.z * you.z

### Returns the cross product `me × you`, perpendicular to both operands.
### :param you: The right operand.
### :returns: The vector `(y₁z₂−z₁y₂, z₁x₂−x₁z₂, x₁y₂−y₁x₂)`.
routine Vector3D.cross(you: Vector3D) -> Vector3D
  return Vector3D(x: me.y * you.z - me.z * you.y, y: me.z * you.x - me.x * you.z, z: me.x * you.y - me.y * you.x)

### Returns the squared Euclidean length (avoids the square root of `length`).
### :returns: `me · me`.
routine Vector3D.length_squared() -> F32
  return me.x * me.x + me.y * me.y + me.z * me.z

### Returns the Euclidean length (magnitude) of this vector.
### :returns: `√(x² + y² + z²)`.
routine Vector3D.length() -> F32
  return me.length_squared().sqrt_unchecked()

### Returns the unit vector pointing in the same direction. A zero vector is
### returned unchanged (its length is zero).
### :returns: `me / |me|`, or `me` when `|me| == 0`.
routine Vector3D.normalize() -> Vector3D
  var len = me.length()
  if len == 0.0_f32
    return me
  return me.scale(factor: 1.0_f32 / len)

### Returns the Euclidean distance between this vector and `you`.
### :param you: The other point.
### :returns: `|me − you|`.
routine Vector3D.distance(you: Vector3D) -> F32
  return (me - you).length()

### Returns the linear interpolation between `me` (at `t = 0`) and `you` (at `t = 1`).
### :param you: The endpoint.
### :param t: The interpolation parameter (unclamped).
### :returns: `me + t·(you − me)`.
routine Vector3D.lerp(you: Vector3D, t: F32) -> Vector3D
  return me + (you - me).scale(factor: t)

### Returns `true` if all three components compare equal.
### :param you: The value to compare against.
### :returns: `true` if every component of `me` equals the matching component of `you`.
routine Vector3D.eq(you: Vector3D) -> Bool
  return me.x == you.x and me.y == you.y and me.z == you.z

### Formats this vector as `(x, y, z)`.
### :returns: The resulting `Text` value.
routine Vector3D.represent() -> Text
  return "(" + me.x.represent() + ", " + me.y.represent() + ", " + me.z.represent() + ")"

### Returns a diagnostic string wrapping the value with its type name.
### :returns: The resulting `Text` value.
routine Vector3D.diagnose() -> Text
  return "Vector3D" + me.represent()

### Returns an xxHash64-based hash of this vector.
### :returns: A `U64` hash combining all three components.
routine Vector3D.fast_hash() -> U64
  var acc = __hash_round(acc: 0u64, h: me.x.fast_hash())
  acc = __hash_round(acc: acc, h: me.y.fast_hash())
  acc = __hash_round(acc: acc, h: me.z.fast_hash())
  return __hash_finalize(h: acc)

### Returns a SipHash-2-4 keyed hash of this vector.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash.
routine Vector3D.hash(k0: U64, k1: U64) -> U64
  var acc = __hash_round(acc: 0u64, h: me.x.hash(k0: k0, k1: k1))
  acc = __hash_round(acc: acc, h: me.y.hash(k0: k0, k1: k1))
  acc = __hash_round(acc: acc, h: me.z.hash(k0: k0, k1: k1))
  return __hash_finalize(h: acc)

# ============================================================================
# Vector4D
# ============================================================================

### A four-dimensional vector with `F32` components.
record Vector4D obeys Addable, Subtractable, Negatable, Equatable
  ### The x component.
  x: F32
  ### The y component.
  y: F32
  ### The z component.
  z: F32
  ### The w component.
  w: F32

# Vector4D constants
preset VECTOR4D_ZERO: Vector4D = Vector4D(x: 0.0_f32, y: 0.0_f32, z: 0.0_f32, w: 0.0_f32)
preset VECTOR4D_UNIT_X: Vector4D = Vector4D(x: 1.0_f32, y: 0.0_f32, z: 0.0_f32, w: 0.0_f32)
preset VECTOR4D_UNIT_Y: Vector4D = Vector4D(x: 0.0_f32, y: 1.0_f32, z: 0.0_f32, w: 0.0_f32)
preset VECTOR4D_UNIT_Z: Vector4D = Vector4D(x: 0.0_f32, y: 0.0_f32, z: 1.0_f32, w: 0.0_f32)
preset VECTOR4D_UNIT_W: Vector4D = Vector4D(x: 0.0_f32, y: 0.0_f32, z: 0.0_f32, w: 1.0_f32)

### Returns the component-wise sum `me + you`.
### :param you: The addend.
### :returns: A `Vector4D` whose components are the sums.
routine Vector4D.add(you: Vector4D) -> Vector4D
  return Vector4D(x: me.x + you.x, y: me.y + you.y, z: me.z + you.z, w: me.w + you.w)

### Returns the component-wise difference `me - you`.
### :param you: The value to subtract.
### :returns: A `Vector4D` whose components are the differences.
routine Vector4D.sub(you: Vector4D) -> Vector4D
  return Vector4D(x: me.x - you.x, y: me.y - you.y, z: me.z - you.z, w: me.w - you.w)

### Returns the arithmetic negation of this vector.
### :returns: A `Vector4D` with all components negated.
routine Vector4D.neg() -> Vector4D
  return Vector4D(x: -me.x, y: -me.y, z: -me.z, w: -me.w)

### Returns this vector scaled by a scalar `factor`.
### :param factor: The scalar multiplier.
### :returns: `factor · me`, component-wise.
routine Vector4D.scale(factor: F32) -> Vector4D
  return Vector4D(x: me.x * factor, y: me.y * factor, z: me.z * factor, w: me.w * factor)

### Returns the dot product `me · you`.
### :param you: The right operand.
### :returns: `me.x·you.x + me.y·you.y + me.z·you.z + me.w·you.w`.
routine Vector4D.dot(you: Vector4D) -> F32
  return me.x * you.x + me.y * you.y + me.z * you.z + me.w * you.w

### Returns the squared Euclidean length (avoids the square root of `length`).
### :returns: `me · me`.
routine Vector4D.length_squared() -> F32
  return me.x * me.x + me.y * me.y + me.z * me.z + me.w * me.w

### Returns the Euclidean length (magnitude) of this vector.
### :returns: `√(x² + y² + z² + w²)`.
routine Vector4D.length() -> F32
  return me.length_squared().sqrt_unchecked()

### Returns the unit vector pointing in the same direction. A zero vector is
### returned unchanged (its length is zero).
### :returns: `me / |me|`, or `me` when `|me| == 0`.
routine Vector4D.normalize() -> Vector4D
  var len = me.length()
  if len == 0.0_f32
    return me
  return me.scale(factor: 1.0_f32 / len)

### Returns the Euclidean distance between this vector and `you`.
### :param you: The other point.
### :returns: `|me − you|`.
routine Vector4D.distance(you: Vector4D) -> F32
  return (me - you).length()

### Returns the linear interpolation between `me` (at `t = 0`) and `you` (at `t = 1`).
### :param you: The endpoint.
### :param t: The interpolation parameter (unclamped).
### :returns: `me + t·(you − me)`.
routine Vector4D.lerp(you: Vector4D, t: F32) -> Vector4D
  return me + (you - me).scale(factor: t)

### Returns `true` if all four components compare equal.
### :param you: The value to compare against.
### :returns: `true` if every component of `me` equals the matching component of `you`.
routine Vector4D.eq(you: Vector4D) -> Bool
  return me.x == you.x and me.y == you.y and me.z == you.z and me.w == you.w

### Formats this vector as `(x, y, z, w)`.
### :returns: The resulting `Text` value.
routine Vector4D.represent() -> Text
  return "(" + me.x.represent() + ", " + me.y.represent() + ", " + me.z.represent() + ", " + me.w.represent() + ")"

### Returns a diagnostic string wrapping the value with its type name.
### :returns: The resulting `Text` value.
routine Vector4D.diagnose() -> Text
  return "Vector4D" + me.represent()

### Returns an xxHash64-based hash of this vector.
### :returns: A `U64` hash combining all four components.
routine Vector4D.fast_hash() -> U64
  var acc = __hash_round(acc: 0u64, h: me.x.fast_hash())
  acc = __hash_round(acc: acc, h: me.y.fast_hash())
  acc = __hash_round(acc: acc, h: me.z.fast_hash())
  acc = __hash_round(acc: acc, h: me.w.fast_hash())
  return __hash_finalize(h: acc)

### Returns a SipHash-2-4 keyed hash of this vector.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash.
routine Vector4D.hash(k0: U64, k1: U64) -> U64
  var acc = __hash_round(acc: 0u64, h: me.x.hash(k0: k0, k1: k1))
  acc = __hash_round(acc: acc, h: me.y.hash(k0: k0, k1: k1))
  acc = __hash_round(acc: acc, h: me.z.hash(k0: k0, k1: k1))
  acc = __hash_round(acc: acc, h: me.w.hash(k0: k0, k1: k1))
  return __hash_finalize(h: acc)
