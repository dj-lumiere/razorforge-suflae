module Core

import Collections

# ============================================================================
# U384 — raw 384-bit unsigned integer. Engine-only intermediate: the wide
# product/numerator (L) of the binary192 float engine
# (UnpackedFloat[U192, U384, 192], the D128/B128 W=192 scratch). Not user-facing, so it carries
# only the minimal surface the engine needs: FloorDivisible (knuth-D, the `//` the
# divide core calls) + value semantics. No literal suffix (like U512/U1024, constants
# are assembled from U64 limbs via `asm384`).
# ============================================================================

@llvm("i384")
record U384 obeys FloorDivisible, Assignable, Copyable
  pass

### Assemble 6 U64 limbs (little-endian) into a U384.
@inline
routine asm384(q0: U64, q1: U64, q2: U64, q3: U64, q4: U64, q5: U64) -> U384
  var r = LLVM::zero_extend[U64, U384](q0)
  r = LLVM::bit_or(a: r, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U384](q1), bits: U384.to_width(s: 64_s64)))
  r = LLVM::bit_or(a: r, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U384](q2), bits: U384.to_width(s: 128_s64)))
  r = LLVM::bit_or(a: r, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U384](q3), bits: U384.to_width(s: 192_s64)))
  r = LLVM::bit_or(a: r, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U384](q4), bits: U384.to_width(s: 256_s64)))
  r = LLVM::bit_or(a: r, b: LLVM::shift_left(value: LLVM::zero_extend[U64, U384](q5), bits: U384.to_width(s: 320_s64)))
  return r

### nth U64 limb of a U384.
@inline
routine limb384(x: U384, i: S64) -> U64
  return LLVM::int_truncate[U384, U64](LLVM::shift_right_unsigned(x, U384.to_width(s: LLVM::mul(a: i, b: 64_s64))))

### Returns me // you via the base-2⁶⁴ Knuth-D kernel (`knuth_divide[6]`, hardware
### `DIV r64` per step) instead of the slow inline-expanded `udiv i384`.
routine U384.floordiv(you: U384) -> U384
  var av = me
  var bv = you
  var rem = Array[U64, 6]()
  danger
    var q = knuth_divide[6](
      a: LLVM::reinterpret_bits[Hijacked[U384], Hijacked[Array[U64, 6]]](av.hijack()),
      b: LLVM::reinterpret_bits[Hijacked[U384], Hijacked[Array[U64, 6]]](bv.hijack()),
      rem: rem.hijack())
    return LLVM::reinterpret_bits[Hijacked[Array[U64, 6]], Hijacked[U384]](q.hijack()).peek()

### Returns me % you (remainder from the same Knuth-D kernel).
routine U384.mod(you: U384) -> U384
  var av = me
  var bv = you
  var rem = Array[U64, 6]()
  danger
    var q = knuth_divide[6](
      a: LLVM::reinterpret_bits[Hijacked[U384], Hijacked[Array[U64, 6]]](av.hijack()),
      b: LLVM::reinterpret_bits[Hijacked[U384], Hijacked[Array[U64, 6]]](bv.hijack()),
      rem: rem.hijack())
    return LLVM::reinterpret_bits[Hijacked[Array[U64, 6]], Hijacked[U384]](rem.hijack()).peek()

### Quotient of `num // den` with the round-sticky baked into bit 0 (set iff the division
### left a nonzero remainder). One Knuth-D call — no separate %/mul-back.
routine udiv384_sticky(num: U384, den: U384) -> U384
  var av = num
  var bv = den
  var rem = Array[U64, 6]()
  danger
    var qa = knuth_divide[6](
      a: LLVM::reinterpret_bits[Hijacked[U384], Hijacked[Array[U64, 6]]](av.hijack()),
      b: LLVM::reinterpret_bits[Hijacked[U384], Hijacked[Array[U64, 6]]](bv.hijack()),
      rem: rem.hijack())
    var q = LLVM::reinterpret_bits[Hijacked[Array[U64, 6]], Hijacked[U384]](qa.hijack()).peek()
    var r = LLVM::reinterpret_bits[Hijacked[Array[U64, 6]], Hijacked[U384]](rem.hijack()).peek()
    if LLVM::int_ne[U384](a: r, b: 0)
      return LLVM::bit_or(a: q, b: LLVM::zero_extend[U64, U384](1_u64))
    return q

### Diagnostic name (raw wide intermediate; not decimal-formatted).
@override
routine U384.represent() -> Text
  return wide_dec[U384](me)

### Diagnostic representation tagged with the type name.
@override
routine U384.diagnose() -> Text
  return "U384"
