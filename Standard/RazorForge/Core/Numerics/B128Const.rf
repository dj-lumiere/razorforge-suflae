### exp_coef polynomial coefficient i -- table-indexed, W-dispatched (126/190/254/382/510).
common routine UnpackedFloat[N, N2].exp_coef(i: S64) -> UnpackedFloat[N, N2]
  if LLVM::int_eq[U64](a: N, b: 2_u64)
    var ci = i
    if LLVM::signed_lt(a: ci, b: 0_s64)
      ci = 0_s64
    if LLVM::signed_ge(a: ci, b: 24_s64)
      ci = 23_s64
    var ui = LLVM::reinterpret_bits[S64, U64](ci)
    var p = LLVM::mul(a: ui, b: 2_u64)
    var cls = POSITIVE_NORMAL
    if LLVM::int_eq(a: EXP_COEF_QUAD_SGN[ui], b: 1_u8)
      cls = NEGATIVE_NORMAL
    return UnpackedFloat[N, N2].make(mant: UnpackedFloat[N, N2].words2(h1: EXP_COEF_QUAD_MANT[LLVM::add(a: p, b: 1_u64)], h0: EXP_COEF_QUAD_MANT[p]), exp: EXP_COEF_QUAD_EXP[ui], fpclass: cls)
  var ci = i
  if LLVM::signed_lt(a: ci, b: 0_s64)
    ci = 0_s64
  if LLVM::signed_ge(a: ci, b: 24_s64)
    ci = 23_s64
  var ui = LLVM::reinterpret_bits[S64, U64](ci)
  var p = LLVM::mul(a: ui, b: 3_u64)
  var cls = POSITIVE_NORMAL
  if LLVM::int_eq(a: EXP_COEF_F192_SGN[ui], b: 1_u8)
    cls = NEGATIVE_NORMAL
  return UnpackedFloat[N, N2].make(mant: UnpackedFloat[N, N2].words3(h2: EXP_COEF_F192_MANT[LLVM::add(a: p, b: 2_u64)], h1: EXP_COEF_F192_MANT[LLVM::add(a: p, b: 1_u64)], h0: EXP_COEF_F192_MANT[p]), exp: EXP_COEF_F192_EXP[ui], fpclass: cls)

