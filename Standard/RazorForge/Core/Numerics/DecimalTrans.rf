module Core

# ============================================================================
# DecimalTrans — decimal256 transcendentals via the binary512 engine (F512).
#
# Decimal (Pmax=70 decimal digits) has no transcendental cores of its own. F512
# carries a 489-bit significand (~147 decimal digits), so a D256 value converted
# to F512, run through the (faithfully-rounded) F512 transcendental, and rounded
# back to 70 digits is CORRECTLY ROUNDED: the ~few-ULP F512 error lands near
# decimal digit ~145, far below the 70-digit rounding boundary.
#
# The two radix adapters are the substance here:
#   decimalfixed_to_f512 (dec->bin): load coeff exactly into the engine, multiply by 10^exp
#     computed by binary-exponentiation of 10.0 in F512 (no big-int 10^k table).
#   f512_to_decimala (bin->dec): scale |x|*10^(76-decexp) to ~10^77, peek the integer
#     with round-half-even, hand the 77-digit coeff to Decimal's decfinA (rounds to 70).
#
# SUPPORTED RANGE: values whose magnitude keeps 10^(76-decexp) inside F512's range
# (decimal exponent within ~+-1.26e6). Beyond that f512_pow10 overflows/underflows;
# real transcendental I/O never reaches it. Verified by round-trip + cross-checks.
# ============================================================================

# ============================================================================
# Radix adapters
# ============================================================================

### Builds the engine value of a non-negative U256 integer (exact; coeff <= 233 bits
### fits the 489-bit significand). value = mant * 2^(exp-509), mant MSB at bit 510.
routine uf512_from_u256(c: U256) -> UnpackedFloat[U512, U1024, 512]
  if LLVM::int_eq[U256](a: c, b: 0)
    return UnpackedFloat[U512, U1024, 512].zero(sign: false)
  var cw = LLVM::zero_extend[U256, U512](c)
  var x = LLVM::sub(a: 512_s64, b: LLVM::int_truncate[U512, S64](LLVM::leading_zeros(cw)))
  var mant = LLVM::shift_left(value: cw, bits: U512.to_width(s: LLVM::sub(a: 511_s64, b: x)))
  return UnpackedFloat[U512, U1024, 512].make(mant: mant, exp: LLVM::sub(a: x, b: 2_s64), fpclass: SignedFpClass.from_flags(sign: false, iszero: false, isinf: false, isnan: false))

### Rounds the engine value (assumed a positive ~integer) to a U512, round-half-even.
### integer = round(mant * 2^(exp-509)); shift = 509 - exp (positive in the ~10^77 range).
routine uf512_to_u512_round(u: UnpackedFloat[U512, U1024, 512]) -> U512
  var shift = LLVM::sub(a: 509_s64, b: u.exp)
  if LLVM::signed_le(a: shift, b: 0_s64)
    return LLVM::shift_left(value: u.mant, bits: U512.to_width(s: LLVM::sub(a: 0_s64, b: shift)))
  if LLVM::signed_ge(a: shift, b: 512_s64)
    return LLVM::zero_extend[U64, U512](0_u64)
  var q = LLVM::shift_right_unsigned(u.mant, U512.to_width(s: shift))
  var lost = LLVM::bit_and(a: u.mant, b: U512.low_mask(n: shift))
  var half = LLVM::shift_left[U512](value: 1, bits: U512.to_width(s: LLVM::sub[S64](a: shift, b: 1_s64)))
  if LLVM::unsigned_gt(a: lost, b: half)
    q = LLVM::add[U512](a: q, b: 1)
  elseif LLVM::int_eq[U512](a: lost, b: half) and LLVM::int_ne[U512](a: LLVM::bit_and[U512](a: q, b: 1), b: 0)
    q = LLVM::add[U512](a: q, b: 1)
  return q

### 10^e as an F512. Common range [-400,400] is a correctly-rounded table lookup
### (one gep+load, more accurate than the loop); extreme |e| falls back to binary
### exponentiation of 10.0 (negative via final reciprocal; faithful ~few ULP).
routine f512_pow10(e: S64) -> F512
  if f512_pow10_in_table(k: e)
    return f512_pow10_tbl(k: e)
  var neg = LLVM::signed_lt(a: e, b: 0_s64)
  var n = if neg then LLVM::sub(a: 0_s64, b: e) else e
  var result = f512a_one()
  var base = UnpackedFloat[U512, U1024, 512].from_s64(src: 10_s64).to_f512a()
  while LLVM::signed_gt(a: n, b: 0_s64)
    if LLVM::int_ne(a: LLVM::bit_and(a: n, b: 1_s64), b: 0_s64)
      result = result * base
    base = base * base
    n = LLVM::shift_right_unsigned[S64](n, 1_u32)
  if neg
    return f512a_one() / result
  return result

### dec -> bin (F512): D128 parts (sign, coeff, exp10) as an F512. The 489-bit significand
### makes `coeff x 10^exp` correctly-rounded for EVERY non-tie decimal->binary128 input —
### the ~2^-475 worst-case error (correctly-rounded f512_pow10 table for |exp|<=400, faithful
### beyond) is far below the ~2^-239 hardest-case decimal->F128 separation. F128.create! uses
### this as its provably-correct fast path; exact ties are resolved separately.
routine d128parts_to_f512(p: D128Parts) -> F512
  var s = if p.sign then 1_u64 else 0_u64
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return F512.from_bits(bits: f512a_inf(sign: s))
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return F512.from_bits(bits: f512a_qnan())
  if LLVM::int_eq(a: p.coeff, b: 0_u128)
    return F512.from_bits(bits: LLVM::shift_left(value: LLVM::zero_extend[U64, U512](s), bits: U512.to_width(s: 511_s64)))
  var v = uf512_from_u256(c: LLVM::zero_extend[U128, U256](p.coeff)).to_f512a() * f512_pow10(e: p.exp)
  if p.sign
    return v.neg()
  return v

### dec -> bin: Decimal value as an F512 (coeff exact, scaled by 10^exp).
routine decimalfixed_to_f512(x: Decimal) -> F512
  var p = x.decode()
  var s = if p.sign then 1_u64 else 0_u64
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return F512.from_bits(bits: f512a_inf(sign: s))
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return F512.from_bits(bits: f512a_qnan())
  if LLVM::int_eq[U256](a: p.coeff, b: 0)
    return F512.from_bits(bits: LLVM::shift_left(value: LLVM::zero_extend[U64, U512](s), bits: U512.to_width(s: 511_s64)))
  var c = uf512_from_u256(c: p.coeff).to_f512a()
  var v = c * f512_pow10(e: p.exp)
  if p.sign
    return v.neg()
  return v

### bin -> dec: F512 value as a Decimal, correctly rounded to <=70 digits, then
### subject to the finite-only Decimal contract: a NaN result crashes with
### NumericDomainError (no real answer), a non-finite (inf) result crashes with
### NumericOverflowError (out of range / pole), and -0 normalizes to +0. This is the
### single chokepoint for ALL Decimal transcendentals, so it carries the policy for
### log(0), acos(2), sqrt(-1), exp(huge), tgamma poles, etc.
routine f512_to_decimala!(x: F512) -> Decimal
  if x.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  if x.is_infinite()
    throw NumericOverflowError(description: "overflow: out of range")
  if x.is_zero()
    return decimalfixed_of_parts(p: DecimalParts(sign: false, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U256](0_u64)))
  var sign = x.is_negative()
  var e_bin = x.to_uf().ilogb()
  # decexp ~ floor(e_bin * log10(2)); log10(2) ~ 315653 / 2^20. +-1 error is absorbed
  # by decfinA (it recounts digits and rounds to 70 either way).
  var decexp = LLVM::signed_div(a: LLVM::mul(a: e_bin, b: 315653_s64), b: 1048576_s64)
  var q = LLVM::sub(a: 76_s64, b: decexp)
  var scaled = x.abs() * f512_pow10(e: q)
  var coeff = uf512_to_u512_round(u: scaled.to_uf())
  # decfinA may itself clamp an out-of-range magnitude to inf; decimalfixed_check! turns
  # that into NumericOverflowError (and is a no-op for an in-range finite result).
  var __dchk0 = decimalfixed_of_parts(p: decfinA(sign: sign, coeff: coeff, exp: LLVM::sub(a: 0_s64, b: q), pref: LLVM::sub(a: 0_s64, b: q)))
  var __dp0 = __dchk0.decode()
  if LLVM::int_eq(a: __dp0.special, b: 1_u64)
    throw NumericOverflowError(description: "overflow: out of range")
  if LLVM::unsigned_ge(a: __dp0.special, b: 2_u64)
    throw NumericDomainError(description: "domain error: no real result")
  if LLVM::int_eq[U256](a: __dp0.coeff, b: 0)
    return decimalfixed_of_parts(p: DecimalParts(sign: false, special: 0_u64, exp: __dp0.exp, coeff: LLVM::zero_extend[U64, U256](0_u64)))
  return __dchk0

# ============================================================================
# Correctly-rounded F512 exp — the "proper" core: k*ln2 range reduction + the
# degree-44 Remez minimax poly (err 2^-299 ~ 90 digits, >> D256's 70) via
# FMA-Horner, scale by 2^k. This is the template the rest of the suite should
# follow (each function needs its own range reduction + Remez poly).
# ============================================================================

### Small-integer F512 constant via the engine (for range-reduction thresholds).
routine f512_intval(n: S64) -> F512
  return UnpackedFloat[U512, U1024, 512].from_s64(src: n).to_f512a()

### Natural log of 2 as F512 (engine constant, full 510-bit at W=512).
routine f512_ln2() -> F512
  return UnpackedFloat[U512, U1024, 512].ln2().to_f512a()

### Natural log of 10 as F512 (engine constant; scales log -> log10).
routine f512_ln10() -> F512
  return UnpackedFloat[U512, U1024, 512].ln10().to_f512a()

### 1/ln2 as F512 (engine constant; scales log -> log2, multiply avoids a divide).
routine f512_recip_ln2() -> F512
  return UnpackedFloat[U512, U1024, 512].recip_ln2().to_f512a()

### 1/ln10 as F512 (engine constant; scales log -> log10, multiply avoids a divide).
routine f512_recip_ln10() -> F512
  return UnpackedFloat[U512, U1024, 512].recip_ln10().to_f512a()

### Correctly-rounded-to-D256 binary512 exp. Specials per IEEE/C99; F512 overflow
### (x > ln(maxfinite) ~ 2.907e6) -> +inf, underflow (x < ln(min_subnormal) ~ -2.908e6)
### -> +0. Thresholds also keep `k` and the F512 exponent inside range.
routine f512_exp_cr(x: F512) -> F512
  if x.is_nan()
    return F512.from_bits(bits: f512a_qnan())
  if x.is_infinite()
    if x.is_negative()
      return F512.from_bits(bits: LLVM::zero_extend[U64, U512](0_u64))
    return F512.from_bits(bits: f512a_inf(sign: 0_u64))
  if x > f512_intval(n: 2907271_s64)
    return F512.from_bits(bits: f512a_inf(sign: 0_u64))
  if x < f512_intval(n: -2907609_s64)
    return F512.from_bits(bits: LLVM::zero_extend[U64, U512](0_u64))
  var kf = (x * expc512_invln2()).round()
  var k = kf.to_uf().to_s64()
  var r = x - kf * expc512_ln2()
  var p = expc512_poly(r: r)
  return p.to_uf().ldexp(e: k).to_f512a()

# ============================================================================
# Correctly-rounded-to-D256 binary512 atan — the second "proper" core (mirrors
# f512_exp_cr). Range reduction: odd symmetry -> x>=0; x>1 -> pi/2 - atan(1/x)
# folds to [0,1]; additive table k=round(32x), c=k/32, u=(x-c)/(1+x*c) shrinks
# |u| to <=1/64; atan(u)=u*H(u^2) with H the even degree-23 Remez minimax
# (atanc512_poly, err 2^-340). Constants baked as F512 patterns in F512Atan.rf.
# ============================================================================

### Correctly-rounded-to-D256 binary512 atan. Specials per C99: atan(NaN)=NaN,
### atan(+-inf)=+-pi/2, atan(+-0)=+-0 (signed zero preserved).
routine f512_atan_cr(x: F512) -> F512
  if x.is_nan()
    return F512.from_bits(bits: f512a_qnan())
  if x.is_infinite()
    if x.is_negative()
      return atanc512_halfpi().neg()
    return atanc512_halfpi()
  if x.is_zero()
    return x
  var neg = x.is_negative()
  var ax = x.abs()
  var one = f512a_one()
  var invert = ax > one
  if invert
    ax = one / ax
  var kf = (ax * f512_intval(n: 32_s64)).round()
  var k = kf.to_uf().to_s64()
  if LLVM::signed_gt(a: k, b: 32_s64)
    k = 32_s64
  var c = kf / f512_intval(n: 32_s64)
  var u = (ax - c) / (one + ax * c)
  var r = atanc512_tab(k: k) + u * atanc512_poly(w: u * u)
  if invert
    r = atanc512_halfpi() - r
  if neg
    return r.neg()
  return r

### Correctly-rounded-to-D256 binary512 asin, composed on the atan core:
### asin(x) = atan(x / sqrt(1 - x^2)). Sign rides through atan (odd); domain
### |x|<=1, with |x|==1 -> +-pi/2 exact and |x|>1 -> NaN.
routine f512_asin_cr(x: F512) -> F512
  if x.is_nan()
    return F512.from_bits(bits: f512a_qnan())
  var one = f512a_one()
  var ax = x.abs()
  if ax > one
    return F512.from_bits(bits: f512a_qnan())
  if ax == one
    if x.is_negative()
      return atanc512_halfpi().neg()
    return atanc512_halfpi()
  var t = x / (one - x * x).sqrt()
  return f512_atan_cr(x: t)

### Correctly-rounded-to-D256 binary512 acos, half-angle form on the atan core:
### acos(x) = 2*atan(sqrt((1-x)/(1+x))) — covers [0,pi] with no pi/2-asin
### cancellation. acos(1)=+0, acos(-1)=pi exact; |x|>1 -> NaN.
routine f512_acos_cr(x: F512) -> F512
  if x.is_nan()
    return F512.from_bits(bits: f512a_qnan())
  var one = f512a_one()
  var ax = x.abs()
  if ax > one
    return F512.from_bits(bits: f512a_qnan())
  if ax == one
    if x.is_negative()
      return f512_intval(n: 2_s64) * atanc512_halfpi()
    return F512.from_bits(bits: LLVM::zero_extend[U64, U512](0_u64))
  var t = ((one - x) / (one + x)).sqrt()
  return f512_intval(n: 2_s64) * f512_atan_cr(x: t)

### Correctly-rounded-to-D256 binary512 atan2(y, x), built on the atan core with
### C99 quadrant/sign rules. x>0: atan(y/x); x<0: atan(y/x) +- pi by sign(y);
### x=0: +-pi/2; infinities -> +-pi/4, +-3pi/4, +-pi/2, +-pi, +-0 per sign(y).
routine f512_atan2_cr(y: F512, x: F512) -> F512
  if y.is_nan() or x.is_nan()
    return F512.from_bits(bits: f512a_qnan())
  var hp = atanc512_halfpi()
  var pi = f512_intval(n: 2_s64) * hp
  var zero = f512_intval(n: 0_s64)
  if x.is_infinite()
    if y.is_infinite()
      var qp = hp / f512_intval(n: 2_s64)
      var base = if x.is_negative() then f512_intval(n: 3_s64) * qp else qp
      return base.copysign(sign: y)
    if x.is_negative()
      return pi.copysign(sign: y)
    return zero.copysign(sign: y)
  if y.is_infinite()
    return hp.copysign(sign: y)
  if x.is_zero()
    if y.is_zero()
      if x.is_negative()
        return pi.copysign(sign: y)
      return y
    return hp.copysign(sign: y)
  var r = f512_atan_cr(x: y / x)
  if x.is_negative()
    return r + pi.copysign(sign: y)
  return r

# ============================================================================
# Transcendentals — decode to F512, run the F512 core, round back to Decimal.
# (Mirrors the F512 surface one-for-one.)
# ============================================================================

### e raised to this value. Uses the range-reduced Remez core (f512_exp_cr).
routine Decimal.exp() -> Decimal
  return f512_to_decimala(x: f512_exp_cr(x: decimalfixed_to_f512(x: me)))

### Natural logarithm. Crashes with NumericDomainError if me < 0, NumericOverflowError if me = 0.
routine Decimal.log!() -> Decimal
  if me.signbit()
    throw NumericDomainError(description: "domain error: no real result")
  if me.is_zero()
    throw NumericOverflowError(description: "overflow: out of range")
  return f512_to_decimala(x: decimalfixed_to_f512(x: me).log())

### exp(me) - 1. Engine expm1 core — cancellation-free near 0 (NOT exp(me)-1).
routine Decimal.expm1() -> Decimal
  return f512_to_decimala(x: decimalfixed_to_f512(x: me).expm1())

### log(1 + me). Engine log1p core — cancellation-free near 0. Crashes if me <= -1.
routine Decimal.log1p!() -> Decimal
  var y = me + Decimal(from: 1_s64)
  if y.signbit()
    throw NumericDomainError(description: "domain error: no real result")
  if y.is_zero()
    throw NumericOverflowError(description: "overflow: out of range")
  return f512_to_decimala(x: decimalfixed_to_f512(x: me).log1p())

### Base-2 logarithm. Crashes with NumericDomainError if me < 0, NumericOverflowError if me = 0.
routine Decimal.log2!() -> Decimal
  if me.signbit()
    throw NumericDomainError(description: "domain error: no real result")
  if me.is_zero()
    throw NumericOverflowError(description: "overflow: out of range")
  return f512_to_decimala(x: decimalfixed_to_f512(x: me).log() * f512_recip_ln2())

### Base-10 logarithm. Crashes with NumericDomainError if me < 0, NumericOverflowError if me = 0.
routine Decimal.log10!() -> Decimal
  if me.signbit()
    throw NumericDomainError(description: "domain error: no real result")
  if me.is_zero()
    throw NumericOverflowError(description: "overflow: out of range")
  return f512_to_decimala(x: decimalfixed_to_f512(x: me).log() * f512_recip_ln10())

### 2 raised to this value: exp(me * ln2) via the Remez core.
routine Decimal.exp2() -> Decimal
  return f512_to_decimala(x: f512_exp_cr(x: decimalfixed_to_f512(x: me) * f512_ln2()))

### 10 raised to this value: exp(me * ln10) via the Remez core.
routine Decimal.exp10() -> Decimal
  return f512_to_decimala(x: f512_exp_cr(x: decimalfixed_to_f512(x: me) * f512_ln10()))

### me raised to the power `you`: exp(you * log(me)) via the Remez core.
### Crashes with NumericDomainError if me <= 0, NumericOverflowError on overflow.
routine Decimal.pow!(you: Decimal) -> Decimal
  if me.signbit() or me.is_zero()
    throw NumericDomainError(description: "domain error: no real result")
  return f512_to_decimala(x: f512_exp_cr(x: decimalfixed_to_f512(x: you) * decimalfixed_to_f512(x: me).log()))

### Square root (correctly rounded). Crashes with NumericDomainError if me < 0.
routine Decimal.sqrt!() -> Decimal
  if me.signbit()
    throw NumericDomainError(description: "domain error: no real result")
  return f512_to_decimala(x: decimalfixed_to_f512(x: me).sqrt())

### Cube root.
routine Decimal.cbrt() -> Decimal
  return f512_to_decimala(x: decimalfixed_to_f512(x: me).cbrt())

### Hypotenuse sqrt(me^2 + you^2).
routine Decimal.hypot(you: Decimal) -> Decimal
  return f512_to_decimala(x: decimalfixed_to_f512(x: me).hypot(you: decimalfixed_to_f512(x: you)))

### Fused multiply-add me*b + c.
routine Decimal.fma(b: Decimal, c: Decimal) -> Decimal
  return f512_to_decimala(x: decimalfixed_to_f512(x: me).fma(b: decimalfixed_to_f512(x: b), c: decimalfixed_to_f512(x: c)))

### Sine.
routine Decimal.sin() -> Decimal
  return f512_to_decimala(x: decimalfixed_to_f512(x: me).sin())

### Cosine.
routine Decimal.cos() -> Decimal
  return f512_to_decimala(x: decimalfixed_to_f512(x: me).cos())

### Tangent.
routine Decimal.tan() -> Decimal
  return f512_to_decimala(x: decimalfixed_to_f512(x: me).tan())

### Arcsine. Crashes with NumericDomainError if |me| > 1.
routine Decimal.asin!() -> Decimal
  var x = decimalfixed_to_f512(x: me)
  if x.abs() > f512a_one()
    throw NumericDomainError(description: "domain error: no real result")
  return f512_to_decimala(x: f512_asin_cr(x: x))

### Arccosine. Crashes with NumericDomainError if |me| > 1.
routine Decimal.acos!() -> Decimal
  var x = decimalfixed_to_f512(x: me)
  if x.abs() > f512a_one()
    throw NumericDomainError(description: "domain error: no real result")
  return f512_to_decimala(x: f512_acos_cr(x: x))

### Arctangent. Uses the dedicated range-reduced Remez core (f512_atan_cr).
routine Decimal.atan() -> Decimal
  return f512_to_decimala(x: f512_atan_cr(x: decimalfixed_to_f512(x: me)))

### Two-argument arctangent atan2(me, x). Dedicated atan-core + C99 quadrant rules.
routine Decimal.atan2(x: Decimal) -> Decimal
  return f512_to_decimala(x: f512_atan2_cr(y: decimalfixed_to_f512(x: me), x: decimalfixed_to_f512(x: x)))

### Hyperbolic sine. Engine sinh core (built on cancellation-free expm1).
routine Decimal.sinh() -> Decimal
  return f512_to_decimala(x: decimalfixed_to_f512(x: me).sinh())

### Hyperbolic cosine. Engine cosh core.
routine Decimal.cosh() -> Decimal
  return f512_to_decimala(x: decimalfixed_to_f512(x: me).cosh())

### Hyperbolic tangent. Engine tanh core (built on cancellation-free expm1).
routine Decimal.tanh() -> Decimal
  return f512_to_decimala(x: decimalfixed_to_f512(x: me).tanh())

### Inverse hyperbolic sine. Engine asinh core (log1p-based near 0).
routine Decimal.asinh() -> Decimal
  return f512_to_decimala(x: decimalfixed_to_f512(x: me).asinh())

### Inverse hyperbolic cosine. Crashes with NumericDomainError if me < 1.
routine Decimal.acosh!() -> Decimal
  var x = decimalfixed_to_f512(x: me)
  if x < f512a_one()
    throw NumericDomainError(description: "domain error: no real result")
  return f512_to_decimala(x: x.acosh())

### Inverse hyperbolic tangent. Crashes with NumericDomainError if |me| > 1, NumericOverflowError if
### |me| = 1.
routine Decimal.atanh!() -> Decimal
  var x = decimalfixed_to_f512(x: me)
  var ax = x.abs()
  if ax > f512a_one()
    throw NumericDomainError(description: "domain error: no real result")
  if ax == f512a_one()
    throw NumericOverflowError(description: "overflow: out of range")
  return f512_to_decimala(x: x.atanh())

# ============================================================================
# erf / erfc — the generic N=120 continued-fraction cores (erf_cf/erfc_cf) run
# at W=512. The CF math error is 2^-402 and the inner exp(n:22) matches the
# 70-digit regime of F512.exp(n:20), so these are correctly-rounded to D256.
# Threshold |x| = 3.1 splits erf-CF (small |x|) from erfc-CF (large |x|), per
# the F128 surface.
# ============================================================================

### Error function erf(x). Specials: erf(NaN)=NaN, erf(+-inf)=+-1.
routine f512_erf_cr(x: F512) -> F512
  if x.is_nan()
    return F512.from_bits(bits: f512a_qnan())
  if x.is_infinite()
    if x.is_negative()
      return f512_intval(n: -1_s64)
    return f512_intval(n: 1_s64)
  var thr = f512_intval(n: 31_s64) / f512_intval(n: 10_s64)
  var a = x.to_uf()
  if x < thr.neg()
    return UnpackedFloat[U512, U1024, 512].from_s64(src: -1_s64).sub(you: a.erfc_cf(levels: 120_s64)).to_f512a()
  if x < thr
    return a.erf_cf(levels: 120_s64).to_f512a()
  return UnpackedFloat[U512, U1024, 512].from_s64(src: 1_s64).sub(you: a.erfc_cf(levels: 120_s64)).to_f512a()

### Complementary error function erfc(x)=1-erf(x). Specials: erfc(NaN)=NaN,
### erfc(-inf)=2, erfc(+inf)=0.
routine f512_erfc_cr(x: F512) -> F512
  if x.is_nan()
    return F512.from_bits(bits: f512a_qnan())
  if x.is_infinite()
    if x.is_negative()
      return f512_intval(n: 2_s64)
    return f512_intval(n: 0_s64)
  var thr = f512_intval(n: 31_s64) / f512_intval(n: 10_s64)
  var a = x.to_uf()
  if x < thr.neg()
    return UnpackedFloat[U512, U1024, 512].from_s64(src: 2_s64).add(you: a.erfc_cf(levels: 120_s64)).to_f512a()
  if x < thr
    return UnpackedFloat[U512, U1024, 512].from_s64(src: 1_s64).sub(you: a.erf_cf(levels: 120_s64)).to_f512a()
  return a.erfc_cf(levels: 120_s64).to_f512a()

### Error function.
routine Decimal.erf() -> Decimal
  return f512_to_decimala(x: f512_erf_cr(x: decimalfixed_to_f512(x: me)))

### Complementary error function.
routine Decimal.erfc() -> Decimal
  return f512_to_decimala(x: f512_erfc_cr(x: decimalfixed_to_f512(x: me)))

# ============================================================================
# tgamma / lgamma — dedicated F512 Stirling core (mirrors the octuple
# lgamma_core but with the wider gamma512_coef table, augmentation threshold 32
# and O=80 terms -> ~2^-280, plus the W=512 sin(n:26)/log(n:23) counts). The
# octuple core (T=20, O=35) only reaches ~2^-164, short of D256's 70 digits.
# ============================================================================

### lgamma core (TLFloat-style): returns (sign of gamma, log|gamma(z)|) at W=512.
routine f512_lgamma_core(z: UnpackedFloat[U512, U1024, 512]) -> UFSign[U512, U1024, 512]
  var one = UnpackedFloat[U512, U1024, 512].from_s64(src: 1_s64)
  var p5 = one.ldexp(e: -1_s64)
  # reflection formula for z < -1: lgamma(z) derived from lgamma(1-z) via Euler reflection (below)
  var reflect = z.lt(you: one.neg())
  var a = if reflect then one.sub(you: z) else z
  # split a into integer part (inv) + fractional remainder (fr); argument-augment small a up to 32
  var inv = a.rint()
  var fr = a.sub(you: inv)
  var w = UnpackedFloat[U512, U1024, 512].from_s64(src: 1_s64)
  var thr = UnpackedFloat[U512, U1024, 512].from_s64(src: 32_s64)
  if inv.lt(you: thr)
    # recurrence gamma(a)=gamma(a+n)/(a(a+1)...(a+n-1)): w accumulates the denominator product
    var ii = inv.to_s64()
    while LLVM::signed_lt(a: ii, b: 32_s64)
      w = w.mul(you: UnpackedFloat[U512, U1024, 512].from_s64(src: ii).add(you: fr))
      ii = LLVM::add(a: ii, b: 1_s64)
    a = thr.add(you: fr)
  # Stirling asymptotic series in 1/a^2 evaluated by Horner over the 80-term gamma512_coef table
  var inv_aa = one.div(you: a.mul(you: a))
  var y = gamma512_coef(i: 79_s64).to_uf()
  var i = 78_s64
  while LLVM::signed_ge(a: i, b: 0_s64)
    y = y.fma(b: inv_aa, c: gamma512_coef(i: i).to_uf())
    i = LLVM::sub(a: i, b: 1_s64)
  # Stirling main term: log|gamma(a)| ~ series/a + (a-1/2)ln a - a + (1/2)ln(2pi)
  var loga = a.log(n: 23_s64, m: 0_s64, t: 0_s64)
  y = y.div(you: a).add(you: a.sub(you: p5).mul(you: loga)).sub(you: a).add(you: p5.mul(you: UnpackedFloat[U512, U1024, 512].ln_2pi()))
  # subtract log of the augmentation product to undo the recurrence shift
  y = y.sub(you: w.abs().log(n: 23_s64, m: 0_s64, t: 0_s64))
  var sign = w.sign()
  if reflect
    # Euler reflection: ln|gamma(z)| = ln(pi) - ln|sin(pi*fr)| - ln|gamma(1-z)|; sign from sin &
    # parity
    var s = UnpackedFloat[U512, U1024, 512].pi().mul(you: fr).sin(n: 26_s64)
    y = UnpackedFloat[U512, U1024, 512].ln_pi().sub(you: s.abs().log(n: 23_s64, m: 0_s64, t: 0_s64)).sub(you: y)
    sign = (sign).xor(you: s.sign())
    sign = sign == inv.iseven()
  return UFSign[U512, U1024, 512](item0: sign, item1: y)

### Gamma function. tgamma(NaN)=NaN, tgamma(+inf)=+inf, tgamma(-inf)=NaN,
### tgamma(+-0)=+-inf, tgamma(negative integer)=NaN.
routine f512_tgamma_cr(x: F512) -> F512
  if x.is_nan()
    return F512.from_bits(bits: f512a_qnan())
  if x.is_infinite()
    if x.is_negative()
      return F512.from_bits(bits: f512a_qnan())
    return x
  if x.is_zero()
    var sg = 0_u64
    if x.is_negative()
      sg = 1_u64
    return F512.from_bits(bits: f512a_inf(sign: sg))
  var zu = x.to_uf()
  if x.is_negative() and zu.isint()
    return F512.from_bits(bits: f512a_qnan())
  var p = f512_lgamma_core(z: zu)
  var r = p.item1.exp(n: 20_s64)
  if p.item0
    r = r.neg()
  return r.to_f512a()

### Log-gamma ln|gamma(x)|. lgamma(NaN)=NaN; lgamma(0)=lgamma(+-inf)=
### lgamma(negative integer)=+inf.
routine f512_lgamma_cr(x: F512) -> F512
  if x.is_nan()
    return F512.from_bits(bits: f512a_qnan())
  if x.is_zero() or x.is_infinite()
    return F512.from_bits(bits: f512a_inf(sign: 0_u64))
  var zu = x.to_uf()
  if x.is_negative() and zu.isint()
    return F512.from_bits(bits: f512a_inf(sign: 0_u64))
  var p = f512_lgamma_core(z: zu)
  return p.item1.to_f512a()

### Gamma function. Crashes with NumericDomainError if me is a non-positive integer,
### NumericOverflowError on overflow.
routine Decimal.tgamma!() -> Decimal
  var r = f512_tgamma_cr(x: decimalfixed_to_f512(x: me))
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  if r.is_infinite()
    throw NumericOverflowError(description: "overflow: out of range")
  return f512_to_decimala(x: r)

### Natural log of the absolute value of gamma. Crashes with NumericOverflowError at poles (me = 0
### or negative integer).
routine Decimal.lgamma!() -> Decimal
  var r = f512_lgamma_cr(x: decimalfixed_to_f512(x: me))
  if r.is_infinite()
    throw NumericOverflowError(description: "overflow: out of range")
  return f512_to_decimala(x: r)

# ============================================================================
# libm manipulation / classification — decimal-native on DecimalParts (value =
# (-1)^sign * coeff * 10^exp). No binary round-trip: exact for the decimal type.
# fmod/remainder/remquo (exact coefficient long-division) and the binary-exponent
# ops (ldexp/frexp/logb/ilogb) are intentionally omitted; `scaleb` (x*10^n) is the
# decimal-native analog provided instead.
# ============================================================================

### Sign bit (true when negative, including -0, -inf, -NaN).
routine Decimal.signbit() -> Bool
  return me.decode().sign

### True for a finite non-zero value (decimal has no binary subnormals).
routine Decimal.is_normal() -> Bool
  var p = me.decode()
  return LLVM::int_eq[U64](a: p.special, b: 0_u64) and LLVM::int_ne[U256](a: p.coeff, b: 0)

### True for +-0.
routine Decimal.is_zero() -> Bool
  var p = me.decode()
  return LLVM::int_eq[U64](a: p.special, b: 0_u64) and LLVM::int_eq[U256](a: p.coeff, b: 0)

### True if me is signed (negative; -0 is signed). Mirrors the D128 surface.
routine Decimal.is_negative() -> Bool
  return me.decode().sign

### True if me is strictly positive (not signed, not zero, not NaN).
routine Decimal.is_positive() -> Bool
  var p = me.decode()
  return not p.sign and LLVM::int_eq[U64](a: p.special, b: 0_u64) and LLVM::int_ne[U256](a: p.coeff, b: 0)

### Returns -1, 0, or +1 matching the sign of me (NaN -> NaN, +-0 -> +0).
routine Decimal.signum() -> Decimal
  if me.is_nan()
    return Decimal.quiet_nan()
  if me.is_zero()
    return decimalfixed_of_parts(p: DecimalParts(sign: false, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U256](0_u64)))
  return if me.decode().sign then Decimal(from: -1_s64) else Decimal(from: 1_s64)

### libm fpclassify code: 0 NaN, 1 infinite, 2 zero, 4 normal (3 subnormal unused).
routine Decimal.fpclassify() -> FpClass
  var p = me.decode()
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return NAN
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return INFINITE
  if LLVM::int_eq[U256](a: p.coeff, b: 0)
    return ZERO
  return NORMAL

### Absolute value (clears the sign, including on NaN/inf).
routine Decimal.abs() -> Decimal
  var p = me.decode()
  return decimalfixed_of_parts(p: DecimalParts(sign: false, special: p.special, exp: p.exp, coeff: p.coeff))

### Negation (flips the sign, including on NaN/inf/zero).
routine Decimal.neg() -> Decimal
  var p = me.decode()
  return decimalfixed_of_parts(p: DecimalParts(sign: not p.sign, special: p.special, exp: p.exp, coeff: p.coeff))

### Magnitude of me with the sign of `you`.
routine Decimal.copysign(you: Decimal) -> Decimal
  var p = me.decode()
  return decimalfixed_of_parts(p: DecimalParts(sign: you.decode().sign, special: p.special, exp: p.exp, coeff: p.coeff))

### Larger of me and you (NaN-skipping, per C99 fmax).
routine Decimal.fmax(you: Decimal) -> Decimal
  if me.is_nan()
    return you
  if you.is_nan()
    return me
  if (me - you).decode().sign
    return you
  return me

### Smaller of me and you (NaN-skipping, per C99 fmin).
routine Decimal.fmin(you: Decimal) -> Decimal
  if me.is_nan()
    return you
  if you.is_nan()
    return me
  if (me - you).decode().sign
    return me
  return you

### Positive difference max(me - you, 0); NaN if either is NaN.
routine Decimal.fdim(you: Decimal) -> Decimal
  if me.is_nan() or you.is_nan()
    return Decimal.quiet_nan()
  var d = me - you
  if d.decode().sign
    return decimalfixed_of_parts(p: DecimalParts(sign: false, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U256](0_u64)))
  return d

### Scale by a power of ten: me * 10^n (the decimal analog of ldexp). Routes through the shared
### `decfinA` encoder so the result obeys the IEEE decimal256 exponent range exactly (quantum
### qmax = Emax-(p-1) = 1572795; above it the coefficient is padded into the canonical max-q
### cohort). `Decimal` is finite-only, so a true overflow THROWS rather than producing infinity
### — a plain failable `!` (recoverable via `try_scaleb!`), matching `D32`/`D64`/`D128`/`F*`.
### Underflow below the minimum quantum flushes to zero.
### :param n: The power-of-ten exponent to apply.
### :returns: `me` scaled by `10^n`.
### :throws: {NumericOverflowError} when the scaled magnitude exceeds the `Decimal` range.
routine Decimal.scaleb!(n: S64) -> Decimal
  var p = me.decode()
  if LLVM::int_ne[U64](a: p.special, b: 0_u64) or LLVM::int_eq[U256](a: p.coeff, b: 0)
    return me
  var ne = LLVM::add(a: p.exp, b: n)
  if LLVM::signed_lt(a: ne, b: -1572932_s64)
    return decimalfixed_of_parts(p: DecimalParts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U256](0_u64)))
  var scaled = decimalfixed_of_parts(p: decfinA(sign: p.sign, coeff: LLVM::zero_extend[U256, U512](p.coeff), exp: ne, pref: ne))
  if LLVM::int_eq(a: scaled.decode().special, b: 1_u64)
    throw NumericOverflowError(description: "overflow: out of range")
  return scaled

### Rounds me to an integral value. mode: 0 trunc, 1 floor, 2 ceil, 3 round
### (half away from zero), 4 rint (half to even). Decimal-native, exact.
routine decimalfixed_round_int(x: Decimal, mode: S64) -> Decimal
  var p = x.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64)
    return x
  if LLVM::int_eq[U256](a: p.coeff, b: 0)
    return x
  if LLVM::signed_ge(a: p.exp, b: 0_s64)
    return x
  var ndrop = LLVM::sub(a: 0_s64, b: p.exp)
  var q = LLVM::zero_extend[U64, U256](0_u64)
  var rnz = true
  var half = false
  var gthalf = false
  if LLVM::signed_le(a: ndrop, b: 70_s64)
    var divp = pow10b(k: ndrop)
    q = div_pow10b(x: p.coeff, k: ndrop)
    var r = LLVM::sub(a: p.coeff, b: LLVM::mul(a: q, b: divp))
    rnz = LLVM::int_ne[U256](a: r, b: 0)
    var twice = LLVM::mul(a: r, b: LLVM::zero_extend[U64, U256](2_u64))
    half = LLVM::int_eq(a: twice, b: divp)
    gthalf = LLVM::unsigned_gt(a: twice, b: divp)
  var inc = false
  if LLVM::int_eq(a: mode, b: 1_s64)
    inc = p.sign and rnz
  elseif LLVM::int_eq(a: mode, b: 2_s64)
    inc = (not p.sign) and rnz
  elseif LLVM::int_eq(a: mode, b: 3_s64)
    inc = gthalf or half
  elseif LLVM::int_eq(a: mode, b: 4_s64)
    if gthalf
      inc = true
    elseif half
      inc = LLVM::int_ne(a: LLVM::bit_and(a: q, b: LLVM::zero_extend[U64, U256](1_u64)), b: LLVM::zero_extend[U64, U256](0_u64))
  var qq = q
  if inc
    qq = LLVM::add(a: q, b: LLVM::zero_extend[U64, U256](1_u64))
  return decimalfixed_of_parts(p: DecimalParts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: qq))

### Truncate toward zero.
routine Decimal.trunc() -> Decimal
  return decimalfixed_round_int(x: me, mode: 0_s64)

### Round toward -inf.
routine Decimal.floor() -> Decimal
  return decimalfixed_round_int(x: me, mode: 1_s64)

### Round toward +inf.
routine Decimal.ceil() -> Decimal
  return decimalfixed_round_int(x: me, mode: 2_s64)

### Round to nearest, ties away from zero.
routine Decimal.round() -> Decimal
  return decimalfixed_round_int(x: me, mode: 3_s64)

### Round to nearest, ties to even (nearbyint/rint).
routine Decimal.rint() -> Decimal
  return decimalfixed_round_int(x: me, mode: 4_s64)

### Fractional part me - trunc(me) (same sign as me); modf int part = trunc(me).
routine Decimal.frac() -> Decimal
  if me.is_nan()
    return me
  var p = me.decode()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return decimalfixed_of_parts(p: DecimalParts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U256](0_u64)))
  return me - me.trunc()

# ============================================================================
# IEEE 754 surface — predicates, total ordering, selection, quantum operations.
# Mirrors the D32/D64/D128 API for `Decimal`, adapted to its 70-digit format
# (Pmax=70, minimum quantum exponent -1572932). `Decimal` is finite-only, so the
# operations that would otherwise produce inf/NaN (logb of zero, a quantize that
# needs > 70 digits) are FAILABLE and throw, matching the rest of the type.
# ============================================================================

### True if me is a finite, nonzero subnormal: quantum exponent at the minimum
### (-1572932) with a coefficient below 10^69 (fewer than the full 70 significant
### digits). `Decimal` has no binary subnormals; this is the decimal-cohort sense.
### :returns: Whether `me` is a subnormal value.
routine Decimal.is_subnormal() -> Bool
  var p = me.decode()
  if LLVM::int_ne[U64](a: p.special, b: 0_u64) or LLVM::int_eq[U256](a: p.coeff, b: 0)
    return false
  return LLVM::int_eq(a: p.exp, b: -1572932_s64) and LLVM::unsigned_lt(a: p.coeff, b: pow10b(k: 69_s64))

### Splits into integer and fractional parts (C modf); both carry me's sign.
### :returns: A tuple `(integer_part, fractional_part)`.
routine Decimal.modf() -> (Decimal, Decimal)
  if me.is_nan()
    return (me, me)
  var p = me.decode()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return (me, decimalfixed_of_parts(p: DecimalParts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U256](0_u64))))
  var ip = me.trunc()
  return (ip, me - ip)

### IEEE 754 totalOrder for decimals: a total order over all values including signed
### zeros and cohorts (equal value with differing exponents). For finite operands of
### equal value the smaller-exponent member precedes when positive (reversed when
### negative). Reuses the shared `decimal_order_band` for the defensive special path.
### :param you: The value to compare against.
### :returns: Whether `me` precedes or equals `you` in the total order.
routine Decimal.total_order(you: Decimal) -> Bool
  var pa = me.decode()
  var pb = you.decode()
  if LLVM::unsigned_ge(a: pa.special, b: 2_u64) or LLVM::unsigned_ge(a: pb.special, b: 2_u64)
    return decimal_order_band(sign: pa.sign, special: pa.special) <= decimal_order_band(sign: pb.sign, special: pb.special)
  var c = me.cmp(you: you)
  if c isnot SAME
    return c is ME_SMALL
  if pa.sign != pb.sign
    return pa.sign
  if pa.sign
    return LLVM::signed_ge(a: pa.exp, b: pb.exp)
  return LLVM::signed_le(a: pa.exp, b: pb.exp)

### IEEE 754 totalOrderMag for decimals: `total_order` applied to the magnitudes.
### :param you: The value whose magnitude to compare against.
### :returns: Whether `|me|` precedes or equals `|you|` in the total order.
routine Decimal.total_order_mag(you: Decimal) -> Bool
  return me.abs().total_order(you: you.abs())

### IEEE 754 logb: the base-10 exponent `e` with `10^e <= |me| < 10^(e+1)`, as a decimal
### integer. `Decimal` is finite-only, so logb(0) (which is -inf in IEEE) throws instead.
### :returns: The radix-10 exponent of `me`.
### :throws: {NumericDomainError} when `me` is zero (no finite exponent).
routine Decimal.logb!() -> Decimal
  var p = me.decode()
  if LLVM::int_eq[U256](a: p.coeff, b: 0)
    throw NumericDomainError(description: "domain error: no real result")
  return Decimal(from: LLVM::add(a: p.exp, b: LLVM::sub(a: digits10a(c: LLVM::zero_extend[U256, U512](p.coeff)), b: 1_s64)))

### IEEE 754-2008 minNum: the smaller operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, ignoring NaN.
routine Decimal.min_num(you: Decimal) -> Decimal
  return me.fmin(you: you)

### IEEE 754-2008 maxNum: the larger operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, ignoring NaN.
routine Decimal.max_num(you: Decimal) -> Decimal
  return me.fmax(you: you)

### IEEE 754-2019 minimum: the smaller operand, ordering -0 below +0.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`.
routine Decimal.minimum(you: Decimal) -> Decimal
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  var c = me.cmp(you: you)
  if c is ME_SMALL
    return me
  if c is ME_LARGE
    return you
  if me.is_zero()
    return if me.signbit() then me else you
  return me

### IEEE 754-2019 maximum: the larger operand, ordering +0 above -0.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`.
routine Decimal.maximum(you: Decimal) -> Decimal
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  var c = me.cmp(you: you)
  if c is ME_LARGE
    return me
  if c is ME_SMALL
    return you
  if me.is_zero()
    return if me.signbit() then you else me
  return me

### IEEE 754 roundToIntegralTiesToAway: rounds to nearest integer, halves away from zero
### (alias of `round`). Never crashes.
### :returns: `me` rounded to an integral value with ties away from zero.
routine Decimal.round_ties_away() -> Decimal
  return me.round()

### IEEE 754 sameQuantum: `true` when `me` and `other` share the same exponent (quantum).
### :param other: The value whose quantum to compare against.
### :returns: Whether the two share a quantum.
routine Decimal.same_quantum(other: Decimal) -> Bool
  var pa = me.decode()
  var pb = other.decode()
  if LLVM::unsigned_ge(a: pa.special, b: 2_u64) or LLVM::unsigned_ge(a: pb.special, b: 2_u64)
    return LLVM::unsigned_ge(a: pa.special, b: 2_u64) and LLVM::unsigned_ge(a: pb.special, b: 2_u64)
  if LLVM::int_eq(a: pa.special, b: 1_u64) or LLVM::int_eq(a: pb.special, b: 1_u64)
    return LLVM::int_eq(a: pa.special, b: 1_u64) and LLVM::int_eq(a: pb.special, b: 1_u64)
  return LLVM::int_eq(a: pa.exp, b: pb.exp)

### IEEE 754 quantize: returns `me`'s value re-expressed with the exponent of `other`
### (rounding half-even when digits are dropped). The canonical money-formatting /
### fixed-scale operation. Throws when the result would need more than 70 significand
### digits (which IEEE represents as NaN, but `Decimal` is finite-only).
### :param other: The value supplying the target exponent.
### :returns: `me` quantized to `other`'s exponent.
### :throws: {NumericOverflowError} when the result needs more than 70 digits.
routine Decimal.quantize!(other: Decimal) -> Decimal
  var pa = me.decode()
  var target = other.decode().exp
  if LLVM::int_eq(a: pa.exp, b: target)
    return me
  if LLVM::signed_gt(a: pa.exp, b: target)
    # Scale the coefficient UP by 10^(pa.exp - target); exact, but throws if it needs > 70 digits.
    var shift = LLVM::sub(a: pa.exp, b: target)
    if LLVM::int_ne[U256](a: pa.coeff, b: 0) and LLVM::signed_gt[S64](a: LLVM::add[S64](a: digits10a(c: LLVM::zero_extend[U256, U512](pa.coeff)), b: shift), b: 70_s64)
      throw NumericOverflowError(description: "overflow: out of range")
    var scaled = LLVM::mul(a: pa.coeff, b: pow10b(k: shift))
    return decimalfixed_of_parts(p: DecimalParts(sign: pa.sign, special: 0_u64, exp: target, coeff: scaled))
  # pa.exp < target: drop (target - pa.exp) digits with half-even rounding.
  var drop = LLVM::sub(a: target, b: pa.exp)
  if LLVM::signed_gt(a: drop, b: 70_s64)
    return decimalfixed_of_parts(p: DecimalParts(sign: pa.sign, special: 0_u64, exp: target, coeff: LLVM::zero_extend[U64, U256](0_u64)))
  var divp = pow10b(k: drop)
  var q = div_pow10b(x: pa.coeff, k: drop)
  var r = LLVM::sub(a: pa.coeff, b: LLVM::mul(a: q, b: divp))
  var twice = LLVM::mul(a: r, b: LLVM::zero_extend[U64, U256](2_u64))
  if LLVM::unsigned_gt(a: twice, b: divp)
    q = LLVM::add(a: q, b: LLVM::zero_extend[U64, U256](1_u64))
  elseif LLVM::int_eq(a: twice, b: divp) and LLVM::int_ne(a: LLVM::bit_and(a: q, b: LLVM::zero_extend[U64, U256](1_u64)), b: LLVM::zero_extend[U64, U256](0_u64))
    q = LLVM::add(a: q, b: LLVM::zero_extend[U64, U256](1_u64))
  return decimalfixed_of_parts(p: DecimalParts(sign: pa.sign, special: 0_u64, exp: target, coeff: q))

### IEEE 754 remainder: `me - other * n`, where `n` is the integer nearest `me / other`
### (ties to even). Result satisfies `|r| <= |other| / 2`. Crashes (DivisionByZeroError)
### when `other` is zero, like the rest of `Decimal` division.
### :param other: The divisor.
### :returns: The IEEE remainder of `me / other`.
routine Decimal.remainder(other: Decimal) -> Decimal
  var n = (me / other).rint()
  return me - other * n
