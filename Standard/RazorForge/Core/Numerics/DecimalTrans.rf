module Core

# ============================================================================
# DecimalTrans — decimal256 transcendentals via the W=320 UnpackedFloat engine.
#
# Decimal (Pmax=70 decimal digits, ~233-bit faithful target) has no transcendental
# cores of its own. The W=320 engine (UnpackedFloat[U320,U640,320]) carries a
# 318-bit mantissa (~95 decimal digits) — the tight, validated (>=233 bits vs F512)
# scratch for D256's 233-bit target, replacing the over-wide 512-bit engine (~2x too
# wide). A D256 value decoded into the W=320 engine, run through the (self-sizing
# W==320) transcendental, and rounded back to 70 digits is CORRECTLY ROUNDED: the
# engine error lands near decimal digit ~95, well below the 70-digit boundary.
#
# The generic engine methods (exp/log/sin/cos/tan/atan/...) self-size at W==320 via
# the F128Const W==320 coefficient tables and the F128Math W==320 degree/reduction
# overrides — so the D256 path drives them DIRECTLY (no packed "F320" type; the engine
# UnpackedFloat[U320,U640,320] value is threaded end-to-end), mirroring how D128Trans
# drives its narrower cores.
#
# The two radix adapters are the substance here:
#   decimalfixed_to_f320 (dec->bin): load coeff exactly into the engine, multiply by
#     10^exp computed by binary-exponentiation of 10.0 (no big-int 10^k table).
#   f320_to_decimala (bin->dec): scale |x|*10^(76-decexp) to ~10^77, peek the integer
#     with round-half-even, hand the 77-digit coeff to Decimal's decfinA (rounds to 70).
#
# SUPPORTED RANGE: values whose magnitude keeps 10^(76-decexp) inside the engine's
# range; real transcendental I/O never reaches the extremes. Verified by round-trip +
# cross-checks.
#
# NOTE: the W=320 radix adapter d128parts_to_f320 below is ALSO F128's correctly-rounded
# decimal->binary128 fast path — the 318-bit mantissa (~2^-310 worst-case) clears the
# ~2^-239 decimal->F128 separation with margin, so the packed-F512 engine is no longer
# needed anywhere. The whole W=512 engine (F512 type + f512_* helpers) has been deleted.
# ============================================================================

# ============================================================================
# W=320 radix adapters (D256 transcendental path)
# ============================================================================

### Builds the W=320 engine value of a non-negative U256 integer (exact; coeff <= 233
### bits fits the 318-bit mantissa). value = mant * 2^(exp-317), mant MSB at bit 318 (W-2).
routine uf320_from_u256(c: U256) -> UnpackedFloat[U320, U640, 320]
  if LLVM::int_eq[U256](a: c, b: 0)
    return UnpackedFloat[U320, U640, 320].zero(sign: false)
  var cw = LLVM::zero_extend[U256, U320](c)
  var x = LLVM::sub(a: 320_s64, b: LLVM::int_truncate[U320, S64](LLVM::leading_zeros(cw)))
  var mant = LLVM::shift_left(value: cw, bits: U320.to_width(s: LLVM::sub(a: 319_s64, b: x)))
  return UnpackedFloat[U320, U640, 320].make(mant: mant, exp: LLVM::sub(a: x, b: 2_s64), fpclass: SignedFpClass.from_flags(sign: false, iszero: false, isinf: false, isnan: false))

### Rounds the W=320 engine value (assumed a positive ~integer) to a U512, round-half-even.
### integer = round(mant * 2^(exp-317)); shift = 317 - exp (positive in the ~10^77 range).
### Output is U512 to feed Decimal's decfinA unchanged (a 77-digit coeff is ~256 bits).
routine uf320_to_u512_round(u: UnpackedFloat[U320, U640, 320]) -> U512
  var mantw = LLVM::zero_extend[U320, U512](u.mant)
  var shift = LLVM::sub(a: 317_s64, b: u.exp)
  if LLVM::signed_le(a: shift, b: 0_s64)
    return LLVM::shift_left(value: mantw, bits: U512.to_width(s: LLVM::sub(a: 0_s64, b: shift)))
  if LLVM::signed_ge(a: shift, b: 320_s64)
    return LLVM::zero_extend[U64, U512](0_u64)
  var q = LLVM::shift_right_unsigned(mantw, U512.to_width(s: shift))
  var lost = LLVM::bit_and(a: mantw, b: U512.low_mask(n: shift))
  var half = LLVM::shift_left[U512](value: 1, bits: U512.to_width(s: LLVM::sub[S64](a: shift, b: 1_s64)))
  if LLVM::unsigned_gt(a: lost, b: half)
    q = LLVM::add[U512](a: q, b: 1)
  elseif LLVM::int_eq[U512](a: lost, b: half) and LLVM::int_ne[U512](a: LLVM::bit_and[U512](a: q, b: 1), b: 0)
    q = LLVM::add[U512](a: q, b: 1)
  return q

### 1.0 as the W=320 engine value.
routine uf320_one() -> UnpackedFloat[U320, U640, 320]
  return UnpackedFloat[U320, U640, 320].from_s64(src: 1_s64)

### Small-integer W=320 engine constant (for range-reduction thresholds).
routine uf320_intval(n: S64) -> UnpackedFloat[U320, U640, 320]
  return UnpackedFloat[U320, U640, 320].from_s64(src: n)

### Builds the W=320 engine value of a non-negative U640 EXACT integer with the given sign,
### rounding the (up to 640-bit) integer to the 318-bit significand ONCE (round-half-even).
### Fed the exact `coeff * 10^exp` big integer, returns the correctly-rounded engine value
### (one rounding, versus coeff-load then engine-multiply which rounds twice). MSB of the rounded
### mantissa lands at bit 318 (W-2); exp per value = mant * 2^(exp - 317).
routine uf320_from_u640(n: U640, sign: Bool) -> UnpackedFloat[U320, U640, 320]
  if LLVM::int_eq[U640](a: n, b: 0)
    return UnpackedFloat[U320, U640, 320].zero(sign: sign)
  var b = LLVM::sub(a: 640_s64, b: LLVM::int_truncate[U640, S64](LLVM::leading_zeros(n)))
  var sh = LLVM::sub(a: b, b: 319_s64)
  var exp = LLVM::sub(a: b, b: 2_s64)
  if LLVM::signed_le(a: sh, b: 0_s64)
    var mant = LLVM::int_truncate[U640, U320](LLVM::shift_left(value: n, bits: U640.to_width(s: LLVM::sub(a: 0_s64, b: sh))))
    return UnpackedFloat[U320, U640, 320].make(mant: mant, exp: exp, fpclass: SignedFpClass.from_flags(sign: sign, iszero: false, isinf: false, isnan: false))
  var q = LLVM::shift_right_unsigned(n, U640.to_width(s: sh))
  var lost = LLVM::bit_and(a: n, b: U640.low_mask(n: sh))
  var half = LLVM::shift_left[U640](value: 1, bits: U640.to_width(s: LLVM::sub[S64](a: sh, b: 1_s64)))
  if LLVM::unsigned_gt(a: lost, b: half)
    q = LLVM::add[U640](a: q, b: 1)
  elseif LLVM::int_eq[U640](a: lost, b: half) and LLVM::int_ne[U640](a: LLVM::bit_and[U640](a: q, b: 1), b: 0)
    q = LLVM::add[U640](a: q, b: 1)
  # A round-up may carry the MSB from bit 318 to bit 319 (q == 2^319): renormalize.
  var lead320 = LLVM::shift_left[U640](value: 1, bits: U640.to_width(s: 319_s64))
  if LLVM::unsigned_ge(a: q, b: lead320)
    q = LLVM::shift_right_unsigned(q, U640.to_width(s: 1_s64))
    exp = LLVM::add(a: exp, b: 1_s64)
  return UnpackedFloat[U320, U640, 320].make(mant: LLVM::int_truncate[U640, U320](q), exp: exp, fpclass: SignedFpClass.from_flags(sign: sign, iszero: false, isinf: false, isnan: false))

### 10^e as a W=320 engine value, TABLE-DRIVEN via a two-level sqrt decomposition —
### ONE engine multiply, ZERO divisions, ZERO binary-exponentiation loop, over the FULL
### decimal256 exponent range [-1572864, +1572864].
###
### Let S = ceil(sqrt(1572864)) = 1255. Write |e| = hi*S + lo (hi = |e|/S, lo = |e|%S).
### Then 10^|e| = 10^(S*hi) * 10^lo, and for e<0 the reciprocal factors are stored DIRECTLY
### (never computed as 1/positive). Four precomputed engine-precision tables carry the factors,
### each entry generated at the engine's 318-bit mantissa convention (value = mant*2^(exp-317),
### mant in [2^318,2^319)) with round-half-even (see f320_pow10_high_pos / _high_neg / _low_pos /
### _low_neg below and gen_f320_pow10.py). Exact-integer powers (10^k, small k) land on their
### exact mantissa; large/negative powers are correctly rounded once at generation time.
###   HIGH_POS[hi] = 10^( S*hi),  HIGH_NEG[hi] = 10^(-S*hi),  hi in 0..ceil(1572864/S)=1254
###   LOW_POS[lo]  = 10^( lo),    LOW_NEG[lo]  = 10^(-lo),     lo in 0..S-1=1254
### result = (e>=0 ? HIGH_POS[hi]*LOW_POS[lo] : HIGH_NEG[hi]*LOW_NEG[lo]).
routine f320_pow10(e: S64) -> UnpackedFloat[U320, U640, 320]
  var neg = LLVM::signed_lt(a: e, b: 0_s64)
  var a = if neg then LLVM::sub(a: 0_s64, b: e) else e
  var hi = LLVM::signed_div(a: a, b: 1255_s64)
  var lo = LLVM::signed_rem(a: a, b: 1255_s64)
  if neg
    return f320_pow10_high_neg(i: hi).mul(you: f320_pow10_low_neg(i: lo))
  return f320_pow10_high_pos(i: hi).mul(you: f320_pow10_low_pos(i: lo))

### dec -> bin: Decimal value as a W=320 engine value (coeff exact, scaled by 10^exp).
### Specials map to engine inf/nan; zero preserves sign.
###
### exp in [0, 76]: form the EXACT big integer coeff * 10^exp (<= 233 + 253 = 486 bits, fits the
###   U640 scratch) and round it to the significand ONCE -> correctly rounded, no multiply loop.
### exp in [-76, 0): value = coeff / 10^|exp| — exact coeff load, exact 10^|exp| load, one engine
###   divide (correctly rounded), instead of building 10^|exp| by binary exponentiation.
### Outside the table's exact-integer range: fall back to coeff-load times f320_pow10 (whose own
###   sqrt-split power-of-ten table covers the full Decimal exponent span; only the rare extremes reach here).
routine decimalfixed_to_f320(x: Decimal) -> UnpackedFloat[U320, U640, 320]
  var p = x.decode()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return UnpackedFloat[U320, U640, 320].inf(sign: p.sign)
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return UnpackedFloat[U320, U640, 320].nan()
  if LLVM::int_eq[U256](a: p.coeff, b: 0)
    return UnpackedFloat[U320, U640, 320].zero(sign: p.sign)
  if LLVM::signed_ge(a: p.exp, b: 0_s64) and LLVM::signed_le(a: p.exp, b: 76_s64)
    var prod = LLVM::mul(a: LLVM::zero_extend[U256, U640](p.coeff), b: LLVM::zero_extend[U256, U640](pow10_tbl(k: p.exp)))
    return uf320_from_u640(n: prod, sign: p.sign)
  if LLVM::signed_lt(a: p.exp, b: 0_s64) and LLVM::signed_ge(a: p.exp, b: -76_s64)
    var num = uf320_from_u256(c: p.coeff)
    var den = uf320_from_u640(n: LLVM::zero_extend[U256, U640](pow10_tbl(k: LLVM::sub(a: 0_s64, b: p.exp))), sign: false)
    var qd = num.div(you: den)
    if p.sign
      return qd.neg()
    return qd
  var v = uf320_from_u256(c: p.coeff).mul(you: f320_pow10(e: p.exp))
  if p.sign
    return v.neg()
  return v

### bin -> dec: W=320 engine value as a Decimal, correctly rounded to <=70 digits, then
### subject to the finite-only Decimal contract: a NaN result crashes with
### NumericDomainError (no real answer), a non-finite (inf) result crashes with
### NumericOverflowError (out of range / pole), and -0 normalizes to +0. This is the
### single chokepoint for ALL Decimal transcendentals, so it carries the policy for
### log(0), acos(2), sqrt(-1), exp(huge), tgamma poles, etc.
routine f320_to_decimala!(x: UnpackedFloat[U320, U640, 320]) -> Decimal
  if x.isnan()
    throw NumericDomainError(description: "domain error: no real result")
  if x.isinf()
    throw NumericOverflowError(description: "overflow: out of range")
  if x.iszero()
    return decimalfixed_of_parts(p: DecimalParts(sign: false, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U256](0_u64)))
  var sign = x.sign()
  var e_bin = x.ilogb()
  # decexp ~ floor(e_bin * log10(2)); log10(2) ~ 315653 / 2^20. +-1 error is absorbed
  # by decfinA (it recounts digits and rounds to 70 either way).
  var decexp = LLVM::signed_div(a: LLVM::mul(a: e_bin, b: 315653_s64), b: 1048576_s64)
  var q = LLVM::sub(a: 76_s64, b: decexp)
  var scaled = x.abs().mul(you: f320_pow10(e: q))
  var coeff = uf320_to_u512_round(u: scaled)
  # decfinA may itself clamp an out-of-range magnitude to inf; the check below turns
  # that into NumericOverflowError (and is a no-op for an in-range finite result).
  var __dchk0 = decimalfixed_of_parts(p: decfinA(sign: sign, coeff: coeff, exp: LLVM::sub(a: 0_s64, b: q), pref: LLVM::sub(a: 0_s64, b: q)))
  var __dp0 = __dchk0.decode()
  if LLVM::int_eq(a: __dp0.special, b: 1_u64)
    throw NumericOverflowError(description: "overflow: out of range")
  if LLVM::unsigned_ge(a: __dp0.special, b: 2_u64)
    throw NumericDomainError(description: "domain error: no real result")
  if LLVM::int_eq[U256](a: __dp0.coeff, b: 0)
    return decimalfixed_of_parts(p: DecimalParts(sign: false, special: 0_u64, exp: __dp0.exp, coeff: LLVM::zero_extend[U64, U256](0_u64)))
  return __dchk0

# ============================================================================
# W=320 radix adapter — F128's correctly-rounded decimal->binary128 fast path
# (F128!(from_text)). Threads the engine value UnpackedFloat[U320,U640,320]
# directly (no packed type), mirroring the D256 transcendental path above.
# ============================================================================

### dec -> bin (W=320 engine): D128 parts (sign, coeff, exp10) as the W=320 engine value.
### The 318-bit mantissa makes `coeff x 10^exp` correctly-rounded for EVERY non-tie
### decimal->binary128 input: the engine's worst-case relative error (a few ULP of 2^-318
### from the exact coeff load plus faithful f320_pow10 — one table lookup pair and a single
### engine multiply — over the D128 exponent range, ~2^-310) is far below the ~2^-239
### hardest-case decimal->F128 separation, so a
### single round of to_f128() (113-bit round-half-even) reproduces the true rounding. F128!
### uses this as its provably-correct fast path; exact ties are resolved separately.
routine d128parts_to_f320(p: D128Parts) -> UnpackedFloat[U320, U640, 320]
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return UnpackedFloat[U320, U640, 320].inf(sign: p.sign)
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return UnpackedFloat[U320, U640, 320].nan()
  if LLVM::int_eq(a: p.coeff, b: 0_u128)
    return UnpackedFloat[U320, U640, 320].zero(sign: p.sign)
  # exp in [0, 76]: exact coeff * 10^exp (<= 126 + 253 = 379 bits) rounded once -> the F128 parse
  # fast path is now correctly rounded at the engine (no faithful pow10 term in its error budget).
  if LLVM::signed_ge(a: p.exp, b: 0_s64) and LLVM::signed_le(a: p.exp, b: 76_s64)
    var prod = LLVM::mul(a: LLVM::zero_extend[U128, U640](p.coeff), b: LLVM::zero_extend[U256, U640](pow10_tbl(k: p.exp)))
    return uf320_from_u640(n: prod, sign: p.sign)
  # exp in [-76, 0): coeff / 10^|exp| — exact loads, one engine divide.
  if LLVM::signed_lt(a: p.exp, b: 0_s64) and LLVM::signed_ge(a: p.exp, b: -76_s64)
    var num = uf320_from_u256(c: LLVM::zero_extend[U128, U256](p.coeff))
    var den = uf320_from_u640(n: LLVM::zero_extend[U256, U640](pow10_tbl(k: LLVM::sub(a: 0_s64, b: p.exp))), sign: false)
    var qd = num.div(you: den)
    if p.sign
      return qd.neg()
    return qd
  var v = uf320_from_u256(c: LLVM::zero_extend[U128, U256](p.coeff)).mul(you: f320_pow10(e: p.exp))
  if p.sign
    return v.neg()
  return v

# ============================================================================
# W=320 engine transcendental cores (D256 path). The generic engine exp/log/atan/
# asin/acos/atan2 self-size at W==320 via the F128Const W==320 coefficient tables
# and the F128Math W==320 degree/reduction overrides, so these are thin
# specials-handling wrappers over the engine cores — no dedicated Remez tables.
# ============================================================================

### W=320 exp. Specials per IEEE/C99: exp(NaN)=NaN, exp(+inf)=+inf, exp(-inf)=+0.
### The engine's exp self-sizes to 70+ digits at W==320 and handles over/underflow
### (+inf / +0) internally via its |me|>~2^28 guard.
routine f320_exp_cr(x: UnpackedFloat[U320, U640, 320]) -> UnpackedFloat[U320, U640, 320]
  if x.isnan()
    return UnpackedFloat[U320, U640, 320].nan()
  if x.isinf()
    if x.sign()
      return UnpackedFloat[U320, U640, 320].zero(sign: false)
    return UnpackedFloat[U320, U640, 320].inf(sign: false)
  return x.exp(n: 36_s64)

### W=320 atan. Specials per C99: atan(NaN)=NaN, atan(+-inf)=+-pi/2, atan(+-0)=+-0.
### The engine atan (table-reduced, width-self-sizing) already handles specials, so
### this delegates directly.
routine f320_atan_cr(x: UnpackedFloat[U320, U640, 320]) -> UnpackedFloat[U320, U640, 320]
  return x.atan()

### W=320 asin. Domain |x|<=1; the engine asin returns NaN for |x|>1 and pi/2 at
### |x|==1, matching the C99 contract.
routine f320_asin_cr(x: UnpackedFloat[U320, U640, 320]) -> UnpackedFloat[U320, U640, 320]
  return x.asin()

### W=320 acos. Domain |x|<=1; the engine acos returns NaN for |x|>1, 0 at x==1 and
### pi at x==-1.
routine f320_acos_cr(x: UnpackedFloat[U320, U640, 320]) -> UnpackedFloat[U320, U640, 320]
  return x.acos()

### W=320 atan2(y, x) with C99 quadrant/sign rules (the engine atan2 core).
routine f320_atan2_cr(y: UnpackedFloat[U320, U640, 320], x: UnpackedFloat[U320, U640, 320]) -> UnpackedFloat[U320, U640, 320]
  return y.atan2(x0: x)

# ============================================================================
# Transcendentals — decode to the W=320 engine, run the engine core, round back to
# Decimal. (Mirrors the engine surface one-for-one; the passed term counts are
# overridden internally by the W==320 self-sizing where applicable.)
# ============================================================================

### e raised to this value. Uses the W=320 engine exp core (self-sizing at W==320).
routine Decimal.exp() -> Decimal
  return f320_to_decimala(x: f320_exp_cr(x: decimalfixed_to_f320(x: me)))

### Natural logarithm. Crashes with NumericDomainError if me < 0, NumericOverflowError if me = 0.
routine Decimal.log!() -> Decimal
  if me.signbit()
    throw NumericDomainError(description: "domain error: no real result")
  if me.is_zero()
    throw NumericOverflowError(description: "overflow: out of range")
  return f320_to_decimala(x: decimalfixed_to_f320(x: me).log(n: 33_s64, m: 0_s64, t: 0_s64))

### exp(me) - 1. Engine expm1 core — cancellation-free near 0 (NOT exp(me)-1).
routine Decimal.expm1() -> Decimal
  return f320_to_decimala(x: decimalfixed_to_f320(x: me).expm1(n: 36_s64))

### log(1 + me). Engine log1p core — cancellation-free near 0. Crashes if me <= -1.
routine Decimal.log1p!() -> Decimal
  var y = me + Decimal(from: 1_s64)
  if y.signbit()
    throw NumericDomainError(description: "domain error: no real result")
  if y.is_zero()
    throw NumericOverflowError(description: "overflow: out of range")
  return f320_to_decimala(x: decimalfixed_to_f320(x: me).log1p(n: 33_s64, m: 0_s64))

### Base-2 logarithm. Crashes with NumericDomainError if me < 0, NumericOverflowError if me = 0.
routine Decimal.log2!() -> Decimal
  if me.signbit()
    throw NumericDomainError(description: "domain error: no real result")
  if me.is_zero()
    throw NumericOverflowError(description: "overflow: out of range")
  return f320_to_decimala(x: decimalfixed_to_f320(x: me).log(n: 33_s64, m: 0_s64, t: 0_s64).mul(you: UnpackedFloat[U320, U640, 320].recip_ln2()))

### Base-10 logarithm. Crashes with NumericDomainError if me < 0, NumericOverflowError if me = 0.
routine Decimal.log10!() -> Decimal
  if me.signbit()
    throw NumericDomainError(description: "domain error: no real result")
  if me.is_zero()
    throw NumericOverflowError(description: "overflow: out of range")
  return f320_to_decimala(x: decimalfixed_to_f320(x: me).log(n: 33_s64, m: 0_s64, t: 0_s64).mul(you: UnpackedFloat[U320, U640, 320].recip_ln10()))

### 2 raised to this value: exp(me * ln2) via the engine exp core.
routine Decimal.exp2() -> Decimal
  return f320_to_decimala(x: f320_exp_cr(x: decimalfixed_to_f320(x: me).mul(you: UnpackedFloat[U320, U640, 320].ln2())))

### 10 raised to this value: exp(me * ln10) via the engine exp core.
routine Decimal.exp10() -> Decimal
  return f320_to_decimala(x: f320_exp_cr(x: decimalfixed_to_f320(x: me).mul(you: UnpackedFloat[U320, U640, 320].ln10())))

### me raised to the power `you`: exp(you * log(me)) via the engine exp core.
### Crashes with NumericDomainError if me <= 0, NumericOverflowError on overflow.
routine Decimal.pow!(you: Decimal) -> Decimal
  if me.signbit() or me.is_zero()
    throw NumericDomainError(description: "domain error: no real result")
  var lm = decimalfixed_to_f320(x: me).log(n: 33_s64, m: 0_s64, t: 0_s64)
  return f320_to_decimala(x: f320_exp_cr(x: decimalfixed_to_f320(x: you).mul(you: lm)))

### Square root (correctly rounded). Crashes with NumericDomainError if me < 0.
routine Decimal.sqrt!() -> Decimal
  if me.signbit()
    throw NumericDomainError(description: "domain error: no real result")
  return f320_to_decimala(x: decimalfixed_to_f320(x: me).sqrt())

### Cube root.
routine Decimal.cbrt() -> Decimal
  return f320_to_decimala(x: decimalfixed_to_f320(x: me).cbrt())

### Hypotenuse sqrt(x^2 + y^2).
### :param x: One leg.
### :param y: The other leg.
routine hypot(x: Decimal, y: Decimal) -> Decimal
  var a = decimalfixed_to_f320(x: x).abs()
  var b = decimalfixed_to_f320(x: y).abs()
  return f320_to_decimala(x: a.mul(you: a).add(you: b.mul(you: b)).sqrt())

### Fused multiply-add me*b + c.
routine Decimal.fma(b: Decimal, c: Decimal) -> Decimal
  return f320_to_decimala(x: decimalfixed_to_f320(x: me).fma(b: decimalfixed_to_f320(x: b), c: decimalfixed_to_f320(x: c)))

### Sine.
routine Decimal.sin() -> Decimal
  return f320_to_decimala(x: decimalfixed_to_f320(x: me).sin(n: 26_s64))

### Cosine.
routine Decimal.cos() -> Decimal
  return f320_to_decimala(x: decimalfixed_to_f320(x: me).cos())

### Tangent.
routine Decimal.tan() -> Decimal
  return f320_to_decimala(x: decimalfixed_to_f320(x: me).tan())

### Arcsine. Crashes with NumericDomainError if |me| > 1.
routine Decimal.asin!() -> Decimal
  var x = decimalfixed_to_f320(x: me)
  if x.abs().gt(you: uf320_one())
    throw NumericDomainError(description: "domain error: no real result")
  return f320_to_decimala(x: f320_asin_cr(x: x))

### Arccosine. Crashes with NumericDomainError if |me| > 1.
routine Decimal.acos!() -> Decimal
  var x = decimalfixed_to_f320(x: me)
  if x.abs().gt(you: uf320_one())
    throw NumericDomainError(description: "domain error: no real result")
  return f320_to_decimala(x: f320_acos_cr(x: x))

### Arctangent. Uses the engine atan core (table-reduced, width-self-sizing).
routine Decimal.atan() -> Decimal
  return f320_to_decimala(x: f320_atan_cr(x: decimalfixed_to_f320(x: me)))

### Two-argument arctangent atan2(y, x). Engine atan2 core + C99 quadrant rules.
### :param y: The y-coordinate.
### :param x: The x-coordinate.
routine atan2(y: Decimal, x: Decimal) -> Decimal
  return f320_to_decimala(x: f320_atan2_cr(y: decimalfixed_to_f320(x: y), x: decimalfixed_to_f320(x: x)))

### Hyperbolic sine. Engine sinh core (built on cancellation-free expm1).
routine Decimal.sinh() -> Decimal
  return f320_to_decimala(x: decimalfixed_to_f320(x: me).sinh())

### Hyperbolic cosine. Engine cosh core.
routine Decimal.cosh() -> Decimal
  return f320_to_decimala(x: decimalfixed_to_f320(x: me).cosh())

### Hyperbolic tangent. Engine tanh core (built on cancellation-free expm1).
routine Decimal.tanh() -> Decimal
  return f320_to_decimala(x: decimalfixed_to_f320(x: me).tanh())

### Inverse hyperbolic sine. Engine asinh core (log1p-based near 0).
routine Decimal.asinh() -> Decimal
  return f320_to_decimala(x: decimalfixed_to_f320(x: me).asinh())

### Inverse hyperbolic cosine. Crashes with NumericDomainError if me < 1.
routine Decimal.acosh!() -> Decimal
  var x = decimalfixed_to_f320(x: me)
  if x.lt(you: uf320_one())
    throw NumericDomainError(description: "domain error: no real result")
  return f320_to_decimala(x: x.acosh())

### Inverse hyperbolic tangent. Crashes with NumericDomainError if |me| > 1, NumericOverflowError if
### |me| = 1.
routine Decimal.atanh!() -> Decimal
  var x = decimalfixed_to_f320(x: me)
  var ax = x.abs()
  if ax.gt(you: uf320_one())
    throw NumericDomainError(description: "domain error: no real result")
  if ax.eq(you: uf320_one())
    throw NumericOverflowError(description: "overflow: out of range")
  return f320_to_decimala(x: x.atanh())

# ============================================================================
# erf / erfc — the generic N=120 continued-fraction cores (erf_cf/erfc_cf) run
# at W=320. levels=120 is a direct param (not auto-overridden by W) and is
# generous for the 233-bit / 70-digit D256 target; the inner exp/log self-size at
# W==320. Threshold |x| = 3.1 splits erf-CF (small |x|) from erfc-CF (large |x|),
# per the F128 surface.
# ============================================================================

### Error function erf(x). Specials: erf(NaN)=NaN, erf(+-inf)=+-1.
routine f320_erf_cr(a: UnpackedFloat[U320, U640, 320]) -> UnpackedFloat[U320, U640, 320]
  if a.isnan()
    return UnpackedFloat[U320, U640, 320].nan()
  if a.isinf()
    if a.sign()
      return uf320_intval(n: -1_s64)
    return uf320_intval(n: 1_s64)
  var thr = uf320_intval(n: 31_s64).div(you: uf320_intval(n: 10_s64))
  if a.lt(you: thr.neg())
    return uf320_intval(n: -1_s64).sub(you: a.erfc_cf(levels: 120_s64))
  if a.lt(you: thr)
    return a.erf_cf(levels: 120_s64)
  return uf320_intval(n: 1_s64).sub(you: a.erfc_cf(levels: 120_s64))

### Complementary error function erfc(x)=1-erf(x). Specials: erfc(NaN)=NaN,
### erfc(-inf)=2, erfc(+inf)=0.
routine f320_erfc_cr(a: UnpackedFloat[U320, U640, 320]) -> UnpackedFloat[U320, U640, 320]
  if a.isnan()
    return UnpackedFloat[U320, U640, 320].nan()
  if a.isinf()
    if a.sign()
      return uf320_intval(n: 2_s64)
    return uf320_intval(n: 0_s64)
  var thr = uf320_intval(n: 31_s64).div(you: uf320_intval(n: 10_s64))
  if a.lt(you: thr.neg())
    return uf320_intval(n: 2_s64).add(you: a.erfc_cf(levels: 120_s64))
  if a.lt(you: thr)
    return uf320_intval(n: 1_s64).sub(you: a.erf_cf(levels: 120_s64))
  return a.erfc_cf(levels: 120_s64)

### Error function.
routine Decimal.erf() -> Decimal
  return f320_to_decimala(x: f320_erf_cr(a: decimalfixed_to_f320(x: me)))

### Complementary error function.
routine Decimal.erfc() -> Decimal
  return f320_to_decimala(x: f320_erfc_cr(a: decimalfixed_to_f320(x: me)))

# ============================================================================
# tgamma / lgamma — Stirling lgamma_core at W=320 using the F128Const W==320
# GAMMA_COEF_B320 table (36 coefficients -> indices 0..35). The old F512 core ran
# O=80 terms over the wider gamma512_coef table; at W=320 the validated table is
# 36 entries, so the Horner series is CLAMPED to 36 coefficients (sdeg 80 -> 36).
# The inner log/exp self-size at W==320; sin(n:26) is the max valid index into the
# 27-entry SIN_COEF_B320 table (augmentation threshold 32, per the W=320 form).
# ============================================================================

### lgamma core (TLFloat-style): returns (sign of gamma, log|gamma(z)|) at W=320.
routine f320_lgamma_core(z: UnpackedFloat[U320, U640, 320]) -> UFSign[U320, U640, 320]
  var one = UnpackedFloat[U320, U640, 320].from_s64(src: 1_s64)
  var p5 = one.ldexp(e: -1_s64)
  # reflection formula for z < -1: lgamma(z) derived from lgamma(1-z) via Euler reflection (below)
  var reflect = z.lt(you: one.neg())
  var a = if reflect then one.sub(you: z) else z
  # split a into integer part (inv) + fractional remainder (fr); argument-augment small a up to 32
  var inv = a.rint()
  var fr = a.sub(you: inv)
  var w = UnpackedFloat[U320, U640, 320].from_s64(src: 1_s64)
  var thr = UnpackedFloat[U320, U640, 320].from_s64(src: 32_s64)
  if inv.lt(you: thr)
    # recurrence gamma(a)=gamma(a+n)/(a(a+1)...(a+n-1)): w accumulates the denominator product
    var ii = inv.to_s64()
    while LLVM::signed_lt(a: ii, b: 32_s64)
      w = w.mul(you: UnpackedFloat[U320, U640, 320].from_s64(src: ii).add(you: fr))
      ii = LLVM::add(a: ii, b: 1_s64)
    a = thr.add(you: fr)
  # Stirling asymptotic series in 1/a^2 evaluated by Horner over the 36-term gamma_coef table
  # (W==320 GAMMA_COEF_B320: indices 0..35). Start at the top coefficient (35) and fold down.
  var inv_aa = one.div(you: a.mul(you: a))
  var y = UnpackedFloat[U320, U640, 320].gamma_coef(35_s64)
  var i = 34_s64
  while LLVM::signed_ge(a: i, b: 0_s64)
    y = y.fma_finite(b: inv_aa, c: UnpackedFloat[U320, U640, 320].gamma_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  # Stirling main term: log|gamma(a)| ~ series/a + (a-1/2)ln a - a + (1/2)ln(2pi)
  var loga = a.log(n: 33_s64, m: 2_s64, t: -1000000_s64)
  y = y.div(you: a).add(you: a.sub(you: p5).mul(you: loga)).sub(you: a).add(you: p5.mul(you: UnpackedFloat[U320, U640, 320].ln_2pi()))
  # subtract log of the augmentation product to undo the recurrence shift
  y = y.sub(you: w.abs().log(n: 33_s64, m: 2_s64, t: -1000000_s64))
  var sign = w.sign()
  if reflect
    # Euler reflection: ln|gamma(z)| = ln(pi) - ln|sin(pi*fr)| - ln|gamma(1-z)|; sign from sin &
    # parity
    var s = UnpackedFloat[U320, U640, 320].pi().mul(you: fr).sin(n: 26_s64)
    y = UnpackedFloat[U320, U640, 320].ln_pi().sub(you: s.abs().log(n: 33_s64, m: 2_s64, t: -1000000_s64)).sub(you: y)
    sign = (sign).xor(you: s.sign())
    sign = sign == inv.iseven()
  return UFSign[U320, U640, 320](item0: sign, item1: y)

### Gamma function. tgamma(NaN)=NaN, tgamma(+inf)=+inf, tgamma(-inf)=NaN,
### tgamma(+-0)=+-inf, tgamma(negative integer)=NaN.
routine f320_tgamma_cr(z: UnpackedFloat[U320, U640, 320]) -> UnpackedFloat[U320, U640, 320]
  if z.isnan()
    return UnpackedFloat[U320, U640, 320].nan()
  if z.isinf()
    if z.sign()
      return UnpackedFloat[U320, U640, 320].nan()
    return z
  if z.iszero()
    return UnpackedFloat[U320, U640, 320].inf(sign: z.sign())
  if z.sign() and z.isint()
    return UnpackedFloat[U320, U640, 320].nan()
  var p = f320_lgamma_core(z: z)
  var r = p.item1.exp(n: 36_s64)
  if p.item0
    r = r.neg()
  return r

### Log-gamma ln|gamma(x)|. lgamma(NaN)=NaN; lgamma(0)=lgamma(+-inf)=
### lgamma(negative integer)=+inf.
routine f320_lgamma_cr(z: UnpackedFloat[U320, U640, 320]) -> UnpackedFloat[U320, U640, 320]
  if z.isnan()
    return UnpackedFloat[U320, U640, 320].nan()
  if z.iszero() or z.isinf()
    return UnpackedFloat[U320, U640, 320].inf(sign: false)
  if z.sign() and z.isint()
    return UnpackedFloat[U320, U640, 320].inf(sign: false)
  var p = f320_lgamma_core(z: z)
  return p.item1

### Gamma function. Crashes with NumericDomainError if me is a non-positive integer,
### NumericOverflowError on overflow.
routine Decimal.tgamma!() -> Decimal
  var r = f320_tgamma_cr(z: decimalfixed_to_f320(x: me))
  if r.isnan()
    throw NumericDomainError(description: "domain error: no real result")
  if r.isinf()
    throw NumericOverflowError(description: "overflow: out of range")
  return f320_to_decimala(x: r)

### Natural log of the absolute value of gamma. Crashes with NumericOverflowError at poles (me = 0
### or negative integer).
routine Decimal.lgamma!() -> Decimal
  var r = f320_lgamma_cr(z: decimalfixed_to_f320(x: me))
  if r.isinf()
    throw NumericOverflowError(description: "overflow: out of range")
  return f320_to_decimala(x: r)

# ============================================================================
# libm manipulation / classification — decimal-native on DecimalParts (value =
# (-1)^sign * coeff * 10^exp). No binary round-trip: exact for the decimal type.
# fmod/remainder/remquo (exact coefficient long-division) and the binary-exponent
# ops (ldexp/frexp/logb/ilogb) are intentionally omitted; `scaleb` (x*10^n) is the
# decimal-native analog provided instead.
# ============================================================================

### Sign bit (true when negative, including -0, -inf, -NaN).
routine Decimal.signbit() -> Bool
  return me.decode().sign

### True for a finite non-zero value (decimal has no binary subnormals).
routine Decimal.is_normal() -> Bool
  var p = me.decode()
  return LLVM::int_eq[U64](a: p.special, b: 0_u64) and LLVM::int_ne[U256](a: p.coeff, b: 0)

### True for +-0.
routine Decimal.is_zero() -> Bool
  var p = me.decode()
  return LLVM::int_eq[U64](a: p.special, b: 0_u64) and LLVM::int_eq[U256](a: p.coeff, b: 0)

### True if me is signed (negative; -0 is signed). Mirrors the D128 surface.
routine Decimal.is_negative() -> Bool
  return me.decode().sign

### True if me is strictly positive (not signed, not zero, not NaN).
routine Decimal.is_positive() -> Bool
  var p = me.decode()
  return not p.sign and LLVM::int_eq[U64](a: p.special, b: 0_u64) and LLVM::int_ne[U256](a: p.coeff, b: 0)

### Returns -1, 0, or +1 matching the sign of me (NaN -> NaN, +-0 -> +0).
routine Decimal.signum() -> Decimal
  if me.is_nan()
    return Decimal.quiet_nan()
  if me.is_zero()
    return decimalfixed_of_parts(p: DecimalParts(sign: false, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U256](0_u64)))
  return if me.decode().sign then Decimal(from: -1_s64) else Decimal(from: 1_s64)

### libm fpclassify code: 0 NaN, 1 infinite, 2 zero, 4 normal (3 subnormal unused).
routine Decimal.fpclassify() -> FpClass
  var p = me.decode()
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return NAN
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return INFINITE
  if LLVM::int_eq[U256](a: p.coeff, b: 0)
    return ZERO
  return NORMAL

### Absolute value (clears the sign, including on NaN/inf).
routine Decimal.abs() -> Decimal
  var p = me.decode()
  return decimalfixed_of_parts(p: DecimalParts(sign: false, special: p.special, exp: p.exp, coeff: p.coeff))

### Negation (flips the sign, including on NaN/inf/zero).
routine Decimal.neg() -> Decimal
  var p = me.decode()
  return decimalfixed_of_parts(p: DecimalParts(sign: not p.sign, special: p.special, exp: p.exp, coeff: p.coeff))

### Magnitude of me with the sign of `you`.
routine Decimal.copysign(you: Decimal) -> Decimal
  var p = me.decode()
  return decimalfixed_of_parts(p: DecimalParts(sign: you.decode().sign, special: p.special, exp: p.exp, coeff: p.coeff))

### Larger of me and you (NaN-skipping, per C99 fmax).
routine Decimal.fmax(you: Decimal) -> Decimal
  if me.is_nan()
    return you
  if you.is_nan()
    return me
  if (me - you).decode().sign
    return you
  return me

### Smaller of me and you (NaN-skipping, per C99 fmin).
routine Decimal.fmin(you: Decimal) -> Decimal
  if me.is_nan()
    return you
  if you.is_nan()
    return me
  if (me - you).decode().sign
    return me
  return you

### Positive difference max(me - you, 0); NaN if either is NaN.
routine Decimal.fdim(you: Decimal) -> Decimal
  if me.is_nan() or you.is_nan()
    return Decimal.quiet_nan()
  var d = me - you
  if d.decode().sign
    return decimalfixed_of_parts(p: DecimalParts(sign: false, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U256](0_u64)))
  return d

### Scale by a power of ten: me * 10^n (the decimal analog of ldexp). Routes through the shared
### `decfinA` encoder so the result obeys the IEEE decimal256 exponent range exactly (quantum
### qmax = Emax-(p-1) = 1572795; above it the coefficient is padded into the canonical max-q
### cohort). `Decimal` is finite-only, so a true overflow THROWS rather than producing infinity
### — a plain failable `!` (recoverable via `try_scaleb!`), matching `D32`/`D64`/`D128`/`F*`.
### Underflow below the minimum quantum flushes to zero.
### :param n: The power-of-ten exponent to apply.
### :returns: `me` scaled by `10^n`.
### :throws: {NumericOverflowError} when the scaled magnitude exceeds the `Decimal` range.
routine Decimal.scaleb!(n: S64) -> Decimal
  var p = me.decode()
  if LLVM::int_ne[U64](a: p.special, b: 0_u64) or LLVM::int_eq[U256](a: p.coeff, b: 0)
    return me
  var ne = LLVM::add(a: p.exp, b: n)
  if LLVM::signed_lt(a: ne, b: -1572932_s64)
    return decimalfixed_of_parts(p: DecimalParts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U256](0_u64)))
  var scaled = decimalfixed_of_parts(p: decfinA(sign: p.sign, coeff: LLVM::zero_extend[U256, U512](p.coeff), exp: ne, pref: ne))
  if LLVM::int_eq(a: scaled.decode().special, b: 1_u64)
    throw NumericOverflowError(description: "overflow: out of range")
  return scaled

### Rounds me to an integral value. mode: 0 trunc, 1 floor, 2 ceil, 3 round
### (half away from zero), 4 rint (half to even). Decimal-native, exact.
routine decimalfixed_round_int(x: Decimal, mode: S64) -> Decimal
  var p = x.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64)
    return x
  if LLVM::int_eq[U256](a: p.coeff, b: 0)
    return x
  if LLVM::signed_ge(a: p.exp, b: 0_s64)
    return x
  var ndrop = LLVM::sub(a: 0_s64, b: p.exp)
  var q = LLVM::zero_extend[U64, U256](0_u64)
  var rnz = true
  var half = false
  var gthalf = false
  if LLVM::signed_le(a: ndrop, b: 70_s64)
    var divp = pow10b(k: ndrop)
    q = div_pow10b(x: p.coeff, k: ndrop)
    var r = LLVM::sub(a: p.coeff, b: LLVM::mul(a: q, b: divp))
    rnz = LLVM::int_ne[U256](a: r, b: 0)
    var twice = LLVM::mul(a: r, b: LLVM::zero_extend[U64, U256](2_u64))
    half = LLVM::int_eq(a: twice, b: divp)
    gthalf = LLVM::unsigned_gt(a: twice, b: divp)
  var inc = false
  if LLVM::int_eq(a: mode, b: 1_s64)
    inc = p.sign and rnz
  elseif LLVM::int_eq(a: mode, b: 2_s64)
    inc = (not p.sign) and rnz
  elseif LLVM::int_eq(a: mode, b: 3_s64)
    inc = gthalf or half
  elseif LLVM::int_eq(a: mode, b: 4_s64)
    if gthalf
      inc = true
    elseif half
      inc = LLVM::int_ne(a: LLVM::bit_and(a: q, b: LLVM::zero_extend[U64, U256](1_u64)), b: LLVM::zero_extend[U64, U256](0_u64))
  var qq = q
  if inc
    qq = LLVM::add(a: q, b: LLVM::zero_extend[U64, U256](1_u64))
  return decimalfixed_of_parts(p: DecimalParts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: qq))

### Truncate toward zero.
routine Decimal.trunc() -> Decimal
  return decimalfixed_round_int(x: me, mode: 0_s64)

### Round toward -inf.
routine Decimal.floor() -> Decimal
  return decimalfixed_round_int(x: me, mode: 1_s64)

### Round toward +inf.
routine Decimal.ceil() -> Decimal
  return decimalfixed_round_int(x: me, mode: 2_s64)

### Round to nearest, ties away from zero.
routine Decimal.round() -> Decimal
  return decimalfixed_round_int(x: me, mode: 3_s64)

### Round to nearest, ties to even (nearbyint/rint).
routine Decimal.rint() -> Decimal
  return decimalfixed_round_int(x: me, mode: 4_s64)

### Fractional part me - trunc(me) (same sign as me); modf int part = trunc(me).
routine Decimal.frac() -> Decimal
  if me.is_nan()
    return me
  var p = me.decode()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return decimalfixed_of_parts(p: DecimalParts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U256](0_u64)))
  return me - me.trunc()

# ============================================================================
# IEEE 754 surface — predicates, total ordering, selection, quantum operations.
# Mirrors the D32/D64/D128 API for `Decimal`, adapted to its 70-digit format
# (Pmax=70, minimum quantum exponent -1572932). `Decimal` is finite-only, so the
# operations that would otherwise produce inf/NaN (logb of zero, a quantize that
# needs > 70 digits) are FAILABLE and throw, matching the rest of the type.
# ============================================================================

### True if me is a finite, nonzero subnormal: quantum exponent at the minimum
### (-1572932) with a coefficient below 10^69 (fewer than the full 70 significant
### digits). `Decimal` has no binary subnormals; this is the decimal-cohort sense.
### :returns: Whether `me` is a subnormal value.
routine Decimal.is_subnormal() -> Bool
  var p = me.decode()
  if LLVM::int_ne[U64](a: p.special, b: 0_u64) or LLVM::int_eq[U256](a: p.coeff, b: 0)
    return false
  return LLVM::int_eq(a: p.exp, b: -1572932_s64) and LLVM::unsigned_lt(a: p.coeff, b: pow10b(k: 69_s64))

### Splits into integer and fractional parts (C modf); both carry me's sign.
### :returns: A tuple `(integer_part, fractional_part)`.
routine Decimal.modf() -> (Decimal, Decimal)
  if me.is_nan()
    return (me, me)
  var p = me.decode()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return (me, decimalfixed_of_parts(p: DecimalParts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U256](0_u64))))
  var ip = me.trunc()
  return (ip, me - ip)

### IEEE 754 totalOrder for decimals: a total order over all values including signed
### zeros and cohorts (equal value with differing exponents). For finite operands of
### equal value the smaller-exponent member precedes when positive (reversed when
### negative). Reuses the shared `decimal_order_band` for the defensive special path.
### :param you: The value to compare against.
### :returns: Whether `me` precedes or equals `you` in the total order.
routine Decimal.total_order(you: Decimal) -> Bool
  var pa = me.decode()
  var pb = you.decode()
  if LLVM::unsigned_ge(a: pa.special, b: 2_u64) or LLVM::unsigned_ge(a: pb.special, b: 2_u64)
    return decimal_order_band(sign: pa.sign, special: pa.special) <= decimal_order_band(sign: pb.sign, special: pb.special)
  var c = me.cmp(you: you)
  if c isnot SAME
    return c is ME_SMALL
  if pa.sign != pb.sign
    return pa.sign
  if pa.sign
    return LLVM::signed_ge(a: pa.exp, b: pb.exp)
  return LLVM::signed_le(a: pa.exp, b: pb.exp)

### IEEE 754 totalOrderMag for decimals: `total_order` applied to the magnitudes.
### :param you: The value whose magnitude to compare against.
### :returns: Whether `|me|` precedes or equals `|you|` in the total order.
routine Decimal.total_order_mag(you: Decimal) -> Bool
  return me.abs().total_order(you: you.abs())

### IEEE 754 logb: the base-10 exponent `e` with `10^e <= |me| < 10^(e+1)`, as a decimal
### integer. `Decimal` is finite-only, so logb(0) (which is -inf in IEEE) throws instead.
### :returns: The radix-10 exponent of `me`.
### :throws: {NumericDomainError} when `me` is zero (no finite exponent).
routine Decimal.logb!() -> Decimal
  var p = me.decode()
  if LLVM::int_eq[U256](a: p.coeff, b: 0)
    throw NumericDomainError(description: "domain error: no real result")
  return Decimal(from: LLVM::add(a: p.exp, b: LLVM::sub(a: digits10a(c: LLVM::zero_extend[U256, U512](p.coeff)), b: 1_s64)))

### IEEE 754-2008 minNum: the smaller operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, ignoring NaN.
routine Decimal.min_num(you: Decimal) -> Decimal
  return me.fmin(you: you)

### IEEE 754-2008 maxNum: the larger operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, ignoring NaN.
routine Decimal.max_num(you: Decimal) -> Decimal
  return me.fmax(you: you)

### IEEE 754-2019 minimum: the smaller operand, ordering -0 below +0.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`.
routine Decimal.minimum(you: Decimal) -> Decimal
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  var c = me.cmp(you: you)
  if c is ME_SMALL
    return me
  if c is ME_LARGE
    return you
  if me.is_zero()
    return if me.signbit() then me else you
  return me

### IEEE 754-2019 maximum: the larger operand, ordering +0 above -0.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`.
routine Decimal.maximum(you: Decimal) -> Decimal
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  var c = me.cmp(you: you)
  if c is ME_LARGE
    return me
  if c is ME_SMALL
    return you
  if me.is_zero()
    return if me.signbit() then you else me
  return me

### IEEE 754 roundToIntegralTiesToAway: rounds to nearest integer, halves away from zero
### (alias of `round`). Never crashes.
### :returns: `me` rounded to an integral value with ties away from zero.
routine Decimal.round_ties_away() -> Decimal
  return me.round()

### IEEE 754 sameQuantum: `true` when `me` and `other` share the same exponent (quantum).
### :param you: The value whose quantum to compare against.
### :returns: Whether the two share a quantum.
routine Decimal.same_quantum(you: Decimal) -> Bool
  var pa = me.decode()
  var pb = you.decode()
  if LLVM::unsigned_ge(a: pa.special, b: 2_u64) or LLVM::unsigned_ge(a: pb.special, b: 2_u64)
    return LLVM::unsigned_ge(a: pa.special, b: 2_u64) and LLVM::unsigned_ge(a: pb.special, b: 2_u64)
  if LLVM::int_eq(a: pa.special, b: 1_u64) or LLVM::int_eq(a: pb.special, b: 1_u64)
    return LLVM::int_eq(a: pa.special, b: 1_u64) and LLVM::int_eq(a: pb.special, b: 1_u64)
  return LLVM::int_eq(a: pa.exp, b: pb.exp)

### IEEE 754 quantize: returns `me`'s value re-expressed with the exponent of `other`
### (rounding half-even when digits are dropped). The canonical money-formatting /
### fixed-scale operation. Throws when the result would need more than 70 significand
### digits (which IEEE represents as NaN, but `Decimal` is finite-only).
### :param you: The value supplying the target exponent.
### :returns: `me` quantized to `other`'s exponent.
### :throws: {NumericOverflowError} when the result needs more than 70 digits.
routine Decimal.quantize!(you: Decimal) -> Decimal
  var pa = me.decode()
  var target = you.decode().exp
  if LLVM::int_eq(a: pa.exp, b: target)
    return me
  if LLVM::signed_gt(a: pa.exp, b: target)
    # Scale the coefficient UP by 10^(pa.exp - target); exact, but throws if it needs > 70 digits.
    var shift = LLVM::sub(a: pa.exp, b: target)
    if LLVM::int_ne[U256](a: pa.coeff, b: 0) and LLVM::signed_gt[S64](a: LLVM::add[S64](a: digits10a(c: LLVM::zero_extend[U256, U512](pa.coeff)), b: shift), b: 70_s64)
      throw NumericOverflowError(description: "overflow: out of range")
    var scaled = LLVM::mul(a: pa.coeff, b: pow10b(k: shift))
    return decimalfixed_of_parts(p: DecimalParts(sign: pa.sign, special: 0_u64, exp: target, coeff: scaled))
  # pa.exp < target: drop (target - pa.exp) digits with half-even rounding.
  var drop = LLVM::sub(a: target, b: pa.exp)
  if LLVM::signed_gt(a: drop, b: 70_s64)
    return decimalfixed_of_parts(p: DecimalParts(sign: pa.sign, special: 0_u64, exp: target, coeff: LLVM::zero_extend[U64, U256](0_u64)))
  var divp = pow10b(k: drop)
  var q = div_pow10b(x: pa.coeff, k: drop)
  var r = LLVM::sub(a: pa.coeff, b: LLVM::mul(a: q, b: divp))
  var twice = LLVM::mul(a: r, b: LLVM::zero_extend[U64, U256](2_u64))
  if LLVM::unsigned_gt(a: twice, b: divp)
    q = LLVM::add(a: q, b: LLVM::zero_extend[U64, U256](1_u64))
  elseif LLVM::int_eq(a: twice, b: divp) and LLVM::int_ne(a: LLVM::bit_and(a: q, b: LLVM::zero_extend[U64, U256](1_u64)), b: LLVM::zero_extend[U64, U256](0_u64))
    q = LLVM::add(a: q, b: LLVM::zero_extend[U64, U256](1_u64))
  return decimalfixed_of_parts(p: DecimalParts(sign: pa.sign, special: 0_u64, exp: target, coeff: q))

### IEEE 754 remainder: `me - other * n`, where `n` is the integer nearest `me / other`
### (ties to even). Result satisfies `|r| <= |other| / 2`. Crashes (DivisionByZeroError)
### when `other` is zero, like the rest of `Decimal` division.
### :param you: The divisor.
### :returns: The IEEE remainder of `me / other`.
routine Decimal.remainder(you: Decimal) -> Decimal
  var n = (me / you).rint()
  return me - you * n

