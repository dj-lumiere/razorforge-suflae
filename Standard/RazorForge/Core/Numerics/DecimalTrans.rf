module Core

# ============================================================================
# DecimalTrans — the transcendental / libm surface of `Decimal`.
#
# `Decimal` is a finite-only canonical face of decimal128 sharing D128's i128 BID
# storage (see Decimal.rf), so every math routine here reinterprets to `D128` via
# `dec_to_d128`, runs D128's already-34-digit-correct transcendental (the W=192
# UnpackedFloat engine in D128Trans.rf), and wraps the result back with
# `dec_of_d128`. Decimal is finite-only, so:
#   * the FAILABLE D128 routines (exp!, log!, sqrt!, pow!, asin!, ...) crash on a
#     non-finite RESULT before returning — their return is always finite, so the
#     plain `dec_of_d128` wrap is correct and the crash propagates loudly; and
#   * the total D128 routines (sin, cos, abs, floor, ...) map a finite input to a
#     finite output, so `dec_of_d128` is likewise safe.
# There is NO bespoke Decimal transcendental engine any more — this file is a thin
# forwarding layer over the verified D128 engine.
# ============================================================================

# ============================================================================
# Exponentials
# ============================================================================

### e^me.
routine Decimal.exp!() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).exp())

### e^me - 1, accurate for small me.
routine Decimal.expm1!() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).expm1())

### 2^me.
routine Decimal.exp2!() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).exp2())

### 10^me.
routine Decimal.exp10!() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).exp10())

# ============================================================================
# Logarithms
# ============================================================================

### Natural logarithm ln(me).
routine Decimal.log!() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).log())

### ln(1 + me), accurate for small me.
routine Decimal.log1p!() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).log1p())

### Base-2 logarithm log2(me).
routine Decimal.log2!() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).log2())

### Base-10 logarithm log10(me).
routine Decimal.log10!() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).log10())

# ============================================================================
# Powers / roots
# ============================================================================

### me raised to the power `you`.
routine Decimal.pow!(you: Decimal) -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).pow(you: dec_to_d128(x: you)))

### Square root of me.
routine Decimal.sqrt!() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).sqrt())

### Cube root of me.
routine Decimal.cbrt() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).cbrt())

### Euclidean norm sqrt(x^2 + y^2), computed without overflow/underflow.
routine hypot(x: Decimal, y: Decimal) -> Decimal
  return dec_of_d128(x: hypot(x: dec_to_d128(x: x), y: dec_to_d128(x: y)))

### 3D Euclidean norm sqrt(x^2 + y^2 + z^2), computed without overflow/underflow.
routine hypot(x: Decimal, y: Decimal, z: Decimal) -> Decimal
  return dec_of_d128(x: hypot(x: dec_to_d128(x: x), y: dec_to_d128(x: y), z: dec_to_d128(x: z)))

### Fused multiply-add me*b + c with a single rounding.
routine Decimal.fma!(b: Decimal, c: Decimal) -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).fma(b: dec_to_d128(x: b), c: dec_to_d128(x: c)))

# ============================================================================
# Trigonometric
# ============================================================================

### Sine of me (radians).
routine Decimal.sin() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).sin())

### Cosine of me (radians).
routine Decimal.cos() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).cos())

### Tangent of me (radians).
routine Decimal.tan() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).tan())

### Arcsine of me (result in radians).
routine Decimal.asin!() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).asin())

### Arccosine of me (result in radians).
routine Decimal.acos!() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).acos())

### Arctangent of me (result in radians).
routine Decimal.atan() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).atan())

### Two-argument arctangent atan2(y, x) (result in radians).
routine atan2(y: Decimal, x: Decimal) -> Decimal
  return dec_of_d128(x: atan2(y: dec_to_d128(x: y), x: dec_to_d128(x: x)))

# ============================================================================
# Hyperbolic
# ============================================================================

### Hyperbolic sine of me.
routine Decimal.sinh!() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).sinh())

### Hyperbolic cosine of me.
routine Decimal.cosh!() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).cosh())

### Hyperbolic tangent of me.
routine Decimal.tanh() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).tanh())

### Inverse hyperbolic sine of me.
routine Decimal.asinh() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).asinh())

### Inverse hyperbolic cosine of me.
routine Decimal.acosh!() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).acosh())

### Inverse hyperbolic tangent of me.
routine Decimal.atanh!() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).atanh())

# ============================================================================
# Special functions
# ============================================================================

### Error function erf(me).
routine Decimal.erf() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).erf())

### Complementary error function erfc(me) = 1 - erf(me).
routine Decimal.erfc() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).erfc())

### Gamma function tgamma(me).
routine Decimal.tgamma!() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).tgamma())

### Natural logarithm of the absolute value of the gamma function, lgamma(me).
routine Decimal.lgamma() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).lgamma())

# ============================================================================
# Sign / inspection
# ============================================================================

### True if me has its sign bit set (negative, including -0).
routine Decimal.signbit() -> Bool
  return dec_to_d128(x: me).signbit()

### True if me is finite and nonzero.
routine Decimal.is_normal() -> Bool
  return dec_to_d128(x: me).is_normal()

### True if me is +-0.
routine Decimal.is_zero() -> Bool
  return dec_to_d128(x: me).is_zero()

### True if me is negative (-0 is negative).
routine Decimal.is_negative() -> Bool
  return dec_to_d128(x: me).is_negative()

### True if me is strictly positive.
routine Decimal.is_positive() -> Bool
  return dec_to_d128(x: me).is_positive()

### True if me is subnormal (finite, nonzero, below the smallest normal).
routine Decimal.is_subnormal() -> Bool
  return dec_to_d128(x: me).is_subnormal()

### -1, 0, or +1 matching the sign of me (+-0 -> +0).
routine Decimal.signum() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).signum())

### C99 fpclassify code (ZERO / SUBNORMAL / NORMAL; a well-formed Decimal is never inf/NaN).
routine Decimal.fpclassify() -> FpClass
  return dec_to_d128(x: me).fpclassify()

# ============================================================================
# Absolute value / negation / sign transfer
# ============================================================================

### Absolute value of me.
routine Decimal.abs() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).abs())

### Negation of me (flips the sign).
routine Decimal.neg() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).neg())

### Magnitude of me with the sign of `you`.
routine Decimal.copysign(you: Decimal) -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).copysign(you: dec_to_d128(x: you)))

# ============================================================================
# Extrema / difference
# ============================================================================

### Larger of me and you (NaN-skipping, per C99 fmax).
routine Decimal.fmax(you: Decimal) -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).fmax(you: dec_to_d128(x: you)))

### Smaller of me and you (NaN-skipping, per C99 fmin).
routine Decimal.fmin(you: Decimal) -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).fmin(you: dec_to_d128(x: you)))

### Positive difference max(me - you, 0).
routine Decimal.fdim(you: Decimal) -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).fdim(you: dec_to_d128(x: you)))

### IEEE minimumNumber(me, you).
routine Decimal.min_num(you: Decimal) -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).min_num(you: dec_to_d128(x: you)))

### IEEE maximumNumber(me, you).
routine Decimal.max_num(you: Decimal) -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).max_num(you: dec_to_d128(x: you)))

### IEEE minimum(me, you).
routine Decimal.minimum(you: Decimal) -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).minimum(you: dec_to_d128(x: you)))

### IEEE maximum(me, you).
routine Decimal.maximum(you: Decimal) -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).maximum(you: dec_to_d128(x: you)))

# ============================================================================
# Remainder
# ============================================================================

### Floating remainder of me / you (C fmod; result has me's sign).
routine Decimal.fmod(you: Decimal) -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).fmod(you: dec_to_d128(x: you)))

### IEEE remainder of me / you (result is the nearest, ties to even).
routine Decimal.remainder(you: Decimal) -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).remainder(you: dec_to_d128(x: you)))

# ============================================================================
# Scaling / exponent
# ============================================================================

### me * 10^n (the decimal analog of ldexp).
routine Decimal.scaleb!(n: S64) -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).scaleb(n: n))

### The base-10 exponent of me (floor(log10(|me|)) as a Decimal).
routine Decimal.logb() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).logb())

# ============================================================================
# Rounding to integral values
# ============================================================================

### Truncates toward zero to an integral value.
routine Decimal.trunc() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).trunc())

### Rounds toward negative infinity (floor).
routine Decimal.floor() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).floor())

### Rounds toward positive infinity (ceil).
routine Decimal.ceil() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).ceil())

### Rounds to the nearest integral value, ties to even.
routine Decimal.round() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).round())

### Rounds to the nearest integral value using the current rounding mode (ties to even).
routine Decimal.rint() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).rint())

### Rounds to the nearest integral value, ties away from zero.
routine Decimal.round_ties_away() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).round_ties_away())

### The fractional part of me (me - trunc(me), carrying me's sign).
routine Decimal.frac() -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).frac())

### Splits me into its integer and fractional parts, both carrying me's sign.
routine Decimal.modf() -> (Decimal, Decimal)
  var ip = me.trunc()
  return (ip, me.sub(you: ip))

# ============================================================================
# Quantum / total ordering
# ============================================================================

### True if me and you have the same quantum (exponent).
routine Decimal.same_quantum(you: Decimal) -> Bool
  return dec_to_d128(x: me).same_quantum(you: dec_to_d128(x: you))

### Rounds me to the quantum (exponent) of you.
routine Decimal.quantize(you: Decimal) -> Decimal
  return dec_of_d128(x: dec_to_d128(x: me).quantize(you: dec_to_d128(x: you)))

### IEEE totalOrder predicate (a total order over all values).
routine Decimal.total_order(you: Decimal) -> Bool
  return dec_to_d128(x: me).total_order(you: dec_to_d128(x: you))

### IEEE totalOrderMag predicate (total order over magnitudes).
routine Decimal.total_order_mag(you: Decimal) -> Bool
  return dec_to_d128(x: me).total_order_mag(you: dec_to_d128(x: you))
