module Core

import Collections
# Core F128 type definition - maps to LLVM fp128

### Represents a 128-bit IEEE 754 binary floating-point value.
### `F128` provides quadruple precision for workloads that need far more range
### and significand precision than `F64`, such as numerical analysis, symbolic
### support code, and high-accuracy scientific routines.
@llvm("fp128")
record F128 obeys Numeric, Ordered
  pass

# IEEE 754 quadruple precision constants
preset F128_EPSILON: F128 = 1.925929944387235853055977942584927319e-34_f128
preset F128_MIN: F128 = -1.189731495357231765085759326628007016e+4932_f128
preset F128_MAX: F128 = 1.189731495357231765085759326628007016e+4932_f128
preset F128_MIN_POSITIVE: F128 = 3.362103143112093506262677817321752602e-4932_f128
preset F128_ZERO: F128 = 0.0_f128
preset F128_ONE: F128 = 1.0_f128

# Mathematical constants with quadruple precision
preset F128_PI: F128 = 3.141592653589793238462643383279502884_f128
preset F128_E: F128 = 2.718281828459045235360287471352662498_f128
preset F128_SQRT_2: F128 = 1.414213562373095048801688724209698079_f128
preset F128_LN_2: F128 = 0.693147180559945309417232121458176568_f128
preset F128_LN_10: F128 = 2.302585092994045684017991454684364208_f128

### Converts an `S8` into quadruple-precision floating-point form.
### :param from: The signed 8-bit integer to convert.
### :returns: The corresponding `F128` value.
routine F128.$create(from: S8) -> F128
  return signed_to_float[S8, F128](from)

### Converts an `S16` into quadruple-precision floating-point form.
### :param from: The signed 16-bit integer to convert.
### :returns: The corresponding `F128` value.
routine F128.$create(from: S16) -> F128
  return signed_to_float[S16, F128](from)

### Converts an `S32` into quadruple-precision floating-point form.
### :param from: The signed 32-bit integer to convert.
### :returns: The corresponding `F128` value.
routine F128.$create(from: S32) -> F128
  return signed_to_float[S32, F128](from)

### Converts an `S64` into quadruple-precision floating-point form.
### :param from: The signed 64-bit integer to convert.
### :returns: The closest representable `F128` value.
routine F128.$create(from: S64) -> F128
  return signed_to_float[S64, F128](from)

### Converts an `S128` into quadruple-precision floating-point form.
### :param from: The signed 128-bit integer to convert.
### :returns: The closest representable `F128` value.
routine F128.$create(from: S128) -> F128
  return signed_to_float[S128, F128](from)

### Converts a `U8` into quadruple-precision floating-point form.
### :param from: The unsigned 8-bit integer to convert.
### :returns: The corresponding `F128` value.
routine F128.$create(from: U8) -> F128
  return unsigned_to_float[U8, F128](from)

### Converts a `U16` into quadruple-precision floating-point form.
### :param from: The unsigned 16-bit integer to convert.
### :returns: The corresponding `F128` value.
routine F128.$create(from: U16) -> F128
  return unsigned_to_float[U16, F128](from)

### Converts a `U32` into quadruple-precision floating-point form.
### :param from: The unsigned 32-bit integer to convert.
### :returns: The corresponding `F128` value.
routine F128.$create(from: U32) -> F128
  return unsigned_to_float[U32, F128](from)

### Converts a `U64` into quadruple-precision floating-point form.
### :param from: The unsigned 64-bit integer to convert.
### :returns: The closest representable `F128` value.
routine F128.$create(from: U64) -> F128
  return unsigned_to_float[U64, F128](from)

### Converts a `U128` into quadruple-precision floating-point form.
### :param from: The unsigned 128-bit integer to convert.
### :returns: The closest representable `F128` value.
routine F128.$create(from: U128) -> F128
  return unsigned_to_float[U128, F128](from)

### Widens a half-precision float to quadruple precision.
### :param from: The `F16` value to widen.
### :returns: An `F128` carrying the same numeric value when representable.
routine F128.$create(from: F16) -> F128
  return float_extend[F16, F128](from)

### Widens a single-precision float to quadruple precision.
### :param from: The `F32` value to widen.
### :returns: An `F128` carrying the same numeric value when representable.
routine F128.$create(from: F32) -> F128
  return float_extend[F32, F128](from)

### Widens a double-precision float to quadruple precision.
### :param from: The `F64` value to widen.
### :returns: An `F128` carrying the same numeric value when representable.
routine F128.$create(from: F64) -> F128
  return float_extend[F64, F128](from)

### Returns an existing `F128` unchanged.
### :param from: The quadruple-precision value to forward.
### :returns: `from`.
routine F128.$create(from: F128) -> F128
  return from

### Converts a decimal32 value to quadruple-precision binary floating point.
### :param from: The decimal floating-point input value.
### :returns: The closest representable `F128` value.
routine F128.$create(from: D32) -> F128
  return rf_d32_to_f128(from.to_bits())

### Converts a decimal64 value to quadruple-precision binary floating point.
### :param from: The decimal floating-point input value.
### :returns: The closest representable `F128` value.
routine F128.$create(from: D64) -> F128
  return rf_d64_to_f128(from.to_bits())

### Converts a decimal128 value to quadruple-precision binary floating point.
### :param from: The decimal floating-point input value.
### :returns: The closest representable `F128` value.
routine F128.$create(from: D128) -> F128
  return rf_d128_to_f128(low: from.low_bits(), high: from.high_bits())

# ============================================================================
# Arithmetic Operations (IEEE 754 semantics)
# ============================================================================

### Returns the sum of this value and the other value.
### :param you: The other value to compare against.
### :returns: The resulting `F128` value.
routine F128.$add!(you: F128) -> F128
  var result = float_add[F128](a: me, b: you)
  if not result.is_finite()
    throw NumericOverflowError(description: f"F128 addition produced non-finite result: {me} + {you}")
  return result

### Returns the difference between this value and the other value.
### :param you: The other value to compare against.
### :returns: The resulting `F128` value.
routine F128.$sub!(you: F128) -> F128
  var result = float_sub[F128](a: me, b: you)
  if not result.is_finite()
    throw NumericOverflowError(description: f"F128 subtraction produced non-finite result: {me} - {you}")
  return result

### Returns the product of this value and the other value.
### :param you: The other value to compare against.
### :returns: The resulting `F128` value.
routine F128.$mul!(you: F128) -> F128
  var result = float_mul[F128](a: me, b: you)
  if not result.is_finite()
    throw NumericOverflowError(description: f"F128 multiplication produced non-finite result: {me} * {you}")
  return result

### Returns the quotient of this value and the other value.
### :param you: The other value to compare against.
### :returns: The resulting `F128` value.
routine F128.$truediv!(you: F128) -> F128
  var result = float_div[F128](a: me, b: you)
  if not result.is_finite()
    throw NumericOverflowError(description: f"F128 division produced non-finite result: {me} / {you}")
  return result

### Returns the negated value.
### :returns: The resulting `F128` value.
routine F128.$neg() -> F128
  return float_neg[F128](me)

### Divides `me` by `you` without overflow checking.
### Returns infinity or NaN on overflow or zero divisor, following raw IEEE 754 semantics.
### :param you: The divisor.
### :returns: The quadruple-precision quotient, possibly infinity or NaN.
dangerous routine F128.$truediv_unchecked(you: F128) -> F128
  return float_div_fast[F128](a: me, b: you)

# ============================================================================
# Comparison Operations (ordered - false if NaN)
# ============================================================================

### Returns whether both values are equal.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
routine F128.$eq(you: F128) -> Bool
  return float_eq[F128](a: me, b: you)

### Compares this value with the other value.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
routine F128.$cmp(you: F128) -> ComparisonSign
  if float_lt[F128](a: me, b: you)
    return ME_SMALL
  if float_gt[F128](a: me, b: you)
    return ME_LARGE
  return SAME

# ============================================================================
# Math Operations using intrinsics
# ============================================================================

### Returns the square root of this value in quadruple precision.
### :returns: The intrinsic square-root result for `me`.
routine F128.sqrt() -> F128
  return sqrt[F128](me)

### Returns the absolute value.
### :returns: The resulting `F128` value.
routine F128.abs() -> F128
  return float_abs[F128](me)

### Rounds this value toward negative infinity.
### :returns: The greatest integral-valued `F128` not larger than `me`.
routine F128.floor() -> F128
  return floor[F128](me)

### Rounds this value toward positive infinity.
### :returns: The smallest integral-valued `F128` not smaller than `me`.
routine F128.ceil() -> F128
  return ceil[F128](me)

### Rounds this value to the nearest integral-valued `F128`.
### :returns: The rounded result in quadruple precision.
routine F128.round() -> F128
  return round[F128](me)

### Discards the fractional part of this value toward zero.
### :returns: The truncated result in quadruple precision.
routine F128.int_truncate() -> F128
  return float_truncate[F128](me)

# ============================================================================
# Trigonometric Functions (via LibBF native runtime)
# ============================================================================

### Returns the sine of this value, interpreting it as radians.
### :returns: The quadruple-precision sine result.
routine F128.sin() -> F128
  return rf_f128_sin(me)

### Returns the cosine of this value, interpreting it as radians.
### :returns: The quadruple-precision cosine result.
routine F128.cos() -> F128
  return rf_f128_cos(me)

### Returns the tangent of this value, interpreting it as radians.
### :returns: The quadruple-precision tangent result.
routine F128.tan() -> F128
  return rf_f128_tan(me)

### Returns the inverse sine of this value.
### :returns: The quadruple-precision arcsine result.
routine F128.asin() -> F128
  return rf_f128_asin(me)

### Returns the inverse cosine of this value.
### :returns: The quadruple-precision arccosine result.
routine F128.acos() -> F128
  return rf_f128_acos(me)

### Returns the inverse tangent of this value.
### :returns: The quadruple-precision arctangent result.
routine F128.atan() -> F128
  return rf_f128_atan(me)

### Returns the polar angle of the point `(x, me)`.
### :param x: The x-coordinate paired with this y-coordinate.
### :returns: The quadrant-aware arctangent result.
routine F128.atan2(x: F128) -> F128
  return rf_f128_atan2(y: me, x: x)

# ============================================================================
# Hyperbolic Functions (via LibBF native runtime)
# ============================================================================

### Returns the hyperbolic sine of this value.
### :returns: The quadruple-precision hyperbolic-sine result.
routine F128.sinh() -> F128
  return rf_f128_sinh(me)

### Returns the hyperbolic cosine of this value.
### :returns: The quadruple-precision hyperbolic-cosine result.
routine F128.cosh() -> F128
  return rf_f128_cosh(me)

### Returns the hyperbolic tangent of this value.
### :returns: The quadruple-precision hyperbolic-tangent result.
routine F128.tanh() -> F128
  return rf_f128_tanh(me)

### Returns the inverse hyperbolic sine of this value.
### :returns: The quadruple-precision inverse-hyperbolic-sine result.
routine F128.asinh() -> F128
  return rf_f128_asinh(me)

### Returns the inverse hyperbolic cosine of this value.
### :returns: The quadruple-precision inverse-hyperbolic-cosine result.
routine F128.acosh() -> F128
  return rf_f128_acosh(me)

### Returns the inverse hyperbolic tangent of this value.
### :returns: The quadruple-precision inverse-hyperbolic-tangent result.
routine F128.atanh() -> F128
  return rf_f128_atanh(me)

# ============================================================================
# Exponential and Logarithmic Functions (via LibBF native runtime)
# ============================================================================

### Returns `e` raised to this value.
### :returns: The quadruple-precision exponential result.
routine F128.exp() -> F128
  return rf_f128_exp(me)

### Returns `2` raised to this value.
### :returns: The quadruple-precision base-2 exponential result.
routine F128.exp2() -> F128
  return rf_f128_exp2(me)

### Returns `exp(me) - 1` with precision suitable for very small inputs.
### :returns: The quadruple-precision exponential-minus-one result.
routine F128.expm1() -> F128
  return rf_f128_expm1(me)

### Returns the natural logarithm of this value.
### :returns: The quadruple-precision natural-log result.
routine F128.log() -> F128
  return rf_f128_log(me)

### Returns the base-2 logarithm of this value.
### :returns: The quadruple-precision binary-log result.
routine F128.log2() -> F128
  return rf_f128_log2(me)

### Returns the base-10 logarithm of this value.
### :returns: The quadruple-precision common-log result.
routine F128.log10() -> F128
  return rf_f128_log10(me)

### Returns `log(1 + me)` with precision suitable for very small inputs.
### :returns: The quadruple-precision log-one-plus result.
routine F128.log1p() -> F128
  return rf_f128_log1p(me)

# ============================================================================
# Power Functions (via LibBF native runtime)
# ============================================================================

### Raises this value to the floating-point power `exp`.
### :param exp: The exponent applied to `me`.
### :returns: `me` raised to `exp` in quadruple precision.
routine F128.pow(exp: F128) -> F128
  return rf_f128_pow(base: me, exp: exp)

### Raises this value to `exp` and rejects non-finite results.
### :param exp: The exponent applied to `me`.
### :returns: `me` raised to `exp` in quadruple precision.
routine F128.$pow!(exp: F128) -> F128
  var result = me.pow(exp)
  if not result.is_finite()
    throw NumericOverflowError(description: f"F128 power produced non-finite result: {me} ** {exp}")
  return result

### Returns the real cube root of this value.
### :returns: The quadruple-precision cube-root result.
routine F128.cbrt() -> F128
  return rf_f128_cbrt(me)

### Returns the Euclidean length of the vector `(me, y)`.
### :param y: The second coordinate.
### :returns: `sqrt(me * me + y * y)` computed by the runtime helper.
routine F128.hypot(y: F128) -> F128
  return rf_f128_hypot(x: me, y: y)

### Returns this value with its sign bit replaced by the sign of `sign`.
### :param sign: The value supplying the sign bit.
### :returns: A value with the magnitude of `me` and the sign of `sign`.
routine F128.copysign(sign: F128) -> F128
  return rf_f128_copysign(value: me, sign: sign)

# ============================================================================
# Utility Methods
# ============================================================================

### Returns the smaller of this value and `you`.
### :param you: The value to compare against.
### :returns: The lower of the two values under the ordered comparison rules.
routine F128.min(you: F128) -> F128
  return if me <= you then me else you

### Returns the larger of this value and `you`.
### :param you: The value to compare against.
### :returns: The greater of the two values under the ordered comparison rules.
routine F128.max(you: F128) -> F128
  return if me >= you then me else you

### Restricts this value to the closed interval `[min_val, max_val]`.
### :param min_val: The lower bound to enforce.
### :param max_val: The upper bound to enforce.
### :returns: `me` if already in range, otherwise the nearest bound.
routine F128.clamp(min_val: F128, max_val: F128) -> F128
  return me.min(max_val).max(min_val)

### Returns `true` if this value is strictly positive (greater than zero).
### :returns: `true` if `me > 0.0`.
routine F128.is_positive() -> Bool
  return me > 0.0_f128

### Returns `true` if this value is strictly negative (less than zero).
### :returns: `true` if `me < 0.0`.
routine F128.is_negative() -> Bool
  return me < 0.0_f128

### Returns `true` if this value compares equal to zero.
### :returns: `true` if `me == 0.0`.
routine F128.is_zero() -> Bool
  return me == 0.0_f128

### Returns the sign of this value as `-1.0`, `0.0`, or `1.0`.
### :returns: A unit-sign value describing the sign of `me`.
routine F128.signum() -> F128
  return when
    me > 0.0_f128 => 1.0_f128
    me < 0.0_f128 => -1.0_f128
    else => 0.0_f128

### Reinterprets this float as its raw IEEE 754 bit pattern.
### :returns: The underlying `U128` encoding of this value.
routine F128.to_bits() -> U128
  return reinterpret_bits[F128, U128](me)

### Returns the low 64 bits of the raw `F128` encoding.
### :returns: The least-significant half of the bit pattern.
routine F128.low_bits() -> U64
  return int_truncate[U128, U64](me.to_bits())

### Returns the high 64 bits of the raw `F128` encoding.
### :returns: The most-significant half of the bit pattern.
routine F128.high_bits() -> U64
  return int_truncate[U128, U64](me.to_bits() >>> 64u32)

### Reinterprets a raw IEEE 754 bit pattern as an `F128`.
### :param bits: The exact quadruple-precision encoding to decode.
### :returns: The `F128` value with that bit pattern.
common routine F128.from_bits(bits: U128) -> F128
  return reinterpret_bits[U128, F128](bits)

# ============================================================================
# Classification
# ============================================================================

### Returns `true` when this value encodes an IEEE 754 NaN.
### :returns: Whether the bit pattern represents a not-a-number payload.
routine F128.is_nan() -> Bool
  # F128: bit 127=sign, bits 126-112=exponent (15 bits), bits 111-0=mantissa (112 bits)
  # NaN = exponent all-ones (0x7FFF) AND mantissa != 0
  var bits = me.to_bits()
  var hi = int_truncate[U128, U64](bits >>> 64u32)
  var lo = int_truncate[U128, U64](bits)
  var exponent = bit_and[U64](shift_right_unsigned[U64](hi, 48_u32), 0x7FFF_u64)
  var hi_mantissa = bit_and[U64](a: hi, b: 0x0000_FFFF_FFFF_FFFF_u64)
  return exponent == 0x7FFF_u64 and (hi_mantissa != 0_u64 or lo != 0_u64)

### Returns `true` when this value encodes positive or negative infinity.
### :returns: Whether the bit pattern represents an infinity.
routine F128.is_infinite() -> Bool
  # F128: bit 127=sign, bits 126-112=exponent (15 bits), bits 111-0=mantissa (112 bits)
  # Infinity = exponent all-ones (0x7FFF) AND mantissa == 0
  var bits = me.to_bits()
  var hi = int_truncate[U128, U64](bits >>> 64u32)
  var lo = int_truncate[U128, U64](bits)
  var exponent = bit_and[U64](shift_right_unsigned[U64](hi, 48_u32), 0x7FFF_u64)
  var hi_mantissa = bit_and[U64](a: hi, b: 0x0000_FFFF_FFFF_FFFF_u64)
  return exponent == 0x7FFF_u64 and hi_mantissa == 0_u64 and lo == 0_u64

### Returns `true` when this value is neither NaN nor infinity.
### :returns: Whether the value is finite.
routine F128.is_finite() -> Bool
  return not me.is_nan() and not me.is_infinite()

### Returns `true` when this is a finite, non-zero, non-subnormal value.
### :returns: Whether the value is a normal IEEE 754 number.
routine F128.is_normal() -> Bool
  return me.is_finite() and not me.is_zero() and not me.is_subnormal()

### Returns `true` when this value is finite, non-zero, and encoded with an exponent of zero.
### :returns: Whether the value is subnormal.
routine F128.is_subnormal() -> Bool
  var bits = me.to_bits()
  var hi = int_truncate[U128, U64](bits >>> 64u32)
  var exponent = bit_and[U64](shift_right_unsigned[U64](hi, 48_u32), 0x7FFF_u64)
  return exponent == 0_u64 and not me.is_zero()

# ============================================================================
# Clamping Arithmetic
# ============================================================================

### Returns `me + you`, clamped to `±F128_MAX` if the result overflows to infinity.
### :param you: The addend.
### :returns: The sum, or `F128_MAX` / `-F128_MAX` if the result would be infinite.
routine F128.$add_clamp(you: F128) -> F128
  var result = float_add[F128](a: me, b: you)
  if result.is_infinite()
    return if result.is_positive() then F128_MAX else float_neg[F128](F128_MAX)
  return result

### Returns `me - you`, clamped to `±F128_MAX` if the result overflows to infinity.
### :param you: The value to subtract.
### :returns: The difference, or `F128_MAX` / `-F128_MAX` if the result would be infinite.
routine F128.$sub_clamp(you: F128) -> F128
  var result = float_sub[F128](a: me, b: you)
  if result.is_infinite()
    return if result.is_positive() then F128_MAX else float_neg[F128](F128_MAX)
  return result

### Returns `me * you`, clamped to `±F128_MAX` if the result overflows to infinity.
### :param you: The multiplier.
### :returns: The product, or `F128_MAX` / `-F128_MAX` if the result would be infinite.
routine F128.$mul_clamp(you: F128) -> F128
  var result = float_mul[F128](a: me, b: you)
  if result.is_infinite()
    return if result.is_positive() then F128_MAX else float_neg[F128](F128_MAX)
  return result

### Returns `me / you`, clamped to `±F128_MAX` if the result overflows to infinity.
### :param you: The divisor.
### :returns: The quotient, or `F128_MAX` / `-F128_MAX` if the result would be infinite.
routine F128.$truediv_clamp(you: F128) -> F128
  var result = float_div[F128](a: me, b: you)
  if result.is_infinite()
    return if result.is_positive() then F128_MAX else float_neg[F128](F128_MAX)
  return result

### Returns `me ** exp`, clamped to `±F128_MAX` if the result overflows to infinity.
### :param exp: The exponent applied to `me`.
### :returns: The power, or `F128_MAX` / `-F128_MAX` if the result would be infinite.
routine F128.$pow_clamp(exp: F128) -> F128
  var result = rf_f128_pow(base: me, exp: exp)
  if result.is_infinite()
    return if result.is_positive() then F128_MAX else float_neg[F128](F128_MAX)
  return result

# ============================================================================
# Integer Conversions
# ============================================================================

### Converts this value to `S64` by first narrowing to `F64`, then truncating toward zero.
### Values outside the `S64` range or non-finite inputs produce unspecified results.
### :returns: The truncated `S64` value.
routine F128.S64!() -> S64
  return me.F64!().S64!()

### Converts this value to `S128` by first narrowing to `F64`, then truncating toward zero.
### Values outside the `S128` range or non-finite inputs produce unspecified results.
### :returns: The truncated `S128` value.
routine F128.S128!() -> S128
  return me.F64!().S128!()

# ============================================================================
# Float Precision Conversions
# ============================================================================

### Narrows this quadruple-precision value to single precision.
### :returns: The nearest representable `F32` value.
routine F128.F32() -> F32
  return float_narrow[F128, F32](me)

### Narrows this quadruple-precision value to double precision.
### :returns: The nearest representable `F64` value.
routine F128.F64() -> F64
  return float_narrow[F128, F64](me)

# ============================================================================
# Diagnostics and Hashing
# ============================================================================

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
routine F128.$diagnose() -> ?Text
  return Text(from: me)

### Returns a stable hash derived from the raw floating-point encoding.
### NaN payloads and negative zero are normalized so equal numeric values hash
### identically under RazorForge's equality rules.
### :returns: The hash code for this value.
routine F128.hash() -> U64
  var bits = me.to_bits()
  var lo = int_truncate[U128, U64](bits)
  var hi = int_truncate[U128, U64](bits >>> 64u32)
  if me.is_nan()
    lo = 0_u64
    hi = 0x7FFF800000000000_u64
  if bits == shift_left[U128](zero_extend[U64, U128](0x8000000000000000_u64), 64_u128)
    lo = 0_u64
    hi = 0_u64
  return bit_xor[U64](lo, mul[U64](a: hi, b: 1099511628211_u64))

# ============================================================================
# Text Representation and Parsing
# ============================================================================

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
routine F128.$represent() -> ?Text
  var cstr_result = rf_format_F128(me)
  return Text(from: CStr(from_ptr: cstr_result))

### Implements the wired routine behavior for this value.
### :param from_text: The `from_text` value.
### :returns: The resulting `F128` value.
### :throws: May throw {InvalidValueError}.
routine F128.$create!(from_text: Text) -> F128
  var len = from_text.count()
  if len == 0u64
    throw InvalidValueError(input: from_text, target: "F128")
  var i = 0u64
  var first = from_text[0u64]
  if first == Character(0x002Bu32) or first == Character(0x002Du32)
    i = 1u64
    if i >= len
      throw InvalidValueError(input: from_text, target: "F128")
  var special = false
  var rest = len - i
  if rest >= 3u64
    var c0 = from_text[i].to_lowercase()
    var c1 = from_text[i + 1u64].to_lowercase()
    var c2 = from_text[i + 2u64].to_lowercase()
    if rest == 3u64 and c0 == Character(0x006Eu32) and c1 == Character(0x0061u32) and c2 == Character(0x006Eu32)
      special = true
    if rest == 3u64 and c0 == Character(0x0069u32) and c1 == Character(0x006Eu32) and c2 == Character(0x0066u32)
      special = true
    if not special and rest == 8u64 and c0 == Character(0x0069u32) and c1 == Character(0x006Eu32) and c2 == Character(0x0066u32)
      var c3 = from_text[i + 3u64].to_lowercase()
      var c4 = from_text[i + 4u64].to_lowercase()
      var c5 = from_text[i + 5u64].to_lowercase()
      var c6 = from_text[i + 6u64].to_lowercase()
      var c7 = from_text[i + 7u64].to_lowercase()
      if c3 == Character(0x0069u32) and c4 == Character(0x006Eu32) and c5 == Character(0x0069u32) and c6 == Character(0x0074u32) and c7 == Character(0x0079u32)
        special = true
  if not special
    var has_digit = false
    var has_dot = false
    var has_exp = false
    while i < len
      var ch = from_text[i]
      if ch.is_numeric()
        has_digit = true
      elseif ch == Character(0x002Eu32)
        if has_dot or has_exp
          throw InvalidValueError(input: from_text, target: "F128")
        has_dot = true
      elseif ch == Character(0x0065u32) or ch == Character(0x0045u32)
        if has_exp or not has_digit
          throw InvalidValueError(input: from_text, target: "F128")
        has_exp = true
        has_digit = false
        if i + 1u64 < len
          var next_ch = from_text[i + 1u64]
          if next_ch == Character(0x002Bu32) or next_ch == Character(0x002Du32)
            i = i + 1u64
      else
        throw InvalidValueError(input: from_text, target: "F128")
      i = i + 1u64
    if not has_digit
      throw InvalidValueError(input: from_text, target: "F128")
  var cstr_val = CStr(from: from_text)
  var result: F128 = 0.0f128
  danger!
    rf_parse_F128(cstr: cstr_val, out: result.hijack())
  return result

# ============================================================================
# Hashing
# ============================================================================

### Returns a hash of this value.
### :returns: The resulting `U64` value.
routine F128.$fast_hash() -> U64
  return __hash_u128(v: reinterpret_bits[F128, U128](me))

# ============================================================================
# Byte Representation
# ============================================================================

### Returns the raw bytes of this value in little-endian order.
### :returns: The resulting `Array[Byte, 16]` value.
routine F128.to_bytes_le() -> Array[Byte, 16]
  var raw = reinterpret_bits[F128, U128](me)
  var lo = int_truncate[U128, U64](raw)
  var hi = int_truncate[U128, U64](raw >>> 64u32)
  var result = Array[Byte, 16]()
  result = set_byte_at(array: result, index: 0_u64, value: int_truncate[U64, U8](lo))
  result = set_byte_at(array: result, index: 1_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 8_u64)))
  result = set_byte_at(array: result, index: 2_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 16_u64)))
  result = set_byte_at(array: result, index: 3_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 24_u64)))
  result = set_byte_at(array: result, index: 4_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 32_u64)))
  result = set_byte_at(array: result, index: 5_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 40_u64)))
  result = set_byte_at(array: result, index: 6_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 48_u64)))
  result = set_byte_at(array: result, index: 7_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 56_u64)))
  result = set_byte_at(array: result, index: 8_u64, value: int_truncate[U64, U8](hi))
  result = set_byte_at(array: result, index: 9_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 8_u64)))
  result = set_byte_at(array: result, index: 10_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 16_u64)))
  result = set_byte_at(array: result, index: 11_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 24_u64)))
  result = set_byte_at(array: result, index: 12_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 32_u64)))
  result = set_byte_at(array: result, index: 13_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 40_u64)))
  result = set_byte_at(array: result, index: 14_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 48_u64)))
  result = set_byte_at(array: result, index: 15_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 56_u64)))
  return result

### Returns the raw bytes of this value in big-endian order.
### :returns: The resulting `Array[Byte, 16]` value.
routine F128.to_bytes_be() -> Array[Byte, 16]
  var raw = reinterpret_bits[F128, U128](me)
  var lo = int_truncate[U128, U64](raw >>> 64u32)
  var hi = int_truncate[U128, U64](raw)
  lo = byte_swap[U64](lo)
  hi = byte_swap[U64](hi)
  var result = Array[Byte, 16]()
  result = set_byte_at(array: result, index: 0_u64, value: int_truncate[U64, U8](lo))
  result = set_byte_at(array: result, index: 1_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 8_u64)))
  result = set_byte_at(array: result, index: 2_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 16_u64)))
  result = set_byte_at(array: result, index: 3_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 24_u64)))
  result = set_byte_at(array: result, index: 4_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 32_u64)))
  result = set_byte_at(array: result, index: 5_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 40_u64)))
  result = set_byte_at(array: result, index: 6_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 48_u64)))
  result = set_byte_at(array: result, index: 7_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 56_u64)))
  result = set_byte_at(array: result, index: 8_u64, value: int_truncate[U64, U8](hi))
  result = set_byte_at(array: result, index: 9_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 8_u64)))
  result = set_byte_at(array: result, index: 10_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 16_u64)))
  result = set_byte_at(array: result, index: 11_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 24_u64)))
  result = set_byte_at(array: result, index: 12_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 32_u64)))
  result = set_byte_at(array: result, index: 13_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 40_u64)))
  result = set_byte_at(array: result, index: 14_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 48_u64)))
  result = set_byte_at(array: result, index: 15_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 56_u64)))
  return result

### Returns a keyed hash of this value using SipHash-2-4.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: The resulting `U64` value.
routine F128.$hash(k0: U64, k1: U64) -> U64
  return __secure_hash_u128(v: reinterpret_bits[F128, U128](me), k0: k0, k1: k1)
