### Restricts this value to the closed interval `[min_val, max_val]`.
### :param min_val: The lower bound to enforce.
### :param max_val: The upper bound to enforce.
### :returns: `me` if already in range, otherwise the nearest bound.
@positional
routine F128.clamp(min_val: F128, max_val: F128) -> F128
  return me.min(max_val).max(min_val)

### Returns the sign of this value as `-1.0`, `0.0`, or `1.0`.
### :returns: A unit-sign value describing the sign of `me`.
routine F128.signum() -> F128
  return when
    me > 0.0_f128 => 1.0_f128
    me < 0.0_f128 => -1.0_f128
    else => 0.0_f128

### Returns the low 64 bits of the raw `F128` encoding.
### :returns: The least-significant half of the bit pattern.
routine F128.low_bits() -> U64
  return int_truncate[U128, U64](me.to_bits())

### Returns the high 64 bits of the raw `F128` encoding.
### :returns: The most-significant half of the bit pattern.
routine F128.high_bits() -> U64
  return int_truncate[U128, U64](me.to_bits() >>> 64u32)

# ============================================================================
# Classification
# ============================================================================

# ============================================================================
# Clamping Arithmetic
# ============================================================================

### Returns `me + you`, clamped to `±F128_MAX` if the result overflows to infinity.
### :param you: The addend.
### :returns: The sum, or `F128_MAX` / `-F128_MAX` if the result would be infinite.
routine F128.$add_clamp(you: F128) -> F128
  var result = me + you
  if result.is_infinite()
    return if result.is_positive() then F128_MAX else F128_MIN
  return result

### Returns `me - you`, clamped to `±F128_MAX` if the result overflows to infinity.
### :param you: The value to subtract.
### :returns: The difference, or `F128_MAX` / `-F128_MAX` if the result would be infinite.
routine F128.$sub_clamp(you: F128) -> F128
  var result = me - you
  if result.is_infinite()
    return if result.is_positive() then F128_MAX else F128_MIN
  return result

### Returns `me * you`, clamped to `±F128_MAX` if the result overflows to infinity.
### :param you: The multiplier.
### :returns: The product, or `F128_MAX` / `-F128_MAX` if the result would be infinite.
routine F128.$mul_clamp(you: F128) -> F128
  var result = me * you
  if result.is_infinite()
    return if result.is_positive() then F128_MAX else F128_MIN
  return result

### Returns `me / you`, clamped to `±F128_MAX` if the result overflows to infinity.
### :param you: The divisor.
### :returns: The quotient, or `F128_MAX` / `-F128_MAX` if the result would be infinite.
routine F128.$truediv_clamp(you: F128) -> F128
  var result = me / you
  if result.is_infinite()
    return if result.is_positive() then F128_MAX else F128_MIN
  return result

### Returns `me ** exp`, clamped to `±F128_MAX` if the result overflows to infinity.
### :param exp: The exponent applied to `me`.
### :returns: The power, or `F128_MAX` / `-F128_MAX` if the result would be infinite.
routine F128.$pow_clamp(exp: F128) -> F128
  var result = me ** exp
  if result.is_infinite()
    return if result.is_positive() then F128_MAX else F128_MIN
  return result

# ============================================================================
# Integer Conversions
# ============================================================================

### Converts this value to `S64` by first narrowing to `F64`, then truncating toward zero.
### Values outside the `S64` range or non-finite inputs produce unspecified results.
### :returns: The truncated `S64` value.
routine F128.S64!() -> S64
  return me.F64!().S64!()

### Converts this value to `S128` by first narrowing to `F64`, then truncating toward zero.
### Values outside the `S128` range or non-finite inputs produce unspecified results.
### :returns: The truncated `S128` value.
routine F128.S128!() -> S128
  return me.F64!().S128!()

# ============================================================================
# Float Precision Conversions
# ============================================================================

### Shifts `sig` right by `drop` bits, rounding to nearest with ties to even.
### Used by the `F128 -> F64` narrowing to discard the low significand bits.
### :param sig: The significand to round (up to 113 significant bits).
### :param drop: The count of low bits to discard.
### :returns: The rounded, right-shifted magnitude.
routine f128_rshift_rne(sig: U128, drop: U64) -> U64
  if drop == 0_u64
    return int_truncate[U128, U64](sig)
  if drop >= 128_u64
    return 0_u64
  var dm1 = zero_extend[U64, U128](sub[U64](a: drop, b: 1_u64))
  var keep = int_truncate[U128, U64](shift_right_unsigned[U128](sig, zero_extend[U64, U128](drop)))
  var roundbit = int_truncate[U128, U64](bit_and[U128](a: shift_right_unsigned[U128](sig, dm1), b: 1_u128))
  var stickymask = sub[U128](a: shift_left[U128](1_u128, dm1), b: 1_u128)
  var sticky = int_ne[U128](a: bit_and[U128](a: sig, b: stickymask), b: 0_u128)
  if roundbit == 1_u64 and (sticky or bit_and[U64](a: keep, b: 1_u64) == 1_u64)
    return add[U64](a: keep, b: 1_u64)
  return keep

### Narrows this quadruple-precision value to single precision.
### :returns: The nearest representable `F32` value.
routine F32.$create(from: F128) -> F32
  # F128 -> F64 (correctly rounded) -> F32 (native fptrunc). The wide F64 slack
  # makes the second rounding faithful for all but pathological double-round ties.
  return float_narrow[F64, F32](F64(from: from))

### Narrows this quadruple-precision value to double precision (correctly rounded,
### pure bit surgery — F128 is an i128 carrier, so no LLVM `fptrunc` is available).
### Handles inf/NaN, overflow to ±inf, the F64 subnormal range, and underflow to ±0.
### :returns: The nearest representable `F64` value (round-to-nearest-ties-to-even).
routine F64.$create(from: F128) -> F64
  var raw = from.to_bits()
  var sign = int_truncate[U128, U64](shift_right_unsigned[U128](raw, 127_u128))
  var E = int_truncate[U128, U64](bit_and[U128](a: shift_right_unsigned[U128](raw, 112_u128), b: 32767_u128))
  var M = bit_and[U128](a: raw, b: sub[U128](a: shift_left[U128](1_u128, 112_u128), b: 1_u128))
  var sbit = shift_left[U64](sign, 63_u64)
  var inf64 = bit_or[U64](a: sbit, b: 0x7FF0000000000000_u64)
  # inf / NaN: exponent all ones.
  if E == 0x7FFF_u64
    if int_eq[U128](a: M, b: 0_u128)
      return reinterpret_bits[U64, F64](inf64)
    return reinterpret_bits[U64, F64](bit_or[U64](a: sbit, b: 0x7FF8000000000000_u64))
  # F128 zero or F128-subnormal: far below the F64 minimum -> signed zero.
  if E == 0_u64
    return reinterpret_bits[U64, F64](sbit)
  var sig = bit_or[U128](a: shift_left[U128](1_u128, 112_u128), b: M)
  var e64s = sub[S64](a: reinterpret_bits[U64, S64](E), b: 15360_s64)
  # overflow.
  if signed_ge[S64](a: e64s, b: 2047_s64)
    return reinterpret_bits[U64, F64](inf64)
  # normal F64 result.
  if signed_ge[S64](a: e64s, b: 1_s64)
    var r = f128_rshift_rne(sig: sig, drop: 60_u64)
    var exp = reinterpret_bits[S64, U64](e64s)
    if r >= shift_left[U64](1_u64, 53_u64)
      exp = add[U64](a: exp, b: 1_u64)
      r = shift_right_unsigned[U64](r, 1_u64)
      if exp >= 2047_u64
        return reinterpret_bits[U64, F64](inf64)
    var mant = bit_and[U64](a: r, b: sub[U64](a: shift_left[U64](1_u64, 52_u64), b: 1_u64))
    return reinterpret_bits[U64, F64](bit_or[U64](a: bit_or[U64](a: sbit, b: shift_left[U64](exp, 52_u64)), b: mant))
  # subnormal F64 result or underflow to zero.
  var drop = sub[S64](a: 61_s64, b: e64s)
  var rs = f128_rshift_rne(sig: sig, drop: reinterpret_bits[S64, U64](drop))
  if rs == 0_u64
    return reinterpret_bits[U64, F64](sbit)
  # rounding up across the subnormal/normal boundary yields the smallest normal.
  if rs >= shift_left[U64](1_u64, 52_u64)
    return reinterpret_bits[U64, F64](bit_or[U64](a: sbit, b: shift_left[U64](1_u64, 52_u64)))
  return reinterpret_bits[U64, F64](bit_or[U64](a: sbit, b: rs))

# ============================================================================
# Diagnostics and Hashing
# ============================================================================

### Returns a stable hash derived from the raw floating-point encoding.
### NaN payloads and negative zero are normalized so equal numeric values hash
### identically under RazorForge's equality rules.
### :returns: The hash code for this value.
routine F128.hash() -> U64
  var bits = me.to_bits()
  var lo = int_truncate[U128, U64](bits)
  var hi = int_truncate[U128, U64](bits >>> 64u32)
  if me.is_nan()
    lo = 0u64
    hi = 0x7FFF800000000000u64
  if bits == shift_left[U128](zero_extend[U64, U128](0x8000000000000000u64), 64_u128)
    lo = 0u64
    hi = 0u64
  return bit_xor[U64](lo, mul[U64](a: hi, b: 1099511628211_u64))

# ============================================================================
# Text Representation and Parsing
# ============================================================================

### Returns `5^k` as a U256 (exact for `k <= 110`). Used to detect/resolve exact-tie
### decimal inputs during parsing (a negative-exponent tie needs `5^|exp|` to divide the
### coefficient). Cheap: at most ~56 multiplies, only on the rare tie path.
### :param k: The non-negative power.
### :returns: `5^k`.
routine f128_pow5(k: S64) -> U256
  var r = zero_extend[U64, U256](1_u64)
  var five = zero_extend[U64, U256](5_u64)
  var i = 0_s64
  while signed_lt[S64](a: i, b: k)
    r = mul[U256](a: r, b: five)
    i = add[S64](a: i, b: 1_s64)
  return r

### Parses decimal text into the correctly-rounded `F128` (provably, round-to-nearest-even).
### :param from_text: The decimal literal.
### :returns: The correctly-rounded `F128` value.
### :throws: {InvalidValueError} on malformed input.
routine F128.$create!(from_text: Text) -> F128
  # PROVABLY-CORRECT decimal->binary128. FAST PATH: `coeff x 10^exp` in F512 (489-bit
  # significand) is correctly-rounded for EVERY non-tie input — its ~2^-475 error is far
  # below the ~2^-239 worst-case decimal->F128 separation. EXACT TIES (the round-half-even
  # cases a fast path can't see) provably need exp in [-56,55]; for exp>=0 the F512 product
  # is exact anyway, and for exp<0 a tie requires 5^|exp| | coeff, in which case
  # V = (coeff / 5^|exp|) x 2^exp is EXACT in F512 via ldexp and resolved with bounded U256.
  # No bignum, no module-Numerics dependency, no table beyond the existing f512_pow10.
  var p = scan_decimal_parts!(from_text: from_text)
  if int_eq[U64](a: p.special, b: 0_u64) and int_ne[U128](a: p.coeff, b: 0_u128) and signed_lt[S64](a: p.exp, b: 0_s64) and signed_ge[S64](a: p.exp, b: -56_s64)
    var p5 = f128_pow5(k: sub[S64](a: 0_s64, b: p.exp))
    var cw = zero_extend[U128, U256](p.coeff)
    if int_eq[U256](a: unsigned_rem[U256](a: cw, b: p5), b: zero_extend[U64, U256](0_u64))
      var m = unsigned_div[U256](a: cw, b: p5)
      var r = uf512_from_u256(c: m).ldexp(e: p.exp).to_f128()
      return if p.sign then r.$neg() else r
  return d128parts_to_f512(p: p).to_uf().to_f128()

# ============================================================================
# Hashing
# ============================================================================

### Returns a hash of this value.
### :returns: The resulting `U64` value.
routine F128.$fast_hash() -> U64
  return __hash_u128(v: reinterpret_bits[F128, U128](me))

# ============================================================================
# Byte Representation
# ============================================================================

### Returns the raw bytes of this value in little-endian order.
### :returns: The resulting `Array[Byte, 16]` value.
routine F128.to_bytes_le() -> Array[Byte, 16]
  var raw = reinterpret_bits[F128, U128](me)
  var lo = int_truncate[U128, U64](raw)
  var hi = int_truncate[U128, U64](raw >>> 64u32)
  var result = Array[Byte, 16]()
  result = set_byte_at(array: result, index: 0u64, value: int_truncate[U64, U8](lo))
  result = set_byte_at(array: result, index: 1_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 8_u64)))
  result = set_byte_at(array: result, index: 2_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 16_u64)))
  result = set_byte_at(array: result, index: 3_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 24_u64)))
  result = set_byte_at(array: result, index: 4_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 32_u64)))
  result = set_byte_at(array: result, index: 5_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 40u64)))
  result = set_byte_at(array: result, index: 6_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 48_u64)))
  result = set_byte_at(array: result, index: 7_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 56_u64)))
  result = set_byte_at(array: result, index: 8_u64, value: int_truncate[U64, U8](hi))
  result = set_byte_at(array: result, index: 9_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 8_u64)))
  result = set_byte_at(array: result, index: 10u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 16_u64)))
  result = set_byte_at(array: result, index: 11_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 24_u64)))
  result = set_byte_at(array: result, index: 12_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 32_u64)))
  result = set_byte_at(array: result, index: 13_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 40u64)))
  result = set_byte_at(array: result, index: 14_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 48_u64)))
  result = set_byte_at(array: result, index: 15_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 56_u64)))
  return result

### Returns the raw bytes of this value in big-endian order.
### :returns: The resulting `Array[Byte, 16]` value.
routine F128.to_bytes_be() -> Array[Byte, 16]
  var raw = reinterpret_bits[F128, U128](me)
  var lo = int_truncate[U128, U64](raw >>> 64u32)
  var hi = int_truncate[U128, U64](raw)
  lo = byte_swap[U64](lo)
  hi = byte_swap[U64](hi)
  var result = Array[Byte, 16]()
  result = set_byte_at(array: result, index: 0u64, value: int_truncate[U64, U8](lo))
  result = set_byte_at(array: result, index: 1_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 8_u64)))
  result = set_byte_at(array: result, index: 2_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 16_u64)))
  result = set_byte_at(array: result, index: 3_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 24_u64)))
  result = set_byte_at(array: result, index: 4_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 32_u64)))
  result = set_byte_at(array: result, index: 5_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 40u64)))
  result = set_byte_at(array: result, index: 6_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 48_u64)))
  result = set_byte_at(array: result, index: 7_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](lo, 56_u64)))
  result = set_byte_at(array: result, index: 8_u64, value: int_truncate[U64, U8](hi))
  result = set_byte_at(array: result, index: 9_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 8_u64)))
  result = set_byte_at(array: result, index: 10u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 16_u64)))
  result = set_byte_at(array: result, index: 11_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 24_u64)))
  result = set_byte_at(array: result, index: 12_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 32_u64)))
  result = set_byte_at(array: result, index: 13_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 40u64)))
  result = set_byte_at(array: result, index: 14_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 48_u64)))
  result = set_byte_at(array: result, index: 15_u64, value: int_truncate[U64, U8](shift_right_unsigned[U64](hi, 56_u64)))
  return result

### Returns a keyed hash of this value using SipHash-2-4.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: The resulting `U64` value.
routine F128.$hash(k0: U64, k1: U64) -> U64
  return __secure_hash_u128(v: reinterpret_bits[F128, U128](me), k0: k0, k1: k1)
