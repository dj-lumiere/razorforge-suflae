module Core

# ============================================================================
# B128 transcendentals — faithful ports of TLFloat's Quad math. The cores are
# WIDTH-GENERIC member routines on UnpackedFloat[M, L, W]. EVERY B128 transcendental
# now computes on the UNIFORM W=192 engine (UnpackedFloat[U192, U384, 192]): a 192-bit
# mantissa carries 79 guard bits over B128's 113-bit significand, so all of them are
# faithfully ~1 ULP. (B128 DIRECT arithmetic add/sub/mul/div stays on the W=128 packed
# core; only the transcendentals route through W=192.) Constants/coefficients come from
# B128Const.rf (W-dispatched; every table has a W==192 branch). Each B128 method casts
# in via me.to_uf192() and out via .to_b128().
# ============================================================================

### exp on the unpacked engine (TLFloat exp_, N=20, M=1).
routine UnpackedFloat[M, L, W].exp(n: S64) -> UnpackedFloat[M, L, W]
  # W=320 (the Decimal engine) overrides the degree to 36 for 70+ digit accuracy.
  if LLVM::int_eq[U64](a: W, b: 512_u64) or LLVM::int_eq[U64](a: W, b: 320_u64)
    n = 36_s64
  # |me| > ~2^28 over/underflows: +inf for positive, +0 for negative.
  if LLVM::signed_gt(a: me.exp, b: 28_s64)
    if me.sign()
      return UnpackedFloat[M, L, W].zero(sign: false)
    return UnpackedFloat[M, L, W].inf(sign: false)
  # Range reduction: q = round(me / ln2); reduced d = (me - q*ln2)/2 via two-part
  # ln2 (hi+lo) FMAs so the cancellation stays full-precision, then halved (ldexp -1).
  var q = me.mul(you: UnpackedFloat[M, L, W].recip_ln2()).rint().to_s64()
  var nq = UnpackedFloat[M, L, W].from_s64(src: LLVM::sub(a: 0_s64, b: q))
  var d = nq.fma(b: UnpackedFloat[M, L, W].ln2_hi(), c: me)
  d = nq.fma(b: UnpackedFloat[M, L, W].ln2_lo(), c: d)
  d = d.ldexp(e: -1_s64)
  # Horner evaluation of the exp series (degree n+1 down to 0) in the reduced d.
  var s = UnpackedFloat[M, L, W].exp_coef(LLVM::add(a: n, b: 1_s64))
  var i = n
  while LLVM::signed_ge(a: i, b: 0_s64)
    s = s.fma_finite(b: d, c: UnpackedFloat[M, L, W].exp_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  # Undo the half-angle (exp(d) -> exp(2d) = s^2), then scale by 2^q (ldexp q).
  s = s.mul_finite(you: s)
  return s.ldexp(e: q)

### expm1 on the unpacked engine (TLFloat expm1_, degree n, M=1).
routine UnpackedFloat[M, L, W].expm1(n: S64) -> UnpackedFloat[M, L, W]
  # W=320 (the Decimal engine) overrides the degree to 36 for 70+ digit accuracy.
  if LLVM::int_eq[U64](a: W, b: 512_u64) or LLVM::int_eq[U64](a: W, b: 320_u64)
    n = 36_s64
  if me.iszero()
    return me
  # |me| > ~2^28: -1 for large-negative (e^x -> 0), +inf for large-positive.
  if LLVM::signed_gt(a: me.exp, b: 28_s64)
    if me.sign()
      return UnpackedFloat[M, L, W].from_s64(src: -1_s64)
    return UnpackedFloat[M, L, W].inf(sign: false)
  # Same q = round(me/ln2) + two-part-ln2 reduction + half-angle as exp.
  var q = me.mul(you: UnpackedFloat[M, L, W].recip_ln2()).rint().to_s64()
  var nq = UnpackedFloat[M, L, W].from_s64(src: LLVM::sub(a: 0_s64, b: q))
  var d = nq.fma(b: UnpackedFloat[M, L, W].ln2_hi(), c: me)
  d = nq.fma(b: UnpackedFloat[M, L, W].ln2_lo(), c: d)
  d = d.ldexp(e: -1_s64)
  # Horner series down to coef 1 (the constant term is handled by the expm1 form below).
  var s = UnpackedFloat[M, L, W].exp_coef(LLVM::add(a: n, b: 1_s64))
  var i = n
  while LLVM::signed_ge(a: i, b: 1_s64)
    s = s.fma_finite(b: d, c: UnpackedFloat[M, L, W].exp_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  # Reconstruct expm1(2d) = s^2 + 2s from the half-angle s = expm1(d)/... (avoids 1-1
  # cancellation that a plain exp(x)-1 would suffer for small x).
  s = s.mul_finite(you: d)
  s = s.fma_finite(b: s, c: s.ldexp(e: 1_s64))
  # Scale by 2^q and add the (2^q - 1) correction so the result is expm1, not exp-1.
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  return s.ldexp(e: q).add(you: one.ldexp(e: q).sub(you: one))

### log on the unpacked engine (TLFloat log_, degree n, m sqrt-reductions, threshold t).
routine UnpackedFloat[M, L, W].log(n: S64, m: S64, t: S64) -> UnpackedFloat[M, L, W]
  # W=320 (Decimal) overrides degree/reductions/threshold for 70+ digits (t very negative = always reduce).
  if LLVM::int_eq[U64](a: W, b: 512_u64) or LLVM::int_eq[U64](a: W, b: 320_u64)
    n = 33_s64
    m = 2_s64
    t = -1000000_s64
  # frexp splits me = fr * 2^e with fr in [0.5,1); recentre to [sqrt(1/2), sqrt(2))
  # so the atanh argument x stays small and symmetric.
  var p = me.frexp()
  var fr = p.item0
  var e = p.item1
  if fr.lt(you: UnpackedFloat[M, L, W].sqrt_half())
    fr = fr.ldexp(e: 1_s64)
    e = LLVM::sub(a: e, b: 1_s64)
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  # When fr is not already near 1, take m square roots: log(fr) = 2^m * log(fr^(1/2^m)),
  # shrinking |x| so the fixed-degree polynomial reaches the target precision.
  var mm = 0_s64
  if LLVM::signed_gt[S64](a: m, b: 0_s64) and LLVM::signed_gt[S64](a: fr.sub(you: one).abs().ilogb(), b: t)
    var k = 0_s64
    while LLVM::signed_lt(a: k, b: m)
      fr = fr.sqrt()
      k = LLVM::add(a: k, b: 1_s64)
    mm = m
  # atanh series: log(fr) = 2*atanh(x) with x = (fr-1)/(fr+1); evaluate in x^2 by Horner.
  var x = fr.sub(you: one).div(you: fr.add(you: one))
  var xx = x.mul_finite(you: x)
  var y = UnpackedFloat[M, L, W].log_coef(LLVM::add(a: n, b: 1_s64))
  var i = n
  while LLVM::signed_ge(a: i, b: 0_s64)
    y = y.fma_finite(b: xx, c: UnpackedFloat[M, L, W].log_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  y = y.mul_finite(you: x)
  # Reassemble: undo the m reductions (ldexp mm), then add e*ln2 via two-part ln2 FMAs.
  var ef = UnpackedFloat[M, L, W].from_s64(src: e)
  y = ef.fma(b: UnpackedFloat[M, L, W].ln2_lo(), c: y.ldexp(e: mm))
  return ef.fma(b: UnpackedFloat[M, L, W].ln2_hi(), c: y)

### log1p on the unpacked engine (TLFloat log1p_, degree n, m sqrt-reductions).
routine UnpackedFloat[M, L, W].log1p(n: S64, m: S64) -> UnpackedFloat[M, L, W]
  if LLVM::int_eq[U64](a: W, b: 512_u64) or LLVM::int_eq[U64](a: W, b: 320_u64)
    n = 33_s64
    # m=2 (one fewer sqrt+div reduction than the old m=3): the Taylor-conservative
    # truncation is still 2^-324 (~97 digits) >> D256's 70 — verified in gen probes.
    # log1p is a shared primitive (atanh/asinh route through it), so this trims the
    # whole inverse-hyperbolic cluster, not just log1p.
    m = 2_s64
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  # frexp(1+me) gives the exponent e; for e==0 keep the original me to avoid losing
  # precision in (1+me)-1 when me is tiny, else use fr-1 recentred to [sqrt(1/2), sqrt(2)).
  var p = me.add(you: one).frexp()
  var fr = p.item0
  var e = p.item1
  if fr.lt(you: UnpackedFloat[M, L, W].sqrt_half())
    fr = fr.ldexp(e: 1_s64)
    e = LLVM::sub(a: e, b: 1_s64)
  fr = if e == 0_s64 then me else fr.sub(you: one)
  # m reduction steps fr <- fr/(sqrt(1+fr)+1) (half-argument for log1p); each halves
  # the magnitude, reconstructed by ldexp m below.
  var k = 0_s64
  while LLVM::signed_lt(a: k, b: m)
    fr = fr.div(you: fr.add(you: one).sqrt().add(you: one))
    k = LLVM::add(a: k, b: 1_s64)
  # atanh series in x = fr/(fr+2): log1p(fr) = 2*atanh(x); Horner in x^2.
  var two = UnpackedFloat[M, L, W].from_s64(src: 2_s64)
  var x = fr.div(you: fr.add(you: two))
  var xx = x.mul(you: x)
  var y = UnpackedFloat[M, L, W].log_coef(LLVM::add(a: n, b: 1_s64))
  var i = n
  while LLVM::signed_ge(a: i, b: 0_s64)
    y = y.fma_finite(b: xx, c: UnpackedFloat[M, L, W].log_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  y = y.mul(you: x)
  # Undo the m reductions (ldexp m) and add e*ln2 (two-part ln2 FMAs).
  var ef = UnpackedFloat[M, L, W].from_s64(src: e)
  y = ef.fma(b: UnpackedFloat[M, L, W].ln2_lo(), c: y.ldexp(e: m))
  return ef.fma(b: UnpackedFloat[M, L, W].ln2_hi(), c: y)

### cbrt on the unpacked engine. me must be finite, nonzero, normal (callers scale/guard).
routine UnpackedFloat[M, L, W].cbrt() -> UnpackedFloat[M, L, W]
  var wb = LLVM::reinterpret_bits[U64, S64](W)
  var one_third = UnpackedFloat[M, L, W].one_third()
  # Split off a power of 2: scale me down by 2^e so the mantissa d is near 1.
  var e = LLVM::add(a: me.mul(you: one_third).ilogb(), b: 2_s64)
  var d = me.ldexp(e: LLVM::sub(a: 0_s64, b: e))
  # Decompose e = 3*(e//3) + r with a large bias (3145728/1048576) to keep e//3 exact;
  # the residue r in {0,1,2} picks the cube-root-of-2^r factor q reapplied at the end.
  var eo3 = LLVM::add(a: e, b: 3145728_s64)
  var r = LLVM::signed_rem(a: eo3, b: 3_s64)
  var q = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if r == 1_s64
    q = UnpackedFloat[M, L, W].cbrt_2()
  if r == 2_s64
    q = UnpackedFloat[M, L, W].cbrt_4()
  q = q.ldexp(e: LLVM::sub(a: LLVM::signed_div(a: eo3, b: 3_s64), b: 1048576_s64))
  if d.sign()
    q = q.neg()
  d = d.abs()
  # Seed x ~= d^(-1/3) from a HARDWARE b64 rcbrt (~52 correct bits), replacing the old degree-5
  # Horner polynomial. Take d's top 53 mantissa bits (leading at W-2) as an exact-in-b64 integer
  # scaled by 2^(d.exp-51), 1/cbrt in b64, then read the ~52-bit result back as an unpacked value.
  var topbits = LLVM::int_truncate[M, U64](LLVM::shift_right_unsigned(d.mant, M.to_width(s: LLVM::sub(a: wb, b: 54_s64))))
  var df = B64(from: topbits).scalbn(n: LLVM::sub(a: d.exp, b: 51_s64))
  var xf = B64(from: 1_u64).truediv_unchecked(you: C::rf_b64_cbrt(value: df))
  var xint = LLVM::float_to_unsigned[B64, U64](xf.scalbn(n: 53_s64))
  var x = UnpackedFloat[M, L, W].from_u64(v: xint).ldexp(e: -53_s64)
  var one_third_neg = one_third.neg()
  # Newton x <- x - (d*x^4 - x)/3 drives x to d^(-1/3), doubling the correct-bit count each step.
  # From the ~52-bit b64 seed, ceil(log2(W/52)) steps reach W bits: W=128/192->2, 256/384->3, 512->4.
  # (Was a fixed 3 on a ~degree-5-poly seed; the b64 seed trims B128 to 2 and the Horner seed to nil.)
  var iters = LLVM::sub(a: LLVM::sub(a: 63_s64, b: LLVM::reinterpret_bits[U64, S64](LLVM::leading_zeros[U64](W))), b: 5_s64)
  if LLVM::signed_lt(a: iters, b: 2_s64)
    iters = 2_s64
  var j = 0_s64
  while LLVM::signed_lt(a: j, b: iters)
    var yy = x.mul_finite(you: x)
    yy = yy.mul_finite(you: yy)
    x = d.fma_finite(b: yy, c: x.neg()).fma_finite(b: one_third_neg, c: x)
    j = LLVM::add(a: j, b: 1_s64)
  # Final correction: form d*x^2 ~ d^(1/3) and apply one Newton step, then scale by q.
  var y2 = x.mul_finite(you: x).mul_finite(you: d)
  var t = y2.fma_finite(b: x, c: UnpackedFloat[M, L, W].from_s64(src: -1_s64))
  var cc = one_third.ldexp(e: 1_s64).neg().mul_finite(you: y2)
  return t.fma_finite(b: cc, c: y2).mul_finite(you: q)

### atan2 on the unpacked engine (TLFloat atan2_, N=17, M=3). Picks degree/depth by width.
routine UnpackedFloat[M, L, W].atan2(x0: UnpackedFloat[M, L, W]) -> UnpackedFloat[M, L, W]
  # W=320 (Decimal) needs deeper half-angle reduction + higher poly degree for 70+ digits.
  var deg = 17_s64
  var depth = 3_s64
  if LLVM::int_eq[U64](a: W, b: 512_u64) or LLVM::int_eq[U64](a: W, b: 320_u64)
    deg = 22_s64
    depth = 5_s64
  return me.atan2_p(x0: x0, deg: deg, depth: depth)

### Degree/depth-parameterized atan2. `deg` = atan-series Horner degree, `depth` = half-angle
### reductions; callers below B128's 113 bits (D64) size both down to their target. atan_coef is
### W-dispatched (a valid quad table at W=128), so reducing `deg` just uses fewer correct terms.
routine UnpackedFloat[M, L, W].atan2_p(x0: UnpackedFloat[M, L, W], deg: S64, depth: S64) -> UnpackedFloat[M, L, W]
  var y = me
  var x = x0
  # Octant folding into |y| <= |x|: q records the quadrant offset (in units of pi/2)
  # so the result can be reconstructed as q*(pi/2) + atan(d).
  var q = 0_s64
  if y.abs().gt(you: x.abs())
    var tmp = x
    x = y
    y = tmp.neg()
    q = if x.sign() then -1_s64 else 1_s64
  elseif x.sign()
    q = if y.sign() then -2_s64 else 2_s64
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  # atan(d) for the folded |d| <= 1 via table reduction (replaces the depth half-angle loop):
  # k = round(32|d|), c = k/32, u = (|d|-c)/(1+|d|*c) with |u| <= 1/64; atan(|d|) = atan_tab(k)
  # + u*H(u^2); the sign of d is reapplied after (atan is odd). deg/depth are now vestigial --
  # the table path is self-sizing by width. x==0 (atan2(0,0)) skips the y/x division entirely.
  var r = UnpackedFloat[M, L, W].zero(sign: false)
  if not x.iszero()
    var d = y.div(you: x)
    var s = d.sign()
    var a = d.abs()
    var n32 = UnpackedFloat[M, L, W].from_s64(src: 32_s64)
    var kf = a.mul(you: n32).rint()
    var k = kf.to_s64()
    if LLVM::signed_gt(a: k, b: 32_s64)
      k = 32_s64
    var c = kf.div(you: n32)
    var u = a.sub(you: c).div(you: one.add(you: a.mul(you: c)))
    r = UnpackedFloat[M, L, W].atan_tab(k: k).add(you: u.mul(you: UnpackedFloat[M, L, W].atan_h(w: u.mul(you: u))))
    if s
      r = r.neg()
  var qu = UnpackedFloat[M, L, W].from_s64(src: q)
  if q == 0_s64
    qu = UnpackedFloat[M, L, W].zero(sign: r.sign())
  if x.iszero()
    r = UnpackedFloat[M, L, W].zero(sign: y.sign())
    var qa = qu.abs()
    qu = if y.sign() then qa.neg() else qa
  # Reconstruct: q*(pi/2) + atan(d).
  return qu.fma(b: UnpackedFloat[M, L, W].pi().ldexp(e: -1_s64), c: r)

### atan on the unpacked engine.
routine UnpackedFloat[M, L, W].atan() -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var negone = one.neg()
  var yinf = if me.sign() then negone else one
  var y = if me.isinf() then yinf else me
  var zero = UnpackedFloat[M, L, W].zero(sign: false)
  var x = if me.isinf() then zero else one
  return y.atan2(x0: x)

### asin on the unpacked engine.
routine UnpackedFloat[M, L, W].asin() -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if me.abs().gt(you: one)
    return UnpackedFloat[M, L, W].nan()
  # asin(x) = atan2(x, sqrt((1+x)(1-x))) = atan2(x, sqrt(1-x^2)).
  var x = one.add(you: me).mul(you: one.sub(you: me)).sqrt()
  return me.atan2(x0: x)

### acos on the unpacked engine.
routine UnpackedFloat[M, L, W].acos() -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if me.abs().gt(you: one)
    return UnpackedFloat[M, L, W].nan()
  # acos(x) = atan2(sqrt(1-x^2), x).
  var y = one.add(you: me).mul(you: one.sub(you: me)).sqrt()
  return y.atan2(x0: me)

### Degree/depth-parameterized atan/asin/acos cores for sub-113-bit targets (D64). Same methods
### as atan/asin/acos but thread `deg`/`depth` to atan2_p.
routine UnpackedFloat[M, L, W].atan_p(deg: S64, depth: S64) -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var negone = one.neg()
  var yinf = if me.sign() then negone else one
  var y = if me.isinf() then yinf else me
  var zero = UnpackedFloat[M, L, W].zero(sign: false)
  var x = if me.isinf() then zero else one
  return y.atan2_p(x0: x, deg: deg, depth: depth)

routine UnpackedFloat[M, L, W].asin_p(deg: S64, depth: S64) -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if me.abs().gt(you: one)
    return UnpackedFloat[M, L, W].nan()
  var x = one.add(you: me).mul(you: one.sub(you: me)).sqrt()
  return me.atan2_p(x0: x, deg: deg, depth: depth)

routine UnpackedFloat[M, L, W].acos_p(deg: S64, depth: S64) -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if me.abs().gt(you: one)
    return UnpackedFloat[M, L, W].nan()
  var y = one.add(you: me).mul(you: one.sub(you: me)).sqrt()
  return y.atan2_p(x0: me, deg: deg, depth: depth)

### sinh on the unpacked engine (expm1_), with explicit expm1 term count `en`.
### The inner expm1 range-reduces uniformly (reduced |d| <= ln2/2), so a lower `en`
### suffices for narrower targets (e.g. D64 at 54 bits) for any input.
routine UnpackedFloat[M, L, W].sinh_n(en: S64) -> UnpackedFloat[M, L, W]
  if me.isnan() or me.isinf()
    return me
  if me.abs().gt(you: UnpackedFloat[M, L, W].from_s64(src: 1048576_s64))
    return UnpackedFloat[M, L, W].inf(sign: me.sign())
  # sinh via expm1 to avoid cancellation near 0: let t = expm1(|x|), then
  # sinh = (t*(t+2)/(t+1))/2; sign reapplied (sinh is odd).
  var d = me.abs().expm1(n: en)
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var two = UnpackedFloat[M, L, W].from_s64(src: 2_s64)
  d = d.mul(you: d.add(you: two)).div(you: d.add(you: one)).ldexp(e: -1_s64)
  if me.sign()
    d = d.neg()
  return d

### sinh on the unpacked engine (expm1_ N=20) at the full B128/Decimal term count.
routine UnpackedFloat[M, L, W].sinh() -> UnpackedFloat[M, L, W]
  return me.sinh_n(en: 20_s64)

### cosh on the unpacked engine (exp_), with explicit exp term count `en`.
### The inner exp range-reduces uniformly, so a lower `en` suffices for narrower targets.
routine UnpackedFloat[M, L, W].cosh_n(en: S64) -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  if me.isinf()
    return UnpackedFloat[M, L, W].inf(sign: false)
  if me.iszero()
    return UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if me.abs().gt(you: UnpackedFloat[M, L, W].from_s64(src: 1048576_s64))
    return UnpackedFloat[M, L, W].inf(sign: false)
  # cosh(x) = (e^|x| + e^-|x|)/2.
  var d = me.abs().exp(n: en)
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  return d.add(you: one.div(you: d)).ldexp(e: -1_s64)

### cosh on the unpacked engine (exp_ N=20) at the full B128/Decimal term count.
routine UnpackedFloat[M, L, W].cosh() -> UnpackedFloat[M, L, W]
  return me.cosh_n(en: 20_s64)

### tanh on the unpacked engine (expm1_), with explicit expm1 term count `en`.
### The inner expm1 range-reduces uniformly, so a lower `en` suffices for narrower targets.
routine UnpackedFloat[M, L, W].tanh_n(en: S64) -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  var y = me.abs()
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if y.isinf() or y.gt(you: UnpackedFloat[M, L, W].from_s64(src: 1048576_s64))
    var res = one
    if me.sign()
      res = one.neg()
    return res
  # tanh via expm1(2|x|): t = expm1(2|x|), tanh = t/(t+2); sign reapplied (tanh is odd).
  var d = y.ldexp(e: 1_s64).expm1(n: en)
  d = d.div(you: d.add(you: UnpackedFloat[M, L, W].from_s64(src: 2_s64)))
  if me.sign()
    d = d.neg()
  return d

### tanh on the unpacked engine (expm1_ N=20) at the full B128/Decimal term count.
routine UnpackedFloat[M, L, W].tanh() -> UnpackedFloat[M, L, W]
  return me.tanh_n(en: 20_s64)

### atanh on the unpacked engine (log1p_, M=0), with explicit log1p term count `ln`.
### The inner log1p recentres uniformly (series |x| <= ~0.1716), so a lower `ln` suffices
### for narrower targets (e.g. D64 at 54 bits) for any input in (-1, 1).
routine UnpackedFloat[M, L, W].atanh_n(ln: S64) -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  if me.isinf()
    return UnpackedFloat[M, L, W].nan()
  var y = me.abs()
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if y.gt(you: one)
    return UnpackedFloat[M, L, W].nan()
  if y.eq(you: one)
    return UnpackedFloat[M, L, W].inf(sign: me.sign())
  # atanh(x) = (1/2)*(log1p(y) - log1p(-y)) with y=|x|; sign reapplied (atanh is odd).
  # The textbook (1/2)*log1p(2y/(1-y)) form is AVOIDED: forming 2y/(1-y) subtracts (1-y),
  # which for y near a value whose 1-y lands the argument on a clean binary boundary (notably
  # y=0.8 -> 2y/(1-y)=8 exactly) collapses to ~65 bits -- a sharp, WIDTH-INDEPENDENT accuracy
  # hole confirmed at both W=192 and W=320. log1p(y)-log1p(-y) never forms that subtraction:
  # near y=0 the two terms have opposite sign (subtraction ADDS magnitude, no cancellation),
  # near y=1 one term dominates, so it is well-conditioned across (-1, 1). m=0: log1p recentres
  # its own argument via frexp, so no reduction sqrt is needed here.
  var d = y.log1p(n: ln, m: 0_s64).sub(you: y.neg().log1p(n: ln, m: 0_s64)).ldexp(e: -1_s64)
  if me.sign()
    d = d.neg()
  return d

### atanh on the unpacked engine (log1p_ N=21, M=0) at the full B128/Decimal term count.
routine UnpackedFloat[M, L, W].atanh() -> UnpackedFloat[M, L, W]
  return me.atanh_n(ln: 21_s64)

### asinh on the unpacked engine (log_/log1p_ N=24, M=0 — no reduction sqrt).
routine UnpackedFloat[M, L, W].asinh() -> UnpackedFloat[M, L, W]
  var y = me.abs()
  if me.isnan() or y.isinf()
    return me
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var ygt1 = y.gt(you: one)
  var d = if ygt1 then one.div(you: y) else y
  d = d.fma(b: d, c: one).sqrt()
  # Pick ONE transcendental (lazy conditional): |x|>1 -> log, else log1p. The old
  # form always evaluated log1p then overwrote it with log for |x|>1 (double work).
  # m=0 (no half-argument sqrt-reduction): the frexp range bounds |x|<=0.1716, so
  # n=24 gives ~2^-130 (> B128's 113-bit / D128's 34-digit target) with NO reduction
  # sqrt. The old m=1 paid a SECOND wide-engine sqrt (~1126 ns) on top of the inherent
  # sqrt(x^2+1) for precision nothing downstream uses. atanh already runs m=0 here.
  var res = if ygt1 then d.fma(b: y, c: y).log(n: 24_s64, m: 0_s64, t: -10_s64) else d.sub(you: one).add(you: y).log1p(n: 24_s64, m: 0_s64)
  if me.sign()
    res = res.neg()
  return res

### acosh on the unpacked engine (log_/log1p_ N=24, M=0 — no reduction sqrt).
routine UnpackedFloat[M, L, W].acosh() -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if me.lt(you: one)
    return UnpackedFloat[M, L, W].nan()
  if me.isinf()
    return UnpackedFloat[M, L, W].inf(sign: false)
  var tm1 = me.sub(you: one)  # x - 1 (exact for x >= 1: subtracting 1 from >=1 never cancels)
  # Near x=1, acosh(x) -> 0 and the argument x + sqrt(x^2-1) -> 1, so plain log(1+w) drops w's
  # low bits the moment 1+w is formed (w ~ sqrt(2(x-1)) can be far below 1). Mirror asinh's
  # small-argument branch: for x < 2 compute w = (x-1) + sqrt((x-1)(x+1)) DIRECTLY (both terms
  # same-sign, no cancellation) and take log1p(w), which consumes w at full precision. For x >= 2
  # the argument is comfortably > 1, so the direct log form is accurate (and slightly cheaper).
  var two = UnpackedFloat[M, L, W].from_s64(src: 2_s64)
  if me.lt(you: two)
    var w = tm1.add(you: tm1.mul(you: me.add(you: one)).sqrt())
    return w.log1p(n: 24_s64, m: 0_s64)
  # m=0: drop the second (reduction) sqrt; n=24 (~2^-130) covers the B128/D128 target.
  var s = me.add(you: one).mul(you: tm1).sqrt().add(you: me)
  return s.log(n: 24_s64, m: 0_s64, t: -10_s64)

# ============================================================================
# B128 method wrappers
# ============================================================================

### Returns `e^me`.
routine B128.exp!() -> B128
  var rr = me.exp_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `e^me` with raw IEEE propagation (NaN -> qNaN, +inf -> +inf, -inf -> +0). No crash.
routine B128.exp_unchecked() -> B128
  return me.exp_unchecked_n(n: 20_s64)

### `e^me` raw IEEE, with the exp-series explicit atanh/exp-series term count `n`.
routine B128.exp_unchecked_n(n: S64) -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    if me.is_negative()
      return B128.from_bits(bits: 0_u128)
    return me
  return me.to_uf192().exp(n: n).to_b128()

### Returns `ln(me)`.
routine B128.log!() -> B128
  var rr = me.log_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `ln(me)` with raw IEEE (NaN/0 -> -inf, x<0 -> qNaN, +inf -> +inf). No crash.
routine B128.log_unchecked() -> B128
  return me.log_unchecked_n(n: 23_s64)

### `ln(me)` raw IEEE, with the atanh-series term count sized to a TARGET precision (bits) rather
### than the full 128-bit width — the operation owns its iteration count, keyed on what the caller
### actually needs. After the [sqrt(1/2), sqrt(2)) reduction |x| <= ~0.172, so the series yields
### ~6 bits per term; n = (prec + guard) / 6. Lower-precision callers (e.g. D64 at 54 bits) get a
### proportionally cheaper log. PROTOTYPE for precision-targeted iteration counts.
routine B128.log_unchecked_n(n: S64) -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_zero()
    return B128.from_bits(bits: b128_inf(sign: 1_u64))
  if me.is_negative()
    return B128.from_bits(bits: b128_qnan())
  if me.is_infinite()
    return me
  return me.to_uf192().log(n: n, m: 0_s64, t: 0_s64).to_b128()

### Returns `e^me - 1`.
routine B128.expm1!() -> B128
  var rr = me.expm1_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `e^me - 1` with raw IEEE (NaN -> qNaN, -inf -> -1, +inf -> +inf). No crash.
routine B128.expm1_unchecked() -> B128
  return me.expm1_unchecked_n(n: 21_s64)

### `e^me - 1` raw IEEE, explicit atanh/exp-series term count `n`.
routine B128.expm1_unchecked_n(n: S64) -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    if me.is_negative()
      return UnpackedFloat[U192, U384, 192].from_s64(src: -1_s64).to_b128()
    return me
  return me.to_uf192().expm1(n: n).to_b128()

### Returns `ln(1 + me)`.
routine B128.log1p!() -> B128
  var rr = me.log1p_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `ln(1+me)` with raw IEEE (NaN -> qNaN, me=-1 -> -inf, me<-1 -> qNaN, +inf -> +inf). No crash.
routine B128.log1p_unchecked() -> B128
  return me.log1p_unchecked_n(n: 21_s64)

### `ln(1+me)` raw IEEE, explicit atanh/exp-series term count `n`.
routine B128.log1p_unchecked_n(n: S64) -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_zero()
    return me
  var negone = UnpackedFloat[U192, U384, 192].from_s64(src: -1_s64).to_b128()
  if me == negone
    return B128.from_bits(bits: b128_inf(sign: 1_u64))
  if me < negone
    return B128.from_bits(bits: b128_qnan())
  if me.is_infinite()
    return me
  return me.to_uf192().log1p(n: n, m: 0_s64).to_b128()

### Returns `log2(me)`.
routine B128.log2!() -> B128
  var rr = me.log2_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `log2(me)` with raw IEEE (computed as ln(me) * (1/ln2)). No crash.
routine B128.log2_unchecked() -> B128
  return me.log2_unchecked_n(n: 23_s64)

### `log2(me)` raw IEEE, with the inner log atanh-series term count `n`.
routine B128.log2_unchecked_n(n: S64) -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_zero()
    return B128.from_bits(bits: b128_inf(sign: 1_u64))
  if me.is_negative()
    return B128.from_bits(bits: b128_qnan())
  if me.is_infinite()
    return me
  return me.to_uf192().log(n: n, m: 0_s64, t: 0_s64).mul(you: UnpackedFloat[U192, U384, 192].recip_ln2()).to_b128()

### Returns `log10(me)`.
routine B128.log10!() -> B128
  var rr = me.log10_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `log10(me)` with raw IEEE (computed as ln(me) * (1/ln10)). No crash.
routine B128.log10_unchecked() -> B128
  return me.log10_unchecked_n(n: 23_s64)

### `log10(me)` raw IEEE, with the inner log atanh-series term count `n`.
routine B128.log10_unchecked_n(n: S64) -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_zero()
    return B128.from_bits(bits: b128_inf(sign: 1_u64))
  if me.is_negative()
    return B128.from_bits(bits: b128_qnan())
  if me.is_infinite()
    return me
  return me.to_uf192().log(n: n, m: 0_s64, t: 0_s64).mul(you: UnpackedFloat[U192, U384, 192].recip_ln10()).to_b128()

### Returns the cube root `cbrt(me)`.
routine B128.cbrt() -> B128
  if me.is_zero() or me.is_infinite() or me.is_nan()
    return me
  return me.to_uf192().cbrt().to_b128()

### Returns `2^me` (computed on the W=192 engine).
routine B128.exp2!() -> B128
  var rr = me.exp2_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `2^me` with raw IEEE (W=192: e^(me*ln2)). No crash.
routine B128.exp2_unchecked() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    if me.is_negative()
      return B128.from_bits(bits: 0_u128)
    return me
  return me.to_uf192().mul(you: UnpackedFloat[U192, U384, 192].ln2()).exp(n: 20_s64).to_b128()

### Returns `10^me` (computed on the W=192 engine).
routine B128.exp10!() -> B128
  var rr = me.exp10_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `10^me` with raw IEEE (W=192: e^(me*ln10)). No crash.
routine B128.exp10_unchecked() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    if me.is_negative()
      return B128.from_bits(bits: 0_u128)
    return me
  return me.to_uf192().mul(you: UnpackedFloat[U192, U384, 192].ln10()).exp(n: 20_s64).to_b128()

### Returns `me ^ you` (computed on the W=192 engine).
routine B128.pow!(you: B128) -> B128
  var rr = me.pow_unchecked(you: you)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me^you` with raw IEEE (full C99 pow special-case ladder). No crash.
### Core path is W=192 `exp(you * ln|me|)`; the sign of an odd-integer exponent is reapplied.
routine B128.pow_unchecked(you: B128) -> B128
  return me.pow_unchecked_p(you: you, logn: 23_s64, expn: 20_s64, fast: false)

### Precision-parameterized pow. `fast: true` runs the general `exp(you * ln|me|)` core at
### B128 width (113-bit significand, ~59 guard bits over D64's 54-bit target) instead of W=192;
### `fast: false` keeps the W=192 path for B128's own faithful ~1 ULP 113-bit result. The
### C99 special-case ladder is precision-independent and shared. `logn`/`expn` set the series
### degrees of the general path.
routine B128.pow_unchecked_p(you: B128, logn: S64, expn: S64, fast: Bool) -> B128
  var one = UnpackedFloat[U128, U256, 128].from_s64(src: 1_s64).to_b128()
  var negone = one.neg()
  var yo = you.to_uf192()
  # Integer/odd-integer exponent classification drives sign rules and domain checks below.
  var yisint = yo.isint()
  var yisoddint = yisint and not yo.iseven()
  var poszero = B128.from_bits(bits: 0_u128)
  var negzero = B128.from_bits(bits: LLVM::shift_left(value: 1_u128, bits: 127_u128))
  var posinf = B128.from_bits(bits: b128_inf(sign: 0_u64))
  var neginf = B128.from_bits(bits: b128_inf(sign: 1_u64))
  var xs = 0_u64
  if me.is_negative()
    xs = 1_u64
  # Negative base raised to a non-integer power has no real result -> qNaN.
  if me.is_negative() and me.is_finite() and not me.is_zero() and you.is_finite() and not yisint
    return B128.from_bits(bits: b128_qnan())
  if me == one or you.is_zero()
    return one
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if you.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: you.to_bits()))
  if not you.is_negative() and not you.is_zero() and me.is_zero() and yisoddint
    return me
  if me.is_zero() and not you.is_negative() and not you.is_zero() and not yisoddint
    return poszero
  if you.is_infinite() and me == negone
    return one
  var absxlt1 = negone < me and me < one
  var absxgt1 = me < negone or one < me
  if you.is_infinite() and you.is_negative() and absxlt1
    return posinf
  if you.is_infinite() and you.is_negative() and absxgt1
    return poszero
  if you.is_infinite() and not you.is_negative() and absxlt1
    return poszero
  if you.is_infinite() and not you.is_negative() and absxgt1
    return posinf
  if me.is_infinite() and me.is_negative() and you.is_negative() and yisoddint
    return negzero
  if me.is_infinite() and me.is_negative() and you.is_negative() and not you.is_zero() and not yisoddint
    return poszero
  if me.is_infinite() and me.is_negative() and not you.is_negative() and yisoddint
    return neginf
  if me.is_infinite() and me.is_negative() and not you.is_negative() and not you.is_zero() and not yisoddint
    return posinf
  if me.is_infinite() and not me.is_negative() and you.is_negative() and not you.is_zero()
    return poszero
  if me.is_infinite() and not me.is_negative() and not you.is_negative() and not you.is_zero()
    return posinf
  if me.is_zero() and yisoddint and you.is_negative()
    return B128.from_bits(bits: b128_inf(sign: xs))
  if me.is_zero() and you.is_negative() and not you.is_zero() and not yisoddint
    return posinf
  # General case: exp(you * ln|me|). Fast path stays at B128 width; default path is W=192.
  if fast
    var zu = me.abs().to_uf().log(n: logn, m: 0_s64, t: 0_s64).mul(you: you.to_uf()).exp(n: expn)
    # Negative base with an odd-integer exponent keeps a negative result.
    if me.is_negative() and yisoddint
      zu = zu.neg()
    return zu.to_b128()
  var z = me.abs().to_uf192().log(n: logn, m: 0_s64, t: 0_s64).mul(you: yo).exp(n: expn)
  # Negative base with an odd-integer exponent keeps a negative result.
  if me.is_negative() and yisoddint
    z = z.neg()
  return z.to_b128()

### Returns `atan(me)`.
routine B128.atan() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  return me.to_uf192().atan().to_b128()

### Returns `asin(me)`.
routine B128.asin!() -> B128
  var rr = me.asin_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `asin(me)` with raw IEEE (|me|>1 -> qNaN). No crash.
routine B128.asin_unchecked() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  return me.to_uf192().asin().to_b128()

### Returns `acos(me)`.
routine B128.acos!() -> B128
  var rr = me.acos_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `acos(me)` with raw IEEE (|me|>1 -> qNaN). No crash.
routine B128.acos_unchecked() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  return me.to_uf192().acos().to_b128()

### Returns `atan2(y, x)`.
### :param y: The y-coordinate.
### :param x: The x-coordinate.
routine atan2(y: B128, x: B128) -> B128
  if y.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: y.to_bits()))
  if x.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: x.to_bits()))
  var yu = y.to_uf192()
  var xu = x.to_uf192()
  if y.is_infinite() or x.is_infinite()
    var one = UnpackedFloat[U192, U384, 192].from_s64(src: 1_s64)
    var negone = one.neg()
    var yinf = if y.is_negative() then negone else one
    var yfin = UnpackedFloat[U192, U384, 192].zero(sign: y.is_negative())
    yu = if y.is_infinite() then yinf else yfin
    var xinf = if x.is_negative() then negone else one
    var xfin = UnpackedFloat[U192, U384, 192].zero(sign: x.is_negative())
    xu = if x.is_infinite() then xinf else xfin
  return yu.atan2(x0: xu).to_b128()

### Degree/depth-reduced inverse-trig for sub-113-bit targets (D64). atan/asin/acos all funnel
### through atan2; these thread reduced `deg`/`depth` to the B128-width core. Already B128 width
### (not the wider Decimal engine), so the win is purely fewer Horner terms + fewer half-angle sqrt reductions.
routine B128.atan_fast(deg: S64, depth: S64) -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  return me.to_uf().atan_p(deg: deg, depth: depth).to_b128()

routine B128.asin_fast(deg: S64, depth: S64) -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  return me.to_uf().asin_p(deg: deg, depth: depth).to_b128()

routine B128.acos_fast(deg: S64, depth: S64) -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  return me.to_uf().acos_p(deg: deg, depth: depth).to_b128()

routine B128.atan2_fast(you: B128, deg: S64, depth: S64) -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if you.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: you.to_bits()))
  var y = me.to_uf()
  var x = you.to_uf()
  if me.is_infinite() or you.is_infinite()
    var one = UnpackedFloat[U128, U256, 128].from_s64(src: 1_s64)
    var negone = one.neg()
    var yinf = if me.is_negative() then negone else one
    var yfin = UnpackedFloat[U128, U256, 128].zero(sign: me.is_negative())
    y = if me.is_infinite() then yinf else yfin
    var xinf = if you.is_negative() then negone else one
    var xfin = UnpackedFloat[U128, U256, 128].zero(sign: you.is_negative())
    x = if you.is_infinite() then xinf else xfin
  return y.atan2_p(x0: x, deg: deg, depth: depth).to_b128()

### Returns `sinh(me)`.
routine B128.sinh!() -> B128
  var rr = me.sinh_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `sinh(me)` with raw IEEE (large |me| -> signed inf). No crash.
routine B128.sinh_unchecked() -> B128
  return me.to_uf192().sinh().to_b128()

### `sinh(me)` raw IEEE, with the inner expm1-series term count `n`.
routine B128.sinh_unchecked_n(n: S64) -> B128
  return me.to_uf192().sinh_n(en: n).to_b128()

### Returns `cosh(me)`.
routine B128.cosh!() -> B128
  var rr = me.cosh_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `cosh(me)` with raw IEEE (large |me| -> +inf). No crash.
routine B128.cosh_unchecked() -> B128
  return me.to_uf192().cosh().to_b128()

### `cosh(me)` raw IEEE, with the inner exp-series term count `n`.
routine B128.cosh_unchecked_n(n: S64) -> B128
  return me.to_uf192().cosh_n(en: n).to_b128()

### Returns `tanh(me)`.
routine B128.tanh() -> B128
  return me.to_uf192().tanh().to_b128()

### `tanh(me)` with the inner expm1-series term count `n`.
routine B128.tanh_n(n: S64) -> B128
  return me.to_uf192().tanh_n(en: n).to_b128()

### Returns `atanh(me)`.
routine B128.atanh!() -> B128
  var rr = me.atanh_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `atanh(me)` with raw IEEE (|me|=1 -> signed inf, |me|>1 -> qNaN). No crash.
routine B128.atanh_unchecked() -> B128
  return me.to_uf192().atanh().to_b128()

### `atanh(me)` raw IEEE, with the inner log1p-series term count `n`.
routine B128.atanh_unchecked_n(n: S64) -> B128
  return me.to_uf192().atanh_n(ln: n).to_b128()

### Returns `asinh(me)` (computed on the W=192 engine).
routine B128.asinh() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  # asinh is odd; asinh(+-0) = +-0. The W=192 log1p path routes through
  # sqrt(x^2+1) whose roundoff leaves a tiny nonzero at x=0, so guard the
  # exact-zero (and signed-zero) result here.
  if me.is_zero()
    return me
  return me.to_uf192().asinh().to_b128()

### Returns `acosh(me)` (computed on the W=192 engine).
routine B128.acosh!() -> B128
  var rr = me.acosh_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `acosh(me)` with raw IEEE (me<1 -> qNaN) computed on the W=192 engine. No crash.
routine B128.acosh_unchecked() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  return me.to_uf192().acosh().to_b128()

# ============================================================================
# Forward trig — Payne-Hanek argument reduction (TLFloat ph) over the rpitab
# 1/(2pi) table, then sin/cos/tan polynomials. Quad params: sin/cos N=14, tan N=16 M=2.
# ============================================================================

### Reads `nbytes` table bytes starting at `start`, MSB-first, into an `L`.
common routine L.read_table_bytes(start: S64, nbytes: S64) -> L
  var acc = L.to_width(s: 0_s64)
  var i = 0_s64
  while LLVM::signed_lt(a: i, b: nbytes)
    var byte = rpitab_byte(idx: LLVM::reinterpret_bits[S64, U64](LLVM::add(a: start, b: i)))
    acc = LLVM::add(a: LLVM::shift_left(value: acc, bits: L.to_width(s: 8_s64)), b: LLVM::zero_extend[U64, L](byte))
    i = LLVM::add(a: i, b: 1_s64)
  return acc

### Payne-Hanek reduction: returns (reduced angle, quadrant&0xff). TLFloat `ph`.
routine UnpackedFloat[M, L, W].ph(p: S64) -> UFExp[M, L, W]
  var wb = LLVM::reinterpret_bits[U64, S64](W)
  var w2 = LLVM::mul(a: 2_s64, b: wb)
  var nbytes = LLVM::signed_div(a: wb, b: 8_s64)
  var nbmant = LLVM::sub(a: wb, b: 2_s64)
  # Tiny arguments (|me| < ~2^-5) need no reduction: return unchanged, quadrant 0.
  if me.iszero() or LLVM::signed_lt(a: me.exp, b: -5_s64)
    var asis = UnpackedFloat[M, L, W].make(mant: me.mant, exp: me.exp, fpclass: SignedFpClass.from_flags(sign: me.sign(), iszero: me.iszero(), isinf: me.isinf(), isnan: me.isnan()))
    return UFExp[M, L, W](item0: asis, item1: 0_s64)
  # Pick the byte window of the 1/(2pi) table aligned to the input's binary exponent so
  # only the bits of 1/(2pi) that overlap me's significance are multiplied.
  var mantexp = LLVM::sub(a: me.exp, b: LLVM::sub(a: nbmant, b: 1_s64))
  var m = LLVM::sub(a: mantexp, b: 1_s64)
  if LLVM::signed_lt[S64](a: m, b: 0_s64)
    m = 0_s64
  var m_aligned = LLVM::sub[S64](a: m, b: LLVM::signed_rem[S64](a: m, b: 8_s64))
  var rpiexp = LLVM::sub(a: LLVM::sub(a: p, b: m_aligned), b: wb)
  var m8 = LLVM::signed_div[S64](a: m, b: 8_s64)
  # Read two W-bit limbs (high, low) of 1/(2pi) and form mant * 1/(2pi) at full width.
  var rpih = L.read_table_bytes(start: m8, nbytes: nbytes)
  var rpil = L.read_table_bytes(start: LLVM::add(a: m8, b: nbytes), nbytes: nbytes)
  var mantL = LLVM::zero_extend[M, L](me.mant)
  var rm = LLVM::add(a: LLVM::mul(a: mantL, b: rpih), b: LLVM::shift_right_unsigned(LLVM::mul(a: mantL, b: rpil), L.to_width(s: wb)))
  # Extract the integer quadrant q = round(rm) and subtract it, leaving the fractional
  # part rm in [-1/2, 1/2) of a full turn (round-to-nearest via the roundbit + mask).
  var q = 0_s64
  var negshift = LLVM::sub(a: 0_s64, b: LLVM::add(a: mantexp, b: rpiexp))
  if LLVM::signed_lt(a: negshift, b: w2)
    var roundbit = LLVM::shift_left[L](value: L.to_width(s: 1_s64), bits: L.to_width(s: LLVM::sub[S64](a: negshift, b: 1_s64)))
    var mask = LLVM::shift_left(value: (L.to_width(s: 0_s64)).bit_not(), bits: L.to_width(s: negshift))
    var qm = LLVM::bit_and(a: LLVM::add(a: rm, b: roundbit), b: mask)
    rm = LLVM::sub(a: rm, b: qm)
    q = LLVM::int_truncate[L, S64](LLVM::shift_right_unsigned(qm, L.to_width(s: negshift)))
  var exp = LLVM::sub(a: LLVM::add(a: mantexp, b: rpiexp), b: p)
  # If the fraction is tiny (near 0 or all-ones), bring in more low limbs of 1/(2pi) to
  # keep full precision before normalizing.
  var j = LLVM::mul(a: 2_s64, b: nbytes)
  while LLVM::signed_gt(a: UnpackedFloat[M, L, W].clz_wide(v: rm), b: wb) or LLVM::signed_gt(a: UnpackedFloat[M, L, W].clz_wide(v: (rm).bit_not()), b: wb)
    var lowpart = LLVM::bit_and(a: LLVM::mul(a: mantL, b: rpil), b: L.low_mask(n: wb))
    rm = LLVM::add(a: LLVM::shift_left(value: rm, bits: L.to_width(s: wb)), b: lowpart)
    rpil = L.read_table_bytes(start: LLVM::add(a: j, b: m8), nbytes: nbytes)
    rm = LLVM::add(a: rm, b: LLVM::shift_right_unsigned(LLVM::mul(a: mantL, b: rpil), L.to_width(s: wb)))
    exp = LLVM::sub(a: exp, b: wb)
    j = LLVM::add(a: j, b: nbytes)
  # If the fraction is in the upper half (>= 1/2 turn) negate it (and q, sign) so the
  # reduced value lies in [0, 1/2) and the quadrant accounting stays consistent.
  var sign = me.sign()
  if (rm).bit(pos: LLVM::sub(a: w2, b: 1_s64))
    rm = LLVM::sub[L](a: L.to_width(s: 0_s64), b: rm)
    q = LLVM::sub(a: 0_s64, b: q)
    sign = not sign
  # Normalize the fraction back into an M-bit mantissa u (left/right shift with rounding),
  # fixing the exponent x for any leading-zero count or rounding carry.
  var x = LLVM::sub(a: w2, b: UnpackedFloat[M, L, W].clz_wide(v: rm))
  var s = LLVM::sub(a: nbmant, b: LLVM::sub(a: x, b: 1_s64))
  var u = M.to_width(s: 0_s64)
  if LLVM::signed_ge(a: s, b: 0_s64)
    u = LLVM::int_truncate[L, M](LLVM::shift_left(value: rm, bits: L.to_width(s: s)))
  else
    var ns = LLVM::sub(a: 0_s64, b: s)
    var rb = LLVM::shift_left[L](value: L.to_width(s: 1_s64), bits: L.to_width(s: LLVM::sub[S64](a: ns, b: 1_s64)))
    u = LLVM::int_truncate[L, M](LLVM::shift_right_unsigned(LLVM::add(a: rm, b: rb), L.to_width(s: ns)))
  if (u).bit(pos: LLVM::add(a: nbmant, b: 1_s64))
    u = LLVM::shift_right_unsigned(u, M.to_width(s: 1_s64))
    x = LLVM::add(a: x, b: 1_s64)
  # Multiply the reduced turn-fraction by pi to get the reduced angle in radians.
  var rexp = LLVM::add(a: LLVM::sub(a: x, b: 2_s64), b: exp)
  var r = UnpackedFloat[M, L, W].make(mant: u, exp: rexp, fpclass: SignedFpClass.from_flags(sign: false, iszero: false, isinf: false, isnan: false)).mul(you: UnpackedFloat[M, L, W].pi())
  var rr = r
  if sign
    rr = r.neg()
  var qv = q
  if sign
    qv = LLVM::sub(a: 0_s64, b: q)
  var qf = LLVM::reinterpret_bits[U64, S64](LLVM::bit_and(a: LLVM::reinterpret_bits[S64, U64](qv), b: 0xff_u64))
  return UFExp[M, L, W](item0: rr, item1: qf)

### sin on the unpacked engine (TLFloat sin_, N=14).
routine UnpackedFloat[M, L, W].sin(n: S64) -> UnpackedFloat[M, L, W]
  # Payne-Hanek reduce to (red, quad); evaluate the series in -red^2.
  var pr = me.ph(p: 1_s64)
  var red = pr.item0
  var quad = pr.item1
  var negsq = red.mul(you: red).neg()
  var d = UnpackedFloat[M, L, W].from_s64(src: 0_s64)
  if LLVM::int_ne(a: LLVM::bit_and(a: quad, b: 1_s64), b: 0_s64)
    # Odd quadrant: sin(x) = cos(reduced); Horner in -red^2 over cos coefficients.
    d = UnpackedFloat[M, L, W].cos_coef(LLVM::add(a: n, b: 1_s64))
    var i = n
    while LLVM::signed_ge(a: i, b: 0_s64)
      d = d.fma_finite(b: negsq, c: UnpackedFloat[M, L, W].cos_coef(i))
      i = LLVM::sub(a: i, b: 1_s64)
  else
    # Even quadrant: sin polynomial in -red^2, multiplied by red (odd function).
    d = UnpackedFloat[M, L, W].sin_coef(n)
    var i = LLVM::sub(a: n, b: 1_s64)
    while LLVM::signed_ge(a: i, b: 0_s64)
      d = d.fma_finite(b: negsq, c: UnpackedFloat[M, L, W].sin_coef(i))
      i = LLVM::sub(a: i, b: 1_s64)
    d = d.mul(you: red)
  # Bit 1 of the quadrant flips the sign (quadrants 2,3).
  if LLVM::int_ne(a: LLVM::bit_and(a: quad, b: 2_s64), b: 0_s64)
    return d.neg()
  return d

### cos on the unpacked engine (TLFloat cos_), with explicit series term count `cn`
### (the even-quadrant cos poly runs to cn+1, the odd-quadrant sin poly to cn). A lower
### `cn` suffices for narrower targets (e.g. D64 at 54 bits) since |red| <= pi/4 caps the
### series argument. W=320 (Decimal) overrides to its 70-digit degree regardless.
routine UnpackedFloat[M, L, W].cos_n(cn: S64) -> UnpackedFloat[M, L, W]
  # Payne-Hanek reduce; evaluate in -red^2 like sin but with the quadrant roles swapped.
  var pr = me.ph(p: 1_s64)
  var red = pr.item0
  var quad = pr.item1
  var negsq = red.mul(you: red).neg()
  # W=320 (Decimal) needs higher poly degree (the ph reduction is already full-width).
  var codd = cn
  var ceven = LLVM::add(a: cn, b: 1_s64)
  if LLVM::int_eq[U64](a: W, b: 512_u64) or LLVM::int_eq[U64](a: W, b: 320_u64)
    codd = 26_s64
    ceven = 27_s64
  var d = UnpackedFloat[M, L, W].from_s64(src: 0_s64)
  if LLVM::int_ne(a: LLVM::bit_and(a: quad, b: 1_s64), b: 0_s64)
    # Odd quadrant: cos(x) = -sin(reduced); sin poly in -red^2 times -red.
    d = UnpackedFloat[M, L, W].sin_coef(codd)
    var i = LLVM::sub(a: codd, b: 1_s64)
    while LLVM::signed_ge(a: i, b: 0_s64)
      d = d.fma_finite(b: negsq, c: UnpackedFloat[M, L, W].sin_coef(i))
      i = LLVM::sub(a: i, b: 1_s64)
    d = d.mul(you: red.neg())
  else
    # Even quadrant: cos polynomial in -red^2 (even function).
    d = UnpackedFloat[M, L, W].cos_coef(ceven)
    var i = LLVM::sub(a: ceven, b: 1_s64)
    while LLVM::signed_ge(a: i, b: 0_s64)
      d = d.fma_finite(b: negsq, c: UnpackedFloat[M, L, W].cos_coef(i))
      i = LLVM::sub(a: i, b: 1_s64)
  # Bit 1 of the quadrant flips the sign (quadrants 2,3).
  if LLVM::int_ne(a: LLVM::bit_and(a: quad, b: 2_s64), b: 0_s64)
    return d.neg()
  return d

### cos on the unpacked engine (TLFloat cos_, N=14) at the full B128/Decimal term count.
routine UnpackedFloat[M, L, W].cos() -> UnpackedFloat[M, L, W]
  return me.cos_n(cn: 14_s64)

### Returns `sin(me)`.
routine B128.sin() -> B128
  return me.sin_n(n: 14_s64)

### `sin(me)` with the series explicit atanh/exp-series term count `n`.
routine B128.sin_n(n: S64) -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    return B128.from_bits(bits: b128_qnan())
  return me.to_uf192().sin(n: n).to_b128()

### Returns `cos(me)`.
routine B128.cos() -> B128
  return me.cos_n(n: 14_s64)

### `cos(me)` with the cos-series explicit term count `n`.
routine B128.cos_n(n: S64) -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    return B128.from_bits(bits: b128_qnan())
  return me.to_uf192().cos_n(cn: n).to_b128()

### tan numerator/denominator pair (TLFloat tan_, N=16, M=2); tan = first/second.
### `td0` is the tan-poly degree; a lower value suffices for narrower targets since the
### 2^sh half-angle reduction caps |x| <= ~pi/4/2^sh. W=320 (Decimal) overrides to its 70-digit degree.
routine UnpackedFloat[M, L, W].tanxy_n(td0: S64) -> UFPair[M, L, W]
  var pr = me.ph(p: 1_s64)
  var red = pr.item0
  var quad = pr.item1
  # W=320 (Decimal) reduces by 2^sh (sh doublings reconstruct: sh-1 in the loop + 1 after) and
  # uses a higher-degree numerator poly for 70+ digits.
  var sh = 3_s64
  var tdeg = td0
  if LLVM::int_eq[U64](a: W, b: 512_u64) or LLVM::int_eq[U64](a: W, b: 320_u64)
    sh = 6_s64
    tdeg = 25_s64
  # Reduce by 2^sh so the tan polynomial converges; x = red / 2^sh.
  var x = red.ldexp(e: LLVM::sub(a: 0_s64, b: sh))
  var xx = x.mul(you: x)
  # Horner for tan(x)/x in x^2, then multiply by x.
  var d = UnpackedFloat[M, L, W].tan_coef(tdeg)
  var i = tdeg
  while LLVM::signed_gt(a: i, b: 0_s64)
    d = d.fma_finite(b: xx, c: UnpackedFloat[M, L, W].tan_coef(LLVM::sub(a: i, b: 1_s64)))
    i = LLVM::sub(a: i, b: 1_s64)
  d = d.mul(you: x)
  # Double-angle: tan(2t) = -2t / (t^2 - 1), applied sh-1 times here (last step after).
  var negone = UnpackedFloat[M, L, W].from_s64(src: -1_s64)
  var y = UnpackedFloat[M, L, W].from_s64(src: 0_s64)
  var k = 0_s64
  while LLVM::signed_lt(a: k, b: LLVM::sub(a: sh, b: 1_s64))
    y = d.fma(b: d, c: negone)
    x = d.ldexp(e: 1_s64).neg()
    d = x.div(you: y)
    k = LLVM::add(a: k, b: 1_s64)
  # Final doubling kept as a numerator/denominator pair (x = -2d, y = d^2-1) so the
  # caller divides once; an odd quadrant means tan -> cot, so swap and negate.
  y = d.fma(b: d, c: negone)
  x = d.ldexp(e: 1_s64).neg()
  if LLVM::int_ne(a: LLVM::bit_and(a: quad, b: 1_s64), b: 0_s64)
    var tmp = x
    x = y
    y = tmp.neg()
  return UFPair[M, L, W](item0: x, item1: y)

### tan numerator/denominator pair at the full B128/Decimal degree.
routine UnpackedFloat[M, L, W].tanxy() -> UFPair[M, L, W]
  return me.tanxy_n(td0: 15_s64)

### tan on the unpacked engine, with explicit tan-poly degree `td0`.
routine UnpackedFloat[M, L, W].tan_n(td0: S64) -> UnpackedFloat[M, L, W]
  var p = me.tanxy_n(td0: td0)
  return p.item0.div(you: p.item1)

### tan on the unpacked engine.
routine UnpackedFloat[M, L, W].tan() -> UnpackedFloat[M, L, W]
  return me.tan_n(td0: 15_s64)

### Returns `tan(me)`.
routine B128.tan() -> B128
  return me.tan_n(n: 15_s64)

### `tan(me)` with the tan-series explicit degree `n`.
routine B128.tan_n(n: S64) -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    return B128.from_bits(bits: b128_qnan())
  return me.to_uf192().tan_n(td0: n).to_b128()

### Returns the fused multiply-add `me*b + c` with a single rounding (computed at W=192).
routine B128.fma!(b: B128, c: B128) -> B128
  var rr = me.fma_unchecked(b: b, c: c)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me*b + c` (single rounding, computed at W=192) with raw IEEE propagation. No crash.
routine B128.fma_unchecked(b: B128, c: B128) -> B128
  return me.to_uf192().fma(b: b.to_uf192(), c: c.to_uf192()).to_b128()

### Returns `sqrt(x^2 + y^2)` without spurious overflow (TLFloat hypot).
### :param x: One leg.
### :param y: The other leg.
routine hypot!(x: B128, y: B128) -> B128
  var rr = hypot_unchecked(x: x, y: y)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `sqrt(x^2 + y^2)` with raw IEEE (any inf -> +inf, any NaN -> qNaN). No crash.
### :param x: One leg.
### :param y: The other leg.
routine hypot_unchecked(x: B128, y: B128) -> B128
  var xx = x.to_uf192()
  var yy = y.to_uf192()
  if xx.isinf() or yy.isinf()
    return B128.from_bits(bits: b128_inf(sign: 0_u64))
  if xx.isnan() or yy.isnan()
    return B128.from_bits(bits: b128_qnan())
  return xx.mul(you: xx).add(you: yy.mul(you: yy)).sqrt().to_b128()

### Returns `sqrt(x^2 + y^2 + z^2)` without spurious overflow. Checked: crashes on non-finite.
### :param x: First leg.
### :param y: Second leg.
### :param z: Third leg.
routine hypot!(x: B128, y: B128, z: B128) -> B128
  var rr = hypot_unchecked(x: x, y: y, z: z)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `sqrt(x^2 + y^2 + z^2)` with raw IEEE (any inf -> +inf, any NaN -> qNaN). No crash. Summed once
### at W=192, so no intermediate double rounding.
### :param x: First leg.
### :param y: Second leg.
### :param z: Third leg.
routine hypot_unchecked(x: B128, y: B128, z: B128) -> B128
  var xx = x.to_uf192()
  var yy = y.to_uf192()
  var zz = z.to_uf192()
  if xx.isinf() or yy.isinf() or zz.isinf()
    return B128.from_bits(bits: b128_inf(sign: 0_u64))
  if xx.isnan() or yy.isnan() or zz.isnan()
    return B128.from_bits(bits: b128_qnan())
  return xx.mul(you: xx).add(you: yy.mul(you: yy)).add(you: zz.mul(you: zz)).sqrt().to_b128()

# ============================================================================
# sinpi / cospi / tanpi (TLFloat; no rpitab — reduce via round(2a) then sin/cos polynomials)
# ============================================================================

### Low 16 bits of the integer value (TLFloat `intlsb`).
routine UnpackedFloat[M, L, W].intlsb() -> S64
  if me.iszero() or me.isinf() or me.isnan()
    return 0_s64
  var wb = LLVM::reinterpret_bits[U64, S64](W)
  var nbmant = LLVM::sub(a: wb, b: 2_s64)
  var s = LLVM::sub(a: nbmant, b: LLVM::add(a: me.exp, b: 1_s64))
  if LLVM::signed_ge(a: s, b: wb) or LLVM::signed_le(a: s, b: -16_s64)
    return 0_s64
  var mm = 0_s64
  if LLVM::signed_ge(a: s, b: 0_s64)
    mm = LLVM::int_truncate[M, S64](LLVM::shift_right_unsigned(me.mant, M.to_width(s: s)))
  else
    mm = LLVM::int_truncate[M, S64](LLVM::shift_left(value: me.mant, bits: M.to_width(s: LLVM::sub(a: 0_s64, b: s))))
  mm = LLVM::bit_and(a: mm, b: 0xffff_s64)
  if me.sign()
    return LLVM::sub(a: LLVM::sub(a: 0_s64, b: mm), b: 1_s64)
  return mm

### sinpi polynomial (TLFloat sinpi_, N=14) on the already-reduced argument.
routine UnpackedFloat[M, L, W].sinpi_poly() -> UnpackedFloat[M, L, W]
  # Evaluate the ordinary sin polynomial at p = pi*me (Horner in -p^2), times -p.
  var p = UnpackedFloat[M, L, W].pi().mul(you: me)
  var negsq = p.mul(you: p).neg()
  var d = UnpackedFloat[M, L, W].sin_coef(14_s64)
  var i = 13_s64
  while LLVM::signed_ge(a: i, b: 0_s64)
    d = d.fma_finite(b: negsq, c: UnpackedFloat[M, L, W].sin_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  return d.mul(you: p.neg())

### cospi polynomial (TLFloat cospi_, N=14) on the already-reduced argument.
routine UnpackedFloat[M, L, W].cospi_poly() -> UnpackedFloat[M, L, W]
  # Evaluate the ordinary cos polynomial at p = pi*me (Horner in -p^2).
  var p = UnpackedFloat[M, L, W].pi().mul(you: me)
  var negsq = p.mul(you: p).neg()
  var d = UnpackedFloat[M, L, W].cos_coef(15_s64)
  var i = 14_s64
  while LLVM::signed_ge(a: i, b: 0_s64)
    d = d.fma_finite(b: negsq, c: UnpackedFloat[M, L, W].cos_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  return d

### Returns `sin(pi*me)`.
routine B128.sinpi() -> B128
  if me.is_nan() or me.is_zero()
    return me
  if me.is_infinite()
    return B128.from_bits(bits: b128_qnan())
  # Reduce on the doubled argument: y = (2a - round(2a))/2 in [-1/4, 1/4]; lx is the low
  # bits of round(2a)*2, selecting which polynomial (sin/cos) and the result sign.
  var a = me.to_uf()
  var x = a.ldexp(e: 1_s64)
  var y = x.sub(you: x.round()).ldexp(e: -1_s64)
  var lx = x.ldexp(e: 1_s64).intlsb()
  var lx3 = LLVM::bit_and(a: lx, b: 3_s64)
  # Exact zeros at integer arguments (sin(pi*integer) = 0), preserving the signed zero.
  if ((LLVM::signed_ge(a: lx, b: 0_s64) and lx3 == 0_s64) or (LLVM::signed_lt(a: lx, b: 0_s64) and lx3 == 3_s64)) and x.isint()
    return UnpackedFloat[U128, U256, 128].zero(sign: x.sign()).to_b128()
  # Quadrant selects cospi vs sinpi polynomial; a further bit flips the sign.
  var z = y.cospi_poly()
  if LLVM::int_ne(a: LLVM::bit_and(a: LLVM::add(a: lx, b: 3_s64), b: 2_s64), b: 0_s64)
    z = y.sinpi_poly()
  if LLVM::int_ne(a: LLVM::bit_and(a: LLVM::add(a: lx, b: 7_s64), b: 4_s64), b: 0_s64)
    z = z.neg()
  return z.to_b128()

### Returns `cos(pi*me)`.
routine B128.cospi() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    return B128.from_bits(bits: b128_qnan())
  var a = me.to_uf()
  var x = a.ldexp(e: 1_s64)
  var y = x.sub(you: x.round()).ldexp(e: -1_s64)
  var lx = x.ldexp(e: 1_s64).intlsb()
  var lx3and2 = LLVM::bit_and(a: LLVM::add(a: lx, b: 3_s64), b: 2_s64)
  if lx3and2 == 0_s64 and y.iszero()
    return UnpackedFloat[U128, U256, 128].zero(sign: false).to_b128()
  var z = y.sinpi_poly()
  if LLVM::int_ne(a: lx3and2, b: 0_s64)
    z = y.cospi_poly()
  if LLVM::int_ne(a: LLVM::bit_and(a: LLVM::add(a: lx, b: 1_s64), b: 4_s64), b: 0_s64)
    z = z.neg()
  return z.to_b128()

### Returns `tan(pi*me)`.
routine B128.tanpi() -> B128
  if me.is_nan() or me.is_zero()
    return me
  if me.is_infinite()
    return B128.from_bits(bits: b128_qnan())
  var a = me.to_uf()
  var x = a.ldexp(e: 1_s64)
  var y = x.sub(you: x.round()).ldexp(e: -1_s64)
  var lx = x.ldexp(e: 1_s64).intlsb()
  var lx3 = LLVM::bit_and(a: lx, b: 3_s64)
  var lx4 = LLVM::bit_and(a: lx, b: 4_s64)
  if ((LLVM::signed_ge(a: lx, b: 0_s64) and lx3 == 0_s64) or (LLVM::signed_lt(a: lx, b: 0_s64) and lx3 == 3_s64)) and x.isint()
    return UnpackedFloat[U128, U256, 128].zero(sign: LLVM::int_ne(a: lx4, b: 0_s64)).to_b128()
  var pr = UnpackedFloat[U128, U256, 128].pi().mul(you: y).tanxy()
  var lx1and2 = LLVM::bit_and(a: LLVM::add(a: lx, b: 1_s64), b: 2_s64)
  var z = pr.item0.div(you: pr.item1)
  if LLVM::int_ne(a: lx1and2, b: 0_s64)
    z = pr.item1.div(you: pr.item0)
  if z.isinf()
    z = UnpackedFloat[U128, U256, 128].make(mant: z.mant, exp: z.exp, fpclass: SignedFpClass.from_flags(sign: LLVM::int_eq(a: lx4, b: 0_s64), iszero: z.iszero(), isinf: z.isinf(), isnan: z.isnan()))
  if LLVM::int_ne(a: lx1and2, b: 0_s64)
    z = z.neg()
  return z.to_b128()

# ============================================================================
# erf / erfc — continued-fraction expansions (TLFloat erf_/erfc_, N=120) on the
# W=192 engine, using exp(-(z^2)) with N=22 and 1/sqrt(pi).
# ============================================================================

### erf_ continued fraction (TLFloat erf_, N=120).
routine UnpackedFloat[M, L, W].erf_cf(levels: S64) -> UnpackedFloat[M, L, W]
  # Backward recurrence (Lentz-style numerator/denominator pair) for the erf continued
  # fraction; `levels` recurrence levels (must be EVEN — two steps per loop iteration), sized by the
  # caller to its precision target (the W=192 erf() needs ~120; D64 far fewer). The seed numerator is
  # 2*levels+1 (odd partial numerator just past the deepest level).
  var zz = me.mul_finite(you: me)
  var n = UnpackedFloat[M, L, W].from_s64(src: LLVM::add(a: LLVM::mul(a: 2_s64, b: levels), b: 1_s64))
  var d = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var i = levels
  while LLVM::signed_gt(a: i, b: 0_s64)
    var i2 = LLVM::mul(a: i, b: 2_s64)
    var t = n
    n = n.mul_finite(you: UnpackedFloat[M, L, W].from_s64(src: LLVM::sub(a: i2, b: 1_s64))).add(you: zz.mul_finite(you: UnpackedFloat[M, L, W].from_s64(src: i2)).mul_finite(you: d))
    d = t
    t = n
    n = n.mul_finite(you: UnpackedFloat[M, L, W].from_s64(src: LLVM::sub(a: i2, b: 3_s64))).sub(you: zz.mul_finite(you: UnpackedFloat[M, L, W].from_s64(src: LLVM::sub(a: i2, b: 2_s64))).mul_finite(you: d))
    d = t
    i = LLVM::sub(a: i, b: 2_s64)
  # erf(z) = (2/sqrt(pi)) * z * e^(-z^2) * (d/n); the ldexp(1) = factor of 2, rsqrt_pi = 1/sqrt(pi).
  d = d.ldexp(e: 1_s64)
  return me.mul_finite(you: UnpackedFloat[M, L, W].rsqrt_pi()).mul_finite(you: zz.neg().exp(n: 22_s64)).mul_finite(you: d.div(you: n))

### erfc_ continued fraction (TLFloat erfc_, N=120).
routine UnpackedFloat[M, L, W].erfc_cf(levels: S64) -> UnpackedFloat[M, L, W]
  # Backward recurrence for the erfc continued fraction (the i/2 partial terms), `levels` levels
  # (EVEN); converges for the tail |z| >= 3.1 where the erf series loses digits. Caller sizes `levels`
  # to its precision target.
  var zz = me.mul_finite(you: me)
  var n = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var d = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var i = levels
  while LLVM::signed_gt(a: i, b: 0_s64)
    var t = n
    n = n.add(you: UnpackedFloat[M, L, W].from_s64(src: i).ldexp(e: -1_s64).mul_finite(you: d))
    d = t
    t = n
    n = zz.mul_finite(you: n).add(you: UnpackedFloat[M, L, W].from_s64(src: LLVM::sub(a: i, b: 1_s64)).ldexp(e: -1_s64).mul_finite(you: d))
    d = t
    i = LLVM::sub(a: i, b: 2_s64)
  # erfc(z) = (1/sqrt(pi)) * z * e^(-z^2) * (d/n).
  return me.mul_finite(you: UnpackedFloat[M, L, W].rsqrt_pi()).mul_finite(you: zz.neg().exp(n: 22_s64)).mul_finite(you: d.div(you: n))

### Returns the error function `erf(me)`.
routine B128.erf() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    var s = if me.is_negative() then -1_s64 else 1_s64
    return UnpackedFloat[U192, U384, 192].from_s64(src: s).to_b128()
  var thr = UnpackedFloat[U192, U384, 192].from_s64(src: 31_s64).div(you: UnpackedFloat[U192, U384, 192].from_s64(src: 10_s64))
  var a = me.to_uf192()
  if a.lt(you: thr.neg())
    return UnpackedFloat[U192, U384, 192].from_s64(src: -1_s64).sub(you: a.erfc_cf(levels: 120_s64)).to_b128()
  if a.lt(you: thr)
    # 72 levels is bit-exact for B128 across the whole erf branch |z|<3.1 (verified: lv=60 already
    # bit-identical to 120 at z=3.09); the tail branch keeps 120 for the W=192 79-guard-bit margin.
    return a.erf_cf(levels: 72_s64).to_b128()
  return UnpackedFloat[U192, U384, 192].from_s64(src: 1_s64).sub(you: a.erfc_cf(levels: 120_s64)).to_b128()

### Returns the complementary error function `erfc(me)`.
routine B128.erfc() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    var s = if me.is_negative() then 2_s64 else 0_s64
    return UnpackedFloat[U192, U384, 192].from_s64(src: s).to_b128()
  var thr = UnpackedFloat[U192, U384, 192].from_s64(src: 31_s64).div(you: UnpackedFloat[U192, U384, 192].from_s64(src: 10_s64))
  var a = me.to_uf192()
  if a.lt(you: thr.neg())
    return UnpackedFloat[U192, U384, 192].from_s64(src: 2_s64).add(you: a.erfc_cf(levels: 120_s64)).to_b128()
  if a.lt(you: thr)
    return UnpackedFloat[U192, U384, 192].from_s64(src: 1_s64).sub(you: a.erf_cf(levels: 72_s64)).to_b128()
  return a.erfc_cf(levels: 120_s64).to_b128()

### Precision-reduced erf for sub-113-bit targets (D64 ~54 bits): identical branch structure to
### `erf()` but the continued fraction runs at B128 width (113-bit) instead of the full W=192 engine, with
### caller-sized `levels_mid` (|z|<3.1 erf branch) and `levels_tail` (|z|>=3.1 erfc branch).
routine B128.erf_fast(levels_mid: S64, levels_tail: S64) -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    var s = if me.is_negative() then -1_s64 else 1_s64
    return UnpackedFloat[U128, U256, 128].from_s64(src: s).to_b128()
  var thr = UnpackedFloat[U128, U256, 128].from_s64(src: 31_s64).div(you: UnpackedFloat[U128, U256, 128].from_s64(src: 10_s64))
  var a = me.to_uf()
  if a.lt(you: thr.neg())
    return UnpackedFloat[U128, U256, 128].from_s64(src: -1_s64).sub(you: a.erfc_cf(levels: levels_tail)).to_b128()
  if a.lt(you: thr)
    return a.erf_cf(levels: levels_mid).to_b128()
  return UnpackedFloat[U128, U256, 128].from_s64(src: 1_s64).sub(you: a.erfc_cf(levels: levels_tail)).to_b128()

### Precision-reduced erfc for sub-113-bit targets (D64): B128-width continued fraction with
### caller-sized `levels_mid`/`levels_tail`. Mirrors `erfc()`'s branch structure.
routine B128.erfc_fast(levels_mid: S64, levels_tail: S64) -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    var s = if me.is_negative() then 2_s64 else 0_s64
    return UnpackedFloat[U128, U256, 128].from_s64(src: s).to_b128()
  var thr = UnpackedFloat[U128, U256, 128].from_s64(src: 31_s64).div(you: UnpackedFloat[U128, U256, 128].from_s64(src: 10_s64))
  var a = me.to_uf()
  if a.lt(you: thr.neg())
    return UnpackedFloat[U128, U256, 128].from_s64(src: 2_s64).add(you: a.erfc_cf(levels: levels_tail)).to_b128()
  if a.lt(you: thr)
    return UnpackedFloat[U128, U256, 128].from_s64(src: 1_s64).sub(you: a.erf_cf(levels: levels_mid)).to_b128()
  return a.erfc_cf(levels: levels_tail).to_b128()

# ============================================================================
# tgamma / lgamma (TLFloat) — wide-engine Stirling series + reflection.
# Params: R=20, O=35, sin N=15, log N=23, exp N=20.
# ============================================================================

### lgamma core (TLFloat lgamma_): returns (sign, log|gamma(me)|).
routine UnpackedFloat[M, L, W].lgamma_core() -> UFSign[M, L, W]
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var p5 = one.ldexp(e: -1_s64)
  # For a < -1 use the reflection formula at the end; work with a = 1-me there.
  var reflect = me.lt(you: one.neg())
  var a = if reflect then one.sub(you: me) else me
  # Argument augmentation: shift a up to >= 20 by the recurrence gamma(a)=gamma(a+1)/a,
  # accumulating the divided-out factors in w (the Stirling series needs a large argument).
  var inv = a.rint()
  var fr = a.sub(you: inv)
  var w = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var twenty = UnpackedFloat[M, L, W].from_s64(src: 20_s64)
  if inv.lt(you: twenty)
    var ii = inv.to_s64()
    while LLVM::signed_lt(a: ii, b: 20_s64)
      w = w.mul_finite(you: UnpackedFloat[M, L, W].from_s64(src: ii).add(you: fr))
      ii = LLVM::add(a: ii, b: 1_s64)
    a = twenty.add(you: fr)
  # Stirling asymptotic series in 1/a^2 (Bernoulli coefficients, degree 35), Horner.
  var inv_aa = one.div(you: a.mul_finite(you: a))
  var y = UnpackedFloat[M, L, W].gamma_coef(35_s64)
  var i = 34_s64
  while LLVM::signed_ge(a: i, b: 0_s64)
    y = y.fma_finite(b: inv_aa, c: UnpackedFloat[M, L, W].gamma_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  # Stirling: lgamma(a) = series/a + (a-1/2)*ln a - a + (1/2)*ln(2pi); subtract ln|w|
  # to undo the argument augmentation.
  var loga = a.log(n: 23_s64, m: 0_s64, t: 0_s64)
  y = y.div(you: a).add(you: a.sub(you: p5).mul(you: loga)).sub(you: a).add(you: p5.mul(you: UnpackedFloat[M, L, W].ln_2pi()))
  y = y.sub(you: w.abs().log(n: 23_s64, m: 0_s64, t: 0_s64))
  var sign = w.sign()
  if reflect
    # Reflection: lgamma(me) = ln(pi) - ln|sin(pi*fr)| - lgamma(1-me); sign from sin and parity.
    var s = UnpackedFloat[M, L, W].pi().mul(you: fr).sin(n: 15_s64)
    y = UnpackedFloat[M, L, W].ln_pi().sub(you: s.abs().log(n: 23_s64, m: 0_s64, t: 0_s64)).sub(you: y)
    sign = (sign).xor(you: s.sign())
    sign = sign == inv.iseven()
  return UFSign[M, L, W](item0: sign, item1: y)

### Degree-parameterized lgamma core for narrower targets (D64): same W=192-width Stirling
### method as `lgamma_core` (so the W=192 `gamma_coef` table stays valid — it is NOT width-portable),
### but with caller-sized Stirling degree `sdeg` (tail terms negligible at the augmented a>=20),
### `log` degree `logn`, and reflection `sin` degree `sinn`. Argument-augmentation target stays 20.
routine UnpackedFloat[M, L, W].lgamma_core_p(sdeg: S64, logn: S64, sinn: S64) -> UFSign[M, L, W]
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var p5 = one.ldexp(e: -1_s64)
  var reflect = me.lt(you: one.neg())
  var a = if reflect then one.sub(you: me) else me
  var inv = a.rint()
  var fr = a.sub(you: inv)
  var w = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var twenty = UnpackedFloat[M, L, W].from_s64(src: 20_s64)
  if inv.lt(you: twenty)
    var ii = inv.to_s64()
    while LLVM::signed_lt(a: ii, b: 20_s64)
      w = w.mul_finite(you: UnpackedFloat[M, L, W].from_s64(src: ii).add(you: fr))
      ii = LLVM::add(a: ii, b: 1_s64)
    a = twenty.add(you: fr)
  var inv_aa = one.div(you: a.mul_finite(you: a))
  var y = UnpackedFloat[M, L, W].gamma_coef(sdeg)
  var i = LLVM::sub(a: sdeg, b: 1_s64)
  while LLVM::signed_ge(a: i, b: 0_s64)
    y = y.fma_finite(b: inv_aa, c: UnpackedFloat[M, L, W].gamma_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  var loga = a.log(n: logn, m: 0_s64, t: 0_s64)
  y = y.div(you: a).add(you: a.sub(you: p5).mul(you: loga)).sub(you: a).add(you: p5.mul(you: UnpackedFloat[M, L, W].ln_2pi()))
  y = y.sub(you: w.abs().log(n: logn, m: 0_s64, t: 0_s64))
  var sign = w.sign()
  if reflect
    var s = UnpackedFloat[M, L, W].pi().mul(you: fr).sin(n: sinn)
    y = UnpackedFloat[M, L, W].ln_pi().sub(you: s.abs().log(n: logn, m: 0_s64, t: 0_s64)).sub(you: y)
    sign = (sign).xor(you: s.sign())
    sign = sign == inv.iseven()
  return UFSign[M, L, W](item0: sign, item1: y)

### Degree-reduced tgamma for narrower targets (D64): W=192 width (valid gamma_coef) with
### caller-sized Stirling/log/sin/exp degrees. See `lgamma_core_p`.
routine B128.tgamma_unchecked_p(sdeg: S64, logn: S64, sinn: S64, expn: S64) -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    if me.is_negative()
      return B128.from_bits(bits: b128_qnan())
    return me
  var zu = me.to_uf192()
  if me.is_zero()
    var sg = 0_u64
    if me.is_negative()
      sg = 1_u64
    return B128.from_bits(bits: b128_inf(sign: sg))
  if me.is_negative() and zu.isint()
    return B128.from_bits(bits: b128_qnan())
  var p = zu.lgamma_core_p(sdeg: sdeg, logn: logn, sinn: sinn)
  var r = p.item1.exp(n: expn)
  if p.item0
    r = r.neg()
  return r.to_b128()

### Degree-reduced lgamma for narrower targets (D64). See `lgamma_core_p`.
routine B128.lgamma_p(sdeg: S64, logn: S64, sinn: S64) -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_zero() or me.is_infinite()
    return B128.from_bits(bits: b128_inf(sign: 0_u64))
  if me.is_negative() and me.to_uf192().isint()
    return B128.from_bits(bits: b128_inf(sign: 0_u64))
  var p = me.to_uf192().lgamma_core_p(sdeg: sdeg, logn: logn, sinn: sinn)
  return p.item1.to_b128()

### Returns the gamma function `tgamma(me)`.
routine B128.tgamma!() -> B128
  var rr = me.tgamma_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `tgamma(me)` with raw IEEE (poles at 0/negative integers -> inf/qNaN). No crash.
### Core path is `exp(lgamma_core)` with the lgamma sign reapplied.
routine B128.tgamma_unchecked() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    # tgamma(+inf) = +inf; tgamma(-inf) = NaN (C99 F.10.4.4).
    if me.is_negative()
      return B128.from_bits(bits: b128_qnan())
    return me
  var zu = me.to_uf192()
  if me.is_zero()
    var sg = 0_u64
    if me.is_negative()
      sg = 1_u64
    return B128.from_bits(bits: b128_inf(sign: sg))
  if me.is_negative() and zu.isint()
    return B128.from_bits(bits: b128_qnan())
  var p = zu.lgamma_core()
  var r = p.item1.exp(n: 20_s64)
  if p.item0
    r = r.neg()
  return r.to_b128()

### Returns the log-gamma function `lgamma(me)` (= ln|gamma(me)|).
routine B128.lgamma() -> B128
  if me.is_nan()
    return B128.from_bits(bits: b128_quiet(bits: me.to_bits()))
  if me.is_zero() or me.is_infinite()
    return B128.from_bits(bits: b128_inf(sign: 0_u64))
  if me.is_negative() and me.to_uf192().isint()
    return B128.from_bits(bits: b128_inf(sign: 0_u64))
  var p = me.to_uf192().lgamma_core()
  return p.item1.to_b128()
