module Core

# CREDITS: UnpackedFloat[M, L, W] is a port and extension of TLFloat's UnpackedFloat
# (© Naoki Shibata and contributors, Boost Software License 1.0). This generic engine
# backs F128 / F256 / F512 and the decimal transcendental bridges.
# See THIRD-PARTY-NOTICES.md.

# ============================================================================
# UnpackedFloat[M, L, W] — generic extended-precision unpacked float, a faithful
# port of TLFloat's `UnpackedFloat<mant_t, longmant_t, 0, nbmant>` (nbexp = 0).
#
#   M = mantissa integer type (e.g. U128), W bits wide; nbmant = W - 2.
#   L = wide integer type, exactly 2*W bits (e.g. U256), for products/alignment.
#   W = bit width of M (e.g. 128).
#
# Convention: ilogb = exp + 1; value = (-1)^sign * mant * 2^(exp - (W - 3)).
# Arithmetic is correctly rounded to nbmant bits (round-to-nearest-even). Packed
# <-> unpacked casts and coefficient tables live per concrete width.
# ============================================================================

### The generic extended-precision unpacked float.
record UnpackedFloat[M, L, W] obeys Addable, Subtractable, Multiplicable, Divisible
needs L obeys FloorDivisible
needs W is U64
  ### Normalized mantissa (leading bit at W-2 when finite-nonzero).
  mant: M
  ### Unbiased exponent offset (ilogb - 1).
  exp: S64
  ### Sign bit.
  sign: Bool
  ### Whether the value is zero.
  iszero: Bool
  ### Whether the value is an infinity.
  isinf: Bool
  ### Whether the value is NaN.
  isnan: Bool

### No-op teardown: all fields are plain values (no owned entities).
dangerous routine UnpackedFloat[M, L, W].$destroy()
  return

### Decimal digit string of a wide unsigned integer (MSD first; "0" for zero). Repeated
### div/mod by 10 through the type's knuth-based FloorDivisible — table-free, any width.
### Backs the wide-int and Decimal `$represent`s.
routine wide_dec[T](v: T) -> Text
needs T obeys FloorDivisible
  if int_eq[T](a: v, b: zero_extend[U64, T](0_u64))
    return "0"
  var out = ""
  var x = v
  var ten = zero_extend[U64, T](10_u64)
  while int_ne[T](a: x, b: zero_extend[U64, T](0_u64))
    var r = x % ten
    var d = int_truncate[T, U64](r)
    out = f"{d}" + out
    x = x // ten
  return out

### An unpacked value paired with an integer exponent/quadrant. Used instead of a
### `(UnpackedFloat, S64)` tuple because tuples of generic records hit a compiler
### `$destroy` synthesis gap (the tuple type's teardown is never emitted).
record UFExp[M, L, W]
needs W is U64
  ### The reduced/fractional unpacked value.
  item0: UnpackedFloat[M, L, W]
  ### The integer exponent or quadrant.
  item1: S64

### A pair of unpacked values (e.g. tan numerator & denominator). Replaces a
### `(UnpackedFloat, UnpackedFloat)` tuple for the same reason as `UFExp`.
record UFPair[M, L, W]
needs W is U64
  ### First component.
  item0: UnpackedFloat[M, L, W]
  ### Second component.
  item1: UnpackedFloat[M, L, W]

### A sign flag paired with an unpacked value (lgamma result). Replaces a
### `(Bool, UnpackedFloat)` tuple for the same reason as `UFExp`.
record UFSign[M, L, W]
needs W is U64
  ### The sign flag.
  item0: Bool
  ### The magnitude value.
  item1: UnpackedFloat[M, L, W]

# ============================================================================
# Low-level width-generic integer helpers
# ============================================================================

### Converts a non-negative S64 amount into a value of int type `T` (for shift
### amounts derived from runtime S64 values, which are strictly typed).
routine uf_amt[T](s: S64) -> ?T
  return zero_extend[U64, T](reinterpret_bits[S64, U64](s))

### Tests bit `pos` of a `T`.
routine uf_bit[T](v: T, pos: S64) -> Bool
  return int_ne[T](a: bit_and[T](a: v, b: shift_left[T](value: 1, bits: uf_amt[T](pos))), b: 0)

### Logical left (s>=0) or right (s<0) shift of a `T` by an S64 amount.
routine uf_sh[T](v: T, s: S64) -> ?T
  if signed_ge[S64](a: s, b: 0_s64)
    return shift_left[T](value: v, bits: uf_amt[T](s))
  return shift_right_unsigned[T](v, uf_amt[T](sub[S64](a: 0_s64, b: s)))

### The mask `(1 << n) - 1` as a `T`.
routine uf_lowmask[T](n: S64) -> ?T
  return sub[T](a: shift_left[T](value: 1, bits: uf_amt[T](n)), b: 1)

### Boolean XOR (for sign combination).
routine uf_bxor(a: Bool, b: Bool) -> Bool
  return (a or b) and not (a and b)

### Counts leading zeros of an `L` (over 2*W bits) using two M-wide halves.
routine uf_clzL[M, L, W](v: L) -> S64
  var wb = reinterpret_bits[U64, S64](W)
  var hi = int_truncate[L, M](shift_right_unsigned[L](v, uf_amt[L](wb)))
  if int_ne[M](a: hi, b: 0)
    return int_truncate[M, S64](leading_zeros[M](hi))
  var lo = int_truncate[L, M](v)
  return add[S64](a: wb, b: int_truncate[M, S64](leading_zeros[M](lo)))

# ============================================================================
# Constructors
# ============================================================================

### Builds an unpacked value from its components.
common routine UnpackedFloat[M, L, W].make(mant: M, exp: S64, sign: Bool, iszero: Bool, isinf: Bool, isnan: Bool) -> ?UnpackedFloat[M, L, W]
  return UnpackedFloat[M, L, W](mant: mant, exp: exp, sign: sign, iszero: iszero, isinf: isinf, isnan: isnan)

### Positive or negative zero.
common routine UnpackedFloat[M, L, W].zero(sign: Bool) -> ?UnpackedFloat[M, L, W]
  return UnpackedFloat[M, L, W](mant: zero_extend[U64, M](0_u64), exp: 0_s64, sign: sign, iszero: true, isinf: false, isnan: false)

### Positive or negative infinity.
common routine UnpackedFloat[M, L, W].inf(sign: Bool) -> ?UnpackedFloat[M, L, W]
  # mantissa = the leading bit at position W-2 (canonical normalized leading-bit slot).
  var lead = shift_left[M](value: 1, bits: uf_amt[M](sub[S64](a: reinterpret_bits[U64, S64](W), b: 2_s64)))
  return UnpackedFloat[M, L, W](mant: lead, exp: -1_s64, sign: sign, iszero: false, isinf: true, isnan: false)

### The canonical quiet NaN.
common routine UnpackedFloat[M, L, W].nan() -> ?UnpackedFloat[M, L, W]
  # mantissa = 0b11 at bit W-2 -> leading bit set plus the quiet bit just below it.
  var m = shift_left[M](value: 3, bits: uf_amt[M](sub[S64](a: reinterpret_bits[U64, S64](W), b: 3_s64)))
  return UnpackedFloat[M, L, W](mant: m, exp: -1_s64, sign: false, iszero: false, isinf: false, isnan: true)

# ============================================================================
# Sign, scaling, comparison
# ============================================================================

### Arithmetic negation.
routine UnpackedFloat[M, L, W].neg() -> ?UnpackedFloat[M, L, W]
  return UnpackedFloat[M, L, W](mant: me.mant, exp: me.exp, sign: not me.sign, iszero: me.iszero, isinf: me.isinf, isnan: me.isnan)

### Absolute value.
routine UnpackedFloat[M, L, W].abs() -> ?UnpackedFloat[M, L, W]
  return UnpackedFloat[M, L, W](mant: me.mant, exp: me.exp, sign: false, iszero: me.iszero, isinf: me.isinf, isnan: me.isnan)

### Multiplies by `2^e` by adjusting the exponent (TLFloat `ldexp_`).
routine UnpackedFloat[M, L, W].ldexp(e: S64) -> ?UnpackedFloat[M, L, W]
  if me.iszero
    return me
  var y = add[S64](a: me.exp, b: e)
  if signed_lt[S64](a: y, b: -2147483648_s64)
    return UnpackedFloat[M, L, W].zero(sign: me.sign)
  if signed_gt[S64](a: y, b: 2147483647_s64)
    return UnpackedFloat[M, L, W].inf(sign: me.sign)
  return UnpackedFloat[M, L, W](mant: me.mant, exp: y, sign: me.sign, iszero: false, isinf: false, isnan: false)

### Three-way comparison (TLFloat `cmp`): -1 if me<you, 0 if equal, +1 if me>you.
### NaN is not handled here (callers guard).
routine UnpackedFloat[M, L, W].cmp(you: UnpackedFloat[M, L, W]) -> S64
  if me.iszero and you.iszero
    return 0_s64
  if you.iszero
    return if me.sign then -1_s64 else 1_s64
  if me.iszero
    return if you.sign then 1_s64 else -1_s64
  if not me.sign and you.sign
    return 1_s64
  if me.sign and not you.sign
    return -1_s64
  if signed_gt[S64](a: me.exp, b: you.exp)
    return if me.sign then -1_s64 else 1_s64
  if signed_lt[S64](a: me.exp, b: you.exp)
    return if me.sign then 1_s64 else -1_s64
  if unsigned_gt[M](a: me.mant, b: you.mant)
    return if me.sign then -1_s64 else 1_s64
  if unsigned_lt[M](a: me.mant, b: you.mant)
    return if me.sign then 1_s64 else -1_s64
  return 0_s64

# ============================================================================
# Addition / subtraction (faithful port of TLFloat faddsub, nbexp=0)
# ============================================================================

### Core add/subtract: returns `me ± you` (subtract when `negate`).
routine UnpackedFloat[M, L, W].faddsub(you: UnpackedFloat[M, L, W], negate: Bool) -> UnpackedFloat[M, L, W]
  var wb = reinterpret_bits[U64, S64](W)
  var carry = sub[S64](a: mul[S64](a: 2_s64, b: wb), b: 1_s64)
  var wm1 = sub[S64](a: wb, b: 1_s64)
  var negwb = sub[S64](a: 0_s64, b: wb)
  var rsign = uf_bxor(a: you.sign, b: negate)
  var ed = sub[S64](a: me.exp, b: you.exp)
  if me.iszero or me.isinf or me.isnan or you.iszero or you.isinf or you.isnan or signed_gt[S64](a: ed, b: wb) or signed_lt[S64](a: ed, b: negwb)
    if me.iszero and you.iszero
      return UnpackedFloat[M, L, W].make(mant: zero_extend[U64, M](0_u64), exp: 0_s64, sign: me.sign and rsign, iszero: true, isinf: false, isnan: false)
    if me.isnan or you.iszero
      return me
    if you.isnan or me.iszero
      return UnpackedFloat[M, L, W].make(mant: you.mant, exp: you.exp, sign: rsign, iszero: you.iszero, isinf: you.isinf, isnan: you.isnan)
    if me.isinf or you.isinf
      if me.isinf and you.isinf and (me.sign == rsign)
        return me
      if me.isinf and you.isinf and (me.sign != rsign)
        return UnpackedFloat[M, L, W].nan()
      if me.isinf
        return me
      return UnpackedFloat[M, L, W].make(mant: you.mant, exp: you.exp, sign: rsign, iszero: you.iszero, isinf: you.isinf, isnan: you.isnan)
    if signed_gt[S64](a: ed, b: wb)
      return me
    if signed_lt[S64](a: ed, b: negwb)
      return UnpackedFloat[M, L, W].make(mant: you.mant, exp: you.exp, sign: rsign, iszero: you.iszero, isinf: you.isinf, isnan: you.isnan)
  # True subtraction iff the effective signs differ; align both mantissas into the
  # wide L word so the larger keeps wb fraction bits and the smaller is shifted by ed.
  var subtract = me.sign != rsign
  var lsh = if signed_gt[S64](a: ed, b: 0_s64) then wb else add[S64](a: wb, b: ed)
  var rsh = if signed_gt[S64](a: ed, b: 0_s64) then sub[S64](a: wb, b: ed) else wb
  var lm = uf_sh[L](v: zero_extend[M, L](me.mant), s: lsh)
  var rm = uf_sh[L](v: zero_extend[M, L](you.mant), s: rsh)
  var exp = if signed_gt[S64](a: ed, b: 0_s64) then me.exp else you.exp
  var am = uf_amt[L](0_s64)
  var rsign2 = me.sign
  if not subtract
    am = add[L](a: lm, b: rm)
    # carry out of the top bit -> renormalize right by one, bump exponent.
    if uf_bit[L](v: am, pos: carry)
      am = uf_sh[L](v: am, s: -1_s64)
      exp = add[S64](a: exp, b: 1_s64)
    # round-half-even: base addend is all the low guard bits; +1 when the round bit (wb) is set.
    var addend = uf_lowmask[L](wm1)
    if uf_bit[L](v: am, pos: wb)
      addend = add[L](a: addend, b: uf_amt[L](1_s64))
    am = add[L](a: am, b: addend)
    if uf_bit[L](v: am, pos: carry)
      am = uf_sh[L](v: am, s: -1_s64)
      exp = add[S64](a: exp, b: 1_s64)
  else
    # magnitude subtraction: result takes the sign of the larger operand.
    if unsigned_lt[L](a: lm, b: rm)
      am = sub[L](a: rm, b: lm)
      rsign2 = rsign
    else
      am = sub[L](a: lm, b: rm)
      rsign2 = me.sign
    # exact cancellation yields +0.
    if int_eq[L](a: am, b: 0)
      rsign2 = false
    # renormalize: shift the leading set bit back up to its canonical position, adjust exp.
    var x = sub[S64](a: uf_clzL[M, L, W](am), b: 1_s64)
    am = uf_sh[L](v: am, s: x)
    exp = sub[S64](a: exp, b: x)
    var addend = uf_lowmask[L](wm1)
    if uf_bit[L](v: am, pos: wb)
      addend = add[L](a: addend, b: uf_amt[L](1_s64))
    am = add[L](a: am, b: addend)
    if uf_bit[L](v: am, pos: carry)
      am = uf_sh[L](v: am, s: -1_s64)
      exp = add[S64](a: exp, b: 1_s64)
  am = uf_sh[L](v: am, s: negwb)
  var am128 = int_truncate[L, M](am)
  var amzero = int_eq[M](a: am128, b: 0)
  if amzero
    exp = 0_s64
  if signed_lt[S64](a: exp, b: -2147483648_s64)
    return UnpackedFloat[M, L, W].zero(sign: rsign2)
  if signed_gt[S64](a: exp, b: 2147483647_s64)
    return UnpackedFloat[M, L, W].inf(sign: rsign2)
  return UnpackedFloat[M, L, W].make(mant: am128, exp: exp, sign: rsign2, iszero: amzero, isinf: false, isnan: false)

### Returns `me + you`.
routine UnpackedFloat[M, L, W].add(you: UnpackedFloat[M, L, W]) -> ?UnpackedFloat[M, L, W]
  return me.faddsub(you: you, negate: false)

### Returns `me - you`.
routine UnpackedFloat[M, L, W].sub(you: UnpackedFloat[M, L, W]) -> ?UnpackedFloat[M, L, W]
  return me.faddsub(you: you, negate: true)

# ============================================================================
# Multiplication (faithful port of TLFloat fmul, nbexp=0)
# ============================================================================

### Returns `me * you`.
routine UnpackedFloat[M, L, W].mul(you: UnpackedFloat[M, L, W]) -> ?UnpackedFloat[M, L, W]
  if me.isnan or you.isnan or (me.iszero and you.isinf) or (me.isinf and you.iszero) or me.isinf or you.isinf
    if me.isnan
      return me
    if you.isnan
      return you
    if (me.iszero and you.isinf) or (me.isinf and you.iszero)
      return UnpackedFloat[M, L, W].nan()
    return UnpackedFloat[M, L, W].inf(sign: uf_bxor(a: me.sign, b: you.sign))
  var wb = reinterpret_bits[U64, S64](W)
  var carry = sub[S64](a: mul[S64](a: 2_s64, b: wb), b: 1_s64)
  var wm1 = sub[S64](a: wb, b: 1_s64)
  var am = mul[L](a: zero_extend[M, L](me.mant), b: zero_extend[M, L](you.mant))
  var x = sub[S64](a: uf_clzL[M, L, W](am), b: 4_s64)
  am = uf_sh[L](v: am, s: add[S64](a: x, b: 3_s64))
  var exp = sub[S64](a: add[S64](a: me.exp, b: you.exp), b: x)
  var addend = uf_lowmask[L](wm1)
  if uf_bit[L](v: am, pos: wb)
    addend = add[L](a: addend, b: uf_amt[L](1_s64))
  am = add[L](a: am, b: addend)
  if uf_bit[L](v: am, pos: carry)
    am = uf_sh[L](v: am, s: -1_s64)
    exp = add[S64](a: exp, b: 1_s64)
  am = uf_sh[L](v: am, s: sub[S64](a: 0_s64, b: wb))
  var am128 = int_truncate[L, M](am)
  var amz = int_eq[M](a: am128, b: 0)
  if amz
    exp = 0_s64
  if signed_lt[S64](a: exp, b: -2147483648_s64)
    return UnpackedFloat[M, L, W].zero(sign: uf_bxor(a: me.sign, b: you.sign))
  if signed_gt[S64](a: exp, b: 2147483647_s64)
    return UnpackedFloat[M, L, W].inf(sign: uf_bxor(a: me.sign, b: you.sign))
  return UnpackedFloat[M, L, W].make(mant: am128, exp: exp, sign: uf_bxor(a: me.sign, b: you.sign), iszero: amz, isinf: false, isnan: false)

# ============================================================================
# Division (correctly rounded to nbmant bits via the L numerator)
# ============================================================================

### Returns `me / you`.
routine UnpackedFloat[M, L, W].div(you: UnpackedFloat[M, L, W]) -> ?UnpackedFloat[M, L, W]
  if me.isnan
    return me
  if you.isnan
    return you
  if you.iszero
    if me.iszero
      return UnpackedFloat[M, L, W].nan()
    return UnpackedFloat[M, L, W].inf(sign: uf_bxor(a: me.sign, b: you.sign))
  if you.isinf
    if me.isinf
      return UnpackedFloat[M, L, W].nan()
    return UnpackedFloat[M, L, W].zero(sign: uf_bxor(a: me.sign, b: you.sign))
  if me.isinf
    return UnpackedFloat[M, L, W].inf(sign: uf_bxor(a: me.sign, b: you.sign))
  if me.iszero
    return UnpackedFloat[M, L, W].zero(sign: uf_bxor(a: me.sign, b: you.sign))
  var wb = reinterpret_bits[U64, S64](W)
  var nbm = sub[S64](a: wb, b: 2_s64)
  var wm1 = sub[S64](a: wb, b: 1_s64)
  var sign = uf_bxor(a: me.sign, b: you.sign)
  var num = uf_sh[L](v: zero_extend[M, L](me.mant), s: wb)
  var den = zero_extend[M, L](you.mant)
  # Delegate to L's FloorDivisible `//` (knuth-based for the wide types) instead of the
  # generic `unsigned_div`/`unsigned_rem` intrinsics, which lower to a catastrophically
  # slow `udiv/urem iN` software expansion (~2.6us/op for i512). One knuth divide; the
  # remainder (only needed as a nonzero/sticky flag) comes from a cheap mul-back.
  var quo = num // den
  var rrem = sub[L](a: num, b: mul[L](a: quo, b: den))
  # msbq = index of the quotient's top set bit; s = how many low bits to drop to nbmant.
  var msbq = sub[S64](a: sub[S64](a: mul[S64](a: 2_s64, b: wb), b: 1_s64), b: uf_clzL[M, L, W](quo))
  var s = sub[S64](a: msbq, b: nbm)
  var q = int_truncate[L, M](uf_sh[L](v: quo, s: sub[S64](a: 0_s64, b: s)))
  # lost = the dropped low s bits; half = the round bit (2^(s-1)) for half-even decisions.
  var lost = int_truncate[L, M](bit_and[L](a: quo, b: uf_lowmask[L](s)))
  var half = uf_sh[M](v: uf_amt[M](1_s64), s: sub[S64](a: s, b: 1_s64))
  var rexp = sub[S64](a: add[S64](a: sub[S64](a: me.exp, b: you.exp), b: msbq), b: add[S64](a: wb, b: 1_s64))
  var roundup = false
  # > half -> round up; == half -> sticky (nonzero remainder) breaks the tie, else even.
  if unsigned_gt[M](a: lost, b: half)
    roundup = true
  elseif int_eq[M](a: lost, b: half)
    if int_ne[L](a: rrem, b: 0)
      roundup = true
    else
      roundup = int_ne[M](a: bit_and[M](a: q, b: uf_amt[M](1_s64)), b: 0)
  if roundup
    q = add[M](a: q, b: uf_amt[M](1_s64))
    # rounding may carry into bit W-1 -> renormalize down one and bump the exponent.
    if uf_bit[M](v: q, pos: wm1)
      q = uf_sh[M](v: q, s: -1_s64)
      rexp = add[S64](a: rexp, b: 1_s64)
  return UnpackedFloat[M, L, W].make(mant: q, exp: rexp, sign: sign, iszero: false, isinf: false, isnan: false)

# ============================================================================
# Wired operators (back the + - * / surface from the obeyed Addable/Subtractable/
# Multiplicable/Divisible protocols). They forward to the named cores. NOTE: the
# operator result type only pins to the concrete instantiation when the receiver
# is concretely typed (e.g. UnpackedFloat[U128,U256,128] in tests); inside the
# generic engine the named methods are used directly to keep Me bound.
# ============================================================================

### Wired `+` — returns `me + you`.
routine UnpackedFloat[M, L, W].$add(you: UnpackedFloat[M, L, W]) -> ?UnpackedFloat[M, L, W]
  return me.add(you: you)

### Wired `-` — returns `me - you`.
routine UnpackedFloat[M, L, W].$sub(you: UnpackedFloat[M, L, W]) -> ?UnpackedFloat[M, L, W]
  return me.sub(you: you)

### Wired `*` — returns `me * you`.
routine UnpackedFloat[M, L, W].$mul(you: UnpackedFloat[M, L, W]) -> ?UnpackedFloat[M, L, W]
  return me.mul(you: you)

### Wired `/` — returns `me / you`.
routine UnpackedFloat[M, L, W].$truediv(you: UnpackedFloat[M, L, W]) -> ?UnpackedFloat[M, L, W]
  return me.div(you: you)

# ============================================================================
# Extra helpers for fma / sqrt
# ============================================================================

### Returns 1 (when `cond`) or 0, as a `T`.
routine uf_bL[T](cond: Bool) -> ?T
  if cond
    return uf_amt[T](1_s64)
  return uf_amt[T](0_s64)

### Clears the low `n` bits of a `T`.
routine uf_clearlow[T](v: T, n: S64) -> ?T
  return bit_and[T](a: v, b: bit_xor[T](a: uf_lowmask[T](n), b: sub[T](a: 0, b: 1)))

### Integer square root over the wide type `L` (restoring bitwise method).
routine uf_isqrt[L, W](n: L) -> ?L
  var wb = reinterpret_bits[U64, S64](W)
  var rem = n
  var res = uf_amt[L](0_s64)
  var bit = shift_left[L](value: 1, bits: uf_amt[L](sub[S64](a: mul[S64](a: 2_s64, b: wb), b: 2_s64)))
  while unsigned_gt[L](a: bit, b: rem)
    bit = shift_right_unsigned[L](bit, uf_amt[L](2_s64))
  while int_ne[L](a: bit, b: 0)
    var rb = add[L](a: res, b: bit)
    if unsigned_ge[L](a: rem, b: rb)
      rem = sub[L](a: rem, b: rb)
      res = add[L](a: shift_right_unsigned[L](res, uf_amt[L](1_s64)), b: bit)
    else
      res = shift_right_unsigned[L](res, uf_amt[L](1_s64))
    bit = shift_right_unsigned[L](bit, uf_amt[L](2_s64))
  return res

# ============================================================================
# Fused multiply-add (faithful port of TLFloat fma, nbexp=0, NGB=4) — me*b + c.
# ============================================================================

### Returns `me*b + c` with a single rounding to nbmant bits.
routine UnpackedFloat[M, L, W].fma(b: UnpackedFloat[M, L, W], c: UnpackedFloat[M, L, W]) -> ?UnpackedFloat[M, L, W]
  if me.isnan or me.isinf or b.isnan or b.isinf or c.isnan or c.isinf
    if me.isnan
      return me
    if b.isnan
      return b
    if c.isnan
      return c
    if (me.iszero and b.isinf) or (me.isinf and b.iszero)
      return UnpackedFloat[M, L, W].nan()
    if not c.isinf
      return UnpackedFloat[M, L, W].inf(sign: uf_bxor(a: me.sign, b: b.sign))
    if not (me.isinf or b.isinf) or (uf_bxor(a: me.sign, b: b.sign) == c.sign)
      return UnpackedFloat[M, L, W].inf(sign: c.sign)
    return UnpackedFloat[M, L, W].nan()
  var wb = reinterpret_bits[U64, S64](W)
  var twoW = mul[S64](a: 2_s64, b: wb)
  var carry = sub[S64](a: twoW, b: 1_s64)
  var wm1 = sub[S64](a: wb, b: 1_s64)
  var pexp = add[S64](a: me.exp, b: b.exp)
  var am = mul[L](a: zero_extend[M, L](me.mant), b: zero_extend[M, L](b.mant))
  var x = sub[S64](a: uf_clzL[M, L, W](am), b: 4_s64)
  am = uf_sh[L](v: am, s: add[S64](a: x, b: 3_s64))
  pexp = sub[S64](a: pexp, b: x)
  var amzero = int_eq[L](a: am, b: 0)
  if amzero
    pexp = 0_s64
  var ed = sub[S64](a: pexp, b: c.exp)
  if amzero and c.iszero
    ed = 0_s64
  elseif amzero
    ed = sub[S64](a: 0_s64, b: twoW)
  elseif c.iszero
    ed = twoW
  var subtract = uf_bxor(a: uf_bxor(a: me.sign, b: b.sign), b: c.sign)
  var resultsign = uf_bxor(a: me.sign, b: b.sign)
  var amsb = false
  var zmsb = false
  var zm = uf_sh[L](v: zero_extend[M, L](c.mant), s: wb)
  if signed_lt[S64](a: ed, b: 0_s64)
    if signed_le[S64](a: ed, b: sub[S64](a: 4_s64, b: twoW))
      amsb = int_ne[L](a: am, b: 0)
      am = uf_amt[L](0_s64)
    else
      amsb = int_ne[L](a: bit_and[L](a: uf_lowmask[L](sub[S64](a: 4_s64, b: ed)), b: am), b: 0)
      am = uf_clearlow[L](v: uf_sh[L](v: am, s: ed), n: 4_s64)
  else
    if signed_ge[S64](a: ed, b: sub[S64](a: twoW, b: 4_s64))
      zmsb = int_ne[L](a: zm, b: 0)
      zm = uf_amt[L](0_s64)
    else
      zmsb = int_ne[L](a: bit_and[L](a: uf_lowmask[L](add[S64](a: 4_s64, b: ed)), b: zm), b: 0)
      zm = uf_clearlow[L](v: uf_sh[L](v: zm, s: sub[S64](a: 0_s64, b: ed)), n: 4_s64)
  var exp = if signed_gt[S64](a: ed, b: 0_s64) then pexp else c.exp
  if not subtract
    am = add[L](a: am, b: zm)
    if uf_bit[L](v: am, pos: carry)
      am = uf_sh[L](v: am, s: -1_s64)
      exp = add[S64](a: exp, b: 1_s64)
    var addend = add[L](a: uf_lowmask[L](wm1), b: uf_bL[L](cond: amsb or zmsb or uf_bit[L](v: am, pos: wb)))
    am = add[L](a: am, b: addend)
  else
    var amge = unsigned_ge[L](a: am, b: zm)
    var psb = if amge then amsb else zmsb
    var nsb = if amge then zmsb else amsb
    resultsign = if amge then resultsign else c.sign
    if amge
      am = sub[L](a: am, b: zm)
    else
      am = sub[L](a: zm, b: am)
    if int_eq[L](a: am, b: 0) and not psb
      resultsign = false
    var x2 = sub[S64](a: uf_clzL[M, L, W](am), b: 1_s64)
    am = uf_sh[L](v: am, s: x2)
    exp = sub[S64](a: exp, b: x2)
    var addend = add[L](a: uf_lowmask[L](wm1), b: uf_bL[L](cond: (not nsb) and (psb or uf_bit[L](v: am, pos: wb))))
    am = add[L](a: am, b: addend)
  if uf_bit[L](v: am, pos: carry)
    am = uf_sh[L](v: am, s: -1_s64)
    exp = add[S64](a: exp, b: 1_s64)
  am = uf_sh[L](v: am, s: sub[S64](a: 0_s64, b: wb))
  var am128 = int_truncate[L, M](am)
  var amz2 = int_eq[M](a: am128, b: 0)
  if amz2
    exp = 0_s64
  if signed_lt[S64](a: exp, b: -2147483648_s64)
    return UnpackedFloat[M, L, W].zero(sign: resultsign)
  if signed_gt[S64](a: exp, b: 2147483647_s64)
    return UnpackedFloat[M, L, W].inf(sign: resultsign)
  return UnpackedFloat[M, L, W].make(mant: am128, exp: exp, sign: resultsign, iszero: amz2, isinf: false, isnan: false)

# ============================================================================
# Square root (faithful port of TLFloat sqrt_)
# ============================================================================

### Returns the correctly-rounded square root.
### Faithful reciprocal-sqrt via Newton (multiply-only) for the binary512 scratch
### tier. The exact bit-by-bit `uf_isqrt` is O(W^2) (~512 digit-recurrence iters at
### W=512); Newton converges quadratically (~10 wide multiplies). F512 is internal
### faithful-rounded scratch, so ~1 ULP is within contract. me must be > 0, finite, normal.
### Normalize me = v * 2^(2k) with v in [1,4); seed 1/sqrt(v) to ~2 bits; iterate
### y <- y*(3 - v*y^2)/2; return (v*y) * 2^k.
routine UnpackedFloat[M, L, W].sqrt_newton() -> ?UnpackedFloat[M, L, W]
  var e1 = add[S64](a: me.exp, b: 1_s64)
  var twok = bit_and[S64](a: e1, b: -2_s64)
  var k = signed_div[S64](a: twok, b: 2_s64)
  var v = me.ldexp(e: sub[S64](a: 0_s64, b: twok))
  var y = UnpackedFloat[M, L, W].from_s64(src: 13_s64).ldexp(e: -4_s64)
  if signed_ge[S64](a: v.exp, b: 0_s64)
    y = UnpackedFloat[M, L, W].from_s64(src: 37_s64).ldexp(e: -6_s64)
  var three = UnpackedFloat[M, L, W].from_s64(src: 3_s64)
  var j = 0_s64
  while signed_lt[S64](a: j, b: 10_s64)
    var t = v.mul(you: y).mul(you: y)
    y = y.mul(you: three.sub(you: t)).ldexp(e: -1_s64)
    j = add[S64](a: j, b: 1_s64)
  return v.mul(you: y).ldexp(e: k)

### Returns the correctly-rounded square root (NaN-of-negative, ±0 and +inf pass through).
### W>=256 routes to the quadratic Newton path; narrower W uses the bitwise `uf_isqrt`.
routine UnpackedFloat[M, L, W].sqrt() -> ?UnpackedFloat[M, L, W]
  if me.isnan
    return me
  if me.iszero
    return me
  # sqrt of a negative value (including -inf) has no real result -> NaN.
  if me.sign
    return UnpackedFloat[M, L, W].nan()
  if me.isinf
    return me
  # Newton's reciprocal-sqrt (10 iters, quadratic) is width-generic and ~O(W); the bitwise
  # `uf_isqrt` fallback below is O(W²). Only F256/F512 reach this engine (F128 has its own sqrt),
  # so route both to Newton — previously only W==512 did, leaving F256 stuck on the slow path.
  if unsigned_ge[U64](a: W, b: 256_u64)
    return me.sqrt_newton()
  var wb = reinterpret_bits[U64, S64](W)
  var offset = 100000000_s64
  var y = sub[S64](a: int_truncate[M, S64](leading_zeros[M](me.mant)), b: 1_s64)
  var x = sub[S64](a: me.exp, b: y)
  var tpar = signed_rem[S64](a: add[S64](a: x, b: offset), b: 2_s64)
  var par = sub[S64](a: 1_s64, b: tpar)
  var s0 = add[S64](a: add[S64](a: wb, b: par), b: y)
  var l = uf_isqrt[L, W](n: uf_sh[L](v: zero_extend[M, L](me.mant), s: s0))
  var s1 = sub[S64](a: add[S64](a: wb, b: 1_s64), b: uf_clzL[M, L, W](l))
  var addl = uf_lowmask[L](sub[S64](a: s1, b: 1_s64))
  if uf_bit[L](v: l, pos: s1)
    addl = add[L](a: addl, b: uf_amt[L](1_s64))
  l = add[L](a: l, b: addl)
  if not uf_bit[L](v: l, pos: sub[S64](a: mul[S64](a: 2_s64, b: wb), b: 1_s64))
    l = sub[L](a: l, b: uf_amt[L](1_s64))
  var m = int_truncate[L, M](uf_sh[L](v: l, s: sub[S64](a: 0_s64, b: s1)))
  if uf_bit[M](v: m, pos: sub[S64](a: wb, b: 1_s64))
    m = uf_sh[M](v: m, s: -1_s64)
    x = add[S64](a: x, b: 1_s64)
  var rexp = sub[S64](a: signed_div[S64](a: add[S64](a: add[S64](a: x, b: mul[S64](a: offset, b: 2_s64)), b: 1_s64), b: 2_s64), b: add[S64](a: offset, b: 1_s64))
  return UnpackedFloat[M, L, W].make(mant: m, exp: rexp, sign: false, iszero: int_eq[M](a: m, b: 0), isinf: false, isnan: false)

# ============================================================================
# Rounding to integer
# ============================================================================

### Truncates toward zero to an integer.
routine UnpackedFloat[M, L, W].trunc() -> ?UnpackedFloat[M, L, W]
  if me.iszero or me.isinf or me.isnan
    return me
  var wb = reinterpret_bits[U64, S64](W)
  if signed_ge[S64](a: me.exp, b: sub[S64](a: wb, b: 2_s64))
    return me
  if signed_lt[S64](a: me.exp, b: -1_s64)
    return UnpackedFloat[M, L, W].zero(sign: me.sign)
  var s = sub[S64](a: sub[S64](a: wb, b: 3_s64), b: me.exp)
  var mask = bit_xor[M](a: uf_lowmask[M](s), b: sub[M](a: 0, b: 1))
  return UnpackedFloat[M, L, W].make(mant: bit_and[M](a: me.mant, b: mask), exp: me.exp, sign: me.sign, iszero: false, isinf: false, isnan: false)

### Rounds to nearest integer, ties away from zero (TLFloat `round`).
routine UnpackedFloat[M, L, W].round() -> ?UnpackedFloat[M, L, W]
  if me.iszero or me.isinf or me.isnan
    return me
  var wb = reinterpret_bits[U64, S64](W)
  if signed_ge[S64](a: me.exp, b: sub[S64](a: wb, b: 3_s64))
    return me
  if signed_lt[S64](a: me.exp, b: -2_s64)
    return UnpackedFloat[M, L, W].zero(sign: me.sign)
  var s = sub[S64](a: sub[S64](a: wb, b: 3_s64), b: me.exp)
  var m = add[M](a: me.mant, b: shift_left[M](value: 1, bits: uf_amt[M](sub[S64](a: s, b: 1_s64))))
  m = bit_and[M](a: m, b: bit_xor[M](a: uf_lowmask[M](s), b: sub[M](a: 0, b: 1)))
  var exp = me.exp
  if uf_bit[M](v: m, pos: sub[S64](a: wb, b: 1_s64))
    m = uf_sh[M](v: m, s: -1_s64)
    exp = add[S64](a: exp, b: 1_s64)
  if int_eq[M](a: m, b: 0)
    return UnpackedFloat[M, L, W].zero(sign: me.sign)
  return UnpackedFloat[M, L, W].make(mant: m, exp: exp, sign: me.sign, iszero: false, isinf: false, isnan: false)

### Rounds to nearest integer, ties to even (TLFloat `rint`).
routine UnpackedFloat[M, L, W].rint() -> ?UnpackedFloat[M, L, W]
  if me.iszero or me.isinf or me.isnan
    return me
  var wb = reinterpret_bits[U64, S64](W)
  if signed_ge[S64](a: me.exp, b: sub[S64](a: wb, b: 3_s64))
    return me
  if signed_lt[S64](a: me.exp, b: -2_s64)
    return UnpackedFloat[M, L, W].zero(sign: me.sign)
  var s = sub[S64](a: sub[S64](a: wb, b: 3_s64), b: me.exp)
  var lsbit = bit_and[M](a: shift_right_unsigned[M](me.mant, uf_amt[M](s)), b: uf_amt[M](1_s64))
  var m = add[M](a: add[M](a: me.mant, b: lsbit), b: sub[M](a: shift_left[M](value: 1, bits: uf_amt[M](sub[S64](a: s, b: 1_s64))), b: 1))
  m = bit_and[M](a: m, b: bit_xor[M](a: uf_lowmask[M](s), b: sub[M](a: 0, b: 1)))
  var exp = me.exp
  if uf_bit[M](v: m, pos: sub[S64](a: wb, b: 1_s64))
    m = uf_sh[M](v: m, s: -1_s64)
    exp = add[S64](a: exp, b: 1_s64)
  if int_eq[M](a: m, b: 0)
    return UnpackedFloat[M, L, W].zero(sign: me.sign)
  return UnpackedFloat[M, L, W].make(mant: m, exp: exp, sign: me.sign, iszero: false, isinf: false, isnan: false)

# ============================================================================
# Integer <-> unpacked conversion
# ============================================================================

### Builds an unpacked value from a non-negative 64-bit integer.
common routine UnpackedFloat[M, L, W].from_u64(v: U64) -> ?UnpackedFloat[M, L, W]
  if v == 0_u64
    return UnpackedFloat[M, L, W].zero(sign: false)
  var wb = reinterpret_bits[U64, S64](W)
  var x = sub[S64](a: 64_s64, b: reinterpret_bits[U64, S64](leading_zeros[U64](v)))
  var s = sub[S64](a: sub[S64](a: mul[S64](a: 2_s64, b: wb), b: 1_s64), b: x)
  var u = uf_sh[L](v: zero_extend[U64, L](v), s: s)
  var rb = uf_lowmask[L](sub[S64](a: wb, b: 1_s64))
  if uf_bit[L](v: u, pos: wb)
    rb = add[L](a: rb, b: uf_amt[L](1_s64))
  u = add[L](a: u, b: rb)
  if uf_bit[L](v: u, pos: sub[S64](a: mul[S64](a: 2_s64, b: wb), b: 1_s64))
    u = uf_sh[L](v: u, s: -1_s64)
    x = add[S64](a: x, b: 1_s64)
  u = uf_sh[L](v: u, s: sub[S64](a: 0_s64, b: wb))
  var m = int_truncate[L, M](u)
  return UnpackedFloat[M, L, W].make(mant: m, exp: sub[S64](a: x, b: 2_s64), sign: false, iszero: int_eq[M](a: m, b: 0), isinf: false, isnan: false)

### Builds an unpacked value from a signed 64-bit integer.
common routine UnpackedFloat[M, L, W].from_s64(src: S64) -> ?UnpackedFloat[M, L, W]
  if src == 0_s64
    return UnpackedFloat[M, L, W].zero(sign: false)
  var sign = signed_lt[S64](a: src, b: 0_s64)
  var v = if sign then sub[S64](a: 0_s64, b: src) else src
  var r = UnpackedFloat[M, L, W].from_u64(v: reinterpret_bits[S64, U64](v))
  return UnpackedFloat[M, L, W].make(mant: r.mant, exp: r.exp, sign: sign, iszero: r.iszero, isinf: false, isnan: false)

### Truncates toward zero into a signed 64-bit integer (castToInt).
routine UnpackedFloat[M, L, W].to_s64() -> S64
  if signed_lt[S64](a: me.exp, b: -1_s64)
    return 0_s64
  if signed_ge[S64](a: me.exp, b: 62_s64)
    return reinterpret_bits[U64, S64](shift_left[U64](value: 1_u64, bits: 63_u64))
  var wb = reinterpret_bits[U64, S64](W)
  var s = sub[S64](a: sub[S64](a: wb, b: 3_s64), b: me.exp)
  var r = reinterpret_bits[U64, S64](int_truncate[M, U64](shift_right_unsigned[M](me.mant, uf_amt[M](s))))
  if me.sign
    return sub[S64](a: 0_s64, b: r)
  return r

# ============================================================================
# ilogb, integer tests, toward0, ordered comparisons
# ============================================================================

### Returns floor(log2|me|) (TLFloat `ilogb`).
routine UnpackedFloat[M, L, W].ilogb() -> S64
  if me.exp != 0_s64
    return add[S64](a: me.exp, b: 1_s64)
  return sub[S64](a: 2_s64, b: int_truncate[M, S64](leading_zeros[M](me.mant)))

### Returns `true` when integer-valued.
routine UnpackedFloat[M, L, W].isint() -> Bool
  if me.isinf or me.isnan
    return false
  var t = me.trunc()
  return int_eq[M](a: t.mant, b: me.mant) and (t.exp == me.exp)

### Returns `true` when an even integer.
routine UnpackedFloat[M, L, W].iseven() -> Bool
  return me.ldexp(e: -1_s64).isint()

### Nudges the magnitude down by one ULP (toward zero) — TLFloat `toward0`.
routine UnpackedFloat[M, L, W].toward0() -> ?UnpackedFloat[M, L, W]
  if me.iszero or me.isinf or me.isnan
    return me
  var wb = reinterpret_bits[U64, S64](W)
  var m = sub[M](a: me.mant, b: uf_amt[M](1_s64))
  var exp = me.exp
  if not uf_bit[M](v: m, pos: sub[S64](a: wb, b: 2_s64))
    exp = sub[S64](a: exp, b: 1_s64)
    m = uf_sh[M](v: m, s: 1_s64)
  return UnpackedFloat[M, L, W].make(mant: m, exp: exp, sign: me.sign, iszero: false, isinf: false, isnan: false)

### Returns `true` when `me < you` (via `cmp`; does not special-case NaN).
routine UnpackedFloat[M, L, W].lt(you: UnpackedFloat[M, L, W]) -> Bool
  return signed_lt[S64](a: me.cmp(you: you), b: 0_s64)

### Returns `true` when `me > you` (via `cmp`; does not special-case NaN).
routine UnpackedFloat[M, L, W].gt(you: UnpackedFloat[M, L, W]) -> Bool
  return signed_gt[S64](a: me.cmp(you: you), b: 0_s64)

### Returns `true` when `me <= you` (via `cmp`; does not special-case NaN).
routine UnpackedFloat[M, L, W].le(you: UnpackedFloat[M, L, W]) -> Bool
  return not signed_gt[S64](a: me.cmp(you: you), b: 0_s64)

### Returns `true` when `me >= you` (via `cmp`; does not special-case NaN).
routine UnpackedFloat[M, L, W].ge(you: UnpackedFloat[M, L, W]) -> Bool
  return not signed_lt[S64](a: me.cmp(you: you), b: 0_s64)

### Returns `true` when `me == you`; NaN compares unequal to everything (incl. itself).
routine UnpackedFloat[M, L, W].eq(you: UnpackedFloat[M, L, W]) -> Bool
  if me.isnan or you.isnan
    return false
  return me.cmp(you: you) == 0_s64

# ============================================================================
# Powers of ten (TLFloat exp10i, by squaring)
# ============================================================================

### Returns `10^a` as an unpacked value.
common routine UnpackedFloat[M, L, W].exp10i(a: S64) -> ?UnpackedFloat[M, L, W]
  var neg = signed_lt[S64](a: a, b: 0_s64)
  var e = if neg then sub[S64](a: 0_s64, b: a) else a
  var r = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var d = UnpackedFloat[M, L, W].from_s64(src: 10_s64)
  while signed_gt[S64](a: e, b: 0_s64)
    if signed_rem[S64](a: e, b: 2_s64) == 1_s64
      r = (r * (d))
    d = (d * (d))
    e = shift_right_signed[S64](e, 1_s64)
  if neg
    return (UnpackedFloat[M, L, W].from_s64(src: 1_s64) / (r))
  return r

### Splits into a fraction in [0.5,1) and a power-of-two exponent (TLFloat `frexp_`):
### returns (fraction, exp) with me = fraction * 2^exp.
routine UnpackedFloat[M, L, W].frexp() -> UFExp[M, L, W]
  var fr = UnpackedFloat[M, L, W].make(mant: me.mant, exp: -2_s64, sign: me.sign, iszero: me.iszero, isinf: me.isinf, isnan: me.isnan)
  return UFExp[M, L, W](item0: fr, item1: add[S64](a: me.exp, b: 2_s64))

### Builds an `M`-typed value from two U64 halves (low, then high<<64).
routine uf_w2[M](h1: U64, h0: U64) -> ?M
  return bit_or[M](a: zero_extend[U64, M](h0), b: shift_left[M](value: zero_extend[U64, M](h1), bits: 64))

### Builds an `M`-typed value from four U64 halves (h3..h0, most significant first).
routine uf_w4[M](h3: U64, h2: U64, h1: U64, h0: U64) -> ?M
  return bit_or[M](a: uf_w2[M](h1: h1, h0: h0), b: shift_left[M](value: uf_w2[M](h1: h3, h0: h2), bits: 128))

### Builds an `M`-typed value from eight U64 halves (h7..h0, most significant first).
routine uf_w8[M](h7: U64, h6: U64, h5: U64, h4: U64, h3: U64, h2: U64, h1: U64, h0: U64) -> ?M
  return bit_or[M](a: uf_w4[M](h3: h3, h2: h2, h1: h1, h0: h0), b: shift_left[M](value: uf_w4[M](h3: h7, h2: h6, h1: h5, h0: h4), bits: 256))

### Bitwise complement of a `T`.
routine uf_not[T](v: T) -> ?T
  return bit_xor[T](a: v, b: sub[T](a: 0, b: 1))
