module Core

# CREDITS: UnpackedFloat[N, N2] is a port and extension of TLFloat's UnpackedFloat
# (© Naoki Shibata and contributors, Boost Software License 1.0). This generic engine
# backs the W=128 and W=192 engines (B128 + the D64/D128/Decimal transcendental bridges).
# See THIRD-PARTY-NOTICES.md.

# ============================================================================
# UnpackedFloat[N, N2] — generic extended-precision unpacked float, a faithful
# port of TLFloat's `UnpackedFloat<mant_t, longmant_t, 0, nbmant>` (nbexp = 0).
#
#   N  = mantissa limb count; the mantissa is an `Array[U64, N]`, W = 64*N bits wide, nbmant = W - 2.
#   N2 = 2*N, the limb count of the double-width intermediate (products, division numerators).
#
# No width-specific integer type is involved: every mantissa operation goes through the limb
# kernels in Limbs.rf, so a new width is a new (N, N2) pair and nothing else.
#
# Convention: ilogb = exp + 1; value = (-1)^sign * mant * 2^(exp - (W - 3)).
# Arithmetic is correctly rounded to nbmant bits (round-to-nearest-even). Packed
# <-> unpacked casts and coefficient tables live per concrete width.
# ============================================================================

### The generic extended-precision unpacked float.
record UnpackedFloat[U64 N, U64 N2] obeys Addable, Subtractable, Multiplicable, Divisible
  ### Normalized mantissa limbs (leading bit at W-2 when finite-nonzero).
  mant: Array[U64, N]
  ### Unbiased exponent offset (ilogb - 1).
  exp: S64
  ### Sign + zero/inf/nan state folded into ONE i32-backed field. Replaces the old
  ### `sign`/`iszero`/`isinf`/`isnan` boolean quartet — four `i1` struct fields hit an aarch64
  ### by-value calling-convention bug when they spill to the stack (a wide mantissa
  ### exhausts the argument registers and pushes the flags out, where caller/callee disagree on
  ### the stack layout). One integer field is laid out unambiguously on every target.
  ### Read it through the `sign()`/`iszero()`/`isinf()`/`isnan()` accessors below.
  fpclass: SignedFpClass

### No-op teardown: all fields are plain values (no owned entities).
@override
dangerous routine UnpackedFloat[N, N2].destroy()
  return

### The 9 decimal digits of a U64 in [0, 10⁹), zero-padded (interior base-10⁹ chunk of `wide_dec`).
### The `// 10` / `% 10` here are on a scalar U64 by a constant, so the backend lowers them to a
### reciprocal multiply (no hardware divide) — the "magic/Montgomery" step for the constant divisor.
routine wide_dec9(c: U64) -> Text
  var s = ""
  var x = c
  var i = 0_s64
  while LLVM::signed_lt(a: i, b: 9_s64)
    s = f"{LLVM::unsigned_rem(a: x, b: 10_u64)}" + s
    x = LLVM::unsigned_div(a: x, b: 10_u64)
    i = LLVM::add(a: i, b: 1_s64)
  return s

### The decimal digits of a nonzero U64 with no leading zeros (the most-significant base-10⁹ chunk).
routine wide_dec_head(c: U64) -> Text
  var s = ""
  var x = c
  while LLVM::int_ne(a: x, b: 0_u64)
    s = f"{LLVM::unsigned_rem(a: x, b: 10_u64)}" + s
    x = LLVM::unsigned_div(a: x, b: 10_u64)
  return s

### Decimal digit string of a wide unsigned integer (MSD first; "0" for zero). Peels base-10⁹
### chunks: one wide `// 10⁹` / `% 10⁹` per 9 digits (vs per-digit) through the type's knuth-based
### FloorDivisible, then formats each 9-digit chunk with scalar reciprocal-multiply `// 10`. The
### wide divisor 10⁹ fits one limb, so each peel is the fast single-limb divide. Backs the wide-int
### and Decimal `represent`s; table-free, any width.
routine wide_dec[T](v: T) -> Text
needs T obeys FloorDivisible
  if LLVM::int_eq(a: v, b: LLVM::zero_extend[U64, T](0_u64))
    return "0"
  var ten9 = LLVM::zero_extend[U64, T](1000000000_u64)
  var out = ""
  var x = v
  # divide first, then take the remainder as x - q*10⁹ (a wide mul+sub, not a second wide divide)
  var q = x // ten9
  var chunk = LLVM::int_truncate[T, U64](LLVM::sub(a: x, b: LLVM::mul(a: q, b: ten9)))
  x = q
  while LLVM::int_ne(a: x, b: LLVM::zero_extend[U64, T](0_u64))
    out = wide_dec9(c: chunk) + out
    q = x // ten9
    chunk = LLVM::int_truncate[T, U64](LLVM::sub(a: x, b: LLVM::mul(a: q, b: ten9)))
    x = q
  out = wide_dec_head(c: chunk) + out
  return out

### An unpacked value paired with an integer exponent/quadrant. Used instead of a
### `(UnpackedFloat, S64)` tuple because tuples of generic records hit a compiler
### `destroy` synthesis gap (the tuple type's teardown is never emitted).
record UFExp[U64 N, U64 N2]
  ### The reduced/fractional unpacked value.
  item0: UnpackedFloat[N, N2]
  ### The integer exponent or quadrant.
  item1: S64

### A pair of unpacked values (e.g. tan numerator & denominator). Replaces a
### `(UnpackedFloat, UnpackedFloat)` tuple for the same reason as `UFExp`.
record UFPair[U64 N, U64 N2]
  ### First component.
  item0: UnpackedFloat[N, N2]
  ### Second component.
  item1: UnpackedFloat[N, N2]

### A sign flag paired with an unpacked value (lgamma result). Replaces a
### `(Bool, UnpackedFloat)` tuple for the same reason as `UFExp`.
record UFSign[U64 N, U64 N2]
  ### The sign flag.
  item0: Bool
  ### The magnitude value.
  item1: UnpackedFloat[N, N2]

# ============================================================================
# Low-level width-generic integer helpers (on plain LLVM integer types; the engine itself
# works on limbs — these stay for the packed-format code in B128/D64/D128)
# ============================================================================

### Converts a non-negative S64 amount `s` into a value of int type `T` (for shift amounts
### derived from runtime S64 values, which are strictly typed). A `common` routine keyed on the
### TARGET type `T` (not a `[T]`-parametrized S64 member): a method-level type param drives the
### instantiation off the call, which the reachability pass prunes for the widest tier (the wide
### product type `L`, reached only through nested generic-member instantiations) — keying on the
### receiver type seeds every width, exactly like `low_mask`/`from_words`.
common routine T.to_width(s: S64) -> T
  return LLVM::zero_extend[U64, T](LLVM::reinterpret_bits[S64, U64](s))

### The mask `(1 << n) - 1` as a `T`.
common routine T.low_mask(n: S64) -> T
  return LLVM::sub[T](a: LLVM::shift_left[T](value: 1, bits: T.to_width(s: n)), b: 1)

### Boolean XOR (for sign combination).
routine Bool.xor(you: Bool) -> Bool
  return (me or you) and not (me and you)

### Mantissa width W in bits (64 per limb).
common routine UnpackedFloat[N, N2].width() -> S64
  return LLVM::mul(a: LLVM::reinterpret_bits[U64, S64](N), b: 64_s64)

### Counts leading zeros of a double-width limb value (over all 2W bits).
common routine UnpackedFloat[N, N2].clz_wide(v: Array[U64, N2]) -> S64
  return v.wide_clz()

### The single bit `2^pos` as a mantissa.
common routine UnpackedFloat[N, N2].mant_bit(pos: S64) -> Array[U64, N]
  return wide_bit_at[N](pos: pos)

# ============================================================================
# Constructors
# ============================================================================

### Builds an unpacked value from its mantissa, exponent, and classification. The class is the
### single source of sign/zero/inf/nan state (see `SignedFpClass`); pass a class directly (e.g.
### `POSITIVE_NORMAL`), or fold the legacy boolean quartet through `SignedFpClass.from_flags`.
common routine UnpackedFloat[N, N2].make(mant: Array[U64, N], exp: S64, fpclass: SignedFpClass) -> UnpackedFloat[N, N2]
  return UnpackedFloat[N, N2](mant: mant, exp: exp, fpclass: fpclass)

# The class predicates live as member routines on the (non-generic) `SignedFpClass` choice — see
# SignedFpClass.rf. They can't be methods on the generic `UnpackedFloat` record because
# instantiated-generic codegen can't lower an `is` pattern; the generic accessors below just
# forward `me.fpclass` to those member routines.

### True iff the value is negative (sign bit set). NaN is treated as unsigned (false).
routine UnpackedFloat[N, N2].sign() -> Bool
  return me.fpclass.is_negative()

### True iff the value is ±0.
routine UnpackedFloat[N, N2].iszero() -> Bool
  return me.fpclass.is_zero()

### True iff the value is ±infinity.
routine UnpackedFloat[N, N2].isinf() -> Bool
  return me.fpclass.is_inf()

### True iff the value is NaN (quiet or signaling).
routine UnpackedFloat[N, N2].isnan() -> Bool
  return me.fpclass.is_nan()

### Positive or negative zero.
common routine UnpackedFloat[N, N2].zero(sign: Bool) -> UnpackedFloat[N, N2]
  return UnpackedFloat[N, N2].make(mant: Array[U64, N](), exp: 0_s64, fpclass: SignedFpClass.from_flags(sign: sign, iszero: true, isinf: false, isnan: false))

### Positive or negative infinity.
common routine UnpackedFloat[N, N2].inf(sign: Bool) -> UnpackedFloat[N, N2]
  # mantissa = the leading bit at position W-2 (canonical normalized leading-bit slot).
  var lead = UnpackedFloat[N, N2].mant_bit(pos: LLVM::sub(a: UnpackedFloat[N, N2].width(), b: 2_s64))
  return UnpackedFloat[N, N2].make(mant: lead, exp: -1_s64, fpclass: SignedFpClass.from_flags(sign: sign, iszero: false, isinf: true, isnan: false))

### The canonical quiet NaN.
common routine UnpackedFloat[N, N2].nan() -> UnpackedFloat[N, N2]
  # mantissa = 0b11 at bit W-2 -> leading bit set plus the quiet bit just below it.
  var m = wide_from_u64[N](v: 3_u64).wide_shl(n: LLVM::sub(a: UnpackedFloat[N, N2].width(), b: 3_s64))
  return UnpackedFloat[N, N2].make(mant: m, exp: -1_s64, fpclass: SignedFpClass.from_flags(sign: false, iszero: false, isinf: false, isnan: true))

# ============================================================================
# Sign, scaling, comparison
# ============================================================================

### Arithmetic negation.
routine UnpackedFloat[N, N2].neg() -> UnpackedFloat[N, N2]
  return UnpackedFloat[N, N2].make(mant: me.mant, exp: me.exp, fpclass: SignedFpClass.from_flags(sign: not me.sign(), iszero: me.iszero(), isinf: me.isinf(), isnan: me.isnan()))

### Absolute value.
routine UnpackedFloat[N, N2].abs() -> UnpackedFloat[N, N2]
  return UnpackedFloat[N, N2].make(mant: me.mant, exp: me.exp, fpclass: SignedFpClass.from_flags(sign: false, iszero: me.iszero(), isinf: me.isinf(), isnan: me.isnan()))

### Multiplies by `2^e` by adjusting the exponent (TLFloat `ldexp_`).
routine UnpackedFloat[N, N2].ldexp(e: S64) -> UnpackedFloat[N, N2]
  if me.iszero()
    return me
  var y = LLVM::add(a: me.exp, b: e)
  if LLVM::signed_lt(a: y, b: -2147483648_s64)
    return UnpackedFloat[N, N2].zero(sign: me.sign())
  if LLVM::signed_gt(a: y, b: 2147483647_s64)
    return UnpackedFloat[N, N2].inf(sign: me.sign())
  return UnpackedFloat[N, N2].make(mant: me.mant, exp: y, fpclass: SignedFpClass.from_flags(sign: me.sign(), iszero: false, isinf: false, isnan: false))

### Three-way comparison (TLFloat `cmp`): -1 if me<you, 0 if equal, +1 if me>you.
### NaN is not handled here (callers guard).
routine UnpackedFloat[N, N2].cmp(you: UnpackedFloat[N, N2]) -> S64
  if me.iszero() and you.iszero()
    return 0_s64
  if you.iszero()
    return if me.sign() then -1_s64 else 1_s64
  if me.iszero()
    return if you.sign() then 1_s64 else -1_s64
  if not me.sign() and you.sign()
    return 1_s64
  if me.sign() and not you.sign()
    return -1_s64
  if LLVM::signed_gt(a: me.exp, b: you.exp)
    return if me.sign() then -1_s64 else 1_s64
  if LLVM::signed_lt(a: me.exp, b: you.exp)
    return if me.sign() then 1_s64 else -1_s64
  var mc = me.mant.wide_cmp(you: you.mant)
  if LLVM::signed_gt(a: mc, b: 0_s64)
    return if me.sign() then -1_s64 else 1_s64
  if LLVM::signed_lt(a: mc, b: 0_s64)
    return if me.sign() then 1_s64 else -1_s64
  return 0_s64

# ============================================================================
# Addition / subtraction (faithful port of TLFloat faddsub, nbexp=0)
# ============================================================================

### Core add/subtract: returns `me ± you` (subtract when `negate`).
routine UnpackedFloat[N, N2].faddsub(you: UnpackedFloat[N, N2], negate: Bool) -> UnpackedFloat[N, N2]
  var wb = UnpackedFloat[N, N2].width()
  var wm1 = LLVM::sub(a: wb, b: 1_s64)
  var wm2 = LLVM::sub(a: wb, b: 2_s64)
  var negwb = LLVM::sub(a: 0_s64, b: wb)
  var rsign = (you.sign()).xor(you: negate)
  var ed = LLVM::sub(a: me.exp, b: you.exp)
  if me.iszero() or me.isinf() or me.isnan() or you.iszero() or you.isinf() or you.isnan() or LLVM::signed_gt(a: ed, b: wb) or LLVM::signed_lt(a: ed, b: negwb)
    if me.iszero() and you.iszero()
      return UnpackedFloat[N, N2].make(mant: Array[U64, N](), exp: 0_s64, fpclass: SignedFpClass.from_flags(sign: me.sign() and rsign, iszero: true, isinf: false, isnan: false))
    if me.isnan() or you.iszero()
      return me
    if you.isnan() or me.iszero()
      return UnpackedFloat[N, N2].make(mant: you.mant, exp: you.exp, fpclass: SignedFpClass.from_flags(sign: rsign, iszero: you.iszero(), isinf: you.isinf(), isnan: you.isnan()))
    if me.isinf() or you.isinf()
      if me.isinf() and you.isinf() and (me.sign() == rsign)
        return me
      if me.isinf() and you.isinf() and (me.sign() != rsign)
        return UnpackedFloat[N, N2].nan()
      if me.isinf()
        return me
      return UnpackedFloat[N, N2].make(mant: you.mant, exp: you.exp, fpclass: SignedFpClass.from_flags(sign: rsign, iszero: you.iszero(), isinf: you.isinf(), isnan: you.isnan()))
    if LLVM::signed_gt(a: ed, b: wb)
      return me
    if LLVM::signed_lt(a: ed, b: negwb)
      return UnpackedFloat[N, N2].make(mant: you.mant, exp: you.exp, fpclass: SignedFpClass.from_flags(sign: rsign, iszero: you.iszero(), isinf: you.isinf(), isnan: you.isnan()))
  # Effective subtraction iff the signs differ. Work at the mantissa width (significand leading
  # at bit W-2), tracking only a guard + sticky below it, instead of the 2W-wide alignment the
  # reference uses. `hi` is the magnitude-larger operand (by exp, then mantissa); `d` the gap.
  var subtract = me.sign() != rsign
  var abig = LLVM::signed_gt(a: me.exp, b: you.exp) or (LLVM::int_eq(a: me.exp, b: you.exp) and me.mant.wide_ge(you: you.mant))
  var himant = if abig then me.mant else you.mant
  var lomant = if abig then you.mant else me.mant
  var d = if abig then ed else LLVM::sub(a: 0_s64, b: ed)
  var exp = if abig then me.exp else you.exp
  var rsign2 = if abig then me.sign() else rsign
  var am = himant
  if not subtract
    # ---- addition of magnitudes: hi + (lo >> d), round-half-even on (guard, sticky) ----
    var sm = lomant
    var g = false
    var s = false
    if LLVM::signed_ge(a: d, b: wb)
      sm = Array[U64, N]()
      s = not lomant.wide_is_zero()
    elseif LLVM::signed_ge(a: d, b: 1_s64)
      sm = lomant.wide_shl(n: LLVM::sub(a: 0_s64, b: d))
      g = lomant.wide_bit(pos: LLVM::sub(a: d, b: 1_s64))
      if LLVM::signed_ge(a: d, b: 2_s64)
        s = lomant.wide_low_nonzero(n: LLVM::sub(a: d, b: 1_s64))
    am = himant.wide_add(you: sm)
    if am.wide_bit(pos: wm1)
      var ns = s or g
      g = am.wide_bit(pos: 0_s64)
      am = am.wide_shl(n: -1_s64)
      exp = LLVM::add(a: exp, b: 1_s64)
      s = ns
    if g and (s or am.wide_bit(pos: 0_s64))
      am = am.wide_add_u64(v: 1_u64)
      if am.wide_bit(pos: wm1)
        am = am.wide_shl(n: -1_s64)
        exp = LLVM::add(a: exp, b: 1_s64)
  elseif LLVM::signed_le(a: d, b: 1_s64)
    # ---- subtraction, near path (d in {0,1}): exact with one extra low bit (scale both up by 1),
    # so the possibly-large cancellation renormalizes without losing precision ----
    var hh = himant.wide_shl(n: 1_s64)
    var ll = lomant.wide_shl(n: LLVM::sub(a: 1_s64, b: d))
    am = hh.wide_sub(you: ll)
    if am.wide_is_zero()
      rsign2 = false
      exp = 0_s64
    else
      var lz = am.wide_clz()
      am = am.wide_shl(n: lz)
      exp = LLVM::sub(a: exp, b: lz)
      var gbit = am.wide_bit(pos: 0_s64)
      am = am.wide_shl(n: -1_s64)
      if gbit and am.wide_bit(pos: 0_s64)
        am = am.wide_add_u64(v: 1_u64)
        if am.wide_bit(pos: wm1)
          am = am.wide_shl(n: -1_s64)
          exp = LLVM::add(a: exp, b: 1_s64)
  else
    # ---- subtraction, far path (d >= 2): at most a 1-bit cancellation. Track two guard bits
    # (g1 = lo bit d-1, g2 = lo bit d-2) + a sticky below, so the leading-drop case renormalizes
    # (M0 = 2*am - g1) and rounds at the correct position with g2; a final power-of-2 check fixes
    # a round-down that crosses a power of two. d >= W: lo is wholly below, frac < 1/2 -> hi. ----
    if LLVM::signed_ge(a: d, b: wb)
      am = himant
    else
      var sm = lomant.wide_shl(n: LLVM::sub(a: 0_s64, b: d))
      var g1 = lomant.wide_bit(pos: LLVM::sub(a: d, b: 1_s64))
      var g2 = lomant.wide_bit(pos: LLVM::sub(a: d, b: 2_s64))
      var s = false
      if LLVM::signed_ge(a: d, b: 3_s64)
        s = lomant.wide_low_nonzero(n: LLVM::sub(a: d, b: 2_s64))
      am = himant.wide_sub(you: sm)
      if am.wide_bit(pos: wm2)
        if g1
          if g2 or s
            am = am.wide_sub_u64(v: 1_u64)
          else
            am = am.wide_sub_u64(v: LLVM::bit_and(a: am.wide_low_u64(), b: 1_u64))
      else
        var g1v = if g1 then 1_u64 else 0_u64
        am = am.wide_shl(n: 1_s64).wide_sub_u64(v: g1v)
        exp = LLVM::sub(a: exp, b: 1_s64)
        if g2
          if s
            am = am.wide_sub_u64(v: 1_u64)
          else
            am = am.wide_sub_u64(v: LLVM::bit_and(a: am.wide_low_u64(), b: 1_u64))
      if not am.wide_bit(pos: wm2)
        am = am.wide_shl(n: 1_s64)
        exp = LLVM::sub(a: exp, b: 1_s64)
  var amzero = am.wide_is_zero()
  if amzero
    exp = 0_s64
  if LLVM::signed_lt(a: exp, b: -2147483648_s64)
    return UnpackedFloat[N, N2].zero(sign: rsign2)
  if LLVM::signed_gt(a: exp, b: 2147483647_s64)
    return UnpackedFloat[N, N2].inf(sign: rsign2)
  return UnpackedFloat[N, N2].make(mant: am, exp: exp, fpclass: SignedFpClass.from_flags(sign: rsign2, iszero: amzero, isinf: false, isnan: false))

### Returns `me - you`. Wired `-`; `.sub(you:)` callers resolve here by bare-name lookup.
routine UnpackedFloat[N, N2].sub(you: UnpackedFloat[N, N2]) -> UnpackedFloat[N, N2]
  return me.faddsub(you: you, negate: true)

# ============================================================================
# Multiplication (faithful port of TLFloat fmul, nbexp=0)
# ============================================================================

### Returns `me * you`. Wired `*`; `.mul(you:)` callers resolve here by bare-name lookup.
routine UnpackedFloat[N, N2].mul(you: UnpackedFloat[N, N2]) -> UnpackedFloat[N, N2]
  if me.isnan() or you.isnan() or (me.iszero() and you.isinf()) or (me.isinf() and you.iszero()) or me.isinf() or you.isinf()
    if me.isnan()
      return me
    if you.isnan()
      return you
    if (me.iszero() and you.isinf()) or (me.isinf() and you.iszero())
      return UnpackedFloat[N, N2].nan()
    return UnpackedFloat[N, N2].inf(sign: (me.sign()).xor(you: you.sign()))
  return me.mul_finite(you: you)

### Finite multiply: the normal-operand path of `mul` WITHOUT the six isnan/isinf guards. Newton/
### Horner loops over known-finite values (sqrt/cbrt) call this to skip per-step classification.
### me and you MUST both be finite normals/zeros -- a nan/inf operand yields garbage, not a nan.
routine UnpackedFloat[N, N2].mul_finite(you: UnpackedFloat[N, N2]) -> UnpackedFloat[N, N2]
  var wb = UnpackedFloat[N, N2].width()
  var carry = LLVM::sub(a: LLVM::mul(a: 2_s64, b: wb), b: 1_s64)
  var wm1 = LLVM::sub(a: wb, b: 1_s64)
  var am = wide_mul_to[N, N2](a: me.mant, b: you.mant)
  # Both mantissas are normalized (leading bit at W-2), so the 2W-bit product lands in
  # [2^(2W-4), 2^(2W-2)): its leading bit is at 2W-3 or 2W-4 — exactly two cases. A single bit test
  # replaces a leading-zero count + a runtime-amount normalization shift with a fixed 1- or 2-bit
  # shift that pins the leading bit at 2W-2.
  var exp = LLVM::add(a: me.exp, b: you.exp)
  if am.wide_bit(pos: LLVM::sub(a: carry, b: 2_s64))
    am = am.wide_shl(n: 1_s64)
    exp = LLVM::add(a: exp, b: 2_s64)
  else
    am = am.wide_shl(n: 2_s64)
    exp = LLVM::add(a: exp, b: 1_s64)
  var addend = wide_low_mask[N2](n: wm1)
  if am.wide_bit(pos: wb)
    addend = addend.wide_add_u64(v: 1_u64)
  am = am.wide_add(you: addend)
  if am.wide_bit(pos: carry)
    am = am.wide_shl(n: -1_s64)
    exp = LLVM::add(a: exp, b: 1_s64)
  am = am.wide_shl(n: LLVM::sub(a: 0_s64, b: wb))
  var amn = wide_resize[N2, N](a: am)
  var amz = amn.wide_is_zero()
  if amz
    exp = 0_s64
  if LLVM::signed_lt(a: exp, b: -2147483648_s64)
    return UnpackedFloat[N, N2].zero(sign: (me.sign()).xor(you: you.sign()))
  if LLVM::signed_gt(a: exp, b: 2147483647_s64)
    return UnpackedFloat[N, N2].inf(sign: (me.sign()).xor(you: you.sign()))
  return UnpackedFloat[N, N2].make(mant: amn, exp: exp, fpclass: SignedFpClass.from_flags(sign: (me.sign()).xor(you: you.sign()), iszero: amz, isinf: false, isnan: false))

# ============================================================================
# Division (correctly rounded to nbmant bits via the double-width numerator)
# ============================================================================

### Returns `me / you`.
routine UnpackedFloat[N, N2].div(you: UnpackedFloat[N, N2]) -> UnpackedFloat[N, N2]
  if me.isnan()
    return me
  if you.isnan()
    return you
  if you.iszero()
    if me.iszero()
      return UnpackedFloat[N, N2].nan()
    return UnpackedFloat[N, N2].inf(sign: (me.sign()).xor(you: you.sign()))
  if you.isinf()
    if me.isinf()
      return UnpackedFloat[N, N2].nan()
    return UnpackedFloat[N, N2].zero(sign: (me.sign()).xor(you: you.sign()))
  if me.isinf()
    return UnpackedFloat[N, N2].inf(sign: (me.sign()).xor(you: you.sign()))
  if me.iszero()
    return UnpackedFloat[N, N2].zero(sign: (me.sign()).xor(you: you.sign()))
  var wb = UnpackedFloat[N, N2].width()
  var nbm = LLVM::sub(a: wb, b: 2_s64)
  var wm1 = LLVM::sub(a: wb, b: 1_s64)
  var sign = (me.sign()).xor(you: you.sign())
  var num = wide_resize[N, N2](a: me.mant).wide_shl(n: wb)
  var den = wide_resize[N, N2](a: you.mant)
  # One Knuth-D divide gives both the quotient and the remainder (needed only as a sticky flag).
  var qr = num.wide_divmod(you: den)
  var quo = qr.quo
  var remnz = not qr.rem.wide_is_zero()
  # msbq = index of the quotient's top set bit; s = how many low bits to drop to nbmant.
  var msbq = LLVM::sub(a: LLVM::sub(a: LLVM::mul(a: 2_s64, b: wb), b: 1_s64), b: quo.wide_clz())
  var s = LLVM::sub(a: msbq, b: nbm)
  var q = wide_resize[N2, N](a: quo.wide_shl(n: LLVM::sub(a: 0_s64, b: s)))
  # lost = the dropped low s bits; half = the round bit (2^(s-1)) for half-even decisions.
  var lost = wide_resize[N2, N](a: quo.wide_keep_low(n: s))
  var half = wide_bit_at[N](pos: LLVM::sub(a: s, b: 1_s64))
  var rexp = LLVM::sub(a: LLVM::add(a: LLVM::sub(a: me.exp, b: you.exp), b: msbq), b: LLVM::add(a: wb, b: 1_s64))
  var roundup = false
  # > half -> round up; == half -> sticky (nonzero remainder) breaks the tie, else even.
  var lh = lost.wide_cmp(you: half)
  if LLVM::signed_gt(a: lh, b: 0_s64)
    roundup = true
  elseif LLVM::int_eq(a: lh, b: 0_s64)
    if remnz
      roundup = true
    else
      roundup = q.wide_bit(pos: 0_s64)
  if roundup
    q = q.wide_add_u64(v: 1_u64)
    # rounding may carry into bit W-1 -> renormalize down one and bump the exponent.
    if q.wide_bit(pos: wm1)
      q = q.wide_shl(n: -1_s64)
      rexp = LLVM::add(a: rexp, b: 1_s64)
  return UnpackedFloat[N, N2].make(mant: q, exp: rexp, fpclass: SignedFpClass.from_flags(sign: sign, iszero: false, isinf: false, isnan: false))

# ============================================================================
# Wired operators (back the + - * / surface from the obeyed Addable/Subtractable/
# Multiplicable/Divisible protocols). They forward to the named cores. NOTE: the
# operator result type only pins to the concrete instantiation when the receiver
# is concretely typed (e.g. UnpackedFloat[2, 4] in tests); inside the
# generic engine the named methods are used directly to keep Me bound.
# ============================================================================

### Wired `+` — returns `me + you`. Also the `.add(you:)` method (same bare name `add`); callers
### that write `x.add(y)` resolve here by bare-name lookup, and `x + y` lowers here.
routine UnpackedFloat[N, N2].add(you: UnpackedFloat[N, N2]) -> UnpackedFloat[N, N2]
  return me.faddsub(you: you, negate: false)

### Wired `/` — returns `me / you`.
routine UnpackedFloat[N, N2].truediv(you: UnpackedFloat[N, N2]) -> UnpackedFloat[N, N2]
  return me.div(you: you)

# ============================================================================
# Extra helpers for fma / sqrt
# ============================================================================

### Integer floor square root of a double-width limb value `v` — b64-seeded Newton using the Knuth
### divide, then an exact ±1 correction. It stays in raw limbs (no per-step UnpackedFloat
### pack/classify), so a handful of fast divides beat both the O(W²) restoring-bitwise isqrt and the
### reciprocal float `sqrt_newton` at the B128 width.
common routine UnpackedFloat[N, N2].isqrt_newton_wide(v: Array[U64, N2]) -> Array[U64, N2]
  if v.wide_is_zero()
    return v
  var one = wide_from_u64[N2](v: 1_u64)
  var twoW = LLVM::mul(a: 2_s64, b: UnpackedFloat[N, N2].width())
  # Seed x ~= sqrt(v) from hardware b64: take the top <=52 bits of v (even shift, so the b64 sqrt
  # scales back by an integer power of two), b64-sqrt, then shift the ~26-bit integer result up by sh/2.
  var bl = LLVM::sub(a: twoW, b: v.wide_clz())
  var sh = 0_s64
  if LLVM::signed_gt(a: bl, b: 52_s64)
    sh = LLVM::sub(a: bl, b: 52_s64)
    if LLVM::int_ne(a: LLVM::signed_rem(a: sh, b: 2_s64), b: 0_s64)
      sh = LLVM::sub(a: sh, b: 1_s64)
  var vtop = v.wide_shl(n: LLVM::sub(a: 0_s64, b: sh)).wide_low_u64()
  var seed = LLVM::float_to_unsigned[B64, U64](B64(from: vtop).sqrt_unchecked())
  var x = wide_from_u64[N2](v: seed).wide_shl(n: LLVM::signed_div(a: sh, b: 2_s64))
  if x.wide_is_zero()
    x = one
  # Newton x <- (x + v//x)/2. From a ~26-bit-accurate seed, 3 steps reach ~208 bits (>=W at every
  # width this path serves); the exact correction below pins floor(sqrt(v)) regardless.
  var j = 0_s64
  while LLVM::signed_lt(a: j, b: 3_s64)
    var q = v.wide_div(you: x)
    x = x.wide_add(you: q).wide_shl(n: -1_s64)
    j = LLVM::add(a: j, b: 1_s64)
  # x < 2^W here, so x*x < 2^2W fits the double width; pin the exact floor with a ±1 sweep.
  while x.wide_mul(you: x).wide_gt(you: v)
    x = x.wide_sub(you: one)
  var x1 = x.wide_add(you: one)
  while x1.wide_mul(you: x1).wide_le(you: v)
    x = x1
    x1 = x1.wide_add(you: one)
  return x

# ============================================================================
# Fused multiply-add (faithful port of TLFloat fma, nbexp=0, NGB=4) — me*b + c.
# ============================================================================

### Returns `me*b + c` with a single rounding to nbmant bits.
routine UnpackedFloat[N, N2].fma(b: UnpackedFloat[N, N2], c: UnpackedFloat[N, N2]) -> UnpackedFloat[N, N2]
  if me.isnan() or me.isinf() or b.isnan() or b.isinf() or c.isnan() or c.isinf()
    if me.isnan()
      return me
    if b.isnan()
      return b
    if c.isnan()
      return c
    if (me.iszero() and b.isinf()) or (me.isinf() and b.iszero())
      return UnpackedFloat[N, N2].nan()
    if not c.isinf()
      return UnpackedFloat[N, N2].inf(sign: (me.sign()).xor(you: b.sign()))
    if not (me.isinf() or b.isinf()) or ((me.sign()).xor(you: b.sign()) == c.sign())
      return UnpackedFloat[N, N2].inf(sign: c.sign())
    return UnpackedFloat[N, N2].nan()
  return me.fma_finite(b: b, c: c)

### Finite fma: the normal-operand path of `fma` WITHOUT the six isnan/isinf guards. Polynomial
### Horner loops over known-finite values call this to skip per-step classification. me, b and c
### MUST all be finite normals/zeros -- a nan/inf operand yields garbage, not a propagated nan.
routine UnpackedFloat[N, N2].fma_finite(b: UnpackedFloat[N, N2], c: UnpackedFloat[N, N2]) -> UnpackedFloat[N, N2]
  var wb = UnpackedFloat[N, N2].width()
  var twoW = LLVM::mul(a: 2_s64, b: wb)
  var carry = LLVM::sub(a: twoW, b: 1_s64)
  var wm1 = LLVM::sub(a: wb, b: 1_s64)
  var pexp = LLVM::add(a: me.exp, b: b.exp)
  var am = wide_mul_to[N, N2](a: me.mant, b: b.mant)
  # Product of two normalized mantissas -> leading bit at 2W-3 or 2W-4; a bit test + fixed shift
  # replaces a leading-zero count + a variable shift here (same trick as `mul_finite`), pinning the
  # leading bit at 2W-2. The subtract-path clz below stays: cancellation there can drop the leading
  # bit anywhere.
  if am.wide_bit(pos: LLVM::sub(a: carry, b: 2_s64))
    am = am.wide_shl(n: 1_s64)
    pexp = LLVM::add(a: pexp, b: 2_s64)
  else
    am = am.wide_shl(n: 2_s64)
    pexp = LLVM::add(a: pexp, b: 1_s64)
  var amzero = am.wide_is_zero()
  if amzero
    pexp = 0_s64
  var ed = LLVM::sub(a: pexp, b: c.exp)
  if amzero and c.iszero()
    ed = 0_s64
  elseif amzero
    ed = LLVM::sub(a: 0_s64, b: twoW)
  elseif c.iszero()
    ed = twoW
  var subtract = ((me.sign()).xor(you: b.sign())).xor(you: c.sign())
  var resultsign = (me.sign()).xor(you: b.sign())
  var amsb = false
  var zmsb = false
  var zm = wide_resize[N, N2](a: c.mant).wide_shl(n: wb)
  if LLVM::signed_lt(a: ed, b: 0_s64)
    if LLVM::signed_le(a: ed, b: LLVM::sub(a: 4_s64, b: twoW))
      amsb = not am.wide_is_zero()
      am = Array[U64, N2]()
    else
      amsb = am.wide_low_nonzero(n: LLVM::sub[S64](a: 4_s64, b: ed))
      am = am.wide_shl(n: ed).wide_clear_low(n: 4_s64)
  else
    if LLVM::signed_ge(a: ed, b: LLVM::sub(a: twoW, b: 4_s64))
      zmsb = not zm.wide_is_zero()
      zm = Array[U64, N2]()
    else
      zmsb = zm.wide_low_nonzero(n: LLVM::add[S64](a: 4_s64, b: ed))
      zm = zm.wide_shl(n: LLVM::sub(a: 0_s64, b: ed)).wide_clear_low(n: 4_s64)
  var exp = if LLVM::signed_gt(a: ed, b: 0_s64) then pexp else c.exp
  if not subtract
    am = am.wide_add(you: zm)
    if am.wide_bit(pos: carry)
      am = am.wide_shl(n: -1_s64)
      exp = LLVM::add(a: exp, b: 1_s64)
    var up = amsb or zmsb or am.wide_bit(pos: wb)
    var upv = if up then 1_u64 else 0_u64
    am = am.wide_add(you: wide_low_mask[N2](n: wm1).wide_add_u64(v: upv))
  else
    var amge = am.wide_ge(you: zm)
    var psb = if amge then amsb else zmsb
    var nsb = if amge then zmsb else amsb
    resultsign = if amge then resultsign else c.sign()
    if amge
      am = am.wide_sub(you: zm)
    else
      am = zm.wide_sub(you: am)
    if am.wide_is_zero() and not psb
      resultsign = false
    var x2 = LLVM::sub(a: am.wide_clz(), b: 1_s64)
    am = am.wide_shl(n: x2)
    exp = LLVM::sub(a: exp, b: x2)
    var up = (not nsb) and (psb or am.wide_bit(pos: wb))
    var upv = if up then 1_u64 else 0_u64
    am = am.wide_add(you: wide_low_mask[N2](n: wm1).wide_add_u64(v: upv))
  if am.wide_bit(pos: carry)
    am = am.wide_shl(n: -1_s64)
    exp = LLVM::add(a: exp, b: 1_s64)
  am = am.wide_shl(n: LLVM::sub(a: 0_s64, b: wb))
  var amn = wide_resize[N2, N](a: am)
  var amz2 = amn.wide_is_zero()
  if amz2
    exp = 0_s64
  if LLVM::signed_lt(a: exp, b: -2147483648_s64)
    return UnpackedFloat[N, N2].zero(sign: resultsign)
  if LLVM::signed_gt(a: exp, b: 2147483647_s64)
    return UnpackedFloat[N, N2].inf(sign: resultsign)
  return UnpackedFloat[N, N2].make(mant: amn, exp: exp, fpclass: SignedFpClass.from_flags(sign: resultsign, iszero: amz2, isinf: false, isnan: false))

# ============================================================================
# Square root (faithful port of TLFloat sqrt_)
# ============================================================================

### Newton iteration count for `sqrt_newton`, hand-tuned per engine width. The b64 seed gives ~52
### correct bits and each Newton step doubles them, so the `floor(log2 W)-4` fallback reaches the
### ~2W-bit target; the explicit per-width entries let a tier be dialed in empirically (raise for
### accuracy, lower for speed) without touching the formula. N is a buildtime constant, so this
### whole ladder folds to a single value per engine instantiation.
secret common routine UnpackedFloat[N, N2].sqrt_newton_iters() -> S64
  if LLVM::int_eq[U64](a: N, b: 4_u64)
    return 4_s64
  if LLVM::int_eq[U64](a: N, b: 8_u64)
    return 5_s64
  var wu = LLVM::reinterpret_bits[S64, U64](UnpackedFloat[N, N2].width())
  var f = LLVM::sub(a: LLVM::sub(a: 63_s64, b: LLVM::reinterpret_bits[U64, S64](LLVM::leading_zeros[U64](wu))), b: 4_s64)
  if LLVM::signed_lt(a: f, b: 2_s64)
    return 2_s64
  return f

### Returns the correctly-rounded square root.
### Faithful reciprocal-sqrt via Newton (multiply-only) — the wide-engine path (W>=256; W=128 uses the
### integer-domain `isqrt_newton_wide` in `sqrt()`, which is faster at that width). Multiply-only
### Newton avoids the wide divide that gets costly as W grows; converges quadratically. me must be > 0,
### finite, normal. Normalize me = v * 2^(2k) with v in [1,4); seed 1/sqrt(v) from a HARDWARE b64
### rsqrt (~52 correct bits, not the old ~2-bit constant), iterate y <- y*(3 - v*y^2)/2; return
### (v*y) * 2^k. Iteration count comes from `sqrt_newton_iters()` (per-width tunable).
routine UnpackedFloat[N, N2].sqrt_newton() -> UnpackedFloat[N, N2]
  var wb = UnpackedFloat[N, N2].width()
  var e1 = LLVM::add(a: me.exp, b: 1_s64)
  var twok = LLVM::bit_and(a: e1, b: -2_s64)
  var k = LLVM::signed_div(a: twok, b: 2_s64)
  var v = me.ldexp(e: LLVM::sub(a: 0_s64, b: twok))
  # Seed y ~= 1/sqrt(v) from hardware b64. v in [1,4): take its top 53 mantissa bits (leading at W-2,
  # so shift down by W-54) as an exact-in-b64 integer scaled by 2^(v.exp-51), rsqrt in b64, then read
  # the ~52-bit b64 result back as an unpacked value (y*2^53 is an integer < 2^54 -> from_u64, /2^53).
  var topbits = v.mant.wide_shl(n: LLVM::sub(a: 54_s64, b: wb)).wide_low_u64()
  var vf = B64(from: topbits).scalbn(n: LLVM::sub(a: v.exp, b: 51_s64))
  var yf = B64(from: 1_u64).truediv_unchecked(you: vf.sqrt_unchecked())
  var yint = LLVM::float_to_unsigned[B64, U64](yf.scalbn(n: 53_s64))
  var y = UnpackedFloat[N, N2].from_u64(v: yint).ldexp(e: -53_s64)
  var three = UnpackedFloat[N, N2].from_s64(src: 3_s64)
  var iters = UnpackedFloat[N, N2].sqrt_newton_iters()
  var j = 0_s64
  while LLVM::signed_lt(a: j, b: iters)
    var t = v.mul_finite(you: y).mul_finite(you: y)
    y = y.mul_finite(you: three.sub(you: t)).ldexp(e: -1_s64)
    j = LLVM::add(a: j, b: 1_s64)
  return v.mul_finite(you: y).ldexp(e: k)

### Returns the correctly-rounded square root (NaN-of-negative, ±0 and +inf pass through).
### W>=256 routes to the quadratic Newton path; narrower W uses the integer `isqrt_newton_wide`.
routine UnpackedFloat[N, N2].sqrt() -> UnpackedFloat[N, N2]
  if me.isnan()
    return me
  if me.iszero()
    return me
  # sqrt of a negative value (including -inf) has no real result -> NaN.
  if me.sign()
    return UnpackedFloat[N, N2].nan()
  if me.isinf()
    return me
  # Crossover is between W=128 and W=256: at W=128 the INTEGER-domain isqrt (`isqrt_newton_wide`:
  # b64-seeded Newton on limbs, exact) beats the reciprocal float Newton (`sqrt_newton`: fixed b64-seed
  # setup + wide muls, each packing/classifying an UnpackedFloat), because the integer path stays in
  # raw limbs with a few fast Knuth divides and no per-step float ceremony. W>=256 routes to
  # `sqrt_newton`, where the divide cost grows and the multiply-only reciprocal path wins.
  var wb = UnpackedFloat[N, N2].width()
  if LLVM::signed_ge(a: wb, b: 256_s64)
    return me.sqrt_newton()
  var offset = 100000000_s64
  var y = LLVM::sub(a: me.mant.wide_clz(), b: 1_s64)
  var x = LLVM::sub(a: me.exp, b: y)
  var tpar = LLVM::signed_rem(a: LLVM::add(a: x, b: offset), b: 2_s64)
  var par = LLVM::sub(a: 1_s64, b: tpar)
  var s0 = LLVM::add(a: LLVM::add(a: wb, b: par), b: y)
  var l = UnpackedFloat[N, N2].isqrt_newton_wide(v: wide_resize[N, N2](a: me.mant).wide_shl(n: s0))
  var s1 = LLVM::sub(a: LLVM::add(a: wb, b: 1_s64), b: l.wide_clz())
  var addl = wide_low_mask[N2](n: LLVM::sub(a: s1, b: 1_s64))
  if l.wide_bit(pos: s1)
    addl = addl.wide_add_u64(v: 1_u64)
  l = l.wide_add(you: addl)
  if not l.wide_bit(pos: LLVM::sub(a: LLVM::mul(a: 2_s64, b: wb), b: 1_s64))
    l = l.wide_sub_u64(v: 1_u64)
  var m = wide_resize[N2, N](a: l.wide_shl(n: LLVM::sub(a: 0_s64, b: s1)))
  if m.wide_bit(pos: LLVM::sub(a: wb, b: 1_s64))
    m = m.wide_shl(n: -1_s64)
    x = LLVM::add(a: x, b: 1_s64)
  var rexp = LLVM::sub(a: LLVM::signed_div(a: LLVM::add(a: LLVM::add(a: x, b: LLVM::mul(a: offset, b: 2_s64)), b: 1_s64), b: 2_s64), b: LLVM::add(a: offset, b: 1_s64))
  return UnpackedFloat[N, N2].make(mant: m, exp: rexp, fpclass: SignedFpClass.from_flags(sign: false, iszero: m.wide_is_zero(), isinf: false, isnan: false))

# ============================================================================
# Rounding to integer
# ============================================================================

### Truncates toward zero to an integer.
routine UnpackedFloat[N, N2].trunc() -> UnpackedFloat[N, N2]
  if me.iszero() or me.isinf() or me.isnan()
    return me
  var wb = UnpackedFloat[N, N2].width()
  if LLVM::signed_ge(a: me.exp, b: LLVM::sub(a: wb, b: 2_s64))
    return me
  if LLVM::signed_lt(a: me.exp, b: -1_s64)
    return UnpackedFloat[N, N2].zero(sign: me.sign())
  var s = LLVM::sub(a: LLVM::sub(a: wb, b: 3_s64), b: me.exp)
  return UnpackedFloat[N, N2].make(mant: me.mant.wide_clear_low(n: s), exp: me.exp, fpclass: SignedFpClass.from_flags(sign: me.sign(), iszero: false, isinf: false, isnan: false))

### Rounds to nearest integer, ties away from zero (TLFloat `round`).
routine UnpackedFloat[N, N2].round() -> UnpackedFloat[N, N2]
  if me.iszero() or me.isinf() or me.isnan()
    return me
  var wb = UnpackedFloat[N, N2].width()
  if LLVM::signed_ge(a: me.exp, b: LLVM::sub(a: wb, b: 3_s64))
    return me
  if LLVM::signed_lt(a: me.exp, b: -2_s64)
    return UnpackedFloat[N, N2].zero(sign: me.sign())
  var s = LLVM::sub(a: LLVM::sub(a: wb, b: 3_s64), b: me.exp)
  var m = me.mant.wide_add(you: UnpackedFloat[N, N2].mant_bit(pos: LLVM::sub[S64](a: s, b: 1_s64)))
  m = m.wide_clear_low(n: s)
  var exp = me.exp
  if m.wide_bit(pos: LLVM::sub(a: wb, b: 1_s64))
    m = m.wide_shl(n: -1_s64)
    exp = LLVM::add(a: exp, b: 1_s64)
  if m.wide_is_zero()
    return UnpackedFloat[N, N2].zero(sign: me.sign())
  return UnpackedFloat[N, N2].make(mant: m, exp: exp, fpclass: SignedFpClass.from_flags(sign: me.sign(), iszero: false, isinf: false, isnan: false))

### Rounds to nearest integer, ties to even (TLFloat `rint`).
routine UnpackedFloat[N, N2].rint() -> UnpackedFloat[N, N2]
  if me.iszero() or me.isinf() or me.isnan()
    return me
  var wb = UnpackedFloat[N, N2].width()
  if LLVM::signed_ge(a: me.exp, b: LLVM::sub(a: wb, b: 3_s64))
    return me
  if LLVM::signed_lt(a: me.exp, b: -2_s64)
    return UnpackedFloat[N, N2].zero(sign: me.sign())
  var s = LLVM::sub(a: LLVM::sub(a: wb, b: 3_s64), b: me.exp)
  var lsb = if me.mant.wide_bit(pos: s) then 1_u64 else 0_u64
  var m = me.mant.wide_add_u64(v: lsb).wide_add(you: wide_low_mask[N](n: LLVM::sub[S64](a: s, b: 1_s64)))
  m = m.wide_clear_low(n: s)
  var exp = me.exp
  if m.wide_bit(pos: LLVM::sub(a: wb, b: 1_s64))
    m = m.wide_shl(n: -1_s64)
    exp = LLVM::add(a: exp, b: 1_s64)
  if m.wide_is_zero()
    return UnpackedFloat[N, N2].zero(sign: me.sign())
  return UnpackedFloat[N, N2].make(mant: m, exp: exp, fpclass: SignedFpClass.from_flags(sign: me.sign(), iszero: false, isinf: false, isnan: false))

# ============================================================================
# Integer <-> unpacked conversion
# ============================================================================

### Builds an unpacked value from a non-negative 64-bit integer.
common routine UnpackedFloat[N, N2].from_u64(v: U64) -> UnpackedFloat[N, N2]
  if v == 0_u64
    return UnpackedFloat[N, N2].zero(sign: false)
  var wb = UnpackedFloat[N, N2].width()
  var x = LLVM::sub(a: 64_s64, b: LLVM::reinterpret_bits[U64, S64](LLVM::leading_zeros(v)))
  var s = LLVM::sub(a: LLVM::sub(a: LLVM::mul(a: 2_s64, b: wb), b: 1_s64), b: x)
  var u = wide_from_u64[N2](v: v).wide_shl(n: s)
  var rb = wide_low_mask[N2](n: LLVM::sub(a: wb, b: 1_s64))
  if u.wide_bit(pos: wb)
    rb = rb.wide_add_u64(v: 1_u64)
  u = u.wide_add(you: rb)
  if u.wide_bit(pos: LLVM::sub(a: LLVM::mul(a: 2_s64, b: wb), b: 1_s64))
    u = u.wide_shl(n: -1_s64)
    x = LLVM::add(a: x, b: 1_s64)
  u = u.wide_shl(n: LLVM::sub(a: 0_s64, b: wb))
  var m = wide_resize[N2, N](a: u)
  return UnpackedFloat[N, N2].make(mant: m, exp: LLVM::sub[S64](a: x, b: 2_s64), fpclass: SignedFpClass.from_flags(sign: false, iszero: m.wide_is_zero(), isinf: false, isnan: false))

### Builds an unpacked value from a signed 64-bit integer.
common routine UnpackedFloat[N, N2].from_s64(src: S64) -> UnpackedFloat[N, N2]
  if src == 0_s64
    return UnpackedFloat[N, N2].zero(sign: false)
  var sign = LLVM::signed_lt(a: src, b: 0_s64)
  var v = if sign then LLVM::sub(a: 0_s64, b: src) else src
  var r = UnpackedFloat[N, N2].from_u64(v: LLVM::reinterpret_bits[S64, U64](v))
  return UnpackedFloat[N, N2].make(mant: r.mant, exp: r.exp, fpclass: SignedFpClass.from_flags(sign: sign, iszero: r.iszero(), isinf: false, isnan: false))

### Truncates toward zero into a signed 64-bit integer (castToInt).
routine UnpackedFloat[N, N2].to_s64() -> S64
  if LLVM::signed_lt(a: me.exp, b: -1_s64)
    return 0_s64
  if LLVM::signed_ge(a: me.exp, b: 62_s64)
    return LLVM::reinterpret_bits[U64, S64](LLVM::shift_left(value: 1_u64, bits: 63_u64))
  var wb = UnpackedFloat[N, N2].width()
  var s = LLVM::sub(a: LLVM::sub(a: wb, b: 3_s64), b: me.exp)
  var r = LLVM::reinterpret_bits[U64, S64](me.mant.wide_shl(n: LLVM::sub(a: 0_s64, b: s)).wide_low_u64())
  if me.sign()
    return LLVM::sub(a: 0_s64, b: r)
  return r

# ============================================================================
# ilogb, integer tests, toward0, ordered comparisons
# ============================================================================

### Returns floor(log2|me|) (TLFloat `ilogb`).
routine UnpackedFloat[N, N2].ilogb() -> S64
  if me.exp != 0_s64
    return LLVM::add(a: me.exp, b: 1_s64)
  return LLVM::sub(a: 2_s64, b: me.mant.wide_clz())

### Returns `true` when integer-valued.
routine UnpackedFloat[N, N2].isint() -> Bool
  if me.isinf() or me.isnan()
    return false
  var t = me.trunc()
  return t.mant.wide_eq(you: me.mant) and (t.exp == me.exp)

### Returns `true` when an even integer.
routine UnpackedFloat[N, N2].iseven() -> Bool
  return me.ldexp(e: -1_s64).isint()

### Nudges the magnitude down by one ULP (toward zero) — TLFloat `toward0`.
routine UnpackedFloat[N, N2].toward0() -> UnpackedFloat[N, N2]
  if me.iszero() or me.isinf() or me.isnan()
    return me
  var wb = UnpackedFloat[N, N2].width()
  var m = me.mant.wide_sub_u64(v: 1_u64)
  var exp = me.exp
  if not m.wide_bit(pos: LLVM::sub(a: wb, b: 2_s64))
    exp = LLVM::sub(a: exp, b: 1_s64)
    m = m.wide_shl(n: 1_s64)
  return UnpackedFloat[N, N2].make(mant: m, exp: exp, fpclass: SignedFpClass.from_flags(sign: me.sign(), iszero: false, isinf: false, isnan: false))

### Returns `true` when `me < you` (via `cmp`; does not special-case NaN).
### `@override`: UnpackedFloat's `cmp` returns a raw signed width (compared to 0 by `LLVM::signed_lt`),
### not a `ComparisonSign`, so these replace the auto-derived `me.cmp(you) == ME_SMALL` helpers.
@override
routine UnpackedFloat[N, N2].lt(you: UnpackedFloat[N, N2]) -> Bool
  return LLVM::signed_lt(a: me.cmp(you: you), b: 0_s64)

### Returns `true` when `me > you` (via `cmp`; does not special-case NaN).
@override
routine UnpackedFloat[N, N2].gt(you: UnpackedFloat[N, N2]) -> Bool
  return LLVM::signed_gt(a: me.cmp(you: you), b: 0_s64)

### Returns `true` when `me <= you` (via `cmp`; does not special-case NaN).
@override
routine UnpackedFloat[N, N2].le(you: UnpackedFloat[N, N2]) -> Bool
  return not LLVM::signed_gt(a: me.cmp(you: you), b: 0_s64)

### Returns `true` when `me >= you` (via `cmp`; does not special-case NaN).
@override
routine UnpackedFloat[N, N2].ge(you: UnpackedFloat[N, N2]) -> Bool
  return not LLVM::signed_lt(a: me.cmp(you: you), b: 0_s64)

### Returns `true` when `me == you`; NaN compares unequal to everything (incl. itself).
routine UnpackedFloat[N, N2].eq(you: UnpackedFloat[N, N2]) -> Bool
  if me.isnan() or you.isnan()
    return false
  return me.cmp(you: you) == 0_s64

# ============================================================================
# Powers of ten (TLFloat exp10i, by squaring)
# ============================================================================

### Returns `10^a` as an unpacked value.
common routine UnpackedFloat[N, N2].exp10i(a: S64) -> UnpackedFloat[N, N2]
  var neg = LLVM::signed_lt(a: a, b: 0_s64)
  var e = if neg then LLVM::sub(a: 0_s64, b: a) else a
  var r = UnpackedFloat[N, N2].from_s64(src: 1_s64)
  var d = UnpackedFloat[N, N2].from_s64(src: 10_s64)
  while LLVM::signed_gt(a: e, b: 0_s64)
    if LLVM::signed_rem(a: e, b: 2_s64) == 1_s64
      r = r.mul(you: d)
    d = d.mul(you: d)
    e = LLVM::shift_right_signed(e, 1_s64)
  if neg
    return UnpackedFloat[N, N2].from_s64(src: 1_s64).div(you: r)
  return r

### Splits into a fraction in [0.5,1) and a power-of-two exponent (TLFloat `frexp_`):
### returns (fraction, exp) with me = fraction * 2^exp.
routine UnpackedFloat[N, N2].frexp() -> UFExp[N, N2]
  var fr = UnpackedFloat[N, N2].make(mant: me.mant, exp: -2_s64, fpclass: SignedFpClass.from_flags(sign: me.sign(), iszero: me.iszero(), isinf: me.isinf(), isnan: me.isnan()))
  return UFExp[N, N2](item0: fr, item1: LLVM::add(a: me.exp, b: 2_s64))

# ============================================================================
# Mantissa literals — build an `Array[U64, N]` mantissa from U64 words (most significant first)
# or from a single 128-bit literal. Words beyond N limbs are dropped.
# ============================================================================

### A mantissa from two words (h1 * 2^64 + h0).
common routine UnpackedFloat[N, N2].words2(h1: U64, h0: U64) -> Array[U64, N]
  return wide_words2[N](h1: h1, h0: h0)

### A mantissa from three words (h2 * 2^128 + h1 * 2^64 + h0).
common routine UnpackedFloat[N, N2].words3(h2: U64, h1: U64, h0: U64) -> Array[U64, N]
  return wide_words3[N](h2: h2, h1: h1, h0: h0)

### A mantissa from a single 128-bit literal.
common routine UnpackedFloat[N, N2].from_u128_mant(v: U128) -> Array[U64, N]
  return wide_from_u128[N](v: v)
