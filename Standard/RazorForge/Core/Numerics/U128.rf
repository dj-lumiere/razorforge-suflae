module Core

### A 128-bit unsigned integer in the range 0 to
### 340,282,366,920,938,463,463,374,607,431,768,211,455.
###
### `U128` is used for cryptographic keys, UUIDs, very large counters, and
### other data that requires more than 64 bits. Note that `U128` does not
### implement `AtomicType` because hardware atomic operations on 128-bit
### values are not universally available.
@llvm("i128")
record U128 obeys UnsignedIntegral, Ordered, ConstCompatible, Assignable, Copyable, Splittable
  pass

# Constants for U128 limits
preset U128_MIN: U128 = 0_u128
preset U128_MAX: U128 = 340282366920938463463374607431768211455_u128
preset U128_ZERO: U128 = 0_u128
preset U128_ONE: U128 = 1_u128

# ============================================================================
# Creators
# ============================================================================

### Converts an `S8` to `U128`, throwing if the value is negative.
### :param from: The `S8` value to convert.
### :returns: A `U128` with the same unsigned value as `from`.
### :throws: {IntegerOverflowError} if `from < 0`.
routine U128!(from: S8) -> U128
  if from < 0_s8
    throw IntegerOverflowError()
  return LLVM::sign_extend[S8, U128](from)

### Converts an `S16` to `U128`, throwing if the value is negative.
### :param from: The `S16` value to convert.
### :returns: A `U128` with the same unsigned value as `from`.
### :throws: {IntegerOverflowError} if `from < 0`.
routine U128!(from: S16) -> U128
  if from < 0_s16
    throw IntegerOverflowError()
  return LLVM::sign_extend[S16, U128](from)

### Converts an `S32` to `U128`, throwing if the value is negative.
### :param from: The `S32` value to convert.
### :returns: A `U128` with the same unsigned value as `from`.
### :throws: {IntegerOverflowError} if `from < 0`.
routine U128!(from: S32) -> U128
  if from < 0_s32
    throw IntegerOverflowError()
  return LLVM::sign_extend[S32, U128](from)

### Converts an `S64` to `U128`, throwing if the value is negative.
### :param from: The `S64` value to convert.
### :returns: A `U128` with the same unsigned value as `from`.
### :throws: {IntegerOverflowError} if `from < 0`.
routine U128!(from: S64) -> U128
  if from < 0_s64
    throw IntegerOverflowError()
  return LLVM::sign_extend[S64, U128](from)

### Converts an `S128` to `U128`, throwing if the value is negative.
### :param from: The `S128` value to convert.
### :returns: The same bit pattern reinterpreted as an unsigned value.
### :throws: {IntegerOverflowError} if `from < 0`.
routine U128!(from: S128) -> U128
  if from < 0_s128
    throw IntegerOverflowError()
  return LLVM::reinterpret_bits[S128, U128](from)

### Zero-extends a `U8` to `U128`.
### :param from: The `U8` value to widen.
### :returns: A `U128` equal in value to `from`.
routine U128(from: U8) -> U128
  return LLVM::zero_extend[U8, U128](from)

### Zero-extends a `U16` to `U128`.
### :param from: The `U16` value to widen.
### :returns: A `U128` equal in value to `from`.
routine U128(from: U16) -> U128
  return LLVM::zero_extend[U16, U128](from)

### Zero-extends a `U32` to `U128`.
### :param from: The `U32` value to widen.
### :returns: A `U128` equal in value to `from`.
routine U128(from: U32) -> U128
  return LLVM::zero_extend[U32, U128](from)

### Zero-extends a `U64` to `U128`.
### :param from: The `U64` value to widen.
### :returns: A `U128` equal in value to `from`.
routine U128(from: U64) -> U128
  return LLVM::zero_extend[U64, U128](from)

### Identity conversion — returns `from` unchanged.
### :param from: The `U128` value to return.
### :returns: `from` unchanged.
routine U128(from: U128) -> U128
  return from

### Converts an `S256` to `U128`, throwing if the value is negative or exceeds U128_MAX.
### :param from: The `S256` value to convert.
### :returns: The lower 128 bits of `from`.
### :throws: {IntegerOverflowError} if `from` is outside 0..340282366920938463463374607431768211455.
routine U128!(from: S256) -> U128
  if not (0_s256 <= from <= 340282366920938463463374607431768211455_s256)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S256, U128](from)

### Converts a `U256` to `U128`, throwing if the value exceeds U128_MAX.
### :param from: The `U256` value to convert.
### :returns: The lower 128 bits of `from`.
### :throws: {IntegerOverflowError} if `from > 340282366920938463463374607431768211455`.
routine U128!(from: U256) -> U128
  if from > 340282366920938463463374607431768211455_u256
    throw IntegerOverflowError()
  return LLVM::int_truncate[U256, U128](from)

### Converts an `B16` to `U128`, truncating toward zero.
### :param from: The `B16` value to convert.
### :returns: The integer part of `from` as a `U128`.
### :throws: {IntegerOverflowError} if `from` is NaN, infinite, or negative.
routine U128!(from: B16) -> U128
  return from.B32().U128!()

### Converts an `B32` to `U128`, truncating toward zero.
### :param from: The `B32` value to convert.
### :returns: The integer part of `from` as a `U128`.
### :throws: {IntegerOverflowError} if `from` is NaN, infinite, or negative.
routine U128!(from: B32) -> U128
  if not from.is_finite() or from < 0.0_b32
    throw IntegerOverflowError()
  return LLVM::float_to_unsigned[B32, U128](from)

### Converts an `B64` to `U128`, truncating toward zero.
### :param from: The `B64` value to convert.
### :returns: The integer part of `from` as a `U128`.
### :throws: {IntegerOverflowError} if `from` is NaN, infinite, negative, or >= 2^128.
routine U128!(from: B64) -> U128
  if from.is_nan() or from < 0.0_b64 or from >= 340282366920938463463374607431768211456.0_b64
    throw IntegerOverflowError()
  return LLVM::float_to_unsigned[B64, U128](from)

### Converts an `B128` to `U128`, truncating toward zero.
### :param from: The `B128` value to convert.
### :returns: The integer part of `from` as a `U128`.
### :throws: {NumericOverflowError} if negative or >= 2^128; {NumericDomainError} if NaN.
routine U128!(from: B128) -> U128
  var bits = from.to_bits()
  var sign = LLVM::int_truncate[U128, U64](LLVM::shift_right_unsigned(bits, 127_u128))
  var biased = LLVM::int_truncate[U128, U64](LLVM::bit_and(a: LLVM::shift_right_unsigned(bits, 112_u128), b: 32767_u128))
  var frac = LLVM::bit_and(a: bits, b: b128_mant_mask())
  if biased == 0x7FFF_u64
    if LLVM::int_eq(a: frac, b: 0_u128)
      throw NumericOverflowError(description: "cannot convert infinite B128 to U128")
    throw NumericDomainError(description: "cannot convert NaN B128 to U128")
  if sign == 1_u64 and (LLVM::int_ne(a: biased, b: 0_u64) or LLVM::int_ne(a: frac, b: 0_u128))
    throw NumericOverflowError(description: "cannot convert negative B128 to U128")
  if biased < 16383_u64
    return 0_u128
  var actual_exp = LLVM::sub(a: biased, b: 16383_u64)
  if actual_exp >= 128_u64
    throw NumericOverflowError(description: "B128 value out of range for U128")
  var sig = LLVM::bit_or(a: b128_implicit(), b: frac)
  if actual_exp <= 112_u64
    return LLVM::shift_right_unsigned(sig, LLVM::zero_extend[U64, U128](LLVM::sub(a: 112_u64, b: actual_exp)))
  return LLVM::shift_left(sig, LLVM::zero_extend[U64, U128](LLVM::sub(a: actual_exp, b: 112_u64)))

### Converts a `D32` to `U128`, truncating toward zero.
### :param from: The `D32` value to convert.
### :returns: The integer part of `from` as a `U128`.
### :throws: {NumericOverflowError} if the integer part overflows U128.
routine U128!(from: D32) -> U128
  return U128(from: D128(from: from))

### Converts a `D64` to `U128`, truncating toward zero.
### :param from: The `D64` value to convert.
### :returns: The integer part of `from` as a `U128`.
### :throws: {NumericOverflowError} if the integer part overflows U128.
routine U128!(from: D64) -> U128
  return U128(from: D128(from: from))

# ============================================================================
# Arithmetic Operations (trapping on overflow by default)
# ============================================================================

### Returns the sum and a flag indicating whether the result wrapped around.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_sum, overflowed)`.
routine U128.add_with_overflow(you: U128) -> (U128, Bool)
  return LLVM::unsigned_add_checked[U128](me, you)

### Returns the difference and a flag indicating whether the result wrapped around.
### :param you: The value to subtract.
### :returns: A tuple of `(wrapped_difference, overflowed)`.
routine U128.sub_with_overflow(you: U128) -> (U128, Bool)
  return LLVM::unsigned_sub_checked[U128](me, you)

### Returns the product and a flag indicating whether the result wrapped around.
### :param you: The right operand.
### :returns: A tuple of `(wrapped_product, overflowed)`.
routine U128.mul_with_overflow(you: U128) -> (U128, Bool)
  return LLVM::unsigned_mul_checked[U128](me, you)

### Returns `me + you`, throwing on overflow.
### :param you: The right operand.
### :returns: The sum `me + you`.
### :throws: {IntegerOverflowError} if the result exceeds `U128_MAX`.
routine U128.add!(you: U128) -> U128
  var result = me.add_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me - you`, throwing on underflow.
### :param you: The value to subtract.
### :returns: The difference `me - you`.
### :throws: {IntegerOverflowError} if the result is less than `U128_MIN` (0).
routine U128.sub!(you: U128) -> U128
  var result = me.sub_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me * you`, throwing on overflow.
### :param you: The right operand.
### :returns: The product `me * you`.
### :throws: {IntegerOverflowError} if the result exceeds `U128_MAX`.
routine U128.mul!(you: U128) -> U128
  var result = me.mul_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Unsigned 128/128 floor division via the generic base-2⁶⁴ Knuth-D kernel
### (`knuth_divide[2]`), which bottoms out on hardware `DIV r64` for every estimation
### step — avoiding the slow soft `__udivti3`/inline-expansion at every divisor size.
### The `i128` storage is reinterpreted in place as two little-endian U64 limbs.
### PRECONDITION: `b != 0`.
routine u128_floordiv(a: U128, b: U128) -> U128
  var av = a
  var bv = b
  var rem = Array[U64, 2]()
  var qlo = 0_u64
  var qhi = 0_u64
  danger
    var q = knuth_divide[2](
      a: LLVM::reinterpret_bits[Hijacked[U128], Hijacked[Array[U64, 2]]](av.hijack()),
      b: LLVM::reinterpret_bits[Hijacked[U128], Hijacked[Array[U64, 2]]](bv.hijack()),
      rem: rem.hijack())
    qlo = LLVM::load_element_ref[Array[U64, 2], U64](q.hijack(), 0_u64)
    qhi = LLVM::load_element_ref[Array[U64, 2], U64](q.hijack(), 1_u64)
  return LLVM::bit_or(LLVM::shift_left(LLVM::zero_extend[U64, U128](qhi), 64_u128), LLVM::zero_extend[U64, U128](qlo))

### Returns `me // you` (integer division), throwing if `you` is zero.
### :param you: The divisor.
### :returns: The quotient `me // you`.
### :throws: {DivisionByZeroError} if `you == 0`.
routine U128.floordiv!(you: U128) -> U128
  if you == 0
    throw DivisionByZeroError()
  return u128_floordiv(a: me, b: you)

### Returns `me % you` (integer remainder).
### :param you: The divisor.
### :returns: The remainder `me % you`. Behavior is undefined if `you == 0`.
### Unsigned 128-bit remainder via the Knuth-D kernel. PRECONDITION: `b != 0`.
routine u128_mod(a: U128, b: U128) -> U128
  var av = a
  var bv = b
  var rem = Array[U64, 2]()
  var rlo = 0_u64
  var rhi = 0_u64
  danger
    var q = knuth_divide[2](
      a: LLVM::reinterpret_bits[Hijacked[U128], Hijacked[Array[U64, 2]]](av.hijack()),
      b: LLVM::reinterpret_bits[Hijacked[U128], Hijacked[Array[U64, 2]]](bv.hijack()),
      rem: rem.hijack())
    rlo = LLVM::load_element_ref[Array[U64, 2], U64](rem.hijack(), 0_u64)
    rhi = LLVM::load_element_ref[Array[U64, 2], U64](rem.hijack(), 1_u64)
  return LLVM::bit_or(LLVM::shift_left(LLVM::zero_extend[U64, U128](rhi), 64_u128), LLVM::zero_extend[U64, U128](rlo))

### Remainder of `me` divided by `you`.
### :param you: The divisor.
### :returns: The remainder.
### :throws: {DivisionByZeroError} if `you == 0`.
routine U128.mod!(you: U128) -> U128
  if you == 0_u128
    throw DivisionByZeroError()
  return u128_mod(a: me, b: you)

### (quotient, remainder) of `a // b` and `a % b` from ONE `knuth_divide[2]` pass. PRECONDITION: `b != 0`.
routine u128_divmod(a: U128, b: U128) -> (U128, U128)
  var av = a
  var bv = b
  var rem = Array[U64, 2]()
  var qlo = 0_u64
  var qhi = 0_u64
  var rlo = 0_u64
  var rhi = 0_u64
  danger
    var q = knuth_divide[2](
      a: LLVM::reinterpret_bits[Hijacked[U128], Hijacked[Array[U64, 2]]](av.hijack()),
      b: LLVM::reinterpret_bits[Hijacked[U128], Hijacked[Array[U64, 2]]](bv.hijack()),
      rem: rem.hijack())
    qlo = LLVM::load_element_ref[Array[U64, 2], U64](q.hijack(), 0_u64)
    qhi = LLVM::load_element_ref[Array[U64, 2], U64](q.hijack(), 1_u64)
    rlo = LLVM::load_element_ref[Array[U64, 2], U64](rem.hijack(), 0_u64)
    rhi = LLVM::load_element_ref[Array[U64, 2], U64](rem.hijack(), 1_u64)
  var qv = LLVM::bit_or(LLVM::shift_left(LLVM::zero_extend[U64, U128](qhi), 64_u128), LLVM::zero_extend[U64, U128](qlo))
  var rv = LLVM::bit_or(LLVM::shift_left(LLVM::zero_extend[U64, U128](rhi), 64_u128), LLVM::zero_extend[U64, U128](rlo))
  return (qv, rv)

### (quotient, remainder) of `me // you` and `me % you` from ONE Knuth-D pass — half the work of
### calling `//` and `%` separately. Throws on a zero divisor.
### :param you: The divisor.
### :returns: The tuple `(me // you, me % you)`.
### :throws: {DivisionByZeroError} if `you == 0`.
@readonly
routine U128.divmod!(you: U128) -> (U128, U128)
  if you == 0_u128
    throw DivisionByZeroError()
  return u128_divmod(a: me, b: you)

# ============================================================================
# Negation (wrapping)
# ============================================================================

### Returns the two's-complement negation `(2¹²⁸ - me) mod 2¹²⁸`.
### :returns: The wrapped negation.
routine U128.neg_wrap() -> U128
  return LLVM::sub(a: 0_u128, b: me)

### Returns `(wrapping negation, overflowed)`. Overflow occurs for any non-zero value.
### :returns: A tuple of `(wrapped negation, overflow flag)`.
routine U128.neg_with_overflow() -> (U128, Bool)
  return (LLVM::sub(a: 0_u128, b: me), me != 0_u128)

# ============================================================================
# Wrapping Arithmetic (+%, -%, *%)
# ============================================================================

### Returns `(me + you) mod 2¹²⁸` without overflow check.
### :param you: The right operand.
### :returns: The sum modulo 2¹²⁸.
routine U128.add_wrap(you: U128) -> U128
  return LLVM::add(a: me, b: you)

### Returns `(me - you) mod 2¹²⁸` without underflow check.
### :param you: The value to subtract.
### :returns: The difference modulo 2¹²⁸.
routine U128.sub_wrap(you: U128) -> U128
  return LLVM::sub(a: me, b: you)

### Returns `(me * you) mod 2¹²⁸` without overflow check.
### :param you: The right operand.
### :returns: The product modulo 2¹²⁸.
routine U128.mul_wrap(you: U128) -> U128
  return LLVM::mul(a: me, b: you)

# ============================================================================
# Unchecked Arithmetic (+!, -!, *!, //!, %!)
# ============================================================================

### Returns `me + you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The sum, assuming no overflow.
dangerous routine U128.add_unchecked(you: U128) -> U128
  return LLVM::unsigned_add_exact[U128](a: me, b: you)

### Returns `me - you` with undefined behavior on underflow.
### :param you: The value to subtract.
### :returns: The difference, assuming no underflow.
dangerous routine U128.sub_unchecked(you: U128) -> U128
  return LLVM::unsigned_sub_exact[U128](a: me, b: you)

### Returns `me * you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The product, assuming no overflow.
dangerous routine U128.mul_unchecked(you: U128) -> U128
  return LLVM::unsigned_mul_exact[U128](a: me, b: you)

### Returns `me // you` with undefined behavior if `you == 0`.
### :param you: The divisor.
### :returns: The quotient, assuming `you != 0`.
dangerous routine U128.floordiv_unchecked(you: U128) -> U128
  # Use the hand-written base-2⁶⁴ Knuth divider, not LLVM's `udiv i128` (`__udivti3`): the bench shows
  # `u128_floordiv` is faster (~11 vs ~17 ns) and it matches `floordiv!`'s kernel (sans the zero check).
  return u128_floordiv(a: me, b: you)

### Returns `me % you` with undefined behavior if `you == 0`.
### :param you: The divisor.
### :returns: The remainder, assuming `you != 0`.
dangerous routine U128.mod_unchecked(you: U128) -> U128
  return u128_mod(a: me, b: you)

# ============================================================================
# Clamping Arithmetic (+^, -^, *^)
# ============================================================================

### Returns `me + you`, clamped to `U128_MAX` on overflow.
### :param you: The right operand.
### :returns: The sum, or `U128_MAX` if it would overflow.
routine U128.add_clamp(you: U128) -> U128
  return LLVM::unsigned_add_sat[U128](a: me, b: you)

### Returns `me - you`, clamped to `U128_MIN` on underflow.
### :param you: The value to subtract.
### :returns: The difference, or `0` if it would go below `U128_MIN`.
routine U128.sub_clamp(you: U128) -> U128
  return LLVM::unsigned_sub_sat[U128](a: me, b: you)

### Returns `me * you`, clamped to `U128_MAX` on overflow.
### :param you: The right operand.
### :returns: The product, or `U128_MAX` if it would overflow.
routine U128.mul_clamp(you: U128) -> U128
  var wide = LLVM::mul(LLVM::zero_extend[U128, U256](me), LLVM::zero_extend[U128, U256](you))
  if LLVM::unsigned_gt(wide, 340282366920938463463374607431768211455_u256)
    return U128_MAX
  return LLVM::int_truncate[U256, U128](wide)

# ============================================================================
# Widening / Carrying Arithmetic (multi-word building blocks)
# ============================================================================

### Returns `me + you + carry` as `(wrapped_sum, carry_out)`.
### Chains across words to add integers wider than `U128`: feed each word's
### `carry_out` in as the next higher word's `carry`.
### :param you: The right operand.
### :param carry: The incoming carry bit from the lower word.
### :returns: A tuple of `(wrapped sum, outgoing carry)`.
routine U128.carrying_add(you: U128, carry: Bool) -> (U128, Bool)
  var carry_val: U128 = if carry then 1_u128 else 0_u128
  var first = me.add_with_overflow(you)
  var second = first.item0.add_with_overflow(carry_val)
  return (second.item0, first.item1 or second.item1)

### Returns `me - you - borrow` as `(wrapped_difference, borrow_out)`.
### Chains across words to subtract integers wider than `U128`.
### :param you: The value to subtract.
### :param borrow: The incoming borrow bit from the lower word.
### :returns: A tuple of `(wrapped difference, outgoing borrow)`.
routine U128.borrowing_sub(you: U128, borrow: Bool) -> (U128, Bool)
  var borrow_val: U128 = if borrow then 1_u128 else 0_u128
  var first = me.sub_with_overflow(you)
  var second = first.item0.sub_with_overflow(borrow_val)
  return (second.item0, first.item1 or second.item1)

### Returns the full `me * you` product as `(low, high)` halves.
### The product of two `U128` values needs 256 bits; this splits it into the
### low and high `U128` words without loss.
### :param you: The right operand.
### :returns: A tuple of `(low 128 bits, high 128 bits)`.
routine U128.widening_mul(you: U128) -> (U128, U128)
  var wide = LLVM::mul(LLVM::zero_extend[U128, U256](me), LLVM::zero_extend[U128, U256](you))
  var lo = LLVM::int_truncate[U256, U128](wide)
  var hi = LLVM::int_truncate[U256, U128](LLVM::shift_right_unsigned(wide, 128_u256))
  return (lo, hi)

### Returns `me * you + carry` as `(low, high)` halves.
### Never overflows: the largest result is `(2¹²⁸-1)² + (2¹²⁸-1) < 2²⁵⁶`. The
### workhorse of schoolbook multiplication — `carry` accumulates the high word
### carried out of the previous column.
### :param you: The right operand.
### :param carry: The value to add to the product.
### :returns: A tuple of `(low 128 bits, high 128 bits)`.
routine U128.carrying_mul(you: U128, carry: U128) -> (U128, U128)
  var wide = LLVM::mul(LLVM::zero_extend[U128, U256](me), LLVM::zero_extend[U128, U256](you))
  wide = LLVM::add(wide, LLVM::zero_extend[U128, U256](carry))
  var lo = LLVM::int_truncate[U256, U128](wide)
  var hi = LLVM::int_truncate[U256, U128](LLVM::shift_right_unsigned(wide, 128_u256))
  return (lo, hi)

# ============================================================================
# Power Operations (**)
# ============================================================================

### Returns `me ** exp` and a flag indicating whether the result wrapped around.
### :param exp: The exponent.
### :returns: A tuple of `(wrapped_result, overflowed)`.
routine U128.pow_with_overflow(exp: U128) -> (U128, Bool)
  var result: U128 = 1
  var base: U128 = me
  var e: U32 = U32(exp)
  var overflow = false
  while e > 0
    if (e & 1) == 1
      var mul_result = result.mul_with_overflow(base)
      result = mul_result.item0
      overflow = overflow or mul_result.item1
    e = e >> 1_u32
    if e > 0
      var square_result = base.mul_with_overflow(base)
      base = square_result.item0
      overflow = overflow or square_result.item1
  return (result, overflow)

### Returns `me ** exp`, throwing on overflow.
### :param exp: The exponent.
### :returns: The result of raising `me` to the power `exp`.
### :throws: {IntegerOverflowError} if the result exceeds `U128_MAX`.
routine U128.pow!(exp: U128) -> U128
  var result = me.pow_with_overflow(exp)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me ** exp` with wrapping arithmetic (mod 2¹²⁸).
### :param exp: The exponent.
### :returns: The result modulo 2¹²⁸.
routine U128.pow_wrap(exp: U128) -> U128
  var result: U128 = 1
  var base: U128 = me
  var e: U32 = U32(exp)
  while e > 0
    if (e & 1) == 1
      result = result.mul_wrap(base)
    e = e >> 1_u32
    if e > 0
      base = base.mul_wrap(base)
  return result

### Returns `me ** exp`, clamped to `U128_MAX` on overflow.
### :param exp: The exponent.
### :returns: The result, or `U128_MAX` if it would overflow.
routine U128.pow_clamp(exp: U128) -> U128
  var result: U128 = 1
  var base: U128 = me
  var e: U32 = U32(exp)
  while e > 0
    if (e & 1) == 1
      result = result.mul_clamp(base)
    base = base.mul_clamp(base)
    e = e >> 1_u32
  return result

# ============================================================================
# Bitwise Operations
# ============================================================================

### Returns the bitwise AND of this value and `you`.
### :param you: The right operand.
### :returns: `me & you`.
routine U128.bitand(you: U128) -> U128
  return LLVM::bit_and(a: me, b: you)

### Returns the bitwise OR of this value and `you`.
### :param you: The right operand.
### :returns: `me | you`.
routine U128.bitor(you: U128) -> U128
  return LLVM::bit_or(a: me, b: you)

### Returns the bitwise XOR of this value and `you`.
### :param you: The right operand.
### :returns: `me ^ you`.
routine U128.bitxor(you: U128) -> U128
  return LLVM::bit_xor(a: me, b: you)

### Returns the bitwise complement of this value.
### :returns: `~me` — each bit flipped.
routine U128.bitnot() -> U128
  return LLVM::bit_xor(a: me, b: U128_MAX)

# ============================================================================
# Shift Operations (<<, <<?>, >>, <<<, >>>)
# For unsigned types, arithmetic and logical shifts behave identically
# ============================================================================

### Left-shifts this value by `bits` positions, filling vacated bits with zero.
### :param bits: The number of bit positions to shift left.
### :returns: `me << bits`.
routine U128.ashl(bits: U32) -> U128
  return LLVM::shift_left(me, U128(bits))

### Right-shifts this value by `bits` positions, filling vacated bits with zero.
### :param bits: The number of bit positions to shift right.
### :returns: `me >> bits` (logical, zero-filling).
routine U128.ashr(bits: U32) -> U128
  return LLVM::shift_right_unsigned(me, U128(bits))

### Left-shifts this value by `bits` positions (logical shift, same as `ashl` for unsigned).
### :param bits: The number of bit positions to shift left.
### :returns: `me << bits`.
routine U128.lshl(bits: U32) -> U128
  return LLVM::shift_left(me, U128(bits))

### Right-shifts this value by `bits` positions (logical shift, same as `ashr` for unsigned).
### :param bits: The number of bit positions to shift right.
### :returns: `me >> bits` (zero-filling).
routine U128.lshr(bits: U32) -> U128
  return LLVM::shift_right_unsigned(me, U128(bits))

# ============================================================================
# Comparison Operations
# ============================================================================

### Returns `true` when both values are equal.
### :param you: The value to compare against.
### :returns: `true` if `me == you`; `false` otherwise.
routine U128.eq(you: U128) -> Bool
  return LLVM::int_eq(a: me, b: you)

### Compares this value with `you`, returning the ordering relationship.
### :param you: The value to compare against.
### :returns: `ME_SMALL` if `me < you`, `ME_LARGE` if `me > you`, `SAME` if equal.
routine U128.cmp(you: U128) -> ComparisonSign
  if LLVM::unsigned_lt(me, you)
    return ME_SMALL
  if LLVM::unsigned_gt(me, you)
    return ME_LARGE
  return SAME

# ============================================================================
# Math Operations
# ============================================================================

### Returns the smaller of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me <= you`; otherwise `you`.
routine U128.min(you: U128) -> U128
  return if me <= you then me else you

### Returns the larger of this value and `you`.
### :param you: The value to compare against.
### :returns: `me` if `me >= you`; otherwise `you`.
routine U128.max(you: U128) -> U128
  return if me >= you then me else you

### Returns this value clamped to the range `min_val..=max_val`.
### :param min_val: The lower bound (inclusive).
### :param max_val: The upper bound (inclusive).
### :returns: `min_val` if `me < min_val`; `max_val` if `me > max_val`; otherwise `me`.
@positional
routine U128.clamp(min_val: U128, max_val: U128) -> U128
  return me.min(max_val).max(min_val)

# ============================================================================
# Integer Math (roots, logs, rounding)
# ============================================================================

### Returns the integer square root ⌊√me⌋ — the largest value whose square is ≤ me.
### :returns: The floor of the square root of `me`.
routine U128.isqrt() -> U128
  var x = me
  var result = 0_u128
  var bit = 1_u128 << 126_u32
  while bit > x
    bit = bit.lshr(2_u32)
  while bit != 0_u128
    var next = result.add_wrap(bit)
    if x >= next
      x = x.sub_wrap(next)
      result = result.lshr(1_u32).add_wrap(bit)
    else
      result = result.lshr(1_u32)
    bit = bit.lshr(2_u32)
  return result

### Returns ⌊log₂ me⌋. Throws if `me` is zero (the logarithm of zero is undefined).
### :returns: The floor of the base-2 logarithm.
### :throws: {NumericDomainError} if `me == 0`.
routine U128.ilog2() -> U128
  if me == 0_u128
    throw NumericDomainError(description: "ilog2 of zero is undefined")
  return 127_u128 - me.leading_zeros()

### Returns ⌊log₁₀ me⌋. Throws if `me` is zero.
### :returns: The floor of the base-10 logarithm.
### :throws: {NumericDomainError} if `me == 0`.
routine U128.ilog10() -> U128
  if me == 0_u128
    throw NumericDomainError(description: "ilog10 of zero is undefined")
  var n = me
  var count = 0_u128
  while n >= 10_u128
    n = n // 10_u128
    count = count + 1_u128
  return count

### Returns ⌊log_base me⌋. Throws if `me` is zero or `base < 2`.
### :param base: The logarithm base (must be ≥ 2).
### :returns: The floor of the base-`base` logarithm.
### :throws: {NumericDomainError} if `me == 0` or `base < 2`.
routine U128.ilog(base: U128) -> U128
  if me == 0_u128 or base < 2_u128
    throw NumericDomainError(description: "ilog domain: me must be > 0 and base >= 2")
  var n = me
  var count = 0_u128
  while n >= base
    n = n // base
    count = count + 1_u128
  return count

### Returns the absolute difference |me - you| without overflow.
### :param you: The other value.
### :returns: The non-negative distance between `me` and `you`.
routine U128.abs_diff(you: U128) -> U128
  return if me >= you then me.sub_wrap(you) else you.sub_wrap(me)

### Returns ⌈me / you⌉ (division rounding toward positive infinity).
### :param you: The divisor.
### :returns: The ceiling of `me / you`.
### :throws: {DivisionByZeroError} if `you == 0`.
routine U128.div_ceil(you: U128) -> U128
  var q = me.floordiv!(you)
  var r = me.mod!(you)
  return if r == 0_u128 then q else q.add_wrap(1_u128)

### Returns the smallest power of two that is ≥ me. Both `0` and `1` map to `1`.
### :returns: The next power of two at or above `me`.
### :throws: {IntegerOverflowError} if the next power of two exceeds `U128_MAX`.
routine U128.next_power_of_two() -> U128
  if me <= 1_u128
    return 1_u128
  var shift = 128_u128 - me.sub_wrap(1_u128).leading_zeros()
  if shift >= 128_u128
    throw IntegerOverflowError()
  return LLVM::shift_left(1_u128, shift)

### Returns the smallest multiple of `you` that is ≥ me.
### :param you: The base to round up to.
### :returns: The next multiple of `you` at or above `me`.
### :throws: {DivisionByZeroError} if `you == 0`.
### :throws: {IntegerOverflowError} if the result exceeds `U128_MAX`.
routine U128.next_multiple_of(you: U128) -> U128
  var r = me.mod!(you)
  if r == 0_u128
    return me
  return me.add!(you.sub_wrap(r))

### Returns ⌊(me + you) / 2⌋ computed without overflow.
### :param you: The other value.
### :returns: The midpoint of `me` and `you`, rounding toward negative infinity.
routine U128.midpoint(you: U128) -> U128
  return me.bitand(you).add_wrap(me.bitxor(you).lshr(1_u32))

# ============================================================================
# Bit Manipulation
# ============================================================================

### Returns the count of set bits (popcount) in this value's 128-bit representation.
### :returns: The number of `1` bits; between 0 and 128.
routine U128.count_ones() -> U128
  return LLVM::count_ones[U128](me)

### Returns the count of clear bits in this value's 128-bit representation.
### :returns: `128` minus the popcount; between 0 and 128.
routine U128.count_zeros() -> U128
  return 128_u128 -% me.count_ones()

### Returns the number of leading zero bits, starting from the most-significant bit.
### :returns: The leading zero count; `128` if the value is zero.
routine U128.leading_zeros() -> U128
  return LLVM::leading_zeros(me)

### Returns the number of trailing zero bits, starting from the least-significant bit.
### :returns: The trailing zero count; `128` if the value is zero.
routine U128.trailing_zeros() -> U128
  return LLVM::trailing_zeros(me)

### Returns the number of leading one bits, starting from the most-significant bit.
### :returns: The leading one count; `128` if the value is `U128_MAX`.
routine U128.leading_ones() -> U128
  return me.bitnot().leading_zeros()

### Returns the number of trailing one bits, starting from the least-significant bit.
### :returns: The trailing one count; `128` if the value is `U128_MAX`.
routine U128.trailing_ones() -> U128
  return me.bitnot().trailing_zeros()

### Returns this value with its bits reversed (bit 127 ↔ bit 0, etc.).
### :returns: The bit-reversed `U128`.
routine U128.reverse_bits() -> U128
  return LLVM::reverse_bits[U128](me)

### Returns this value with its 16 bytes swapped (for endianness conversion).
### :returns: A `U128` with its bytes in reverse order.
routine U128.swap_bytes() -> U128
  return LLVM::byte_swap(me)

### Returns `true` if this value is an exact power of two.
### :returns: `true` if `me` is 1, 2, 4, ..., 2¹²⁷; `false` otherwise (including zero).
routine U128.is_power_of_two() -> Bool
  return me != 0_u128 and (me & (me - 1_u128)) == 0_u128

### Returns this value rotated left by `bits` positions.
routine U128.rotate_left(bits: U32) -> U128
  var n = bits % 128_u32
  if n == 0_u32
    return me
  return LLVM::bit_or(a: LLVM::shift_left(me, U128(n)), b: LLVM::shift_right_unsigned(me, U128(128_u32 -% n)))

### Returns this value rotated right by `bits` positions.
routine U128.rotate_right(bits: U32) -> U128
  var n = bits % 128_u32
  if n == 0_u32
    return me
  return LLVM::bit_or(a: LLVM::shift_right_unsigned(me, U128(n)), b: LLVM::shift_left(me, U128(128_u32 -% n)))

### Returns the raw byte representation of this value in little-endian order.
routine U128.to_bytes_le() -> Array[Byte, 16]
  var result = Array[Byte, 16]()
  var i = 0_u64
  while i < 16_u64
    var b = LLVM::int_truncate[U128, U8](LLVM::shift_right_unsigned(me, U128(i * 8_u64)))
    result = LLVM::set_byte_at(array: result, index: i, value: b)
    i = i + 1_u64
  return result

### Returns the raw byte representation of this value in big-endian order.
routine U128.to_bytes_be() -> Array[Byte, 16]
  return me.swap_bytes().to_bytes_le()

### Builds a `U128` from its little-endian raw byte representation.
common routine U128.from_bytes_le(bytes: Array[Byte, 16]) -> U128
  var result = 0_u128
  var i = 0_u64
  while i < 16_u64
    var part = LLVM::shift_left(LLVM::zero_extend[U8, U128](LLVM::byte_at(array: bytes, index: i)), U128(i * 8_u64))
    result = LLVM::bit_or(a: result, b: part)
    i = i + 1_u64
  return result

### Builds a `U128` from its big-endian raw byte representation.
common routine U128.from_bytes_be(bytes: Array[Byte, 16]) -> U128
  return U128.from_bytes_le(bytes: bytes).swap_bytes()

# ============================================================================
# Utility Methods
# ============================================================================

### Returns `true` if this value is zero.
### :returns: `true` if `me == 0`.
routine U128.is_zero() -> Bool
  return me == 0_u128

### Returns `true` if this value is divisible by 2.
### :returns: `true` if the least-significant bit is 0.
routine U128.is_even() -> Bool
  var result = LLVM::bit_and(a: me, b: 1_u128)
  return LLVM::int_eq(a: result, b: 0_u128)

### Returns `true` if this value is not divisible by 2.
### :returns: `true` if the least-significant bit is 1.
routine U128.is_odd() -> Bool
  return not me.is_even()

### Returns the upper 64 bits of this 128-bit value.
### :returns: Bits 127..64 as a `U64`.
routine U128.high64() -> U64
  var shifted = LLVM::shift_right_unsigned[U128](me, 64_u32)
  return LLVM::int_truncate[U128, U64](shifted)

### Returns the lower 64 bits of this 128-bit value.
### :returns: Bits 63..0 as a `U64`.
routine U128.low64() -> U64
  return LLVM::int_truncate[U128, U64](me)

# ============================================================================
# Text Representation and Parsing
# ============================================================================

### Returns the human-readable text of this value.
### :returns: The value rendered as `Text`.
@override
routine U128.represent() -> Text
  if me == 0u128
    return "0"
  var digits = List[Character]()
  var remaining = me
  while remaining > 0u128
    var digit = U8(LLVM::unsigned_rem(a: remaining, b: 10u128))
    remaining = LLVM::unsigned_div(a: remaining, b: 10u128)
    digits.add_first(Character(0x0030u32 + U32(digit)))
  return Text(from_list: steal digits)

### Returns a type-tagged debug rendering of this value.
### :returns: A diagnostic `Text` rendering, e.g. `Type(value)`.
@override
routine U128.diagnose() -> Text
  return "U128(" + me.represent() + ")"

### Parses a decimal string into a `U128`.
### :param from_text: The decimal string to parse (no sign, no prefix).
### :returns: The parsed `U128` value.
### :throws: {InvalidValueError} if `from_text` is empty or contains non-digit characters.
routine U128!(from_text: Text) -> U128
  if from_text.count() == 0u64
    throw InvalidValueError(input: from_text, target: "U128")
  var result = 0u128
  var i = 0u64
  while i < from_text.count()
    var ch = from_text[i]
    if ch.is_numeric()
      result = result * 10u128 + U128(ch.digit_value())
    else
      throw InvalidValueError(input: from_text, target: "U128")
    i = i + 1u64
  return result

# ============================================================================
# Hashing
# ============================================================================

### Returns a SipHash-2-4 keyed hash of this 128-bit value.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash suitable for denial-of-service-resistant hash tables.
routine U128.hash(k0: U64, k1: U64) -> U64
  return __secure_hash_u128(v: me, k0: k0, k1: k1)
