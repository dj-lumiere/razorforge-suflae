module Core

import Collections
# Core B16 type definition - maps to LLVM half

### Represents a 16-bit IEEE 754 binary floating-point value.
### `B16` trades away precision and range for compact storage, which makes it a
### good fit for packed numeric data, graphics formats, and bandwidth-sensitive
### workloads.
@llvm("half")
record B16 obeys Numeric, Ordered, Assignable, Copyable, Splittable
  pass

# IEEE 754 half precision constants
preset B16_EPSILON: B16 = 9.765625e-4_b16
preset B16_MIN: B16 = -65504.0_b16
preset B16_MAX: B16 = 65504.0_b16
preset B16_MIN_POSITIVE: B16 = 6.103515625e-5_b16
preset B16_ZERO: B16 = 0.0_b16
preset B16_ONE: B16 = 1.0_b16
preset B16_INFINITY: B16 = inf_b16
preset B16_NAN: B16 = nan_b16

# Mathematical constants
preset B16_PI: B16 = 3.140625_b16
preset B16_E: B16 = 2.71875_b16
preset B16_SQRT_2: B16 = 1.414063_b16

### Converts an `S8` into half-precision floating-point form.
### :param from: The signed 8-bit integer to convert.
### :returns: The corresponding `B16` value.
@inline
routine B16(from: S8) -> B16
  return LLVM::signed_to_float[S8, B16](from)

### Converts an `S16` into half-precision floating-point form.
### :param from: The signed 16-bit integer to convert.
### :returns: The closest representable `B16` value.
@inline
routine B16(from: S16) -> B16
  return LLVM::signed_to_float[S16, B16](from)

### Converts an `S32` into half-precision floating-point form.
### :param from: The signed 32-bit integer to convert.
### :returns: The closest representable `B16` value.
routine B16!(from: S32) -> B16
  return LLVM::signed_to_float[S32, B16](from).finite()

### Converts an `S64` into half-precision floating-point form.
### :param from: The signed 64-bit integer to convert.
### :returns: The closest representable `B16` value.
routine B16!(from: S64) -> B16
  return LLVM::signed_to_float[S64, B16](from).finite()

### Converts an `S128` into half-precision floating-point form.
### :param from: The signed 128-bit integer to convert.
### :returns: The closest representable `B16` value.
routine B16!(from: S128) -> B16
  return LLVM::signed_to_float[S128, B16](from).finite()

### Converts a `U8` into half-precision floating-point form.
### :param from: The unsigned 8-bit integer to convert.
### :returns: The corresponding `B16` value.
@inline
routine B16(from: U8) -> B16
  return LLVM::unsigned_to_float[U8, B16](from)

### Converts a `U16` into half-precision floating-point form.
### :param from: The unsigned 16-bit integer to convert.
### :returns: The closest representable `B16` value.
routine B16!(from: U16) -> B16
  return LLVM::unsigned_to_float[U16, B16](from).finite()

### Converts a `U32` into half-precision floating-point form.
### :param from: The unsigned 32-bit integer to convert.
### :returns: The closest representable `B16` value.
routine B16!(from: U32) -> B16
  return LLVM::unsigned_to_float[U32, B16](from).finite()

### Converts a `U64` into half-precision floating-point form.
### :param from: The unsigned 64-bit integer to convert.
### :returns: The closest representable `B16` value.
routine B16!(from: U64) -> B16
  return LLVM::unsigned_to_float[U64, B16](from).finite()

### Converts a `U128` into half-precision floating-point form.
### :param from: The unsigned 128-bit integer to convert.
### :returns: The closest representable `B16` value.
routine B16!(from: U128) -> B16
  return LLVM::unsigned_to_float[U128, B16](from).finite()

### Converts an `S256` into half-precision floating-point form.
### :param from: The signed 256-bit integer to convert.
### :returns: The closest representable `B16` value.
routine B16!(from: S256) -> B16
  return LLVM::signed_to_float[S256, B16](from).finite()

### Converts a `U256` into half-precision floating-point form.
### :param from: The unsigned 256-bit integer to convert.
### :returns: The closest representable `B16` value.
routine B16!(from: U256) -> B16
  return LLVM::unsigned_to_float[U256, B16](from).finite()

### Returns an existing `B16` unchanged.
### :param from: The half-precision value to forward.
### :returns: `from`.
@inline
routine B16(from: B16) -> B16
  return from

### Narrows a single-precision float to half precision.
### :param from: The `B32` value to convert.
### :returns: The nearest representable `B16` value.
@inline
routine B16(from: B32) -> B16
  return LLVM::float_narrow[B32, B16](from)

### Narrows a double-precision float to half precision.
### :param from: The `B64` value to convert.
### :returns: The nearest representable `B16` value.
@inline
routine B16(from: B64) -> B16
  return LLVM::float_narrow[B64, B16](from)

### Narrows a quadruple-precision float to half precision.
### :param from: The `B128` value to convert.
### :returns: The nearest representable `B16` value.
routine B16(from: B128) -> B16
  # Narrow to B32 first (B32 keeps more than enough precision that the second
  # rounding step is harmless in practice), then to B16.
  return B16(from: from.B32())

### Converts a decimal32 value to half-precision binary floating point.
### :param from: The decimal floating-point input value.
### :returns: The closest representable `B16` value.
routine B16(from: D32) -> B16
  return LLVM::float_narrow[B32, B16](B32(from: B64(from)))

### Converts a decimal64 value to half-precision binary floating point.
### :param from: The decimal floating-point input value.
### :returns: The closest representable `B16` value.
routine B16(from: D64) -> B16
  return LLVM::float_narrow[B32, B16](B32(from: B64(from)))

### Converts a decimal128 value to half-precision binary floating point.
### :param from: The decimal floating-point input value.
### :returns: The closest representable `B16` value.
routine B16(from: D128) -> B16
  return LLVM::float_narrow[B32, B16](B32(from: B64(from)))

# ============================================================================
# Arithmetic Operations (IEEE 754 semantics)
# ============================================================================

# Checked arithmetic crashes with a specific cause on a non-finite result (mirrors B64/Decimal):
# ±inf -> NumericOverflowError, NaN -> NumericDomainError, x/0 -> DivisionByZeroError. `@crash_only`
# keeps the callers non-failable. Use the `*_unchecked` operators for raw IEEE 754 propagation.

### Returns `me + you`. Checked: crashes if the IEEE result is non-finite. Use `add_unchecked` for
### raw IEEE.
### :param you: The addend.
### :returns: The half-precision sum (always finite).
routine B16.add!(you: B16) -> B16
  var r = LLVM::float_add[B16](a: me, b: you)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `me - you`. Checked: crashes if the IEEE result is non-finite. Use `sub_unchecked` for
### raw IEEE.
### :param you: The value to subtract.
### :returns: The half-precision difference (always finite).
routine B16.sub!(you: B16) -> B16
  var r = LLVM::float_sub[B16](a: me, b: you)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `me * you`. Checked: crashes if the IEEE result is non-finite. Use `mul_unchecked` for
### raw IEEE.
### :param you: The multiplier.
### :returns: The half-precision product (always finite).
routine B16.mul!(you: B16) -> B16
  var r = LLVM::float_mul[B16](a: me, b: you)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `me / you`. Checked: `x/0` -> DivisionByZeroError, `0/0` -> domain, overflow ->
### overflow.
### Use `truediv_unchecked` for raw IEEE 754, or `(a / b).finite()` for recoverable handling.
### :param you: The divisor.
### :returns: The half-precision quotient (always finite).
routine B16.truediv!(you: B16) -> B16
  var r = LLVM::float_div[B16](a: me, b: you)
  if r.is_finite()
    return r
  if you.is_zero() and not me.is_zero()
    throw DivisionByZeroError()
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `me` if it is finite; throws if it is ±infinity or NaN. The opt-in
### finiteness assertion for IEEE arithmetic, e.g. `var x = (a * b + c).finite()`.
### :returns: `me`, when finite.
### :throws: {NumericOverflowError} if `me` is ±infinity or NaN.
routine B16.finite!() -> B16
  if not me.is_finite()
    throw NumericOverflowError(description: f"B16 value is non-finite: {me}")
  return me

### Returns the negated value.
### :returns: The resulting `B16` value.
routine B16.neg() -> B16
  return LLVM::float_neg[B16](me)

# Unchecked variants — raw IEEE 754 propagation (the float analog of integer `+%`/`+^`). Plain
# (NOT `dangerous`): inf/NaN are valid IEEE values, the `_unchecked` spelling is the marker.

### Returns `me / you` with raw IEEE 754 semantics: `x/0` -> ±infinity, `0/0` -> NaN. No crash.
routine B16.truediv_unchecked(you: B16) -> B16
  return LLVM::float_div[B16](a: me, b: you)

### Returns `me + you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine B16.add_unchecked(you: B16) -> B16
  return LLVM::float_add[B16](a: me, b: you)

### Returns `me - you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine B16.sub_unchecked(you: B16) -> B16
  return LLVM::float_sub[B16](a: me, b: you)

### Returns `me * you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine B16.mul_unchecked(you: B16) -> B16
  return LLVM::float_mul[B16](a: me, b: you)

# ============================================================================
# Comparison Operations (ordered - false if NaN)
# ============================================================================

### Returns whether both values are equal.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
routine B16.eq(you: B16) -> Bool
  return LLVM::float_eq[B16](a: me, b: you)

### Compares this value with the other value.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
routine B16.cmp(you: B16) -> ComparisonSign
  if LLVM::float_lt[B16](a: me, b: you)
    return ME_SMALL
  if LLVM::float_gt[B16](a: me, b: you)
    return ME_LARGE
  return SAME

# ============================================================================
# Math Operations using intrinsics
# ============================================================================

### Returns the square root of this value in half precision.
### :returns: The intrinsic square-root result for `me`.
routine B16.sqrt!() -> B16
  var rr = me.sqrt_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Square root with raw IEEE 754 propagation (`sqrt(<0)` -> NaN). Thin wrapper over LLVM `sqrt`.
routine B16.sqrt_unchecked() -> B16
  return LLVM::sqrt[B16](me)

### Returns the absolute value.
### :returns: The resulting `B16` value.
routine B16.abs() -> B16
  return LLVM::float_abs[B16](me)

### Rounds this value toward negative infinity.
### :returns: The greatest integral-valued `B16` not larger than `me`.
routine B16.floor() -> B16
  return LLVM::floor[B16](me)

### Rounds this value toward positive infinity.
### :returns: The smallest integral-valued `B16` not smaller than `me`.
routine B16.ceil() -> B16
  return LLVM::ceil[B16](me)

### Rounds this value to the nearest integral-valued `B16`.
### :returns: The rounded result in half precision.
routine B16.round() -> B16
  return LLVM::round[B16](me)

### Discards the fractional part of this value toward zero.
### :returns: The truncated result in half precision.
routine B16.int_truncate() -> B16
  return LLVM::float_truncate[B16](me)

### Returns this value with its sign bit replaced by the sign of `sign`.
### :param sign: The value supplying the sign bit.
### :returns: A value with the magnitude of `me` and the sign of `sign`.
routine B16.copysign(sign: B16) -> B16
  return LLVM::copysign[B16](me, sign)

# ============================================================================
# Convenience (recip / angle conversion / integer power / midpoint)
# ============================================================================

### Returns the reciprocal `1 / me` (`±∞` for `±0`, following IEEE rules).
### :returns: The multiplicative inverse.
routine B16.recip() -> B16
  return B16_ONE.truediv_unchecked(me)

### Returns `me` converted from radians to degrees (`me × 180 / π`).
### :returns: The angle in degrees.
routine B16.to_degrees() -> B16
  return me.mul_unchecked(180.0_b16).truediv_unchecked(B16_PI)

### Returns `me` converted from degrees to radians (`me × π / 180`).
### :returns: The angle in radians.
routine B16.to_radians() -> B16
  return me.mul_unchecked(B16_PI).truediv_unchecked(180.0_b16)

### Returns `me` raised to the integer power `n` via exponentiation by squaring.
### A negative `n` inverts the result. Exact for small exponents, unlike `pow` with a float exponent.
### :param n: The integer exponent.
### :returns: `me ** n`.
routine B16.powi(n: S32) -> B16
  var base = if n < 0_s32 then B16_ONE.truediv_unchecked(me) else me
  var count = n.unsigned_abs()
  var result = B16_ONE
  while count > 0_u32
    if count.bitand(1_u32) == 1_u32
      result = result.mul_unchecked(base)
    base = base.mul_unchecked(base)
    count = count.lshr(1_u32)
  return result

### Returns `(me + you) / 2`, computed without intermediate overflow.
### :param you: The other value.
### :returns: The arithmetic midpoint of `me` and `you`.
routine B16.midpoint(you: B16) -> B16
  var lo = B16_MIN_POSITIVE.mul_unchecked(2.0_b16)
  var hi = B16_MAX.truediv_unchecked(2.0_b16)
  var aa = me.abs()
  var ab = you.abs()
  if aa <= hi and ab <= hi
    return me.add_unchecked(you).truediv_unchecked(2.0_b16)
  if aa < lo
    return me.add_unchecked(you.truediv_unchecked(2.0_b16))
  if ab < lo
    return me.truediv_unchecked(2.0_b16).add_unchecked(you)
  return me.truediv_unchecked(2.0_b16).add_unchecked(you.truediv_unchecked(2.0_b16))

# ============================================================================
# Utility Methods
# ============================================================================

### Returns the smaller of this value and `you`.
### :param you: The value to compare against.
### :returns: The lower of the two values under the ordered comparison rules.
routine B16.min(you: B16) -> B16
  return if me <= you then me else you

### Returns the larger of this value and `you`.
### :param you: The value to compare against.
### :returns: The greater of the two values under the ordered comparison rules.
routine B16.max(you: B16) -> B16
  return if me >= you then me else you

### Restricts this value to the closed interval `[min_val, max_val]`.
### :param min_val: The lower bound to enforce.
### :param max_val: The upper bound to enforce.
### :returns: `me` if already in range, otherwise the nearest bound.
@positional
routine B16.clamp(min_val: B16, max_val: B16) -> B16
  return me.min(max_val).max(min_val)

### Returns `true` if this value is strictly positive (greater than zero).
### :returns: `true` if `me > 0.0`.
routine B16.is_positive() -> Bool
  return me > 0.0_b16

### Returns `true` if this value is strictly negative (less than zero).
### :returns: `true` if `me < 0.0`.
routine B16.is_negative() -> Bool
  return me < 0.0_b16

### Returns `true` if this value compares equal to zero.
### :returns: `true` if `me == 0.0`.
routine B16.is_zero() -> Bool
  return me == 0.0_b16

### Returns `true` when this value encodes an IEEE 754 NaN.
### :returns: Whether the bit pattern represents a not-a-number payload.
routine B16.is_nan() -> Bool
  var bits = me.to_bits()
  var exponent = LLVM::bit_and(a: bits, b: 0x7C00_u16)
  var mantissa = LLVM::bit_and(a: bits, b: 0x03FF_u16)
  return exponent == 0x7C00_u16 and mantissa != 0_u16

### True when this is a SIGNALING NaN (quiet bit clear). Arithmetic only makes quiet NaN.
routine B16.is_signaling() -> Bool
  return me.is_nan() and LLVM::bit_and(a: me.to_bits(), b: 0x0200_u16) == 0_u16

### Returns `true` when this value encodes positive or negative infinity.
### :returns: Whether the bit pattern represents an infinity.
routine B16.is_infinite() -> Bool
  var bits = me.to_bits()
  var exponent = LLVM::bit_and(a: bits, b: 0x7C00_u16)
  var mantissa = LLVM::bit_and(a: bits, b: 0x03FF_u16)
  return exponent == 0x7C00_u16 and mantissa == 0_u16

### Returns `true` when this value is neither NaN nor infinity.
### :returns: Whether the value is finite.
routine B16.is_finite() -> Bool
  return not me.is_nan() and not me.is_infinite()

### Returns the sign of this value as `-1.0`, `0.0`, or `1.0`.
### :returns: A unit-sign value describing the sign of `me`.
routine B16.signum() -> B16
  return when
    me > 0.0_b16 => 1.0_b16
    me < 0.0_b16 => -1.0_b16
    else => 0.0_b16

# ============================================================================
# Type Conversions
# ============================================================================

### Reinterprets this float as its raw IEEE 754 bit pattern.
### :returns: The underlying `U16` encoding of this value.
routine B16.to_bits() -> U16
  return LLVM::reinterpret_bits[B16, U16](me)

### Reinterprets a raw IEEE 754 bit pattern as an `B16`.
### :param bits: The exact half-precision encoding to decode.
### :returns: The `B16` value with that bit pattern.
common routine B16.from_bits(bits: U16) -> B16
  return LLVM::reinterpret_bits[U16, B16](bits)

### Returns a signaling NaN (interop/testing; never produced by arithmetic).
common routine B16.signaling_nan() -> B16
  return B16.from_bits(bits: 0x7C01_u16)

# ============================================================================
# Text Representation and Parsing
# ============================================================================

### Returns the shortest decimal text that reads back as this exact value (`B16!(from_text:)`
### round-trips it bit for bit).
### :returns: The resulting `Text` value.
@override
routine B16.represent() -> Text
  if me.is_signaling()
    return "snan"
  return format_binary_shortest(raw: LLVM::zero_extend[U16, U64](me.to_bits()), fmt: 2_s32)

### Renders this value to `sig_digits` significant decimal digits with C `%g`
### layout (pure-RF exact-rational conversion; widens to B64 exactly first).
### :param sig_digits: The number of significant decimal digits (>= 1).
### :returns: The resulting `Text` value.
routine B16.to_text(sig_digits: U64) -> Text
  return format_binary(value: B64(from: B32(from: me)), sig: sig_digits)

### Renders this value with exactly `places` digits after the point, rounded half to even from its
### exact value (`2.675.fixed(2)` is `2.67`, since the stored double is just below 2.675). The integer
### part is always written out in full, never in exponent form.
### :param places: The number of digits after the point (0 for none).
### :returns: The rendered `Text`.
@readonly
routine B16.fixed(places: U64) -> Text
  return format_binary_fixed(value: B64(from: B32(from: me)), places: places)

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@override
routine B16.diagnose() -> Text
  return "B16(" + me.represent() + ")"

### Implements the wired routine behavior for this value.
### :param from_text: The `from_text` value.
### :returns: The resulting `B16` value.
### :throws: May throw {InvalidValueError}.
routine B16!(from_text: Text) -> B16
  var pc = parse_float_components(from_text: from_text, target: "B16")
  if pc.kind == 3_s32
    throw InvalidValueError(input: from_text, target: "B16")
  if pc.kind == 1_s32
    return B16_NAN
  if pc.kind == 2_s32
    if pc.is_neg
      return -B16_INFINITY
    return B16_INFINITY
  return b16_from_ratio(neg: pc.is_neg, digits: pc.digits, dec_exp: pc.dec_exp)

# ============================================================================
# Hashing
# ============================================================================

# ============================================================================
# Byte Representation
# ============================================================================

### Returns the raw bytes of this value in little-endian order.
### :returns: The resulting `Array[Byte, 2]` value.
routine B16.to_bytes_le() -> Array[Byte, 2]
  var raw = LLVM::reinterpret_bits[B16, U16](me)
  var result = Array[Byte, 2]()
  result = LLVM::set_byte_at(array: result, index: 0u64, value: LLVM::int_truncate[U16, U8](raw))
  result = LLVM::set_byte_at(array: result, index: 1_u64, value: LLVM::int_truncate[U16, U8](LLVM::shift_right_unsigned(raw, 8_u16)))
  return result

### Returns the raw bytes of this value in big-endian order.
### :returns: The resulting `Array[Byte, 2]` value.
routine B16.to_bytes_be() -> Array[Byte, 2]
  var raw = LLVM::byte_swap(LLVM::reinterpret_bits[B16, U16](me))
  var result = Array[Byte, 2]()
  result = LLVM::set_byte_at(array: result, index: 0u64, value: LLVM::int_truncate[U16, U8](raw))
  result = LLVM::set_byte_at(array: result, index: 1_u64, value: LLVM::int_truncate[U16, U8](LLVM::shift_right_unsigned(raw, 8_u16)))
  return result

### Returns a keyed hash of this value using SipHash-2-4.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: The resulting `U64` value.
routine B16.hash(k0: U64, k1: U64) -> U64
  return __secure_hash_u64(v: LLVM::zero_extend[U16, U64](LLVM::reinterpret_bits[B16, U16](me)), k0: k0, k1: k1)

# ============================================================================
# Full libm parity — RF-native via the B32 path (no b16_functions.c runtime).
# Each B16 transcendental widens EXACTLY to B32 (LLVM `fpext`), evaluates in
# B32, then narrows back with a single rounding (LLVM `fptrunc`). This is the
# same "compute in b32, re-narrow" contract the old uint16-ABI runtime provided,
# but expressed in RF over B32's own routines — so the C half-precision shims are
# gone. `nextafter` is the one exception (it must step the 16-bit pattern
# directly, since a B32 step would narrow back to the same B16 value).
# ============================================================================

### Arc sine.
routine B16.asin!() -> B16
  var rr = me.asin_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Arc cosine.
routine B16.acos!() -> B16
  var rr = me.acos_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Hyperbolic sine.
routine B16.sinh!() -> B16
  var rr = me.sinh_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Hyperbolic cosine.
routine B16.cosh!() -> B16
  var rr = me.cosh_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Inverse hyperbolic cosine.
routine B16.acosh!() -> B16
  var rr = me.acosh_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Inverse hyperbolic tangent.
routine B16.atanh!() -> B16
  var rr = me.atanh_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Natural exponential.
routine B16.exp!() -> B16
  var rr = me.exp_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Base-2 exponential.
routine B16.exp2!() -> B16
  var rr = me.exp2_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### exp(me) - 1, accurate near zero.
routine B16.expm1!() -> B16
  var rr = me.expm1_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Base-10 exponential.
routine B16.exp10!() -> B16
  var rr = me.exp10_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Natural logarithm.
routine B16.log!() -> B16
  var rr = me.log_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Base-2 logarithm.
routine B16.log2!() -> B16
  var rr = me.log2_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Base-10 logarithm.
routine B16.log10!() -> B16
  var rr = me.log10_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### log(1 + me), accurate near zero.
routine B16.log1p!() -> B16
  var rr = me.log1p_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raises this value to `exp`, checked: crashes on a non-finite result (overflow -> inf, domain ->
### NaN). Use `pow_unchecked` for raw IEEE 754 propagation.
### :param exp: The exponent applied to `me`.
### :returns: `me` raised to `exp` (always finite).
routine B16.pow!(exp: B16) -> B16
  var rr = me.pow_unchecked(exp: exp)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Hypotenuse without overflow.
### :param x: One leg.
### :param y: The other leg.
routine hypot!(x: B16, y: B16) -> B16
  var rr = hypot_unchecked(x: x, y: y)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### 3D hypotenuse sqrt(x^2 + y^2 + z^2) without overflow. Checked: crashes on overflow.
### :param x: First leg.
### :param y: Second leg.
### :param z: Third leg.
routine hypot!(x: B16, y: B16, z: B16) -> B16
  var rr = hypot_unchecked(x: x, y: y, z: z)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### 3D hypotenuse with raw IEEE 754 propagation (overflow -> +inf). Composed as
### `hypot(hypot(x, y), z)` — overflow-safe, libm has no 3-arg hypot.
### :param x: First leg.
### :param y: Second leg.
### :param z: Third leg.
routine hypot_unchecked(x: B16, y: B16, z: B16) -> B16
  return hypot_unchecked(x: hypot_unchecked(x: x, y: y), y: z)

### Fused multiply-add me*b + c with a single rounding.
routine B16.fma!(b: B16, c: B16) -> B16
  var rr = me.fma_unchecked(b: b, c: c)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Fused multiply-add me*b + c with raw IEEE 754 propagation, correctly rounded (one rounding to
### nearest, ties to even).
routine B16.fma_unchecked(b: B16, c: B16) -> B16
  # me*b has at most 22 significant bits, so it is exact in binary64 and p + c is the only inexact step.
  # TwoSum recovers that step's error exactly, which turns the binary64 sum into a round-to-odd result.
  # Rounding it to nearest binary16 is then a single correct rounding (going through binary32 instead
  # would round twice and miss ties).
  var p = B64(from: me) *! B64(from: b)
  var cd = B64(from: c)
  var s = p +! cd
  if s.is_finite()
    var bv = s -! p
    var err = (p -! (s -! bv)) +! (cd -! bv)
    var sb = s.to_bits()
    if err != 0.0 and sb & 1_u64 == 0
      # step one ulp toward the exact sum, the truncated value, whose last bit is odd
      if (err > 0.0) == (s > 0.0)
        sb = sb +% 1
      else
        sb = sb -% 1
      s = B64.from_bits(bits: sb)
  return b16_narrow_b64(d: s)

### Floating-point remainder (C fmod).
routine B16.fmod(you: B16) -> B16
  return B16(from: B32(from: me).fmod(you: B32(from: you)))

### IEEE remainder (C remainder).
routine B16.remainder(you: B16) -> B16
  return B16(from: B32(from: me).remainder(you: B32(from: you)))

### Positive difference max(me - you, 0) (C fdim).
routine B16.fdim(you: B16) -> B16
  return B16(from: B32(from: me).fdim(you: B32(from: you)))

### Larger of me and you (C fmax).
routine B16.fmax(you: B16) -> B16
  return B16(from: B32(from: me).fmax(you: B32(from: you)))

### Smaller of me and you (C fmin).
routine B16.fmin(you: B16) -> B16
  return B16(from: B32(from: me).fmin(you: B32(from: you)))

### Next representable value after me toward you. Steps the 16-bit sign-magnitude
### pattern directly (a B32 step would narrow back to the same B16 value).
routine B16.nextafter(you: B16) -> B16
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  if me == you
    return you
  var bits = me.to_bits()
  var mag = LLVM::bit_and(a: bits, b: 0x7FFF_u16)
  var sgn = LLVM::bit_and(a: bits, b: 0x8000_u16)
  if mag == 0_u16
    # me is ±0 (and me != you): step to the smallest subnormal toward you.
    return if you.is_positive() then B16.from_bits(bits: 0x0001_u16) else B16.from_bits(bits: 0x8001_u16)
  var larger_mag = (me.is_positive() and you > me) or (me.is_negative() and you < me)
  var next_mag = if larger_mag then LLVM::add(a: mag, b: 1_u16) else LLVM::sub(a: mag, b: 1_u16)
  return B16.from_bits(bits: LLVM::bit_or(a: sgn, b: next_mag))

### me * 2^n (C scalbn).
routine B16.scalbn(n: S64) -> B16
  return B16(from: B32(from: me).scalbn(n: n))

### Alias of scalbn (C ldexp).
routine B16.ldexp(n: S64) -> B16
  return B16(from: B32(from: me).scalbn(n: n))

### Rounds to nearest integer in the current rounding mode (C rint).
routine B16.rint() -> B16
  return B16(from: B32(from: me).rint())

### Gamma function.
routine B16.tgamma!() -> B16
  var rr = me.tgamma_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Truncates toward zero (alias of int_truncate).
routine B16.trunc() -> B16
  return LLVM::float_truncate[B16](me)

### Fractional part me - trunc(me).
routine B16.frac() -> B16
  return me - LLVM::float_truncate[B16](me)

### Integer and fractional parts (C modf); both carry the sign of me.
routine B16.modf() -> (B16, B16)
  var ip = LLVM::float_truncate[B16](me)
  return (ip, me - ip)

### Fraction in [0.5,1) and power-of-two exponent (C frexp).
routine B16.frexp() -> (B16, S64)
  if me.is_zero() or me.is_infinite() or me.is_nan()
    return (me, 0_s64)
  var e = LLVM::add(a: C::rf_b32_ilogb(value: B32(from: me)), b: 1_s64)
  return (me.scalbn(n: LLVM::sub(a: 0_s64, b: e)), e)

### True if the sign bit is set (C signbit).
routine B16.signbit() -> Bool
  return LLVM::int_ne(a: LLVM::bit_and(a: me.to_bits(), b: 0x8000_u16), b: 0_u16)

### True for a subnormal (denormalized, nonzero) value.
routine B16.is_subnormal() -> Bool
  var bits = me.to_bits()
  var exponent = LLVM::bit_and(a: bits, b: 0x7C00_u16)
  var mantissa = LLVM::bit_and(a: bits, b: 0x03FF_u16)
  return exponent == 0_u16 and mantissa != 0_u16

### True for a finite, normal value (nonzero and not subnormal).
routine B16.is_normal() -> Bool
  return me.is_finite() and not me.is_zero() and not me.is_subnormal()

### C fpclassify: 0 NaN, 1 infinite, 2 zero, 3 subnormal, 4 normal.
routine B16.fpclassify() -> FpClass
  if me.is_signaling()
    return SIGNALING_NAN
  if me.is_nan()
    return NAN
  if me.is_infinite()
    return INFINITE
  if me.is_zero()
    return ZERO
  if me.is_subnormal()
    return SUBNORMAL
  return NORMAL

# ============================================================================
# IEEE 754 Tier 1 — total ordering predicates
# ============================================================================

### Sign-magnitude total-order key: negatives become small, non-negatives large, so an
### unsigned `<=` reproduces the IEEE 754 totalOrder ranking (-NaN < -inf < ... < +inf < +NaN).
routine b16_order_key(bits: U16) -> U16
  if LLVM::int_ne(a: LLVM::bit_and(a: bits, b: 0x8000_u16), b: 0_u16)
    return LLVM::bit_xor(a: bits, b: 0xFFFF_u16)
  return LLVM::bit_or(a: bits, b: 0x8000_u16)

### IEEE 754 totalOrder: a total order over all values including signed zeros and NaNs
### (-NaN < -inf < negatives < -0 < +0 < positives < +inf < +NaN). Never crashes.
### :param you: The value to compare against.
### :returns: Whether `me` precedes or equals `you` in the total order.
routine B16.total_order(you: B16) -> Bool
  return b16_order_key(bits: me.to_bits()) <= b16_order_key(bits: you.to_bits())

### IEEE 754 totalOrderMag: `total_order` applied to the magnitudes (sign bit cleared).
### :param you: The value whose magnitude to compare against.
### :returns: Whether `|me|` precedes or equals `|you|` in the total order.
routine B16.total_order_mag(you: B16) -> Bool
  return LLVM::bit_and(a: me.to_bits(), b: 0x7FFF_u16) <= LLVM::bit_and(a: you.to_bits(), b: 0x7FFF_u16)

# ============================================================================
# IEEE 754 Tier 2 — stepping, exponent extraction, scaling, selection, rounding
# ============================================================================

### IEEE 754 nextUp: the least value greater than `me`. Propagating; never crashes.
### :returns: The next representable value toward +infinity.
routine B16.next_up() -> B16
  return me.nextafter(you: B16_INFINITY)

### IEEE 754 nextDown: the greatest value less than `me`. Never crashes.
### :returns: The next representable value toward -infinity.
routine B16.next_down() -> B16
  return me.nextafter(you: -B16_INFINITY)

### IEEE 754 logb: the unbiased exponent of `me` as a floating value (logb(0)=-inf,
### logb(±inf)=+inf, logb(NaN)=NaN). Propagating; never crashes.
### :returns: The radix-2 exponent of `me`.
routine B16.logb() -> B16
  if me.is_nan()
    return me
  if me.is_infinite()
    return B16_INFINITY
  if me.is_zero()
    return -B16_INFINITY
  return B16(from: C::rf_b32_ilogb(value: B32(from: me)))

### IEEE 754 scaleB: `me * 2^n`. Checked: crashes if a finite `me` overflows to ±infinity.
### :param n: The power-of-two exponent to apply.
### :returns: `me` scaled by `2^n`.
routine B16.scaleb!(n: S64) -> B16
  var r = me.scalbn(n: n)
  if r.is_finite() or not me.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me * 2^n` with raw IEEE 754 propagation (overflow -> ±infinity).
### :param n: The power-of-two exponent to apply.
### :returns: `me` scaled by `2^n`.
routine B16.scaleb_unchecked(n: S64) -> B16
  return me.scalbn(n: n)

### IEEE 754-2008 minNum: the smaller operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, ignoring NaN.
routine B16.min_num(you: B16) -> B16
  return me.fmin(you: you)

### IEEE 754-2008 maxNum: the larger operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, ignoring NaN.
routine B16.max_num(you: B16) -> B16
  return me.fmax(you: you)

### IEEE 754-2019 minimum: the smaller operand, propagating NaN, ordering -0 below +0.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, NaN if either is NaN.
routine B16.minimum(you: B16) -> B16
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  if me == you
    if me.is_zero()
      return if me.signbit() then me else you
    return me
  return if me < you then me else you

### IEEE 754-2019 maximum: the larger operand, propagating NaN, ordering +0 above -0.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, NaN if either is NaN.
routine B16.maximum(you: B16) -> B16
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  if me == you
    if me.is_zero()
      return if me.signbit() then you else me
    return me
  return if me > you then me else you

### IEEE 754 roundToIntegralTiesToAway: rounds to nearest integer, halves away from zero.
### :returns: `me` rounded to an integral value with ties away from zero.
routine B16.round_ties_away() -> B16
  if not me.is_finite()
    return me
  var a = me.abs()
  var t = a.trunc()
  var rounded = if a - t >= 0.5_b16 then t + 1.0_b16 else t
  return rounded.copysign(sign: me)
