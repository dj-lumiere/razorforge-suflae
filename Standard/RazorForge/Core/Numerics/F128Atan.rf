### atan(k/32) for k in 1..32 (k<=0 -> +0), W-dispatched limb-table index accessor.
common routine UnpackedFloat[M, L, W].atan_tab(k: S64) -> UnpackedFloat[M, L, W]
  if LLVM::signed_le(a: k, b: 0_s64)
    return UnpackedFloat[M, L, W].zero(sign: false)
  var ck = k
  if LLVM::signed_gt(a: ck, b: 32_s64)
    ck = 32_s64
  var ui = LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: ck, b: 1_s64))
  if LLVM::int_eq[U64](a: W, b: 128_u64)
    var p = LLVM::mul(a: ui, b: 2_u64)
    return UnpackedFloat[M, L, W].make(mant: M.from_words2(h1: ATAN_TAB_QUAD_MANT[LLVM::add(a: p, b: 1_u64)], h0: ATAN_TAB_QUAD_MANT[p]), exp: ATAN_TAB_QUAD_EXP[ui], fpclass: POSITIVE_NORMAL)
  if LLVM::int_eq[U64](a: W, b: 192_u64)
    var p = LLVM::mul(a: ui, b: 3_u64)
    return UnpackedFloat[M, L, W].make(mant: M.from_words3(h2: ATAN_TAB_F192_MANT[LLVM::add(a: p, b: 2_u64)], h1: ATAN_TAB_F192_MANT[LLVM::add(a: p, b: 1_u64)], h0: ATAN_TAB_F192_MANT[p]), exp: ATAN_TAB_F192_EXP[ui], fpclass: POSITIVE_NORMAL)
  if LLVM::int_eq[U64](a: W, b: 512_u64)
    var p = LLVM::mul(a: ui, b: 8_u64)
    return UnpackedFloat[M, L, W].make(mant: M.from_words8(h7: ATAN_TAB_DEC_MANT[LLVM::add(a: p, b: 7_u64)], h6: ATAN_TAB_DEC_MANT[LLVM::add(a: p, b: 6_u64)], h5: ATAN_TAB_DEC_MANT[LLVM::add(a: p, b: 5_u64)], h4: ATAN_TAB_DEC_MANT[LLVM::add(a: p, b: 4_u64)], h3: ATAN_TAB_DEC_MANT[LLVM::add(a: p, b: 3_u64)], h2: ATAN_TAB_DEC_MANT[LLVM::add(a: p, b: 2_u64)], h1: ATAN_TAB_DEC_MANT[LLVM::add(a: p, b: 1_u64)], h0: ATAN_TAB_DEC_MANT[p]), exp: ATAN_TAB_DEC_EXP[ui], fpclass: POSITIVE_NORMAL)
  if LLVM::int_eq[U64](a: W, b: 384_u64)
    var p = LLVM::mul(a: ui, b: 6_u64)
    return UnpackedFloat[M, L, W].make(mant: M.from_words6(h5: ATAN_TAB_F384_MANT[LLVM::add(a: p, b: 5_u64)], h4: ATAN_TAB_F384_MANT[LLVM::add(a: p, b: 4_u64)], h3: ATAN_TAB_F384_MANT[LLVM::add(a: p, b: 3_u64)], h2: ATAN_TAB_F384_MANT[LLVM::add(a: p, b: 2_u64)], h1: ATAN_TAB_F384_MANT[LLVM::add(a: p, b: 1_u64)], h0: ATAN_TAB_F384_MANT[p]), exp: ATAN_TAB_F384_EXP[ui], fpclass: POSITIVE_NORMAL)
  if LLVM::int_eq[U64](a: W, b: 320_u64)
    var p = LLVM::mul(a: ui, b: 5_u64)
    return UnpackedFloat[M, L, W].make(mant: M.from_words5(h4: ATAN_TAB_B320_MANT[LLVM::add(a: p, b: 4_u64)], h3: ATAN_TAB_B320_MANT[LLVM::add(a: p, b: 3_u64)], h2: ATAN_TAB_B320_MANT[LLVM::add(a: p, b: 2_u64)], h1: ATAN_TAB_B320_MANT[LLVM::add(a: p, b: 1_u64)], h0: ATAN_TAB_B320_MANT[p]), exp: ATAN_TAB_B320_EXP[ui], fpclass: POSITIVE_NORMAL)
