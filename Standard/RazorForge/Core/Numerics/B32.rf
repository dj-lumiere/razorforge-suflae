routine B32.sinh!() -> B32
  var rr = me.sinh_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Hyperbolic sine with raw IEEE 754 propagation (overflow -> ±inf). Wraps `rf_b32_sinh`.
routine B32.sinh_unchecked() -> B32
  return LLVM::sinh[B32](value: me)

