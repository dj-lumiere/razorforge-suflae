### Tangent (radians).
routine B32.tan() -> B32
  return LLVM::tan[B32](value: me)

### Arc sine.
routine B32.asin!() -> B32
  var rr = me.asin_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Arc sine with raw IEEE 754 propagation (`|me| > 1` -> NaN). Thin wrapper over `rf_b32_asin`.
routine B32.asin_unchecked() -> B32
  return LLVM::asin[B32](value: me)

### Arc cosine.
routine B32.acos!() -> B32
  var rr = me.acos_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Arc cosine with raw IEEE 754 propagation (`|me| > 1` -> NaN). Thin wrapper over `rf_b32_acos`.
routine B32.acos_unchecked() -> B32
  return LLVM::acos[B32](value: me)

### Arc tangent.
routine B32.atan() -> B32
  return LLVM::atan[B32](value: me)

### Two-argument arc tangent atan2(y, x).
### :param y: The y-coordinate.
### :param x: The x-coordinate.
routine atan2(y: B32, x: B32) -> B32
  return LLVM::atan2[B32](a: y, b: x)

