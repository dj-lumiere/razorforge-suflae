module Core

import Collections

# CREDITS: the BID (Binary-Integer-Decimal) encoding, rounding, and exponent rules of
# this decimal32 engine are a port and extension of Intel's Decimal Floating-Point
# Math Library ("libbid", © Intel Corporation, BSD 3-Clause). See THIRD-PARTY-NOTICES.md.


# ============================================================================
# D32 — software IEEE 754-2008 decimal32 (BID), native arithmetic at U64 working
# width (7+7=14-digit products fit U64). Real BID32 storage: Form 1 (coeff < 2^23),
# Form 2 (large coeff, implicit 2^23), plus inf/NaN via the combination prefix.
#
# Pmax=7, Emax=96, Emin=-95, bias=101, stored exponent q in [-101, 90].
# Decodes to a narrow U64-coefficient D32Parts so the hot path never widens past U64;
# converts to D128Parts only for the cold special-value / formatter paths.
# ============================================================================


### A software decimal32 value in BID storage.
@llvm("i32")
record D32 obeys Numeric, Ordered
  pass

### Narrow decoded fields (U64 coefficient — decimal32 has <= 7 digits).
record D32Parts
  sign: Bool
  special: U64
  exp: S64
  coeff: U64

### Widen to D128Parts for the shared special-value rules / decimal formatter.
routine d32parts_to_d128(p: D32Parts) -> D128Parts
  return D128Parts(sign: p.sign, special: p.special, exp: p.exp, coeff: zero_extend[U64, U128](p.coeff))

### Narrow a D128Parts back (special-rule results are inf/NaN/zero, coeff 0 — lossless).
routine d128_to_d32parts(p: D128Parts) -> D32Parts
  return D32Parts(sign: p.sign, special: p.special, exp: p.exp, coeff: int_truncate[U128, U64](p.coeff))

### 10^k as a U64 (k <= 19), via the U256 pow10 table truncated.
routine p10_u64(k: S64) -> U64
  return int_truncate[U256, U64](pow10_tbl(k: k))

### Decimal digit count of a U64 (0 has 1 digit) via clz + one correction compare.
routine digits10_u64(c: U64) -> S64
  if int_eq[U64](a: c, b: 0_u64)
    return 1_s64
  var nbits = sub[S64](a: 64_s64, b: reinterpret_bits[U64, S64](leading_zeros[U64](c)))
  var d = add[S64](a: signed_div[S64](a: mul[S64](a: nbits, b: 1233_s64), b: 4096_s64), b: 1_s64)
  if signed_ge[S64](a: d, b: 1_s64) and unsigned_lt[U64](a: c, b: p10_u64(k: sub[S64](a: d, b: 1_s64)))
    return sub[S64](a: d, b: 1_s64)
  if signed_le[S64](a: d, b: 19_s64) and unsigned_ge[U64](a: c, b: p10_u64(k: d))
    return add[S64](a: d, b: 1_s64)
  return d

# ---- raw bits ----
routine D32.to_bits() -> U32
  return reinterpret_bits[D32, U32](me)

common routine D32.from_bits(bits: U32) -> D32
  return reinterpret_bits[U32, D32](bits)

### BID32 decode -> narrow parts.
routine D32.decode() -> D32Parts
  var bits = me.to_bits()
  var sign = int_ne[U32](a: bit_and[U32](a: bits, b: shift_left[U32](value: 1_u32, bits: 31_u32)), b: 0_u32)
  var top5 = zero_extend[U32, U64](bit_and[U32](a: shift_right_unsigned[U32](bits, 26_u32), b: 0x1F_u32))
  if int_eq[U64](a: top5, b: 0x1E_u64)
    return D32Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: 0_u64)
  if int_eq[U64](a: top5, b: 0x1F_u64)
    var sp = 2_u64
    if int_ne[U32](a: bit_and[U32](a: shift_right_unsigned[U32](bits, 25_u32), b: 1_u32), b: 0_u32)
      sp = 3_u64
    return D32Parts(sign: sign, special: sp, exp: 0_s64, coeff: 0_u64)
  var biased = 0_u64
  var c32 = 0_u32
  if int_eq[U64](a: shift_right_unsigned[U64](top5, 3_u64), b: 3_u64)
    # Form 2: exp bits 28:21, coeff = (bits 20:0) | 2^23
    biased = zero_extend[U32, U64](bit_and[U32](a: shift_right_unsigned[U32](bits, 21_u32), b: 0xFF_u32))
    c32 = bit_or[U32](a: bit_and[U32](a: bits, b: 0x1FFFFF_u32), b: shift_left[U32](value: 1_u32, bits: 23_u32))
  else
    # Form 1: exp bits 30:23, coeff bits 22:0
    biased = zero_extend[U32, U64](bit_and[U32](a: shift_right_unsigned[U32](bits, 23_u32), b: 0xFF_u32))
    c32 = bit_and[U32](a: bits, b: 0x7FFFFF_u32)
  return D32Parts(sign: sign, special: 0_u64, exp: sub[S64](a: reinterpret_bits[U64, S64](biased), b: 101_s64), coeff: zero_extend[U32, U64](c32))

### Narrow parts -> BID32 (Form 1 / Form 2 / special). Finite parts must already be
### rounded to <= 7 digits and in the decimal32 exponent range (decfin32 guarantees this).
routine d32_of_parts(p: D32Parts) -> D32
  var sbit = shift_left[U32](value: if p.sign then 1_u32 else 0_u32, bits: 31_u32)
  if int_ne[U64](a: p.special, b: 0_u64)
    var top5 = if int_eq[U64](a: p.special, b: 1_u64) then 0x1E_u32 else 0x1F_u32
    var bb = bit_or[U32](a: sbit, b: shift_left[U32](value: top5, bits: 26_u32))
    if int_eq[U64](a: p.special, b: 3_u64)
      bb = bit_or[U32](a: bb, b: shift_left[U32](value: 1_u32, bits: 25_u32))
    return D32.from_bits(bits: bb)
  var ebits8 = int_truncate[U64, U32](bit_and[U64](a: add[U64](a: reinterpret_bits[S64, U64](p.exp), b: 101_u64), b: 0xFF_u64))
  var c32 = int_truncate[U64, U32](p.coeff)
  if unsigned_lt[U32](a: c32, b: 0x800000_u32)
    # Form 1: exp bits 30:23, coeff bits 22:0
    return D32.from_bits(bits: bit_or[U32](a: bit_or[U32](a: sbit, b: shift_left[U32](value: ebits8, bits: 23_u32)), b: c32))
  # Form 2: bits 30:29 = 11, exp bits 28:21, coeff low 21 bits (implicit 2^23)
  var g2 = shift_left[U32](value: 0x3_u32, bits: 29_u32)
  var ebits = shift_left[U32](value: ebits8, bits: 21_u32)
  var clow = bit_and[U32](a: c32, b: 0x1FFFFF_u32)
  return D32.from_bits(bits: bit_or[U32](a: bit_or[U32](a: sbit, b: g2), b: bit_or[U32](a: ebits, b: clow)))

### Builds a finite D32 from a signed coefficient and base-10 exponent (rounded/ranged).
common routine D32.from_components(sign: Bool, coeff: U64, exp: S64) -> D32
  return d32_of_parts(p: decfin32(sign: sign, coeff: coeff, exp: exp, pref: exp))

### Builds a D32 from a 64-bit signed integer (exponent 0).
common routine D32.from_int64(value: S64) -> D32
  var neg = signed_lt[S64](a: value, b: 0_s64)
  var mag = if neg then sub[S64](a: 0_s64, b: value) else value
  return D32.from_components(sign: neg, coeff: reinterpret_bits[S64, U64](mag), exp: 0_s64)

### Infinity / quiet NaN.
common routine D32.infinity(sign: Bool) -> D32
  return d32_of_parts(p: D32Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: 0_u64))
common routine D32.quiet_nan() -> D32
  return d32_of_parts(p: D32Parts(sign: false, special: 2_u64, exp: 0_s64, coeff: 0_u64))
### Returns a signaling NaN (interop/testing; never produced by arithmetic).
common routine D32.signaling_nan() -> D32
  return d32_of_parts(p: D32Parts(sign: false, special: 3_u64, exp: 0_s64, coeff: 0_u64))

routine D32.is_finite() -> Bool
  return int_eq[U64](a: me.decode().special, b: 0_u64)
routine D32.is_infinite() -> Bool
  return int_eq[U64](a: me.decode().special, b: 1_u64)
routine D32.is_nan() -> Bool
  return unsigned_ge[U64](a: me.decode().special, b: 2_u64)

### True when this is a SIGNALING NaN (special field == 3).
routine D32.is_signaling() -> Bool
  return int_eq[U64](a: me.decode().special, b: 3_u64)

### True when this is a finite zero (±0).
routine D32.is_zero() -> Bool
  var p = me.decode()
  return int_eq[U64](a: p.special, b: 0_u64) and int_eq[U64](a: p.coeff, b: 0_u64)

# ============================================================================
# Finalize: round to Pmax=7, clamp exponent to [-101, 90] (overflow -> inf,
# underflow -> round-off / zero), then strip/pad toward the preferred exponent.
# ============================================================================
routine decfin32(sign: Bool, coeff: U64, exp: S64, pref: S64) -> D32Parts
  if int_eq[U64](a: coeff, b: 0_u64)
    var ez = pref
    if signed_lt[S64](a: ez, b: -101_s64)
      ez = -101_s64
    if signed_gt[S64](a: ez, b: 90_s64)
      ez = 90_s64
    return D32Parts(sign: sign, special: 0_u64, exp: ez, coeff: 0_u64)
  var c = coeff
  var e = exp
  var nd = digits10_u64(c: c)
  if signed_gt[S64](a: nd, b: 7_s64)
    var drop = sub[S64](a: nd, b: 7_s64)
    var divv = p10_u64(k: drop)
    var q = div_pow10_u64(x: c, k: drop)
    var r = sub[U64](a: c, b: mul[U64](a: q, b: divv))
    var twice = mul[U64](a: r, b: 2_u64)
    if unsigned_gt[U64](a: twice, b: divv)
      q = add[U64](a: q, b: 1_u64)
    elseif int_eq[U64](a: twice, b: divv) and int_ne[U64](a: bit_and[U64](a: q, b: 1_u64), b: 0_u64)
      q = add[U64](a: q, b: 1_u64)
    c = q
    e = add[S64](a: e, b: drop)
    if unsigned_ge[U64](a: c, b: p10_u64(k: 7_s64))
      c = div_pow10_u64(x: c, k: 1_s64)
      e = add[S64](a: e, b: 1_s64)
  # overflow: pad coefficient (lowering e) up to 7 digits, then saturate to inf
  while signed_gt[S64](a: e, b: 90_s64) and unsigned_lt[U64](a: c, b: p10_u64(k: 6_s64))
    c = mul[U64](a: c, b: 10_u64)
    e = sub[S64](a: e, b: 1_s64)
  if signed_gt[S64](a: e, b: 90_s64)
    return D32Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: 0_u64)
  # underflow: round off low digits (subnormal) until e reaches the minimum
  while signed_lt[S64](a: e, b: -101_s64) and int_ne[U64](a: c, b: 0_u64)
    var rd = unsigned_rem[U64](a: c, b: 10_u64)
    c = unsigned_div[U64](a: c, b: 10_u64)
    e = add[S64](a: e, b: 1_s64)
    if unsigned_gt[U64](a: rd, b: 5_u64) or (int_eq[U64](a: rd, b: 5_u64) and int_ne[U64](a: bit_and[U64](a: c, b: 1_u64), b: 0_u64))
      c = add[U64](a: c, b: 1_u64)
  if int_eq[U64](a: c, b: 0_u64)
    var ez2 = if signed_lt[S64](a: e, b: -101_s64) then -101_s64 else e
    return D32Parts(sign: sign, special: 0_u64, exp: ez2, coeff: 0_u64)
  # strip trailing zeros toward pref (raise e); pad toward pref (lower e) within 7 digits
  while signed_lt[S64](a: e, b: pref) and int_eq[U64](a: unsigned_rem[U64](a: c, b: 10_u64), b: 0_u64)
    c = unsigned_div[U64](a: c, b: 10_u64)
    e = add[S64](a: e, b: 1_s64)
  while signed_gt[S64](a: e, b: pref) and unsigned_lt[U64](a: c, b: p10_u64(k: 6_s64)) and signed_le[S64](a: e, b: 90_s64)
    c = mul[U64](a: c, b: 10_u64)
    e = sub[S64](a: e, b: 1_s64)
  return D32Parts(sign: sign, special: 0_u64, exp: e, coeff: c)

# ============================================================================
# Arithmetic (U64 working width)
# ============================================================================
routine d32_mul(a: D32, b: D32) -> D32
  var pa = a.decode()
  var pb = b.decode()
  if int_ne[U64](a: pa.special, b: 0_u64) or int_ne[U64](a: pb.special, b: 0_u64)
    return d32_of_parts(p: d128_to_d32parts(mul_special_parts(pa: d32parts_to_d128(p: pa), pb: d32parts_to_d128(p: pb))))
  var sign = pa.sign != pb.sign
  var prod = mul[U64](a: pa.coeff, b: pb.coeff)
  return d32_of_parts(p: decfin32(sign: sign, coeff: prod, exp: add[S64](a: pa.exp, b: pb.exp), pref: add[S64](a: pa.exp, b: pb.exp)))

routine d32_add(a: D32, b: D32) -> D32
  var pa = a.decode()
  var pb = b.decode()
  if int_ne[U64](a: pa.special, b: 0_u64) or int_ne[U64](a: pb.special, b: 0_u64)
    return d32_of_parts(p: d128_to_d32parts(add_special_parts(pa: d32parts_to_d128(p: pa), pb: d32parts_to_d128(p: pb))))
  var eh = pa.exp
  var ch = pa.coeff
  var sh = pa.sign
  var el = pb.exp
  var cl = pb.coeff
  var sl = pb.sign
  if signed_lt[S64](a: pa.exp, b: pb.exp)
    eh = pb.exp
    ch = pb.coeff
    sh = pb.sign
    el = pa.exp
    cl = pa.coeff
    sl = pa.sign
  var pref = el
  var shift = sub[S64](a: eh, b: el)
  var ew = el
  if signed_le[S64](a: shift, b: 9_s64)
    ch = mul[U64](a: ch, b: p10_u64(k: shift))
  else
    ch = mul[U64](a: ch, b: p10_u64(k: 9_s64))
    ew = sub[S64](a: eh, b: 9_s64)
    # keep the low operand's in-window digits (down to ew); sticky only below.
    var drop = sub[S64](a: shift, b: 9_s64)
    if signed_ge[S64](a: drop, b: 7_s64)
      cl = if int_ne[U64](a: cl, b: 0_u64) then 1_u64 else 0_u64
    else
      var q = div_pow10_u64(x: cl, k: drop)
      var rem = sub[U64](a: cl, b: mul[U64](a: q, b: p10_u64(k: drop)))
      cl = if int_ne[U64](a: rem, b: 0_u64) then bit_or[U64](a: q, b: 1_u64) else q
  var rc = 0_u64
  var rsign = sh
  if sh == sl
    rc = add[U64](a: ch, b: cl)
  elseif unsigned_ge[U64](a: ch, b: cl)
    rc = sub[U64](a: ch, b: cl)
  else
    rc = sub[U64](a: cl, b: ch)
    rsign = sl
  if int_eq[U64](a: rc, b: 0_u64)
    # IEEE 754: a zero sum keeps the common sign ((-0)+(-0) = -0); opposite-sign
    # cancellation gives +0 (roundTiesToEven).
    rsign = if sh == sl then sh else false
  return d32_of_parts(p: decfin32(sign: rsign, coeff: rc, exp: ew, pref: pref))

### Negation: flip the sign bit.
routine d32_neg(a: D32) -> D32
  return D32.from_bits(bits: bit_xor[U32](a: a.to_bits(), b: shift_left[U32](value: 1_u32, bits: 31_u32)))

routine d32_sub(a: D32, b: D32) -> D32
  return d32_add(a: a, b: d32_neg(a: b))

routine d32_div(a: D32, b: D32) -> D32
  var pa = a.decode()
  var pb = b.decode()
  if int_ne[U64](a: pa.special, b: 0_u64) or int_ne[U64](a: pb.special, b: 0_u64)
    return d32_of_parts(p: d128_to_d32parts(div_special_parts(pa: d32parts_to_d128(p: pa), pb: d32parts_to_d128(p: pb))))
  var sign = pa.sign != pb.sign
  var azero = int_eq[U64](a: pa.coeff, b: 0_u64)
  var bzero = int_eq[U64](a: pb.coeff, b: 0_u64)
  if bzero
    if azero
      return d32_of_parts(p: D32Parts(sign: false, special: 2_u64, exp: 0_s64, coeff: 0_u64))
    return d32_of_parts(p: D32Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: 0_u64))
  var pref = sub[S64](a: pa.exp, b: pb.exp)
  if azero
    return d32_of_parts(p: decfin32(sign: sign, coeff: 0_u64, exp: pref, pref: pref))
  var num = pa.coeff
  var den = pb.coeff
  # scale numerator to ~Pmax+2 quotient digits, divide, sticky, round to 7
  var target = add[S64](a: digits10_u64(c: den), b: 9_s64)
  var shift = sub[S64](a: target, b: digits10_u64(c: num))
  if signed_lt[S64](a: shift, b: 0_s64)
    shift = 0_s64
  num = mul[U64](a: num, b: p10_u64(k: shift))
  var q = unsigned_div[U64](a: num, b: den)
  var rem = sub[U64](a: num, b: mul[U64](a: q, b: den))
  if int_ne[U64](a: rem, b: 0_u64)
    q = bit_or[U64](a: q, b: 1_u64)
  var exp = sub[S64](a: sub[S64](a: pa.exp, b: pb.exp), b: shift)
  return d32_of_parts(p: decfin32(sign: sign, coeff: q, exp: exp, pref: pref))

# ---- wired operators + represent ----
# Checked arithmetic crashes with a specific cause on a non-finite result (mirrors F64/Decimal):
# ±inf -> NumericOverflowError, NaN -> NumericDomainError, x/0 -> DivisionByZeroError. `@crash_only`
# keeps the callers non-failable. Use the `$*_unchecked` operators for raw IEEE 754 propagation.
@crash_only
routine d32_overflow_crash!() -> D32
  throw NumericOverflowError(description: "D32 overflow: the result is infinite (out of range).")
@crash_only
routine d32_domain_crash!() -> D32
  throw NumericDomainError(description: "D32: undefined operation with no real result (e.g. 0/0 or inf - inf).")
@crash_only
routine d32_divzero_crash!() -> D32
  throw DivisionByZeroError()
@crash_only
routine d32_nonfinite_crash!(r: D32) -> D32
  if r.is_nan()
    return d32_domain_crash!()
  return d32_overflow_crash!()

### Returns `me + you`. Checked: crashes if the result is non-finite. Use `$add_unchecked` for raw IEEE.
routine D32.$add(you: D32) -> D32
  var r = d32_add(a: me, b: you)
  if r.is_finite()
    return r
  return d32_nonfinite_crash!(r: r)
### Returns `me - you`. Checked: crashes if the result is non-finite. Use `$sub_unchecked` for raw IEEE.
routine D32.$sub(you: D32) -> D32
  var r = d32_sub(a: me, b: you)
  if r.is_finite()
    return r
  return d32_nonfinite_crash!(r: r)
### Returns `me * you`. Checked: crashes if the result is non-finite. Use `$mul_unchecked` for raw IEEE.
routine D32.$mul(you: D32) -> D32
  var r = d32_mul(a: me, b: you)
  if r.is_finite()
    return r
  return d32_nonfinite_crash!(r: r)
### Returns `me / you`. Checked: `x/0` -> DivisionByZeroError, `0/0` -> domain, overflow -> overflow.
### Use `$truediv_unchecked` for raw IEEE 754 (`x/0` -> ±inf, `0/0` -> NaN).
routine D32.$truediv(you: D32) -> D32
  var r = d32_div(a: me, b: you)
  if r.is_finite()
    return r
  if you.is_zero() and not me.is_zero()
    return d32_divzero_crash!()
  return d32_nonfinite_crash!(r: r)

### Returns `me + you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine D32.$add_unchecked(you: D32) -> D32
  return d32_add(a: me, b: you)
### Returns `me - you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine D32.$sub_unchecked(you: D32) -> D32
  return d32_sub(a: me, b: you)
### Returns `me * you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine D32.$mul_unchecked(you: D32) -> D32
  return d32_mul(a: me, b: you)
### Returns `me / you` with raw IEEE 754 propagation (`x/0` -> ±infinity, `0/0` -> NaN). No crash.
routine D32.$truediv_unchecked(you: D32) -> D32
  return d32_div(a: me, b: you)

### Decimal value equality (NaN never equal; infinities equal only with the same sign;
### finite values compare by value, so different cohorts of the same number are equal).
routine D32.$eq(you: D32) -> Bool
  if me.is_nan() or you.is_nan()
    return false
  if me.is_infinite() or you.is_infinite()
    var pa = me.decode()
    var pb = you.decode()
    return int_eq[U64](a: pa.special, b: pb.special) and pa.sign == pb.sign
  return int_eq[U64](a: d32_sub(a: me, b: you).decode().coeff, b: 0_u64)

### Three-way decimal comparison (NaN unordered -> SAME; finite by sign of me - you).
routine D32.$cmp(you: D32) -> ComparisonSign
  if me.is_nan() or you.is_nan()
    return SAME
  if me.is_infinite() or you.is_infinite()
    var pa = me.decode()
    var pb = you.decode()
    if int_eq[U64](a: pa.special, b: pb.special) and pa.sign == pb.sign
      return SAME
    if int_eq[U64](a: pa.special, b: 1_u64)
      return if pa.sign then ME_SMALL else ME_LARGE
    return if pb.sign then ME_LARGE else ME_SMALL
  var d = d32_sub(a: me, b: you).decode()
  if int_eq[U64](a: d.coeff, b: 0_u64)
    return SAME
  return if d.sign then ME_SMALL else ME_LARGE

### Raises this value to the `you` power (IEEE semantics: inf/NaN on overflow/domain error).
routine D32.$pow!(you: D32) -> D32
  var r = me.pow_unchecked(you: you)
  if r.is_finite()
    return r
  return d32_nonfinite_crash!(r: r)

routine D32.$represent() -> Text
  return d128_represent(p: d32parts_to_d128(p: me.decode()))
routine D32.$diagnose() -> Text
  return "D32(" + me.$represent() + ")"

# ============================================================================
# Public surface — creators / presets / parser / hash / bytes
#
# The construction/conversion web, presets, byte/hash views, and the decimal-text
# parser. Storage, arithmetic, comparison, libm, and formatting are the software BID
# engine above (`@llvm("i32") record D32 obeys Numeric, Ordered`). The matched
# `D32.$create(from: F64)` / `F64.$create(from: D32)` live with the engine. Pure RF.
# ============================================================================

# ============================================================================
# Constants
# ============================================================================

preset D32_ZERO: D32 = 0.0_d32
preset D32_ONE: D32 = 1.0_d32

# ============================================================================
# Creators — integers
# ============================================================================

routine D32.$create(from: S8) -> D32
  return D32.from_int64(value: S64(from))
routine D32.$create(from: S16) -> D32
  return D32.from_int64(value: S64(from))
routine D32.$create(from: S32) -> D32
  return D32.from_int64(value: S64(from))
routine D32.$create(from: S64) -> D32
  return D32.from_int64(value: from)
routine D32.$create(from: S128) -> D32
  return D32(from: D128(from: from))
routine D32.$create(from: S256) -> D32
  return D32(from: D128(from: from))

routine D32.$create(from: U8) -> D32
  return D32.from_components(sign: false, coeff: U64(from), exp: 0_s64)
routine D32.$create(from: U16) -> D32
  return D32.from_components(sign: false, coeff: U64(from), exp: 0_s64)
routine D32.$create(from: U32) -> D32
  return D32.from_components(sign: false, coeff: U64(from), exp: 0_s64)
routine D32.$create(from: U64) -> D32
  return D32.from_components(sign: false, coeff: from, exp: 0_s64)
routine D32.$create(from: U128) -> D32
  return D32(from: D128(from: from))
routine D32.$create(from: U256) -> D32
  return D32(from: D128(from: from))

# ============================================================================
# Creators — binary floats (matched width is F64, provided by the engine)
# ============================================================================

routine D32.$create(from: F16) -> D32
  return D32(from: F64(from))
routine D32.$create(from: F32) -> D32
  return D32(from: F64(from))
routine D32.$create(from: F128) -> D32
  return D32(from: from.F64())

# ============================================================================
# Creators — decimal <-> decimal
# ============================================================================

routine D32.$create(from: D32) -> D32
  return from
routine D32.$create(from: D64) -> D32
  return d32_of_parts(p: d128_to_d32parts(p: d64parts_to_d128(p: from.decode())))
routine D32.$create(from: D128) -> D32
  return d32_of_parts(p: d128_to_d32parts(p: from.decode()))

# ============================================================================
# Text parsing — shared D128 scanner, narrowed to D32.
# ============================================================================

### Parses a decimal literal into a `D32`.
### :throws: {InvalidValueError} if the text is not a valid decimal literal.
routine D32.$create!(from_text: Text) -> D32
  return D32(from: parse_decimal_d128!(from_text: from_text))

# ============================================================================
# Hashing
# ============================================================================

### Returns an xxHash64-based hash of the raw decimal32 encoding.
routine D32.$fast_hash() -> U64
  return __hash_u128(v: zero_extend[U32, U128](me.to_bits()))

# ============================================================================
# Byte Representation
# ============================================================================

### Returns the raw bytes of this value in little-endian order.
routine D32.to_bytes_le() -> Array[Byte, 4]
  var raw = me.to_bits()
  var result = Array[Byte, 4]()
  var i = 0_u64
  while unsigned_lt[U64](a: i, b: 4_u64)
    var b = int_truncate[U32, U8](shift_right_unsigned[U32](raw, int_truncate[U64, U32](mul[U64](a: i, b: 8_u64))))
    result = set_byte_at(array: result, index: i, value: b)
    i = add[U64](a: i, b: 1_u64)
  return result

### Returns the raw bytes of this value in big-endian order.
routine D32.to_bytes_be() -> Array[Byte, 4]
  var raw = me.to_bits()
  var result = Array[Byte, 4]()
  var i = 0_u64
  while unsigned_lt[U64](a: i, b: 4_u64)
    var b = int_truncate[U32, U8](shift_right_unsigned[U32](raw, int_truncate[U64, U32](mul[U64](a: sub[U64](a: 3_u64, b: i), b: 8_u64))))
    result = set_byte_at(array: result, index: i, value: b)
    i = add[U64](a: i, b: 1_u64)
  return result
