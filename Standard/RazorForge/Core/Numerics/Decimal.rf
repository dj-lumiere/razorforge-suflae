module Core

import Collections

# CREDITS: the BID (Binary-Integer-Decimal) encoding, round-half-to-even rounding,
# exponent clamping, and reciprocal / power-of-ten table approach of this decimal
# engine are a port and extension of Intel's Decimal Floating-Point Math Library
# ("libbid", © Intel Corporation, BSD 3-Clause). See THIRD-PARTY-NOTICES.md.

# ============================================================================
# Decimal — tabled-BID decimal256 (Pmax=70). Binary-coefficient storage in i256:
# bit255=sign, bits254..233 = biased exponent (22 bits, bias 1572932), bits232..0
# = coefficient (233 bits, holds 10^70-1). Working width U512 (product ≤140 digits
# ≈466 bits); decfin rounds the U512 product to U256 then strips in U256. Uses the
# verified reciprocal tables: div_pow10_u512 (round), div_pow10b (strip/digits).
# ============================================================================

### Decoded parts of a decimal256: value = (-1)^sign * coeff * 10^exp.
record DecimalParts
  sign: Bool
  special: U64
  exp: S64
  coeff: U256

### A software decimal256 value (BID-internal, binary coefficient storage).
@llvm("i256")
record Decimal obeys Numeric, Ordered
  pass

# ============================================================================
# Constants (fixed 70-digit; Decimal is fixed-precision, so these are presets)
# ============================================================================

### The mathematical constant pi (Archimedes' constant), correctly rounded to the 70 significant
### digits of `Decimal` precision. `Decimal` is a fixed 70-digit type, so pi is a constant value
### rather than a precision-parameterized routine. The literal carries extra digits; the
### compile-time
### BID encoder rounds it to 70 digits (round-half-to-even).
preset DECIMAL_PI: Decimal = 3.141592653589793238462643383279502884197169399375105820974944592307816406286dn
### Euler's number e (the base of the natural logarithm), correctly rounded to the 70 significant
### digits of `Decimal` precision.
preset DECIMAL_E: Decimal = 2.718281828459045235360287471352662497757247093699959574966967627724076630354dn

### Zero.
preset DECIMAL_ZERO: Decimal = 0dn
### One.
preset DECIMAL_ONE: Decimal = 1dn
### The largest finite `Decimal`: 70 nines at the maximum quantum exponent (1572795).
preset DECIMAL_MAX: Decimal = 9.999999999999999999999999999999999999999999999999999999999999999999999e1572864dn
### The most-negative finite `Decimal` (negative `DECIMAL_MAX`).
preset DECIMAL_MIN: Decimal = -9.999999999999999999999999999999999999999999999999999999999999999999999e1572864dn
### The smallest positive `Decimal` (coefficient 1 at the minimum quantum exponent).
preset DECIMAL_MIN_POSITIVE: Decimal = 1e-1572932dn
### The unit in the last place at exponent 0: `10^-(70-1)`, the gap from 1 to the next `Decimal`.
preset DECIMAL_EPSILON: Decimal = 1e-69dn

# ============================================================================
# Bit representation (raw i256 <-> value)
# ============================================================================

### Returns the raw i256 storage of this value (no decode; bit-for-bit reinterpret).
### :returns: the BID encoding as a U256.
@readonly
routine Decimal.to_bits() -> U256
  return reinterpret_bits[Decimal, U256](me)

### Reinterprets a raw U256 as a Decimal (bit-for-bit; assumes valid BID encoding).
### :param bits: the BID-encoded i256 storage.
common routine Decimal.from_bits(bits: U256) -> Decimal
  return reinterpret_bits[U256, Decimal](bits)

# ============================================================================
# Hashing & byte representation
# ============================================================================

### Returns a hash of the raw decimal256 encoding by folding its two 128-bit halves.
### Canonicalization (trailing-zero stripping) keeps equal values bit-identical, so equal
### `Decimal`s hash equally.
### :returns: A `U64` hash of `me`.
routine Decimal.fast_hash() -> U64
  var raw = me.to_bits()
  var lo = __hash_u128(v: raw.low128())
  var hi = __hash_u128(v: raw.high128())
  return lo ^ hi

### Returns the raw 32 bytes of this value in little-endian order.
### :returns: The BID-256 encoding, least-significant byte first.
routine Decimal.to_bytes_le() -> Array[Byte, 32]
  var raw = me.to_bits()
  var result = Array[Byte, 32]()
  var i = 0_u64
  while unsigned_lt[U64](a: i, b: 32_u64)
    var b = int_truncate[U256, U8](shift_right_unsigned[U256](raw, zero_extend[U64, U256](mul[U64](a: i, b: 8_u64))))
    result = set_byte_at(array: result, index: i, value: b)
    i = add[U64](a: i, b: 1_u64)
  return result

### Returns the raw 32 bytes of this value in big-endian order.
### :returns: The BID-256 encoding, most-significant byte first.
routine Decimal.to_bytes_be() -> Array[Byte, 32]
  var raw = me.to_bits()
  var result = Array[Byte, 32]()
  var i = 0_u64
  while unsigned_lt[U64](a: i, b: 32_u64)
    var b = int_truncate[U256, U8](shift_right_unsigned[U256](raw, zero_extend[U64, U256](mul[U64](a: sub[U64](a: 31_u64, b: i), b: 8_u64))))
    result = set_byte_at(array: result, index: i, value: b)
    i = add[U64](a: i, b: 1_u64)
  return result

# ============================================================================
# Text parsing — full 70-digit coefficient scan (the U256 analog of D128's
# scan_decimal_parts!; `Decimal` is finite-only, so inf/NaN text is rejected).
# ============================================================================

### Scans decimal text into sign / coefficient (U256) / base-10 exponent, accumulating the
### full coefficient so `Decimal`'s 70 digits are captured exactly.
### :throws: {InvalidValueError} on malformed input or inf/NaN (unrepresentable in `Decimal`).
routine scan_decimal_parts256!(from_text: Text) -> DecimalParts
  var len = from_text.count()
  if len == 0u64
    throw InvalidValueError(input: from_text, target: "decimal number")
  var i = 0u64
  var neg = false
  var first = from_text[0u64]
  if first == Character(0x002Bu32) or first == Character(0x002Du32)
    neg = first == Character(0x002Du32)
    i = 1u64
    if i >= len
      throw InvalidValueError(input: from_text, target: "decimal number")
  var coeff = zero_extend[U64, U256](0_u64)
  var ten = zero_extend[U64, U256](10_u64)
  var exp10 = 0_s64
  var seen_dot = false
  var has_digit = false
  while i < len
    var ch = from_text[i]
    if ch.is_numeric()
      coeff = add[U256](a: mul[U256](a: coeff, b: ten), b: zero_extend[U32, U256](reinterpret_bits[S32, U32](ch.digit_value())))
      if seen_dot
        exp10 = sub[S64](a: exp10, b: 1_s64)
      has_digit = true
    elseif ch == Character(0x002Eu32)
      if seen_dot
        throw InvalidValueError(input: from_text, target: "decimal number")
      seen_dot = true
    elseif ch == Character(0x0065u32) or ch == Character(0x0045u32)
      if not has_digit
        throw InvalidValueError(input: from_text, target: "decimal number")
      i = i + 1u64
      var esign = false
      if i < len and (from_text[i] == Character(0x002Bu32) or from_text[i] == Character(0x002Du32))
        esign = from_text[i] == Character(0x002Du32)
        i = i + 1u64
      var eval = 0_s64
      var has_edigit = false
      while i < len
        var ec = from_text[i]
        if not ec.is_numeric()
          throw InvalidValueError(input: from_text, target: "decimal number")
        eval = add[S64](a: mul[S64](a: eval, b: 10_s64), b: S64(ec.digit_value()))
        has_edigit = true
        i = i + 1u64
      if not has_edigit
        throw InvalidValueError(input: from_text, target: "decimal number")
      exp10 = add[S64](a: exp10, b: if esign then sub[S64](a: 0_s64, b: eval) else eval)
      break
    else
      throw InvalidValueError(input: from_text, target: "decimal number")
    i = i + 1u64
  if not has_digit
    throw InvalidValueError(input: from_text, target: "decimal number")
  return DecimalParts(sign: neg, special: 0_u64, exp: exp10, coeff: coeff)

### Parses a decimal literal into a `Decimal` (scans the full 70-digit coefficient).
### :throws: {InvalidValueError} if the text is not a valid finite decimal literal.
routine Decimal.create!(from_text: Text) -> Decimal
  var p = scan_decimal_parts256(from_text: from_text)
  return Decimal.from_components(sign: p.sign, coeff: p.coeff, exp: p.exp)

# ============================================================================
# Decode / encode — value <-> DecimalParts (sign / special / exp / coeff)
# ============================================================================

### BINARY decode — sign / specials (combination prefix at bits 254..250: 0x1E inf,
### 0x1F NaN with bit 249 = signaling) / 22-bit biased exponent / 233-bit coefficient.
### Finite biased exponents top out near 0x18 in the top-5, so the inf/NaN prefixes never
### collide with a finite value (mirrors D128's scheme).
@readonly
routine Decimal.decode() -> DecimalParts
  var bits = me.to_bits()
  var sign = int_ne[U256](a: bit_and[U256](a: bits, b: shift_left[U256](value: zero_extend[U64, U256](1_u64), bits: U256.to_width(s: 255_s64))), b: zero_extend[U64, U256](0_u64))
  var top5 = int_truncate[U256, U64](bit_and[U256](a: shift_right_unsigned[U256](bits, U256.to_width(s: 250_s64)), b: zero_extend[U64, U256](0x1F_u64)))
  if int_eq[U64](a: top5, b: 0x1E_u64)
    return DecimalParts(sign: sign, special: 1_u64, exp: 0_s64, coeff: zero_extend[U64, U256](0_u64))
  if int_eq[U64](a: top5, b: 0x1F_u64)
    var sp = 2_u64
    if int_ne[U256](a: bit_and[U256](a: shift_right_unsigned[U256](bits, U256.to_width(s: 249_s64)), b: zero_extend[U64, U256](1_u64)), b: zero_extend[U64, U256](0_u64))
      sp = 3_u64
    return DecimalParts(sign: sign, special: sp, exp: 0_s64, coeff: zero_extend[U64, U256](0_u64))
  var biased = int_truncate[U256, U64](bit_and[U256](a: shift_right_unsigned[U256](bits, U256.to_width(s: 233_s64)), b: zero_extend[U64, U256](0x3FFFFF_u64)))
  var coeff = bit_and[U256](a: bits, b: sub[U256](a: shift_left[U256](value: zero_extend[U64, U256](1_u64), bits: U256.to_width(s: 233_s64)), b: zero_extend[U64, U256](1_u64)))
  return DecimalParts(sign: sign, special: 0_u64, exp: sub[S64](a: reinterpret_bits[U64, S64](biased), b: 1572932_s64), coeff: coeff)

### Canonicalizes a finite decimal by stripping FRACTIONAL trailing zeros (exponent < 0) up
### toward exponent 0. `Decimal` is RazorForge's own canonical decimal — unlike the IEEE-cohort
### `D32`/`D64`/`D128`, trailing zeros aren't preserved, so two equal values share one
### representation: `2.50` and `2.5` both store as 25*10^-1, `3.0` as 3*10^0, `1.230` as
### 123*10^-2. Integers (exponent >= 0) are left untouched — `100` stays `100*10^0` (not stripped
### to `1*10^2`, which would render as scientific `1E+2`) and `6.02214076e23` keeps its scientific
### form. Specials (inf/NaN) pass through; zero canonicalizes to exponent 0.
routine decimal_normalize_parts(p: DecimalParts) -> DecimalParts
  if int_ne[U64](a: p.special, b: 0_u64)
    return p
  var zero = zero_extend[U64, U256](0_u64)
  if int_eq[U256](a: p.coeff, b: zero)
    return DecimalParts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: zero)
  var cu = p.coeff
  var e = p.exp
  # Batched fractional-trailing-zero strip toward exponent 0 (reciprocal divide, not a per-digit
  # loop — mirrors decfinA's strip): the most we can strip is room = -e (to reach exp 0); cap that
  # by the binary trailing-zero count (decimal tz <= binary tz, one cttz), find the largest tz <=
  # cap
  # with 10^tz | cu via one exact-divide check + a binary-search fallback, then divide once.
  var room = sub[S64](a: 0_s64, b: e)
  if signed_gt[S64](a: room, b: 0_s64)
    var cap = if signed_lt[S64](a: room, b: 70_s64) then room else 70_s64
    var t2 = int_truncate[U256, S64](trailing_zeros[U256](cu))
    if signed_lt[S64](a: t2, b: cap)
      cap = t2
    var tz = 0_s64
    if signed_gt[S64](a: cap, b: 0_s64)
      var ctop = div_pow10b(x: cu, k: cap)
      if int_eq[U256](a: cu, b: mul[U256](a: ctop, b: pow10b(k: cap)))
        tz = cap
      else
        var hi = sub[S64](a: cap, b: 1_s64)
        var probe = 64_s64
        while signed_ge[S64](a: probe, b: 1_s64)
          var cand = add[S64](a: tz, b: probe)
          if signed_le[S64](a: cand, b: hi)
            var c10 = div_pow10b(x: cu, k: cand)
            if int_eq[U256](a: cu, b: mul[U256](a: c10, b: pow10b(k: cand)))
              tz = cand
          probe = signed_div[S64](a: probe, b: 2_s64)
    if signed_gt[S64](a: tz, b: 0_s64)
      cu = div_pow10b(x: cu, k: tz)
      e = add[S64](a: e, b: tz)
  return DecimalParts(sign: p.sign, special: 0_u64, exp: e, coeff: cu)

### BINARY encode — pack sign / specials (combination prefix) / exponent / coefficient.
### Finite values are canonicalized (trailing zeros stripped) so the stored bits — and thus
### `decode`, `eq`, `cmp`, `hash`, `to_bytes`, and `represent` — are all consistent.
routine decimalfixed_of_parts(p: DecimalParts) -> Decimal
  var sbit = shift_left[U256](value: zero_extend[U64, U256](if p.sign then 1_u64 else 0_u64), bits: U256.to_width(s: 255_s64))
  if int_ne[U64](a: p.special, b: 0_u64)
    var top5 = if int_eq[U64](a: p.special, b: 1_u64) then 0x1E_u64 else 0x1F_u64
    var b = bit_or[U256](a: sbit, b: shift_left[U256](value: zero_extend[U64, U256](top5), bits: U256.to_width(s: 250_s64)))
    if int_eq[U64](a: p.special, b: 3_u64)
      b = bit_or[U256](a: b, b: shift_left[U256](value: zero_extend[U64, U256](1_u64), bits: U256.to_width(s: 249_s64)))
    return Decimal.from_bits(bits: b)
  var pn = decimal_normalize_parts(p: p)
  var biased = add[U64](a: reinterpret_bits[S64, U64](pn.exp), b: 1572932_u64)
  var ebits = shift_left[U256](value: zero_extend[U64, U256](bit_and[U64](a: biased, b: 0x3FFFFF_u64)), bits: U256.to_width(s: 233_s64))
  return Decimal.from_bits(bits: bit_or[U256](a: bit_or[U256](a: sbit, b: ebits), b: pn.coeff))

# ============================================================================
# Special values & classification
# ============================================================================

### Infinity with the given sign / a quiet NaN.
common routine Decimal.infinity(sign: Bool) -> Decimal
  return decimalfixed_of_parts(p: DecimalParts(sign: sign, special: 1_u64, exp: 0_s64, coeff: zero_extend[U64, U256](0_u64)))

### Returns a quiet NaN (special field 2, zero coefficient).
### :returns: A quiet-NaN `Decimal`.
common routine Decimal.quiet_nan() -> Decimal
  return decimalfixed_of_parts(p: DecimalParts(sign: false, special: 2_u64, exp: 0_s64, coeff: zero_extend[U64, U256](0_u64)))

# ============================================================================
# Creators — integers. A `Decimal` is an `@llvm("i256")` carrier, so without these
# `create` overloads `Decimal(from: <int>)` would lower to a RAW i256 cast (storing
# the bare integer in the bits) instead of the BID encoding {coeff, exp: 0}. decfinA
# rounds magnitudes wider than 70 digits (round-half-even).
# ============================================================================

### Builds a Decimal from a sign + U256 magnitude at the given exponent (rounds to <= 70 digits).
common routine Decimal.from_components(sign: Bool, coeff: U256, exp: S64) -> Decimal
  return decimalfixed_of_parts(p: decfinA(sign: sign, coeff: zero_extend[U256, U512](coeff), exp: exp, pref: exp))

### Builds a Decimal from a 64-bit signed integer (exponent 0).
common routine Decimal.from_int64(value: S64) -> Decimal
  var neg = signed_lt[S64](a: value, b: 0_s64)
  var mag = if neg then sub[S64](a: 0_s64, b: value) else value
  return Decimal.from_components(sign: neg, coeff: zero_extend[U64, U256](reinterpret_bits[S64, U64](mag)), exp: 0_s64)

### Signed integer -> Decimal.
### S8 -> Decimal (widened to S64, exponent 0).
routine Decimal.create(from: S8) -> Decimal
  return Decimal.from_int64(value: S64(from))

### S16 -> Decimal (widened to S64, exponent 0).
routine Decimal.create(from: S16) -> Decimal
  return Decimal.from_int64(value: S64(from))

### S32 -> Decimal (widened to S64, exponent 0).
routine Decimal.create(from: S32) -> Decimal
  return Decimal.from_int64(value: S64(from))

### S64 -> Decimal (exponent 0).
routine Decimal.create(from: S64) -> Decimal
  return Decimal.from_int64(value: from)

### S128 -> Decimal (split sign / magnitude into a U256 coefficient, exponent 0).
routine Decimal.create(from: S128) -> Decimal
  # negate via two's complement on the signed value, then reinterpret the magnitude as unsigned
  var neg = signed_lt[S128](a: from, b: 0_s128)
  var mag = if neg then reinterpret_bits[S128, U128](sub[S128](a: 0_s128, b: from)) else reinterpret_bits[S128, U128](from)
  return Decimal.from_components(sign: neg, coeff: zero_extend[U128, U256](mag), exp: 0_s64)

### S256 -> Decimal (split sign / magnitude into the U256 coefficient, exponent 0).
routine Decimal.create(from: S256) -> Decimal
  # S256_MIN negates to itself in two's complement; its magnitude (2^255) still fits the 256-bit
  # coeff
  var neg = signed_lt[S256](a: from, b: 0_s256)
  var mag = if neg then reinterpret_bits[S256, U256](sub[S256](a: 0_s256, b: from)) else reinterpret_bits[S256, U256](from)
  return Decimal.from_components(sign: neg, coeff: mag, exp: 0_s64)

### Unsigned integer -> Decimal.
### U8 -> Decimal (zero-extend into the coefficient, exponent 0).
routine Decimal.create(from: U8) -> Decimal
  return Decimal.from_components(sign: false, coeff: zero_extend[U8, U256](from), exp: 0_s64)

### U16 -> Decimal (zero-extend into the coefficient, exponent 0).
routine Decimal.create(from: U16) -> Decimal
  return Decimal.from_components(sign: false, coeff: zero_extend[U16, U256](from), exp: 0_s64)

### U32 -> Decimal (zero-extend into the coefficient, exponent 0).
routine Decimal.create(from: U32) -> Decimal
  return Decimal.from_components(sign: false, coeff: zero_extend[U32, U256](from), exp: 0_s64)

### U64 -> Decimal (zero-extend into the coefficient, exponent 0).
routine Decimal.create(from: U64) -> Decimal
  return Decimal.from_components(sign: false, coeff: zero_extend[U64, U256](from), exp: 0_s64)

### U128 -> Decimal (zero-extend into the coefficient, exponent 0).
routine Decimal.create(from: U128) -> Decimal
  return Decimal.from_components(sign: false, coeff: zero_extend[U128, U256](from), exp: 0_s64)

### U256 -> Decimal (coefficient stored directly, exponent 0).
routine Decimal.create(from: U256) -> Decimal
  return Decimal.from_components(sign: false, coeff: from, exp: 0_s64)

# ============================================================================
# Creators — binary floats. Routed through D128 (the matched float->decimal engine,
# correctly rounded): F16/F32/F64 are captured well within D128's 34 digits
# (round-trip-exact); F128 is correctly rounded to 34 digits. inf/NaN pass through
# the D128 -> Decimal parts path. A full 70-digit binary->decimal would need an F512
# widening primitive (`to_f512a` only accepts the native 512-engine uf) — future work.
# ============================================================================

### Binary float -> Decimal (correctly rounded via D128).
### F16 -> Decimal via D128 (round-trip-exact: F16 fits well inside D128's 34 digits).
routine Decimal.create(from: F16) -> Decimal
  return Decimal(from: D128(from: from))

### F32 -> Decimal via D128 (round-trip-exact).
routine Decimal.create(from: F32) -> Decimal
  return Decimal(from: D128(from: from))

### F64 -> Decimal via D128 (round-trip-exact).
routine Decimal.create(from: F64) -> Decimal
  return Decimal(from: D128(from: from))

### F128 -> Decimal via D128 (correctly rounded to 34 digits; full 70-digit path is future work).
routine Decimal.create(from: F128) -> Decimal
  return Decimal(from: D128(from: from))

# ============================================================================
# Creators — IEEE decimals (D32/D64/D128). Exact: the source coefficient (<= 34
# digits) and exponent transfer directly into the 70-digit cohort; inf/NaN pass
# through. Routed via the decoded parts, NOT binary F512 (decimals aren't exact
# in binary).
# ============================================================================

### Builds a Decimal from already-decoded decimal parts (special-aware).
common routine Decimal.from_decimal_parts(sign: Bool, special: U64, exp: S64, coeff: U256) -> Decimal
  if int_eq[U64](a: special, b: 1_u64)
    return Decimal.infinity(sign: sign)
  if unsigned_ge[U64](a: special, b: 2_u64)
    return Decimal.quiet_nan()
  return Decimal.from_components(sign: sign, coeff: coeff, exp: exp)

### IEEE decimal -> Decimal.
### D32 -> Decimal (exact: decode parts, widen coefficient into the 70-digit cohort).
routine Decimal.create(from: D32) -> Decimal
  var p = from.decode()
  return Decimal.from_decimal_parts(sign: p.sign, special: p.special, exp: p.exp, coeff: zero_extend[U64, U256](p.coeff))

### D64 -> Decimal (exact: decode parts, widen coefficient into the 70-digit cohort).
routine Decimal.create(from: D64) -> Decimal
  var p = from.decode()
  return Decimal.from_decimal_parts(sign: p.sign, special: p.special, exp: p.exp, coeff: zero_extend[U64, U256](p.coeff))

### D128 -> Decimal (exact: decode parts, widen the 34-digit coefficient into the cohort).
routine Decimal.create(from: D128) -> Decimal
  var p = from.decode()
  return Decimal.from_decimal_parts(sign: p.sign, special: p.special, exp: p.exp, coeff: zero_extend[U128, U256](p.coeff))

### Classification. True when special == 0 (a finite value, including zero).
@readonly
routine Decimal.is_finite() -> Bool
  return int_eq[U64](a: me.decode().special, b: 0_u64)

### True when the value is +-infinity (special == 1).
@readonly
routine Decimal.is_infinite() -> Bool
  return int_eq[U64](a: me.decode().special, b: 1_u64)

### True when the value is NaN (special >= 2: 2 = quiet, 3 = signaling).
@readonly
routine Decimal.is_nan() -> Bool
  return unsigned_ge[U64](a: me.decode().special, b: 2_u64)

# ============================================================================
# Comparison (Equatable / Comparable) — by decoded parts, NOT by subtraction, so
# it never crashes (Decimal arithmetic is @crash_only on overflow). Both operands
# are finite in normal use; specials are handled defensively.
# ============================================================================

### Three-way magnitude comparison of two FINITE, NONZERO decimals |ca*10^ea| vs
### |cb*10^eb|. Compares adjusted exponents (position of the most-significant digit)
### first; on a tie the exponent spread is bounded by the digit-count difference
### (<= 70), so aligning the coefficients in U512 cannot overflow.
routine decimal_cmp_mag(ca: U256, ea: S64, cb: U256, eb: S64) -> ComparisonSign
  var wa = zero_extend[U256, U512](ca)
  var wb = zero_extend[U256, U512](cb)
  var adja = add[S64](a: ea, b: sub[S64](a: digits10a(c: wa), b: 1_s64))
  var adjb = add[S64](a: eb, b: sub[S64](a: digits10a(c: wb), b: 1_s64))
  if signed_gt[S64](a: adja, b: adjb)
    return ME_LARGE
  if signed_lt[S64](a: adja, b: adjb)
    return ME_SMALL
  if signed_gt[S64](a: ea, b: eb)
    wa = mul[U512](a: wa, b: pow10a(k: sub[S64](a: ea, b: eb)))
  if signed_lt[S64](a: ea, b: eb)
    wb = mul[U512](a: wb, b: pow10a(k: sub[S64](a: eb, b: ea)))
  if unsigned_gt[U512](a: wa, b: wb)
    return ME_LARGE
  if unsigned_lt[U512](a: wa, b: wb)
    return ME_SMALL
  return SAME

### Three-way comparison under IEEE ordered semantics. NaN is unordered and maps to
### SAME (matching the engine convention). Zero compares equal regardless of sign.
@readonly
routine Decimal.cmp(you: Decimal) -> ComparisonSign
  var pa = me.decode()
  var pb = you.decode()
  if unsigned_ge[U64](a: pa.special, b: 2_u64) or unsigned_ge[U64](a: pb.special, b: 2_u64)
    return SAME
  if int_eq[U64](a: pa.special, b: 1_u64) or int_eq[U64](a: pb.special, b: 1_u64)
    if int_eq[U64](a: pa.special, b: pb.special) and pa.sign == pb.sign
      return SAME
    if int_eq[U64](a: pa.special, b: 1_u64)
      return if pa.sign then ME_SMALL else ME_LARGE
    return if pb.sign then ME_LARGE else ME_SMALL
  var az = int_eq[U256](a: pa.coeff, b: 0)
  var bz = int_eq[U256](a: pb.coeff, b: 0)
  if az and bz
    return SAME
  if az
    return if pb.sign then ME_LARGE else ME_SMALL
  if bz
    return if pa.sign then ME_SMALL else ME_LARGE
  if pa.sign != pb.sign
    return if pa.sign then ME_SMALL else ME_LARGE
  # Same sign, both nonzero: for negatives the larger magnitude is the smaller value,
  # so swap operands to flip the magnitude comparison.
  if pa.sign
    return decimal_cmp_mag(ca: pb.coeff, ea: pb.exp, cb: pa.coeff, eb: pa.exp)
  return decimal_cmp_mag(ca: pa.coeff, ea: pa.exp, cb: pb.coeff, eb: pb.exp)

### Value equality. NaN is never equal to anything (including itself); every other
### case follows the three-way comparison (so 1.0 and 1.00 are equal).
@readonly
routine Decimal.eq(you: Decimal) -> Bool
  if me.is_nan() or you.is_nan()
    return false
  var c = me.cmp(you: you)
  return c is SAME

# ============================================================================
# Crash-only error sinks + result contract
#
# Decimal is a finite-only, beginner-facing type: arithmetic that would yield a
# non-finite value crashes with a SPECIFIC cause — NumericOverflowError (true result
# too large -> inf), NumericDomainError (an undefined result like 0/0 -> NaN), and
# DivisionByZeroError (a nonzero value over zero). `@crash_only` makes each crash
# unconditional, so the wired operators that call them need not be failable.
# ============================================================================

# ============================================================================
# Special-case arithmetic (inf / NaN / zero operands, on DecimalParts)
# ============================================================================

### Special-arithmetic parts (coeff 0). NaN propagates; rules mirror D128 / IEEE 754.
### Quiet-NaN parts (special 2, coeff 0).
routine nan256() -> DecimalParts
  return DecimalParts(sign: false, special: 2_u64, exp: 0_s64, coeff: zero_extend[U64, U256](0_u64))

### Signed-infinity parts (special 1, coeff 0).
routine inf256(sign: Bool) -> DecimalParts
  return DecimalParts(sign: sign, special: 1_u64, exp: 0_s64, coeff: zero_extend[U64, U256](0_u64))

### Signed-zero parts (special 0, coeff 0).
routine zero256(sign: Bool) -> DecimalParts
  return DecimalParts(sign: sign, special: 0_u64, exp: 0_s64, coeff: zero_extend[U64, U256](0_u64))

### True if either operand is a NaN (special >= 2).
routine has_nan256(pa: DecimalParts, pb: DecimalParts) -> Bool
  return unsigned_ge[U64](a: pa.special, b: 2_u64) or unsigned_ge[U64](a: pb.special, b: 2_u64)

### Special-case result of a+b when at least one operand is non-finite.
### inf+inf same sign = inf; inf-inf (opposite signs) = NaN; NaN propagates.
routine add_special256(pa: DecimalParts, pb: DecimalParts) -> DecimalParts
  if has_nan256(pa: pa, pb: pb)
    return nan256()
  if int_eq[U64](a: pa.special, b: 1_u64) and int_eq[U64](a: pb.special, b: 1_u64)
    if pa.sign == pb.sign
      return inf256(sign: pa.sign)
    return nan256()
  if int_eq[U64](a: pa.special, b: 1_u64)
    return inf256(sign: pa.sign)
  return inf256(sign: pb.sign)

### Special-case result of a*b when at least one operand is non-finite.
### NaN propagates; inf*0 = NaN; otherwise inf with the XOR of the signs.
routine mul_special256(pa: DecimalParts, pb: DecimalParts) -> DecimalParts
  if has_nan256(pa: pa, pb: pb)
    return nan256()
  var azero = int_eq[U64](a: pa.special, b: 0_u64) and int_eq[U256](a: pa.coeff, b: 0)
  var bzero = int_eq[U64](a: pb.special, b: 0_u64) and int_eq[U256](a: pb.coeff, b: 0)
  if azero or bzero
    return nan256()
  return inf256(sign: pa.sign != pb.sign)

### Special-case result of a/b when at least one operand is non-finite.
### NaN propagates; inf/inf = NaN; inf/finite = inf; finite/inf = 0; sign is XOR of signs.
routine div_special256(pa: DecimalParts, pb: DecimalParts) -> DecimalParts
  if has_nan256(pa: pa, pb: pb)
    return nan256()
  var sign = pa.sign != pb.sign
  if int_eq[U64](a: pa.special, b: 1_u64)
    if int_eq[U64](a: pb.special, b: 1_u64)
      return nan256()
    return inf256(sign: sign)
  return zero256(sign: sign)

# ============================================================================
# Numeric helpers — powers of ten / digit count (U512 working width)
# ============================================================================

### 10^k as a U512 (k <= 76) — 10^k fits U256, widened.
routine pow10a(k: S64) -> U512
  return pow10_512_tbl(k: k)

### Decimal digits in a U512 value, via 10^18 chunks (mulhi reciprocal).
routine digits10a(c: U512) -> S64
  if int_eq[U512](a: c, b: 0)
    return 1_s64
  # clz-based digit count (see digits10b), U512 pow10 table for the ±1 correction.
  var nbits = sub[S64](a: 512_s64, b: int_truncate[U512, S64](leading_zeros[U512](c)))
  var d = add[S64](a: signed_div[S64](a: mul[S64](a: nbits, b: 1233_s64), b: 4096_s64), b: 1_s64)
  if signed_ge[S64](a: d, b: 1_s64) and unsigned_lt[U512](a: c, b: pow10_512_tbl(k: sub[S64](a: d, b: 1_s64)))
    return sub[S64](a: d, b: 1_s64)
  if signed_le[S64](a: d, b: 154_s64) and unsigned_ge[U512](a: c, b: pow10_512_tbl(k: d))
    return add[S64](a: d, b: 1_s64)
  return d

# ============================================================================
# Rounding / finalize — round a working value to <=70 digits + clamp exponent
# ============================================================================

### Rounds a U512 working value to <=70 sig digits (round-half-even), nudges toward
### `pref`, returns finalized parts. Front rounds in U512; back strips in U256.
routine decfinA(sign: Bool, coeff: U512, exp: S64, pref: S64) -> DecimalParts
  var two = zero_extend[U64, U512](2_u64)
  var one = zero_extend[U64, U512](1_u64)
  if int_eq[U512](a: coeff, b: 0)
    return DecimalParts(sign: sign, special: 0_u64, exp: pref, coeff: zero_extend[U64, U256](0_u64))
  var c = coeff
  var e = exp
  var nd = digits10a(c: c)
  if signed_gt[S64](a: nd, b: 70_s64)
    var drop = sub[S64](a: nd, b: 70_s64)
    var div = pow10a(k: drop)
    var q = div_pow10_u512(x: c, k: drop)
    var r = sub[U512](a: c, b: mul[U512](a: q, b: div))
    var twice = mul[U512](a: r, b: two)
    if unsigned_gt[U512](a: twice, b: div)
      q = add[U512](a: q, b: one)
    elseif int_eq[U512](a: twice, b: div) and int_ne[U512](a: bit_and[U512](a: q, b: one), b: 0)
      q = add[U512](a: q, b: one)
    c = q
    e = add[S64](a: e, b: drop)
    # Rounding can only carry 70 digits to 71, i.e. c >= 10^70. One U512 compare
    # instead of a second full digits10a clz pass (matches decfinB's strat).
    if unsigned_ge[U512](a: c, b: pow10a(k: 70_s64))
      c = div_pow10_u512(x: c, k: 1_s64)
      e = add[S64](a: e, b: 1_s64)
  # c now <= 70 digits -> fits U256; strip/pad/digit-count in U256.
  var cu = int_truncate[U512, U256](c)
  var ten = zero_extend[U64, U256](10_u64)
  # batched trailing-zero strip toward pref
  var room = sub[S64](a: pref, b: e)
  if signed_gt[S64](a: room, b: 0_s64) and int_ne[U256](a: cu, b: 0)
    var cap = if signed_lt[S64](a: room, b: 70_s64) then room else 70_s64
    # tz <= binary trailing zeros (cttz, one instruction); caps the probe search so
    # div_pow10/mul never fire for candidates > t2 (odd coeffs => zero wide mults).
    var t2 = int_truncate[U256, S64](trailing_zeros[U256](cu))
    if signed_lt[S64](a: t2, b: cap)
      cap = t2
    var tz = 0_s64
    if signed_gt[S64](a: cap, b: 0_s64)
      # Fast path for exact-round results: if 10^cap divides cu outright, tz = cap in ONE
      # wide check instead of log2(cap) probes (the common case for division).
      var ctop = div_pow10b(x: cu, k: cap)
      if int_eq[U256](a: cu, b: mul[U256](a: ctop, b: pow10b(k: cap)))
        tz = cap
      else
        var hi = sub[S64](a: cap, b: 1_s64)
        var probe = 64_s64
        while signed_ge[S64](a: probe, b: 1_s64)
          var cand = add[S64](a: tz, b: probe)
          if signed_le[S64](a: cand, b: hi)
            var c10 = div_pow10b(x: cu, k: cand)
            if int_eq[U256](a: cu, b: mul[U256](a: c10, b: pow10b(k: cand)))
              tz = cand
          probe = signed_div[S64](a: probe, b: 2_s64)
    if signed_gt[S64](a: tz, b: 0_s64)
      cu = div_pow10b(x: cu, k: tz)
      e = add[S64](a: e, b: tz)
  # Pad toward pref while cu stays under 70 digits ("digits < 70" == "cu < 10^69").
  var ten69 = pow10_tbl(k: 69_s64)
  while signed_gt[S64](a: e, b: pref) and unsigned_lt[U256](a: cu, b: ten69)
    cu = mul[U256](a: cu, b: ten)
    e = sub[S64](a: e, b: 1_s64)
  # IEEE decimal256 overflow clamp: the quantum exponent q must be <= qmax =
  # Emax-(p-1) = 1572795 (p=70, bias 1572932). Above qmax, pad the coefficient with
  # zeros to pull q down (the canonical max-q cohort); if it will not fit in 70 digits
  # the magnitude exceeds Nmax -> infinity, which the wired operators turn into a crash.
  if signed_gt[S64](a: e, b: 1572795_s64)
    var spread = sub[S64](a: e, b: 1572795_s64)
    var fits = false
    if signed_le[S64](a: spread, b: 69_s64)
      var lim = pow10_tbl(k: sub[S64](a: 70_s64, b: spread))
      if unsigned_lt[U256](a: cu, b: lim)
        fits = true
    if not fits
      return DecimalParts(sign: sign, special: 1_u64, exp: 0_s64, coeff: zero_extend[U64, U256](0_u64))
    cu = int_truncate[U512, U256](mul[U512](a: zero_extend[U256, U512](cu), b: pow10a(k: spread)))
    e = 1572795_s64
  return DecimalParts(sign: sign, special: 0_u64, exp: e, coeff: cu)

# ============================================================================
# Arithmetic operators (mul / add / neg / sub / truediv)
# ============================================================================

### Returns me * you.
routine Decimal.mul!(you: Decimal) -> Decimal
  var pa = me.decode()
  var pb = you.decode()
  if int_ne[U64](a: pa.special, b: 0_u64) or int_ne[U64](a: pb.special, b: 0_u64)
    var __dchk0 = decimalfixed_of_parts(p: mul_special256(pa: pa, pb: pb))
    var __dp0 = __dchk0.decode()
    if int_eq[U64](a: __dp0.special, b: 1_u64)
      throw NumericOverflowError(description: "overflow: out of range")
    if unsigned_ge[U64](a: __dp0.special, b: 2_u64)
      throw NumericDomainError(description: "domain error: no real result")
    if int_eq[U256](a: __dp0.coeff, b: 0)
      return decimalfixed_of_parts(p: DecimalParts(sign: false, special: 0_u64, exp: __dp0.exp, coeff: zero_extend[U64, U256](0_u64)))
    return __dchk0
  var sign = pa.sign != pb.sign
  var prod = mul[U512](a: zero_extend[U256, U512](pa.coeff), b: zero_extend[U256, U512](pb.coeff))
  var __dchk1 = decimalfixed_of_parts(p: decfinA(sign: sign, coeff: prod, exp: add[S64](a: pa.exp, b: pb.exp), pref: add[S64](a: pa.exp, b: pb.exp)))
  var __dp1 = __dchk1.decode()
  if int_eq[U64](a: __dp1.special, b: 1_u64)
    throw NumericOverflowError(description: "overflow: out of range")
  if unsigned_ge[U64](a: __dp1.special, b: 2_u64)
    throw NumericDomainError(description: "domain error: no real result")
  if int_eq[U256](a: __dp1.coeff, b: 0)
    return decimalfixed_of_parts(p: DecimalParts(sign: false, special: 0_u64, exp: __dp1.exp, coeff: zero_extend[U64, U256](0_u64)))
  return __dchk1

### Returns me + you (align to smaller exponent, guard 76, U512 combine).
routine Decimal.add!(you: Decimal) -> Decimal
  var pa = me.decode()
  var pb = you.decode()
  if int_ne[U64](a: pa.special, b: 0_u64) or int_ne[U64](a: pb.special, b: 0_u64)
    var __dchk2 = decimalfixed_of_parts(p: add_special256(pa: pa, pb: pb))
    var __dp2 = __dchk2.decode()
    if int_eq[U64](a: __dp2.special, b: 1_u64)
      throw NumericOverflowError(description: "overflow: out of range")
    if unsigned_ge[U64](a: __dp2.special, b: 2_u64)
      throw NumericDomainError(description: "domain error: no real result")
    if int_eq[U256](a: __dp2.coeff, b: 0)
      return decimalfixed_of_parts(p: DecimalParts(sign: false, special: 0_u64, exp: __dp2.exp, coeff: zero_extend[U64, U256](0_u64)))
    return __dchk2
  var eh = pa.exp
  var ch = zero_extend[U256, U512](pa.coeff)
  var sh = pa.sign
  var el = pb.exp
  var cl = zero_extend[U256, U512](pb.coeff)
  var sl = pb.sign
  if signed_lt[S64](a: pa.exp, b: pb.exp)
    eh = pb.exp
    ch = zero_extend[U256, U512](pb.coeff)
    sh = pb.sign
    el = pa.exp
    cl = zero_extend[U256, U512](pa.coeff)
    sl = pa.sign
  var pref = el
  var shift = sub[S64](a: eh, b: el)
  var ew = el
  if signed_le[S64](a: shift, b: 76_s64)
    ch = mul[U512](a: ch, b: pow10a(k: shift))
  else
    ch = mul[U512](a: ch, b: pow10a(k: 76_s64))
    ew = sub[S64](a: eh, b: 76_s64)
    cl = if int_ne[U512](a: cl, b: 0) then zero_extend[U64, U512](1_u64) else zero_extend[U64, U512](0_u64)
  var rc = zero_extend[U64, U512](0_u64)
  var rsign = sh
  if sh == sl
    rc = add[U512](a: ch, b: cl)
  elseif unsigned_ge[U512](a: ch, b: cl)
    rc = sub[U512](a: ch, b: cl)
  else
    rc = sub[U512](a: cl, b: ch)
    rsign = sl
  if int_eq[U512](a: rc, b: 0)
    # IEEE 754: a zero sum keeps the common sign ((-0)+(-0) = -0); opposite-sign
    # cancellation gives +0 (roundTiesToEven).
    rsign = if sh == sl then sh else false
  var __dchk3 = decimalfixed_of_parts(p: decfinA(sign: rsign, coeff: rc, exp: ew, pref: pref))
  var __dp3 = __dchk3.decode()
  if int_eq[U64](a: __dp3.special, b: 1_u64)
    throw NumericOverflowError(description: "overflow: out of range")
  if unsigned_ge[U64](a: __dp3.special, b: 2_u64)
    throw NumericDomainError(description: "domain error: no real result")
  if int_eq[U256](a: __dp3.coeff, b: 0)
    return decimalfixed_of_parts(p: DecimalParts(sign: false, special: 0_u64, exp: __dp3.exp, coeff: zero_extend[U64, U256](0_u64)))
  return __dchk3

### Arithmetic negation (flip sign bit).
routine decimalfixed_neg(a: Decimal) -> Decimal
  return Decimal.from_bits(bits: bit_xor[U256](a: a.to_bits(), b: shift_left[U256](value: zero_extend[U64, U256](1_u64), bits: U256.to_width(s: 255_s64))))

### Returns me - you. Failable like `add!`/`mul!`/`truediv!`: subtraction can overflow the
### `Decimal` range (e.g. MAX - (-MAX)), so the throw propagates through `add!` (the `-` operator
### crashes on it in non-failable context; `try_sub!` recovers).
routine Decimal.sub!(you: Decimal) -> Decimal
  return me.add(you: decimalfixed_neg(a: you))

### Returns me / you (scale numerator ~74 digits past, divide, sticky, round).
routine Decimal.truediv!(you: Decimal) -> Decimal
  var pa = me.decode()
  var pb = you.decode()
  if int_ne[U64](a: pa.special, b: 0_u64) or int_ne[U64](a: pb.special, b: 0_u64)
    var __dchk4 = decimalfixed_of_parts(p: div_special256(pa: pa, pb: pb))
    var __dp4 = __dchk4.decode()
    if int_eq[U64](a: __dp4.special, b: 1_u64)
      throw NumericOverflowError(description: "overflow: out of range")
    if unsigned_ge[U64](a: __dp4.special, b: 2_u64)
      throw NumericDomainError(description: "domain error: no real result")
    if int_eq[U256](a: __dp4.coeff, b: 0)
      return decimalfixed_of_parts(p: DecimalParts(sign: false, special: 0_u64, exp: __dp4.exp, coeff: zero_extend[U64, U256](0_u64)))
    return __dchk4
  var sign = pa.sign != pb.sign
  if int_eq[U256](a: pb.coeff, b: 0)
    if int_eq[U256](a: pa.coeff, b: 0)
      throw NumericDomainError(description: "domain error: no real result")
    throw DivisionByZeroError()
  var pref = sub[S64](a: pa.exp, b: pb.exp)
  if int_eq[U256](a: pa.coeff, b: 0)
    var __dchk5 = decimalfixed_of_parts(p: decfinA(sign: sign, coeff: zero_extend[U64, U512](0_u64), exp: pref, pref: pref))
    var __dp5 = __dchk5.decode()
    if int_eq[U64](a: __dp5.special, b: 1_u64)
      throw NumericOverflowError(description: "overflow: out of range")
    if unsigned_ge[U64](a: __dp5.special, b: 2_u64)
      throw NumericDomainError(description: "domain error: no real result")
    if int_eq[U256](a: __dp5.coeff, b: 0)
      return decimalfixed_of_parts(p: DecimalParts(sign: false, special: 0_u64, exp: __dp5.exp, coeff: zero_extend[U64, U256](0_u64)))
    return __dchk5
  var num = zero_extend[U256, U512](pa.coeff)
  var den = zero_extend[U256, U512](pb.coeff)
  # +71: quotient = 71-72 digits = 70 result + 1 round digit; sticky bit carries the rest
  # (correct round-half-even). Narrower than the old +74's ~3 needless extra digits.
  var target = add[S64](a: digits10a(c: den), b: 71_s64)
  var shift = sub[S64](a: target, b: digits10a(c: num))
  if signed_lt[S64](a: shift, b: 0_s64)
    shift = 0_s64
  num = mul[U512](a: num, b: pow10a(k: shift))
  # register-resident n=1 long division (the common small-divisor case) + sticky;
  # falls back to generic Knuth for multi-limb divisors.
  var q = udiv512_by_u256_sticky(num: num, den: den)
  var exp = sub[S64](a: pref, b: shift)
  var __dchk6 = decimalfixed_of_parts(p: decfinA(sign: sign, coeff: q, exp: exp, pref: pref))
  var __dp6 = __dchk6.decode()
  if int_eq[U64](a: __dp6.special, b: 1_u64)
    throw NumericOverflowError(description: "overflow: out of range")
  if unsigned_ge[U64](a: __dp6.special, b: 2_u64)
    throw NumericDomainError(description: "domain error: no real result")
  if int_eq[U256](a: __dp6.coeff, b: 0)
    return decimalfixed_of_parts(p: DecimalParts(sign: false, special: 0_u64, exp: __dp6.exp, coeff: zero_extend[U64, U256](0_u64)))
  return __dchk6

# ============================================================================
# Formatting — decimal text (represent), decNumber decToString style
# ============================================================================

### Full decimal256 text — up to 70 digits (decNumber decToString style: plain when
### exp<=0 and adjusted exp >= -6, else scientific). Digit extraction is table-free
### (knuth `%`/`//` by 10), so it is NOT bounded by the 10^40 reciprocal table; the
### decimal point is placed during extraction since Text has no slicing.
routine d256b_represent(p: DecimalParts) -> Text
  if int_eq[U64](a: p.special, b: 1_u64)
    return if p.sign then "-inf" else "inf"
  if unsigned_ge[U64](a: p.special, b: 2_u64)
    return "NaN"
  var pn = decimal_normalize_parts(p: p)
  var sign = pn.sign
  var coeff = pn.coeff
  var exp = pn.exp
  if int_eq[U256](a: coeff, b: zero_extend[U64, U256](0_u64))
    return if sign then "-0" else "0"
  var nd = digits10b(c: coeff)
  var adj = add[S64](a: exp, b: sub[S64](a: nd, b: 1_s64))
  var ten = zero_extend[U64, U256](10_u64)
  # `out`/`x`/`j` kept at function scope — builds the result in place (clean, and the
  # accumulator never escapes a branch). (The cross-scope-RC-assignment use-after-free
  # this originally worked around was root-caused + fixed in RecordCopyLoweringPass.)
  var out = ""
  var x = coeff
  var j = 0_s64
  if signed_le[S64](a: exp, b: 0_s64) and signed_ge[S64](a: adj, b: -6_s64)
    var frac = sub[S64](a: 0_s64, b: exp)
    while signed_lt[S64](a: j, b: nd)
      if int_eq[S64](a: j, b: frac) and signed_gt[S64](a: frac, b: 0_s64)
        out = "." + out
      var r = x % ten
      var dg = int_truncate[U256, U64](r)
      out = f"{dg}" + out
      x = x // ten
      j = add[S64](a: j, b: 1_s64)
    if signed_ge[S64](a: frac, b: nd)
      out = "0." + dec_zeros(n: sub[S64](a: frac, b: nd)) + out
  else
    while signed_lt[S64](a: j, b: nd)
      var r = x % ten
      var dg = int_truncate[U256, U64](r)
      if int_eq[S64](a: j, b: sub[S64](a: nd, b: 1_s64)) and signed_gt[S64](a: nd, b: 1_s64)
        out = f"{dg}" + "." + out
      else
        out = f"{dg}" + out
      x = x // ten
      j = add[S64](a: j, b: 1_s64)
    var mag = if signed_lt[S64](a: adj, b: 0_s64) then sub[S64](a: 0_s64, b: adj) else adj
    var es = if signed_lt[S64](a: adj, b: 0_s64) then "-" else "+"
    out = out + "E" + es + f"{mag}"
  return if sign then "-" + out else out

### Returns the decimal text of this value (full 70-digit formatter).
routine Decimal.represent() -> Text
  return d256b_represent(p: me.decode())

### Returns a debug rendering of this value, e.g. `Decimal(3.5)`. Mirrors the D32/D64/D128 surface.
routine Decimal.diagnose() -> Text
  return "Decimal(" + me.represent() + ")"
