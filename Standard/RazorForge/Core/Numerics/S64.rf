module Core

### A 64-bit signed integer in the range −9,223,372,036,854,775,808 to 9,223,372,036,854,775,807.
### `S64` is the default word-sized signed integer type in RazorForge.
@llvm("i64")
record S64 obeys SignedIntegral, Ordered, ConstCompatible, AtomicType
  pass

# Constants for S64 limits
preset S64_MIN: S64 = -9_223_372_036_854_775_808_s64
preset S64_MAX: S64 = 9_223_372_036_854_775_807_s64
preset S64_ZERO: S64 = 0_s64
preset S64_ONE: S64 = 1_s64

# ============================================================================
# Checked Creators (crash on overflow)
# ============================================================================

### Sign-extends a signed 8-bit integer to `S64`.
### :param from: The source value.
### :returns: The `S64` representation of `from`.
routine S64.$create(from: S8) -> S64
  return sign_extend[S8, S64](from)

### Sign-extends a signed 16-bit integer to `S64`.
### :param from: The source value.
### :returns: The `S64` representation of `from`.
routine S64.$create(from: S16) -> S64
  return sign_extend[S16, S64](from)

### Sign-extends a signed 32-bit integer to `S64`.
### :param from: The source value.
### :returns: The `S64` representation of `from`.
routine S64.$create(from: S32) -> S64
  return sign_extend[S32, S64](from)

### Returns `from` unchanged (identity conversion).
### :param from: The source value.
### :returns: `from`.
routine S64.$create(from: S64) -> S64
  return from

### Truncates a signed 128-bit integer to `S64`.
### :param from: The source value.
### :returns: The `S64` representation of `from`.
### :throws: {IntegerOverflowError} if `from` is outside the `S64` range.
routine S64.$create!(from: S128) -> S64
  if not (-9223372036854775808s128 <= from <= 9223372036854775807s128)
    throw IntegerOverflowError()
  return int_truncate[S128, S64](from)

### Zero-extends an unsigned 8-bit integer to `S64`.
### :param from: The source value.
### :returns: The `S64` representation of `from`.
routine S64.$create(from: U8) -> S64
  return zero_extend[U8, S64](from)

### Zero-extends an unsigned 16-bit integer to `S64`.
### :param from: The source value.
### :returns: The `S64` representation of `from`.
routine S64.$create(from: U16) -> S64
  return zero_extend[U16, S64](from)

### Zero-extends an unsigned 32-bit integer to `S64`.
### :param from: The source value.
### :returns: The `S64` representation of `from`.
routine S64.$create(from: U32) -> S64
  return zero_extend[U32, S64](from)

### Reinterprets a `U64` as `S64` using two's complement.
### :param from: The source value.
### :returns: The `S64` representation of `from`.
### :throws: {IntegerOverflowError} if `from` exceeds `S64_MAX`.
routine S64.$create!(from: U64) -> S64
  if from > 9223372036854775807_u64
    throw IntegerOverflowError()
  return reinterpret_bits[U64, S64](from)

### Truncates an unsigned 128-bit integer to `S64`.
### :param from: The source value.
### :returns: The `S64` representation of `from`.
### :throws: {IntegerOverflowError} if `from` exceeds `S64_MAX`.
routine S64.$create!(from: U128) -> S64
  if from > 9223372036854775807_u128
    throw IntegerOverflowError()
  return int_truncate[U128, S64](from)

### Truncates a 16-bit float to `S64` by first widening to `F32`.
### :param from: The source float value.
### :returns: The truncated `S64` representation.
routine S64.$create!(from: F16) -> S64
  return from.F32().S64!()

### Truncates a 32-bit float to `S64`, rounding toward zero.
### :param from: The source float value.
### :returns: The truncated `S64` representation.
routine S64.$create!(from: F32) -> S64
  if from.is_nan() or not (-9223372036854775808.0_f32 <= from <= 9223372036854775807.0_f32)
    throw IntegerOverflowError()
  return float_to_signed[F32, S64](from)

### Truncates a 64-bit float to `S64`, rounding toward zero.
### :param from: The source float value.
### :returns: The truncated `S64` representation.
routine S64.$create!(from: F64) -> S64
  if from.is_nan() or not (-9223372036854775808.0_f64 <= from <= 9223372036854775807.0_f64)
    throw IntegerOverflowError()
  return float_to_signed[F64, S64](from)

### Truncates a 128-bit float to `S64` by narrowing to `F64` first.
### :param from: The source float value.
### :returns: The truncated `S64` representation.
routine S64.$create!(from: F128) -> S64
  if from.is_nan() or not (-9223372036854775808.0_f128 <= from <= 9223372036854775807.0_f128)
    throw IntegerOverflowError()
  return from.F64().S64!()

### Converts a 32-bit decimal float to `S64`.
### :param from: The source decimal float value.
### :returns: The truncated `S64` representation.
routine S64.$create!(from: D32) -> S64
  return D128(from: from).to_s128!().S64!()

### Converts a 64-bit decimal float to `S64`.
### :param from: The source decimal float value.
### :returns: The truncated `S64` representation.
routine S64.$create!(from: D64) -> S64
  return D128(from: from).to_s128!().S64!()

### Converts a 128-bit decimal float to `S64`.
### :param from: The source decimal float value.
### :returns: The truncated `S64` representation.
routine S64.$create!(from: D128) -> S64
  return from.to_s128!().S64!()

# ============================================================================
# Arithmetic Operations
# ============================================================================

### Returns the sum of this value and `you`, and a flag indicating whether the result overflowed.
### :param you: The right operand.
### :returns: A tuple of `(sum, overflow_flag)`.
routine S64.add_with_overflow(you: S64) -> (S64, Bool)
  return signed_add_checked[S64](me, you)

### Returns the difference `me - you`, and a flag indicating whether the result overflowed.
### :param you: The value to subtract.
### :returns: A tuple of `(difference, overflow_flag)`.
routine S64.sub_with_overflow(you: S64) -> (S64, Bool)
  return signed_sub_checked[S64](me, you)

### Returns the product of this value and `you`, and a flag indicating whether the result overflowed.
### :param you: The right operand.
### :returns: A tuple of `(product, overflow_flag)`.
routine S64.mul_with_overflow(you: S64) -> (S64, Bool)
  return signed_mul_checked[S64](me, you)

### Returns `me + you`, throwing on overflow.
### :param you: The right operand.
### :returns: The sum.
### :throws: {IntegerOverflowError} if the result is outside the `S64` range.
routine S64.$add!(you: S64) -> S64
  var result = me.add_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me - you`, throwing on overflow.
### :param you: The value to subtract.
### :returns: The difference.
### :throws: {IntegerOverflowError} if the result is outside the `S64` range.
routine S64.$sub!(you: S64) -> S64
  var result = me.sub_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me * you`, throwing on overflow.
### :param you: The right operand.
### :returns: The product.
### :throws: {IntegerOverflowError} if the result is outside the `S64` range.
routine S64.$mul!(you: S64) -> S64
  var result = me.mul_with_overflow(you)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me // you` (floor division), throwing on errors.
### Floor division rounds toward negative infinity, unlike truncation-division.
### :param you: The divisor.
### :returns: The floor quotient.
### :throws: {DivisionByZeroError} if `you == 0`.
### :throws: {IntegerOverflowError} if `me == S64_MIN and you == -1`.
routine S64.$floordiv!(you: S64) -> S64
  if you == 0
    throw DivisionByZeroError()
  if me == S64_MIN and you == -1_s64
    throw IntegerOverflowError()
  var quotient = signed_div[S64](a: me, b: you)
  var remainder = signed_rem[S64](a: me, b: you)
  if remainder < 0_s64
    if you > 0_s64
      return quotient - 1_s64
    return quotient + 1_s64
  return quotient

### Returns `me % you` (floor modulo), where the result sign matches `you`.
### :param you: The divisor.
### :returns: The floor remainder.
### :throws: {DivisionByZeroError} if `you == 0`.
routine S64.$mod!(you: S64) -> S64
  if you == 0
    throw DivisionByZeroError()
  var remainder = signed_rem[S64](a: me, b: you)
  if remainder < 0_s64
    if you > 0_s64
      return remainder + you
    return remainder - you
  return remainder

### Returns `-me` (arithmetic negation).
### :returns: The negated value.
routine S64.$neg!() -> S64
  if me == -9223372036854775808_s64
    throw IntegerOverflowError()
  return sub[S64](a: 0_s64, b: me)

# ============================================================================
# Wrapping Arithmetic (+%, -%, *%)
# ============================================================================

### Returns `(me + you) mod 2⁶⁴` in two's complement, without overflow check.
### :param you: The right operand.
### :returns: The wrapped sum.
routine S64.$add_wrap(you: S64) -> S64
  return add[S64](a: me, b: you)

### Returns `(me - you) mod 2⁶⁴` in two's complement, without overflow check.
### :param you: The value to subtract.
### :returns: The wrapped difference.
routine S64.$sub_wrap(you: S64) -> S64
  return sub[S64](a: me, b: you)

### Returns `(me * you) mod 2⁶⁴` in two's complement, without overflow check.
### :param you: The right operand.
### :returns: The wrapped product.
routine S64.$mul_wrap(you: S64) -> S64
  return mul[S64](a: me, b: you)

# ============================================================================
# Unchecked Arithmetic (+!, -!, *!, //!, %!)
# ============================================================================

### Returns `me + you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The sum.
dangerous routine S64.$add_unchecked(you: S64) -> S64
  return signed_add_exact[S64](a: me, b: you)

### Returns `me - you` with undefined behavior on overflow.
### :param you: The value to subtract.
### :returns: The difference.
dangerous routine S64.$sub_unchecked(you: S64) -> S64
  return signed_sub_exact[S64](a: me, b: you)

### Returns `me * you` with undefined behavior on overflow.
### :param you: The right operand.
### :returns: The product.
dangerous routine S64.$mul_unchecked(you: S64) -> S64
  return signed_mul_exact[S64](a: me, b: you)

### Returns `me // you` (floor division) with undefined behavior if `you` is zero.
### :param you: The divisor.
### :returns: The floor quotient.
dangerous routine S64.$floordiv_unchecked(you: S64) -> S64
  var quotient = signed_div[S64](a: me, b: you)
  var remainder = signed_rem[S64](a: me, b: you)
  if remainder < 0_s64
    if you > 0_s64
      return quotient - 1_s64
    return quotient + 1_s64
  return quotient

### Returns `me % you` (floor modulo) with undefined behavior if `you` is zero.
### :param you: The divisor.
### :returns: The floor remainder.
dangerous routine S64.$mod_unchecked(you: S64) -> S64
  var remainder = signed_rem[S64](a: me, b: you)
  if remainder < 0_s64
    if you > 0_s64
      return remainder + you
    return remainder - you
  return remainder

# ============================================================================
# Clamping Arithmetic (+^, -^, *^)
# ============================================================================

### Returns `me + you`, clamped to `[S64_MIN, S64_MAX]` on overflow.
### :param you: The right operand.
### :returns: The clamped sum.
routine S64.$add_clamp(you: S64) -> S64
  return signed_add_sat[S64](a: me, b: you)

### Returns `me - you`, clamped to `[S64_MIN, S64_MAX]` on overflow.
### :param you: The value to subtract.
### :returns: The clamped difference.
routine S64.$sub_clamp(you: S64) -> S64
  return signed_sub_sat[S64](a: me, b: you)

### Returns `me * you`, clamped to `[S64_MIN, S64_MAX]` on overflow.
### :param you: The right operand.
### :returns: The clamped product.
routine S64.$mul_clamp(you: S64) -> S64
  var wide = mul[S128](sign_extend[S64, S128](me), sign_extend[S64, S128](you))
  if signed_gt[S128](wide, 9223372036854775807_s128)
    return S64_MAX
  if signed_lt[S128](wide, -9223372036854775808_s128)
    return S64_MIN
  return int_truncate[S128, S64](wide)

# ============================================================================
# Power Operations (**)
# ============================================================================

### Returns `me ** exp` and an overflow flag.
### Uses repeated squaring. `0 ** 0 == 1` (the empty product); a negative exponent crashes
### with NumericDomainError (the result would not be an integer).
### :param exp: The exponent. Must be non-negative.
### :returns: A tuple of `(result, overflow_flag)`.
### :throws: {NumericDomainError} if `exp < 0`.
routine S64.pow_with_overflow!(exp: S64) -> (S64, Bool)
  var result: S64 = 1
  var base: S64 = me
  var e: S64 = exp
  var overflow = false
  if exp < 0
    throw NumericDomainError(description: "Negative exponent: an integer raised to a negative power has no integer result.")
  while e > 0
    if (e & 1) == 1
      var mul_result = result.mul_with_overflow(base)
      result = mul_result.item0
      overflow = overflow or mul_result.item1
    e = e >> 1_u32
    if e > 0
      var square_result = base.mul_with_overflow(base)
      base = square_result.item0
      overflow = overflow or square_result.item1
  return (result, overflow)

### Returns `me ** exp`, throwing on overflow.
### :param exp: The exponent. Must be non-negative.
### :returns: The result.
### :throws: {IntegerOverflowError} if the result is outside the `S64` range.
routine S64.$pow!(exp: S64) -> S64
  var result = me.pow_with_overflow!(exp)
  if result.item1
    throw IntegerOverflowError()
  return result.item0

### Returns `me ** exp` with wrapping arithmetic.
### :param exp: The exponent. Must be non-negative.
### :returns: The result modulo 2⁶⁴ in two's complement.
routine S64.$pow_wrap!(exp: S64) -> S64
  if exp < 0_s64
    throw NumericDomainError(description: "Negative exponent: an integer raised to a negative power has no integer result.")
  var result: S64 = 1
  var base: S64 = me
  var e: U32 = U32(exp)
  while e > 0
    if (e & 1) == 1
      result = result.$mul_wrap(base)
    e = e >> 1_u32
    if e > 0
      base = base.$mul_wrap(base)
  return result

### Returns `me ** exp` clamped to `[S64_MIN, S64_MAX]` on overflow.
### :param exp: The exponent. Must be non-negative.
### :returns: The clamped result.
routine S64.$pow_clamp!(exp: S64) -> S64
  var result: S64 = 1
  var base: S64 = me
  if exp < 0
    throw NumericDomainError(description: "Negative exponent: an integer raised to a negative power has no integer result.")
  while exp > 0
    if (exp & 1) == 1
      result = result.$mul_clamp(base)
    exp = exp >> 1_u32
    if exp > 0
      base = base.$mul_clamp(base)
  return result

# ============================================================================
# Bitwise Operations
# ============================================================================

### Returns `me & you` (bitwise AND).
### :param you: The right operand.
### :returns: The bitwise intersection.
routine S64.$bitand(you: S64) -> S64
  return bit_and[S64](a: me, b: you)

### Returns `me | you` (bitwise OR).
### :param you: The right operand.
### :returns: The bitwise union.
routine S64.$bitor(you: S64) -> S64
  return bit_or[S64](a: me, b: you)

### Returns `me ^ you` (bitwise XOR).
### :param you: The right operand.
### :returns: The bitwise exclusive-or.
routine S64.$bitxor(you: S64) -> S64
  return bit_xor[S64](a: me, b: you)

### Returns `~me` (bitwise NOT).
### :returns: The bitwise complement.
routine S64.$bitnot() -> S64
  return bit_xor[S64](a: me, b: -1)

# ============================================================================
# Shift Operations (<<, <<?>, >>, <<<, >>>)
# ============================================================================

### Returns `me << bits` (arithmetic left shift).
### :param bits: The number of bit positions to shift.
### :returns: The shifted value.
routine S64.$ashl(bits: U32) -> S64
  return shift_left[S64](me, S64(bits))

### Returns `me >> bits` (arithmetic right shift, sign-filling).
### :param bits: The number of bit positions to shift.
### :returns: The shifted value.
routine S64.$ashr(bits: U32) -> S64
  return shift_right_signed[S64](me, S64(bits))

### Returns `me << bits` (logical left shift).
### :param bits: The number of bit positions to shift.
### :returns: The shifted value.
routine S64.$lshl(bits: U32) -> S64
  return shift_left[S64](me, S64(bits))

### Returns `me >> bits` (logical right shift, zero-filling).
### :param bits: The number of bit positions to shift.
### :returns: The shifted value.
routine S64.$lshr(bits: U32) -> S64
  return shift_right_unsigned[S64](me, S64(bits))

# ============================================================================
# Comparison Operations
# ============================================================================

### Returns true if both values are equal.
### :param you: The value to compare against.
### :returns: `true` if `me == you`.
routine S64.$eq(you: S64) -> Bool
  return int_eq[S64](a: me, b: you)

### Returns the ordering relationship between this value and `you`.
### :param you: The value to compare against.
### :returns: `ME_SMALL` if `me < you`, `ME_LARGE` if `me > you`, `SAME` if equal.
routine S64.$cmp(you: S64) -> ComparisonSign
  if signed_lt[S64](me, you)
    return ME_SMALL
  if signed_gt[S64](me, you)
    return ME_LARGE
  return SAME

# ============================================================================
# Math Operations
# ============================================================================

### Returns the absolute value of this value.
### :returns: `me` if non-negative; `-me` otherwise.
### :throws: {IntegerOverflowError} when `me` is `S64_MIN` (its magnitude is not representable in S64).
routine S64.abs!() -> S64
  if me == -9223372036854775808_s64
    throw IntegerOverflowError()
  return int_abs[S64](me)

### Returns the smaller of this value and `you`.
### :param you: The value to compare.
### :returns: `me` if `me <= you`; otherwise `you`.
routine S64.min(you: S64) -> S64
  if me <= you
    return me
  else
    return you

### Returns the larger of this value and `you`.
### :param you: The value to compare.
### :returns: `me` if `me >= you`; otherwise `you`.
routine S64.max(you: S64) -> S64
  if me >= you
    return me
  else
    return you

### Returns this value clamped to the inclusive range `[min_val, max_val]`.
### :param min_val: The lower bound of the allowed range.
### :param max_val: The upper bound of the allowed range.
### :returns: `min_val` if `me < min_val`; `max_val` if `me > max_val`; `me` otherwise.
@positional
routine S64.clamp(min_val: S64, max_val: S64) -> S64
  return me.min(max_val).max(min_val)

# ============================================================================
# Bit Manipulation
# ============================================================================

### Returns the number of bits set to one (popcount).
### :returns: The count of set bits in the 64-bit representation.
routine S64.count_ones() -> S64
  return count_ones[S64](me)

### Returns the number of bits set to zero.
### :returns: `64` minus the popcount.
routine S64.count_zeros() -> S64
  return 64_s64 -% me.count_ones()

### Returns the number of consecutive zero bits before the highest set bit.
### :returns: The leading zero count; `64` if the value is zero.
routine S64.leading_zeros() -> S64
  return leading_zeros[S64](me)

### Returns the number of consecutive zero bits starting from the least significant bit.
### :returns: The trailing zero count; `64` if the value is zero.
routine S64.trailing_zeros() -> S64
  return trailing_zeros[S64](me)

### Returns the number of consecutive one bits before the highest clear bit.
### :returns: The leading one count.
routine S64.leading_ones() -> S64
  return me.$bitnot().leading_zeros()

### Returns the number of consecutive one bits starting from the least significant bit.
### :returns: The trailing one count.
routine S64.trailing_ones() -> S64
  return me.$bitnot().trailing_zeros()

### Returns this value with the bit order reversed.
### :returns: The bit-reversed value.
routine S64.reverse_bits() -> S64
  return reverse_bits[S64](me)

### Returns this value with the byte order reversed (big/little endian swap).
### :returns: The byte-swapped value.
routine S64.swap_bytes() -> S64
  return byte_swap[S64](me)

# ============================================================================
# Utility Methods
# ============================================================================

### Returns true if this value is strictly greater than zero.
### :returns: `true` when `me > 0`.
routine S64.is_positive() -> Bool
  return me > 0_s64

### Returns true if this value is strictly less than zero.
### :returns: `true` when `me < 0`.
routine S64.is_negative() -> Bool
  return me < 0_s64

### Returns true if this value is zero.
### :returns: `true` when `me == 0`.
routine S64.is_zero() -> Bool
  return me == 0_s64

### Returns true if this value is even.
### :returns: `true` when the least significant bit is clear.
routine S64.is_even() -> Bool
  var result = bit_and[S64](a: me, b: 1_s64)
  return int_eq[S64](a: result, b: 0_s64)

### Returns true if this value is odd.
### :returns: `true` when the least significant bit is set.
routine S64.is_odd() -> Bool
  return not me.is_even()

### Returns the sign of this value as −1, 0, or 1.
### :returns: `1` if positive, `−1` if negative, `0` if zero.
routine S64.signum() -> S64
  return when
    me > 0_s64 => 1_s64
    me < 0_s64 => -1_s64
    else => 0_s64

### Returns true if this value is an exact power of two.
### Negative values always return `false`.
### :returns: `true` if `me > 0 and (me & (me - 1)) == 0`.
routine S64.is_power_of_two() -> Bool
  var is_pos = signed_gt[S64](me, 0_s64)
  var minus_one = sub[S64](a: me, b: 1_s64)
  var anded = bit_and[S64](a: me, b: minus_one)
  var is_zero = int_eq[S64](a: anded, b: 0_s64)
  return is_pos and is_zero

# ============================================================================
# Text Representation and Parsing
# ============================================================================

routine S64.$represent() -> Text
  if me == 0s64
    return "0"
  if me > 0s64
    return U64(me).$represent()
  # Use reinterpret_bits (not U64(me)) — U64.$create!(S64) throws on negative inputs,
  # and we need the raw bit pattern so the two's-complement negation `0u64 -% bits`
  # yields |me| (works correctly even for S64.MIN, whose absolute value overflows S64).
  return "-" + (0u64 -% reinterpret_bits[S64, U64](me)).$represent()

routine S64.$diagnose() -> Text
  return "S64(" + me.$represent() + ")"

### Parses a decimal text representation of an `S64`.
### Accepts an optional leading `+` or `-` sign followed by ASCII decimal digits.
### :param from_text: The text to parse.
### :returns: The parsed `S64` value.
### :throws: {InvalidValueError} if the text is empty or contains non-digit characters.
routine S64.$create!(from_text: Text) -> S64
  if from_text.count() == 0u64
    throw InvalidValueError(input: from_text, target: "S64")
  var start = 0u64
  var negative = false
  var first = from_text[0u64]
  if first == Character(0x002Du32)
    negative = true
    start = 1u64
  elseif first == Character(0x002Bu32)
    start = 1u64
  if start >= from_text.count()
    throw InvalidValueError(input: from_text, target: "S64")
  var result = 0u64
  var i = start
  while i < from_text.count()
    var ch = from_text[i]
    if ch.is_numeric()
      result = result * 10u64 + U64(ch.digit_value())
    else
      throw InvalidValueError(input: from_text, target: "S64")
    i = i + 1u64
  if negative
    if result > 9223372036854775808_u64
      throw IntegerOverflowError()
    return reinterpret_bits[U64, S64](0u64 -% result)
  return S64(result)

# ============================================================================
# Hashing
# ============================================================================

### Returns an xxHash64-based hash of this value.
### :returns: The 64-bit hash.
routine S64.$fast_hash() -> U64
  return __hash_leaf(v: reinterpret_bits[S64, U64](me))

### Returns a SipHash-2-4 keyed hash of this value.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: The 64-bit keyed hash.
routine S64.$hash(k0: U64, k1: U64) -> U64
  return __secure_hash_u64(v: reinterpret_bits[S64, U64](me), k0: k0, k1: k1)
