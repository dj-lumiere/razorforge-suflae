    p = p.fma_finite(b: w, c: UnpackedFloat[N, N2].make(mant: UnpackedFloat[N, N2].from_u128_mant(v: 0x618613589b1a2c2a583e85a4e0a7c0e2_u128), exp: -6_s64, fpclass: POSITIVE_NORMAL))
