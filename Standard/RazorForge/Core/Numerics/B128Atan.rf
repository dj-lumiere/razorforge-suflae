### atan(k/32) for k in 1..32 (k<=0 -> +0), W-dispatched limb-table index accessor.
common routine UnpackedFloat[N, N2].atan_tab(k: S64) -> UnpackedFloat[N, N2]
  if LLVM::signed_le(a: k, b: 0_s64)
    return UnpackedFloat[N, N2].zero(sign: false)
  var ck = k
  if LLVM::signed_gt(a: ck, b: 32_s64)
    ck = 32_s64
  var ui = LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: ck, b: 1_s64))
  if LLVM::int_eq[U64](a: N, b: 2_u64)
    var p = LLVM::mul(a: ui, b: 2_u64)
    return UnpackedFloat[N, N2].make(mant: UnpackedFloat[N, N2].words2(h1: ATAN_TAB_QUAD_MANT[LLVM::add(a: p, b: 1_u64)], h0: ATAN_TAB_QUAD_MANT[p]), exp: ATAN_TAB_QUAD_EXP[ui], fpclass: POSITIVE_NORMAL)
  var p = LLVM::mul(a: ui, b: 3_u64)
  return UnpackedFloat[N, N2].make(mant: UnpackedFloat[N, N2].words3(h2: ATAN_TAB_F192_MANT[LLVM::add(a: p, b: 2_u64)], h1: ATAN_TAB_F192_MANT[LLVM::add(a: p, b: 1_u64)], h0: ATAN_TAB_F192_MANT[p]), exp: ATAN_TAB_F192_EXP[ui], fpclass: POSITIVE_NORMAL)

