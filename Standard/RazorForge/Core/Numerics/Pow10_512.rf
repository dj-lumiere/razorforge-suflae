### True iff k is inside the table range [-400, 400].
routine f512_pow10_in_table(k: S64) -> Bool
  return signed_ge[S64](a: k, b: -400_s64) and signed_le[S64](a: k, b: 400_s64)

### Correctly-rounded 10^k as F512 via table lookup (caller guards range).
### Limbs big-endian (h7 first). Index with a plain running pointer var (generic
### calls inside `[]` don't lower), rebuild U512 inline (no generic uf_w8 call).
routine f512_pow10_tbl(k: S64) -> F512
  var p = mul[U64](a: reinterpret_bits[S64, U64](add[S64](a: k, b: 400_s64)), b: 8_u64)
  var acc = zero_extend[U64, U512](POW10_512_LIMBS[p])
  p = add[U64](a: p, b: 1_u64)
  acc = bit_or[U512](a: shift_left[U512](value: acc, bits: 64), b: zero_extend[U64, U512](POW10_512_LIMBS[p]))
  p = add[U64](a: p, b: 1_u64)
  acc = bit_or[U512](a: shift_left[U512](value: acc, bits: 64), b: zero_extend[U64, U512](POW10_512_LIMBS[p]))
  p = add[U64](a: p, b: 1_u64)
  acc = bit_or[U512](a: shift_left[U512](value: acc, bits: 64), b: zero_extend[U64, U512](POW10_512_LIMBS[p]))
  p = add[U64](a: p, b: 1_u64)
  acc = bit_or[U512](a: shift_left[U512](value: acc, bits: 64), b: zero_extend[U64, U512](POW10_512_LIMBS[p]))
  p = add[U64](a: p, b: 1_u64)
  acc = bit_or[U512](a: shift_left[U512](value: acc, bits: 64), b: zero_extend[U64, U512](POW10_512_LIMBS[p]))
  p = add[U64](a: p, b: 1_u64)
  acc = bit_or[U512](a: shift_left[U512](value: acc, bits: 64), b: zero_extend[U64, U512](POW10_512_LIMBS[p]))
  p = add[U64](a: p, b: 1_u64)
  acc = bit_or[U512](a: shift_left[U512](value: acc, bits: 64), b: zero_extend[U64, U512](POW10_512_LIMBS[p]))
  return F512.from_bits(bits: acc)
