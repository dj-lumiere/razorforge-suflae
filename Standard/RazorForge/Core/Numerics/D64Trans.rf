### 10^e as a DD via a two-level sqrt-split power-of-ten table (S=20 = ceil(sqrt(398))): with a=|e|,
### hi=a/S, lo=a%S, the result is HIGH[hi]*LOW[lo] (ONE DD multiply, zero division, zero binary-exp
### loop). Both signs store their powers directly (NO 1/positive division). Each table entry is a DD
### (hi,lo) pair reconstructed from its stored IEEE bit patterns (exact); non-exact/large/negative
### entries were rounded round-half-even at ~120-digit precision, far beyond DD's ~31 digits. The
### magnitude boundary matches the old binary-exp path: powers past f64's range saturate to +inf
### (10^320..10^400) or underflow to 0 (10^-340..10^-398). |e|>398 clamps to the table's inf/0 edge.
routine dd_pow10(e: S64) -> DD
  var neg = LLVM::signed_lt(a: e, b: 0_s64)
  var a = if neg then LLVM::sub(a: 0_s64, b: e) else e
  var hi_i = LLVM::signed_div(a: a, b: 20_s64)
  var lo_i = LLVM::signed_rem(a: a, b: 20_s64)
  if LLVM::signed_gt(a: hi_i, b: 20_s64)
    hi_i = 20_s64
  var hu = LLVM::reinterpret_bits[S64, U64](hi_i)
  var lu = LLVM::reinterpret_bits[S64, U64](lo_i)
  if neg
    var hin = DD(hi: F64.from_bits(bits: DD_POW10_HN_HI[hu]), lo: F64.from_bits(bits: DD_POW10_HN_LO[hu]))
    var lon = DD(hi: F64.from_bits(bits: DD_POW10_LN_HI[lu]), lo: F64.from_bits(bits: DD_POW10_LN_LO[lu]))
    return hin.mul(you: lon)
  var hip = DD(hi: F64.from_bits(bits: DD_POW10_HP_HI[hu]), lo: F64.from_bits(bits: DD_POW10_HP_LO[hu]))
  var lop = DD(hi: F64.from_bits(bits: DD_POW10_LP_HI[lu]), lo: F64.from_bits(bits: DD_POW10_LP_LO[lu]))
  return hip.mul(you: lop)

### A U64 coefficient (<=16 digits) as an exact DD. Split into the top 8 and bottom 8
### decimal digits; each half is < 10^8 < 2^53 so converts to f64 exactly, then
### reassembled as chi*10^8 + clo (DD add is error-free for these exact terms).
routine u64_coeff_to_dd(c: U64) -> DD
  var chi = LLVM::unsigned_div(a: c, b: 100000000_u64)
  var clo = LLVM::unsigned_rem(a: c, b: 100000000_u64)
  var hi = dd_of(x: LLVM::unsigned_to_float[U64, F64](chi)).mul(you: dd_pow10(e: 8_s64))
  return hi.add(you: dd_of(x: LLVM::unsigned_to_float[U64, F64](clo)))

### Rounds a positive DD ~integer (< 10^18, comfortably within U64) to a U64, round-half-even.
### Adds 0.5 and floors; on an exact half the floor lands even-or-odd per the fractional part,
### which for a 16-17 digit decimal coefficient is well below DD's ~31-digit resolution.
routine dd_to_u64_round(u: DD) -> U64
  var r = u.add(you: dd_of(x: 0.5_f64)).floor()
  # split the integer DD into top (r/1e9) and bottom (r%1e9) halves; each < 10^9 < 2^53.
  var scale = dd_pow10(e: 9_s64)
  var qhi = r.div(you: scale).floor()
  var lo = r.sub(you: qhi.mul(you: scale))
  var hi_u = LLVM::float_to_unsigned[F64, U64](qhi.to_f64())
  var lo_u = LLVM::float_to_unsigned[F64, U64](lo.to_f64())
  return LLVM::add(a: LLVM::mul(a: hi_u, b: 1000000000_u64), b: lo_u)

### dec -> DD: D64 value as a DD (coeff exact, scaled by 10^exp). Specials return
### DD sentinels: inf as a huge value, NaN as 0/0, signed zero preserved by sign.
routine d64_to_dd(x: D64) -> DD
  var p = x.decode()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    var inf = dd_of(x: 1.0_f64).div(you: dd_of(x: 0.0_f64))
    return if p.sign then inf.neg() else inf
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return dd_of(x: 0.0_f64).div(you: dd_of(x: 0.0_f64))
  if LLVM::int_eq(a: p.coeff, b: 0_u64)
    return if p.sign then dd_of(x: 0.0_f64).neg() else dd_of(x: 0.0_f64)
  var mag = u64_coeff_to_dd(c: p.coeff).mul(you: dd_pow10(e: p.exp))
  return if p.sign then mag.neg() else mag

### bin -> dec: DD value as a D64, rounded to <=16 digits. Non-finite DD (via to_f64
### classification on the hi limb) maps to inf/NaN; zero and signed zero preserved.
routine dd_to_d64(x: DD) -> D64
  var f = x.to_f64()
  if f.is_nan()
    return D64.quiet_nan()
  if f.is_infinite()
    return D64.infinity(sign: LLVM::float_lt[F64](a: x.hi, b: 0.0_f64))
  if LLVM::float_eq[F64](a: x.hi, b: 0.0_f64)
    return d64_of_parts(p: D64Parts(sign: LLVM::float_lt[F64](a: LLVM::copysign[F64](value: 1.0_f64, sign: x.hi), b: 0.0_f64), special: 0_u64, exp: 0_s64, coeff: 0_u64))
  var sign = LLVM::float_lt[F64](a: x.hi, b: 0.0_f64)
  var ax = x.abs()
  # est. decimal exponent from log10 of the hi limb (faithful; the scale below corrects).
  var decexp = LLVM::float_to_signed[F64, S64](LLVM::floor[F64](value: LLVM::log10[F64](value: ax.hi)))
  # scale so the coefficient lands as a ~16-digit integer (15 - decexp), then round to U64.
  var q = LLVM::sub(a: 15_s64, b: decexp)
  var coeff = dd_to_u64_round(u: ax.mul(you: dd_pow10(e: q)))
  # pref = qmax (369) makes decfin64 strip ALL trailing zeros after rounding to 16 digits,
  # so a DD->decimal result is stored reduced, not padded.
  return d64_of_parts(p: decfin64(sign: sign, coeff: LLVM::zero_extend[U64, U128](coeff), exp: LLVM::sub(a: 0_s64, b: q), pref: 369_s64))

# ============================================================================
# Binary <-> decimal bridge (dec <-> bin128). Engine = UnpackedFloat[U128, U256, 128] (= F128).
# Used BOTH for the correctly-rounded D64 <-> F32/F64/F128 conversions AND (below) for every D64
# transcendental: F128's ~34-digit significand and ±4932 binary exponent fully cover decimal64's 16
# digits and its ±385 decimal range, so an out-of-F64-range D64 (e.g. log(1e380) = 875.06…) converts
# and evaluates correctly — where the old DD (double-double) engine overflowed to inf because DD
# shares F64's ±308 range. Width constants mirror uf256_from_u128 with W=128.
# ============================================================================

### Builds the engine value of a U64 integer with the given sign (exact; <=64 bits
### fits the 113-bit significand). value = mant * 2^(exp-125), MSB at bit 126.
routine uf128_from_u64(c: U64, sign: Bool) -> UnpackedFloat[U128, U256, 128]
  if LLVM::int_eq(a: c, b: 0_u64)
    return UnpackedFloat[U128, U256, 128].zero(sign: sign)
  var cw = LLVM::zero_extend[U64, U128](c)
  var x = LLVM::sub(a: 128_s64, b: LLVM::int_truncate[U128, S64](LLVM::leading_zeros(cw)))
  var mant = LLVM::shift_left(value: cw, bits: U128.to_width(s: LLVM::sub(a: 127_s64, b: x)))
  return UnpackedFloat[U128, U256, 128].make(mant: mant, exp: LLVM::sub(a: x, b: 2_s64), fpclass: SignedFpClass.from_flags(sign: sign, iszero: false, isinf: false, isnan: false))

### Rounds the engine value (assumed a positive ~integer) to a U128, round-half-even.
### shift = 125 - exp (positive in the ~10^20 range).
routine uf128_to_u128_round(u: UnpackedFloat[U128, U256, 128]) -> U128
  var shift = LLVM::sub(a: 125_s64, b: u.exp)
  if LLVM::signed_le(a: shift, b: 0_s64)
    return LLVM::shift_left(value: u.mant, bits: U128.to_width(s: LLVM::sub(a: 0_s64, b: shift)))
  if LLVM::signed_ge(a: shift, b: 128_s64)
    return LLVM::zero_extend[U64, U128](0_u64)
  var q = LLVM::shift_right_unsigned(u.mant, U128.to_width(s: shift))
  var lost = LLVM::bit_and(a: u.mant, b: U128.low_mask(n: shift))
  var half = LLVM::shift_left[U128](value: 1, bits: U128.to_width(s: LLVM::sub[S64](a: shift, b: 1_s64)))
  if LLVM::unsigned_gt(a: lost, b: half)
    q = LLVM::add[U128](a: q, b: 1)
  elseif LLVM::int_eq[U128](a: lost, b: half) and LLVM::int_ne[U128](a: LLVM::bit_and[U128](a: q, b: 1), b: 0)
    q = LLVM::add[U128](a: q, b: 1)
  return q

# ============================================================================
# Tabled 10^e for the W=128 engine (sqrt-split S=20 over decimal64's |e| <= 398), mirroring
# uf192_pow10: a = |e|, hi = a/20, lo = a%20, result = HIGH[hi] * LOW[lo] — ONE engine multiply,
# no binary-exponentiation loop (which made the D64<->F128 path slower than the wider D128<->F192).
# Each entry is the round-half-even nearest W=128 significand (mant, exp) to the true power; the split
# product is faithful to ~37 digits (>> decimal64's 16 and F128's 34). Mantissa stored as 2*U64 words
# (from_words2), value = mant * 2^(exp-125) (the uf128_from_u64 convention).
# ============================================================================
