routine pow10_hp128(idx: U64) -> UnpackedFloat[U128, U256, 128]
  var p = LLVM::mul(a: idx, b: 2_u64)
  return UnpackedFloat[U128, U256, 128].make(mant: U128.from_words2(h1: D64_UF128_HP_MANT[p], h0: D64_UF128_HP_MANT[LLVM::add(a: p, b: 1_u64)]), exp: D64_UF128_HP_EXP[idx], fpclass: POSITIVE_NORMAL)
routine pow10_lp128(idx: U64) -> UnpackedFloat[U128, U256, 128]
  var p = LLVM::mul(a: idx, b: 2_u64)
  return UnpackedFloat[U128, U256, 128].make(mant: U128.from_words2(h1: D64_UF128_LP_MANT[p], h0: D64_UF128_LP_MANT[LLVM::add(a: p, b: 1_u64)]), exp: D64_UF128_LP_EXP[idx], fpclass: POSITIVE_NORMAL)
routine pow10_hn128(idx: U64) -> UnpackedFloat[U128, U256, 128]
  var p = LLVM::mul(a: idx, b: 2_u64)
  return UnpackedFloat[U128, U256, 128].make(mant: U128.from_words2(h1: D64_UF128_HN_MANT[p], h0: D64_UF128_HN_MANT[LLVM::add(a: p, b: 1_u64)]), exp: D64_UF128_HN_EXP[idx], fpclass: POSITIVE_NORMAL)
routine pow10_ln128(idx: U64) -> UnpackedFloat[U128, U256, 128]
  var p = LLVM::mul(a: idx, b: 2_u64)
  return UnpackedFloat[U128, U256, 128].make(mant: U128.from_words2(h1: D64_UF128_LN_MANT[p], h0: D64_UF128_LN_MANT[LLVM::add(a: p, b: 1_u64)]), exp: D64_UF128_LN_EXP[idx], fpclass: POSITIVE_NORMAL)

### 10^e as a W=128 engine value via the sqrt-split table (one engine multiply, no loop). Covers
### decimal64's |e| <= 398; |e| beyond that saturates at the table edge (folds to inf/0 downstream).
routine uf128_pow10(e: S64) -> UnpackedFloat[U128, U256, 128]
  var neg = LLVM::signed_lt(a: e, b: 0_s64)
  var a = if neg then LLVM::sub(a: 0_s64, b: e) else e
  var au = LLVM::reinterpret_bits[S64, U64](a)
  var hi = LLVM::unsigned_div(a: au, b: 20_u64)
  var lo = LLVM::unsigned_rem(a: au, b: 20_u64)
  if LLVM::unsigned_gt(a: hi, b: 20_u64)
    hi = 20_u64
  if neg
    return pow10_hn128(idx: hi).mul(you: pow10_ln128(idx: lo))
  return pow10_hp128(idx: hi).mul(you: pow10_lp128(idx: lo))

### dec -> bin: D64 value as an F128 (coeff exact, scaled by 10^exp).
routine d64_to_f128(x: D64) -> F128
  var p = x.decode()
  var s = if p.sign then 1_u64 else 0_u64
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return F128.from_bits(bits: f128_inf(sign: s))
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return F128.from_bits(bits: f128_qnan())
  if LLVM::int_eq(a: p.coeff, b: 0_u64)
    # signed zero: sign bit (s) at bit 127, all else 0
    return F128.from_bits(bits: LLVM::shift_left(value: LLVM::zero_extend[U64, U128](s), bits: U128.to_width(s: 127_s64)))
  # coeff (exact, <=16 digits fits the 113-bit significand) scaled by 10^exp — ONE tabled engine mul
  return uf128_from_u64(c: p.coeff, sign: p.sign).mul(you: uf128_pow10(e: p.exp)).to_f128()

### bin -> dec: F128 value as a D64, correctly rounded to <=16 digits.
routine f128_to_d64(x: F128) -> D64
  if x.is_nan()
    return D64.quiet_nan()
  if x.is_infinite()
    return D64.infinity(sign: x.is_negative())
  if x.is_zero()
    return d64_of_parts(p: D64Parts(sign: x.is_negative(), special: 0_u64, exp: 0_s64, coeff: 0_u64))
  var sign = x.is_negative()
  var e_bin = x.to_uf().ilogb()
  # est. decimal exponent: e_bin * log10(2) where 315653/1048576 ~ log10(2) (2^-20 scale)
  var decexp = LLVM::signed_div(a: LLVM::mul(a: e_bin, b: 315653_s64), b: 1048576_s64)
  # scale so the coefficient lands as a ~21-digit integer (20 - decexp), then round to U128
  var q = LLVM::sub(a: 20_s64, b: decexp)
  var scaled = x.abs().to_uf().mul(you: uf128_pow10(e: q))
  var coeff = uf128_to_u128_round(u: scaled)
  # Normalize the result cohort: pref = qmax (369) makes decfin64 strip ALL trailing zeros
  # after rounding to 16 digits, so a float->decimal result is stored reduced, not padded.
  return d64_of_parts(p: decfin64(sign: sign, coeff: coeff, exp: LLVM::sub(a: 0_s64, b: q), pref: 369_s64))

# ============================================================================
# Transcendentals — all delegate to the F128 (W=128) engine surface (erf/gamma included): decode
# D64 -> F128, evaluate, round F128 -> D64. F128 covers decimal64's full ±385 range (DD did not),
# so extreme-magnitude inputs (e.g. log of a >1e308 D64) are correct instead of overflowing to inf.
# ============================================================================

### e^me via the DD engine. Crashes on a non-finite result.
### :returns: The exponential of `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D64.exp!() -> D64
  var r = me.exp_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### e^me, raw IEEE: may return ±inf (overflow) or NaN. Never crashes.
### :returns: The exponential of `me`, possibly non-finite.
routine D64.exp_unchecked() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).exp_unchecked())

### e^me - 1 (accurate near 0) via DD. Crashes on a non-finite result.
### :returns: `exp(me) - 1`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D64.expm1!() -> D64
  var r = me.expm1_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `exp(me) - 1`, raw IEEE: may return ±inf or NaN. Never crashes.
### :returns: `exp(me) - 1`, possibly non-finite.
routine D64.expm1_unchecked() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).expm1_unchecked())

