### 10^e as a DD via a two-level sqrt-split power-of-ten table (S=20 = ceil(sqrt(398))): with a=|e|,
### hi=a/S, lo=a%S, the result is HIGH[hi]*LOW[lo] (ONE DD multiply, zero division, zero binary-exp
### loop). Both signs store their powers directly (NO 1/positive division). Each table entry is a DD
### (hi,lo) pair reconstructed from its stored IEEE bit patterns (exact); non-exact/large/negative
### entries were rounded round-half-even at ~120-digit precision, far beyond DD's ~31 digits. The
### magnitude boundary matches the old binary-exp path: powers past b64's range saturate to +inf
### (10^320..10^400) or underflow to 0 (10^-340..10^-398). |e|>398 clamps to the table's inf/0 edge.
routine dd_pow10(e: S64) -> DD
  var neg = LLVM::signed_lt(a: e, b: 0_s64)
  var a = if neg then LLVM::sub(a: 0_s64, b: e) else e
  var hi_i = LLVM::signed_div(a: a, b: 20_s64)
  var lo_i = LLVM::signed_rem(a: a, b: 20_s64)
  if LLVM::signed_gt(a: hi_i, b: 20_s64)
    hi_i = 20_s64
  var hu = LLVM::reinterpret_bits[S64, U64](hi_i)
  var lu = LLVM::reinterpret_bits[S64, U64](lo_i)
  if neg
    var hin = DD(hi: B64.from_bits(bits: DD_POW10_HN_HI[hu]), lo: B64.from_bits(bits: DD_POW10_HN_LO[hu]))
    var lon = DD(hi: B64.from_bits(bits: DD_POW10_LN_HI[lu]), lo: B64.from_bits(bits: DD_POW10_LN_LO[lu]))
    return hin.mul(you: lon)
  var hip = DD(hi: B64.from_bits(bits: DD_POW10_HP_HI[hu]), lo: B64.from_bits(bits: DD_POW10_HP_LO[hu]))
  var lop = DD(hi: B64.from_bits(bits: DD_POW10_LP_HI[lu]), lo: B64.from_bits(bits: DD_POW10_LP_LO[lu]))
  return hip.mul(you: lop)

### A U64 coefficient (<=16 digits) as an exact DD. Split into the top 8 and bottom 8
### decimal digits; each half is < 10^8 < 2^53 so converts to b64 exactly, then
### reassembled as chi*10^8 + clo (DD add is error-free for these exact terms).
routine u64_coeff_to_dd(c: U64) -> DD
  var chi = LLVM::unsigned_div(a: c, b: 100000000_u64)
  var clo = LLVM::unsigned_rem(a: c, b: 100000000_u64)
  var hi = dd_of(x: LLVM::unsigned_to_float[U64, B64](chi)).mul(you: dd_pow10(e: 8_s64))
  return hi.add(you: dd_of(x: LLVM::unsigned_to_float[U64, B64](clo)))

### Turns a positive DD ~integer (< 10^18) into a U64 for a LATER decimal rounding that drops at least
### one digit: the integer part, with its last digit nudged off 0/5 when the value was inexact. Rounding
### the integer to nearest here and again in decfin rounded twice (a value just below a decimal midpoint,
### ...649|4999964, came out as ...6495000 and then rounded up to ...650).
routine dd_to_u64_sticky(u: DD) -> U64
  var r = u.floor()
  var frac = u.sub(you: r)
  var scale = dd_pow10(e: 9_s64)
  var qhi = r.div(you: scale).floor()
  var lo = r.sub(you: qhi.mul(you: scale))
  var hi_u = LLVM::float_to_unsigned[B64, U64](qhi.to_b64())
  var lo_u = LLVM::float_to_unsigned[B64, U64](lo.to_b64())
  var q = LLVM::add(a: LLVM::mul(a: hi_u, b: 1000000000_u64), b: lo_u)
  var digit = LLVM::unsigned_rem[U64](a: q, b: 10)
  if (LLVM::float_ne[B64](a: frac.hi, b: 0.0_b64) or LLVM::float_ne[B64](a: frac.lo, b: 0.0_b64)) and (digit == 0_u64 or digit == 5_u64)
    q = LLVM::add(a: q, b: 1_u64)
  return q

### Rounds a positive DD ~integer (< 10^18, comfortably within U64) to a U64, round-half-even.
### Adds 0.5 and floors; on an exact half the floor lands even-or-odd per the fractional part,
### which for a 16-17 digit decimal coefficient is well below DD's ~31-digit resolution.
routine dd_to_u64_round(u: DD) -> U64
  var r = u.add(you: dd_of(x: 0.5_b64)).floor()
  # split the integer DD into top (r/1e9) and bottom (r%1e9) halves; each < 10^9 < 2^53.
  var scale = dd_pow10(e: 9_s64)
  var qhi = r.div(you: scale).floor()
  var lo = r.sub(you: qhi.mul(you: scale))
  var hi_u = LLVM::float_to_unsigned[B64, U64](qhi.to_b64())
  var lo_u = LLVM::float_to_unsigned[B64, U64](lo.to_b64())
  return LLVM::add(a: LLVM::mul(a: hi_u, b: 1000000000_u64), b: lo_u)

### dec -> DD: D64 value as a DD (coeff exact, scaled by 10^exp). Specials return
### DD sentinels: inf as a huge value, NaN as 0/0, signed zero preserved by sign.
routine d64_to_dd(x: D64) -> DD
  var p = x.decode()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    var inf = dd_of(x: 1.0_b64).div(you: dd_of(x: 0.0_b64))
    return if p.sign then inf.neg() else inf
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return dd_of(x: 0.0_b64).div(you: dd_of(x: 0.0_b64))
  if LLVM::int_eq(a: p.coeff, b: 0_u64)
    return if p.sign then dd_of(x: 0.0_b64).neg() else dd_of(x: 0.0_b64)
  var mag = u64_coeff_to_dd(c: p.coeff).mul(you: dd_pow10(e: p.exp))
  return if p.sign then mag.neg() else mag

### bin -> dec: DD value as a D64, rounded to <=16 digits. Non-finite DD (via to_b64
### classification on the hi limb) maps to inf/NaN; zero and signed zero preserved.
routine dd_to_d64(x: DD) -> D64
  var f = x.to_b64()
  if f.is_nan()
    return D64.quiet_nan()
  if f.is_infinite()
    return D64.infinity(sign: LLVM::float_lt[B64](a: x.hi, b: 0.0_b64))
  if LLVM::float_eq[B64](a: x.hi, b: 0.0_b64)
    return d64_of_parts(p: D64Parts(sign: LLVM::float_lt[B64](a: LLVM::copysign[B64](value: 1.0_b64, sign: x.hi), b: 0.0_b64), special: 0_u64, exp: 0_s64, coeff: 0_u64))
  var sign = LLVM::float_lt[B64](a: x.hi, b: 0.0_b64)
  var ax = x.abs()
  # est. decimal exponent from log10 of the hi limb (faithful; the scale below corrects).
  var decexp = LLVM::float_to_signed[B64, S64](LLVM::floor[B64](value: LLVM::log10[B64](value: ax.hi)))
  # scale so the coefficient lands as a ~16-digit integer (15 - decexp), then round to U64.
  var q = LLVM::sub(a: 15_s64, b: decexp)
  var coeff = dd_to_u64_round(u: ax.mul(you: dd_pow10(e: q)))
  # pref = qmax (369) makes decfin64 strip ALL trailing zeros after rounding to 16 digits,
  # so a DD->decimal result is stored reduced, not padded.
  return d64_of_parts(p: decfin64(sign: sign, coeff: LLVM::zero_extend[U64, U128](coeff), exp: LLVM::sub(a: 0_s64, b: q), pref: 369_s64))

# ============================================================================
# Binary <-> decimal bridge (decimal64 <-> binary128), in integer arithmetic.
# Used BOTH for the correctly rounded D64 <-> B32/B64/B128 conversions AND (below) for every D64
# transcendental: B128's 113-bit significand and its exponent range cover decimal64's 16 digits and its
# ±398 decimal exponents, so an out-of-B64-range D64 (e.g. log(1e380) = 875.06…) converts and evaluates
# correctly. Each direction is one integer multiply by a tabled 10^e and one rounding.
# ============================================================================

### 10^e for e in [-398, 414] as a 192-bit significand M in [2^191, 2^192), rounded to nearest (exact for
### 0 <= e <= 82, where 5^e fits): 10^e ~ M * 2^(d64_pow10_bin_exp(e) - 191). Entry e + 398 is three U64
### words, the high word first.
