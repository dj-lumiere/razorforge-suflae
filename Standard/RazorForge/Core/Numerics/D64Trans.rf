### floor(e * log2(10)), exact for every e the table covers.
@inline
secret routine d64_pow10_bin_exp(e: S64) -> S64
  return (e *% 217706_s64) >> 16

### a * M for a 64-bit a and the table entry M of 10^e: the 256-bit product as four words, high first.
@inline
secret routine d64_mul_pow10(a: U64, e: S64) -> (U64, U64, U64, U64)
  var i = LLVM::reinterpret_bits[S64, U64](e +% 398_s64) *% 3_u64
  var aw = LLVM::zero_extend[U64, U128](a)
  var t2 = aw *% LLVM::zero_extend[U64, U128](D64_POW10_192[i])
  var t1 = aw *% LLVM::zero_extend[U64, U128](D64_POW10_192[i +% 1_u64])
  var t0 = aw *% LLVM::zero_extend[U64, U128](D64_POW10_192[i +% 2_u64])
  var s1 = (t0 >>> 64) +% LLVM::zero_extend[U64, U128](LLVM::int_truncate[U128, U64](t1))
  var s2 = (t1 >>> 64) +% LLVM::zero_extend[U64, U128](LLVM::int_truncate[U128, U64](t2)) +% (s1 >>> 64)
  var p3 = LLVM::int_truncate[U128, U64]((t2 >>> 64) +% (s2 >>> 64))
  return (p3, LLVM::int_truncate[U128, U64](s2), LLVM::int_truncate[U128, U64](s1), LLVM::int_truncate[U128, U64](t0))

### A decimal value as the bits of a binary format with a p-bit significand and exponents emin..emax
### (bias emax): B16 is (11, -14, 15), B32 (24, -126, 127), B64 (53, -1022, 1023), B128 (113, -16382,
### 16383). Correctly rounded in one step, with subnormal results and overflow to infinity; NaN comes back
### as the positive quiet NaN. The coefficient (< 10^16, exponent in [-398, 369], so decimal32 and decimal64
### both fit) normalized to 64 bits times the tabled 10^exp is a 256-bit product whose top bits are the
### significand. The product is exact for 0 <= exp <= 82. Elsewhere the table's error is below 2^-78 of a
### B128 ulp, and the exact value is never halfway: for exp > 82 its odd part is far wider than 113 bits,
### and for exp < 0 it is either a binary fraction of at most 54 bits (handled exactly below, since it can
### be halfway at a narrower format) or not a binary fraction at all.
routine decimal_to_binary_bits(sign: Bool, special: U64, coeff: U64, exp: S64, p: S64, emin: S64, emax: S64) -> U128
  var ebits = 65_s64 -% LLVM::reinterpret_bits[U64, S64](LLVM::leading_zeros(LLVM::reinterpret_bits[S64, U64](emax)))
  var pw = LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](p -% 1_s64))
  var sbit = if sign then LLVM::shift_left(value: 1_u128, bits: pw +% LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](ebits))) else 0_u128
  var inf = LLVM::shift_left(value: LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64]((emax << 1) +% 1_s64)), bits: pw)
  if special == 1_u64
    return sbit | inf
  if special >= 2_u64
    return inf | LLVM::shift_left(value: 1_u128, bits: pw -% 1_u128)
  if coeff == 0_u64
    return sbit
  # h: the significand's top 128 bits with the leading 1 at bit 127, rest: any lower bit set, e2: the
  # exponent of the leading bit
  var h = 0_u128
  var rest = false
  var e2 = 0_s64
  var dyadic = false
  if p < 55_s64 and exp < 0_s64 and exp >= -22_s64
    var j = 0_s64 -% exp
    var p5 = LLVM::int_truncate[U128, U64](LLVM::shift_right_unsigned(p10_u128(k: j), LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](j))))
    if LLVM::unsigned_rem(a: coeff, b: p5) == 0_u64
      # coeff / 5^j * 2^-j exactly: a binary fraction that fits 54 bits
      var v = LLVM::unsigned_div(a: coeff, b: p5)
      var vl = 63_s64 -% LLVM::reinterpret_bits[U64, S64](LLVM::leading_zeros(v))
      h = LLVM::zero_extend[U64, U128](v) << 64
      h = LLVM::shift_left(value: h, bits: LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](63_s64 -% vl)))
      e2 = vl -% j
      dyadic = true
  if not dyadic
    var lz = LLVM::leading_zeros(coeff)
    var (p3, p2, p1, p0) = d64_mul_pow10(a: LLVM::shift_left(value: coeff, bits: lz), e: exp)
    # the product is in [2^254, 2^256): top = 1 when bit 255 is set
    var top = p3 >>> 63
    h = (LLVM::zero_extend[U64, U128](p3) << 64) | LLVM::zero_extend[U64, U128](p2)
    var low = p1
    if top == 0_u64
      h = (h << 1) | LLVM::zero_extend[U64, U128](p1 >>> 63)
      low = p1 << 1
    rest = low != 0_u64 or p0 != 0_u64
    e2 = 63_s64 +% LLVM::reinterpret_bits[U64, S64](top) +% d64_pow10_bin_exp(e: exp) -% LLVM::reinterpret_bits[U64, S64](lz)
  if e2 > emax
    return sbit | inf
  # bits kept: all p for a normal result, fewer below emin (a subnormal keeps down to 2^(emin-p+1))
  var keep = p
  if e2 < emin
    keep = p -% (emin -% e2)
  var mant = 0_u128
  if keep == 0_s64
    # the value is in [2^(emin-p), 2^(emin-p+1)): above that half of the smallest subnormal rounds up to it
    if h != (1_u128 << 127) or rest
      mant = 1_u128
  elseif keep > 0_s64
    var s = LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](128_s64 -% keep))
    mant = LLVM::shift_right_unsigned(h, s)
    var half = LLVM::shift_right_unsigned(h, s -% 1_u128) & 1_u128
    var below = (h & (LLVM::shift_left(value: 1_u128, bits: s -% 1_u128) -% 1_u128)) != 0_u128 or rest
    if half != 0_u128 and (below or (mant & 1_u128) != 0_u128)
      mant = mant +% 1_u128
  # a normal result adds its exponent field under the significand's leading 1 (so a carry out of the
  # significand steps the exponent, up to infinity); a subnormal is the significand alone
  var base = 0_u128
  if e2 >= emin
    base = LLVM::shift_left(value: LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](e2 +% emax -% 1_s64)), bits: pw)
  return sbit | (base +% mant)

### dec -> bin: a D64 as a B128, correctly rounded (see decimal_to_binary_bits).
routine d64_to_b128(x: D64) -> B128
  var p = x.decode()
  return B128.from_bits(bits: decimal_to_binary_bits(sign: p.sign, special: p.special, coeff: p.coeff, exp: p.exp, p: 113_s64, emin: -16382_s64, emax: 16383_s64))

### Whether x = m * 2^lsb is exactly (2t+1)/2 * 10^-qe for qe < 0, halfway between t and t+1 at that
### scale: the odd part of m must be (2t+1) * 5^-qe (so 5^-qe < 2^128, -qe <= 55) and the powers of two
### must match. Shared by the decimal64 and decimal128 bridges.
secret routine binary_is_decimal_tie(m: U128, lsb: S64, t: U128, qe: S64) -> Bool
  var j = 0_s64 -% qe
  if j > 55_s64 or m == 0_u128
    return false
  var tz = LLVM::int_truncate[U128, S64](LLVM::trailing_zeros(m))
  if tz +% lsb != j -% 1_s64
    return false
  var modd = LLVM::shift_right_unsigned(m, LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](tz)))
  var p5 = 1_u128
  var i = 0_s64
  while i < j
    p5 = p5 *% 5_u128
    i = i +% 1_s64
  if LLVM::unsigned_rem[U128](a: modd, b: p5) != 0_u128
    return false
  return LLVM::unsigned_div[U128](a: modd, b: p5) == (t << 1) +% 1_u128

### A B128 as a decimal with `digits` digits (7 for decimal32, 16 for decimal64) and exponents emin..emax,
### correctly rounded in one step, subnormal results included; the parts come back reduced (no trailing
### zeros). zmin / imax are the binary exponents below which the value rounds to zero and from which it
### overflows (decimal32: -337 / 323, decimal64: -1325 / 1279).
### x = m * 2^(e2-112) times the tabled 10^q, q = 15 - floor(e2 * log10(2)), has a 16- or 17-digit integer
### part N, and the 305-bit product carries the fraction for the rounding. The product is exact for
### 0 <= q <= 82. For q > 82 (x below 1e-67) x * 10^q is never an integer or halfway, and the table's error
### (about 2^-137 of N's last place) cannot move the rounding. For q < 0 (x at or above 1e16) x can be
### exactly halfway, so a result within 2^-62 of halfway is settled exactly by binary_is_decimal_tie.
routine b128_to_decimal_parts(x: B128, digits: S64, emin: S64, emax: S64, zmin: S64, imax: S64) -> D64Parts
  var bits = x.to_bits()
  var sign = (bits >>> 127) != 0_u128
  var be = LLVM::int_truncate[U128, S64]((bits >>> 112) & 0x7FFF_u128)
  var frac = bits & ((1_u128 << 112) -% 1_u128)
  if be == 0x7FFF_s64
    if frac != 0_u128
      return D64Parts(sign: false, special: 2_u64, exp: 0_s64, coeff: 0_u64)
    return D64Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: 0_u64)
  if be == 0_s64 and frac == 0_u128
    return D64Parts(sign: sign, special: 0_u64, exp: 0_s64, coeff: 0_u64)
  var e2 = be -% 16383_s64
  if e2 >= imax
    return D64Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: 0_u64)
  if e2 < zmin
    return D64Parts(sign: sign, special: 0_u64, exp: emin, coeff: 0_u64)
  var m = frac | (1_u128 << 112)
  var q = 15_s64 -% ((e2 *% 78913_s64) >> 18)
  var (a3, a2, a1, a0) = d64_mul_pow10(a: LLVM::int_truncate[U128, U64](m), e: q)
  var (b3, b2, b1, b0) = d64_mul_pow10(a: LLVM::int_truncate[U128, U64](m >>> 64), e: q)
  # the 305-bit product A + B * 2^64 as five words p4..p0 (p0 = a0)
  var s1 = LLVM::zero_extend[U64, U128](a1) +% LLVM::zero_extend[U64, U128](b0)
  var s2 = LLVM::zero_extend[U64, U128](a2) +% LLVM::zero_extend[U64, U128](b1) +% (s1 >>> 64)
  var s3 = LLVM::zero_extend[U64, U128](a3) +% LLVM::zero_extend[U64, U128](b2) +% (s2 >>> 64)
  var p4 = b3 +% LLVM::int_truncate[U128, U64](s3 >>> 64)
  var p3 = LLVM::int_truncate[U128, U64](s3)
  var p2 = LLVM::int_truncate[U128, U64](s2)
  var p1 = LLVM::int_truncate[U128, U64](s1)
  # the integer part N sits above bit sh = 303 - e2 - floor(q * log2(10)), which is 250..254
  var sh = 303_s64 -% e2 -% d64_pow10_bin_exp(e: q)
  var k = LLVM::int_truncate[U64, U32](LLVM::reinterpret_bits[S64, U64](sh -% 192_s64))
  var n = LLVM::int_truncate[U128, U64](((LLVM::zero_extend[U64, U128](p4) << 64) | LLVM::zero_extend[U64, U128](p3)) >>> k)
  # the top 128 fraction bits (the fraction times 2^128) and whether any bit below them is set
  var fs = 64_u32 -% k
  var fhi = (((LLVM::zero_extend[U64, U128](p3) << 64) | LLVM::zero_extend[U64, U128](p2)) << fs) | LLVM::zero_extend[U64, U128](p1 >>> (64_u32 -% fs))
  var frest = (p1 << fs) != 0_u64 or a0 != 0_u64
  var exact = q >= 0_s64 and q <= 82_s64
  var half = 1_u128 << 127
  var near = 1_u128 << 66
  # digits dropped from N: the excess over `digits`, or more when the result is subnormal
  var drop = 16_s64 -% digits
  if n >= 10000000000000000_u64
    drop = drop +% 1_s64
  if drop -% q < emin
    drop = emin +% q
  var c = n
  var up = false
  if drop == 0_s64
    var off = if fhi >= half then fhi -% half else half -% fhi
    if exact
      up = fhi > half or (fhi == half and (frest or (n & 1_u64) != 0_u64))
    elseif q < 0_s64 and off < near and binary_is_decimal_tie(m: m, lsb: e2 -% 112_s64, t: LLVM::zero_extend[U64, U128](n), qe: q)
      up = (n & 1_u64) != 0_u64
    else
      up = fhi >= half
  elseif drop > 19_s64
    c = 0_u64
  else
    var p10 = 10_u64
    if drop == 1_s64
      c = LLVM::unsigned_div(a: n, b: 10_u64)
    else
      p10 = p10_u64(k: drop)
      c = LLVM::unsigned_div(a: n, b: p10)
    var r = n -% c *% p10
    var h = LLVM::unsigned_div(a: p10, b: 2_u64)
    if exact
      up = r > h or (r == h and (fhi != 0_u128 or frest or (c & 1_u64) != 0_u64))
    elseif q -% drop < 0_s64 and ((r == h and fhi < near) or (r == h -% 1_u64 and fhi > (0_u128 -% near))) and binary_is_decimal_tie(m: m, lsb: e2 -% 112_s64, t: LLVM::zero_extend[U64, U128](c), qe: q -% drop)
      up = (c & 1_u64) != 0_u64
    else
      up = r >= h
  var ex = drop -% q
  if up
    c = c +% 1_u64
    if c == p10_u64(k: digits)
      c = p10_u64(k: digits -% 1_s64)
      ex = ex +% 1_s64
  if c == 0_u64
    return D64Parts(sign: sign, special: 0_u64, exp: emin, coeff: 0_u64)
  # stored reduced: strip every trailing zero (up to the largest exponent)
  loop
    if ex >= emax
      break
    var c10 = LLVM::unsigned_div(a: c, b: 10_u64)
    if c10 *% 10_u64 != c
      break
    c = c10
    ex = ex +% 1_s64
  # above the largest exponent: pad the coefficient while it has room, else overflow
  var pad_limit = p10_u64(k: digits -% 1_s64)
  while ex > emax and c < pad_limit
    c = c *% 10_u64
    ex = ex -% 1_s64
  if ex > emax
    return D64Parts(sign: sign, special: 1_u64, exp: 0_s64, coeff: 0_u64)
  return D64Parts(sign: sign, special: 0_u64, exp: ex, coeff: c)

### bin -> dec: a B128 as a D64, correctly rounded to <= 16 digits (see b128_to_decimal_parts).
routine b128_to_d64(x: B128) -> D64
  return d64_of_parts(p: b128_to_decimal_parts(x: x, digits: 16_s64, emin: -398_s64, emax: 369_s64, zmin: -1325_s64, imax: 1279_s64))

### bin -> dec: a B128 as a D32, correctly rounded to <= 7 digits (see b128_to_decimal_parts).
routine b128_to_d32(x: B128) -> D32
  var p = b128_to_decimal_parts(x: x, digits: 7_s64, emin: -101_s64, emax: 90_s64, zmin: -337_s64, imax: 323_s64)
  return d32_of_parts(p: D32Parts(sign: p.sign, special: p.special, exp: p.exp, coeff: p.coeff))

# ============================================================================
# Transcendentals — all delegate to the B128 (W=128) engine surface (erf/gamma included): decode
# D64 -> B128, evaluate, round B128 -> D64. B128 covers decimal64's full ±385 range (DD did not),
# so extreme-magnitude inputs (e.g. log of a >1e308 D64) are correct instead of overflowing to inf.
# ============================================================================

# Fast paths. Each computes a B128 close to the true value from correctly rounded B128 (or B64 CORE-MATH)
# pieces, with a bound 2^-k on its relative error, and keeps it only when the whole band rounds to one D64
# (d64_round_within), which is then the correct rounding. Otherwise the slower engine path decides.

### The unbiased binary exponent of a finite nonzero B128 (|x| in [2^e, 2^(e+1))), -20000 for zero.
@inline
secret routine b128_exponent(x: B128) -> S64
  var be = LLVM::int_truncate[U128, S64]((x.to_bits() >>> 112) & 0x7FFF_u128)
  return if be == 0_s64 then -20000_s64 else be -% 16383_s64

### The unbiased binary exponent of a finite nonzero B64, -2000 for zero.
@inline
secret routine b64_exponent(x: B64) -> S64
  var be = LLVM::reinterpret_bits[U64, S64]((x.to_bits() >>> 52) & 0x7FF_u64)
  return if be == 0_s64 then -2000_s64 else be -% 1023_s64

### log(x) * scale for a positive finite D64 x (the correctly rounded B128 log times a constant). Each of
### the roundings of x, the log, the constant and the product adds 2^-113 relative, and x's rounding moves
### the log by 2^-113 absolute, 2^-113 / |log x| relative, which grows as x nears 1.
secret routine d64_log_scaled(x: D64, scale: B128) -> (Bool, D64)
  var p = x.decode()
  if p.special != 0_u64 or p.sign or p.coeff == 0_u64
    return (false, x)
  var l = d64_to_b128(x: x).log_unchecked()
  if l.is_zero()
    return (true, D64.from_components(sign: false, coeff: 0_u64, exp: 0_s64))
  var k = 113_s64 +% b128_exponent(x: l)
  if k > 110_s64
    k = 110_s64
  k = k -% 1_s64
  if k < 60_s64
    return (false, x)
  return d64_round_within(r: l *! scale, k: k)

### |x|^y for a finite positive D64 x and a finite nonzero D64 y as exp(y log x) in B128. With t = y log x,
### x's rounding moves log x by 2^-113 (t by |y| 2^-113), the log, y's rounding and the product each move t
### by |t| 2^-113, and exp adds 2^-113, so the result is within (3|t| + |y| + 1) 2^-113 relative. |t| from
### 2^11 on (overflow or underflow territory) is left to the engine.
secret routine d64_pow_fast(x: D64, y: D64) -> (Bool, D64)
  var px = x.decode()
  var py = y.decode()
  if px.special != 0_u64 or py.special != 0_u64 or px.coeff == 0_u64 or py.coeff == 0_u64
    return (false, x)
  var yb = d64_to_b128(x: y)
  var t = yb *! d64_to_b128(x: x).log_unchecked()
  var et = b128_exponent(x: t)
  if et > 10_s64
    return (false, x)
  var m = et +% 3_s64
  var ey = b128_exponent(x: yb) +% 1_s64
  if ey > m
    m = ey
  if m < 0_s64
    m = 0_s64
  var k = 110_s64 -% m
  if k < 60_s64
    return (false, x)
  return d64_round_within(r: t.exp_unchecked(), k: k)

### sinh (which = 0), cosh (1) or tanh (2) of a finite D64 from the correctly rounded B128 exp / expm1:
### sinh = (e + e / (e + 1)) / 2 with e = expm1|x|, cosh = (e + 1/e) / 2 with e = exp|x|, tanh = e / (e + 2)
### with e = expm1 2|x|. At most five roundings of 2^-113, and x's rounding seen through the function
### (|x| coth|x| for sinh, |x| tanh|x| for cosh, below 1 for tanh): within (6 + |x|) 2^-113 relative.
### |x| from 1024 on (overflow, or tanh at ±1) is left to the engine.
secret routine d64_hyperbolic(x: D64, which: U64) -> (Bool, D64)
  var p = x.decode()
  if p.special != 0_u64
    return (false, x)
  var a = d64_to_b128(x: x).abs()
  var ea = b128_exponent(x: a)
  if ea > 9_s64
    return (false, x)
  var one = 1.0_b128
  var r = a
  if which == 0_u64
    var em = a.expm1_unchecked()
    r = (em +! em /! (em +! one)) *! 0.5_b128
  elseif which == 1_u64
    var e = a.exp_unchecked()
    r = (e +! one /! e) *! 0.5_b128
  else
    var em2 = (a *! 2.0_b128).expm1_unchecked()
    r = em2 /! (em2 +! 2.0_b128)
  if p.sign and which != 1_u64
    r = r.neg()
  var m = ea +% 1_s64
  if m < 3_s64
    m = 3_s64
  return d64_round_within(r: r, k: 110_s64 -% m)

### 2/sqrt(pi) as a B64 (for the first-order correction terms below).
secret preset D64_ERF_TWO_OVER_SQRTPI: B64 = 0x1.20dd750429b6dp+0

### erf of a finite D64 from the B64 CORE-MATH kernels. x (rounded to B128) is split z = zh + zl with zh a
### B64, and erf(z) = erf(zh) + zl * 2/sqrt(pi) * exp(-zh^2) + O(zl^2): the correction's own error and the
### dropped term stay below 2^-99 relative. The fast double-double kernel is within 2^-68 relative, the
### accurate one within about 2^-106 (so 2^-95 is allowed with the correction). From |x| = 6 on erfc is
### below 2.2e-17, so erf rounds to ±1. Between the kernels' limit 5.92 and 6 the engine decides.
secret routine d64_erf_fast(x: D64) -> (Bool, D64)
  var p = x.decode()
  if p.special != 0_u64 or p.coeff == 0_u64
    return (false, x)
  var z = d64_to_b128(x: x).abs()
  var zh = B64(from: z)
  if zh >= 6.0
    # erfc(6) = 2.2e-17 is under the 5e-17 between 1 and the midpoint below it
    return (true, D64.from_components(sign: p.sign, coeff: 1_u64, exp: 0_s64))
  if zh > 0x1.7afb48dc96626p+2
    # past the kernels' range, but erfc is still above 5e-17 up to about 5.93
    return (false, x)
  if zh < 0x1p-61
    # erf(z) = 2z/sqrt(pi) (1 - z^2/3 + ...), z^2 below 2^-122
    var rt = z *! 1.128379167095512573896158903121545_b128
    if p.sign
      rt = rt.neg()
    return d64_round_within(r: rt, k: 108_s64)
  var zl = B64(from: z -! B128(from: zh))
  var corr = B128(from: zl *! D64_ERF_TWO_OVER_SQRTPI *! (-(zh *! zh)).exp_unchecked())
  var f = b64_erf_fast(z: zh)
  var r = (B128(from: f.hi) +! B128(from: f.lo)) +! corr
  if p.sign
    r = r.neg()
  var (ok, v) = d64_round_within(r: r, k: 67_s64)
  if ok
    return (true, v)
  var a = b64_erf_accurate(z: zh)
  var r2 = (B128(from: a.hi) +! B128(from: a.lo)) +! corr
  if p.sign
    r2 = r2.neg()
  return d64_round_within(r: r2, k: 95_s64)

### erfc of a finite D64 (-5.8 < x < 26, |x| above 2^-50) from the B64 CORE-MATH fast kernel, which returns
### h + l and an absolute error bound. x (rounded to B128) is split xh + xl as in d64_erf_fast, with the
### correction -xl * 2/sqrt(pi) * exp(-xh^2), whose error stays below 2^-85 relative up to x = 26.
secret routine d64_erfc_fast(x: D64) -> (Bool, D64)
  var p = x.decode()
  if p.special != 0_u64 or p.coeff == 0_u64
    return (false, x)
  var xb = d64_to_b128(x: x)
  var xh = B64(from: xb)
  if not (xh > -5.8 and xh < 26.0) or xh.abs() < 0x1p-50
    return (false, x)
  var xl = B64(from: xb -! B128(from: xh))
  var corr = B128(from: -(xl *! D64_ERF_TWO_OVER_SQRTPI *! (-(xh *! xh)).exp_unchecked()))
  var f = b64_erfc_fast(x: xh)
  var r = (B128(from: f.item0) +! B128(from: f.item1)) +! corr
  # relative bound: err / |h| below 2^(eerr + 1 - eh), plus the correction's 2^-85
  var rel = b64_exponent(x: f.item2) +% 1_s64 -% b64_exponent(x: f.item0)
  if rel < -85_s64
    rel = -85_s64
  var k = 0_s64 -% (rel +% 1_s64)
  if k < 60_s64
    return (false, x)
  return d64_round_within(r: r, k: k)

### e^me via B128. Crashes on a non-finite result.
### :returns: The exponential of `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D64.exp!() -> D64
  var r = me.exp_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### e^me, raw IEEE: may return ±inf (overflow) or NaN. Never crashes.
### :returns: The exponential of `me`, possibly non-finite.
routine D64.exp_unchecked() -> D64
  return b128_to_d64(x: d64_to_b128(x: me).exp_unchecked())

### e^me - 1 (accurate near 0) via DD. Crashes on a non-finite result.
### :returns: `exp(me) - 1`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D64.expm1!() -> D64
  var r = me.expm1_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `exp(me) - 1`, raw IEEE: may return ±inf or NaN. Never crashes.
### :returns: `exp(me) - 1`, possibly non-finite.
routine D64.expm1_unchecked() -> D64
  return b128_to_d64(x: d64_to_b128(x: me).expm1_unchecked())

### 2^me via DD. Crashes on a non-finite result.
### :returns: Two raised to the power `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D64.exp2!() -> D64
  var r = me.exp2_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### 2^me, raw IEEE: may return ±inf or NaN. Never crashes.
### :returns: Two raised to the power `me`, possibly non-finite.
routine D64.exp2_unchecked() -> D64
  return b128_to_d64(x: d64_to_b128(x: me).exp2_unchecked())

### 10^me via DD. Crashes on a non-finite result.
### :returns: Ten raised to the power `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D64.exp10!() -> D64
  var r = me.exp10_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### 10^me, raw IEEE: may return ±inf or NaN. Never crashes.
### :returns: Ten raised to the power `me`, possibly non-finite.
routine D64.exp10_unchecked() -> D64
  return b128_to_d64(x: d64_to_b128(x: me).exp10_unchecked())

### Natural log ln(me) via DD. Crashes on a non-finite result (e.g. me<=0).
### :returns: The natural logarithm of `me`.
### :throws: {NumericDomainError} on NaN (me<0); {NumericOverflowError} on ±inf (me=0).
routine D64.log!() -> D64
  var r = me.log_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### ln(me), raw IEEE: NaN for me<0, -inf for me=0. Never crashes.
### :returns: The natural logarithm of `me`, possibly non-finite.
routine D64.log_unchecked() -> D64
  return b128_to_d64(x: d64_to_b128(x: me).log_unchecked())

### ln(1+me) (accurate near 0) via DD. Crashes on a non-finite result (me<=-1).
### :returns: `ln(1 + me)`.
### :throws: {NumericDomainError} on NaN (me<-1); {NumericOverflowError} on ±inf (me=-1).
routine D64.log1p!() -> D64
  var r = me.log1p_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `ln(1 + me)`, raw IEEE: NaN for me<-1, -inf for me=-1. Never crashes.
### :returns: `ln(1 + me)`, possibly non-finite.
routine D64.log1p_unchecked() -> D64
  return b128_to_d64(x: d64_to_b128(x: me).log1p_unchecked_n(n: 15_s64))

### Base-2 log log2(me) via DD. Crashes on a non-finite result (me<=0).
### :returns: The base-2 logarithm of `me`.
### :throws: {NumericDomainError} on NaN (me<0); {NumericOverflowError} on ±inf (me=0).
routine D64.log2!() -> D64
  var r = me.log2_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### log2(me), raw IEEE: NaN for me<0, -inf for me=0. Never crashes.
### :returns: The base-2 logarithm of `me`, possibly non-finite.
routine D64.log2_unchecked() -> D64
  var (ok, r) = d64_log_scaled(x: me, scale: 1.442695040888963407359924681001892_b128)
  if ok
    return r
  return b128_to_d64(x: d64_to_b128(x: me).log2_unchecked_n(n: 16_s64))

### Base-10 log log10(me) via DD. Crashes on a non-finite result (me<=0).
### :returns: The base-10 logarithm of `me`.
### :throws: {NumericDomainError} on NaN (me<0); {NumericOverflowError} on ±inf (me=0).
routine D64.log10!() -> D64
  var r = me.log10_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### log10(me), raw IEEE: NaN for me<0, -inf for me=0. Never crashes.
### :returns: The base-10 logarithm of `me`, possibly non-finite.
routine D64.log10_unchecked() -> D64
  var (ok, r) = d64_log_scaled(x: me, scale: 0.4342944819032518276511289189166051_b128)
  if ok
    return r
  return b128_to_d64(x: d64_to_b128(x: me).log10_unchecked_n(n: 16_s64))

### Square root sqrt(me) via DD. Crashes on a non-finite result (me<0).
### :returns: The square root of `me`.
### :throws: {NumericDomainError} on NaN (me<0); {NumericOverflowError} on ±inf.
routine D64.sqrt!() -> D64
  var r = me.sqrt_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### sqrt(me), raw IEEE: NaN for me<0. Never crashes.
### :returns: The square root of `me`, possibly NaN.
routine D64.sqrt_unchecked() -> D64
  # sqrt(neg) = NaN (IEEE), sqrt(+/-0) = +0: guard the strictly-negative case explicitly, then
  # delegate the magnitude sqrt to the B128 (W=192) engine — which carries D64's full exponent
  # range, unlike a DoubleDouble path (B64 exponent) that would overflow large D64 operands.
  if me.is_negative() and not me.is_zero()
    return D64.quiet_nan()
  return b128_to_d64(x: d64_to_b128(x: me).sqrt_unchecked())

### Cube root cbrt(me) via DD (defined for all reals). Never crashes.
### :returns: The cube root of `me`.
routine D64.cbrt() -> D64
  return b128_to_d64(x: d64_to_b128(x: me).cbrt())

### me^you (general power) via DD, raw IEEE: may return ±inf or NaN. Never crashes.
### :param you: The exponent.
### :returns: `me` raised to the power `you`, possibly non-finite.
routine D64.pow_unchecked(you: D64) -> D64
  # DD.pow computes exp(you * ln|me|) — the general POSITIVE-base power. A negative base is
  # only real for an integer exponent: restore the magnitude via |me|^you and set the sign
  # from the exponent's parity (odd -> negative); a non-integer exponent is a domain NaN.
  var (ok, fr) = d64_pow_fast(x: me.abs(), y: you)
  var r = fr
  if not ok
    r = b128_to_d64(x: d64_to_b128(x: me.abs()).pow_unchecked(you: d64_to_b128(x: you)))
  if not (me.is_negative() and not me.is_zero())
    return r
  var yint = you.trunc()
  if you.cmp(you: yint) != SAME
    return D64.quiet_nan()
  # parity: yint - 2*trunc(yint/2) is 0 (even) or ±1 (odd)
  var parity = yint - D64(from: 2_s64) * (yint / D64(from: 2_s64)).trunc()
  if parity.is_zero()
    return r
  return r.neg()

### sqrt(x^2 + y^2) (without spurious overflow) via DD. Crashes if non-finite.
### :param x: The first leg.
### :param y: The second leg.
### :returns: The Euclidean length `hypot(x, y)`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine hypot!(x: D64, y: D64) -> D64
  var r = hypot_unchecked(x: x, y: y)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `hypot(x, y)`, raw IEEE: may return +inf. Never crashes.
### :param x: The first leg.
### :param y: The second leg.
### :returns: The Euclidean length, possibly +inf.
routine hypot_unchecked(x: D64, y: D64) -> D64
  return b128_to_d64(x: hypot_unchecked(x: d64_to_b128(x: x), y: d64_to_b128(x: y)))

### sqrt(x^2 + y^2 + z^2) (without spurious overflow) via B128. Crashes if non-finite.
### :param x: The first leg.
### :param y: The second leg.
### :param z: The third leg.
### :returns: The 3D Euclidean length.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine hypot!(x: D64, y: D64, z: D64) -> D64
  var r = hypot_unchecked(x: x, y: y, z: z)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `hypot(x, y, z)`, raw IEEE: may return +inf. Never crashes. Summed once at B128 width.
### :param x: The first leg.
### :param y: The second leg.
### :param z: The third leg.
### :returns: The 3D Euclidean length, possibly +inf.
routine hypot_unchecked(x: D64, y: D64, z: D64) -> D64
  return b128_to_d64(x: hypot_unchecked(x: d64_to_b128(x: x), y: d64_to_b128(x: y), z: d64_to_b128(x: z)))

### Fused multiply-add me*b + c, single rounding, via DD. Crashes if non-finite.
### :param b: The multiplier.
### :param c: The addend.
### :returns: `me * b + c` rounded once.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D64.fma!(b: D64, c: D64) -> D64
  var r = me.fma_unchecked(b: b, c: c)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me * b + c` (single rounding), raw IEEE: may return ±inf or NaN. Never crashes.
### :param b: The multiplier.
### :param c: The addend.
### :returns: `me * b + c`, possibly non-finite.
routine D64.fma_unchecked(b: D64, c: D64) -> D64
  return b128_to_d64(x: d64_to_b128(x: me).fma_unchecked(b: d64_to_b128(x: b), c: d64_to_b128(x: c)))

### Arcsine asin(me) via DD. Crashes if non-finite (|me|>1).
### :returns: The arcsine of `me` in radians.
### :throws: {NumericDomainError} on NaN (|me|>1); {NumericOverflowError} on ±inf.
routine D64.asin!() -> D64
  var r = me.asin_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### asin(me), raw IEEE: NaN for |me|>1. Never crashes.
### :returns: The arcsine of `me`, possibly NaN.
routine D64.asin_unchecked() -> D64
  # DD.asin = atan(me/sqrt(1-me^2)); for |me|>1 that sqrt clamps to 0 (wrong ±pi/2 instead of
  # NaN), so guard the domain here to preserve IEEE (asin NaN for |me|>1).
  if me.abs().cmp(you: D64(from: 1_s64)) == ME_LARGE
    return D64.quiet_nan()
  return b128_to_d64(x: d64_to_b128(x: me).asin_unchecked())

### Arccosine acos(me) via DD. Crashes if non-finite (|me|>1).
### :returns: The arccosine of `me` in radians.
### :throws: {NumericDomainError} on NaN (|me|>1); {NumericOverflowError} on ±inf.
routine D64.acos!() -> D64
  var r = me.acos_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### acos(me), raw IEEE: NaN for |me|>1. Never crashes.
### :returns: The arccosine of `me`, possibly NaN.
routine D64.acos_unchecked() -> D64
  # acos = pi/2 - asin; same |me|>1 domain guard (DD.sqrt clamp would otherwise mask the NaN).
  if me.abs().cmp(you: D64(from: 1_s64)) == ME_LARGE
    return D64.quiet_nan()
  return b128_to_d64(x: d64_to_b128(x: me).acos_unchecked())

### Arctangent atan(me) via DD (defined for all reals). Never crashes.
### :returns: The arctangent of `me` in radians.
routine D64.atan() -> D64
  return b128_to_d64(x: d64_to_b128(x: me).atan())

### Two-argument arctangent atan2(y, x), quadrant-aware, via DD. Never crashes.
### :param y: The y-coordinate.
### :param x: The x-coordinate.
### :returns: The angle of (x, y) in radians, in (-pi, pi].
routine atan2(y: D64, x: D64) -> D64
  return b128_to_d64(x: atan2(y: d64_to_b128(x: y), x: d64_to_b128(x: x)))

### Hyperbolic sine sinh(me) via DD. Crashes if non-finite (overflow for large |me|).
### :returns: The hyperbolic sine of `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D64.sinh!() -> D64
  var r = me.sinh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### sinh(me), raw IEEE: ±inf on overflow. Never crashes.
### :returns: The hyperbolic sine of `me`, possibly ±inf.
routine D64.sinh_unchecked() -> D64
  var (ok, r) = d64_hyperbolic(x: me, which: 0_u64)
  if ok
    return r
  return b128_to_d64(x: d64_to_b128(x: me).sinh_unchecked_n(n: 13_s64))

### Hyperbolic cosine cosh(me) via DD. Crashes if non-finite (overflow for large |me|).
### :returns: The hyperbolic cosine of `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D64.cosh!() -> D64
  var r = me.cosh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### cosh(me), raw IEEE: +inf on overflow. Never crashes.
### :returns: The hyperbolic cosine of `me`, possibly +inf.
routine D64.cosh_unchecked() -> D64
  var (ok, r) = d64_hyperbolic(x: me, which: 1_u64)
  if ok
    return r
  return b128_to_d64(x: d64_to_b128(x: me).cosh_unchecked_n(n: 13_s64))

### Hyperbolic tangent tanh(me) via DD (defined for all reals). Never crashes.
### :returns: The hyperbolic tangent of `me`.
routine D64.tanh() -> D64
  var (ok, r) = d64_hyperbolic(x: me, which: 2_u64)
  if ok
    return r
  return b128_to_d64(x: d64_to_b128(x: me).tanh_n(n: 13_s64))

### Inverse hyperbolic sine asinh(me) via DD (defined for all reals). Never crashes.
### :returns: The inverse hyperbolic sine of `me`.
routine D64.asinh() -> D64
  return b128_to_d64(x: d64_to_b128(x: me).asinh())

### Inverse hyperbolic cosine acosh(me) via DD. Crashes if non-finite (me<1).
### :returns: The inverse hyperbolic cosine of `me`.
### :throws: {NumericDomainError} on NaN (me<1); {NumericOverflowError} on ±inf.
routine D64.acosh!() -> D64
  var r = me.acosh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### acosh(me), raw IEEE: NaN for me<1. Never crashes.
### :returns: The inverse hyperbolic cosine of `me`, possibly NaN.
routine D64.acosh_unchecked() -> D64
  # DD.acosh = log(me + sqrt(me^2-1)); for me<1 that sqrt clamps to 0 (finite garbage instead
  # of NaN), so guard the domain here to preserve IEEE (acosh NaN for me<1).
  if me.cmp(you: D64(from: 1_s64)) == ME_SMALL
    return D64.quiet_nan()
  return b128_to_d64(x: d64_to_b128(x: me).acosh_unchecked())

### Inverse hyperbolic tangent atanh(me) via DD. Crashes if non-finite (|me|>=1).
### :returns: The inverse hyperbolic tangent of `me`.
### :throws: {NumericDomainError} on NaN (|me|>1); {NumericOverflowError} on ±inf (|me|=1).
routine D64.atanh!() -> D64
  var r = me.atanh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### atanh(me), raw IEEE: NaN for |me|>1, ±inf for |me|=1. Never crashes.
### :returns: The inverse hyperbolic tangent of `me`, possibly non-finite.
routine D64.atanh_unchecked() -> D64
  return b128_to_d64(x: d64_to_b128(x: me).atanh_unchecked_n(n: 14_s64))

### Error function erf(me) via DD. Never crashes (saturates to ±1).
### :returns: The error function of `me`.
routine D64.erf() -> D64
  var (ok, r) = d64_erf_fast(x: me)
  if ok
    return r
  return b128_to_d64(x: d64_to_b128(x: me).erf_fast(levels_mid: 44_s64, levels_tail: 76_s64))

### Complementary error function erfc(me) = 1 - erf(me) via DD. Never crashes.
### :returns: The complementary error function of `me`.
routine D64.erfc() -> D64
  var (ok, r) = d64_erfc_fast(x: me)
  if ok
    return r
  return b128_to_d64(x: d64_to_b128(x: me).erfc_fast(levels_mid: 48_s64, levels_tail: 90_s64))

### Gamma function tgamma(me) via DD. Crashes if non-finite (poles at 0 and neg ints).
### :returns: The gamma function of `me`.
### :throws: {NumericDomainError} on NaN (neg int poles); {NumericOverflowError} on ±inf.
routine D64.tgamma!() -> D64
  var r = me.tgamma_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### tgamma(me), raw IEEE: ±inf at poles, NaN for neg-int poles, overflow. Never crashes.
### :returns: The gamma function of `me`, possibly non-finite.
routine D64.tgamma_unchecked() -> D64
  return b128_to_d64(x: d64_to_b128(x: me).tgamma_unchecked())

### Log-gamma lgamma(me) = ln(|gamma(me)|) via DD. Never crashes (+inf at poles).
### :returns: The natural log of the absolute gamma of `me`.
routine D64.lgamma() -> D64
  return b128_to_d64(x: d64_to_b128(x: me).lgamma())

# ============================================================================
# libm manipulation / classification — decimal-native on D64Parts (coeff U64).
# ============================================================================

### IEEE 754 signBit: true when the sign bit is set (includes -0 and -NaN). Never crashes.
### :returns: Whether `me`'s sign bit is set.
routine D64.signbit() -> Bool
  return me.decode().sign

### True if me is negative (sign bit set; includes -0 and -NaN).
routine D64.is_negative() -> Bool
  return me.decode().sign

### True if me is strictly positive (not signed, not zero).
routine D64.is_positive() -> Bool
  var p = me.decode()
  return not p.sign and LLVM::int_eq(a: p.special, b: 0_u64) and LLVM::int_ne(a: p.coeff, b: 0_u64)

### True if me is a finite, nonzero subnormal: quantum exponent at the minimum (-398)
### with a coefficient below 10^15 (fewer than the full 16 significant digits).
routine D64.is_subnormal() -> Bool
  var p = me.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64) or LLVM::int_eq(a: p.coeff, b: 0_u64)
    return false
  return LLVM::int_eq(a: p.exp, b: -398_s64) and LLVM::unsigned_lt(a: p.coeff, b: 1000000000000000_u64)

### Splits into integer and fractional parts (C modf); both carry me's sign.
routine D64.modf() -> (D64, D64)
  if me.is_nan()
    return (me, me)
  var p = me.decode()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return (me, d64_of_parts(p: D64Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: 0_u64)))
  var ip = me.trunc()
  return (ip, me - ip)

### True if me is finite and nonzero (a normal or subnormal number, not zero/inf/NaN).
### :returns: Whether `me` is a finite nonzero value.
routine D64.is_normal() -> Bool
  var p = me.decode()
  return LLVM::int_eq(a: p.special, b: 0_u64) and LLVM::int_ne(a: p.coeff, b: 0_u64)

### True if me is ±0 (finite with a zero coefficient).
### :returns: Whether `me` is zero.
routine D64.is_zero() -> Bool
  var p = me.decode()
  return LLVM::int_eq(a: p.special, b: 0_u64) and LLVM::int_eq(a: p.coeff, b: 0_u64)

### IEEE 754 fpClassify: bucket me into signaling/quiet NaN, infinite, zero, subnormal, normal.
### :returns: The floating-point class of `me`.
routine D64.fpclassify() -> FpClass
  var p = me.decode()
  if LLVM::int_eq(a: p.special, b: 3_u64)
    return SIGNALING_NAN
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return NAN
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return INFINITE
  if LLVM::int_eq(a: p.coeff, b: 0_u64)
    return ZERO
  if me.is_subnormal()
    return SUBNORMAL
  return NORMAL

### Absolute value |me| (clears the sign bit, cohort preserved). Never crashes.
### :returns: The magnitude of `me`.
routine D64.abs() -> D64
  var p = me.decode()
  return d64_of_parts(p: D64Parts(sign: false, special: p.special, exp: p.exp, coeff: p.coeff))

### IEEE 754 totalOrder for decimals (see `D128.total_order`). Orders signed zeros, cohorts,
### and NaNs into one total ranking; never crashes.
### :param you: The value to compare against.
### :returns: Whether `me` precedes or equals `you` in the total order.
routine D64.total_order(you: D64) -> Bool
  var pa = me.decode()
  var pb = you.decode()
  if LLVM::unsigned_ge(a: pa.special, b: 2_u64) or LLVM::unsigned_ge(a: pb.special, b: 2_u64)
    return decimal_order_band(sign: pa.sign, special: pa.special) <= decimal_order_band(sign: pb.sign, special: pb.special)
  var c = me.cmp(you: you)
  if c != SAME
    return c == ME_SMALL
  if pa.sign != pb.sign
    return pa.sign
  if pa.sign
    return LLVM::signed_ge(a: pa.exp, b: pb.exp)
  return LLVM::signed_le(a: pa.exp, b: pb.exp)

### IEEE 754 totalOrderMag for decimals: `total_order` on the magnitudes.
### :param you: The value whose magnitude to compare against.
### :returns: Whether `|me|` precedes or equals `|you|` in the total order.
routine D64.total_order_mag(you: D64) -> Bool
  return me.abs().total_order(you: you.abs())

### Unary negation -me (flips the sign bit, cohort preserved). Never crashes.
### :returns: `me` with its sign flipped.
routine D64.neg() -> D64
  var p = me.decode()
  return d64_of_parts(p: D64Parts(sign: not p.sign, special: p.special, exp: p.exp, coeff: p.coeff))

### IEEE 754 copySign: me's magnitude with you's sign bit. Never crashes.
### :param you: The value supplying the sign.
### :returns: `|me|` carrying `you`'s sign.
routine D64.copysign(you: D64) -> D64
  var p = me.decode()
  return d64_of_parts(p: D64Parts(sign: you.decode().sign, special: p.special, exp: p.exp, coeff: p.coeff))

### Returns -1, 0, or +1 indicating the sign of `me`; NaN propagates; ±0 -> +0.
routine D64.signum() -> D64
  if me.is_nan()
    return D64.quiet_nan()
  if me.is_zero()
    return d64_of_parts(p: D64Parts(sign: false, special: 0_u64, exp: 0_s64, coeff: 0_u64))
  return if me.decode().sign then D64(from: -1_s64) else D64(from: 1_s64)

### Throws when `me` is non-finite (inf or NaN).
@crash_only
routine D64.finite!() -> D64
  if not me.is_finite()
    if me.is_nan()
      throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")
  return me

### C99 fmod: me - trunc(me/you)*you (truncated-division remainder).
routine D64.fmod(you: D64) -> D64
  if me.is_nan() or you.is_nan()
    return D64.quiet_nan()
  if me.is_infinite() or you.is_zero()
    return D64.quiet_nan()
  if you.is_infinite()
    return me
  var n = me.truediv_unchecked(you: you).trunc()
  return me.sub_unchecked(you: you.mul_unchecked(you: n))

### C99 fmax: the larger of me and you, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The larger operand, or the non-NaN one.
routine D64.fmax(you: D64) -> D64
  if me.is_nan()
    return you
  if you.is_nan()
    return me
  if (me - you).decode().sign
    return you
  return me

### C99 fmin: the smaller of me and you, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The smaller operand, or the non-NaN one.
routine D64.fmin(you: D64) -> D64
  if me.is_nan()
    return you
  if you.is_nan()
    return me
  if (me - you).decode().sign
    return me
  return you

### C99 fdim: the positive difference max(me - you, 0). NaN propagates. Never crashes.
### :param you: The value to subtract.
### :returns: `me - you` if positive, else +0.
routine D64.fdim(you: D64) -> D64
  if me.is_nan() or you.is_nan()
    return D64.quiet_nan()
  var d = me - you
  if d.decode().sign
    return d64_of_parts(p: D64Parts(sign: false, special: 0_u64, exp: 0_s64, coeff: 0_u64))
  return d

### IEEE 754 scaleB: `me * 10^n`. Checked: crashes if a finite `me` overflows to ±infinity.
### :param n: The power-of-ten exponent to apply.
### :returns: `me` scaled by `10^n`.
routine D64.scaleb!(n: S64) -> D64
  var r = me.scaleb_unchecked(n: n)
  if r.is_finite() or not me.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me * 10^n` with raw propagation (overflow -> ±infinity, underflow -> 0).
### :param n: The power-of-ten exponent to apply.
### :returns: `me` scaled by `10^n`.
routine D64.scaleb_unchecked(n: S64) -> D64
  var p = me.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64) or LLVM::int_eq(a: p.coeff, b: 0_u64)
    return me
  var ne = LLVM::add(a: p.exp, b: n)
  if LLVM::signed_gt(a: ne, b: 369_s64)
    return D64.infinity(sign: p.sign)
  if LLVM::signed_lt(a: ne, b: -398_s64)
    return d64_of_parts(p: D64Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: 0_u64))
  return d64_of_parts(p: D64Parts(sign: p.sign, special: 0_u64, exp: ne, coeff: p.coeff))

# ============================================================================
# IEEE 754 Tier 2 — exponent extraction, selection, rounding
# (decimal next_up/next_down deferred — cohort/ULP stepping not yet implemented)
# ============================================================================

### IEEE 754 logb: the base-10 exponent of `me` as a decimal integer (logb(0)=-inf,
### logb(±inf)=+inf, logb(NaN)=NaN). Propagating; never crashes.
### :returns: The radix-10 exponent of `me`.
routine D64.logb() -> D64
  var p = me.decode()
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return D64.quiet_nan()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return D64.infinity(sign: false)
  if LLVM::int_eq(a: p.coeff, b: 0_u64)
    return D64.infinity(sign: true)
  return D64(from: LLVM::add(a: p.exp, b: LLVM::sub(a: digits10_u64(c: p.coeff), b: 1_s64)))

### IEEE 754-2008 minNum: the smaller operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, ignoring NaN.
routine D64.min_num(you: D64) -> D64
  return me.fmin(you: you)

### IEEE 754-2008 maxNum: the larger operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, ignoring NaN.
routine D64.max_num(you: D64) -> D64
  return me.fmax(you: you)

### IEEE 754-2019 minimum: the smaller operand, propagating NaN, ordering -0 below +0.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, NaN if either is NaN.
routine D64.minimum(you: D64) -> D64
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  var c = me.cmp(you: you)
  if c == ME_SMALL
    return me
  if c == ME_LARGE
    return you
  if me.is_zero()
    return if me.signbit() then me else you
  return me

### IEEE 754-2019 maximum: the larger operand, propagating NaN, ordering +0 above -0.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, NaN if either is NaN.
routine D64.maximum(you: D64) -> D64
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  var c = me.cmp(you: you)
  if c == ME_LARGE
    return me
  if c == ME_SMALL
    return you
  if me.is_zero()
    return if me.signbit() then you else me
  return me

### IEEE 754 roundToIntegralTiesToAway: rounds to nearest integer, halves away from zero
### (alias of `round`). Never crashes.
### :returns: `me` rounded to an integral value with ties away from zero.
routine D64.round_ties_away() -> D64
  return me.round()

# ============================================================================
# IEEE 754 Tier 3 — decimal-specific (quantize, same_quantum, remainder)
# ============================================================================

### IEEE 754 sameQuantum: `true` when `me` and `other` share an exponent, or are both infinite,
### or both NaN. Never crashes.
### :param you: The value whose quantum to compare against.
### :returns: Whether the two share a quantum.
routine D64.same_quantum(you: D64) -> Bool
  var pa = me.decode()
  var pb = you.decode()
  if LLVM::unsigned_ge(a: pa.special, b: 2_u64) or LLVM::unsigned_ge(a: pb.special, b: 2_u64)
    return LLVM::unsigned_ge(a: pa.special, b: 2_u64) and LLVM::unsigned_ge(a: pb.special, b: 2_u64)
  if LLVM::int_eq(a: pa.special, b: 1_u64) or LLVM::int_eq(a: pb.special, b: 1_u64)
    return LLVM::int_eq(a: pa.special, b: 1_u64) and LLVM::int_eq(a: pb.special, b: 1_u64)
  return LLVM::int_eq(a: pa.exp, b: pb.exp)

### IEEE 754 quantize: `me`'s value re-expressed with `other`'s exponent (half-even when dropping
### digits). NaN if the result needs more than 16 significand digits, or for incompatible specials.
### :param you: The value supplying the target exponent.
### :returns: `me` quantized to `other`'s exponent, or NaN if not representable.
routine D64.quantize(you: D64) -> D64
  var pa = me.decode()
  var pb = you.decode()
  if LLVM::unsigned_ge(a: pa.special, b: 2_u64) or LLVM::unsigned_ge(a: pb.special, b: 2_u64)
    return D64.quiet_nan()
  var ainf = LLVM::int_eq(a: pa.special, b: 1_u64)
  var binf = LLVM::int_eq(a: pb.special, b: 1_u64)
  if ainf or binf
    if ainf and binf
      return me
    return D64.quiet_nan()
  var target = pb.exp
  if LLVM::int_eq(a: pa.exp, b: target)
    return me
  if LLVM::signed_gt(a: pa.exp, b: target)
    var shift = LLVM::sub(a: pa.exp, b: target)
    if LLVM::int_ne(a: pa.coeff, b: 0_u64) and LLVM::signed_gt(a: LLVM::add(a: digits10_u64(c: pa.coeff), b: shift), b: 16_s64)
      return D64.quiet_nan()
    var scaled = LLVM::mul(a: LLVM::zero_extend[U64, U256](pa.coeff), b: pow10b(k: shift))
    return d64_of_parts(p: D64Parts(sign: pa.sign, special: 0_u64, exp: target, coeff: LLVM::int_truncate[U256, U64](scaled)))
  var drop = LLVM::sub(a: target, b: pa.exp)
  if LLVM::signed_gt(a: drop, b: 16_s64)
    return d64_of_parts(p: D64Parts(sign: pa.sign, special: 0_u64, exp: target, coeff: 0_u64))
  var cw = LLVM::zero_extend[U64, U256](pa.coeff)
  var divp = pow10b(k: drop)
  var q = div_pow10b(x: cw, k: drop)
  var r = LLVM::sub(a: cw, b: LLVM::mul(a: q, b: divp))
  var twice = LLVM::mul(a: r, b: LLVM::zero_extend[U64, U256](2_u64))
  if LLVM::unsigned_gt(a: twice, b: divp)
    q = LLVM::add(a: q, b: LLVM::zero_extend[U64, U256](1_u64))
  elseif LLVM::int_eq(a: twice, b: divp) and LLVM::int_ne(a: LLVM::bit_and(a: q, b: LLVM::zero_extend[U64, U256](1_u64)), b: LLVM::zero_extend[U64, U256](0_u64))
    q = LLVM::add(a: q, b: LLVM::zero_extend[U64, U256](1_u64))
  return d64_of_parts(p: D64Parts(sign: pa.sign, special: 0_u64, exp: target, coeff: LLVM::int_truncate[U256, U64](q)))

### IEEE 754 remainder: `me - other * n` with `n` the nearest integer to `me / other` (ties even).
### NaN if `me` infinite or `other` zero; `me` if `other` infinite. Never crashes.
### :param you: The divisor.
### :returns: The IEEE remainder of `me / other`.
routine D64.remainder(you: D64) -> D64
  if me.is_nan() or you.is_nan()
    return D64.quiet_nan()
  if me.is_infinite() or you.is_zero()
    return D64.quiet_nan()
  if you.is_infinite()
    return me
  var n = me.truediv_unchecked(you: you).rint()
  return me.sub_unchecked(you: you.mul_unchecked(you: n))

### IEEE 754 normalize (the `reduce` operation): trailing zeros stripped to the simplest cohort
### member (`3.00` -> `3`, `1.50` -> `1.5`, `100` -> `1E+2`, `0.00` -> `0`). Specials pass through.
### Never crashes. Arithmetic stays cohort-preserving (IEEE); this is the opt-in to shortest form.
### :returns: `me` normalized to its simplest cohort member.
routine D64.normalize() -> D64
  var p = me.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64)
    return me
  if LLVM::int_eq(a: p.coeff, b: 0_u64)
    return d64_of_parts(p: D64Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: 0_u64))
  return d64_of_parts(p: decfin64(sign: p.sign, coeff: LLVM::zero_extend[U64, U128](p.coeff), exp: p.exp, pref: 369_s64))

### Rounds to integral. mode: 0 trunc, 1 floor, 2 ceil, 3 round (half away), 4 rint (half even).
routine d64_round_int(x: D64, mode: S64) -> D64
  var p = x.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64)
    return x
  if LLVM::int_eq(a: p.coeff, b: 0_u64)
    return x
  if LLVM::signed_ge(a: p.exp, b: 0_s64)
    return x
  var ndrop = LLVM::sub(a: 0_s64, b: p.exp)
  var cw = LLVM::zero_extend[U64, U256](p.coeff)
  var q = LLVM::zero_extend[U64, U256](0_u64)
  var rnz = true
  var half = false
  var gthalf = false
  if LLVM::signed_le(a: ndrop, b: 16_s64)
    var divp = pow10b(k: ndrop)
    q = div_pow10b(x: cw, k: ndrop)
    var r = LLVM::sub(a: cw, b: LLVM::mul(a: q, b: divp))
    rnz = LLVM::int_ne[U256](a: r, b: 0)
    var twice = LLVM::mul(a: r, b: LLVM::zero_extend[U64, U256](2_u64))
    half = LLVM::int_eq(a: twice, b: divp)
    gthalf = LLVM::unsigned_gt(a: twice, b: divp)
  var inc = false
  if LLVM::int_eq(a: mode, b: 1_s64)
    inc = p.sign and rnz
  elseif LLVM::int_eq(a: mode, b: 2_s64)
    inc = (not p.sign) and rnz
  elseif LLVM::int_eq(a: mode, b: 3_s64)
    inc = gthalf or half
  elseif LLVM::int_eq(a: mode, b: 4_s64)
    if gthalf
      inc = true
    elseif half
      inc = LLVM::int_ne(a: LLVM::bit_and(a: q, b: LLVM::zero_extend[U64, U256](1_u64)), b: LLVM::zero_extend[U64, U256](0_u64))
  var qq = q
  if inc
    qq = LLVM::add(a: q, b: LLVM::zero_extend[U64, U256](1_u64))
  return d64_of_parts(p: D64Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: LLVM::int_truncate[U256, U64](qq)))

### Truncates toward zero to an integral value. Never crashes.
### :returns: `me` with its fractional part discarded.
routine D64.trunc() -> D64
  return d64_round_int(x: me, mode: 0_s64)

### Rounds down (toward -inf) to an integral value. Never crashes.
### :returns: The largest integer <= `me`.
routine D64.floor() -> D64
  return d64_round_int(x: me, mode: 1_s64)

### Rounds up (toward +inf) to an integral value. Never crashes.
### :returns: The smallest integer >= `me`.
routine D64.ceil() -> D64
  return d64_round_int(x: me, mode: 2_s64)

### Rounds to nearest integer, ties away from zero. Never crashes.
### :returns: `me` rounded with ties away.
routine D64.round() -> D64
  return d64_round_int(x: me, mode: 3_s64)

### IEEE 754 roundToIntegral, ties to even. Never crashes.
### :returns: `me` rounded with ties to even.
routine D64.rint() -> D64
  return d64_round_int(x: me, mode: 4_s64)

### Fractional part me - trunc(me) (carries me's sign). NaN/inf -> NaN/±0. Never crashes.
### :returns: The signed fractional part of `me`.
routine D64.frac() -> D64
  if me.is_nan()
    return me
  var p = me.decode()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return d64_of_parts(p: D64Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: 0_u64))
  return me - me.trunc()
