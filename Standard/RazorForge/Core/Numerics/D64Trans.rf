  throw NumericOverflowError(description: "overflow: out of range")

### log10(me), raw IEEE: NaN for me<0, -inf for me=0. Never crashes.
### :returns: The base-10 logarithm of `me`, possibly non-finite.
routine D64.log10_unchecked() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).log10_unchecked_n(n: 9_s64))

### Square root sqrt(me) via F128. Crashes on a non-finite result (me<0).
### :returns: The square root of `me`.
### :throws: {NumericDomainError} on NaN (me<0); {NumericOverflowError} on ±inf.
routine D64.sqrt!() -> D64
  var r = me.sqrt_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### sqrt(me), raw IEEE: NaN for me<0. Never crashes.
### :returns: The square root of `me`, possibly NaN.
routine D64.sqrt_unchecked() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).sqrt_unchecked())

### Cube root cbrt(me) via F128 (defined for all reals). Never crashes.
### :returns: The cube root of `me`.
routine D64.cbrt() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).cbrt())

### me^you (general power) via F128, raw IEEE: may return ±inf or NaN. Never crashes.
### :param you: The exponent.
### :returns: `me` raised to the power `you`, possibly non-finite.
routine D64.pow_unchecked(you: D64) -> D64
  # D64 needs ~54 bits; run the general exp(you*ln|me|) core at F128 width (113-bit, ~59 guard
  # bits) with reduced series degrees rather than octuple. Correctness vs the octuple result is
  # checked across a (base, exp) grid by the pow self-diff fixture.
  return f128_to_d64(x: d64_to_f128(x: me).pow_unchecked_p(you: d64_to_f128(x: you), logn: 12_s64, expn: 12_s64, fast: true))

### sqrt(me^2 + you^2) (without spurious overflow) via F128. Crashes if non-finite.
### :param you: The second leg.
### :returns: The Euclidean length `hypot(me, you)`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D64.hypot!(you: D64) -> D64
  var r = me.hypot_unchecked(you: you)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `hypot(me, you)`, raw IEEE: may return +inf. Never crashes.
### :param you: The second leg.
### :returns: The Euclidean length, possibly +inf.
routine D64.hypot_unchecked(you: D64) -> D64
  return f128_to_d64(x: d64_to_f128(x: me).hypot_unchecked(you: d64_to_f128(x: you)))

### Fused multiply-add me*b + c, single rounding, via F128. Crashes if non-finite.
### :param b: The multiplier.
### :param c: The addend.
### :returns: `me * b + c` rounded once.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D64.fma!(b: D64, c: D64) -> D64
  var r = me.fma_unchecked(b: b, c: c)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me * b + c` (single rounding), raw IEEE: may return ±inf or NaN. Never crashes.
### :param b: The multiplier.
### :param c: The addend.
### :returns: `me * b + c`, possibly non-finite.
routine D64.fma_unchecked(b: D64, c: D64) -> D64
  return f128_to_d64(x: d64_to_f128(x: me).fma_unchecked(b: d64_to_f128(x: b), c: d64_to_f128(x: c)))

### Sine sin(me) (radians) via F128. Never crashes (NaN for non-finite input).
### :returns: The sine of `me`.
routine D64.sin() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).sin_n(n: 6_s64))

### Cosine cos(me) (radians) via F128. Never crashes (NaN for non-finite input).
### :returns: The cosine of `me`.
routine D64.cos() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).cos_n(n: 8_s64))

### Tangent tan(me) (radians) via F128. Never crashes (NaN for non-finite input).
### :returns: The tangent of `me`.
routine D64.tan() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).tan_n(n: 10_s64))

### Arcsine asin(me) via F128. Crashes if non-finite (|me|>1).
### :returns: The arcsine of `me` in radians.
### :throws: {NumericDomainError} on NaN (|me|>1); {NumericOverflowError} on ±inf.
routine D64.asin!() -> D64
  var r = me.asin_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### asin(me), raw IEEE: NaN for |me|>1. Never crashes.
### :returns: The arcsine of `me`, possibly NaN.
routine D64.asin_unchecked() -> D64
  # Already F128 width; reduce the atan2 Horner degree + half-angle depth to D64's ~54 bits.
  return f128_to_d64(x: d64_to_f128(x: me).asin_fast(deg: 12_s64, depth: 2_s64))

### Arccosine acos(me) via F128. Crashes if non-finite (|me|>1).
### :returns: The arccosine of `me` in radians.
### :throws: {NumericDomainError} on NaN (|me|>1); {NumericOverflowError} on ±inf.
routine D64.acos!() -> D64
  var r = me.acos_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### acos(me), raw IEEE: NaN for |me|>1. Never crashes.
### :returns: The arccosine of `me`, possibly NaN.
routine D64.acos_unchecked() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).acos_fast(deg: 12_s64, depth: 2_s64))

### Arctangent atan(me) via F128 (defined for all reals). Never crashes.
### :returns: The arctangent of `me` in radians.
routine D64.atan() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).atan_fast(deg: 12_s64, depth: 2_s64))

### Two-argument arctangent atan2(me, x), quadrant-aware, via F128. Never crashes.
### :param x: The x-coordinate (me is the y-coordinate).
### :returns: The angle of (x, me) in radians, in (-pi, pi].
routine D64.atan2(x: D64) -> D64
  return f128_to_d64(x: d64_to_f128(x: me).atan2_fast(you: d64_to_f128(x: x), deg: 12_s64, depth: 2_s64))

### Hyperbolic sine sinh(me) via F128. Crashes if non-finite (overflow for large |me|).
### :returns: The hyperbolic sine of `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D64.sinh!() -> D64
  var r = me.sinh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### sinh(me), raw IEEE: ±inf on overflow. Never crashes.
### :returns: The hyperbolic sine of `me`, possibly ±inf.
routine D64.sinh_unchecked() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).sinh_unchecked_n(n: 9_s64))

