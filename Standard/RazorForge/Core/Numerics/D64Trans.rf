  throw NumericOverflowError(description: "overflow: out of range")

### cosh(me), raw IEEE: +inf on overflow. Never crashes.
### :returns: The hyperbolic cosine of `me`, possibly +inf.
routine D64.cosh_unchecked() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).cosh_unchecked())

### Hyperbolic tangent tanh(me) via DD (defined for all reals). Never crashes.
### :returns: The hyperbolic tangent of `me`.
routine D64.tanh() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).tanh())

### Inverse hyperbolic sine asinh(me) via DD (defined for all reals). Never crashes.
### :returns: The inverse hyperbolic sine of `me`.
routine D64.asinh() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).asinh())

### Inverse hyperbolic cosine acosh(me) via DD. Crashes if non-finite (me<1).
### :returns: The inverse hyperbolic cosine of `me`.
### :throws: {NumericDomainError} on NaN (me<1); {NumericOverflowError} on ±inf.
routine D64.acosh!() -> D64
  var r = me.acosh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### acosh(me), raw IEEE: NaN for me<1. Never crashes.
### :returns: The inverse hyperbolic cosine of `me`, possibly NaN.
routine D64.acosh_unchecked() -> D64
  # DD.acosh = log(me + sqrt(me^2-1)); for me<1 that sqrt clamps to 0 (finite garbage instead
  # of NaN), so guard the domain here to preserve IEEE (acosh NaN for me<1).
  if me.cmp(you: D64(from: 1_s64)) is ME_SMALL
    return D64.quiet_nan()
  return f128_to_d64(x: d64_to_f128(x: me).acosh_unchecked())

### Inverse hyperbolic tangent atanh(me) via DD. Crashes if non-finite (|me|>=1).
### :returns: The inverse hyperbolic tangent of `me`.
### :throws: {NumericDomainError} on NaN (|me|>1); {NumericOverflowError} on ±inf (|me|=1).
routine D64.atanh!() -> D64
  var r = me.atanh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### atanh(me), raw IEEE: NaN for |me|>1, ±inf for |me|=1. Never crashes.
### :returns: The inverse hyperbolic tangent of `me`, possibly non-finite.
routine D64.atanh_unchecked() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).atanh_unchecked())

### Error function erf(me) via DD. Never crashes (saturates to ±1).
### :returns: The error function of `me`.
routine D64.erf() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).erf())

### Complementary error function erfc(me) = 1 - erf(me) via DD. Never crashes.
### :returns: The complementary error function of `me`.
routine D64.erfc() -> D64
