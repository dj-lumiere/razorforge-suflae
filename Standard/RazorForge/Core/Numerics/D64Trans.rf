  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### 2^me, raw IEEE: may return ±inf or NaN. Never crashes.
### :returns: Two raised to the power `me`, possibly non-finite.
routine D64.exp2_unchecked() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).exp2_unchecked())

### 10^me via F128. Crashes on a non-finite result.
### :returns: Ten raised to the power `me`.
### :throws: {NumericDomainError} when the result is NaN; {NumericOverflowError} on ±inf.
routine D64.exp10!() -> D64
  var r = me.exp10_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### 10^me, raw IEEE: may return ±inf or NaN. Never crashes.
### :returns: Ten raised to the power `me`, possibly non-finite.
routine D64.exp10_unchecked() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).exp10_unchecked())

### Natural log ln(me) via F128. Crashes on a non-finite result (e.g. me<=0).
### :returns: The natural logarithm of `me`.
### :throws: {NumericDomainError} on NaN (me<0); {NumericOverflowError} on ±inf (me=0).
routine D64.log!() -> D64
  var r = me.log_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### ln(me), raw IEEE: NaN for me<0, -inf for me=0. Never crashes.
### :returns: The natural logarithm of `me`, possibly non-finite.
routine D64.log_unchecked() -> D64
  # PROTOTYPE: D64 carries ~16 digits (~54 bits), so size the log's atanh-series term count to 54
  # bits rather than F128's full 128 — roughly half the series terms. Correctness gated by
  # tcheck_d64_transcendentals.
  return f128_to_d64(x: d64_to_f128(x: me).log_unchecked_n(n: 9_s64))

### ln(1+me) (accurate near 0) via F128. Crashes on a non-finite result (me<=-1).
### :returns: `ln(1 + me)`.
### :throws: {NumericDomainError} on NaN (me<-1); {NumericOverflowError} on ±inf (me=-1).
routine D64.log1p!() -> D64
  var r = me.log1p_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `ln(1 + me)`, raw IEEE: NaN for me<-1, -inf for me=-1. Never crashes.
### :returns: `ln(1 + me)`, possibly non-finite.
routine D64.log1p_unchecked() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).log1p_unchecked_n(n: 9_s64))

### Base-2 log log2(me) via F128. Crashes on a non-finite result (me<=0).
### :returns: The base-2 logarithm of `me`.
### :throws: {NumericDomainError} on NaN (me<0); {NumericOverflowError} on ±inf (me=0).
routine D64.log2!() -> D64
  var r = me.log2_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### log2(me), raw IEEE: NaN for me<0, -inf for me=0. Never crashes.
### :returns: The base-2 logarithm of `me`, possibly non-finite.
routine D64.log2_unchecked() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).log2_unchecked_n(n: 9_s64))

### Base-10 log log10(me) via F128. Crashes on a non-finite result (me<=0).
### :returns: The base-10 logarithm of `me`.
### :throws: {NumericDomainError} on NaN (me<0); {NumericOverflowError} on ±inf (me=0).
routine D64.log10!() -> D64
  var r = me.log10_unchecked()
  if r.is_finite()
