routine D64.asinh() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).asinh())

### Inverse hyperbolic cosine acosh(me) via F128. Crashes if non-finite (me<1).
### :returns: The inverse hyperbolic cosine of `me`.
### :throws: {NumericDomainError} on NaN (me<1); {NumericOverflowError} on ±inf.
routine D64.acosh!() -> D64
  var r = me.acosh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### acosh(me), raw IEEE: NaN for me<1. Never crashes.
### :returns: The inverse hyperbolic cosine of `me`, possibly NaN.
routine D64.acosh_unchecked() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).acosh_unchecked())

### Inverse hyperbolic tangent atanh(me) via F128. Crashes if non-finite (|me|>=1).
### :returns: The inverse hyperbolic tangent of `me`.
### :throws: {NumericDomainError} on NaN (|me|>1); {NumericOverflowError} on ±inf (|me|=1).
routine D64.atanh!() -> D64
  var r = me.atanh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### atanh(me), raw IEEE: NaN for |me|>1, ±inf for |me|=1. Never crashes.
### :returns: The inverse hyperbolic tangent of `me`, possibly non-finite.
routine D64.atanh_unchecked() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).atanh_unchecked_n(n: 9_s64))

### Error function erf(me) via F128. Never crashes (saturates to ±1).
### :returns: The error function of `me`.
routine D64.erf() -> D64
  # D64 needs ~54 bits; run the continued fraction at F128 width (113-bit) with reduced levels
  # rather than octuple. lm=50/lt=64 carry ~20% margin over the validated floors (lm=42, lt<<62)
  # at the hardest point z~3.1. Checked vs the octuple result by the erf levels-sweep fixture.
  return f128_to_d64(x: d64_to_f128(x: me).erf_fast(levels_mid: 50_s64, levels_tail: 64_s64))

### Complementary error function erfc(me) = 1 - erf(me) via F128. Never crashes.
### :returns: The complementary error function of `me`.
routine D64.erfc() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).erfc_fast(levels_mid: 50_s64, levels_tail: 64_s64))

### Gamma function tgamma(me) via F128. Crashes if non-finite (poles at 0 and neg ints).
### :returns: The gamma function of `me`.
### :throws: {NumericDomainError} on NaN (neg int poles); {NumericOverflowError} on ±inf.
routine D64.tgamma!() -> D64
  var r = me.tgamma_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### tgamma(me), raw IEEE: ±inf at poles, NaN for neg-int poles, overflow. Never crashes.
### :returns: The gamma function of `me`, possibly non-finite.
routine D64.tgamma_unchecked() -> D64
  # D64 needs ~54 bits; octuple-width Stirling (gamma_coef is octuple-only, not width-portable)
  # but with reduced Stirling/log/sin/exp degrees. Checked vs the full-degree octuple result by
  # the gamma self-diff fixture.
  return f128_to_d64(x: d64_to_f128(x: me).tgamma_unchecked_p(sdeg: 12_s64, logn: 10_s64, sinn: 9_s64, expn: 10_s64))

### Log-gamma lgamma(me) = ln(|gamma(me)|) via F128. Never crashes (+inf at poles).
### :returns: The natural log of the absolute gamma of `me`.
routine D64.lgamma() -> D64
  return f128_to_d64(x: d64_to_f128(x: me).lgamma_p(sdeg: 12_s64, logn: 10_s64, sinn: 9_s64))

# ============================================================================
# libm manipulation / classification — decimal-native on D64Parts (coeff U64).
# ============================================================================

### IEEE 754 signBit: true when the sign bit is set (includes -0 and -NaN). Never crashes.
### :returns: Whether `me`'s sign bit is set.
routine D64.signbit() -> Bool
  return me.decode().sign

### True if me is negative (sign bit set; includes -0 and -NaN).
routine D64.is_negative() -> Bool
  return me.decode().sign

### True if me is strictly positive (not signed, not zero).
routine D64.is_positive() -> Bool
  var p = me.decode()
  return not p.sign and int_eq[U64](a: p.special, b: 0_u64) and int_ne[U64](a: p.coeff, b: 0_u64)

### True if me is a finite, nonzero subnormal: quantum exponent at the minimum (-398)
### with a coefficient below 10^15 (fewer than the full 16 significant digits).
routine D64.is_subnormal() -> Bool
  var p = me.decode()
  if int_ne[U64](a: p.special, b: 0_u64) or int_eq[U64](a: p.coeff, b: 0_u64)
    return false
  return int_eq[S64](a: p.exp, b: -398_s64) and unsigned_lt[U64](a: p.coeff, b: 1000000000000000_u64)

### Splits into integer and fractional parts (C modf); both carry me's sign.
routine D64.modf() -> (D64, D64)
  if me.is_nan()
    return (me, me)
  var p = me.decode()
  if int_eq[U64](a: p.special, b: 1_u64)
    return (me, d64_of_parts(p: D64Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: 0_u64)))
  var ip = me.trunc()
  return (ip, me - ip)

### True if me is finite and nonzero (a normal or subnormal number, not zero/inf/NaN).
### :returns: Whether `me` is a finite nonzero value.
routine D64.is_normal() -> Bool
  var p = me.decode()
  return int_eq[U64](a: p.special, b: 0_u64) and int_ne[U64](a: p.coeff, b: 0_u64)

### True if me is ±0 (finite with a zero coefficient).
### :returns: Whether `me` is zero.
routine D64.is_zero() -> Bool
  var p = me.decode()
  return int_eq[U64](a: p.special, b: 0_u64) and int_eq[U64](a: p.coeff, b: 0_u64)

### IEEE 754 fpClassify: bucket me into signaling/quiet NaN, infinite, zero, subnormal, normal.
### :returns: The floating-point class of `me`.
routine D64.fpclassify() -> FpClass
  var p = me.decode()
  if int_eq[U64](a: p.special, b: 3_u64)
    return SIGNALING_NAN
  if unsigned_ge[U64](a: p.special, b: 2_u64)
    return NAN
  if int_eq[U64](a: p.special, b: 1_u64)
    return INFINITE
  if int_eq[U64](a: p.coeff, b: 0_u64)
    return ZERO
  if me.is_subnormal()
    return SUBNORMAL
  return NORMAL

### Absolute value |me| (clears the sign bit, cohort preserved). Never crashes.
### :returns: The magnitude of `me`.
routine D64.abs() -> D64
  var p = me.decode()
  return d64_of_parts(p: D64Parts(sign: false, special: p.special, exp: p.exp, coeff: p.coeff))

### IEEE 754 totalOrder for decimals (see `D128.total_order`). Orders signed zeros, cohorts,
### and NaNs into one total ranking; never crashes.
### :param you: The value to compare against.
### :returns: Whether `me` precedes or equals `you` in the total order.
routine D64.total_order(you: D64) -> Bool
  var pa = me.decode()
  var pb = you.decode()
  if unsigned_ge[U64](a: pa.special, b: 2_u64) or unsigned_ge[U64](a: pb.special, b: 2_u64)
    return decimal_order_band(sign: pa.sign, special: pa.special) <= decimal_order_band(sign: pb.sign, special: pb.special)
  var c = me.$cmp(you: you)
  if c isnot SAME
    return c is ME_SMALL
  if pa.sign != pb.sign
    return pa.sign
  if pa.sign
    return signed_ge[S64](a: pa.exp, b: pb.exp)
  return signed_le[S64](a: pa.exp, b: pb.exp)

### IEEE 754 totalOrderMag for decimals: `total_order` on the magnitudes.
### :param you: The value whose magnitude to compare against.
### :returns: Whether `|me|` precedes or equals `|you|` in the total order.
routine D64.total_order_mag(you: D64) -> Bool
  return me.abs().total_order(you: you.abs())

### Unary negation -me (flips the sign bit, cohort preserved). Never crashes.
### :returns: `me` with its sign flipped.
routine D64.$neg() -> D64
  var p = me.decode()
  return d64_of_parts(p: D64Parts(sign: not p.sign, special: p.special, exp: p.exp, coeff: p.coeff))

### IEEE 754 copySign: me's magnitude with you's sign bit. Never crashes.
### :param you: The value supplying the sign.
### :returns: `|me|` carrying `you`'s sign.
routine D64.copysign(you: D64) -> D64
  var p = me.decode()
  return d64_of_parts(p: D64Parts(sign: you.decode().sign, special: p.special, exp: p.exp, coeff: p.coeff))

### Returns -1, 0, or +1 indicating the sign of `me`; NaN propagates; ±0 -> +0.
routine D64.signum() -> D64
  if me.is_nan()
    return D64.quiet_nan()
  if me.is_zero()
    return d64_of_parts(p: D64Parts(sign: false, special: 0_u64, exp: 0_s64, coeff: 0_u64))
  return if me.decode().sign then D64(from: -1_s64) else D64(from: 1_s64)

### Throws when `me` is non-finite (inf or NaN).
@crash_only
routine D64.finite!() -> D64
  if not me.is_finite()
    if me.is_nan()
      throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")
  return me

### C99 fmod: me - trunc(me/you)*you (truncated-division remainder).
routine D64.fmod(you: D64) -> D64
  if me.is_nan() or you.is_nan()
    return D64.quiet_nan()
  if me.is_infinite() or you.is_zero()
    return D64.quiet_nan()
  if you.is_infinite()
    return me
  var n = me.$truediv_unchecked(you: you).trunc()
  return me.$sub_unchecked(you: you.$mul_unchecked(you: n))

### C99 fmax: the larger of me and you, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The larger operand, or the non-NaN one.
routine D64.fmax(you: D64) -> D64
  if me.is_nan()
    return you
  if you.is_nan()
    return me
  if (me - you).decode().sign
    return you
  return me

### C99 fmin: the smaller of me and you, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The smaller operand, or the non-NaN one.
routine D64.fmin(you: D64) -> D64
  if me.is_nan()
    return you
  if you.is_nan()
    return me
  if (me - you).decode().sign
    return me
  return you

### C99 fdim: the positive difference max(me - you, 0). NaN propagates. Never crashes.
### :param you: The value to subtract.
### :returns: `me - you` if positive, else +0.
routine D64.fdim(you: D64) -> D64
  if me.is_nan() or you.is_nan()
    return D64.quiet_nan()
  var d = me - you
  if d.decode().sign
    return d64_of_parts(p: D64Parts(sign: false, special: 0_u64, exp: 0_s64, coeff: 0_u64))
  return d

### IEEE 754 scaleB: `me * 10^n`. Checked: crashes if a finite `me` overflows to ±infinity.
### :param n: The power-of-ten exponent to apply.
### :returns: `me` scaled by `10^n`.
routine D64.scaleb!(n: S64) -> D64
  var r = me.scaleb_unchecked(n: n)
  if r.is_finite() or not me.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me * 10^n` with raw propagation (overflow -> ±infinity, underflow -> 0).
### :param n: The power-of-ten exponent to apply.
### :returns: `me` scaled by `10^n`.
routine D64.scaleb_unchecked(n: S64) -> D64
  var p = me.decode()
  if int_ne[U64](a: p.special, b: 0_u64) or int_eq[U64](a: p.coeff, b: 0_u64)
    return me
  var ne = add[S64](a: p.exp, b: n)
  if signed_gt[S64](a: ne, b: 369_s64)
    return D64.infinity(sign: p.sign)
  if signed_lt[S64](a: ne, b: -398_s64)
    return d64_of_parts(p: D64Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: 0_u64))
  return d64_of_parts(p: D64Parts(sign: p.sign, special: 0_u64, exp: ne, coeff: p.coeff))

# ============================================================================
# IEEE 754 Tier 2 — exponent extraction, selection, rounding
# (decimal next_up/next_down deferred — cohort/ULP stepping not yet implemented)
# ============================================================================

### IEEE 754 logb: the base-10 exponent of `me` as a decimal integer (logb(0)=-inf,
### logb(±inf)=+inf, logb(NaN)=NaN). Propagating; never crashes.
### :returns: The radix-10 exponent of `me`.
routine D64.logb() -> D64
  var p = me.decode()
  if unsigned_ge[U64](a: p.special, b: 2_u64)
    return D64.quiet_nan()
  if int_eq[U64](a: p.special, b: 1_u64)
    return D64.infinity(sign: false)
  if int_eq[U64](a: p.coeff, b: 0_u64)
    return D64.infinity(sign: true)
  return D64(from: add[S64](a: p.exp, b: sub[S64](a: digits10_u64(c: p.coeff), b: 1_s64)))

### IEEE 754-2008 minNum: the smaller operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, ignoring NaN.
routine D64.min_num(you: D64) -> D64
  return me.fmin(you: you)

### IEEE 754-2008 maxNum: the larger operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, ignoring NaN.
routine D64.max_num(you: D64) -> D64
  return me.fmax(you: you)

### IEEE 754-2019 minimum: the smaller operand, propagating NaN, ordering -0 below +0.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, NaN if either is NaN.
routine D64.minimum(you: D64) -> D64
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  var c = me.$cmp(you: you)
  if c is ME_SMALL
    return me
  if c is ME_LARGE
    return you
  if me.is_zero()
    return if me.signbit() then me else you
  return me

### IEEE 754-2019 maximum: the larger operand, propagating NaN, ordering +0 above -0.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, NaN if either is NaN.
routine D64.maximum(you: D64) -> D64
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  var c = me.$cmp(you: you)
  if c is ME_LARGE
    return me
  if c is ME_SMALL
    return you
  if me.is_zero()
    return if me.signbit() then you else me
  return me

### IEEE 754 roundToIntegralTiesToAway: rounds to nearest integer, halves away from zero
### (alias of `round`). Never crashes.
### :returns: `me` rounded to an integral value with ties away from zero.
routine D64.round_ties_away() -> D64
  return me.round()

# ============================================================================
# IEEE 754 Tier 3 — decimal-specific (quantize, same_quantum, remainder)
# ============================================================================

### IEEE 754 sameQuantum: `true` when `me` and `other` share an exponent, or are both infinite,
### or both NaN. Never crashes.
### :param other: The value whose quantum to compare against.
### :returns: Whether the two share a quantum.
routine D64.same_quantum(other: D64) -> Bool
  var pa = me.decode()
  var pb = other.decode()
  if unsigned_ge[U64](a: pa.special, b: 2_u64) or unsigned_ge[U64](a: pb.special, b: 2_u64)
    return unsigned_ge[U64](a: pa.special, b: 2_u64) and unsigned_ge[U64](a: pb.special, b: 2_u64)
  if int_eq[U64](a: pa.special, b: 1_u64) or int_eq[U64](a: pb.special, b: 1_u64)
    return int_eq[U64](a: pa.special, b: 1_u64) and int_eq[U64](a: pb.special, b: 1_u64)
  return int_eq[S64](a: pa.exp, b: pb.exp)

### IEEE 754 quantize: `me`'s value re-expressed with `other`'s exponent (half-even when dropping
### digits). NaN if the result needs more than 16 significand digits, or for incompatible specials.
### :param other: The value supplying the target exponent.
### :returns: `me` quantized to `other`'s exponent, or NaN if not representable.
routine D64.quantize(other: D64) -> D64
  var pa = me.decode()
  var pb = other.decode()
  if unsigned_ge[U64](a: pa.special, b: 2_u64) or unsigned_ge[U64](a: pb.special, b: 2_u64)
    return D64.quiet_nan()
  var ainf = int_eq[U64](a: pa.special, b: 1_u64)
  var binf = int_eq[U64](a: pb.special, b: 1_u64)
  if ainf or binf
    if ainf and binf
      return me
    return D64.quiet_nan()
  var target = pb.exp
  if int_eq[S64](a: pa.exp, b: target)
    return me
  if signed_gt[S64](a: pa.exp, b: target)
    var shift = sub[S64](a: pa.exp, b: target)
    if int_ne[U64](a: pa.coeff, b: 0_u64) and signed_gt[S64](a: add[S64](a: digits10_u64(c: pa.coeff), b: shift), b: 16_s64)
      return D64.quiet_nan()
    var scaled = mul[U256](a: zero_extend[U64, U256](pa.coeff), b: pow10b(k: shift))
    return d64_of_parts(p: D64Parts(sign: pa.sign, special: 0_u64, exp: target, coeff: int_truncate[U256, U64](scaled)))
  var drop = sub[S64](a: target, b: pa.exp)
  if signed_gt[S64](a: drop, b: 16_s64)
    return d64_of_parts(p: D64Parts(sign: pa.sign, special: 0_u64, exp: target, coeff: 0_u64))
  var cw = zero_extend[U64, U256](pa.coeff)
  var divp = pow10b(k: drop)
  var q = div_pow10b(x: cw, k: drop)
  var r = sub[U256](a: cw, b: mul[U256](a: q, b: divp))
  var twice = mul[U256](a: r, b: zero_extend[U64, U256](2_u64))
  if unsigned_gt[U256](a: twice, b: divp)
    q = add[U256](a: q, b: zero_extend[U64, U256](1_u64))
  elseif int_eq[U256](a: twice, b: divp) and int_ne[U256](a: bit_and[U256](a: q, b: zero_extend[U64, U256](1_u64)), b: zero_extend[U64, U256](0_u64))
    q = add[U256](a: q, b: zero_extend[U64, U256](1_u64))
  return d64_of_parts(p: D64Parts(sign: pa.sign, special: 0_u64, exp: target, coeff: int_truncate[U256, U64](q)))

### IEEE 754 remainder: `me - other * n` with `n` the nearest integer to `me / other` (ties even).
### NaN if `me` infinite or `other` zero; `me` if `other` infinite. Never crashes.
### :param other: The divisor.
### :returns: The IEEE remainder of `me / other`.
routine D64.remainder(other: D64) -> D64
  if me.is_nan() or other.is_nan()
    return D64.quiet_nan()
  if me.is_infinite() or other.is_zero()
    return D64.quiet_nan()
  if other.is_infinite()
    return me
  var n = me.$truediv_unchecked(you: other).rint()
  return me.$sub_unchecked(you: other.$mul_unchecked(you: n))

### IEEE 754 normalize (the `reduce` operation): trailing zeros stripped to the simplest cohort
### member (`3.00` -> `3`, `1.50` -> `1.5`, `100` -> `1E+2`, `0.00` -> `0`). Specials pass through.
### Never crashes. Arithmetic stays cohort-preserving (IEEE); this is the opt-in to shortest form.
### :returns: `me` normalized to its simplest cohort member.
routine D64.normalize() -> D64
  var p = me.decode()
  if int_ne[U64](a: p.special, b: 0_u64)
    return me
  if int_eq[U64](a: p.coeff, b: 0_u64)
    return d64_of_parts(p: D64Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: 0_u64))
  return d64_of_parts(p: decfin64(sign: p.sign, coeff: zero_extend[U64, U128](p.coeff), exp: p.exp, pref: 369_s64))

### Rounds to integral. mode: 0 trunc, 1 floor, 2 ceil, 3 round (half away), 4 rint (half even).
routine d64_round_int(x: D64, mode: S64) -> D64
  var p = x.decode()
  if int_ne[U64](a: p.special, b: 0_u64)
    return x
  if int_eq[U64](a: p.coeff, b: 0_u64)
    return x
  if signed_ge[S64](a: p.exp, b: 0_s64)
    return x
  var ndrop = sub[S64](a: 0_s64, b: p.exp)
  var cw = zero_extend[U64, U256](p.coeff)
  var q = zero_extend[U64, U256](0_u64)
  var rnz = true
  var half = false
  var gthalf = false
  if signed_le[S64](a: ndrop, b: 16_s64)
    var divp = pow10b(k: ndrop)
    q = div_pow10b(x: cw, k: ndrop)
    var r = sub[U256](a: cw, b: mul[U256](a: q, b: divp))
    rnz = int_ne[U256](a: r, b: 0)
    var twice = mul[U256](a: r, b: zero_extend[U64, U256](2_u64))
    half = int_eq[U256](a: twice, b: divp)
    gthalf = unsigned_gt[U256](a: twice, b: divp)
  var inc = false
  if int_eq[S64](a: mode, b: 1_s64)
    inc = p.sign and rnz
  elseif int_eq[S64](a: mode, b: 2_s64)
    inc = (not p.sign) and rnz
  elseif int_eq[S64](a: mode, b: 3_s64)
    inc = gthalf or half
  elseif int_eq[S64](a: mode, b: 4_s64)
    if gthalf
      inc = true
    elseif half
      inc = int_ne[U256](a: bit_and[U256](a: q, b: zero_extend[U64, U256](1_u64)), b: zero_extend[U64, U256](0_u64))
  var qq = q
  if inc
    qq = add[U256](a: q, b: zero_extend[U64, U256](1_u64))
  return d64_of_parts(p: D64Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: int_truncate[U256, U64](qq)))

### Truncates toward zero to an integral value. Never crashes.
### :returns: `me` with its fractional part discarded.
routine D64.trunc() -> D64
  return d64_round_int(x: me, mode: 0_s64)

### Rounds down (toward -inf) to an integral value. Never crashes.
### :returns: The largest integer <= `me`.
routine D64.floor() -> D64
  return d64_round_int(x: me, mode: 1_s64)

### Rounds up (toward +inf) to an integral value. Never crashes.
### :returns: The smallest integer >= `me`.
routine D64.ceil() -> D64
  return d64_round_int(x: me, mode: 2_s64)

### Rounds to nearest integer, ties away from zero. Never crashes.
### :returns: `me` rounded with ties away.
routine D64.round() -> D64
  return d64_round_int(x: me, mode: 3_s64)

### IEEE 754 roundToIntegral, ties to even. Never crashes.
### :returns: `me` rounded with ties to even.
routine D64.rint() -> D64
  return d64_round_int(x: me, mode: 4_s64)

### Fractional part me - trunc(me) (carries me's sign). NaN/inf -> NaN/±0. Never crashes.
### :returns: The signed fractional part of `me`.
routine D64.frac() -> D64
  if me.is_nan()
    return me
  var p = me.decode()
  if int_eq[U64](a: p.special, b: 1_u64)
    return d64_of_parts(p: D64Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: 0_u64))
  return me - me.trunc()
