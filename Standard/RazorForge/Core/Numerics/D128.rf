### The high 256 bits of the 512-bit product `a * b`, from four 128 x 128 partial products (each fits
### U256), so no 512-bit integer is needed.
routine u256_mulhi(a: U256, b: U256) -> U256
  var w128 = U256.to_width(s: 128_s64)
  var a0 = LLVM::zero_extend[U128, U256](LLVM::int_truncate[U256, U128](a))
  var a1 = LLVM::shift_right_unsigned(a, w128)
  var b0 = LLVM::zero_extend[U128, U256](LLVM::int_truncate[U256, U128](b))
  var b1 = LLVM::shift_right_unsigned(b, w128)
  var p00 = LLVM::mul(a: a0, b: b0)
  var p01 = LLVM::mul(a: a0, b: b1)
  var p10 = LLVM::mul(a: a1, b: b0)
  var p11 = LLVM::mul(a: a1, b: b1)
  var p01_lo = LLVM::zero_extend[U128, U256](LLVM::int_truncate[U256, U128](p01))
  var p10_lo = LLVM::zero_extend[U128, U256](LLVM::int_truncate[U256, U128](p10))
  # the middle column: carries out of bit 256 of the low half
  var mid = LLVM::add(a: LLVM::add(a: LLVM::shift_right_unsigned(p00, w128), b: p01_lo), b: p10_lo)
  var hi = LLVM::add(a: p11, b: LLVM::shift_right_unsigned(p01, w128))
  hi = LLVM::add(a: hi, b: LLVM::shift_right_unsigned(p10, w128))
  return LLVM::add(a: hi, b: LLVM::shift_right_unsigned(mid, w128))

### floor(x / 10^k) by reciprocal-multiply (k in 1..40); k<=0 returns x.
routine div_pow10b(x: U256, k: S64) -> U256
  if LLVM::signed_le(a: k, b: 0_s64)
    return x
  var ku = LLVM::reinterpret_bits[S64, U64](k)
  var i0 = LLVM::reinterpret_bits[S64, U64](LLVM::mul(a: k, b: 4_s64))
  var i1 = LLVM::add(a: i0, b: 1_u64)
  var i2 = LLVM::add(a: i0, b: 2_u64)
  var i3 = LLVM::add(a: i0, b: 3_u64)
  var g0 = POW10_MAGIC[i0]
  var g1 = POW10_MAGIC[i1]
  var g2 = POW10_MAGIC[i2]
  var g3 = POW10_MAGIC[i3]
  var mm = LLVM::bit_or(a: LLVM::bit_or(a: LLVM::zero_extend[U64, U256](g0), b: LLVM::shift_left(value: LLVM::zero_extend[U64, U256](g1), bits: U256.to_width(s: 64_s64))), b: LLVM::bit_or(a: LLVM::shift_left(value: LLVM::zero_extend[U64, U256](g2), bits: U256.to_width(s: 128_s64)), b: LLVM::shift_left(value: LLVM::zero_extend[U64, U256](g3), bits: U256.to_width(s: 192_s64))))
  var t = u256_mulhi(a: x, b: mm)
  var s = POW10_SHIFT[ku]
  var ad = POW10_ADD[ku]
  if LLVM::int_ne(a: ad, b: 0_u64)
    var dd = LLVM::shift_right_unsigned(LLVM::sub(a: x, b: t), U256.to_width(s: 1_s64))
    var q = LLVM::add(a: dd, b: t)
    return LLVM::shift_right_unsigned(q, U256.to_width(s: LLVM::sub(a: s, b: 1_s64)))
  return LLVM::shift_right_unsigned(t, U256.to_width(s: s))

