### Returns `me ^ you` (computed in octuple).
routine F128.pow!(you: F128) -> F128
  var rr = me.pow_unchecked(you: you)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me^you` with raw IEEE (full C99 pow special-case ladder). No crash.
### Core path is octuple `exp(you * ln|me|)`; the sign of an odd-integer exponent is reapplied.
routine F128.pow_unchecked(you: F128) -> F128
  return me.pow_unchecked_p(you: you, logn: 23_s64, expn: 20_s64, fast: false)

### Precision-parameterized pow. `fast: true` runs the general `exp(you * ln|me|)` core at
### F128 width (113-bit significand, ~59 guard bits over D64's 54-bit target) instead of octuple;
### `fast: false` keeps the octuple path for F128's own correctly-rounded 113-bit result. The
### C99 special-case ladder is precision-independent and shared. `logn`/`expn` set the series
### degrees of the general path.
routine F128.pow_unchecked_p(you: F128, logn: S64, expn: S64, fast: Bool) -> F128
  var one = UnpackedFloat[U128, U256, 128].from_s64(src: 1_s64).to_f128()
  var negone = one.neg()
  var yo = you.to_oct()
  # Integer/odd-integer exponent classification drives sign rules and domain checks below.
  var yisint = yo.isint()
  var yisoddint = yisint and not yo.iseven()
  var poszero = F128.from_bits(bits: 0_u128)
  var negzero = F128.from_bits(bits: LLVM::shift_left(value: 1_u128, bits: 127_u128))
  var posinf = F128.from_bits(bits: f128_inf(sign: 0_u64))
  var neginf = F128.from_bits(bits: f128_inf(sign: 1_u64))
  var xs = 0_u64
  if me.is_negative()
    xs = 1_u64
  # Negative base raised to a non-integer power has no real result -> qNaN.
  if me.is_negative() and me.is_finite() and not me.is_zero() and you.is_finite() and not yisint
    return F128.from_bits(bits: f128_qnan())
  if me == one or you.is_zero()
    return one
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if you.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: you.to_bits()))
  if not you.is_negative() and not you.is_zero() and me.is_zero() and yisoddint
    return me
  if me.is_zero() and not you.is_negative() and not you.is_zero() and not yisoddint
    return poszero
  if you.is_infinite() and me == negone
    return one
  var absxlt1 = negone < me and me < one
  var absxgt1 = me < negone or one < me
  if you.is_infinite() and you.is_negative() and absxlt1
    return posinf
  if you.is_infinite() and you.is_negative() and absxgt1
    return poszero
  if you.is_infinite() and not you.is_negative() and absxlt1
    return poszero
  if you.is_infinite() and not you.is_negative() and absxgt1
    return posinf
  if me.is_infinite() and me.is_negative() and you.is_negative() and yisoddint
    return negzero
  if me.is_infinite() and me.is_negative() and you.is_negative() and not you.is_zero() and not yisoddint
    return poszero
  if me.is_infinite() and me.is_negative() and not you.is_negative() and yisoddint
    return neginf
  if me.is_infinite() and me.is_negative() and not you.is_negative() and not you.is_zero() and not yisoddint
    return posinf
  if me.is_infinite() and not me.is_negative() and you.is_negative() and not you.is_zero()
    return poszero
  if me.is_infinite() and not me.is_negative() and not you.is_negative() and not you.is_zero()
    return posinf
  if me.is_zero() and yisoddint and you.is_negative()
    return F128.from_bits(bits: f128_inf(sign: xs))
  if me.is_zero() and you.is_negative() and not you.is_zero() and not yisoddint
    return posinf
  # General case: exp(you * ln|me|). Fast path stays at F128 width; default path is octuple.
  if fast
    var zu = me.abs().to_uf().log(n: logn, m: 0_s64, t: 0_s64).mul(you: you.to_uf()).exp(n: expn)
    # Negative base with an odd-integer exponent keeps a negative result.
    if me.is_negative() and yisoddint
      zu = zu.neg()
    return zu.to_f128()
  var z = me.abs().to_oct().log(n: logn, m: 0_s64, t: 0_s64).mul(you: yo).exp(n: expn)
  # Negative base with an odd-integer exponent keeps a negative result.
  if me.is_negative() and yisoddint
    z = z.neg()
  return z.to_f128()

### Returns `atan(me)`.
routine F128.atan() -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  return me.to_uf().atan().to_f128()

### Returns `asin(me)`.
routine F128.asin!() -> F128
  var rr = me.asin_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `asin(me)` with raw IEEE (|me|>1 -> qNaN). No crash.
routine F128.asin_unchecked() -> F128
  if me.is_nan()
