# ============================================================================
# Forward trig — Payne-Hanek argument reduction (TLFloat ph) over the rpitab
# 1/(2pi) table, then sin/cos/tan polynomials. Quad params: sin/cos N=14, tan N=16 M=2.
# ============================================================================

### Reads `nbytes` table bytes starting at `start`, MSB-first, into an `L`.
common routine L.read_table_bytes(start: S64, nbytes: S64) -> L
  var acc = L.to_width(s: 0_s64)
  var i = 0_s64
  while LLVM::signed_lt(a: i, b: nbytes)
    var byte = rpitab_byte(idx: LLVM::reinterpret_bits[S64, U64](LLVM::add(a: start, b: i)))
    acc = LLVM::add(a: LLVM::shift_left(value: acc, bits: L.to_width(s: 8_s64)), b: LLVM::zero_extend[U64, L](byte))
    i = LLVM::add(a: i, b: 1_s64)
  return acc

### Payne-Hanek reduction: returns (reduced angle, quadrant&0xff). TLFloat `ph`.
routine UnpackedFloat[M, L, W].ph(p: S64) -> UFExp[M, L, W]
  var wb = LLVM::reinterpret_bits[U64, S64](W)
  var w2 = LLVM::mul(a: 2_s64, b: wb)
  var nbytes = LLVM::signed_div(a: wb, b: 8_s64)
  var nbmant = LLVM::sub(a: wb, b: 2_s64)
  # Tiny arguments (|me| < ~2^-5) need no reduction: return unchanged, quadrant 0.
  if me.iszero() or LLVM::signed_lt(a: me.exp, b: -5_s64)
    var asis = UnpackedFloat[M, L, W].make(mant: me.mant, exp: me.exp, fpclass: SignedFpClass.from_flags(sign: me.sign(), iszero: me.iszero(), isinf: me.isinf(), isnan: me.isnan()))
    return UFExp[M, L, W](item0: asis, item1: 0_s64)
  # Pick the byte window of the 1/(2pi) table aligned to the input's binary exponent so
  # only the bits of 1/(2pi) that overlap me's significance are multiplied.
  var mantexp = LLVM::sub(a: me.exp, b: LLVM::sub(a: nbmant, b: 1_s64))
  var m = LLVM::sub(a: mantexp, b: 1_s64)
  if LLVM::signed_lt[S64](a: m, b: 0_s64)
    m = 0_s64
  var m_aligned = LLVM::sub[S64](a: m, b: LLVM::signed_rem[S64](a: m, b: 8_s64))
  var rpiexp = LLVM::sub(a: LLVM::sub(a: p, b: m_aligned), b: wb)
  var m8 = LLVM::signed_div[S64](a: m, b: 8_s64)
  # Read two W-bit limbs (high, low) of 1/(2pi) and form mant * 1/(2pi) at full width.
  var rpih = L.read_table_bytes(start: m8, nbytes: nbytes)
  var rpil = L.read_table_bytes(start: LLVM::add(a: m8, b: nbytes), nbytes: nbytes)
  var mantL = LLVM::zero_extend[M, L](me.mant)
  var rm = LLVM::add(a: LLVM::mul(a: mantL, b: rpih), b: LLVM::shift_right_unsigned(LLVM::mul(a: mantL, b: rpil), L.to_width(s: wb)))
  # Extract the integer quadrant q = round(rm) and subtract it, leaving the fractional
  # part rm in [-1/2, 1/2) of a full turn (round-to-nearest via the roundbit + mask).
  var q = 0_s64
  var negshift = LLVM::sub(a: 0_s64, b: LLVM::add(a: mantexp, b: rpiexp))
  if LLVM::signed_lt(a: negshift, b: w2)
    var roundbit = LLVM::shift_left[L](value: L.to_width(s: 1_s64), bits: L.to_width(s: LLVM::sub[S64](a: negshift, b: 1_s64)))
    var mask = LLVM::shift_left(value: (L.to_width(s: 0_s64)).bit_not(), bits: L.to_width(s: negshift))
    var qm = LLVM::bit_and(a: LLVM::add(a: rm, b: roundbit), b: mask)
    rm = LLVM::sub(a: rm, b: qm)
    q = LLVM::int_truncate[L, S64](LLVM::shift_right_unsigned(qm, L.to_width(s: negshift)))
  var exp = LLVM::sub(a: LLVM::add(a: mantexp, b: rpiexp), b: p)
  # If the fraction is tiny (near 0 or all-ones), bring in more low limbs of 1/(2pi) to
  # keep full precision before normalizing.
  var j = LLVM::mul(a: 2_s64, b: nbytes)
  while LLVM::signed_gt(a: UnpackedFloat[M, L, W].clz_wide(v: rm), b: wb) or LLVM::signed_gt(a: UnpackedFloat[M, L, W].clz_wide(v: (rm).bit_not()), b: wb)
    var lowpart = LLVM::bit_and(a: LLVM::mul(a: mantL, b: rpil), b: L.low_mask(n: wb))
    rm = LLVM::add(a: LLVM::shift_left(value: rm, bits: L.to_width(s: wb)), b: lowpart)
    rpil = L.read_table_bytes(start: LLVM::add(a: j, b: m8), nbytes: nbytes)
    rm = LLVM::add(a: rm, b: LLVM::shift_right_unsigned(LLVM::mul(a: mantL, b: rpil), L.to_width(s: wb)))
    exp = LLVM::sub(a: exp, b: wb)
    j = LLVM::add(a: j, b: nbytes)
  # If the fraction is in the upper half (>= 1/2 turn) negate it (and q, sign) so the
  # reduced value lies in [0, 1/2) and the quadrant accounting stays consistent.
  var sign = me.sign()
  if (rm).bit(pos: LLVM::sub(a: w2, b: 1_s64))
    rm = LLVM::sub[L](a: L.to_width(s: 0_s64), b: rm)
    q = LLVM::sub(a: 0_s64, b: q)
    sign = not sign
  # Normalize the fraction back into an M-bit mantissa u (left/right shift with rounding),
  # fixing the exponent x for any leading-zero count or rounding carry.
  var x = LLVM::sub(a: w2, b: UnpackedFloat[M, L, W].clz_wide(v: rm))
  var s = LLVM::sub(a: nbmant, b: LLVM::sub(a: x, b: 1_s64))
  var u = M.to_width(s: 0_s64)
  if LLVM::signed_ge(a: s, b: 0_s64)
    u = LLVM::int_truncate[L, M](LLVM::shift_left(value: rm, bits: L.to_width(s: s)))
  else
    var ns = LLVM::sub(a: 0_s64, b: s)
    var rb = LLVM::shift_left[L](value: L.to_width(s: 1_s64), bits: L.to_width(s: LLVM::sub[S64](a: ns, b: 1_s64)))
    u = LLVM::int_truncate[L, M](LLVM::shift_right_unsigned(LLVM::add(a: rm, b: rb), L.to_width(s: ns)))
  if (u).bit(pos: LLVM::add(a: nbmant, b: 1_s64))
    u = LLVM::shift_right_unsigned(u, M.to_width(s: 1_s64))
    x = LLVM::add(a: x, b: 1_s64)
  # Multiply the reduced turn-fraction by pi to get the reduced angle in radians.
  var rexp = LLVM::add(a: LLVM::sub(a: x, b: 2_s64), b: exp)
  var r = UnpackedFloat[M, L, W].make(mant: u, exp: rexp, fpclass: SignedFpClass.from_flags(sign: false, iszero: false, isinf: false, isnan: false)).mul(you: UnpackedFloat[M, L, W].pi())
  var rr = r
  if sign
    rr = r.neg()
  var qv = q
  if sign
    qv = LLVM::sub(a: 0_s64, b: q)
  var qf = LLVM::reinterpret_bits[U64, S64](LLVM::bit_and(a: LLVM::reinterpret_bits[S64, U64](qv), b: 0xff_u64))
  return UFExp[M, L, W](item0: rr, item1: qf)

### sin on the unpacked engine (TLFloat sin_, N=14).
routine UnpackedFloat[M, L, W].sin(n: S64) -> UnpackedFloat[M, L, W]
  # Payne-Hanek reduce to (red, quad); evaluate the series in -red^2.
  var pr = me.ph(p: 1_s64)
  var red = pr.item0
  var quad = pr.item1
  var negsq = red.mul(you: red).neg()
  var d = UnpackedFloat[M, L, W].from_s64(src: 0_s64)
  if LLVM::int_ne(a: LLVM::bit_and(a: quad, b: 1_s64), b: 0_s64)
    # Odd quadrant: sin(x) = cos(reduced); Horner in -red^2 over cos coefficients.
    d = UnpackedFloat[M, L, W].cos_coef(LLVM::add(a: n, b: 1_s64))
    var i = n
    while LLVM::signed_ge(a: i, b: 0_s64)
      d = d.fma(b: negsq, c: UnpackedFloat[M, L, W].cos_coef(i))
      i = LLVM::sub(a: i, b: 1_s64)
  else
    # Even quadrant: sin polynomial in -red^2, multiplied by red (odd function).
    d = UnpackedFloat[M, L, W].sin_coef(n)
    var i = LLVM::sub(a: n, b: 1_s64)
    while LLVM::signed_ge(a: i, b: 0_s64)
      d = d.fma(b: negsq, c: UnpackedFloat[M, L, W].sin_coef(i))
      i = LLVM::sub(a: i, b: 1_s64)
    d = d.mul(you: red)
  # Bit 1 of the quadrant flips the sign (quadrants 2,3).
  if LLVM::int_ne(a: LLVM::bit_and(a: quad, b: 2_s64), b: 0_s64)
    return d.neg()
  return d

### cos on the unpacked engine (TLFloat cos_), with explicit series term count `cn`
### (the even-quadrant cos poly runs to cn+1, the odd-quadrant sin poly to cn). A lower
### `cn` suffices for narrower targets (e.g. D64 at 54 bits) since |red| <= pi/4 caps the
### series argument. W=512 overrides to its 70-digit degree regardless.
routine UnpackedFloat[M, L, W].cos_n(cn: S64) -> UnpackedFloat[M, L, W]
  # Payne-Hanek reduce; evaluate in -red^2 like sin but with the quadrant roles swapped.
  var pr = me.ph(p: 1_s64)
  var red = pr.item0
  var quad = pr.item1
  var negsq = red.mul(you: red).neg()
  # W=512 needs higher poly degree (the ph reduction is already full-width).
  var codd = cn
  var ceven = LLVM::add(a: cn, b: 1_s64)
  if LLVM::int_eq[U64](a: W, b: 512_u64)
    codd = 26_s64
    ceven = 27_s64
  var d = UnpackedFloat[M, L, W].from_s64(src: 0_s64)
  if LLVM::int_ne(a: LLVM::bit_and(a: quad, b: 1_s64), b: 0_s64)
    # Odd quadrant: cos(x) = -sin(reduced); sin poly in -red^2 times -red.
    d = UnpackedFloat[M, L, W].sin_coef(codd)
    var i = LLVM::sub(a: codd, b: 1_s64)
    while LLVM::signed_ge(a: i, b: 0_s64)
      d = d.fma(b: negsq, c: UnpackedFloat[M, L, W].sin_coef(i))
      i = LLVM::sub(a: i, b: 1_s64)
    d = d.mul(you: red.neg())
  else
    # Even quadrant: cos polynomial in -red^2 (even function).
    d = UnpackedFloat[M, L, W].cos_coef(ceven)
    var i = LLVM::sub(a: ceven, b: 1_s64)
    while LLVM::signed_ge(a: i, b: 0_s64)
      d = d.fma(b: negsq, c: UnpackedFloat[M, L, W].cos_coef(i))
      i = LLVM::sub(a: i, b: 1_s64)
  # Bit 1 of the quadrant flips the sign (quadrants 2,3).
  if LLVM::int_ne(a: LLVM::bit_and(a: quad, b: 2_s64), b: 0_s64)
    return d.neg()
  return d

### cos on the unpacked engine (TLFloat cos_, N=14) at the full F128/F256 term count.
routine UnpackedFloat[M, L, W].cos() -> UnpackedFloat[M, L, W]
  return me.cos_n(cn: 14_s64)

### Returns `sin(me)`.
routine F128.sin() -> F128
  return me.sin_n(n: 14_s64)

### `sin(me)` with the series explicit atanh/exp-series term count `n`.
routine F128.sin_n(n: S64) -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    return F128.from_bits(bits: f128_qnan())
  return me.to_uf().sin(n: n).to_f128()

### Returns `cos(me)`.
routine F128.cos() -> F128
  return me.cos_n(n: 14_s64)

### `cos(me)` with the cos-series explicit term count `n`.
routine F128.cos_n(n: S64) -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    return F128.from_bits(bits: f128_qnan())
  return me.to_uf().cos_n(cn: n).to_f128()

### tan numerator/denominator pair (TLFloat tan_, N=16, M=2); tan = first/second.
### `td0` is the tan-poly degree; a lower value suffices for narrower targets since the
### 2^sh half-angle reduction caps |x| <= ~pi/4/2^sh. W=512 overrides to its 70-digit degree.
routine UnpackedFloat[M, L, W].tanxy_n(td0: S64) -> UFPair[M, L, W]
  var pr = me.ph(p: 1_s64)
  var red = pr.item0
  var quad = pr.item1
  # W=512 reduces by 2^sh (sh doublings reconstruct: sh-1 in the loop + 1 after) and
  # uses a higher-degree numerator poly for 70+ digits.
  var sh = 3_s64
  var tdeg = td0
  if LLVM::int_eq[U64](a: W, b: 512_u64)
    sh = 6_s64
    tdeg = 25_s64
  # Reduce by 2^sh so the tan polynomial converges; x = red / 2^sh.
  var x = red.ldexp(e: LLVM::sub(a: 0_s64, b: sh))
  var xx = x.mul(you: x)
  # Horner for tan(x)/x in x^2, then multiply by x.
  var d = UnpackedFloat[M, L, W].tan_coef(tdeg)
  var i = tdeg
  while LLVM::signed_gt(a: i, b: 0_s64)
    d = d.fma(b: xx, c: UnpackedFloat[M, L, W].tan_coef(LLVM::sub(a: i, b: 1_s64)))
    i = LLVM::sub(a: i, b: 1_s64)
  d = d.mul(you: x)
  # Double-angle: tan(2t) = -2t / (t^2 - 1), applied sh-1 times here (last step after).
  var negone = UnpackedFloat[M, L, W].from_s64(src: -1_s64)
  var y = UnpackedFloat[M, L, W].from_s64(src: 0_s64)
  var k = 0_s64
  while LLVM::signed_lt(a: k, b: LLVM::sub(a: sh, b: 1_s64))
    y = d.fma(b: d, c: negone)
    x = d.ldexp(e: 1_s64).neg()
    d = x.div(you: y)
    k = LLVM::add(a: k, b: 1_s64)
  # Final doubling kept as a numerator/denominator pair (x = -2d, y = d^2-1) so the
  # caller divides once; an odd quadrant means tan -> cot, so swap and negate.
  y = d.fma(b: d, c: negone)
  x = d.ldexp(e: 1_s64).neg()
  if LLVM::int_ne(a: LLVM::bit_and(a: quad, b: 1_s64), b: 0_s64)
    var tmp = x
    x = y
    y = tmp.neg()
  return UFPair[M, L, W](item0: x, item1: y)

### tan numerator/denominator pair at the full F128/F256 degree.
routine UnpackedFloat[M, L, W].tanxy() -> UFPair[M, L, W]
  return me.tanxy_n(td0: 15_s64)

### tan on the unpacked engine, with explicit tan-poly degree `td0`.
routine UnpackedFloat[M, L, W].tan_n(td0: S64) -> UnpackedFloat[M, L, W]
  var p = me.tanxy_n(td0: td0)
  return p.item0.div(you: p.item1)

### tan on the unpacked engine.
routine UnpackedFloat[M, L, W].tan() -> UnpackedFloat[M, L, W]
  return me.tan_n(td0: 15_s64)

### Returns `tan(me)`.
routine F128.tan() -> F128
  return me.tan_n(n: 15_s64)

### `tan(me)` with the tan-series explicit degree `n`.
routine F128.tan_n(n: S64) -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    return F128.from_bits(bits: f128_qnan())
  return me.to_uf().tan_n(td0: n).to_f128()

### Returns the fused multiply-add `me*b + c` with a single rounding (octuple).
routine F128.fma!(b: F128, c: F128) -> F128
  var rr = me.fma_unchecked(b: b, c: c)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me*b + c` (single rounding, octuple) with raw IEEE propagation. No crash.
routine F128.fma_unchecked(b: F128, c: F128) -> F128
  return me.to_oct().fma(b: b.to_oct(), c: c.to_oct()).to_f128()

### Returns `sqrt(me^2 + you^2)` without spurious overflow (TLFloat hypot).
routine F128.hypot!(you: F128) -> F128
  var rr = me.hypot_unchecked(you: you)
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `sqrt(me^2 + you^2)` with raw IEEE (any inf -> +inf, any NaN -> qNaN). No crash.
routine F128.hypot_unchecked(you: F128) -> F128
  var xx = me.to_uf()
  var yy = you.to_uf()
  if xx.isinf() or yy.isinf()
    return F128.from_bits(bits: f128_inf(sign: 0_u64))
  if xx.isnan() or yy.isnan()
    return F128.from_bits(bits: f128_qnan())
  return xx.mul(you: xx).add(you: yy.mul(you: yy)).sqrt().to_f128()

# ============================================================================
# sinpi / cospi / tanpi (TLFloat; no rpitab — reduce via round(2a) then sin/cos polynomials)
# ============================================================================

### Low 16 bits of the integer value (TLFloat `intlsb`).
routine UnpackedFloat[M, L, W].intlsb() -> S64
  if me.iszero() or me.isinf() or me.isnan()
    return 0_s64
  var wb = LLVM::reinterpret_bits[U64, S64](W)
  var nbmant = LLVM::sub(a: wb, b: 2_s64)
  var s = LLVM::sub(a: nbmant, b: LLVM::add(a: me.exp, b: 1_s64))
  if LLVM::signed_ge(a: s, b: wb) or LLVM::signed_le(a: s, b: -16_s64)
    return 0_s64
  var mm = 0_s64
  if LLVM::signed_ge(a: s, b: 0_s64)
    mm = LLVM::int_truncate[M, S64](LLVM::shift_right_unsigned(me.mant, M.to_width(s: s)))
  else
    mm = LLVM::int_truncate[M, S64](LLVM::shift_left(value: me.mant, bits: M.to_width(s: LLVM::sub(a: 0_s64, b: s))))
  mm = LLVM::bit_and(a: mm, b: 0xffff_s64)
  if me.sign()
    return LLVM::sub(a: LLVM::sub(a: 0_s64, b: mm), b: 1_s64)
  return mm

### sinpi polynomial (TLFloat sinpi_, N=14) on the already-reduced argument.
routine UnpackedFloat[M, L, W].sinpi_poly() -> UnpackedFloat[M, L, W]
  # Evaluate the ordinary sin polynomial at p = pi*me (Horner in -p^2), times -p.
  var p = UnpackedFloat[M, L, W].pi().mul(you: me)
  var negsq = p.mul(you: p).neg()
  var d = UnpackedFloat[M, L, W].sin_coef(14_s64)
  var i = 13_s64
  while LLVM::signed_ge(a: i, b: 0_s64)
    d = d.fma(b: negsq, c: UnpackedFloat[M, L, W].sin_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  return d.mul(you: p.neg())

### cospi polynomial (TLFloat cospi_, N=14) on the already-reduced argument.
routine UnpackedFloat[M, L, W].cospi_poly() -> UnpackedFloat[M, L, W]
  # Evaluate the ordinary cos polynomial at p = pi*me (Horner in -p^2).
  var p = UnpackedFloat[M, L, W].pi().mul(you: me)
  var negsq = p.mul(you: p).neg()
  var d = UnpackedFloat[M, L, W].cos_coef(15_s64)
  var i = 14_s64
  while LLVM::signed_ge(a: i, b: 0_s64)
    d = d.fma(b: negsq, c: UnpackedFloat[M, L, W].cos_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  return d

### Returns `sin(pi*me)`.
routine F128.sinpi() -> F128
  if me.is_nan() or me.is_zero()
    return me
  if me.is_infinite()
    return F128.from_bits(bits: f128_qnan())
  # Reduce on the doubled argument: y = (2a - round(2a))/2 in [-1/4, 1/4]; lx is the low
  # bits of round(2a)*2, selecting which polynomial (sin/cos) and the result sign.
  var a = me.to_uf()
  var x = a.ldexp(e: 1_s64)
  var y = x.sub(you: x.round()).ldexp(e: -1_s64)
  var lx = x.ldexp(e: 1_s64).intlsb()
  var lx3 = LLVM::bit_and(a: lx, b: 3_s64)
  # Exact zeros at integer arguments (sin(pi*integer) = 0), preserving the signed zero.
  if ((LLVM::signed_ge(a: lx, b: 0_s64) and lx3 == 0_s64) or (LLVM::signed_lt(a: lx, b: 0_s64) and lx3 == 3_s64)) and x.isint()
    return UnpackedFloat[U128, U256, 128].zero(sign: x.sign()).to_f128()
  # Quadrant selects cospi vs sinpi polynomial; a further bit flips the sign.
  var z = y.cospi_poly()
  if LLVM::int_ne(a: LLVM::bit_and(a: LLVM::add(a: lx, b: 3_s64), b: 2_s64), b: 0_s64)
    z = y.sinpi_poly()
  if LLVM::int_ne(a: LLVM::bit_and(a: LLVM::add(a: lx, b: 7_s64), b: 4_s64), b: 0_s64)
    z = z.neg()
  return z.to_f128()

### Returns `cos(pi*me)`.
routine F128.cospi() -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    return F128.from_bits(bits: f128_qnan())
  var a = me.to_uf()
  var x = a.ldexp(e: 1_s64)
  var y = x.sub(you: x.round()).ldexp(e: -1_s64)
  var lx = x.ldexp(e: 1_s64).intlsb()
  var lx3and2 = LLVM::bit_and(a: LLVM::add(a: lx, b: 3_s64), b: 2_s64)
  if lx3and2 == 0_s64 and y.iszero()
    return UnpackedFloat[U128, U256, 128].zero(sign: false).to_f128()
  var z = y.sinpi_poly()
  if LLVM::int_ne(a: lx3and2, b: 0_s64)
    z = y.cospi_poly()
  if LLVM::int_ne(a: LLVM::bit_and(a: LLVM::add(a: lx, b: 1_s64), b: 4_s64), b: 0_s64)
    z = z.neg()
  return z.to_f128()

### Returns `tan(pi*me)`.
routine F128.tanpi() -> F128
  if me.is_nan() or me.is_zero()
    return me
  if me.is_infinite()
    return F128.from_bits(bits: f128_qnan())
  var a = me.to_uf()
  var x = a.ldexp(e: 1_s64)
  var y = x.sub(you: x.round()).ldexp(e: -1_s64)
  var lx = x.ldexp(e: 1_s64).intlsb()
  var lx3 = LLVM::bit_and(a: lx, b: 3_s64)
  var lx4 = LLVM::bit_and(a: lx, b: 4_s64)
  if ((LLVM::signed_ge(a: lx, b: 0_s64) and lx3 == 0_s64) or (LLVM::signed_lt(a: lx, b: 0_s64) and lx3 == 3_s64)) and x.isint()
    return UnpackedFloat[U128, U256, 128].zero(sign: LLVM::int_ne(a: lx4, b: 0_s64)).to_f128()
  var pr = UnpackedFloat[U128, U256, 128].pi().mul(you: y).tanxy()
  var lx1and2 = LLVM::bit_and(a: LLVM::add(a: lx, b: 1_s64), b: 2_s64)
  var z = pr.item0.div(you: pr.item1)
  if LLVM::int_ne(a: lx1and2, b: 0_s64)
    z = pr.item1.div(you: pr.item0)
  if z.isinf()
    z = UnpackedFloat[U128, U256, 128].make(mant: z.mant, exp: z.exp, fpclass: SignedFpClass.from_flags(sign: LLVM::int_eq(a: lx4, b: 0_s64), iszero: z.iszero(), isinf: z.isinf(), isnan: z.isnan()))
  if LLVM::int_ne(a: lx1and2, b: 0_s64)
    z = z.neg()
  return z.to_f128()

# ============================================================================
# erf / erfc — continued-fraction expansions (TLFloat erf_/erfc_, N=120) in
# octuple, using exp(-(z^2)) with N=22 and 1/sqrt(pi).
# ============================================================================

### erf_ continued fraction (TLFloat erf_, N=120).
routine UnpackedFloat[M, L, W].erf_cf(levels: S64) -> UnpackedFloat[M, L, W]
  # Backward recurrence (Lentz-style numerator/denominator pair) for the erf continued
  # fraction; `levels` recurrence levels (must be EVEN — two steps per loop iteration), sized by the
  # caller to its precision target (F256 needs ~120; F128/D64 far fewer). The seed numerator is
  # 2*levels+1 (odd partial numerator just past the deepest level).
  var zz = me.mul(you: me)
  var n = UnpackedFloat[M, L, W].from_s64(src: LLVM::add(a: LLVM::mul(a: 2_s64, b: levels), b: 1_s64))
  var d = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var i = levels
  while LLVM::signed_gt(a: i, b: 0_s64)
    var i2 = LLVM::mul(a: i, b: 2_s64)
    var t = n
    n = n.mul(you: UnpackedFloat[M, L, W].from_s64(src: LLVM::sub(a: i2, b: 1_s64))).add(you: zz.mul(you: UnpackedFloat[M, L, W].from_s64(src: i2)).mul(you: d))
    d = t
    t = n
    n = n.mul(you: UnpackedFloat[M, L, W].from_s64(src: LLVM::sub(a: i2, b: 3_s64))).sub(you: zz.mul(you: UnpackedFloat[M, L, W].from_s64(src: LLVM::sub(a: i2, b: 2_s64))).mul(you: d))
    d = t
    i = LLVM::sub(a: i, b: 2_s64)
  # erf(z) = (2/sqrt(pi)) * z * e^(-z^2) * (d/n); the ldexp(1) = factor of 2, rsqrt_pi = 1/sqrt(pi).
  d = d.ldexp(e: 1_s64)
  return me.mul(you: UnpackedFloat[M, L, W].rsqrt_pi()).mul(you: zz.neg().exp(n: 22_s64)).mul(you: d.div(you: n))

### erfc_ continued fraction (TLFloat erfc_, N=120).
routine UnpackedFloat[M, L, W].erfc_cf(levels: S64) -> UnpackedFloat[M, L, W]
  # Backward recurrence for the erfc continued fraction (the i/2 partial terms), `levels` levels
  # (EVEN); converges for the tail |z| >= 3.1 where the erf series loses digits. Caller sizes `levels`
  # to its precision target.
  var zz = me.mul(you: me)
  var n = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var d = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var i = levels
  while LLVM::signed_gt(a: i, b: 0_s64)
    var t = n
    n = n.add(you: UnpackedFloat[M, L, W].from_s64(src: i).ldexp(e: -1_s64).mul(you: d))
    d = t
    t = n
    n = zz.mul(you: n).add(you: UnpackedFloat[M, L, W].from_s64(src: LLVM::sub(a: i, b: 1_s64)).ldexp(e: -1_s64).mul(you: d))
    d = t
    i = LLVM::sub(a: i, b: 2_s64)
  # erfc(z) = (1/sqrt(pi)) * z * e^(-z^2) * (d/n).
  return me.mul(you: UnpackedFloat[M, L, W].rsqrt_pi()).mul(you: zz.neg().exp(n: 22_s64)).mul(you: d.div(you: n))

### Returns the error function `erf(me)`.
routine F128.erf() -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    var s = if me.is_negative() then -1_s64 else 1_s64
    return UnpackedFloat[U128, U256, 128].from_s64(src: s).to_f128()
  var thr = UnpackedFloat[U256, U512, 256].from_s64(src: 31_s64).div(you: UnpackedFloat[U256, U512, 256].from_s64(src: 10_s64))
  var a = me.to_oct()
  if a.lt(you: thr.neg())
    return UnpackedFloat[U256, U512, 256].from_s64(src: -1_s64).sub(you: a.erfc_cf(levels: 120_s64)).to_f128()
  if a.lt(you: thr)
    # 72 levels is bit-exact for F128 across the whole erf branch |z|<3.1 (verified: lv=60 already
    # bit-identical to 120 at z=3.09); the shared W=256 erf_cf otherwise carries 120 for F256's 237 bits.
    return a.erf_cf(levels: 72_s64).to_f128()
  return UnpackedFloat[U256, U512, 256].from_s64(src: 1_s64).sub(you: a.erfc_cf(levels: 120_s64)).to_f128()

### Returns the complementary error function `erfc(me)`.
routine F128.erfc() -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    var s = if me.is_negative() then 2_s64 else 0_s64
    return UnpackedFloat[U128, U256, 128].from_s64(src: s).to_f128()
  var thr = UnpackedFloat[U256, U512, 256].from_s64(src: 31_s64).div(you: UnpackedFloat[U256, U512, 256].from_s64(src: 10_s64))
  var a = me.to_oct()
  if a.lt(you: thr.neg())
    return UnpackedFloat[U256, U512, 256].from_s64(src: 2_s64).add(you: a.erfc_cf(levels: 120_s64)).to_f128()
  if a.lt(you: thr)
    return UnpackedFloat[U256, U512, 256].from_s64(src: 1_s64).sub(you: a.erf_cf(levels: 72_s64)).to_f128()
  return a.erfc_cf(levels: 120_s64).to_f128()

### Precision-reduced erf for sub-113-bit targets (D64 ~54 bits): identical branch structure to
### `erf()` but the continued fraction runs at F128 width (113-bit) instead of octuple, with
### caller-sized `levels_mid` (|z|<3.1 erf branch) and `levels_tail` (|z|>=3.1 erfc branch).
routine F128.erf_fast(levels_mid: S64, levels_tail: S64) -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    var s = if me.is_negative() then -1_s64 else 1_s64
    return UnpackedFloat[U128, U256, 128].from_s64(src: s).to_f128()
  var thr = UnpackedFloat[U128, U256, 128].from_s64(src: 31_s64).div(you: UnpackedFloat[U128, U256, 128].from_s64(src: 10_s64))
  var a = me.to_uf()
  if a.lt(you: thr.neg())
    return UnpackedFloat[U128, U256, 128].from_s64(src: -1_s64).sub(you: a.erfc_cf(levels: levels_tail)).to_f128()
  if a.lt(you: thr)
    return a.erf_cf(levels: levels_mid).to_f128()
  return UnpackedFloat[U128, U256, 128].from_s64(src: 1_s64).sub(you: a.erfc_cf(levels: levels_tail)).to_f128()

### Precision-reduced erfc for sub-113-bit targets (D64): F128-width continued fraction with
### caller-sized `levels_mid`/`levels_tail`. Mirrors `erfc()`'s branch structure.
routine F128.erfc_fast(levels_mid: S64, levels_tail: S64) -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    var s = if me.is_negative() then 2_s64 else 0_s64
    return UnpackedFloat[U128, U256, 128].from_s64(src: s).to_f128()
  var thr = UnpackedFloat[U128, U256, 128].from_s64(src: 31_s64).div(you: UnpackedFloat[U128, U256, 128].from_s64(src: 10_s64))
  var a = me.to_uf()
  if a.lt(you: thr.neg())
    return UnpackedFloat[U128, U256, 128].from_s64(src: 2_s64).add(you: a.erfc_cf(levels: levels_tail)).to_f128()
  if a.lt(you: thr)
    return UnpackedFloat[U128, U256, 128].from_s64(src: 1_s64).sub(you: a.erf_cf(levels: levels_mid)).to_f128()
  return a.erfc_cf(levels: levels_tail).to_f128()

# ============================================================================
# tgamma / lgamma (TLFloat) — octuple Stirling series + reflection.
# Params: R=20, O=35, sin N=15, log N=23, exp N=20.
# ============================================================================

### lgamma core (TLFloat lgamma_): returns (sign, log|gamma(me)|).
routine UnpackedFloat[M, L, W].lgamma_core() -> UFSign[M, L, W]
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var p5 = one.ldexp(e: -1_s64)
  # For a < -1 use the reflection formula at the end; work with a = 1-me there.
  var reflect = me.lt(you: one.neg())
  var a = if reflect then one.sub(you: me) else me
  # Argument augmentation: shift a up to >= 20 by the recurrence gamma(a)=gamma(a+1)/a,
  # accumulating the divided-out factors in w (the Stirling series needs a large argument).
  var inv = a.rint()
  var fr = a.sub(you: inv)
  var w = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var twenty = UnpackedFloat[M, L, W].from_s64(src: 20_s64)
  if inv.lt(you: twenty)
    var ii = inv.to_s64()
    while LLVM::signed_lt(a: ii, b: 20_s64)
      w = w.mul(you: UnpackedFloat[M, L, W].from_s64(src: ii).add(you: fr))
      ii = LLVM::add(a: ii, b: 1_s64)
    a = twenty.add(you: fr)
  # Stirling asymptotic series in 1/a^2 (Bernoulli coefficients, degree 35), Horner.
  var inv_aa = one.div(you: a.mul(you: a))
  var y = UnpackedFloat[M, L, W].gamma_coef(35_s64)
  var i = 34_s64
  while LLVM::signed_ge(a: i, b: 0_s64)
    y = y.fma(b: inv_aa, c: UnpackedFloat[M, L, W].gamma_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  # Stirling: lgamma(a) = series/a + (a-1/2)*ln a - a + (1/2)*ln(2pi); subtract ln|w|
  # to undo the argument augmentation.
  var loga = a.log(n: 23_s64, m: 0_s64, t: 0_s64)
  y = y.div(you: a).add(you: a.sub(you: p5).mul(you: loga)).sub(you: a).add(you: p5.mul(you: UnpackedFloat[M, L, W].ln_2pi()))
  y = y.sub(you: w.abs().log(n: 23_s64, m: 0_s64, t: 0_s64))
  var sign = w.sign()
  if reflect
    # Reflection: lgamma(me) = ln(pi) - ln|sin(pi*fr)| - lgamma(1-me); sign from sin and parity.
    var s = UnpackedFloat[M, L, W].pi().mul(you: fr).sin(n: 15_s64)
    y = UnpackedFloat[M, L, W].ln_pi().sub(you: s.abs().log(n: 23_s64, m: 0_s64, t: 0_s64)).sub(you: y)
    sign = (sign).xor(you: s.sign())
    sign = sign == inv.iseven()
  return UFSign[M, L, W](item0: sign, item1: y)

### Degree-parameterized lgamma core for sub-octuple targets (D64): same octuple-width Stirling
### method as `lgamma_core` (so the octuple `gamma_coef` table stays valid — it is NOT width-portable),
### but with caller-sized Stirling degree `sdeg` (tail terms negligible at the augmented a>=20),
### `log` degree `logn`, and reflection `sin` degree `sinn`. Argument-augmentation target stays 20.
routine UnpackedFloat[M, L, W].lgamma_core_p(sdeg: S64, logn: S64, sinn: S64) -> UFSign[M, L, W]
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var p5 = one.ldexp(e: -1_s64)
  var reflect = me.lt(you: one.neg())
  var a = if reflect then one.sub(you: me) else me
  var inv = a.rint()
  var fr = a.sub(you: inv)
  var w = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var twenty = UnpackedFloat[M, L, W].from_s64(src: 20_s64)
  if inv.lt(you: twenty)
    var ii = inv.to_s64()
    while LLVM::signed_lt(a: ii, b: 20_s64)
      w = w.mul(you: UnpackedFloat[M, L, W].from_s64(src: ii).add(you: fr))
      ii = LLVM::add(a: ii, b: 1_s64)
    a = twenty.add(you: fr)
  var inv_aa = one.div(you: a.mul(you: a))
  var y = UnpackedFloat[M, L, W].gamma_coef(sdeg)
  var i = LLVM::sub(a: sdeg, b: 1_s64)
  while LLVM::signed_ge(a: i, b: 0_s64)
    y = y.fma(b: inv_aa, c: UnpackedFloat[M, L, W].gamma_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  var loga = a.log(n: logn, m: 0_s64, t: 0_s64)
  y = y.div(you: a).add(you: a.sub(you: p5).mul(you: loga)).sub(you: a).add(you: p5.mul(you: UnpackedFloat[M, L, W].ln_2pi()))
  y = y.sub(you: w.abs().log(n: logn, m: 0_s64, t: 0_s64))
  var sign = w.sign()
  if reflect
    var s = UnpackedFloat[M, L, W].pi().mul(you: fr).sin(n: sinn)
    y = UnpackedFloat[M, L, W].ln_pi().sub(you: s.abs().log(n: logn, m: 0_s64, t: 0_s64)).sub(you: y)
    sign = (sign).xor(you: s.sign())
    sign = sign == inv.iseven()
  return UFSign[M, L, W](item0: sign, item1: y)

### Degree-reduced tgamma for sub-octuple targets (D64): octuple width (valid gamma_coef) with
### caller-sized Stirling/log/sin/exp degrees. See `lgamma_core_p`.
routine F128.tgamma_unchecked_p(sdeg: S64, logn: S64, sinn: S64, expn: S64) -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    if me.is_negative()
      return F128.from_bits(bits: f128_qnan())
    return me
  var zu = me.to_oct()
  if me.is_zero()
    var sg = 0_u64
    if me.is_negative()
      sg = 1_u64
    return F128.from_bits(bits: f128_inf(sign: sg))
  if me.is_negative() and zu.isint()
    return F128.from_bits(bits: f128_qnan())
  var p = zu.lgamma_core_p(sdeg: sdeg, logn: logn, sinn: sinn)
  var r = p.item1.exp(n: expn)
  if p.item0
    r = r.neg()
  return r.to_f128()

### Degree-reduced lgamma for sub-octuple targets (D64). See `lgamma_core_p`.
routine F128.lgamma_p(sdeg: S64, logn: S64, sinn: S64) -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if me.is_zero() or me.is_infinite()
    return F128.from_bits(bits: f128_inf(sign: 0_u64))
  if me.is_negative() and me.to_oct().isint()
    return F128.from_bits(bits: f128_inf(sign: 0_u64))
  var p = me.to_oct().lgamma_core_p(sdeg: sdeg, logn: logn, sinn: sinn)
  return p.item1.to_f128()

### Returns the gamma function `tgamma(me)`.
routine F128.tgamma!() -> F128
  var rr = me.tgamma_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `tgamma(me)` with raw IEEE (poles at 0/negative integers -> inf/qNaN). No crash.
### Core path is `exp(lgamma_core)` with the lgamma sign reapplied.
routine F128.tgamma_unchecked() -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    # tgamma(+inf) = +inf; tgamma(-inf) = NaN (C99 F.10.4.4).
    if me.is_negative()
      return F128.from_bits(bits: f128_qnan())
    return me
  var zu = me.to_oct()
  if me.is_zero()
    var sg = 0_u64
    if me.is_negative()
      sg = 1_u64
    return F128.from_bits(bits: f128_inf(sign: sg))
  if me.is_negative() and zu.isint()
    return F128.from_bits(bits: f128_qnan())
  var p = zu.lgamma_core()
  var r = p.item1.exp(n: 20_s64)
  if p.item0
    r = r.neg()
  return r.to_f128()

### Returns the log-gamma function `lgamma(me)` (= ln|gamma(me)|).
routine F128.lgamma() -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if me.is_zero() or me.is_infinite()
    return F128.from_bits(bits: f128_inf(sign: 0_u64))
  if me.is_negative() and me.to_oct().isint()
    return F128.from_bits(bits: f128_inf(sign: 0_u64))
  var p = me.to_oct().lgamma_core()
  return p.item1.to_f128()
