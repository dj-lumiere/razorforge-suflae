  if me.is_zero()
    return F128.from_bits(bits: f128_inf(sign: 1_u64))
  if me.is_negative()
    return F128.from_bits(bits: f128_qnan())
  if me.is_infinite()
    return me
  return me.to_uf().log(n: n, m: 0_s64, t: 0_s64).mul(you: UnpackedFloat[U128, U256, 128].recip_ln2()).to_f128()

