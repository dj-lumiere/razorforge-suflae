### Returns `atan2(me, you)`.
routine F128.atan2(you: F128) -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if you.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: you.to_bits()))
  var y = me.to_uf()
  var x = you.to_uf()
  if me.is_infinite() or you.is_infinite()
    var one = UnpackedFloat[U128, U256, 128].from_s64(src: 1_s64)
    var negone = one.neg()
    var yinf = if me.is_negative() then negone else one
    var yfin = UnpackedFloat[U128, U256, 128].zero(sign: me.is_negative())
    y = if me.is_infinite() then yinf else yfin
    var xinf = if you.is_negative() then negone else one
    var xfin = UnpackedFloat[U128, U256, 128].zero(sign: you.is_negative())
    x = if you.is_infinite() then xinf else xfin
  return y.atan2(x0: x).to_f128()

### Degree/depth-reduced inverse-trig for sub-113-bit targets (D64). atan/asin/acos all funnel
### through atan2; these thread reduced `deg`/`depth` to the F128-width core. Already F128 width
### (not octuple), so the win is purely fewer Horner terms + fewer half-angle sqrt reductions.
routine F128.atan_fast(deg: S64, depth: S64) -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  return me.to_uf().atan_p(deg: deg, depth: depth).to_f128()

routine F128.asin_fast(deg: S64, depth: S64) -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  return me.to_uf().asin_p(deg: deg, depth: depth).to_f128()

routine F128.acos_fast(deg: S64, depth: S64) -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  return me.to_uf().acos_p(deg: deg, depth: depth).to_f128()

routine F128.atan2_fast(you: F128, deg: S64, depth: S64) -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if you.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: you.to_bits()))
  var y = me.to_uf()
  var x = you.to_uf()
  if me.is_infinite() or you.is_infinite()
    var one = UnpackedFloat[U128, U256, 128].from_s64(src: 1_s64)
    var negone = one.neg()
    var yinf = if me.is_negative() then negone else one
    var yfin = UnpackedFloat[U128, U256, 128].zero(sign: me.is_negative())
    y = if me.is_infinite() then yinf else yfin
    var xinf = if you.is_negative() then negone else one
    var xfin = UnpackedFloat[U128, U256, 128].zero(sign: you.is_negative())
    x = if you.is_infinite() then xinf else xfin
  return y.atan2_p(x0: x, deg: deg, depth: depth).to_f128()

