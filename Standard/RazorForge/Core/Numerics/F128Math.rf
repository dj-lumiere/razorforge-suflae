module Core

# ============================================================================
# F128 transcendentals — faithful ports of TLFloat's Quad math. The cores are
# WIDTH-GENERIC member routines on UnpackedFloat[M, L, W]: the same method serves
# the 128-bit quad engine and the 256-bit octuple engine (TLFloat uses octuple
# internally for exp2/exp10/pow/asinh/acosh). Constants/coefficients come from
# F128Const.rf (W-dispatched). Each F128 method casts in via me.to_uf()/to_oct()
# and out via .to_f128().
# ============================================================================

### exp on the unpacked engine (TLFloat exp_, N=20, M=1).
routine UnpackedFloat[M, L, W].exp(n: S64) -> UnpackedFloat[M, L, W]
  # W=512 (octuple-of-octuple) overrides the degree to 36 for 70+ digit accuracy.
  if LLVM::int_eq[U64](a: W, b: 512_u64)
    n = 36_s64
  # |me| > ~2^28 over/underflows: +inf for positive, +0 for negative.
  if LLVM::signed_gt(a: me.exp, b: 28_s64)
    if me.sign()
      return UnpackedFloat[M, L, W].zero(sign: false)
    return UnpackedFloat[M, L, W].inf(sign: false)
  # Range reduction: q = round(me / ln2); reduced d = (me - q*ln2)/2 via two-part
  # ln2 (hi+lo) FMAs so the cancellation stays full-precision, then halved (ldexp -1).
  var q = me.mul(you: UnpackedFloat[M, L, W].recip_ln2()).rint().to_s64()
  var nq = UnpackedFloat[M, L, W].from_s64(src: LLVM::sub(a: 0_s64, b: q))
  var d = nq.fma(b: UnpackedFloat[M, L, W].ln2_hi(), c: me)
  d = nq.fma(b: UnpackedFloat[M, L, W].ln2_lo(), c: d)
  d = d.ldexp(e: -1_s64)
  # Horner evaluation of the exp series (degree n+1 down to 0) in the reduced d.
  var s = UnpackedFloat[M, L, W].exp_coef(LLVM::add(a: n, b: 1_s64))
  var i = n
  while LLVM::signed_ge(a: i, b: 0_s64)
    s = s.fma(b: d, c: UnpackedFloat[M, L, W].exp_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  # Undo the half-angle (exp(d) -> exp(2d) = s^2), then scale by 2^q (ldexp q).
  s = s.mul(you: s)
  return s.ldexp(e: q)

### expm1 on the unpacked engine (TLFloat expm1_, degree n, M=1).
routine UnpackedFloat[M, L, W].expm1(n: S64) -> UnpackedFloat[M, L, W]
  # W=512 overrides the degree to 36 for 70+ digit accuracy.
  if LLVM::int_eq[U64](a: W, b: 512_u64)
    n = 36_s64
  if me.iszero()
    return me
  # |me| > ~2^28: -1 for large-negative (e^x -> 0), +inf for large-positive.
  if LLVM::signed_gt(a: me.exp, b: 28_s64)
    if me.sign()
      return UnpackedFloat[M, L, W].from_s64(src: -1_s64)
    return UnpackedFloat[M, L, W].inf(sign: false)
  # Same q = round(me/ln2) + two-part-ln2 reduction + half-angle as exp.
  var q = me.mul(you: UnpackedFloat[M, L, W].recip_ln2()).rint().to_s64()
  var nq = UnpackedFloat[M, L, W].from_s64(src: LLVM::sub(a: 0_s64, b: q))
  var d = nq.fma(b: UnpackedFloat[M, L, W].ln2_hi(), c: me)
  d = nq.fma(b: UnpackedFloat[M, L, W].ln2_lo(), c: d)
  d = d.ldexp(e: -1_s64)
  # Horner series down to coef 1 (the constant term is handled by the expm1 form below).
  var s = UnpackedFloat[M, L, W].exp_coef(LLVM::add(a: n, b: 1_s64))
  var i = n
  while LLVM::signed_ge(a: i, b: 1_s64)
    s = s.fma(b: d, c: UnpackedFloat[M, L, W].exp_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  # Reconstruct expm1(2d) = s^2 + 2s from the half-angle s = expm1(d)/... (avoids 1-1
  # cancellation that a plain exp(x)-1 would suffer for small x).
  s = s.mul(you: d)
  s = s.fma(b: s, c: s.ldexp(e: 1_s64))
  # Scale by 2^q and add the (2^q - 1) correction so the result is expm1, not exp-1.
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  return s.ldexp(e: q).add(you: one.ldexp(e: q).sub(you: one))

### log on the unpacked engine (TLFloat log_, degree n, m sqrt-reductions, threshold t).
routine UnpackedFloat[M, L, W].log(n: S64, m: S64, t: S64) -> UnpackedFloat[M, L, W]
  # W=512 overrides degree/reductions/threshold for 70+ digits (t very negative = always reduce).
  if LLVM::int_eq[U64](a: W, b: 512_u64)
    n = 33_s64
    m = 2_s64
    t = -1000000_s64
  # frexp splits me = fr * 2^e with fr in [0.5,1); recentre to [sqrt(1/2), sqrt(2))
  # so the atanh argument x stays small and symmetric.
  var p = me.frexp()
  var fr = p.item0
  var e = p.item1
  if fr.lt(you: UnpackedFloat[M, L, W].sqrt_half())
    fr = fr.ldexp(e: 1_s64)
    e = LLVM::sub(a: e, b: 1_s64)
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  # When fr is not already near 1, take m square roots: log(fr) = 2^m * log(fr^(1/2^m)),
  # shrinking |x| so the fixed-degree polynomial reaches the target precision.
  var mm = 0_s64
  if LLVM::signed_gt[S64](a: m, b: 0_s64) and LLVM::signed_gt[S64](a: fr.sub(you: one).abs().ilogb(), b: t)
    var k = 0_s64
    while LLVM::signed_lt(a: k, b: m)
      fr = fr.sqrt()
      k = LLVM::add(a: k, b: 1_s64)
    mm = m
  # atanh series: log(fr) = 2*atanh(x) with x = (fr-1)/(fr+1); evaluate in x^2 by Horner.
  var x = fr.sub(you: one).div(you: fr.add(you: one))
  var xx = x.mul(you: x)
  var y = UnpackedFloat[M, L, W].log_coef(LLVM::add(a: n, b: 1_s64))
  var i = n
  while LLVM::signed_ge(a: i, b: 0_s64)
    y = y.fma(b: xx, c: UnpackedFloat[M, L, W].log_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  y = y.mul(you: x)
  # Reassemble: undo the m reductions (ldexp mm), then add e*ln2 via two-part ln2 FMAs.
  var ef = UnpackedFloat[M, L, W].from_s64(src: e)
  y = ef.fma(b: UnpackedFloat[M, L, W].ln2_lo(), c: y.ldexp(e: mm))
  return ef.fma(b: UnpackedFloat[M, L, W].ln2_hi(), c: y)

### log1p on the unpacked engine (TLFloat log1p_, degree n, m sqrt-reductions).
routine UnpackedFloat[M, L, W].log1p(n: S64, m: S64) -> UnpackedFloat[M, L, W]
  if LLVM::int_eq[U64](a: W, b: 512_u64)
    n = 33_s64
    # m=2 (one fewer sqrt+div reduction than the old m=3): the Taylor-conservative
    # truncation is still 2^-324 (~97 digits) >> D256's 70 — verified in gen probes.
    # log1p is a shared primitive (atanh/asinh route through it), so this trims the
    # whole inverse-hyperbolic cluster, not just log1p.
    m = 2_s64
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  # frexp(1+me) gives the exponent e; for e==0 keep the original me to avoid losing
  # precision in (1+me)-1 when me is tiny, else use fr-1 recentred to [sqrt(1/2), sqrt(2)).
  var p = me.add(you: one).frexp()
  var fr = p.item0
  var e = p.item1
  if fr.lt(you: UnpackedFloat[M, L, W].sqrt_half())
    fr = fr.ldexp(e: 1_s64)
    e = LLVM::sub(a: e, b: 1_s64)
  fr = if e == 0_s64 then me else fr.sub(you: one)
  # m reduction steps fr <- fr/(sqrt(1+fr)+1) (half-argument for log1p); each halves
  # the magnitude, reconstructed by ldexp m below.
  var k = 0_s64
  while LLVM::signed_lt(a: k, b: m)
    fr = fr.div(you: fr.add(you: one).sqrt().add(you: one))
    k = LLVM::add(a: k, b: 1_s64)
  # atanh series in x = fr/(fr+2): log1p(fr) = 2*atanh(x); Horner in x^2.
  var two = UnpackedFloat[M, L, W].from_s64(src: 2_s64)
  var x = fr.div(you: fr.add(you: two))
  var xx = x.mul(you: x)
  var y = UnpackedFloat[M, L, W].log_coef(LLVM::add(a: n, b: 1_s64))
  var i = n
  while LLVM::signed_ge(a: i, b: 0_s64)
    y = y.fma(b: xx, c: UnpackedFloat[M, L, W].log_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  y = y.mul(you: x)
  # Undo the m reductions (ldexp m) and add e*ln2 (two-part ln2 FMAs).
  var ef = UnpackedFloat[M, L, W].from_s64(src: e)
  y = ef.fma(b: UnpackedFloat[M, L, W].ln2_lo(), c: y.ldexp(e: m))
  return ef.fma(b: UnpackedFloat[M, L, W].ln2_hi(), c: y)

### cbrt on the unpacked engine (TLFloat cbrt_, N=4, M=3).
routine UnpackedFloat[M, L, W].cbrt() -> UnpackedFloat[M, L, W]
  var one_third = UnpackedFloat[M, L, W].one_third()
  # Split off a power of 2: scale me down by 2^e so the mantissa d is near 1.
  var e = LLVM::add(a: me.mul(you: one_third).ilogb(), b: 2_s64)
  var d = me.ldexp(e: LLVM::sub(a: 0_s64, b: e))
  # Decompose e = 3*(e//3) + r with a large bias (3145728/1048576) to keep e//3 exact;
  # the residue r in {0,1,2} picks the cube-root-of-2^r factor q reapplied at the end.
  var eo3 = LLVM::add(a: e, b: 3145728_s64)
  var r = LLVM::signed_rem(a: eo3, b: 3_s64)
  var q = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if r == 1_s64
    q = UnpackedFloat[M, L, W].cbrt_2()
  if r == 2_s64
    q = UnpackedFloat[M, L, W].cbrt_4()
  q = q.ldexp(e: LLVM::sub(a: LLVM::signed_div(a: eo3, b: 3_s64), b: 1048576_s64))
  if d.sign()
    q = q.neg()
  d = d.abs()
  # Polynomial seed of d^(1/3) about d=1 (Horner in d-1), then refine.
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var dm1 = d.sub(you: one)
  var x = UnpackedFloat[M, L, W].cbrt_coef(5_s64)
  var i = 4_s64
  while LLVM::signed_ge(a: i, b: 0_s64)
    x = x.fma(b: dm1, c: UnpackedFloat[M, L, W].cbrt_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  # 3 Halley/Newton-style iterations: x <- x - (1/3)*x*(x^4*d - 1) drives x to d^(-2/3).
  var j = 0_s64
  while LLVM::signed_lt(a: j, b: 3_s64)
    var yy = x.mul(you: x)
    yy = yy.mul(you: yy)
    x = d.fma(b: yy, c: x.neg()).fma(b: one_third.neg(), c: x)
    j = LLVM::add(a: j, b: 1_s64)
  # Final correction: form d*x^2 ~ d^(1/3) and apply one Newton step, then scale by q.
  var y2 = x.mul(you: x).mul(you: d)
  var t = y2.fma(b: x, c: UnpackedFloat[M, L, W].from_s64(src: -1_s64))
  var cc = one_third.ldexp(e: 1_s64).neg().mul(you: y2)
  return t.fma(b: cc, c: y2).mul(you: q)

### atan2 on the unpacked engine (TLFloat atan2_, N=17, M=3). Picks degree/depth by width.
routine UnpackedFloat[M, L, W].atan2(x0: UnpackedFloat[M, L, W]) -> UnpackedFloat[M, L, W]
  # W=512 needs deeper half-angle reduction + higher poly degree for 70+ digits.
  var deg = 17_s64
  var depth = 3_s64
  if LLVM::int_eq[U64](a: W, b: 512_u64)
    deg = 22_s64
    depth = 5_s64
  return me.atan2_p(x0: x0, deg: deg, depth: depth)

### Degree/depth-parameterized atan2. `deg` = atan-series Horner degree, `depth` = half-angle
### reductions; callers below F128's 113 bits (D64) size both down to their target. atan_coef is
### W-dispatched (a valid quad table at W=128), so reducing `deg` just uses fewer correct terms.
routine UnpackedFloat[M, L, W].atan2_p(x0: UnpackedFloat[M, L, W], deg: S64, depth: S64) -> UnpackedFloat[M, L, W]
  var y = me
  var x = x0
  # Octant folding into |y| <= |x|: q records the quadrant offset (in units of pi/2)
  # so the result can be reconstructed as q*(pi/2) + atan(d).
  var q = 0_s64
  if y.abs().gt(you: x.abs())
    var tmp = x
    x = y
    y = tmp.neg()
    q = if x.sign() then -1_s64 else 1_s64
  elseif x.sign()
    q = if y.sign() then -2_s64 else 2_s64
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var d = y.div(you: x)
  var r = UnpackedFloat[M, L, W].atan_coef(deg)
  # `depth` half-angle reductions d <- d/(sqrt(1+d^2)+1) shrink |d| so the fixed-degree
  # poly converges; the matching ldexp(depth) below undoes them.
  var j = 0_s64
  while LLVM::signed_lt(a: j, b: depth)
    d = d.div(you: d.fma(b: d, c: one).sqrt().add(you: one))
    j = LLVM::add(a: j, b: 1_s64)
  # Horner evaluation of the atan series in d^2, then multiply by d.
  var i = LLVM::sub(a: deg, b: 1_s64)
  while LLVM::signed_ge(a: i, b: 0_s64)
    r = r.fma(b: d.mul(you: d), c: UnpackedFloat[M, L, W].atan_coef(i))
    i = LLVM::sub(a: i, b: 1_s64)
  r = r.mul(you: d)
  var qu = UnpackedFloat[M, L, W].from_s64(src: q)
  if q == 0_s64
    qu = UnpackedFloat[M, L, W].zero(sign: r.sign())
  if x.iszero()
    r = UnpackedFloat[M, L, W].zero(sign: y.sign())
    var qa = qu.abs()
    qu = if y.sign() then qa.neg() else qa
  # Reconstruct: q*(pi/2) + 2^depth * atan(reduced d).
  return qu.fma(b: UnpackedFloat[M, L, W].pi().ldexp(e: -1_s64), c: r.ldexp(e: depth))

### atan on the unpacked engine.
routine UnpackedFloat[M, L, W].atan() -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var negone = one.neg()
  var yinf = if me.sign() then negone else one
  var y = if me.isinf() then yinf else me
  var zero = UnpackedFloat[M, L, W].zero(sign: false)
  var x = if me.isinf() then zero else one
  return y.atan2(x0: x)

### asin on the unpacked engine.
routine UnpackedFloat[M, L, W].asin() -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if me.abs().gt(you: one)
    return UnpackedFloat[M, L, W].nan()
  # asin(x) = atan2(x, sqrt((1+x)(1-x))) = atan2(x, sqrt(1-x^2)).
  var x = one.add(you: me).mul(you: one.sub(you: me)).sqrt()
  return me.atan2(x0: x)

### acos on the unpacked engine.
routine UnpackedFloat[M, L, W].acos() -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if me.abs().gt(you: one)
    return UnpackedFloat[M, L, W].nan()
  # acos(x) = atan2(sqrt(1-x^2), x).
  var y = one.add(you: me).mul(you: one.sub(you: me)).sqrt()
  return y.atan2(x0: me)

### Degree/depth-parameterized atan/asin/acos cores for sub-113-bit targets (D64). Same methods
### as atan/asin/acos but thread `deg`/`depth` to atan2_p.
routine UnpackedFloat[M, L, W].atan_p(deg: S64, depth: S64) -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var negone = one.neg()
  var yinf = if me.sign() then negone else one
  var y = if me.isinf() then yinf else me
  var zero = UnpackedFloat[M, L, W].zero(sign: false)
  var x = if me.isinf() then zero else one
  return y.atan2_p(x0: x, deg: deg, depth: depth)

routine UnpackedFloat[M, L, W].asin_p(deg: S64, depth: S64) -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if me.abs().gt(you: one)
    return UnpackedFloat[M, L, W].nan()
  var x = one.add(you: me).mul(you: one.sub(you: me)).sqrt()
  return me.atan2_p(x0: x, deg: deg, depth: depth)

routine UnpackedFloat[M, L, W].acos_p(deg: S64, depth: S64) -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if me.abs().gt(you: one)
    return UnpackedFloat[M, L, W].nan()
  var y = one.add(you: me).mul(you: one.sub(you: me)).sqrt()
  return y.atan2_p(x0: me, deg: deg, depth: depth)

### sinh on the unpacked engine (expm1_), with explicit expm1 term count `en`.
### The inner expm1 range-reduces uniformly (reduced |d| <= ln2/2), so a lower `en`
### suffices for narrower targets (e.g. D64 at 54 bits) for any input.
routine UnpackedFloat[M, L, W].sinh_n(en: S64) -> UnpackedFloat[M, L, W]
  if me.isnan() or me.isinf()
    return me
  if me.abs().gt(you: UnpackedFloat[M, L, W].from_s64(src: 1048576_s64))
    return UnpackedFloat[M, L, W].inf(sign: me.sign())
  # sinh via expm1 to avoid cancellation near 0: let t = expm1(|x|), then
  # sinh = (t*(t+2)/(t+1))/2; sign reapplied (sinh is odd).
  var d = me.abs().expm1(n: en)
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var two = UnpackedFloat[M, L, W].from_s64(src: 2_s64)
  d = d.mul(you: d.add(you: two)).div(you: d.add(you: one)).ldexp(e: -1_s64)
  if me.sign()
    d = d.neg()
  return d

### sinh on the unpacked engine (expm1_ N=20) at the full F128/F256 term count.
routine UnpackedFloat[M, L, W].sinh() -> UnpackedFloat[M, L, W]
  return me.sinh_n(en: 20_s64)

### cosh on the unpacked engine (exp_), with explicit exp term count `en`.
### The inner exp range-reduces uniformly, so a lower `en` suffices for narrower targets.
routine UnpackedFloat[M, L, W].cosh_n(en: S64) -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  if me.isinf()
    return UnpackedFloat[M, L, W].inf(sign: false)
  if me.iszero()
    return UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if me.abs().gt(you: UnpackedFloat[M, L, W].from_s64(src: 1048576_s64))
    return UnpackedFloat[M, L, W].inf(sign: false)
  # cosh(x) = (e^|x| + e^-|x|)/2.
  var d = me.abs().exp(n: en)
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  return d.add(you: one.div(you: d)).ldexp(e: -1_s64)

### cosh on the unpacked engine (exp_ N=20) at the full F128/F256 term count.
routine UnpackedFloat[M, L, W].cosh() -> UnpackedFloat[M, L, W]
  return me.cosh_n(en: 20_s64)

### tanh on the unpacked engine (expm1_), with explicit expm1 term count `en`.
### The inner expm1 range-reduces uniformly, so a lower `en` suffices for narrower targets.
routine UnpackedFloat[M, L, W].tanh_n(en: S64) -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  var y = me.abs()
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if y.isinf() or y.gt(you: UnpackedFloat[M, L, W].from_s64(src: 1048576_s64))
    var res = one
    if me.sign()
      res = one.neg()
    return res
  # tanh via expm1(2|x|): t = expm1(2|x|), tanh = t/(t+2); sign reapplied (tanh is odd).
  var d = y.ldexp(e: 1_s64).expm1(n: en)
  d = d.div(you: d.add(you: UnpackedFloat[M, L, W].from_s64(src: 2_s64)))
  if me.sign()
    d = d.neg()
  return d

### tanh on the unpacked engine (expm1_ N=20) at the full F128/F256 term count.
routine UnpackedFloat[M, L, W].tanh() -> UnpackedFloat[M, L, W]
  return me.tanh_n(en: 20_s64)

### atanh on the unpacked engine (log1p_, M=0), with explicit log1p term count `ln`.
### The inner log1p recentres uniformly (series |x| <= ~0.1716), so a lower `ln` suffices
### for narrower targets (e.g. D64 at 54 bits) for any input in (-1, 1).
routine UnpackedFloat[M, L, W].atanh_n(ln: S64) -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  if me.isinf()
    return UnpackedFloat[M, L, W].nan()
  var y = me.abs()
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if y.gt(you: one)
    return UnpackedFloat[M, L, W].nan()
  if y.eq(you: one)
    return UnpackedFloat[M, L, W].inf(sign: me.sign())
  # atanh(x) = (1/2)*log1p(2y/(1-y)) with y=|x|; m=0 (the small frexp range needs no
  # reduction sqrt); sign reapplied (atanh is odd).
  var d = y.ldexp(e: 1_s64).div(you: one.sub(you: y)).log1p(n: ln, m: 0_s64).ldexp(e: -1_s64)
  if me.sign()
    d = d.neg()
  return d

### atanh on the unpacked engine (log1p_ N=21, M=0) at the full F128/F256 term count.
routine UnpackedFloat[M, L, W].atanh() -> UnpackedFloat[M, L, W]
  return me.atanh_n(ln: 21_s64)

### asinh on the unpacked engine (log_/log1p_ N=24, M=0 — no reduction sqrt).
routine UnpackedFloat[M, L, W].asinh() -> UnpackedFloat[M, L, W]
  var y = me.abs()
  if me.isnan() or y.isinf()
    return me
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  var ygt1 = y.gt(you: one)
  var d = if ygt1 then one.div(you: y) else y
  d = d.fma(b: d, c: one).sqrt()
  # Pick ONE transcendental (lazy conditional): |x|>1 -> log, else log1p. The old
  # form always evaluated log1p then overwrote it with log for |x|>1 (double work).
  # m=0 (no half-argument sqrt-reduction): the frexp range bounds |x|<=0.1716, so
  # n=24 gives ~2^-130 (> F128's 113-bit / D128's 34-digit target) with NO reduction
  # sqrt. The old m=1 paid a SECOND F256 sqrt (~1126 ns) on top of the inherent
  # sqrt(x^2+1) for precision nothing downstream uses. atanh already runs m=0 here.
  var res = if ygt1 then d.fma(b: y, c: y).log(n: 24_s64, m: 0_s64, t: -10_s64) else d.sub(you: one).add(you: y).log1p(n: 24_s64, m: 0_s64)
  if me.sign()
    res = res.neg()
  return res

### acosh on the unpacked engine (log_ N=24, M=0 — no reduction sqrt).
routine UnpackedFloat[M, L, W].acosh() -> UnpackedFloat[M, L, W]
  if me.isnan()
    return me
  var one = UnpackedFloat[M, L, W].from_s64(src: 1_s64)
  if me.lt(you: one)
    return UnpackedFloat[M, L, W].nan()
  if me.isinf()
    return UnpackedFloat[M, L, W].inf(sign: false)
  var s = me.add(you: one).mul(you: me.sub(you: one)).sqrt().add(you: me)
  # m=0: drop the second (reduction) sqrt; n=24 (~2^-130) covers the F128/D128 target.
  return s.log(n: 24_s64, m: 0_s64, t: -10_s64)

# ============================================================================
# F128 method wrappers
# ============================================================================

### Returns `e^me`.
routine F128.exp!() -> F128
  var rr = me.exp_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `e^me` with raw IEEE propagation (NaN -> qNaN, +inf -> +inf, -inf -> +0). No crash.
routine F128.exp_unchecked() -> F128
  return me.exp_unchecked_n(n: 20_s64)

### `e^me` raw IEEE, with the exp-series explicit atanh/exp-series term count `n`.
routine F128.exp_unchecked_n(n: S64) -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    if me.is_negative()
      return F128.from_bits(bits: 0_u128)
    return me
  return me.to_uf().exp(n: n).to_f128()

### Returns `ln(me)`.
routine F128.log!() -> F128
  var rr = me.log_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `ln(me)` with raw IEEE (NaN/0 -> -inf, x<0 -> qNaN, +inf -> +inf). No crash.
routine F128.log_unchecked() -> F128
  return me.log_unchecked_n(n: 21_s64)

### `ln(me)` raw IEEE, with the atanh-series term count sized to a TARGET precision (bits) rather
### than the full 128-bit width — the operation owns its iteration count, keyed on what the caller
### actually needs. After the [sqrt(1/2), sqrt(2)) reduction |x| <= ~0.172, so the series yields
### ~6 bits per term; n = (prec + guard) / 6. Lower-precision callers (e.g. D64 at 54 bits) get a
### proportionally cheaper log. PROTOTYPE for precision-targeted iteration counts.
routine F128.log_unchecked_n(n: S64) -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if me.is_zero()
    return F128.from_bits(bits: f128_inf(sign: 1_u64))
  if me.is_negative()
    return F128.from_bits(bits: f128_qnan())
  if me.is_infinite()
    return me
  return me.to_uf().log(n: n, m: 0_s64, t: 0_s64).to_f128()

### Returns `e^me - 1`.
routine F128.expm1!() -> F128
  var rr = me.expm1_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `e^me - 1` with raw IEEE (NaN -> qNaN, -inf -> -1, +inf -> +inf). No crash.
routine F128.expm1_unchecked() -> F128
  return me.expm1_unchecked_n(n: 21_s64)

### `e^me - 1` raw IEEE, explicit atanh/exp-series term count `n`.
routine F128.expm1_unchecked_n(n: S64) -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if me.is_infinite()
    if me.is_negative()
      return UnpackedFloat[U128, U256, 128].from_s64(src: -1_s64).to_f128()
    return me
  return me.to_uf().expm1(n: n).to_f128()

### Returns `ln(1 + me)`.
routine F128.log1p!() -> F128
  var rr = me.log1p_unchecked()
  if rr.is_finite()
    return rr
  if rr.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `ln(1+me)` with raw IEEE (NaN -> qNaN, me=-1 -> -inf, me<-1 -> qNaN, +inf -> +inf). No crash.
routine F128.log1p_unchecked() -> F128
  return me.log1p_unchecked_n(n: 21_s64)

### `ln(1+me)` raw IEEE, explicit atanh/exp-series term count `n`.
routine F128.log1p_unchecked_n(n: S64) -> F128
  if me.is_nan()
    return F128.from_bits(bits: f128_quiet(bits: me.to_bits()))
  if me.is_zero()
    return me
  var negone = UnpackedFloat[U128, U256, 128].from_s64(src: -1_s64).to_f128()
  if me == negone
    return F128.from_bits(bits: f128_inf(sign: 1_u64))
  if me < negone
    return F128.from_bits(bits: f128_qnan())
  if me.is_infinite()
    return me
  return me.to_uf().log1p(n: n, m: 0_s64).to_f128()

