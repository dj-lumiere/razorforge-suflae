module Core

# ============================================================================
# Limb kernels — unsigned fixed-width integer arithmetic on `Array[U64, K]` (little-endian: limb 0 is
# the least significant). The soft-float engine (`UnpackedFloat[N, N2]`) keeps its mantissa and its
# double-width intermediate as limb arrays, so no per-width integer type (U192/U384/...) is needed:
# one set of kernels serves every width, and K is a build-time constant per instantiation (the loops
# unroll at -O2).
#
# All arithmetic wraps modulo 2^(64K). Shift amounts at or beyond the width give zero; a bit position
# outside [0, 64K) reads as 0. Operations on a value are members (`x.wide_add(you: y)`); builders and
# width conversions are free routines taking the limb count(s) explicitly (`wide_from_u64[N](v: 1)`,
# `wide_resize[N, N2](a: x)`).
#
# Performance shape (these run in the inner loop of every soft-float operation, including at -O0 in
# the dev loop and the test suite):
#   * limbs are read/written in place through a `Hijacked` pointer (`LLVM::load_element_ref` /
#     `store_element_ref`), not the bounds-checked `getitem!`/`setitem!` calls — every index is a loop
#     counter already inside [0, K);
#   * loop counters use raw `LLVM::` integer ops, not the checked `S64` operators (each of which is a
#     routine call at -O0);
#   * every kernel is `@inline` (LLVM `alwaysinline`, honored at -O0 too).
# ============================================================================

# ----------------------------------------------------------------------------
# Builders
# ----------------------------------------------------------------------------

### A limb array holding `v` (zero-extended).
@inline
routine wide_from_u64[K](v: U64) -> Array[U64, K]
needs U64 K
  var r = Array[U64, K]()
  danger
    LLVM::store_element_ref[Array[U64, K], U64](r.hijack(), 0_u64, v)
  return r

### A limb array holding `h1 * 2^64 + h0` (only `h0` when K = 1).
@inline
routine wide_words2[K](h1: U64, h0: U64) -> Array[U64, K]
needs U64 K
  var r = Array[U64, K]()
  danger
    var rp = r.hijack()
    LLVM::store_element_ref[Array[U64, K], U64](rp, 0_u64, h0)
    if LLVM::unsigned_gt(a: K, b: 1_u64)
      LLVM::store_element_ref[Array[U64, K], U64](rp, 1_u64, h1)
  return r

### A limb array holding `h2 * 2^128 + h1 * 2^64 + h0` (upper words dropped when K is smaller).
@inline
routine wide_words3[K](h2: U64, h1: U64, h0: U64) -> Array[U64, K]
needs U64 K
  var r = wide_words2[K](h1: h1, h0: h0)
  danger
    if LLVM::unsigned_gt(a: K, b: 2_u64)
      LLVM::store_element_ref[Array[U64, K], U64](r.hijack(), 2_u64, h2)
  return r

### A limb array holding `v` (zero-extended; truncated when K = 1).
@inline
routine wide_from_u128[K](v: U128) -> Array[U64, K]
needs U64 K
  var hi = LLVM::int_truncate[U128, U64](LLVM::shift_right_unsigned(v, 64_u128))
  var lo = LLVM::int_truncate[U128, U64](v)
  return wide_words2[K](h1: hi, h0: lo)

### The mask `2^n - 1` (n <= 0 gives 0, n >= 64K gives all ones).
@inline
routine wide_low_mask[K](n: S64) -> Array[U64, K]
needs U64 K
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  var r = Array[U64, K]()
  danger
    var rp = r.hijack()
    var i = 0_s64
    var take = n
    while LLVM::signed_lt(a: i, b: kl)
      var ui = LLVM::reinterpret_bits[S64, U64](i)
      if LLVM::signed_ge(a: take, b: 64_s64)
        LLVM::store_element_ref[Array[U64, K], U64](rp, ui, U64_MAX)
      elseif LLVM::signed_gt(a: take, b: 0_s64)
        var part = LLVM::sub(a: LLVM::shift_left(value: 1_u64, bits: LLVM::reinterpret_bits[S64, U64](take)), b: 1_u64)
        LLVM::store_element_ref[Array[U64, K], U64](rp, ui, part)
      take = LLVM::sub(a: take, b: 64_s64)
      i = LLVM::add(a: i, b: 1_s64)
  return r

### The single bit `2^pos` (zero when pos is outside [0, 64K)).
@inline
routine wide_bit_at[K](pos: S64) -> Array[U64, K]
needs U64 K
  var r = Array[U64, K]()
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  if LLVM::signed_lt(a: pos, b: 0_s64) or LLVM::signed_ge(a: pos, b: LLVM::mul(a: kl, b: 64_s64))
    return r
  var wi = LLVM::shift_right_signed(pos, 6_s64)
  var one = LLVM::shift_left(value: 1_u64, bits: LLVM::reinterpret_bits[S64, U64](LLVM::bit_and(a: pos, b: 63_s64)))
  danger
    # Every limb is written at its own loop index (a select per limb once unrolled), never at the
    # runtime index `wi`. A runtime index pins the array in memory instead of registers.
    var rp = r.hijack()
    var i = 0_s64
    while LLVM::signed_lt(a: i, b: kl)
      var w = 0_u64
      if LLVM::int_eq(a: i, b: wi)
        w = one
      LLVM::store_element_ref[Array[U64, K], U64](rp, LLVM::reinterpret_bits[S64, U64](i), w)
      i = LLVM::add(a: i, b: 1_s64)
  return r

### Copies `a` into K2 limbs: zero-extends when K2 > K, keeps the low K2 limbs when K2 < K.
@inline
routine wide_resize[K, K2](a: Array[U64, K]) -> Array[U64, K2]
needs U64 K, U64 K2
  var n = LLVM::reinterpret_bits[U64, S64](K)
  var k2 = LLVM::reinterpret_bits[U64, S64](K2)
  if LLVM::signed_lt(a: k2, b: n)
    n = k2
  var src = a
  var r = Array[U64, K2]()
  danger
    var sp = src.hijack()
    var rp = r.hijack()
    var i = 0_s64
    while LLVM::signed_lt(a: i, b: n)
      var ui = LLVM::reinterpret_bits[S64, U64](i)
      LLVM::store_element_ref[Array[U64, K2], U64](rp, ui, LLVM::load_element_ref[Array[U64, K], U64](sp, ui))
      i = LLVM::add(a: i, b: 1_s64)
  return r

### The product `a * b`, kept to its low K2 limbs (K2 = 2K is the exact full product).
@inline
routine wide_mul_to[K, K2](a: Array[U64, K], b: Array[U64, K]) -> Array[U64, K2]
needs U64 K, U64 K2
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  var k2 = LLVM::reinterpret_bits[U64, S64](K2)
  var x = a
  var y = b
  var r = Array[U64, K2]()
  danger
    var xp = x.hijack()
    var yp = y.hijack()
    var rp = r.hijack()
    var i = 0_s64
    while LLVM::signed_lt(a: i, b: kl) and LLVM::signed_lt(a: i, b: k2)
      var carry = 0_u64
      var xi = LLVM::zero_extend[U64, U128](LLVM::load_element_ref[Array[U64, K], U64](xp, LLVM::reinterpret_bits[S64, U64](i)))
      var j = 0_s64
      var t = i
      while LLVM::signed_lt(a: j, b: kl) and LLVM::signed_lt(a: t, b: k2)
        var ut = LLVM::reinterpret_bits[S64, U64](t)
        var yj = LLVM::load_element_ref[Array[U64, K], U64](yp, LLVM::reinterpret_bits[S64, U64](j))
        var rt = LLVM::load_element_ref[Array[U64, K2], U64](rp, ut)
        var p = LLVM::mul(a: xi, b: LLVM::zero_extend[U64, U128](yj))
        p = LLVM::add(a: p, b: LLVM::zero_extend[U64, U128](rt))
        p = LLVM::add(a: p, b: LLVM::zero_extend[U64, U128](carry))
        LLVM::store_element_ref[Array[U64, K2], U64](rp, ut, LLVM::int_truncate[U128, U64](p))
        carry = LLVM::int_truncate[U128, U64](LLVM::shift_right_unsigned(p, 64_u128))
        j = LLVM::add(a: j, b: 1_s64)
        t = LLVM::add(a: t, b: 1_s64)
      var top = LLVM::add(a: i, b: kl)
      if LLVM::signed_lt(a: top, b: k2)
        LLVM::store_element_ref[Array[U64, K2], U64](rp, LLVM::reinterpret_bits[S64, U64](top), carry)
      i = LLVM::add(a: i, b: 1_s64)
  return r

# ----------------------------------------------------------------------------
# Tests and comparisons
# ----------------------------------------------------------------------------

### Whether every limb is zero.
@inline
routine Array[U64, K].wide_is_zero() -> Bool
needs U64 K
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  var a = me
  var acc = 0_u64
  danger
    var ap = a.hijack()
    var i = 0_s64
    while LLVM::signed_lt(a: i, b: kl)
      acc = LLVM::bit_or(a: acc, b: LLVM::load_element_ref[Array[U64, K], U64](ap, LLVM::reinterpret_bits[S64, U64](i)))
      i = LLVM::add(a: i, b: 1_s64)
  return LLVM::int_eq(a: acc, b: 0_u64)

### Unsigned three-way comparison: -1, 0 or +1.
@inline
routine Array[U64, K].wide_cmp(you: Array[U64, K]) -> S64
needs U64 K
  var a = me
  var b = you
  danger
    var ap = a.hijack()
    var bp = b.hijack()
    var i = LLVM::sub(a: LLVM::reinterpret_bits[U64, S64](K), b: 1_s64)
    while LLVM::signed_ge(a: i, b: 0_s64)
      var ui = LLVM::reinterpret_bits[S64, U64](i)
      var x = LLVM::load_element_ref[Array[U64, K], U64](ap, ui)
      var y = LLVM::load_element_ref[Array[U64, K], U64](bp, ui)
      if LLVM::unsigned_lt(a: x, b: y)
        return -1_s64
      if LLVM::unsigned_gt(a: x, b: y)
        return 1_s64
      i = LLVM::sub(a: i, b: 1_s64)
  return 0_s64

### Whether `me == you`.
@inline
routine Array[U64, K].wide_eq(you: Array[U64, K]) -> Bool
needs U64 K
  return LLVM::int_eq(a: me.wide_cmp(you: you), b: 0_s64)

### Whether `me < you` (unsigned).
@inline
routine Array[U64, K].wide_lt(you: Array[U64, K]) -> Bool
needs U64 K
  return LLVM::signed_lt(a: me.wide_cmp(you: you), b: 0_s64)

### Whether `me > you` (unsigned).
@inline
routine Array[U64, K].wide_gt(you: Array[U64, K]) -> Bool
needs U64 K
  return LLVM::signed_gt(a: me.wide_cmp(you: you), b: 0_s64)

### Whether `me >= you` (unsigned).
@inline
routine Array[U64, K].wide_ge(you: Array[U64, K]) -> Bool
needs U64 K
  return LLVM::signed_ge(a: me.wide_cmp(you: you), b: 0_s64)

### Whether `me <= you` (unsigned).
@inline
routine Array[U64, K].wide_le(you: Array[U64, K]) -> Bool
needs U64 K
  return LLVM::signed_le(a: me.wide_cmp(you: you), b: 0_s64)

### Bit `pos` (false outside [0, 64K)).
@inline
routine Array[U64, K].wide_bit(pos: S64) -> Bool
needs U64 K
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  if LLVM::signed_lt(a: pos, b: 0_s64) or LLVM::signed_ge(a: pos, b: LLVM::mul(a: kl, b: 64_s64))
    return false
  var a = me
  var wi = LLVM::shift_right_signed(pos, 6_s64)
  var w = 0_u64
  danger
    # Select the limb by comparing every loop index against `wi` rather than loading at `wi`, so
    # the limbs stay in registers after unrolling.
    var ap = a.hijack()
    var i = 0_s64
    while LLVM::signed_lt(a: i, b: kl)
      var x = LLVM::load_element_ref[Array[U64, K], U64](ap, LLVM::reinterpret_bits[S64, U64](i))
      if LLVM::int_eq(a: i, b: wi)
        w = x
      i = LLVM::add(a: i, b: 1_s64)
  var sh = LLVM::reinterpret_bits[S64, U64](LLVM::bit_and(a: pos, b: 63_s64))
  return LLVM::int_ne(a: LLVM::bit_and(a: LLVM::shift_right_unsigned(w, sh), b: 1_u64), b: 0_u64)

### Whether any of the low `n` bits is set.
@inline
routine Array[U64, K].wide_low_nonzero(n: S64) -> Bool
needs U64 K
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  var a = me
  var acc = 0_u64
  danger
    var ap = a.hijack()
    var i = 0_s64
    var take = n
    # Fixed trip count (no early exit on `take`), so the loop unrolls and the limbs stay in registers.
    while LLVM::signed_lt(a: i, b: kl)
      var w = LLVM::load_element_ref[Array[U64, K], U64](ap, LLVM::reinterpret_bits[S64, U64](i))
      if LLVM::signed_le(a: take, b: 0_s64)
        w = 0_u64
      elseif LLVM::signed_lt(a: take, b: 64_s64)
        w = LLVM::bit_and(a: w, b: LLVM::sub(a: LLVM::shift_left(value: 1_u64, bits: LLVM::reinterpret_bits[S64, U64](take)), b: 1_u64))
      acc = LLVM::bit_or(a: acc, b: w)
      take = LLVM::sub(a: take, b: 64_s64)
      i = LLVM::add(a: i, b: 1_s64)
  return LLVM::int_ne(a: acc, b: 0_u64)

### Count of leading zero bits over the full 64K-bit width (64K for zero).
@inline
routine Array[U64, K].wide_clz() -> S64
needs U64 K
  var a = me
  var z = 0_s64
  danger
    var ap = a.hijack()
    var i = LLVM::sub(a: LLVM::reinterpret_bits[U64, S64](K), b: 1_s64)
    while LLVM::signed_ge(a: i, b: 0_s64)
      var w = LLVM::load_element_ref[Array[U64, K], U64](ap, LLVM::reinterpret_bits[S64, U64](i))
      if LLVM::int_ne(a: w, b: 0_u64)
        return LLVM::add(a: z, b: LLVM::reinterpret_bits[U64, S64](LLVM::leading_zeros(w)))
      z = LLVM::add(a: z, b: 64_s64)
      i = LLVM::sub(a: i, b: 1_s64)
  return z

### The least significant limb.
@inline
routine Array[U64, K].wide_low_u64() -> U64
needs U64 K
  var a = me
  danger
    return LLVM::load_element_ref[Array[U64, K], U64](a.hijack(), 0_u64)

### The low 128 bits (limbs 0 and 1; limb 1 is taken as 0 when K = 1).
@inline
routine Array[U64, K].wide_low_u128() -> U128
needs U64 K
  var a = me
  danger
    var ap = a.hijack()
    var lo = LLVM::zero_extend[U64, U128](LLVM::load_element_ref[Array[U64, K], U64](ap, 0_u64))
    if LLVM::unsigned_lt(a: K, b: 2_u64)
      return lo
    var hi = LLVM::zero_extend[U64, U128](LLVM::load_element_ref[Array[U64, K], U64](ap, 1_u64))
    return LLVM::bit_or(a: lo, b: LLVM::shift_left(value: hi, bits: 64_u128))

# ----------------------------------------------------------------------------
# Bitwise
# ----------------------------------------------------------------------------

### Limb-wise AND.
@inline
routine Array[U64, K].wide_and(you: Array[U64, K]) -> Array[U64, K]
needs U64 K
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  var a = me
  var b = you
  var r = Array[U64, K]()
  danger
    var ap = a.hijack()
    var bp = b.hijack()
    var rp = r.hijack()
    var i = 0_s64
    while LLVM::signed_lt(a: i, b: kl)
      var ui = LLVM::reinterpret_bits[S64, U64](i)
      LLVM::store_element_ref[Array[U64, K], U64](rp, ui, LLVM::bit_and(a: LLVM::load_element_ref[Array[U64, K], U64](ap, ui), b: LLVM::load_element_ref[Array[U64, K], U64](bp, ui)))
      i = LLVM::add(a: i, b: 1_s64)
  return r

### Limb-wise OR.
@inline
routine Array[U64, K].wide_or(you: Array[U64, K]) -> Array[U64, K]
needs U64 K
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  var a = me
  var b = you
  var r = Array[U64, K]()
  danger
    var ap = a.hijack()
    var bp = b.hijack()
    var rp = r.hijack()
    var i = 0_s64
    while LLVM::signed_lt(a: i, b: kl)
      var ui = LLVM::reinterpret_bits[S64, U64](i)
      LLVM::store_element_ref[Array[U64, K], U64](rp, ui, LLVM::bit_or(a: LLVM::load_element_ref[Array[U64, K], U64](ap, ui), b: LLVM::load_element_ref[Array[U64, K], U64](bp, ui)))
      i = LLVM::add(a: i, b: 1_s64)
  return r

### Limb-wise complement.
@inline
routine Array[U64, K].wide_not() -> Array[U64, K]
needs U64 K
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  var a = me
  var r = Array[U64, K]()
  danger
    var ap = a.hijack()
    var rp = r.hijack()
    var i = 0_s64
    while LLVM::signed_lt(a: i, b: kl)
      var ui = LLVM::reinterpret_bits[S64, U64](i)
      LLVM::store_element_ref[Array[U64, K], U64](rp, ui, LLVM::bit_xor(a: LLVM::load_element_ref[Array[U64, K], U64](ap, ui), b: U64_MAX))
      i = LLVM::add(a: i, b: 1_s64)
  return r

### Keeps only the low `n` bits.
@inline
routine Array[U64, K].wide_keep_low(n: S64) -> Array[U64, K]
needs U64 K
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  var r = me
  danger
    var rp = r.hijack()
    var i = 0_s64
    var take = n
    while LLVM::signed_lt(a: i, b: kl)
      var ui = LLVM::reinterpret_bits[S64, U64](i)
      if LLVM::signed_le(a: take, b: 0_s64)
        LLVM::store_element_ref[Array[U64, K], U64](rp, ui, 0_u64)
      elseif LLVM::signed_lt(a: take, b: 64_s64)
        var w = LLVM::load_element_ref[Array[U64, K], U64](rp, ui)
        var mask = LLVM::sub(a: LLVM::shift_left(value: 1_u64, bits: LLVM::reinterpret_bits[S64, U64](take)), b: 1_u64)
        LLVM::store_element_ref[Array[U64, K], U64](rp, ui, LLVM::bit_and(a: w, b: mask))
      take = LLVM::sub(a: take, b: 64_s64)
      i = LLVM::add(a: i, b: 1_s64)
  return r

### Clears the low `n` bits.
@inline
routine Array[U64, K].wide_clear_low(n: S64) -> Array[U64, K]
needs U64 K
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  var r = me
  danger
    var rp = r.hijack()
    var i = 0_s64
    var take = n
    # Fixed trip count (see `wide_low_nonzero`).
    while LLVM::signed_lt(a: i, b: kl)
      var ui = LLVM::reinterpret_bits[S64, U64](i)
      if LLVM::signed_ge(a: take, b: 64_s64)
        LLVM::store_element_ref[Array[U64, K], U64](rp, ui, 0_u64)
      elseif LLVM::signed_gt(a: take, b: 0_s64)
        var w = LLVM::load_element_ref[Array[U64, K], U64](rp, ui)
        var keep = LLVM::bit_xor(a: LLVM::sub(a: LLVM::shift_left(value: 1_u64, bits: LLVM::reinterpret_bits[S64, U64](take)), b: 1_u64), b: U64_MAX)
        LLVM::store_element_ref[Array[U64, K], U64](rp, ui, LLVM::bit_and(a: w, b: keep))
      take = LLVM::sub(a: take, b: 64_s64)
      i = LLVM::add(a: i, b: 1_s64)
  return r

### Logical left shift by `n` bits (a negative `n` shifts right).
@inline
routine Array[U64, K].wide_shl(n: S64) -> Array[U64, K]
needs U64 K
  if LLVM::signed_lt(a: n, b: 0_s64)
    return me.wide_shr_nonneg(n: LLVM::sub(a: 0_s64, b: n))
  return me.wide_shl_nonneg(n: n)

### Logical right shift by `n` bits (a negative `n` shifts left).
@inline
routine Array[U64, K].wide_shr(n: S64) -> Array[U64, K]
needs U64 K
  if LLVM::signed_lt(a: n, b: 0_s64)
    return me.wide_shl_nonneg(n: LLVM::sub(a: 0_s64, b: n))
  return me.wide_shr_nonneg(n: n)

### Logical left shift by `n >= 0` bits. Kept apart from `wide_shl` so neither shift calls the other:
### mutual recursion would stop `@inline` from inlining them.
@inline
routine Array[U64, K].wide_shl_nonneg(n: S64) -> Array[U64, K]
needs U64 K
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  var q = LLVM::shift_right_signed(n, 6_s64)
  if LLVM::signed_ge(a: q, b: kl)
    return Array[U64, K]()
  var b = LLVM::reinterpret_bits[S64, U64](LLVM::bit_and(a: n, b: 63_s64))
  var r = me
  danger
    var rp = r.hijack()
    # Whole-limb part: one conditional pass per set bit of `q` (1, 2, 4, ... limbs), each reading at
    # `i - step` for a build-time `step`. No limb index depends on `n`, so after unrolling the limbs
    # live in registers and the passes become selects.
    var step = 1_s64
    while LLVM::signed_lt(a: step, b: kl)
      if LLVM::int_ne(a: LLVM::bit_and(a: q, b: step), b: 0_s64)
        var i = LLVM::sub(a: kl, b: 1_s64)
        while LLVM::signed_ge(a: i, b: 0_s64)
          var w = 0_u64
          if LLVM::signed_ge(a: i, b: step)
            w = LLVM::load_element_ref[Array[U64, K], U64](rp, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: i, b: step)))
          LLVM::store_element_ref[Array[U64, K], U64](rp, LLVM::reinterpret_bits[S64, U64](i), w)
          i = LLVM::sub(a: i, b: 1_s64)
      step = LLVM::shift_left(step, 1_s64)
    # Sub-limb part: high to low, so limb j-1 is still unshifted when limb j reads it.
    if LLVM::int_ne(a: b, b: 0_u64)
      var inv = LLVM::sub(a: 64_u64, b: b)
      var j = LLVM::sub(a: kl, b: 1_s64)
      while LLVM::signed_ge(a: j, b: 0_s64)
        var w = LLVM::shift_left(value: LLVM::load_element_ref[Array[U64, K], U64](rp, LLVM::reinterpret_bits[S64, U64](j)), bits: b)
        if LLVM::signed_gt(a: j, b: 0_s64)
          var lower = LLVM::load_element_ref[Array[U64, K], U64](rp, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: j, b: 1_s64)))
          w = LLVM::bit_or(a: w, b: LLVM::shift_right_unsigned(lower, inv))
        LLVM::store_element_ref[Array[U64, K], U64](rp, LLVM::reinterpret_bits[S64, U64](j), w)
        j = LLVM::sub(a: j, b: 1_s64)
  return r

### Logical right shift by `n >= 0` bits (see `wide_shl_nonneg`).
@inline
routine Array[U64, K].wide_shr_nonneg(n: S64) -> Array[U64, K]
needs U64 K
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  var q = LLVM::shift_right_signed(n, 6_s64)
  if LLVM::signed_ge(a: q, b: kl)
    return Array[U64, K]()
  var b = LLVM::reinterpret_bits[S64, U64](LLVM::bit_and(a: n, b: 63_s64))
  var r = me
  danger
    var rp = r.hijack()
    # Whole-limb part (see `wide_shl`): passes of 1, 2, 4, ... limbs, reading at `i + step`.
    var step = 1_s64
    while LLVM::signed_lt(a: step, b: kl)
      if LLVM::int_ne(a: LLVM::bit_and(a: q, b: step), b: 0_s64)
        var i = 0_s64
        while LLVM::signed_lt(a: i, b: kl)
          var w = 0_u64
          var src = LLVM::add(a: i, b: step)
          if LLVM::signed_lt(a: src, b: kl)
            w = LLVM::load_element_ref[Array[U64, K], U64](rp, LLVM::reinterpret_bits[S64, U64](src))
          LLVM::store_element_ref[Array[U64, K], U64](rp, LLVM::reinterpret_bits[S64, U64](i), w)
          i = LLVM::add(a: i, b: 1_s64)
      step = LLVM::shift_left(step, 1_s64)
    # Sub-limb part: low to high, so limb j+1 is still unshifted when limb j reads it.
    if LLVM::int_ne(a: b, b: 0_u64)
      var inv = LLVM::sub(a: 64_u64, b: b)
      var j = 0_s64
      while LLVM::signed_lt(a: j, b: kl)
        var w = LLVM::shift_right_unsigned(LLVM::load_element_ref[Array[U64, K], U64](rp, LLVM::reinterpret_bits[S64, U64](j)), b)
        var nxt = LLVM::add(a: j, b: 1_s64)
        if LLVM::signed_lt(a: nxt, b: kl)
          var upper = LLVM::load_element_ref[Array[U64, K], U64](rp, LLVM::reinterpret_bits[S64, U64](nxt))
          w = LLVM::bit_or(a: w, b: LLVM::shift_left(value: upper, bits: inv))
        LLVM::store_element_ref[Array[U64, K], U64](rp, LLVM::reinterpret_bits[S64, U64](j), w)
        j = LLVM::add(a: j, b: 1_s64)
  return r

# ----------------------------------------------------------------------------
# Arithmetic (wrapping)
# ----------------------------------------------------------------------------

### `me + you` modulo 2^(64K).
@inline
routine Array[U64, K].wide_add(you: Array[U64, K]) -> Array[U64, K]
needs U64 K
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  var a = me
  var b = you
  var r = Array[U64, K]()
  var carry = 0_u128
  danger
    var ap = a.hijack()
    var bp = b.hijack()
    var rp = r.hijack()
    var i = 0_s64
    while LLVM::signed_lt(a: i, b: kl)
      var ui = LLVM::reinterpret_bits[S64, U64](i)
      var x = LLVM::zero_extend[U64, U128](LLVM::load_element_ref[Array[U64, K], U64](ap, ui))
      var y = LLVM::zero_extend[U64, U128](LLVM::load_element_ref[Array[U64, K], U64](bp, ui))
      var s = LLVM::add(a: LLVM::add(a: x, b: y), b: carry)
      LLVM::store_element_ref[Array[U64, K], U64](rp, ui, LLVM::int_truncate[U128, U64](s))
      carry = LLVM::shift_right_unsigned(s, 64_u128)
      i = LLVM::add(a: i, b: 1_s64)
  return r

### `me - you` modulo 2^(64K).
@inline
routine Array[U64, K].wide_sub(you: Array[U64, K]) -> Array[U64, K]
needs U64 K
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  var a = me
  var b = you
  var r = Array[U64, K]()
  var borrow = 0_u128
  danger
    var ap = a.hijack()
    var bp = b.hijack()
    var rp = r.hijack()
    var i = 0_s64
    while LLVM::signed_lt(a: i, b: kl)
      var ui = LLVM::reinterpret_bits[S64, U64](i)
      var x = LLVM::zero_extend[U64, U128](LLVM::load_element_ref[Array[U64, K], U64](ap, ui))
      var y = LLVM::zero_extend[U64, U128](LLVM::load_element_ref[Array[U64, K], U64](bp, ui))
      var d = LLVM::sub(a: LLVM::sub(a: x, b: y), b: borrow)
      LLVM::store_element_ref[Array[U64, K], U64](rp, ui, LLVM::int_truncate[U128, U64](d))
      borrow = LLVM::bit_and(a: LLVM::shift_right_unsigned(d, 64_u128), b: 1_u128)
      i = LLVM::add(a: i, b: 1_s64)
  return r

### `me + v` modulo 2^(64K). The carry runs through every limb: a fixed trip count unrolls into
### registers, an early-exit ripple would keep the array in memory.
@inline
routine Array[U64, K].wide_add_u64(v: U64) -> Array[U64, K]
needs U64 K
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  var r = me
  danger
    var rp = r.hijack()
    var carry = v
    var i = 0_s64
    while LLVM::signed_lt(a: i, b: kl)
      var ui = LLVM::reinterpret_bits[S64, U64](i)
      var w = LLVM::load_element_ref[Array[U64, K], U64](rp, ui)
      var s = LLVM::add(a: w, b: carry)
      LLVM::store_element_ref[Array[U64, K], U64](rp, ui, s)
      carry = if LLVM::unsigned_lt(a: s, b: w) then 1_u64 else 0_u64
      i = LLVM::add(a: i, b: 1_s64)
  return r

### `me - v` modulo 2^(64K). The borrow runs through every limb (see `wide_add_u64`).
@inline
routine Array[U64, K].wide_sub_u64(v: U64) -> Array[U64, K]
needs U64 K
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  var r = me
  danger
    var rp = r.hijack()
    var borrow = v
    var i = 0_s64
    while LLVM::signed_lt(a: i, b: kl)
      var ui = LLVM::reinterpret_bits[S64, U64](i)
      var w = LLVM::load_element_ref[Array[U64, K], U64](rp, ui)
      LLVM::store_element_ref[Array[U64, K], U64](rp, ui, LLVM::sub(a: w, b: borrow))
      borrow = if LLVM::unsigned_lt(a: w, b: borrow) then 1_u64 else 0_u64
      i = LLVM::add(a: i, b: 1_s64)
  return r

### `me * you` modulo 2^(64K).
@inline
routine Array[U64, K].wide_mul(you: Array[U64, K]) -> Array[U64, K]
needs U64 K
  return wide_mul_to[K, K](a: me, b: you)

### Quotient and remainder of an unsigned division.
record WideQuoRem[U64 K]
  ### The quotient.
  quo: Array[U64, K]
  ### The remainder.
  rem: Array[U64, K]

### `me // you` and `me % you` via the base-2^64 Knuth-D kernel (`you` must be nonzero).
routine Array[U64, K].wide_divmod(you: Array[U64, K]) -> WideQuoRem[K]
needs U64 K
  var av = me
  var bv = you
  var rem = Array[U64, K]()
  danger
    var q = knuth_divide[K](a: av.hijack(), b: bv.hijack(), rem: rem.hijack())
    return WideQuoRem[K](quo: q, rem: rem)

### `me // you` (`you` must be nonzero).
@inline
routine Array[U64, K].wide_div(you: Array[U64, K]) -> Array[U64, K]
needs U64 K
  return me.wide_divmod(you: you).quo

### The quotient of a division plus whether its remainder is nonzero.
record WideQuoSticky[U64 K2]
  ### The quotient.
  quo: Array[U64, K2]
  ### True when the remainder is nonzero.
  remnz: Bool

### `a // b` for a K2-limb dividend and a K-limb divisor whose top limb is nonzero (K >= 2, K2 >= K), plus
### whether `a % b` is nonzero. Knuth algorithm D like `knuth_divide`, but the lengths are the build-time K
### and K2 instead of counted significant limbs, and the qhat correction is a fixed two-step loop (Knuth
### bounds it at two), so every limb index is a loop counter and the whole divide unrolls into registers.
### This is the soft-float divide's shape: the dividend is a mantissa shifted up one width, the divisor a
### normalized mantissa.
routine wide_div_sticky[K, K2](a: Array[U64, K2], b: Array[U64, K]) -> WideQuoSticky[K2]
needs U64 K, U64 K2
  var kl = LLVM::reinterpret_bits[U64, S64](K)
  var k2 = LLVM::reinterpret_bits[U64, S64](K2)
  var av = a
  var bv = b
  var q = Array[U64, K2]()
  var un = Array[U64, K2]()
  var vn = Array[U64, K]()
  var remacc = 0_u64
  danger
    var ap = av.hijack()
    var bp = bv.hijack()
    var qp = q.hijack()
    var unp = un.hijack()
    var vnp = vn.hijack()
    var ktop = LLVM::sub(a: kl, b: 1_s64)

    # D1: shift both operands left by su so the divisor's top limb has its MSB set (su may be 0).
    var su = LLVM::leading_zeros(LLVM::load_element_ref[Array[U64, K], U64](bp, LLVM::reinterpret_bits[S64, U64](ktop)))
    var shifted = LLVM::int_ne(a: su, b: 0_u64)
    var su_inv = LLVM::sub(a: 64_u64, b: su)
    var vi = ktop
    while LLVM::signed_ge(a: vi, b: 0_s64)
      var vw = LLVM::shift_left(value: LLVM::load_element_ref[Array[U64, K], U64](bp, LLVM::reinterpret_bits[S64, U64](vi)), bits: su)
      if shifted and LLVM::signed_gt(a: vi, b: 0_s64)
        vw = LLVM::bit_or(a: vw, b: LLVM::shift_right_unsigned(LLVM::load_element_ref[Array[U64, K], U64](bp, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: vi, b: 1_s64))), su_inv))
      LLVM::store_element_ref[Array[U64, K], U64](vnp, LLVM::reinterpret_bits[S64, U64](vi), vw)
      vi = LLVM::sub(a: vi, b: 1_s64)
    # The dividend grows one limb: `un_top` holds the bits shifted out of limb K2-1.
    var un_top = 0_u64
    if shifted
      un_top = LLVM::shift_right_unsigned(LLVM::load_element_ref[Array[U64, K2], U64](ap, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: k2, b: 1_s64))), su_inv)
    var ui = LLVM::sub(a: k2, b: 1_s64)
    while LLVM::signed_ge(a: ui, b: 0_s64)
      var uw = LLVM::shift_left(value: LLVM::load_element_ref[Array[U64, K2], U64](ap, LLVM::reinterpret_bits[S64, U64](ui)), bits: su)
      if shifted and LLVM::signed_gt(a: ui, b: 0_s64)
        uw = LLVM::bit_or(a: uw, b: LLVM::shift_right_unsigned(LLVM::load_element_ref[Array[U64, K2], U64](ap, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: ui, b: 1_s64))), su_inv))
      LLVM::store_element_ref[Array[U64, K2], U64](unp, LLVM::reinterpret_bits[S64, U64](ui), uw)
      ui = LLVM::sub(a: ui, b: 1_s64)

    var vn1 = LLVM::load_element_ref[Array[U64, K], U64](vnp, LLVM::reinterpret_bits[S64, U64](ktop))
    var vn2 = LLVM::load_element_ref[Array[U64, K], U64](vnp, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: ktop, b: 1_s64)))
    var vrec = reciprocal_word(vn1)

    # D2..D7: one quotient limb per step, high to low. Limb j+K of the dividend is `un_top` on the first
    # step and an `un` limb after that.
    var j = LLVM::sub(a: k2, b: kl)
    while LLVM::signed_ge(a: j, b: 0_s64)
      var jn = LLVM::add(a: j, b: kl)
      var intop = LLVM::int_eq(a: jn, b: k2)
      var un_jn = un_top
      if not intop
        un_jn = LLVM::load_element_ref[Array[U64, K2], U64](unp, LLVM::reinterpret_bits[S64, U64](jn))
      var un_jn1 = LLVM::load_element_ref[Array[U64, K2], U64](unp, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: jn, b: 1_s64)))
      var un_jn2 = LLVM::load_element_ref[Array[U64, K2], U64](unp, LLVM::reinterpret_bits[S64, U64](LLVM::sub(a: jn, b: 2_s64)))

      # D3: estimate qhat from the top two dividend limbs over vn1. rhat can pass 2^64 in the
      # all-ones case. `rhat_ok` tracks that, and Knuth's correction applies only while it holds.
      var qhat = 0_u64
      var rhat = 0_u64
      var rhat_ok = true
      if LLVM::int_eq(a: un_jn, b: vn1)
        qhat = U64_MAX
        rhat = LLVM::add(a: un_jn1, b: vn1)
        rhat_ok = LLVM::unsigned_ge(a: rhat, b: un_jn1)
      else
        var dr = div2by1(u1: un_jn, u0: un_jn1, d: vn1, v: vrec)
        qhat = dr.q
        rhat = dr.r
      var step = 0_s64
      while LLVM::signed_lt(a: step, b: 2_s64)
        if rhat_ok
          var lhs = LLVM::mul(a: LLVM::zero_extend[U64, U128](qhat), b: LLVM::zero_extend[U64, U128](vn2))
          var rhs = LLVM::bit_or(a: LLVM::shift_left(LLVM::zero_extend[U64, U128](rhat), 64_u128), b: LLVM::zero_extend[U64, U128](un_jn2))
          if LLVM::unsigned_gt(a: lhs, b: rhs)
            qhat = LLVM::sub(a: qhat, b: 1_u64)
            var rnew = LLVM::add(a: rhat, b: vn1)
            if LLVM::unsigned_lt(a: rnew, b: rhat)
              rhat_ok = false
            else
              rhat = rnew
          else
            rhat_ok = false
        step = LLVM::add(a: step, b: 1_s64)

      # D4: subtract qhat * vn from un[j .. j+K] (signed S128 borrow `k`).
      var k = LLVM::zero_extend[U64, S128](0_u64)
      var ii = 0_s64
      while LLVM::signed_lt(a: ii, b: kl)
        var p = LLVM::mul(a: LLVM::zero_extend[U64, U128](qhat), b: LLVM::zero_extend[U64, U128](LLVM::load_element_ref[Array[U64, K], U64](vnp, LLVM::reinterpret_bits[S64, U64](ii))))
        var plo = LLVM::int_truncate[U128, U64](p)
        var phi = LLVM::int_truncate[U128, U64](LLVM::shift_right_unsigned(p, 64_u128))
        var idx = LLVM::reinterpret_bits[S64, U64](LLVM::add(a: ii, b: j))
        var cur = LLVM::load_element_ref[Array[U64, K2], U64](unp, idx)
        var t = LLVM::sub(a: LLVM::sub(a: LLVM::zero_extend[U64, S128](cur), b: k), b: LLVM::zero_extend[U64, S128](plo))
        LLVM::store_element_ref[Array[U64, K2], U64](unp, idx, LLVM::int_truncate[S128, U64](t))
        k = LLVM::sub(a: LLVM::zero_extend[U64, S128](phi), b: LLVM::shift_right_signed(t, 64_s128))
        ii = LLVM::add(a: ii, b: 1_s64)
      var ttop = LLVM::sub(a: LLVM::zero_extend[U64, S128](un_jn), b: k)
      var newtop = LLVM::int_truncate[S128, U64](ttop)

      # D5/D6: a negative result means qhat was one too big, so add the divisor back.
      if LLVM::signed_lt(a: ttop, b: LLVM::zero_extend[U64, S128](0_u64))
        qhat = LLVM::sub(a: qhat, b: 1_u64)
        var carry = 0_u64
        var ai = 0_s64
        while LLVM::signed_lt(a: ai, b: kl)
          var aidx = LLVM::reinterpret_bits[S64, U64](LLVM::add(a: ai, b: j))
          var sum = LLVM::add(a: LLVM::add(a: LLVM::zero_extend[U64, U128](LLVM::load_element_ref[Array[U64, K2], U64](unp, aidx)), b: LLVM::zero_extend[U64, U128](LLVM::load_element_ref[Array[U64, K], U64](vnp, LLVM::reinterpret_bits[S64, U64](ai)))), b: LLVM::zero_extend[U64, U128](carry))
          LLVM::store_element_ref[Array[U64, K2], U64](unp, aidx, LLVM::int_truncate[U128, U64](sum))
          carry = LLVM::int_truncate[U128, U64](LLVM::shift_right_unsigned(sum, 64_u128))
          ai = LLVM::add(a: ai, b: 1_s64)
        newtop = LLVM::add(a: newtop, b: carry)
      if intop
        un_top = newtop
      else
        LLVM::store_element_ref[Array[U64, K2], U64](unp, LLVM::reinterpret_bits[S64, U64](jn), newtop)
      LLVM::store_element_ref[Array[U64, K2], U64](qp, LLVM::reinterpret_bits[S64, U64](j), qhat)
      j = LLVM::sub(a: j, b: 1_s64)

    # D8: the remainder is the low K limbs of un, still shifted by su (which does not change zero-ness).
    var ri = 0_s64
    while LLVM::signed_lt(a: ri, b: kl)
      remacc = LLVM::bit_or(a: remacc, b: LLVM::load_element_ref[Array[U64, K2], U64](unp, LLVM::reinterpret_bits[S64, U64](ri)))
      ri = LLVM::add(a: ri, b: 1_s64)
  return WideQuoSticky[K2](quo: q, remnz: LLVM::int_ne(a: remacc, b: 0_u64))
