### One word of a turn-fraction entry, the low word first (j = 0 is bits 0..63): DEC_TURN_POS row `row`
### for a non-negative exponent, else DEC_TURN_NEG row `row` = 1 / (2 pi 10^row).
@inline
secret routine dec_turn_word(neg: Bool, row: U64, j: U64) -> U64
  var i = row *% 8_u64 +% (7_u64 -% j)
  return if neg then DEC_TURN_NEG[i] else DEC_TURN_POS[i]

### The reduction of x = c * 10^e (c > 0, x >= 0.78) modulo pi/2: the quadrant q in 0..3 and the angle
### x - q * pi/2 in [-pi/4, pi/4] on the W=192 engine. For e >= 0, frac(x / (2 pi)) = frac(c * 10^b *
### frac(10^(32i) / (2 pi))) with e = 32i + b, and for e < 0 it is frac(c * (1 / (2 pi 10^-e))), where
### -e <= 33 since x >= 0.78 and c < 10^34. The multiplier is below 2^217 and the table fraction has 512
### bits, so the turn fraction is known to about 2^-295: the angle keeps 191 good bits unless x lies within
### 2^-104 of a quarter turn of a multiple of pi/2, far closer than any decimal128 value comes.
routine decimal_quarter_reduce(c: U128, e: S64) -> (U64, UnpackedFloat[3, 6])
  var m = Array[U64, 4]()
  var neg = e < 0_s64
  var row = 0_u64
  if neg
    row = LLVM::reinterpret_bits[S64, U64](0_s64 -% e)
    m[0] = LLVM::int_truncate[U128, U64](c)
    m[1] = LLVM::int_truncate[U128, U64](c >>> 64)
  else
    var eu = LLVM::reinterpret_bits[S64, U64](e)
    row = eu >>> 5
    # m = c * 10^b, a 128 x 128 -> 256-bit product (10^b < 2^104)
    var p10 = p10_u128(k: LLVM::reinterpret_bits[U64, S64](eu & 31_u64))
    var cl = LLVM::zero_extend[U64, U128](LLVM::int_truncate[U128, U64](c))
    var ch = c >>> 64
    var pl = LLVM::zero_extend[U64, U128](LLVM::int_truncate[U128, U64](p10))
    var ph = p10 >>> 64
    var ll = cl *% pl
    var lh = cl *% ph
    var hl = ch *% pl
    var hh = ch *% ph
    var s1 = (ll >>> 64) +% LLVM::zero_extend[U64, U128](LLVM::int_truncate[U128, U64](lh)) +% LLVM::zero_extend[U64, U128](LLVM::int_truncate[U128, U64](hl))
    var s2 = (lh >>> 64) +% (hl >>> 64) +% LLVM::zero_extend[U64, U128](LLVM::int_truncate[U128, U64](hh)) +% (s1 >>> 64)
    m[0] = LLVM::int_truncate[U128, U64](ll)
    m[1] = LLVM::int_truncate[U128, U64](s1)
    m[2] = LLVM::int_truncate[U128, U64](s2)
    m[3] = LLVM::int_truncate[U128, U64]((hh >>> 64) +% (s2 >>> 64))
  # the turn fraction: the low 512 bits of m times the table fraction
  var acc = Array[U64, 8]()
  var i = 0_u64
  while i < 4_u64
    var mi = m[i]
    if mi != 0_u64
      var carry = 0_u64
      var j = 0_u64
      while i +% j < 8_u64
        var t = LLVM::zero_extend[U64, U128](mi) *% LLVM::zero_extend[U64, U128](dec_turn_word(neg: neg, row: row, j: j)) +% LLVM::zero_extend[U64, U128](acc[i +% j]) +% LLVM::zero_extend[U64, U128](carry)
        acc[i +% j] = LLVM::int_truncate[U128, U64](t)
        carry = LLVM::int_truncate[U128, U64](t >>> 64)
        j = j +% 1_u64
    i = i +% 1_u64
  # in quarter turns: the top two bits are the quadrant, the rest the remainder, rounded to the nearest
  # quadrant (a remainder of half a quarter or more counts from the next quadrant, negatively)
  var top = acc[7]
  var q = top >>> 62
  var negative = ((top >>> 61) & 1_u64) != 0_u64
  acc[7] = top & 0x3FFFFFFFFFFFFFFF_u64
  if negative
    q = (q +% 1_u64) & 3_u64
    # 2^510 - acc: the two's complement over the 512 bits, less the two top bits
    var borrow = 1_u64
    var k = 0_u64
    while k < 8_u64
      var v = (acc[k] ^ 0xFFFFFFFFFFFFFFFF_u64) +% borrow
      if v != 0_u64
        borrow = 0_u64
      acc[k] = v
      k = k +% 1_u64
    acc[7] = acc[7] & 0x3FFFFFFFFFFFFFFF_u64
  # the leading bit L of the remainder (in units of 2^-510 quarter turns)
  var w = 7_s64
  while w >= 0_s64 and acc[LLVM::reinterpret_bits[S64, U64](w)] == 0_u64
    w = w -% 1_s64
  if w < 0_s64
    return (q, UnpackedFloat[3, 6].zero(sign: false))
  var lead = w *% 64_s64 +% 63_s64 -% LLVM::reinterpret_bits[U64, S64](LLVM::leading_zeros(acc[LLVM::reinterpret_bits[S64, U64](w)]))
  if lead < 191_s64
    return (q, UnpackedFloat[3, 6].zero(sign: false))
  # the 192 bits from lead - 191 up: 191 significand bits and the rounding bit below them
  var lo = LLVM::reinterpret_bits[S64, U64](lead -% 191_s64)
  var wi = lo >>> 6
  var b = LLVM::int_truncate[U64, U32](lo & 63_u64)
  var win = Array[U64, 3]()
  var k2 = 0_u64
  while k2 < 3_u64
    var wlo = acc[wi +% k2]
    var whi = 0_u64
    if wi +% k2 +% 1_u64 < 8_u64
      whi = acc[wi +% k2 +% 1_u64]
    if b == 0_u32
      win[k2] = wlo
    else
      win[k2] = (wlo >>> b) | (whi << (64_u32 -% b))
    k2 = k2 +% 1_u64
  var round = win[0] & 1_u64
  var h0 = (win[0] >>> 1) | (win[1] << 63)
  var h1 = (win[1] >>> 1) | (win[2] << 63)
  var h2 = win[2] >>> 1
  var ex = lead -% 511_s64
  if round != 0_u64
    h0 = h0 +% 1_u64
    if h0 == 0_u64
      h1 = h1 +% 1_u64
      if h1 == 0_u64
        h2 = h2 +% 1_u64
        if (h2 >>> 63) != 0_u64
          h2 = h2 >>> 1
          ex = ex +% 1_s64
  var quarter = UnpackedFloat[3, 6].make(mant: wide_words3[3](h2: h2, h1: h1, h0: h0), exp: ex, fpclass: POSITIVE_NORMAL)
  var pi = UnpackedFloat[3, 6].pi()
  var angle = quarter.mul(you: UnpackedFloat[3, 6].make(mant: pi.mant, exp: pi.exp -% 1_s64, fpclass: POSITIVE_NORMAL))
  if negative
    return (q, angle.neg())
  return (q, angle)

### sin(t) for |t| <= pi/4 on the W=192 engine: the odd Taylor series in -t^2 through t^31 (the whole
### coefficient table), no reduction. The first dropped term is below 2^-133 of the result.
routine uf192_sin_small(t: UnpackedFloat[3, 6]) -> UnpackedFloat[3, 6]
  var negsq = t.mul(you: t).neg()
  var d = UnpackedFloat[3, 6].sin_coef(15_s64)
  var i = 14_s64
  while i >= 0_s64
    d = d.fma_finite(b: negsq, c: UnpackedFloat[3, 6].sin_coef(i))
    i = i -% 1_s64
  return d.mul(you: t)

### cos(t) for |t| <= pi/4 on the W=192 engine: the even Taylor series in -t^2 through t^32 (the whole
### coefficient table), no reduction. The first dropped term is below 2^-140 of the result.
routine uf192_cos_small(t: UnpackedFloat[3, 6]) -> UnpackedFloat[3, 6]
  var negsq = t.mul(you: t).neg()
  var d = UnpackedFloat[3, 6].cos_coef(16_s64)
  var i = 15_s64
  while i >= 0_s64
    d = d.fma_finite(b: negsq, c: UnpackedFloat[3, 6].cos_coef(i))
    i = i -% 1_s64
  return d

### Which of sin(t), cos(t), -sin(t), -cos(t) is sin(t + q * pi/2) (cos: shift q by one).
@inline
secret routine quadrant_pick_b128(q: U64, s: B128, c: B128) -> B128
  var k = q & 3_u64
  if k == 0_u64
    return s
  if k == 1_u64
    return c
  if k == 2_u64
    return s.neg()
  return c.neg()

### quadrant_pick_b128 on the W=192 engine.
@inline
secret routine quadrant_pick_uf192(q: U64, s: UnpackedFloat[3, 6], c: UnpackedFloat[3, 6]) -> UnpackedFloat[3, 6]
  var k = q & 3_u64
  if k == 0_u64
    return s
  if k == 1_u64
    return c
  if k == 2_u64
    return s.neg()
  return c.neg()

### The ±2^-k band around r: its bits for r * (1 - 2^-k) and r * (1 + 2^-k), or r itself twice when r is
### zero, infinite or NaN (exact then). 2^-k relative is at most 2^(113-k) units in r's last place.
secret routine b128_band(r: B128, k: S64) -> (B128, B128)
  var bits = r.to_bits()
  var sbit = bits & (1_u128 << 127)
  var mag = bits ^ sbit
  var d = LLVM::shift_left(value: 1_u128, bits: LLVM::zero_extend[U64, U128](LLVM::reinterpret_bits[S64, U64](113_s64 -% k)))
  if (mag >>> 112) == 0x7FFF_u128 or mag <= d
    return (r, r)
  return (B128.from_bits(bits: sbit | (mag -% d)), B128.from_bits(bits: sbit | (mag +% d)))

### The D64 that every value within r * (1 ± 2^-k) rounds to, and whether there is one (a correct
### rounding of the true value when r approximates it that closely).
routine d64_round_within(r: B128, k: S64) -> (Bool, D64)
  var (lo, hi) = b128_band(r: r, k: k)
  var a = b128_to_d64(x: lo)
  return (a.to_bits() == b128_to_d64(x: hi).to_bits(), a)

### d64_round_within for D32.
routine d32_round_within(r: B128, k: S64) -> (Bool, D32)
  var (lo, hi) = b128_band(r: r, k: k)
  var a = b128_to_d32(x: lo)
  return (a.to_bits() == b128_to_d32(x: hi).to_bits(), a)

### sin (which = 0), cos (1) or tan (2) of a finite decimal c * 10^e as a B128 near the true value: the
### fast value from the correctly rounded B128 sin/cos (relative error below 2^-107), and the W=192 engine
### value (error far below any decimal rounding) for when the fast one cannot decide the rounding.
### `small` means |x| < 0.78, where no reduction is needed and xb = the B128 of x (relative error 2^-113)
### and xu = the engine value of x.
routine decimal_trig_fast(which: U64, sign: Bool, c: U128, e: S64, small: Bool, xb: B128) -> B128
  if small
    if which == 0_u64
      return xb.sin()
    if which == 1_u64
      return xb.cos()
    var (ss, cs) = xb.sincos()
    return ss /! cs
  var (q, t) = decimal_quarter_reduce(c: c, e: e)
  var tb = t.to_b128()
  if which == 2_u64
    var (st, ct) = tb.sincos()
    var s = quadrant_pick_b128(q: q, s: st, c: ct)
    if sign
      s = s.neg()
    return s /! quadrant_pick_b128(q: q +% 1_u64, s: st, c: ct)
  # sin(t + q pi/2) is ±sin t for an even quadrant and ±cos t for an odd one (cos: one quadrant on), so
  # only one of them is evaluated
  var k = (q +% which) & 3_u64
  var v = tb.sin()
  if (k & 1_u64) != 0_u64
    v = tb.cos()
  if (k & 2_u64) != 0_u64
    v = v.neg()
  if sign and which == 0_u64
    v = v.neg()
  return v

### decimal_trig_fast on the W=192 engine (xu = the engine value of x when small).
routine decimal_trig_engine(which: U64, sign: Bool, c: U128, e: S64, small: Bool, xu: UnpackedFloat[3, 6]) -> UnpackedFloat[3, 6]
  var s = UnpackedFloat[3, 6].zero(sign: false)
  var co = s
  if small
    s = uf192_sin_small(t: xu)
    co = uf192_cos_small(t: xu)
  else
    var (q, t) = decimal_quarter_reduce(c: c, e: e)
    var st = uf192_sin_small(t: t)
    var ct = uf192_cos_small(t: t)
    s = quadrant_pick_uf192(q: q, s: st, c: ct)
    co = quadrant_pick_uf192(q: q +% 1_u64, s: st, c: ct)
    if sign
      s = s.neg()
  if which == 0_u64
    return s
  if which == 1_u64
    return co
  return s.div(you: co)

### sin / cos / tan of a D64 (which = 0 / 1 / 2), correctly rounded unless the engine value is needed and
### lands within its own tiny error of a decimal midpoint.
secret routine d64_trig(x: D64, which: U64) -> D64
  var p = x.decode()
  if p.special != 0_u64
    return D64.quiet_nan()
  var xb = d64_to_b128(x: x)
  var small = xb.abs() < 0.78_b128
  var c = LLVM::zero_extend[U64, U128](p.coeff)
  var (ok, r) = d64_round_within(r: decimal_trig_fast(which: which, sign: p.sign, c: c, e: p.exp, small: small, xb: xb), k: 106_s64)
  if ok
    return r
  var xu = UnpackedFloat[3, 6].zero(sign: false)
  if small
    xu = d128_to_uf192(x: D128(from: x))
  return b128_to_d64(x: decimal_trig_engine(which: which, sign: p.sign, c: c, e: p.exp, small: small, xu: xu).to_b128())

### sin / cos / tan of a D32 (which = 0 / 1 / 2); see d64_trig.
secret routine d32_trig(x: D32, which: U64) -> D32
  var p = x.decode()
  if p.special != 0_u64
    return D32.quiet_nan()
  var xb = B128(from: x)
  var small = xb.abs() < 0.78_b128
  var c = LLVM::zero_extend[U64, U128](p.coeff)
  var (ok, r) = d32_round_within(r: decimal_trig_fast(which: which, sign: p.sign, c: c, e: p.exp, small: small, xb: xb), k: 106_s64)
  if ok
    return r
  var xu = UnpackedFloat[3, 6].zero(sign: false)
  if small
    xu = d128_to_uf192(x: D128(from: x))
  return b128_to_d32(x: decimal_trig_engine(which: which, sign: p.sign, c: c, e: p.exp, small: small, xu: xu).to_b128())

### sin / cos / tan of a D128 (which = 0 / 1 / 2) on the W=192 engine.
secret routine d128_trig(x: D128, which: U64) -> D128
  var p = x.decode()
  if p.special != 0_u64
    return D128.quiet_nan()
  var xu = d128_to_uf192(x: x)
  # |x| < 0.78 needs no reduction (x = 0 included): below 1/2 by the exponent, else by comparing
  var e2 = xu.exp +% 1_s64
  var small = p.coeff == 0_u128 or e2 < -1_s64 or (e2 == -1_s64 and xu.to_b128().abs() < 0.78_b128)
  return uf192_to_d128(x: decimal_trig_engine(which: which, sign: p.sign, c: p.coeff, e: p.exp, small: small, xu: xu))

### Sine of me (radians), correctly rounded. NaN for a non-finite argument.
routine D64.sin() -> D64
  return d64_trig(x: me, which: 0_u64)

### Cosine of me (radians), correctly rounded. NaN for a non-finite argument.
routine D64.cos() -> D64
  return d64_trig(x: me, which: 1_u64)

### Tangent of me (radians), correctly rounded. NaN for a non-finite argument.
routine D64.tan() -> D64
  return d64_trig(x: me, which: 2_u64)

### Sine of me (radians), correctly rounded. NaN for a non-finite argument.
routine D32.sin() -> D32
  return d32_trig(x: me, which: 0_u64)

### Cosine of me (radians), correctly rounded. NaN for a non-finite argument.
routine D32.cos() -> D32
  return d32_trig(x: me, which: 1_u64)

### Tangent of me (radians), correctly rounded. NaN for a non-finite argument.
routine D32.tan() -> D32
  return d32_trig(x: me, which: 2_u64)

### Sine of me (radians). NaN for a non-finite argument.
routine D128.sin() -> D128
  return d128_trig(x: me, which: 0_u64)

### Cosine of me (radians). NaN for a non-finite argument.
routine D128.cos() -> D128
  return d128_trig(x: me, which: 1_u64)

### Tangent of me (radians). NaN for a non-finite argument.
routine D128.tan() -> D128
  return d128_trig(x: me, which: 2_u64)
