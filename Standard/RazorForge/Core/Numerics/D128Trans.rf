module Core

# ============================================================================
# D128Trans — decimal128 (Pmax=34) transcendentals + libm surface via the
# binary256 engine (F256, 237-bit significand ~71 decimal digits). A D128
# value widened to F256, run through the (already 34-digit-correct) F256
# transcendental, and rounded back to 34 digits is correctly rounded: the F256
# error lands near digit ~71, far below the 34-digit boundary.
#
# Mirrors DecimalTrans (which bridges Decimal<->F512) at half the width. The
# special funcs erf/erfc/tgamma/lgamma use the GENERIC W=256 engine cores — the
# octuple-tuned coefficient tables (gamma_coef, erf CF N=120) already exceed 34
# digits, so no dedicated wide tables are needed here.
# ============================================================================

# ============================================================================
# Radix adapters (dec <-> bin256)
# ============================================================================

### Builds the engine value of a U128 integer with the given sign (exact; coeff
### <= 113 bits fits the 237-bit significand). value = mant * 2^(exp-253), MSB at
### bit 254 (W-2). Width constants mirror uf512_from_u256 with W=256.
routine uf256_from_u128(c: U128, sign: Bool) -> UnpackedFloat[U256, U512, 256]
  if LLVM::int_eq(a: c, b: 0_u128)
    return UnpackedFloat[U256, U512, 256].zero(sign: sign)
  var cw = LLVM::zero_extend[U128, U256](c)
  var x = LLVM::sub(a: 256_s64, b: LLVM::int_truncate[U256, S64](LLVM::leading_zeros(cw)))
  var mant = LLVM::shift_left(value: cw, bits: U256.to_width(s: LLVM::sub(a: 255_s64, b: x)))
  return UnpackedFloat[U256, U512, 256].make(mant: mant, exp: LLVM::sub(a: x, b: 2_s64), fpclass: SignedFpClass.from_flags(sign: sign, iszero: false, isinf: false, isnan: false))

### Rounds the engine value (assumed a positive ~integer) to a U256, round-half-even.
### shift = 253 - exp (positive in the ~10^40 range).
routine uf256_to_u256_round(u: UnpackedFloat[U256, U512, 256]) -> U256
  var shift = LLVM::sub(a: 253_s64, b: u.exp)
  if LLVM::signed_le(a: shift, b: 0_s64)
    return LLVM::shift_left(value: u.mant, bits: U256.to_width(s: LLVM::sub(a: 0_s64, b: shift)))
  if LLVM::signed_ge(a: shift, b: 256_s64)
    return LLVM::zero_extend[U64, U256](0_u64)
  var q = LLVM::shift_right_unsigned(u.mant, U256.to_width(s: shift))
  var lost = LLVM::bit_and(a: u.mant, b: U256.low_mask(n: shift))
  var half = LLVM::shift_left[U256](value: 1, bits: U256.to_width(s: LLVM::sub[S64](a: shift, b: 1_s64)))
  if LLVM::unsigned_gt(a: lost, b: half)
    q = LLVM::add[U256](a: q, b: 1)
  elseif LLVM::int_eq[U256](a: lost, b: half) and LLVM::int_ne[U256](a: LLVM::bit_and[U256](a: q, b: 1), b: 0)
    q = LLVM::add[U256](a: q, b: 1)
  return q

### 10^e as an F256 via binary exponentiation of 10.0 (faithful ~few ULP; ample
### for 34-digit D128). No table — F256 covers the full D128 exponent range.
routine f256_pow10(e: S64) -> F256
  var neg = LLVM::signed_lt(a: e, b: 0_s64)
  var n = if neg then LLVM::sub(a: 0_s64, b: e) else e
  var result = UnpackedFloat[U256, U512, 256].from_s64(src: 1_s64).to_f256a()
  var base = UnpackedFloat[U256, U512, 256].from_s64(src: 10_s64).to_f256a()
  while LLVM::signed_gt(a: n, b: 0_s64)
    if LLVM::int_ne(a: LLVM::bit_and(a: n, b: 1_s64), b: 0_s64)
      result = result * base
    base = base * base
    n = LLVM::shift_right_unsigned[S64](n, 1_u32)
  if neg
    return UnpackedFloat[U256, U512, 256].from_s64(src: 1_s64).to_f256a() / result
  return result

### dec -> bin: decimal parts (sign, coeff, exp10) as an F256 (coeff exact, scaled by
### 10^exp). Takes raw parts so the binary parsers (F128/F64) can convert the FULL scanned
### coefficient directly and round once, instead of double-rounding through 34-digit D128.
### The coeff may carry up to 38 digits (<= 126 bits); the 237-bit significand holds it exactly.
routine d128parts_to_f256(p: D128Parts) -> F256
  var s = if p.sign then 1_u64 else 0_u64
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return F256.from_bits(bits: f256a_inf(sign: s))
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return F256.from_bits(bits: f256a_qnan())
  if LLVM::int_eq(a: p.coeff, b: 0_u128)
    return F256.from_bits(bits: LLVM::shift_left(value: LLVM::zero_extend[U64, U256](s), bits: U256.to_width(s: 255_s64)))
  return uf256_from_u128(c: p.coeff, sign: p.sign).to_f256a() * f256_pow10(e: p.exp)

### dec -> bin: D128 value as an F256 (coeff exact, scaled by 10^exp).
routine d128_to_f256(x: D128) -> F256
  return d128parts_to_f256(p: x.decode())

### bin -> dec: F256 value as a D128, correctly rounded to <=34 digits.
routine f256_to_d128(x: F256) -> D128
  if x.is_nan()
    return D128.quiet_nan()
  if x.is_infinite()
    return D128.infinity(sign: x.is_negative())
  if x.is_zero()
    return d128_of_parts(p: D128Parts(sign: x.is_negative(), special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U128](0_u64)))
  var sign = x.is_negative()
  var e_bin = x.to_uf().ilogb()
  # decexp ~ floor(e_bin * log10(2)); log10(2) ~ 315653 / 2^20. +-1 absorbed by decfinB.
  var decexp = LLVM::signed_div(a: LLVM::mul(a: e_bin, b: 315653_s64), b: 1048576_s64)
  var q = LLVM::sub(a: 40_s64, b: decexp)
  var scaled = x.abs() * f256_pow10(e: q)
  var coeff = uf256_to_u256_round(u: scaled.to_uf())
  # Normalize the result cohort: pref = qmax (6111) makes decfinB strip ALL trailing zeros
  # after rounding to 34 digits, so a float->decimal result is stored reduced (e.g. exp2(10)
  # is 1024×10^0, not 1024×10^-30) rather than padded to a fixed ~34-digit fraction.
  return d128_of_parts(p: decfinB(sign: sign, coeff: coeff, exp: LLVM::sub(a: 0_s64, b: q), pref: 6111_s64))

# ============================================================================
# Transcendentals — decode to F256, run the F256 core, round back to D128.
# F256 already carries the full method surface (exp/log/trig/hyperbolic/...).
# ============================================================================

# Transcendentals delegate to the internal F256 engine (propagating). The bare `op()` is CHECKED
# (crashes if the result is non-finite — domain/overflow); `op_unchecked()` propagates inf/NaN.
# Finite-preserving ops (cbrt, sin/cos/tan/atan/atan2, tanh, asinh) need no split.

### e^me. Crashes: NumericDomainError on NaN, NumericOverflowError on ±inf.
routine D128.exp!() -> D128
  var r = me.exp_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw e^me via the F256 core; may return ±inf or NaN; never crashes.
routine D128.exp_unchecked() -> D128
  return f256_to_d128(x: d128_to_f256(x: me).exp_n(n: 20_s64))

### e^me - 1 (accurate near 0). Crashes: NumericDomainError on NaN, NumericOverflowError on ±inf.
routine D128.expm1!() -> D128
  var r = me.expm1_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw e^me - 1 via the F256 core; may return ±inf or NaN; never crashes.
routine D128.expm1_unchecked() -> D128
  return f256_to_d128(x: d128_to_f256(x: me).expm1_n(n: 21_s64))

### 2^me. Crashes: NumericDomainError on NaN, NumericOverflowError on ±inf.
routine D128.exp2!() -> D128
  var r = me.exp2_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw 2^me via the F256 core; may return ±inf or NaN; never crashes.
routine D128.exp2_unchecked() -> D128
  return f256_to_d128(x: d128_to_f256(x: me).exp2())

### 10^me. Crashes: NumericDomainError on NaN, NumericOverflowError on ±inf.
routine D128.exp10!() -> D128
  var r = me.exp10_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw 10^me via the F256 core; may return ±inf or NaN; never crashes.
routine D128.exp10_unchecked() -> D128
  return f256_to_d128(x: d128_to_f256(x: me).exp10())

### Natural log ln(me). Crashes: NumericDomainError on NaN/domain (me<0), NumericOverflowError on
### ±inf (e.g. log(0) = -inf).
routine D128.log!() -> D128
  var r = me.log_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw ln(me) via the F256 core; may return ±inf or NaN; never crashes.
routine D128.log_unchecked() -> D128
  return f256_to_d128(x: d128_to_f256(x: me).log_n(n: 23_s64))

### ln(1 + me) (accurate near 0). Crashes: NumericDomainError on NaN/domain, NumericOverflowError
### on ±inf.
routine D128.log1p!() -> D128
  var r = me.log1p_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw ln(1 + me) via the F256 core; may return ±inf or NaN; never crashes.
routine D128.log1p_unchecked() -> D128
  return f256_to_d128(x: d128_to_f256(x: me).log1p_n(n: 23_s64))

### Base-2 log log2(me). Crashes: NumericDomainError on NaN/domain, NumericOverflowError on ±inf.
routine D128.log2!() -> D128
  var r = me.log2_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw log2(me) via the F256 core; may return ±inf or NaN; never crashes.
routine D128.log2_unchecked() -> D128
  return f256_to_d128(x: d128_to_f256(x: me).log2())

### Base-10 log log10(me). Crashes: NumericDomainError on NaN/domain, NumericOverflowError on ±inf.
routine D128.log10!() -> D128
  var r = me.log10_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw log10(me) via the F256 core; may return ±inf or NaN; never crashes.
routine D128.log10_unchecked() -> D128
  return f256_to_d128(x: d128_to_f256(x: me).log10())

### Square root sqrt(me). Crashes: NumericDomainError on NaN/domain (me<0), NumericOverflowError
### on ±inf.
routine D128.sqrt!() -> D128
  var r = me.sqrt_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw sqrt(me) via the F256 core; may return ±inf or NaN; never crashes.
routine D128.sqrt_unchecked() -> D128
  return f256_to_d128(x: d128_to_f256(x: me).sqrt())

### Cube root cbrt(me). Finite-preserving (defined for all reals), so never non-finite for finite
### input; never crashes.
routine D128.cbrt() -> D128
  return f256_to_d128(x: d128_to_f256(x: me).cbrt())

### Raw me^you via the F256 core; may return ±inf or NaN; never crashes.
### :param you: The exponent.
routine D128.pow_unchecked(you: D128) -> D128
  return f256_to_d128(x: d128_to_f256(x: me).pow(you: d128_to_f256(x: you)))

### sqrt(me² + you²) without intermediate overflow/underflow. Crashes: NumericDomainError on NaN,
### NumericOverflowError on ±inf.
### :param you: The other leg.
routine D128.hypot!(you: D128) -> D128
  var r = me.hypot_unchecked(you: you)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw sqrt(me² + you²) via the F256 core; may return ±inf or NaN; never crashes.
### :param you: The other leg.
routine D128.hypot_unchecked(you: D128) -> D128
  return f256_to_d128(x: d128_to_f256(x: me).hypot(you: d128_to_f256(x: you)))

### Fused multiply-add me*b + c with a single F256 rounding. Crashes: NumericDomainError on NaN,
### NumericOverflowError on ±inf.
### :param b: The multiplier.
### :param c: The addend.
routine D128.fma!(b: D128, c: D128) -> D128
  var r = me.fma_unchecked(b: b, c: c)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw me*b + c via the F256 core; may return ±inf or NaN; never crashes.
### :param b: The multiplier.
### :param c: The addend.
routine D128.fma_unchecked(b: D128, c: D128) -> D128
  return f256_to_d128(x: d128_to_f256(x: me).fma(b: d128_to_f256(x: b), c: d128_to_f256(x: c)))

### Sine of me (radians). Finite-preserving for finite input; never crashes.
routine D128.sin() -> D128
  return f256_to_d128(x: d128_to_f256(x: me).sin_n(n: 16_s64))

### Cosine of me (radians). Finite-preserving for finite input; never crashes.
routine D128.cos() -> D128
  return f256_to_d128(x: d128_to_f256(x: me).cos())

### Tangent of me (radians). Finite-preserving for finite input; never crashes.
routine D128.tan() -> D128
  return f256_to_d128(x: d128_to_f256(x: me).tan())

### Arcsine asin(me) in radians. Crashes: NumericDomainError on NaN/domain (|me|>1),
### NumericOverflowError on ±inf.
routine D128.asin!() -> D128
  var r = me.asin_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw asin(me) via the F256 core; may return ±inf or NaN; never crashes.
routine D128.asin_unchecked() -> D128
  return f256_to_d128(x: d128_to_f256(x: me).asin())

### Arccosine acos(me) in radians. Crashes: NumericDomainError on NaN/domain (|me|>1),
### NumericOverflowError on ±inf.
routine D128.acos!() -> D128
  var r = me.acos_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw acos(me) via the F256 core; may return ±inf or NaN; never crashes.
routine D128.acos_unchecked() -> D128
  return f256_to_d128(x: d128_to_f256(x: me).acos())

### Arctangent atan(me) in radians. Finite-preserving for finite input; never crashes.
routine D128.atan() -> D128
  return f256_to_d128(x: d128_to_f256(x: me).atan())

### Two-argument arctangent atan2(me, x): angle of the point (x, me). Finite-preserving; never
### crashes.
### :param x: The x-coordinate (denominator).
routine D128.atan2(x: D128) -> D128
  return f256_to_d128(x: d128_to_f256(x: me).atan2(x: d128_to_f256(x: x)))

### Hyperbolic sine sinh(me). Crashes: NumericDomainError on NaN, NumericOverflowError on ±inf.
routine D128.sinh!() -> D128
  var r = me.sinh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw sinh(me) via the F256 core; may return ±inf or NaN; never crashes.
routine D128.sinh_unchecked() -> D128
  return f256_to_d128(x: d128_to_f256(x: me).sinh())

### Hyperbolic cosine cosh(me). Crashes: NumericDomainError on NaN, NumericOverflowError on ±inf.
routine D128.cosh!() -> D128
  var r = me.cosh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw cosh(me) via the F256 core; may return ±inf or NaN; never crashes.
routine D128.cosh_unchecked() -> D128
