module Core

# ============================================================================
# D128Trans — decimal128 (Pmax=34) transcendentals + libm surface via the
# UNIFORM W=192 engine (UnpackedFloat[3, 6], ~190-bit significand
# ~57 decimal digits). A D128 value is widened to the W=192 engine value, run
# through the (already 34-digit-correct) engine transcendental, and rounded
# back to 34 digits: the W=192 error lands near digit ~57, far below the
# 34-digit boundary. W=192's target is exactly 113 bits — D128's target — so
# it is the tightest correct scratch (B128's transcendentals use the same
# engine and land faithful to ~114 bits).
#
# There is no packed 192-bit float type, so the intermediate carrier here is
# the engine value UnpackedFloat[3, 6] directly (its 190-bit
# mantissa holds the up-to-126-bit D128 coefficient exactly). The special
# funcs erf/erfc/tgamma/lgamma use the GENERIC W=192 engine cores; the
# W-dispatched coefficient tables (gamma_coef, erf CF) self-size at W=192.
# ============================================================================

# ============================================================================
# Radix adapters (dec <-> W=192 engine)
# ============================================================================

### Builds the W=192 engine value of a U128 integer with the given sign (exact;
### coeff <= 126 bits fits the 190-bit significand). MSB lands at bit 190 (W-2).
### Mirrors B128.to_uf192's normalized-build convention.
routine uf192_from_u128(c: U128, sign: Bool) -> UnpackedFloat[3, 6]
  if LLVM::int_eq(a: c, b: 0_u128)
    return UnpackedFloat[3, 6].zero(sign: sign)
  var cw = wide_from_u128[3](v: c)
  var x = LLVM::sub(a: 192_s64, b: cw.wide_clz())
  var mant = cw.wide_shl(n: LLVM::sub(a: 191_s64, b: x))
  return UnpackedFloat[3, 6].make(mant: mant, exp: LLVM::sub(a: x, b: 2_s64), fpclass: SignedFpClass.from_flags(sign: sign, iszero: false, isinf: false, isnan: false))

### Turns the engine value (assumed a positive ~integer) into a 384-bit (6-limb) integer for a LATER
### decimal rounding that drops at least one digit: the integer part, with its last digit nudged off 0/5
### when the value was inexact (rounding the integer to nearest here and again in decfinB rounded twice,
### so a value just below a decimal midpoint came out on it and then rounded up). shift = 189 - exp (positive in the ~10^40 range; 189 = W-2 - 1 = mantissa MSB slot).
routine uf192_to_limbs6_sticky(u: UnpackedFloat[3, 6]) -> Array[U64, 6]
  var mw = wide_resize[3, 6](a: u.mant)
  var shift = LLVM::sub(a: 189_s64, b: u.exp)
  if LLVM::signed_le(a: shift, b: 0_s64)
    return mw.wide_shl(n: LLVM::sub(a: 0_s64, b: shift))
  if LLVM::signed_ge(a: shift, b: 384_s64)
    return Array[U64, 6]()
  var q = mw.wide_shl(n: LLVM::sub(a: 0_s64, b: shift))
  if mw.wide_keep_low(n: shift).wide_is_zero()
    return q
  # last decimal digit of q: 2^64 = 6 (mod 10) and 6^i = 6 (mod 10), so q = l0 + 6 * (l1 + ... + l5)
  var high = 0_u64
  var i = 1_u64
  while i < 6_u64
    high = high +% LLVM::unsigned_rem[U64](a: q[i], b: 10)
    i = i +% 1_u64
  var digit = LLVM::unsigned_rem[U64](a: LLVM::unsigned_rem[U64](a: q[0_u64], b: 10) +% 6_u64 *% high, b: 10)
  if digit == 0_u64 or digit == 5_u64
    q = q.wide_add_u64(v: 1_u64)
  return q

### Builds the W=192 engine value of a non-negative 384-bit (6-limb) EXACT integer with the given
### sign, rounding the integer to the 190-bit significand ONCE (round-half-even).
### The single-rounding contract: fed the exact `coeff * 10^exp` big integer, this returns the
### correctly-rounded engine value (strictly better than a coeff-load then engine-multiply, which
### rounds twice). MSB of the rounded mantissa lands at bit 190 (W-2); exp per the engine's
### value = mant * 2^(exp - 189) convention.
routine uf192_from_limbs6(n: Array[U64, 6], sign: Bool) -> UnpackedFloat[3, 6]
  if n.wide_is_zero()
    return UnpackedFloat[3, 6].zero(sign: sign)
  # b = bit length of n; the rounded value has exp = b - 2 (adjusted +1 on a rounding carry).
  var b = LLVM::sub(a: 384_s64, b: n.wide_clz())
  var sh = LLVM::sub(a: b, b: 191_s64)
  var exp = LLVM::sub(a: b, b: 2_s64)
  if LLVM::signed_le(a: sh, b: 0_s64)
    # n fits the significand exactly: shift the MSB up to bit 190, no rounding.
    var mant = wide_resize[6, 3](a: n.wide_shl(n: LLVM::sub(a: 0_s64, b: sh)))
    return UnpackedFloat[3, 6].make(mant: mant, exp: exp, fpclass: SignedFpClass.from_flags(sign: sign, iszero: false, isinf: false, isnan: false))
  # sh > 0: q = n >> sh, round-half-even on the sh dropped low bits.
  var q = n.wide_shl(n: LLVM::sub(a: 0_s64, b: sh))
  var lost = n.wide_keep_low(n: sh)
  var half = wide_bit_at[6](pos: LLVM::sub[S64](a: sh, b: 1_s64))
  var lh = lost.wide_cmp(you: half)
  if LLVM::signed_gt(a: lh, b: 0_s64)
    q = q.wide_add_u64(v: 1_u64)
  elseif LLVM::int_eq(a: lh, b: 0_s64) and q.wide_bit(pos: 0_s64)
    q = q.wide_add_u64(v: 1_u64)
  # A round-up may carry the MSB from bit 190 to bit 191 (q == 2^191): renormalize.
  if q.wide_bit(pos: 191_s64)
    q = q.wide_shl(n: -1_s64)
    exp = LLVM::add(a: exp, b: 1_s64)
  return UnpackedFloat[3, 6].make(mant: wide_resize[6, 3](a: q), exp: exp, fpclass: SignedFpClass.from_flags(sign: sign, iszero: false, isinf: false, isnan: false))

### A U256 as 6 limbs (zero-extended).
routine u256_to_limbs6(c: U256) -> Array[U64, 6]
  var r = Array[U64, 6]()
  var i = 0_s64
  while i < 4
    var ui = LLVM::reinterpret_bits[S64, U64](i)
    r[ui] = LLVM::int_truncate[U256, U64](LLVM::shift_right_unsigned(c, LLVM::zero_extend[U64, U256](ui * 64)))
    i = i + 1
  return r

### The low 256 bits of a 6-limb integer as a U256.
routine limbs6_low_u256(a: Array[U64, 6]) -> U256
  var r = LLVM::zero_extend[U64, U256](0_u64)
  var i = 3_s64
  while i >= 0
    var ui = LLVM::reinterpret_bits[S64, U64](i)
    r = LLVM::bit_or(a: LLVM::shift_left(value: r, bits: LLVM::zero_extend[U64, U256](64_u64)), b: LLVM::zero_extend[U64, U256](a[ui]))
    i = i - 1
  return r

### Builds the W=192 engine value of a non-negative U256 EXACT integer (round-half-even into the
### 190-bit significand). Used to load an exact power-of-ten table entry (10^k for k up to 76, which
### exceeds 190 bits for k > 57 and so genuinely rounds).
routine uf192_from_u256(c: U256, sign: Bool) -> UnpackedFloat[3, 6]
  return uf192_from_limbs6(n: u256_to_limbs6(c: c), sign: sign)

# ============================================================================
# Power-of-ten table for the W=192 engine (sqrt-split, both signs, NO division).
# Generated by gen_pow10_192.py (throwaway); DO NOT EDIT BY HAND.
#
# 10^e is decomposed as 10^(S*hi) * 10^lo with S = 79 (ceil(sqrt(6176))), hi = |e|/S,
# lo = |e|%S. Four small tables hold engine-precision (W=192, ~57 decimal-digit) values:
#   HIGH_POS[hi] = 10^(S*hi),   LOW_POS[lo] = 10^lo      (e >= 0)
#   HIGH_NEG[hi] = 10^-(S*hi),  LOW_NEG[lo] = 10^-lo     (e < 0)
# Negative powers are stored DIRECTLY (not 1/positive). pow10(e) = HIGH[hi] * LOW[lo]:
# one engine multiply, zero division, zero binary-exp loop. hi in 0..79 (80 entries),
# lo in 0..78 (79 entries); max |e| covered = 79*79+78 = 6319 >= 6176 (decimal128 MAXE).
#
# Engine convention (UnpackedFloat.from_u64 at W=192): value = mant * 2^(exp-189),
# mant in [2^190, 2^191) (leading bit at 190), engine exp = floor(log2 value) - 1;
# each entry is round-half-even. Layout per index p=idx*3: MANT[p]=h2 (high 64b),
# MANT[p+1]=h1, MANT[p+2]=h0 (low 64b); EXP[idx]=the signed engine exponent.
# ============================================================================

