### Reads a W=192 engine value from a 3-limb MANT preset (stride 3, h2:h1:h0 high->low) and its
### EXP preset at logical index `idx`. Every table entry is a positive normal.
routine pow10_high_pos(idx: U64) -> UnpackedFloat[3, 6]
  var p = LLVM::mul(a: idx, b: 3_u64)
  return UnpackedFloat[3, 6].make(mant: wide_words3[3](h2: POW10_HIGH_POS_MANT[p], h1: POW10_HIGH_POS_MANT[LLVM::add(a: p, b: 1_u64)], h0: POW10_HIGH_POS_MANT[LLVM::add(a: p, b: 2_u64)]), exp: POW10_HIGH_POS_EXP[idx], fpclass: POSITIVE_NORMAL)

routine pow10_low_pos(idx: U64) -> UnpackedFloat[3, 6]
  var p = LLVM::mul(a: idx, b: 3_u64)
  return UnpackedFloat[3, 6].make(mant: wide_words3[3](h2: POW10_LOW_POS_MANT[p], h1: POW10_LOW_POS_MANT[LLVM::add(a: p, b: 1_u64)], h0: POW10_LOW_POS_MANT[LLVM::add(a: p, b: 2_u64)]), exp: POW10_LOW_POS_EXP[idx], fpclass: POSITIVE_NORMAL)

routine pow10_high_neg(idx: U64) -> UnpackedFloat[3, 6]
  var p = LLVM::mul(a: idx, b: 3_u64)
  return UnpackedFloat[3, 6].make(mant: wide_words3[3](h2: POW10_HIGH_NEG_MANT[p], h1: POW10_HIGH_NEG_MANT[LLVM::add(a: p, b: 1_u64)], h0: POW10_HIGH_NEG_MANT[LLVM::add(a: p, b: 2_u64)]), exp: POW10_HIGH_NEG_EXP[idx], fpclass: POSITIVE_NORMAL)

routine pow10_low_neg(idx: U64) -> UnpackedFloat[3, 6]
  var p = LLVM::mul(a: idx, b: 3_u64)
  return UnpackedFloat[3, 6].make(mant: wide_words3[3](h2: POW10_LOW_NEG_MANT[p], h1: POW10_LOW_NEG_MANT[LLVM::add(a: p, b: 1_u64)], h0: POW10_LOW_NEG_MANT[LLVM::add(a: p, b: 2_u64)]), exp: POW10_LOW_NEG_EXP[idx], fpclass: POSITIVE_NORMAL)

### 10^e as a W=192 engine value, over the full decimal128 exponent span (|e| <= 6176), via the
### sqrt-split table: a = |e|, hi = a / 79, lo = a % 79; result = HIGH[hi] * LOW[lo] with the
### positive or negative tables per sign(e). ONE engine multiply, no division, no binary-exp loop.
### Each table entry is correctly rounded to ~57 decimal digits, so the product is faithful to
### ~56 digits, far tighter than D128's 34-digit target.
routine uf192_pow10(e: S64) -> UnpackedFloat[3, 6]
  var neg = LLVM::signed_lt(a: e, b: 0_s64)
  var a = if neg then LLVM::sub(a: 0_s64, b: e) else e
  var au = LLVM::reinterpret_bits[S64, U64](a)
  var hi = LLVM::unsigned_div(a: au, b: 79_u64)
  var lo = LLVM::unsigned_rem(a: au, b: 79_u64)
  # Saturate the high index to the table edge (idx 0..79; the MANT array is 3*80 = 240 wide). An |e|
  # beyond the D128 span — only reachable from an out-of-range / non-canonical input — would otherwise
  # index past the table; clamping mirrors b64_pow10/dd_pow10 and lets decfinB fold the resulting
  # huge/tiny value to inf/0 instead of an out-of-bounds crash.
  if LLVM::unsigned_gt(a: hi, b: 79_u64)
    hi = 79_u64
  if neg
    return pow10_high_neg(idx: hi).mul(you: pow10_low_neg(idx: lo))
  return pow10_high_pos(idx: hi).mul(you: pow10_low_pos(idx: lo))

### dec -> bin: decimal parts (sign, coeff, exp10) as a W=192 engine value (coeff exact,
### scaled by 10^exp). Takes raw parts so the binary parsers can convert the FULL scanned
### coefficient directly and round once, instead of double-rounding through 34-digit D128.
### The coeff may carry up to 38 digits (<= 126 bits); the 190-bit significand holds it exactly.
###
### exp >= 0 within the exact-table range (0..76): form the EXACT big integer coeff * 10^exp
###   (<= 126 + 253 = 379 bits, fits 6 limbs) and round it to the significand ONCE ->
###   correctly rounded, no engine-multiply loop, no faithful pow10 error.
### exp < 0 within range: value = coeff / 10^|exp| — load 10^|exp| exactly and do ONE engine
###   divide (correctly rounded by the engine), instead of building 10^|exp| by binary-exp.
### Out of the table's exact-integer range: fall back to coeff-load times uf192_pow10 (whose own
###   sqrt-split table covers the full D128 exponent span; only the rare extremes reach here).
routine d128parts_to_uf192(p: D128Parts) -> UnpackedFloat[3, 6]
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return UnpackedFloat[3, 6].inf(sign: p.sign)
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return UnpackedFloat[3, 6].nan()
  if LLVM::int_eq(a: p.coeff, b: 0_u128)
    return UnpackedFloat[3, 6].zero(sign: p.sign)
  if LLVM::signed_ge(a: p.exp, b: 0_s64) and LLVM::signed_le(a: p.exp, b: 76_s64)
    # Exact integer coeff * 10^exp in 384 bits (<= 126 + 253 = 379), rounded once.
    var prod = wide_mul_to[6, 6](a: wide_from_u128[6](v: p.coeff), b: u256_to_limbs6(c: pow10_tbl(k: p.exp)))
    return uf192_from_limbs6(n: prod, sign: p.sign)
  if LLVM::signed_lt(a: p.exp, b: 0_s64) and LLVM::signed_ge(a: p.exp, b: -76_s64)
    # coeff / 10^|exp|: exact coeff load, exact 10^|exp| load, one engine divide.
    var num = uf192_from_u128(c: p.coeff, sign: p.sign)
    var den = uf192_from_u256(c: pow10_tbl(k: LLVM::sub(a: 0_s64, b: p.exp)), sign: false)
    return num.div(you: den)
  return uf192_from_u128(c: p.coeff, sign: p.sign).mul(you: uf192_pow10(e: p.exp))

### dec -> bin: D128 value as a W=192 engine value (coeff exact, scaled by 10^exp).
routine d128_to_uf192(x: D128) -> UnpackedFloat[3, 6]
  return d128parts_to_uf192(p: x.decode())

### bin -> dec: W=192 engine value as a D128, correctly rounded to <=34 digits.
routine uf192_to_d128(x: UnpackedFloat[3, 6]) -> D128
  if x.isnan()
    return D128.quiet_nan()
  if x.isinf()
    return D128.infinity(sign: x.sign())
  if x.iszero()
    return d128_of_parts(p: D128Parts(sign: x.sign(), special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U128](0_u64)))
  var sign = x.sign()
  var e_bin = x.ilogb()
  # decexp ~ floor(e_bin * log10(2)); log10(2) ~ 315653 / 2^20. +-1 absorbed by decfinB.
  var decexp = LLVM::signed_div(a: LLVM::mul(a: e_bin, b: 315653_s64), b: 1048576_s64)
  var q = LLVM::sub(a: 40_s64, b: decexp)
  var scaled = x.abs().mul(you: uf192_pow10(e: q))
  var coeff = uf192_to_limbs6_sticky(u: scaled)
  # Normalize the result cohort: pref = qmax (6111) makes decfinB strip ALL trailing zeros
  # after rounding to 34 digits, so a float->decimal result is stored reduced (e.g. exp2(10)
  # is 1024×10^0, not 1024×10^-30) rather than padded to a fixed ~34-digit fraction.
  return d128_of_parts(p: decfinB(sign: sign, coeff: limbs6_low_u256(a: coeff), exp: LLVM::sub(a: 0_s64, b: q), pref: 6111_s64))

# ============================================================================
# Transcendentals — decode to the W=192 engine, run the engine core, round back
# to D128. The generic UnpackedFloat[3, 6] carries the full method
# surface (exp/log/trig/hyperbolic/...).
# ============================================================================

# Transcendentals delegate to the internal W=192 engine (propagating). The bare `op()` is CHECKED
# (crashes if the result is non-finite — domain/overflow); `op_unchecked()` propagates inf/NaN.
# Finite-preserving ops (cbrt, sin/cos/tan/atan/atan2, tanh, asinh) need no split.

### e^me. Crashes: NumericDomainError on NaN, NumericOverflowError on ±inf.
routine D128.exp!() -> D128
  var r = me.exp_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw e^me via the W=192 core; may return ±inf or NaN; never crashes.
routine D128.exp_unchecked() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).exp(n: 20_s64))

### e^me - 1 (accurate near 0). Crashes: NumericDomainError on NaN, NumericOverflowError on ±inf.
routine D128.expm1!() -> D128
  var r = me.expm1_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw e^me - 1 via the W=192 core; may return ±inf or NaN; never crashes.
routine D128.expm1_unchecked() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).expm1(n: 21_s64))

### 2^me. Crashes: NumericDomainError on NaN, NumericOverflowError on ±inf.
routine D128.exp2!() -> D128
  var r = me.exp2_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw 2^me via the W=192 core; may return ±inf or NaN; never crashes.
routine D128.exp2_unchecked() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).mul(you: UnpackedFloat[3, 6].ln2()).exp(n: 20_s64))

### 10^me. Crashes: NumericDomainError on NaN, NumericOverflowError on ±inf.
routine D128.exp10!() -> D128
  var r = me.exp10_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw 10^me via the W=192 core; may return ±inf or NaN; never crashes.
routine D128.exp10_unchecked() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).mul(you: UnpackedFloat[3, 6].ln10()).exp(n: 20_s64))

### Natural log ln(me). Crashes: NumericDomainError on NaN/domain (me<0), NumericOverflowError on
### ±inf (e.g. log(0) = -inf).
routine D128.log!() -> D128
  var r = me.log_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw ln(me) via the W=192 core; may return ±inf or NaN; never crashes.
routine D128.log_unchecked() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).log(n: 23_s64, m: 0_s64, t: 0_s64))

### ln(1 + me) (accurate near 0). Crashes: NumericDomainError on NaN/domain, NumericOverflowError
### on ±inf.
routine D128.log1p!() -> D128
  var r = me.log1p_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw ln(1 + me) via the W=192 core; may return ±inf or NaN; never crashes.
routine D128.log1p_unchecked() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).log1p(n: 23_s64, m: 0_s64))

### Base-2 log log2(me). Crashes: NumericDomainError on NaN/domain, NumericOverflowError on ±inf.
routine D128.log2!() -> D128
  var r = me.log2_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw log2(me) via the W=192 core; may return ±inf or NaN; never crashes.
routine D128.log2_unchecked() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).log(n: 23_s64, m: 0_s64, t: 0_s64).div(you: UnpackedFloat[3, 6].ln2()))

### Base-10 log log10(me). Crashes: NumericDomainError on NaN/domain, NumericOverflowError on ±inf.
routine D128.log10!() -> D128
  var r = me.log10_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw log10(me) via the W=192 core; may return ±inf or NaN; never crashes.
routine D128.log10_unchecked() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).log(n: 23_s64, m: 0_s64, t: 0_s64).div(you: UnpackedFloat[3, 6].ln10()))

### Square root sqrt(me). Crashes: NumericDomainError on NaN/domain (me<0), NumericOverflowError
### on ±inf.
routine D128.sqrt!() -> D128
  var r = me.sqrt_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw sqrt(me) via the W=192 core; may return ±inf or NaN; never crashes.
routine D128.sqrt_unchecked() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).sqrt())

### Cube root cbrt(me). Finite-preserving (defined for all reals), so never non-finite for finite
### input; never crashes.
routine D128.cbrt() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).cbrt())

### Raw me^you via the W=192 core; may return ±inf or NaN; never crashes.
### Runs the full C99/IEEE pow special-case ladder on the engine value (mirrors B128.pow),
### with the finite core exp(you * ln|me|) at W=192. :param you: The exponent.
routine D128.pow_unchecked(you: D128) -> D128
  var mu = d128_to_uf192(x: me)
  var yo = d128_to_uf192(x: you)
  var one = UnpackedFloat[3, 6].from_s64(src: 1_s64)
  var negone = one.neg()
  var poszero = UnpackedFloat[3, 6].zero(sign: false)
  var negzero = UnpackedFloat[3, 6].zero(sign: true)
  var posinf = UnpackedFloat[3, 6].inf(sign: false)
  var neginf = UnpackedFloat[3, 6].inf(sign: true)
  var mefin = not mu.isnan() and not mu.isinf()
  var youfin = not yo.isnan() and not yo.isinf()
  var yisint = yo.isint()
  var yisoddint = yisint and not yo.iseven()
  # Negative base raised to a non-integer power has no real result -> qNaN.
  if mu.sign() and mefin and not mu.iszero() and youfin and not yisint
    return uf192_to_d128(x: UnpackedFloat[3, 6].nan())
  if mu.eq(you: one) or yo.iszero()
    return uf192_to_d128(x: one)
  if mu.isnan()
    return uf192_to_d128(x: UnpackedFloat[3, 6].nan())
  if yo.isnan()
    return uf192_to_d128(x: UnpackedFloat[3, 6].nan())
  if not yo.sign() and not yo.iszero() and mu.iszero() and yisoddint
    return uf192_to_d128(x: mu)
  if mu.iszero() and not yo.sign() and not yo.iszero() and not yisoddint
    return uf192_to_d128(x: poszero)
  if yo.isinf() and mu.eq(you: negone)
    return uf192_to_d128(x: one)
  var absxlt1 = negone.lt(you: mu) and mu.lt(you: one)
  var absxgt1 = mu.lt(you: negone) or one.lt(you: mu)
  if yo.isinf() and yo.sign() and absxlt1
    return uf192_to_d128(x: posinf)
  if yo.isinf() and yo.sign() and absxgt1
    return uf192_to_d128(x: poszero)
  if yo.isinf() and not yo.sign() and absxlt1
    return uf192_to_d128(x: poszero)
  if yo.isinf() and not yo.sign() and absxgt1
    return uf192_to_d128(x: posinf)
  if mu.isinf() and mu.sign() and yo.sign() and yisoddint
    return uf192_to_d128(x: negzero)
  if mu.isinf() and mu.sign() and yo.sign() and not yo.iszero() and not yisoddint
    return uf192_to_d128(x: poszero)
  if mu.isinf() and mu.sign() and not yo.sign() and yisoddint
    return uf192_to_d128(x: neginf)
  if mu.isinf() and mu.sign() and not yo.sign() and not yo.iszero() and not yisoddint
    return uf192_to_d128(x: posinf)
  if mu.isinf() and not mu.sign() and yo.sign() and not yo.iszero()
    return uf192_to_d128(x: poszero)
  if mu.isinf() and not mu.sign() and not yo.sign() and not yo.iszero()
    return uf192_to_d128(x: posinf)
  if mu.iszero() and yisoddint and yo.sign()
    return uf192_to_d128(x: UnpackedFloat[3, 6].inf(sign: mu.sign()))
  if mu.iszero() and yo.sign() and not yo.iszero() and not yisoddint
    return uf192_to_d128(x: posinf)
  var z = mu.abs().log(n: 23_s64, m: 0_s64, t: 0_s64).mul(you: yo).exp(n: 20_s64)
  if mu.sign() and yisoddint
    z = z.neg()
  return uf192_to_d128(x: z)

### sqrt(x² + y²) without intermediate overflow/underflow. Crashes: NumericDomainError on NaN,
### NumericOverflowError on ±inf.
### :param x: One leg.
### :param y: The other leg.
routine hypot!(x: D128, y: D128) -> D128
  var r = hypot_unchecked(x: x, y: y)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw sqrt(x² + y²) via the W=192 core; may return ±inf or NaN; never crashes.
### :param x: One leg.
### :param y: The other leg.
routine hypot_unchecked(x: D128, y: D128) -> D128
  var a = d128_to_uf192(x: x).abs()
  var b = d128_to_uf192(x: y).abs()
  return uf192_to_d128(x: a.mul(you: a).add(you: b.mul(you: b)).sqrt())

### sqrt(x² + y² + z²) without intermediate overflow\underflow. Crashes: NumericDomainError on NaN,
### NumericOverflowError on ±inf.
### :param x: First leg.
### :param y: Second leg.
### :param z: Third leg.
routine hypot!(x: D128, y: D128, z: D128) -> D128
  var r = hypot_unchecked(x: x, y: y, z: z)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw sqrt(x² + y² + z²) via the W=192 core; may return ±inf or NaN; never crashes. Summed once,
### so no intermediate double rounding.
### :param x: First leg.
### :param y: Second leg.
### :param z: Third leg.
routine hypot_unchecked(x: D128, y: D128, z: D128) -> D128
  var a = d128_to_uf192(x: x).abs()
  var b = d128_to_uf192(x: y).abs()
  var c = d128_to_uf192(x: z).abs()
  return uf192_to_d128(x: a.mul(you: a).add(you: b.mul(you: b)).add(you: c.mul(you: c)).sqrt())

### Fused multiply-add me*b + c with a single W=192 rounding. Crashes: NumericDomainError on NaN,
### NumericOverflowError on ±inf.
### :param b: The multiplier.
### :param c: The addend.
routine D128.fma!(b: D128, c: D128) -> D128
  var r = me.fma_unchecked(b: b, c: c)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw me*b + c via the W=192 core; may return ±inf or NaN; never crashes.
### :param b: The multiplier.
### :param c: The addend.
routine D128.fma_unchecked(b: D128, c: D128) -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).fma(b: d128_to_uf192(x: b), c: d128_to_uf192(x: c)))

### Sine of me (radians). Finite-preserving for finite input; never crashes.
routine D128.sin() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).sin(n: 16_s64))

### Cosine of me (radians). Finite-preserving for finite input; never crashes.
routine D128.cos() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).cos())

### Tangent of me (radians). Finite-preserving for finite input; never crashes.
routine D128.tan() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).tan())

### Arcsine asin(me) in radians. Crashes: NumericDomainError on NaN/domain (|me|>1),
### NumericOverflowError on ±inf.
routine D128.asin!() -> D128
  var r = me.asin_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw asin(me) via the W=192 core; may return ±inf or NaN; never crashes.
routine D128.asin_unchecked() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).asin())

### Arccosine acos(me) in radians. Crashes: NumericDomainError on NaN/domain (|me|>1),
### NumericOverflowError on ±inf.
routine D128.acos!() -> D128
  var r = me.acos_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw acos(me) via the W=192 core; may return ±inf or NaN; never crashes.
routine D128.acos_unchecked() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).acos())

### Arctangent atan(me) in radians. Finite-preserving for finite input; never crashes.
routine D128.atan() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).atan())

### Two-argument arctangent atan2(y, x): angle of the point (x, y). Finite-preserving; never
### crashes.
### :param y: The y-coordinate (numerator).
### :param x: The x-coordinate (denominator).
routine atan2(y: D128, x: D128) -> D128
  return uf192_to_d128(x: d128_to_uf192(x: y).atan2(x0: d128_to_uf192(x: x)))

### Hyperbolic sine sinh(me). Crashes: NumericDomainError on NaN, NumericOverflowError on ±inf.
routine D128.sinh!() -> D128
  var r = me.sinh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw sinh(me) via the W=192 core; may return ±inf or NaN; never crashes.
routine D128.sinh_unchecked() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).sinh())

### Hyperbolic cosine cosh(me). Crashes: NumericDomainError on NaN, NumericOverflowError on ±inf.
routine D128.cosh!() -> D128
  var r = me.cosh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw cosh(me) via the W=192 core; may return ±inf or NaN; never crashes.
routine D128.cosh_unchecked() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).cosh())

### Hyperbolic tangent tanh(me). Finite-preserving for finite input; never crashes.
routine D128.tanh() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).tanh())

### Inverse hyperbolic sine asinh(me). Finite-preserving for finite input; never crashes.
routine D128.asinh() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).asinh())

### Inverse hyperbolic cosine acosh(me). Crashes: NumericDomainError on NaN/domain (me<1),
### NumericOverflowError on ±inf.
routine D128.acosh!() -> D128
  var r = me.acosh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw acosh(me) via the W=192 core; may return ±inf or NaN; never crashes.
routine D128.acosh_unchecked() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).acosh())

### Inverse hyperbolic tangent atanh(me). Crashes: NumericDomainError on NaN/domain (|me|>1),
### NumericOverflowError on ±inf (e.g. atanh(±1) = ±inf).
routine D128.atanh!() -> D128
  var r = me.atanh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw atanh(me) via the W=192 core; may return ±inf or NaN; never crashes.
routine D128.atanh_unchecked() -> D128
  return uf192_to_d128(x: d128_to_uf192(x: me).atanh())

# ============================================================================
# Special functions via generic W=192 engine cores (the W-dispatched tables
# self-size at W=192 with the 113-bit-target counts). Mirrors B128.erf/tgamma
# on the same engine.
# ============================================================================

### Small-integer W=192 engine constant (erf/tgamma thresholds and exact special results).
routine uf192_intval(n: S64) -> UnpackedFloat[3, 6]
  return UnpackedFloat[3, 6].from_s64(src: n)

### gamma via the generic Stirling lgamma_core (W-dispatched gamma_coef self-sizes at W=192).
routine uf192_tgamma(x: UnpackedFloat[3, 6]) -> UnpackedFloat[3, 6]
  if x.isnan()
    return UnpackedFloat[3, 6].nan()
  if x.isinf()
    if x.sign()
      return UnpackedFloat[3, 6].nan()
    return x
  if x.iszero()
    return UnpackedFloat[3, 6].inf(sign: x.sign())
  if x.sign() and x.isint()
    return UnpackedFloat[3, 6].nan()
  var p = x.lgamma_core()
  # lgamma_core returns (sign, ln|gamma|); exponentiate to recover |gamma| then reapply sign.
  var r = p.item1.exp(n: 20_s64)
  if p.item0
    r = r.neg()
  return r

### Log-gamma ln|gamma(x)| via the generic Stirling lgamma_core. lgamma(0)=lgamma(±inf)=+inf, and
### +inf at negative integers (poles). Returns the magnitude's log; the sign of gamma is dropped.
routine uf192_lgamma(x: UnpackedFloat[3, 6]) -> UnpackedFloat[3, 6]
  if x.isnan()
    return UnpackedFloat[3, 6].nan()
  if x.iszero() or x.isinf()
    return UnpackedFloat[3, 6].inf(sign: false)
  if x.sign() and x.isint()
    return UnpackedFloat[3, 6].inf(sign: false)
  var p = x.lgamma_core()
  return p.item1

# ============================================================================
# W=192 erf/erfc with caller-sized CF levels (D128's 113-bit target). Same engine and branch
# structure as B128.erf/erfc; D128's 72/120 mid/tail counts match B128's own W=192 path.
# (Gamma was assessed too: at 113 bits its internal log/exp need near-full degrees — no slack.)
# ============================================================================

### erf at W=192 with caller-sized CF levels (D128). Mirrors B128.erf's branch structure.
### erf(-inf) = -1, erf(+inf) = 1. Threshold ±3.1 picks the erf vs 1-erfc continued fraction.
routine uf192_erf_fast(x: UnpackedFloat[3, 6], levels_mid: S64, levels_tail: S64) -> UnpackedFloat[3, 6]
  if x.isnan()
    return UnpackedFloat[3, 6].nan()
  if x.isinf()
    if x.sign()
      return uf192_intval(n: -1_s64)
    return uf192_intval(n: 1_s64)
  var thr = UnpackedFloat[3, 6].from_s64(src: 31_s64).div(you: UnpackedFloat[3, 6].from_s64(src: 10_s64))
  if x.lt(you: thr.neg())
    return UnpackedFloat[3, 6].from_s64(src: -1_s64).sub(you: x.erfc_cf(levels: levels_tail))
  if x.lt(you: thr)
    return x.erf_cf(levels: levels_mid)
  return UnpackedFloat[3, 6].from_s64(src: 1_s64).sub(you: x.erfc_cf(levels: levels_tail))

### erfc at W=192 with caller-sized CF levels (D128). Mirrors B128.erfc's branch structure.
### erfc(-inf) = 2, erfc(+inf) = 0. Threshold ±3.1 selects erf vs erfc continued fraction.
routine uf192_erfc_fast(x: UnpackedFloat[3, 6], levels_mid: S64, levels_tail: S64) -> UnpackedFloat[3, 6]
  if x.isnan()
    return UnpackedFloat[3, 6].nan()
  if x.isinf()
    if x.sign()
      return uf192_intval(n: 2_s64)
    return uf192_intval(n: 0_s64)
  var thr = UnpackedFloat[3, 6].from_s64(src: 31_s64).div(you: UnpackedFloat[3, 6].from_s64(src: 10_s64))
  if x.lt(you: thr.neg())
    return UnpackedFloat[3, 6].from_s64(src: 2_s64).add(you: x.erfc_cf(levels: levels_tail))
  if x.lt(you: thr)
    return UnpackedFloat[3, 6].from_s64(src: 1_s64).sub(you: x.erf_cf(levels: levels_mid))
  return x.erfc_cf(levels: levels_tail)

### Error function erf(me), in [-1, 1]. Finite-preserving; never crashes.
routine D128.erf() -> D128
  return uf192_to_d128(x: uf192_erf_fast(x: d128_to_uf192(x: me), levels_mid: 72_s64, levels_tail: 120_s64))

### Complementary error function erfc(me) = 1 - erf(me), in [0, 2]. Finite-preserving; never
### crashes.
routine D128.erfc() -> D128
  return uf192_to_d128(x: uf192_erfc_fast(x: d128_to_uf192(x: me), levels_mid: 72_s64, levels_tail: 120_s64))

### Gamma function. Checked: crashes if the result is non-finite (overflow or a pole at a
### non-positive integer). Matches the tgamma!/tgamma_unchecked split on the other types.
routine D128.tgamma!() -> D128
  var r = me.tgamma_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Raw gamma(me) via the W=192 special core; may return ±inf or NaN; never crashes.
routine D128.tgamma_unchecked() -> D128
  # 113-bit gamma needs degrees just below the full width (sweep: logn floor ~20, expn floor ~18);
  # conservative margins leave too little slack to justify a reduced path. Keep the full core.
  return uf192_to_d128(x: uf192_tgamma(x: d128_to_uf192(x: me)))

### Log-gamma ln|gamma(me)|. Finite for non-pole inputs; +inf at 0 and non-positive integers.
### Never crashes.
routine D128.lgamma() -> D128
  return uf192_to_d128(x: uf192_lgamma(x: d128_to_uf192(x: me)))

# ============================================================================
# libm manipulation / classification — decimal-native on D128Parts (value =
# (-1)^sign * coeff * 10^exp). Mirrors the Decimal surface at Pmax=34.
# fmod/remainder/remquo and binary-exponent ops omitted (scaleb = decimal ldexp).
# ============================================================================

### IEEE 754 signbit: the raw sign bit (true for negatives, -0, and -NaN). Never crashes.
routine D128.signbit() -> Bool
  return me.decode().sign

### True if me is negative (sign bit set; includes -0 and -NaN).
routine D128.is_negative() -> Bool
  return me.decode().sign

### True if me is strictly positive (not signed, not zero).
routine D128.is_positive() -> Bool
  var p = me.decode()
  return not p.sign and LLVM::int_eq(a: p.special, b: 0_u64) and LLVM::int_ne(a: p.coeff, b: 0_u128)

### True if me is a finite, nonzero subnormal: quantum exponent at the minimum (-6176)
### with a coefficient below 10^33 (fewer than the full 34 significant digits).
routine D128.is_subnormal() -> Bool
  var p = me.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64) or LLVM::int_eq(a: p.coeff, b: 0_u128)
    return false
  return LLVM::int_eq(a: p.exp, b: -6176_s64) and LLVM::unsigned_lt(a: p.coeff, b: LLVM::int_truncate[U256, U128](pow10_tbl(k: 33_s64)))

### Splits into integer and fractional parts (C modf); both carry me's sign.
routine D128.modf() -> (D128, D128)
  if me.is_nan()
    return (me, me)
  var p = me.decode()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return (me, d128_of_parts(p: D128Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U128](0_u64))))
  var ip = me.trunc()
  return (ip, me - ip)

### True if me is finite and nonzero (special=0, coeff!=0). Note: includes subnormals.
routine D128.is_normal() -> Bool
  var p = me.decode()
  return LLVM::int_eq(a: p.special, b: 0_u64) and LLVM::int_ne(a: p.coeff, b: 0_u128)

### C99 fpclassify: classifies me as SIGNALING_NAN, NAN, INFINITE, ZERO, SUBNORMAL, or NORMAL.
routine D128.fpclassify() -> FpClass
  var p = me.decode()
  if LLVM::int_eq(a: p.special, b: 3_u64)
    return SIGNALING_NAN
  if LLVM::unsigned_ge(a: p.special, b: 2_u64)
    return NAN
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return INFINITE
  if LLVM::int_eq(a: p.coeff, b: 0_u128)
    return ZERO
  if me.is_subnormal()
    return SUBNORMAL
  return NORMAL

### Absolute value |me| (clears the sign bit; preserves specials and the cohort). Never crashes.
routine D128.abs() -> D128
  var p = me.decode()
  return d128_of_parts(p: D128Parts(sign: false, special: p.special, exp: p.exp, coeff: p.coeff))

# ============================================================================
# IEEE 754 Tier 1 — total ordering predicates (shared decimal band helper)
# ============================================================================

### Signed total-order band for a decoded decimal class (sign + special). Ordered so that a
### plain `<=` ranks cross-class operands per IEEE 754 totalOrder:
### -qNaN < -sNaN < -inf < -finite < +finite < +inf < +sNaN < +qNaN.
routine decimal_order_band(sign: Bool, special: U64) -> S64
  var rank = when
    LLVM::int_eq(a: special, b: 1_u64) => 1_s64
    LLVM::int_eq(a: special, b: 3_u64) => 2_s64
    LLVM::int_eq(a: special, b: 2_u64) => 3_s64
    else => 0_s64
  return if sign then LLVM::sub(a: 0_s64, b: LLVM::add(a: 1_s64, b: rank)) else LLVM::add(a: 1_s64, b: rank)

### IEEE 754 totalOrder for decimals: a total order over all values including signed zeros,
### cohorts (equal value with differing exponents), and NaNs. For finite operands of equal
### value the smaller-exponent member precedes when positive (the reverse when negative).
### :param you: The value to compare against.
### :returns: Whether `me` precedes or equals `you` in the total order.
routine D128.total_order(you: D128) -> Bool
  var pa = me.decode()
  var pb = you.decode()
  if LLVM::unsigned_ge(a: pa.special, b: 2_u64) or LLVM::unsigned_ge(a: pb.special, b: 2_u64)
    return decimal_order_band(sign: pa.sign, special: pa.special) <= decimal_order_band(sign: pb.sign, special: pb.special)
  var c = me.cmp(you: you)
  if c != SAME
    return c == ME_SMALL
  if pa.sign != pb.sign
    return pa.sign
  if pa.sign
    return LLVM::signed_ge(a: pa.exp, b: pb.exp)
  return LLVM::signed_le(a: pa.exp, b: pb.exp)

### IEEE 754 totalOrderMag for decimals: `total_order` applied to the magnitudes.
### :param you: The value whose magnitude to compare against.
### :returns: Whether `|me|` precedes or equals `|you|` in the total order.
routine D128.total_order_mag(you: D128) -> Bool
  return me.abs().total_order(you: you.abs())

### Negation -me (flips the sign bit; preserves specials and the cohort). Never crashes.
routine D128.neg() -> D128
  var p = me.decode()
  return d128_of_parts(p: D128Parts(sign: not p.sign, special: p.special, exp: p.exp, coeff: p.coeff))

### C99 copysign: me's magnitude with you's sign bit. Never crashes.
### :param you: The value supplying the sign.
routine D128.copysign(you: D128) -> D128
  var p = me.decode()
  return d128_of_parts(p: D128Parts(sign: you.decode().sign, special: p.special, exp: p.exp, coeff: p.coeff))

### Returns -1, 0, or +1 indicating the sign of `me`; NaN propagates; ±0 -> +0.
routine D128.signum() -> D128
  if me.is_nan()
    return D128.quiet_nan()
  if me.is_zero()
    return d128_of_parts(p: D128Parts(sign: false, special: 0_u64, exp: 0_s64, coeff: 0_u128))
  return if me.decode().sign then D128(from: -1_s64) else D128(from: 1_s64)

### Throws when `me` is non-finite (inf or NaN).
@crash_only
routine D128.finite!() -> D128
  if not me.is_finite()
    if me.is_nan()
      throw NumericDomainError(description: "domain error: no real result")
    throw NumericOverflowError(description: "overflow: out of range")
  return me

### C99 fmod: me - trunc(me/you)*you (truncated-division remainder).
routine D128.fmod(you: D128) -> D128
  if me.is_nan() or you.is_nan()
    return D128.quiet_nan()
  if me.is_infinite() or you.is_zero()
    return D128.quiet_nan()
  if you.is_infinite()
    return me
  var n = (me / you).trunc()
  return me - n * you

### C99 fmax: the larger of me and you, treating NaN as missing (returns the non-NaN operand).
### :param you: The value to compare against.
routine D128.fmax(you: D128) -> D128
  if me.is_nan()
    return you
  if you.is_nan()
    return me
  if (me - you).decode().sign
    return you
  return me

### C99 fmin: the smaller of me and you, treating NaN as missing (returns the non-NaN operand).
### :param you: The value to compare against.
routine D128.fmin(you: D128) -> D128
  if me.is_nan()
    return you
  if you.is_nan()
    return me
  if (me - you).decode().sign
    return me
  return you

### C99 fdim: the positive difference max(me - you, 0); NaN if either operand is NaN.
### :param you: The value to subtract.
routine D128.fdim(you: D128) -> D128
  if me.is_nan() or you.is_nan()
    return D128.quiet_nan()
  var d = me - you
  if d.decode().sign
    return d128_of_parts(p: D128Parts(sign: false, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U128](0_u64)))
  return d

### IEEE 754 scaleB: `me * 10^n`. Checked: crashes if a finite `me` overflows to ±infinity.
### :param n: The power-of-ten exponent to apply.
### :returns: `me` scaled by `10^n`.
routine D128.scaleb!(n: S64) -> D128
  var r = me.scaleb_unchecked(n: n)
  if r.is_finite() or not me.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me * 10^n` with raw propagation (overflow -> ±infinity, underflow -> 0).
### :param n: The power-of-ten exponent to apply.
### :returns: `me` scaled by `10^n`.
routine D128.scaleb_unchecked(n: S64) -> D128
  var p = me.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64) or LLVM::int_eq(a: p.coeff, b: 0_u128)
    return me
  var ne = LLVM::add(a: p.exp, b: n)
  if LLVM::signed_gt(a: ne, b: 6111_s64)
    return D128.infinity(sign: p.sign)
  if LLVM::signed_lt(a: ne, b: -6176_s64)
    return d128_of_parts(p: D128Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U128](0_u64)))
  return d128_of_parts(p: D128Parts(sign: p.sign, special: 0_u64, exp: ne, coeff: p.coeff))

# ============================================================================
# IEEE 754 Tier 2 — exponent extraction, selection, rounding
# (decimal next_up/next_down deferred — cohort/ULP stepping not yet implemented)
# ============================================================================

### IEEE 754 logb: the base-10 exponent `e` with `10^e <= |me| < 10^(e+1)`, as a decimal integer
### (logb(0)=-inf, logb(±inf)=+inf, logb(NaN)=NaN). Propagating; never crashes.
### :returns: The radix-10 exponent of `me`.
routine D128.logb() -> D128
  var p = me.decode()
  if LLVM::int_eq(a: p.special, b: 2_u64) or LLVM::int_eq(a: p.special, b: 3_u64)
    return D128.quiet_nan()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return D128.infinity(sign: false)
  if LLVM::int_eq(a: p.coeff, b: 0_u128)
    return D128.infinity(sign: true)
  return D128(from: LLVM::add(a: p.exp, b: LLVM::sub(a: digits10_u128(c: p.coeff), b: 1_s64)))

### IEEE 754-2008 minNum: the smaller operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, ignoring NaN.
routine D128.min_num(you: D128) -> D128
  return me.fmin(you: you)

### IEEE 754-2008 maxNum: the larger operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, ignoring NaN.
routine D128.max_num(you: D128) -> D128
  return me.fmax(you: you)

### IEEE 754-2019 minimum: the smaller operand, propagating NaN, ordering -0 below +0.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, NaN if either is NaN.
routine D128.minimum(you: D128) -> D128
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  var c = me.cmp(you: you)
  if c == ME_SMALL
    return me
  if c == ME_LARGE
    return you
  if me.is_zero()
    return if me.signbit() then me else you
  return me

### IEEE 754-2019 maximum: the larger operand, propagating NaN, ordering +0 above -0.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, NaN if either is NaN.
routine D128.maximum(you: D128) -> D128
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  var c = me.cmp(you: you)
  if c == ME_LARGE
    return me
  if c == ME_SMALL
    return you
  if me.is_zero()
    return if me.signbit() then you else me
  return me

### IEEE 754 roundToIntegralTiesToAway: rounds to nearest integer, halves away from zero
### (alias of `round`). Never crashes.
### :returns: `me` rounded to an integral value with ties away from zero.
routine D128.round_ties_away() -> D128
  return me.round()

# ============================================================================
# IEEE 754 Tier 3 — decimal-specific (quantize, same_quantum, remainder)
# ============================================================================

### IEEE 754 sameQuantum: `true` when `me` and `other` have the same exponent (quantum), or are
### both infinities, or both NaNs. Never crashes.
### :param you: The value whose quantum to compare against.
### :returns: Whether the two share a quantum.
routine D128.same_quantum(you: D128) -> Bool
  var pa = me.decode()
  var pb = you.decode()
  if LLVM::unsigned_ge(a: pa.special, b: 2_u64) or LLVM::unsigned_ge(a: pb.special, b: 2_u64)
    return LLVM::unsigned_ge(a: pa.special, b: 2_u64) and LLVM::unsigned_ge(a: pb.special, b: 2_u64)
  if LLVM::int_eq(a: pa.special, b: 1_u64) or LLVM::int_eq(a: pb.special, b: 1_u64)
    return LLVM::int_eq(a: pa.special, b: 1_u64) and LLVM::int_eq(a: pb.special, b: 1_u64)
  return LLVM::int_eq(a: pa.exp, b: pb.exp)

### IEEE 754 quantize: returns `me`'s value re-expressed with the exponent of `other` (rounding
### half-even when digits are dropped). Returns NaN when the result needs more than 34 significand
### digits, or for incompatible specials. The canonical money-formatting / fixed-scale operation.
### :param you: The value supplying the target exponent.
### :returns: `me` quantized to `other`'s exponent, or NaN if not representable.
routine D128.quantize(you: D128) -> D128
  var pa = me.decode()
  var pb = you.decode()
  if LLVM::unsigned_ge(a: pa.special, b: 2_u64) or LLVM::unsigned_ge(a: pb.special, b: 2_u64)
    return D128.quiet_nan()
  var ainf = LLVM::int_eq(a: pa.special, b: 1_u64)
  var binf = LLVM::int_eq(a: pb.special, b: 1_u64)
  if ainf or binf
    if ainf and binf
      return me
    return D128.quiet_nan()
  var target = pb.exp
  if LLVM::int_eq(a: pa.exp, b: target)
    return me
  if LLVM::signed_gt(a: pa.exp, b: target)
    # Scale the coefficient UP by 10^(pa.exp - target); exact, but NaN if it needs > 34 digits.
    var shift = LLVM::sub(a: pa.exp, b: target)
    if LLVM::int_ne(a: pa.coeff, b: 0_u128) and LLVM::signed_gt(a: LLVM::add(a: digits10_u128(c: pa.coeff), b: shift), b: 34_s64)
      return D128.quiet_nan()
    var scaled = LLVM::mul(a: LLVM::zero_extend[U128, U256](pa.coeff), b: pow10b(k: shift))
    return d128_of_parts(p: D128Parts(sign: pa.sign, special: 0_u64, exp: target, coeff: LLVM::int_truncate[U256, U128](scaled)))
  # pa.exp < target: drop (target - pa.exp) digits with half-even rounding.
  var drop = LLVM::sub(a: target, b: pa.exp)
  if LLVM::signed_gt(a: drop, b: 34_s64)
    return d128_of_parts(p: D128Parts(sign: pa.sign, special: 0_u64, exp: target, coeff: LLVM::zero_extend[U64, U128](0_u64)))
  var cw = LLVM::zero_extend[U128, U256](pa.coeff)
  var divp = pow10b(k: drop)
  var q = div_pow10b(x: cw, k: drop)
  var r = LLVM::sub(a: cw, b: LLVM::mul(a: q, b: divp))
  var twice = LLVM::mul(a: r, b: LLVM::zero_extend[U64, U256](2_u64))
  if LLVM::unsigned_gt(a: twice, b: divp)
    q = LLVM::add(a: q, b: LLVM::zero_extend[U64, U256](1_u64))
  elseif LLVM::int_eq(a: twice, b: divp) and LLVM::int_ne(a: LLVM::bit_and(a: q, b: LLVM::zero_extend[U64, U256](1_u64)), b: LLVM::zero_extend[U64, U256](0_u64))
    q = LLVM::add(a: q, b: LLVM::zero_extend[U64, U256](1_u64))
  return d128_of_parts(p: D128Parts(sign: pa.sign, special: 0_u64, exp: target, coeff: LLVM::int_truncate[U256, U128](q)))

### IEEE 754 remainder: `me - other * n`, where `n` is the integer nearest `me / other` (ties to
### even). Result satisfies `|r| <= |other| / 2`. Returns NaN if `me` is infinite or `other` is
### zero; returns `me` if `other` is infinite. Never crashes.
### :param you: The divisor.
### :returns: The IEEE remainder of `me / other`.
routine D128.remainder(you: D128) -> D128
  if me.is_nan() or you.is_nan()
    return D128.quiet_nan()
  if me.is_infinite() or you.is_zero()
    return D128.quiet_nan()
  if you.is_infinite()
    return me
  var n = me.truediv_unchecked(you: you).rint()
  return me.sub_unchecked(you: you.mul_unchecked(you: n))

### IEEE 754 normalize (the `reduce` operation): the value with trailing zeros stripped to the
### simplest member of its cohort (e.g. `3.00` -> `3`, `1.50` -> `1.5`, `100` -> `1E+2`,
### `0.00` -> `0`). Specials pass through unchanged. Never crashes. Arithmetic stays
### cohort-preserving (IEEE); this is the explicit opt-in to the shortest representation.
### :returns: `me` normalized to its simplest cohort member.
routine D128.normalize() -> D128
  var p = me.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64)
    return me
  if LLVM::int_eq(a: p.coeff, b: 0_u128)
    return d128_of_parts(p: D128Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U128](0_u64)))
  return d128_of_parts(p: decfinB(sign: p.sign, coeff: LLVM::zero_extend[U128, U256](p.coeff), exp: p.exp, pref: 6111_s64))

### Rounds to integral. mode: 0 trunc, 1 floor, 2 ceil, 3 round (half away), 4 rint (half even).
routine d128_round_int(x: D128, mode: S64) -> D128
  var p = x.decode()
  if LLVM::int_ne(a: p.special, b: 0_u64)
    return x
  if LLVM::int_eq(a: p.coeff, b: 0_u128)
    return x
  if LLVM::signed_ge(a: p.exp, b: 0_s64)
    return x
  var ndrop = LLVM::sub(a: 0_s64, b: p.exp)
  var cw = LLVM::zero_extend[U128, U256](p.coeff)
  var q = LLVM::zero_extend[U64, U256](0_u64)
  var rnz = true
  var half = false
  var gthalf = false
  if LLVM::signed_le(a: ndrop, b: 34_s64)
    var divp = pow10b(k: ndrop)
    q = div_pow10b(x: cw, k: ndrop)
    var r = LLVM::sub(a: cw, b: LLVM::mul(a: q, b: divp))
    rnz = LLVM::int_ne[U256](a: r, b: 0)
    var twice = LLVM::mul(a: r, b: LLVM::zero_extend[U64, U256](2_u64))
    half = LLVM::int_eq(a: twice, b: divp)
    gthalf = LLVM::unsigned_gt(a: twice, b: divp)
  var inc = false
  if LLVM::int_eq(a: mode, b: 1_s64)
    inc = p.sign and rnz
  elseif LLVM::int_eq(a: mode, b: 2_s64)
    inc = (not p.sign) and rnz
  elseif LLVM::int_eq(a: mode, b: 3_s64)
    inc = gthalf or half
  elseif LLVM::int_eq(a: mode, b: 4_s64)
    if gthalf
      inc = true
    elseif half
      inc = LLVM::int_ne(a: LLVM::bit_and(a: q, b: LLVM::zero_extend[U64, U256](1_u64)), b: LLVM::zero_extend[U64, U256](0_u64))
  var qq = q
  if inc
    qq = LLVM::add(a: q, b: LLVM::zero_extend[U64, U256](1_u64))
  return d128_of_parts(p: D128Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: LLVM::int_truncate[U256, U128](qq)))

### Truncates toward zero to an integral value. Specials pass through. Never crashes.
routine D128.trunc() -> D128
  return d128_round_int(x: me, mode: 0_s64)

### Rounds down toward -inf to an integral value. Specials pass through. Never crashes.
routine D128.floor() -> D128
  return d128_round_int(x: me, mode: 1_s64)

### Rounds up toward +inf to an integral value. Specials pass through. Never crashes.
routine D128.ceil() -> D128
  return d128_round_int(x: me, mode: 2_s64)

### Rounds to nearest integral value, ties away from zero. Specials pass through. Never crashes.
routine D128.round() -> D128
  return d128_round_int(x: me, mode: 3_s64)

### Rounds to nearest integral value, ties to even (IEEE roundTiesToEven). Never crashes.
routine D128.rint() -> D128
  return d128_round_int(x: me, mode: 4_s64)

### Fractional part me - trunc(me) (carries me's sign). NaN propagates; ±inf -> ±0. Never crashes.
routine D128.frac() -> D128
  if me.is_nan()
    return me
  var p = me.decode()
  if LLVM::int_eq(a: p.special, b: 1_u64)
    return d128_of_parts(p: D128Parts(sign: p.sign, special: 0_u64, exp: 0_s64, coeff: LLVM::zero_extend[U64, U128](0_u64)))
  return me - me.trunc()
