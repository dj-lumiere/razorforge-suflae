module Core

# ============================================================================
# Correctly rounded inverse hyperbolic cosine of B32
# ============================================================================
# Ported from CORE-MATH, src/binary32/acosh/acoshf.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2023 Alexei Sibidanov. Distributed under the MIT license: see LICENSE-CORE-MATH next to
# this file. RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the original
# is kept (its floating-point exception raising is dropped).
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats.

### Inverse hyperbolic cosine, correctly rounded: the exact acosh rounded to the nearest `B32` (ties to
### even), identical on every platform. Raw IEEE 754 propagation: `acosh(1) == 0`, `+infinity` maps to
### itself, and any `me < 1` (or NaN) gives NaN.
### :returns: The correctly rounded inverse hyperbolic cosine.
routine B32.acosh_unchecked() -> B32
  var tu = me.to_bits()
  if tu <= 0x3F800000_u32
    return b32_acosh_special(x: me)
  if tu <= 0x3F99DB23_u32
    # 1 < x <= 0x1.33b646p+0
    var z = B64(from: me -! 1.0_b32)
    var a = (2.0 *! z).sqrt_unchecked()
    var z2 = z *! z
    var z4 = z2 *! z2
    var f = ((-0x1.555555555491ep-4 +! z *! 0x1.333333319c2p-6) +! z2 *! (-0x1.6db6da26e5e0ep-8 +! z *! 0x1.f1c698b7100cep-10)) +! z4 *! ((-0x1.6e7ca9e152dc2p-11 +! z *! 0x1.1b4cf187158bdp-12) +! z2 *! (-0x1.b5137f11a88e5p-14 +! z *! 0x1.056c6c57152b2p-15))
    return B32(from: a +! (a *! z) *! f)
  if tu < 0x7F800000_u32
    var xd = B64(from: me)
    return B32(from: b32_acosh_log(tp: xd +! (xd *! xd -! 1.0).sqrt_unchecked()))
  return b32_acosh_special(x: me)

### acosh at x <= 1, +infinity, NaN and negative inputs.
### :param x: The input.
### :returns: 0 for x = 1, x itself for +infinity, a quiet NaN otherwise.
secret routine b32_acosh_special(x: B32) -> B32
  var tu = x.to_bits()
  if tu == 0x3F800000_u32
    return 0.0_b32
  if (tu << 1) > 0xFF000000_u32
    # NaN: x + x also quiets a signaling NaN
    return x +! x
  if tu == 0x7F800000_u32
    return x
  return B32.from_bits(bits: 0x7FC00000_u32)

### Returns log(tp) for tp >= 1, correctly rounded once narrowed to B32 (the shared tail of the
### inverse hyperbolic functions, evaluated through a 128-entry reciprocal table).
### :param tp: The argument of the logarithm.
### :returns: log(tp) as a B64 accurate enough to round correctly to B32.
secret routine b32_acosh_log(tp: B64) -> B64
  var tb = tp.to_bits()
  var m = tb & 0x000FFFFFFFFFFFFF_u64
  var j = (m +% (1_u64 << 44)) >>> 45
  var e = B64(from: LLVM::reinterpret_bits[U64, S64](tb >>> 52) - 0x3FF)
  var w = B64.from_bits(bits: m | (0x3FF_u64 << 52))
  var z = w *! B64.from_bits(bits: B32_ACOSH_IX[j]) -! 1.0
  var z2 = z *! z
  var r = ((0x1.62e42fefa39efp-1 *! e +! B64.from_bits(bits: B32_ACOSH_LIX[j])) +! z *! 0x1.0000000066947p+0) +! z2 *! (-0x1.00007f053d8cbp-1 +! z *! 0x1.555280111d914p-2)
  if ((r.to_bits() +% 259000) & 0xFFFFFFF_u64) < 260000
    # accurate path
    z2 = z *! z
    var c0 = 1.0 +! z *! -0.5
    var c2 = 0x1.55555555030bcp-2 +! z *! -0x1.ffffffff2b4e5p-3
    var c4 = 0x1.999b5076a42f2p-3 +! z *! -0x1.55570c45a647dp-3
    c0 = c0 +! z2 *! (c2 +! z2 *! c4)
    var lh = 0x1.62e4p-1 *! e
    var ll = 0x1.7f7d1cf79abcap-20 *! e
    r = (z *! c0 +! (ll +! B64.from_bits(bits: B32_ACOSH_LIX[j]))) +! lh
    if (r.to_bits() & 0xFFFFFFF_u64) == 0
      var h = (z *! c0 +! (ll +! B64.from_bits(bits: B32_ACOSH_LIX[j]))) +! (lh -! r)
      r = r +! 64.0 *! h
  return r

