module Core

# ============================================================================
# Correctly rounded arc tangent of B64
# ============================================================================
# Ported from CORE-MATH, src/binary64/atan/atan.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2023-2026 Alexei Sibidanov <sibid@uvic.ca>. Distributed under the MIT license: see
# LICENSE-CORE-MATH next to this file. RazorForge has no dynamic rounding modes, so only the round-to-nearest
# path of the original is kept (its errno and exception-flag handling are dropped).
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats.

### Arc tangent (radians), correctly rounded: the exact arc tangent rounded to the nearest `B64` (ties to
### even), identical on every platform. The result lies in [-pi/2, pi/2], `atan(-x) == -atan(x)`, ±0 maps
### to itself, ±infinity to ±pi/2 (rounded), and NaN to NaN.
### :returns: The correctly rounded arc tangent.
routine B64.atan() -> B64
  var x = me
  var tu = x.to_bits()
  # at encodes |x|
  var at = tu & 0x7FFFFFFFFFFFFFFF_u64
  var i = LLVM::reinterpret_bits[U64, S64](at >>> 51) - 2030
  if at < 0x3F7B21C475E6362A_u64
    # |x| < 0x1.b21c475e6362ap-8
    if at == 0
      return x
    if at < 0x3E40000000000000_u64
      # |x| < 0x1p-27
      return LLVM::fma[B64](a: -0x1p-54, b: x, c: x)
    var x2 = x *! x
    var x3 = x *! x2
    var x4 = x2 *! x2
    var f = x3 *! ((-0x1.5555555555555p-2 +! x2 *! 0x1.99999999998c1p-3) +! x4 *! (-0x1.249249176aecp-3 +! x2 *! 0x1.c711fd121ae8p-4))
    var epsp = f *! 0x1.6p-50
    var epsm = f *! 0x1.6p-51
    var ub0 = (f +! epsp) +! x
    var lb0 = (f -! epsm) +! x
    if ub0 == lb0
      return ub0
    return b64_atan_refine(x: x, a: ub0)
  var h = 0.0
  var ah = 0.0
  var al = 0.0
  if at > 0x4062DED8E34A9035_u64
    # |x| > 0x1.2ded8e34a9035p+7
    var halfpi: B64 = 0x1.921fb54442d18p+0
    var halfpil: B64 = 0x1.1a62633145c07p-54
    ah = halfpi.copysign(sign: x)
    al = halfpil.copysign(sign: x)
    if at >= 0x434D02967C31CDB5_u64
      # |x| >= 0x1.d02967c31cdb5p+53
      if at > 0x7FF0000000000000_u64
        # NaN
        return x +! x
      return ah +! al
    h = -1.0 /! x
  else
    # now 0x1.b21c475e6362ap-8 <= |x| <= 0x1.2ded8e34a9035p+7, thus 1 <= i <= 30
    var u = tu & 0x0007FFFFFFFFFFFF_u64
    var ut = u >>> 35
    var ut2 = (ut *% ut) >>> 16
    var ci = LLVM::reinterpret_bits[S64, U64](i)
    var j = (((B64_ATAN_C0[ci] << 16) +% ut *% B64_ATAN_C1[ci]) -% ut2 *% B64_ATAN_C2[ci]) >>> 25
    var one: B64 = 1.0
    var sg = one.copysign(sign: x)
    var ta = sg *! B64.from_bits(bits: B64_ATAN_AH[j])
    var id = sg *! LLVM::unsigned_to_float[U64, B64](j)
    al = sg *! B64.from_bits(bits: B64_ATAN_AL[j]) +! 0x1.8469898cc517p-55 *! id
    h = (x -! ta) /! (1.0 +! x *! ta)
    ah = 0x1.921fb54442dp-7 *! id
  var h2 = h *! h
  var h4 = h2 *! h2
  var fp = (1.0 +! h2 *! -0x1.555555555552bp-2) +! h4 *! (0x1.9999999069c2p-3 +! h2 *! -0x1.248d2c8444ac6p-3)
  al = LLVM::fma[B64](a: h, b: fp, c: al)
  var e = h *! 0x1.f8p-51
  var ub = (al +! e) +! ah
  var lb = (al -! e) +! ah
  if ub == lb
    return ub
  return b64_atan_refine(x: x, a: ub)

### Sum `x + y` as a double-double (s, e), assuming |x| >= |y| or x == 0.
### :param x: The larger addend.
### :param y: The smaller addend.
### :returns: The rounded sum and its error.
secret routine b64_atan_fasttwosum(x: B64, y: B64) -> (B64, B64)
  var s = x +! y
  var z = s -! x
  return (s, y -! z)

### Double-double sum (xh + xl) + (ch + cl).
### :param xh: The high part of the first operand.
### :param xl: The low part of the first operand.
### :param ch: The high part of the second operand.
### :param cl: The low part of the second operand.
### :returns: The high and low parts of the sum.
secret routine b64_atan_adddd(xh: B64, xl: B64, ch: B64, cl: B64) -> (B64, B64)
  var s = xh +! ch
  var d = s -! xh
  var l = ((ch -! d) +! (xh +! (d -! s))) +! (xl +! cl)
  return (s, l)

### Double-double product (xh + xl) * (ch + cl).
### :param xh: The high part of the first factor.
### :param xl: The low part of the first factor.
### :param ch: The high part of the second factor.
### :param cl: The low part of the second factor.
### :returns: The high and low parts of the product.
secret routine b64_atan_muldd(xh: B64, xl: B64, ch: B64, cl: B64) -> (B64, B64)
  var ahlh = ch *! xl
  var alhh = cl *! xh
  var ahhh = ch *! xh
  var ahhl = LLVM::fma[B64](a: ch, b: xh, c: -ahhh)
  ahhl = ahhl +! (alhh +! ahlh)
  return b64_atan_fasttwosum(x: ahhh, y: ahhl)

### The accurate path, reached when the fast path cannot decide the rounding: evaluates atan(x) to about
### 107 bits with double-double arithmetic.
### :param x: The argument, with 0x1p-27 <= |x|.
### :param a: The fast-path approximation of atan(x).
### :returns: The correctly rounded arc tangent.
secret routine b64_atan_refine(x: B64, a: B64) -> B64
  var phi = a.abs() *! 0x1.45f306dc9c883p6 +! 256.5
  # 256.5 < phi < 384.5, so 0 <= i <= 128
  var i = (phi.to_bits() >>> 44) & 0xFF_u64
  var h = 0.0
  var hl = 0.0
  if i == 128
    h = -1.0 /! x
    hl = LLVM::fma[B64](a: h, b: x, c: 1.0) *! h
  else
    var ta = B64.from_bits(bits: B64_ATAN_AH[i]).copysign(sign: x)
    var zta = x *! ta
    var ztal = LLVM::fma[B64](a: x, b: ta, c: -zta)
    var zmta = x -! ta
    var v = 1.0 +! zta
    var d = 1.0 -! v
    var ev = ((d +! zta) -! ((d +! v) -! 1.0)) +! ztal
    var r = 1.0 /! v
    var rl = (LLVM::fma[B64](a: r, b: -v, c: 1.0) -! ev *! r) *! r
    h = r *! zmta
    hl = LLVM::fma[B64](a: r, b: zmta, c: -h) +! rl *! zmta
  var p2 = b64_atan_muldd(xh: h, xl: hl, ch: h, cl: hl)
  var h2 = p2.item0
  var h2l = p2.item1
  var h4 = h2 *! h2
  var p3 = b64_atan_muldd(xh: h, xl: hl, ch: h2, cl: h2l)
  var h3 = p3.item0
  var h3l = p3.item1
  var fl = h2 *! ((0x1.c71c71c71c71cp-4 +! h2 *! -0x1.745d1745d1265p-4) +! h4 *! (0x1.3b13b115bcbc4p-4 +! h2 *! -0x1.1107c41ad3253p-4))
  # the double-double polynomial over ch[0..2], Horner from the top coefficient
  var ch = -0x1.2492492492492p-3 +! fl
  var cl = ((-0x1.2492492492492p-3 -! ch) +! fl) +! -0x1.249242093c016p-57
  var m = b64_atan_muldd(xh: h2, xl: h2l, ch: ch, cl: cl)
  ch = m.item0
  cl = m.item1
  var th = ch +! 0x1.999999999999ap-3
  var tl = (0x1.999999999999ap-3 -! th) +! ch
  ch = th
  cl = cl +! (tl +! -0x1.999999999bcb8p-57)
  m = b64_atan_muldd(xh: h2, xl: h2l, ch: ch, cl: cl)
  ch = m.item0
  cl = m.item1
  th = ch +! -0x1.5555555555555p-2
  tl = (-0x1.5555555555555p-2 -! th) +! ch
  ch = th
  cl = cl +! (tl +! -0x1.5555555555555p-56)
  m = b64_atan_muldd(xh: h3, xl: h3l, ch: ch, cl: cl)
  var f = m.item0
  fl = m.item1
  var ah = 0.0
  var al = 0.0
  var at = 0.0
  var one: B64 = 1.0
  var sg = one.copysign(sign: x)
  if i == 0
    ah = h
    al = f
    at = fl
  else
    var df = 0.0
    if i < 128
      df = sg *! B64.from_bits(bits: B64_ATAN_AL[i])
    var id = LLVM::unsigned_to_float[U64, B64](i).copysign(sign: x)
    ah = 0x1.921fb54442dp-7 *! id
    al = 0x1.8469898cc518p-55 *! id
    at = -0x1.fc8f8cbb5bf8p-104 *! id
    var s = b64_atan_adddd(xh: al, xl: at, ch: df, cl: 0.0)
    s = b64_atan_adddd(xh: s.item0, xl: s.item1, ch: h, cl: hl)
    s = b64_atan_adddd(xh: s.item0, xl: s.item1, ch: f, cl: fl)
    al = s.item0
    at = s.item1
  var s0 = b64_atan_fasttwosum(x: ah, y: al)
  var v0 = s0.item0
  var s1 = b64_atan_fasttwosum(x: s0.item1, y: at)
  var v1 = s1.item0
  var v2 = s1.item1
  var t0 = v0.to_bits()
  var t1 = v1.to_bits()
  var low = 0x000FFFFFFFFFFFFF_u64
  if ((t1 +% 1) & low) <= 2 or ((t0 >>> 52) & 0x7FF_u64) -% ((t1 >>> 52) & 0x7FF_u64) > 103
    var ax = x.abs()
    var k = 0_u64
    while k < 12
      if ax == B64.from_bits(bits: B64_ATAN_DB_X[k])
        return B64.from_bits(bits: B64_ATAN_DB_H[k]).copysign(sign: x) +! sg *! B64.from_bits(bits: B64_ATAN_DB_L[k])
      k = k + 1
    if (t1 & low) == 0
      var w = v2.to_bits()
      if ((w ^ t1) >>> 63) != 0
        t1 = t1 -% 1
      else
        t1 = t1 +% 1
      v1 = B64.from_bits(bits: t1)
  return v1 +! v0

# Float tables are stored as IEEE 754 bit patterns (read back with B64.from_bits).
# A[j] hi: tan(pi/256*j); lo: atan(hi) - pi/256*j
