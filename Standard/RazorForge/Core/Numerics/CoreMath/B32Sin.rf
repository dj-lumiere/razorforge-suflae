module Core

# ============================================================================
# Correctly rounded sine of B32
# ============================================================================
# Ported from CORE-MATH, src/binary32/sin/sinf.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2022-2025 Alexei Sibidanov. Distributed under the MIT license: see LICENSE-CORE-MATH next
# to this file. RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the original
# is kept (its errno handling is dropped). Arithmetic uses the unchecked operators `+! -! *! /!`, which are
# raw IEEE 754 on floats.
# The argument reductions and the tables here are shared with `B32.cos()` (B32Cos.rf).

### `sin(i*pi/16)` for i in 0..31, as B64 bit patterns.
secret preset B32_SIN_TB: Array[U64, 32] = [0x0000000000000000_u64, 0x3FC8F8B83C69A60B_u64, 0x3FD87DE2A6AEA963_u64, 0x3FE1C73B39AE68C8_u64, 0x3FE6A09E667F3BCD_u64, 0x3FEA9B66290EA1A3_u64, 0x3FED906BCF328D46_u64, 0x3FEF6297CFF75CB0_u64, 0x3FF0000000000000_u64, 0x3FEF6297CFF75CB0_u64, 0x3FED906BCF328D46_u64, 0x3FEA9B66290EA1A3_u64, 0x3FE6A09E667F3BCD_u64, 0x3FE1C73B39AE68C8_u64, 0x3FD87DE2A6AEA963_u64, 0x3FC8F8B83C69A60B_u64, 0x0000000000000000_u64, 0xBFC8F8B83C69A60B_u64, 0xBFD87DE2A6AEA963_u64, 0xBFE1C73B39AE68C8_u64, 0xBFE6A09E667F3BCD_u64, 0xBFEA9B66290EA1A3_u64, 0xBFED906BCF328D46_u64, 0xBFEF6297CFF75CB0_u64, 0xBFF0000000000000_u64, 0xBFEF6297CFF75CB0_u64, 0xBFED906BCF328D46_u64, 0xBFEA9B66290EA1A3_u64, 0xBFE6A09E667F3BCD_u64, 0xBFE1C73B39AE68C8_u64, 0xBFD87DE2A6AEA963_u64, 0xBFC8F8B83C69A60B_u64]

### Returns the sine of this value, interpreting it as radians, correctly rounded: the exact sine rounded
### to the nearest `B32` (ties to even), identical on every platform. ±infinity gives NaN, NaN maps to NaN
### and ±0 maps to itself.
### :returns: The correctly rounded sine.
routine B32.sin() -> B32
  var t = me.to_bits()
  var ax = t << 1
  if ax > 0x99000000_u32 or ax < 0x73000000_u32
    # |x| > 0x1p+26 or |x| < 0x1p-12
    if ax < 0x73000000_u32
      if ax < 0x66000000_u32
        # |x| < 0x1p-25
        if ax == 0_u32
          return me
        return LLVM::fma[B32](a: -me, b: me.abs(), c: me)
      return (-0x1.555556p-3_b32 *! me) *! (me *! me) +! me
    return b32_sin_big(x: me)
  var z0 = B64(from: me)
  var red = (0.0, 0_u64)
  if ax < 0x822D97C8_u32
    if ax == 0x7E75B8A2_u32 or ax == 0x7F4F0654_u32
      return b32_sin_database(x: me)
    red = b32_trig_reduce_small(x: z0)
  else
    if ax == 0x8C333330_u32
      return b32_sin_database(x: me)
    red = b32_trig_reduce_medium(x: z0)
  var z = red.item0
  var ia = red.item1
  var z2 = z *! z
  var z4 = z2 *! z2
  var aa = (0x1.921fb54442d17p-3 +! z2 *! -0x1.4abbce6256a39p-10) +! z4 *! (0x1.466bc5a518c16p-19 +! z2 *! -0x1.32bdc61074ff6p-29)
  var bb = (0x1.3bd3cc9be45dcp-6 +! z2 *! -0x1.03c1f081b0833p-14) +! z4 *! (0x1.55d3c6fc9ac1fp-24 +! z2 *! -0x1.e1d3ff281b40dp-35)
  var s0 = B64.from_bits(bits: B32_SIN_TB[ia & 31_u64])
  var c0 = B64.from_bits(bits: B32_SIN_TB[(ia +% 8_u64) & 31_u64])
  var r = (s0 +! aa *! (z *! c0)) -! bb *! (z2 *! s0)
  return B32(from: r)

### The sine of the four arguments whose fast path is not correctly rounded.
### :param x: One of the four exceptional arguments (either sign).
### :returns: The correctly rounded sine.
secret routine b32_sin_database(x: B32) -> B32
  var ax = x.to_bits() & 0x7FFFFFFF_u32
  var rh = -0x1.99bc5ap-26_b32
  var rl = -0x1p-51_b32
  if ax == 0x46199998_u32
    rh = -0x1.63f4bap-2_b32
    rl = -0x1p-27_b32
  if ax == 0x3F3ADC51_u32
    rh = 0x1.55688ap-1_b32
    rl = -0x1p-26_b32
  if ax == 0x3FA7832A_u32
    rh = 0x1.ee836cp-1_b32
    rl = -0x1p-26_b32
  var sgn = 1.0_b32.copysign(sign: x)
  return sgn *! rh +! sgn *! rl

### The sine for |x| > 2^26, infinity and NaN.
### :param x: The argument.
### :returns: The correctly rounded sine.
secret routine b32_sin_big(x: B32) -> B32
  var t = x.to_bits()
  var ax = t << 1
  if ax >= 0xFF000000_u32
    if ax << 8 != 0_u32
      return x +! x
    return B32.from_bits(bits: 0xFFC00000_u32)
  var red = b32_trig_reduce_big(u: t, bias: 147_u64)
  var z = red.item0
  var ia = red.item1
  var z2 = z *! z
  var z4 = z2 *! z2
  var aa = (0x1.921fb54442d17p-3 +! z2 *! -0x1.4abbce6256a39p-10) +! z4 *! (0x1.466bc5a518c16p-19 +! z2 *! -0x1.32bdc61074ff6p-29)
  var bb = (0x1.3bd3cc9be45dcp-6 +! z2 *! -0x1.03c1f081b0833p-14) +! z4 *! (0x1.55d3c6fc9ac1fp-24 +! z2 *! -0x1.e1d3ff281b40dp-35)
  var s0 = B64.from_bits(bits: B32_SIN_TB[ia & 31_u64])
  var c0 = B64.from_bits(bits: B32_SIN_TB[(ia +% 8_u64) & 31_u64])
  var r = s0 +! z *! (aa *! c0 -! bb *! (z *! s0))
  return B32(from: r)

### Reduces `x` (|x| < 0x1.2d97c8p+3 or so) modulo pi/16: `16/pi * x = q + z`, with a 53-bit 16/pi.
### :param x: The argument, exactly converted from B32.
### :returns: `(z, q)` with |z| <= 1/2; only the low bits of `q` are meaningful.
secret routine b32_trig_reduce_small(x: B64) -> (B64, U64)
  var idh = 0x1.45f306dc9c883p+2 *! x
  # adding 1.5*2^52 rounds idh to an integer (ties to even) and leaves it in the low mantissa bits
  var q = 0x1.8p52 +! idh
  var id = q -! 0x1.8p52
  return (idh -! id, q.to_bits())

### Reduces `x` (|x| < 2^28) modulo pi/16 with a two-part 16/pi.
### :param x: The argument, exactly converted from B32.
### :returns: `(z, q)` with |z| <= 1/2; only the low bits of `q` are meaningful.
secret routine b32_trig_reduce_medium(x: B64) -> (B64, U64)
  var idl = -0x1.b1bbead603d8bp-29 *! x
  var idh = 0x1.45f306ep+2 *! x
  var q = 0x1.8p52 +! idh
  var id = q -! 0x1.8p52
  return ((idh -! id) +! idl, q.to_bits())

### Reduces a large finite B32 (|x| > 2^26) modulo pi/2^k with a 256-bit 2/pi (Payne-Hanek).
### :param u: The argument's bit pattern.
### :param bias: 147 to reduce modulo pi/16 (sine, cosine), 150 to reduce modulo pi/2 (tangent).
### :returns: `(z, q)` with |z| <= 1/2 (z in units of the reduction step); only the low bits of `q` matter.
secret routine b32_trig_reduce_big(u: U32, bias: U64) -> (B64, U64)
  var e = LLVM::zero_extend[U32, U64]((u >>> 23) & 0xFF_u32)
  var m = LLVM::zero_extend[U64, U128](LLVM::zero_extend[U32, U64]((u & 0x7FFFFF_u32) | 0x800000_u32))
  var p0 = m *% LLVM::zero_extend[U64, U128](0xFE5163ABDEBBC562_u64)
  var p1 = m *% LLVM::zero_extend[U64, U128](0xDB6295993C439041_u64)
  p1 = p1 +% (p0 >>> 64)
  var p2 = m *% LLVM::zero_extend[U64, U128](0xFC2757D1F534DDC0_u64)
  p2 = p2 +% (p1 >>> 64)
  var p3 = m *% LLVM::zero_extend[U64, U128](0xA2F9836E4E441529_u64)
  p3 = p3 +% (p2 >>> 64)
  var p3h = LLVM::int_truncate[U128, U64](p3 >>> 64)
  var p3l = LLVM::int_truncate[U128, U64](p3)
  var p2l = LLVM::int_truncate[U128, U64](p2)
  var p1l = LLVM::int_truncate[U128, U64](p1)
  # e >= 153 here, so s = e - bias >= 3
  var s = e - bias
  var i = p3l
  var a = p2l
  if s < 64_u64
    var sl = LLVM::int_truncate[U64, U32](s)
    var sr = LLVM::int_truncate[U64, U32](64_u64 - s)
    i = (p3h << sl) | (p3l >>> sr)
    a = (p3l << sl) | (p2l >>> sr)
  if s > 64_u64
    var sl = LLVM::int_truncate[U64, U32](s - 64_u64)
    var sr = LLVM::int_truncate[U64, U32](128_u64 - s)
    i = (p3l << sl) | (p2l >>> sr)
    a = (p2l << sl) | (p1l >>> sr)
  # sgn is all ones for a negative argument, else 0
  var sgn = 0_u64
  if u >>> 31 == 1_u32
    sgn = U64_MAX
  # sm is all ones when the fraction a is negative (rounds the quotient up)
  if a >>> 63 == 1_u64
    i = i +% 1_u64
  var z = LLVM::signed_to_float[S64, B64](LLVM::reinterpret_bits[U64, S64](a ^ sgn)) *! 0x1p-64
  i = (i ^ sgn) -% sgn
  return (z, i)
