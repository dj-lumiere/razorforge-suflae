module Core

# ============================================================================
# Correctly rounded inverse hyperbolic tangent of B16
# ============================================================================
# Ported from CORE-MATH, src/binary16/atanh/atanhf16.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2025 Paul Zimmermann. Distributed under the MIT license: see LICENSE-CORE-MATH next
# to this file. RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the original
# is kept. Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats.

### Inverse hyperbolic tangent with raw IEEE 754 propagation, correctly rounded: the exact atanh rounded to
### the nearest `B16` (ties to even), identical on every platform. `±1` gives ±infinity, `|x| > 1` gives
### NaN.
### :returns: The correctly rounded inverse hyperbolic tangent.
routine B16.atanh_unchecked() -> B16
  var v = B32(from: me)
  var u = v.to_bits()
  var au = u & 0x7FFFFFFF_u32
  if au >= 0x3F800000_u32
    # |x| = 1 is a pole, NaN gives x + x (quiets a signaling NaN), and |x| > 1 has no real result (the
    # default NaN of x86)
    if au == 0x3F800000_u32
      return if au == u then B16.from_bits(bits: 0x7C00_u16) else B16.from_bits(bits: 0xFC00_u16)
    if au > 0x7F800000_u32
      return me +! me
    return B16.from_bits(bits: 0xFE00_u16)
  var t = v
  # atanh(-x) = -atanh(x)
  var s = 1.0_b32
  if u >>> 31 == 1
    s = -1.0_b32
  if au >= 0x3F000000_u32
    # |x| >= 1/2: every binary16 input has its own table entry
    var i = LLVM::zero_extend[U32, U64]((au -% 0x3F000000_u32) >>> 13)
    return B16(from: s *! B32.from_bits(bits: B16_ATANH_T1[i]))
  # for |x| <= 0x1.d1p-6, atanh(x) rounds to x
  if au <= 0x3CE88000_u32
    if au == 0
      return me
    return B16(from: LLVM::fma[B32](a: t, b: 0x1p-12_b32, c: t))
  # the one input the polynomial rounds wrongly (|x| = 0x1.4fp-4)
  if au == 0x3DA78000_u32
    return B16(from: s *! 0x1.4fbffep-4_b32)
  # an odd degree-11 polynomial approximating atanh(x) on [0, 1/2]
  var tt = t *! t
  var c9 = LLVM::fma[B32](a: 0x1.43b244p-3_b32, b: tt, c: 0x1.871ffp-4_b32)
  var c5 = LLVM::fma[B32](a: 0x1.2785fcp-3_b32, b: tt, c: 0x1.997ceep-3_b32)
  var c1 = LLVM::fma[B32](a: 0x1.55558ep-2_b32, b: tt, c: 0x1.000004p+0_b32)
  c5 = LLVM::fma[B32](a: c9, b: tt *! tt, c: c5)
  c1 = LLVM::fma[B32](a: c5, b: tt *! tt, c: c1)
  return B16(from: t *! c1)

# atanh(1/2 + i/2^11) rounded to binary32 (bit patterns), for 0 <= i < 2^10.
