# ============================================================================
# Correctly rounded tan(pi*x) of B64
# ============================================================================
# Ported from CORE-MATH, src/binary64/tanpi/tanpi.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2023-2025 Alexei Sibidanov.
# Distributed under the MIT license: see LICENSE-CORE-MATH next to this file. RazorForge has no dynamic
# rounding modes, so only the round-to-nearest path of the original is kept (its errno handling and forced
# underflow are dropped). The double-double helpers shared with sinpi and cospi live in B64TrigPi.rf.
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats.

# tan(pi*i/64) for i in 0..31 as (low, high) pairs, as IEEE 754 bit patterns.
secret preset B64_TANPI_T: Array[U64, 64] = [0x0000000000000000_u64, 0x0000000000000000_u64, 0x3BFADA13CEEBAB9D_u64, 0x3FA927278A3B1162_u64, 0x3C587D054F689D7A_u64, 0x3FB936BB8C5B2DA2_u64, 0x3C52CFB5A746F62C_u64, 0x3FC2FCAC73A60640_u64, 0x3C2EF5D367441946_u64, 0x3FC975F5E0553158_u64, 0x3C65A6D6C3C8B6A7_u64, 0x3FD007FA758626AE_u64, 0xBC6D704D1BFDB6E8_u64, 0x3FD36A08355C63DC_u64, 0x3C678E945DC3913C_u64, 0x3FD6E649F7D78649_u64, 0x3C708B2FB1366EA9_u64, 0x3FDA827999FCEF32_u64, 0x3C741522F15E53C5_u64, 0x3FDE450E0D273E7A_u64, 0xBC8E564BCD1E635D_u64, 0x3FE11AB7190834EC_u64, 0xBC810B4421E6A4F8_u64, 0x3FE32E1889047FFD_u64, 0x3C87A8C52172B675_u64, 0x3FE561B82AB7F990_u64, 0xBC8AA7538E44E996_u64, 0x3FE7BB99ED2990CF_u64, 0xBC7A6DB80FE796FE_u64, 0x3FEA43002AE42850_u64, 0x3C78DCAD85E60FBE_u64, 0x3FED00CBC7384D2E_u64, 0x0000000000000000_u64, 0x3FF0000000000000_u64, 0x3C9946CC0B66979F_u64, 0x3FF1A73D55278C4B_u64, 0xBC787E5AD9735569_u64, 0x3FF37EFD8D87607E_u64, 0x3C86A085E3BC3AF6_u64, 0x3FF592D11142FA55_u64, 0x3C9419FA6954928F_u64, 0x3FF7F218E25A7461_u64, 0xBC7B6FB77846D763_u64, 0x3FFAB1C35D8A74EA_u64, 0x3C80FB3E75C7098E_u64, 0x3FFDEF13B73C1406_u64, 0x3C97CE6CB463C972_u64, 0x4000EA21D716FBF7_u64, 0x3CA21165F626CDD5_u64, 0x4003504F333F9DE6_u64, 0x3C7ACA947BFB1DCC_u64, 0x40065BC6CC825147_u64, 0xBC9B7A14D0D691BE_u64, 0x400A5F59E90600DD_u64, 0xBC889FCD637FBF3B_u64, 0x400FF01305ECD8DC_u64, 0x3C810706FED37F0E_u64, 0x40141BFEE2424771_u64, 0xBCAAE397239C5A0D_u64, 0x401AF73F4CA3310F_u64, 0x3CC351DAEA79411D_u64, 0x40244E6C595AFDCC_u64, 0xBC7B6E6B4DE0CD24_u64, 0x40345AFFED201B55_u64]
