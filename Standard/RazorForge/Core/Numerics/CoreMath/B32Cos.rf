module Core

# ============================================================================
# Correctly rounded cosine of B32
# ============================================================================
# Ported from CORE-MATH, src/binary32/cos/cosf.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2022-2025 Alexei Sibidanov. Distributed under the MIT license: see LICENSE-CORE-MATH next
# to this file. RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the original
# is kept (its errno handling is dropped). Arithmetic uses the unchecked operators `+! -! *! /!`, which are
# raw IEEE 754 on floats.
# The argument reductions and the `sin(i*pi/16)` table come from B32Sin.rf: the original's cosine table
# is the sine table shifted by 8 entries.

### Returns the cosine of this value, interpreting it as radians, correctly rounded: the exact cosine
### rounded to the nearest `B32` (ties to even), identical on every platform. ±infinity gives NaN and NaN
### maps to NaN.
### :returns: The correctly rounded cosine.
routine B32.cos() -> B32
  var t = me.to_bits()
  var ax = t << 1
  if ax > 0x99000000_u32 or ax < 0x74000000_u32
    # |x| > 0x1p+26 or |x| < 0x1p-11
    if ax < 0x74000000_u32
      # cos(x) rounds like 1 - x^2/2 here
      return 0.5_b32 *! LLVM::fma[B32](a: me, b: -me, c: 2.0_b32)
    return b32_cos_big(x: me)
  var z0 = B64(from: me)
  var red = (0.0, 0_u64)
  if ax < 0x82A41896_u32
    if ax == 0x812D97C8_u32
      return b32_cos_database(x: me, r: 0.0)
    red = b32_trig_reduce_small(x: z0)
  else
    red = b32_trig_reduce_medium(x: z0)
  var z = red.item0
  var ia = red.item1
  var z2 = z *! z
  var z4 = z2 *! z2
  var aa = (0x1.921fb54442d17p-3 +! z2 *! -0x1.4abbce6256a39p-10) +! z4 *! (0x1.466bc5a518c16p-19 +! z2 *! -0x1.32bdc61074ff6p-29)
  var bb = (0x1.3bd3cc9be45dcp-6 +! z2 *! -0x1.03c1f081b0833p-14) +! z4 *! (0x1.55d3c6fc9ac1fp-24 +! z2 *! -0x1.e1d3ff281b40dp-35)
  var c0 = B64.from_bits(bits: B32_SIN_TB[(ia +% 8_u64) & 31_u64])
  var s0 = B64.from_bits(bits: B32_SIN_TB[(ia +% 16_u64) & 31_u64])
  var r = (c0 +! aa *! (z *! s0)) -! bb *! (z2 *! c0)
  return B32(from: r)

### The cosine of the arguments whose fast path is not correctly rounded.
### :param x: The argument.
### :param r: The fast-path result, returned when `x` is not exceptional.
### :returns: The correctly rounded cosine.
secret routine b32_cos_database(x: B32, r: B64) -> B32
  var ax = x.to_bits() & 0x7FFFFFFF_u32
  if ax == 0x4096CBE4_u32
    return 0x1.99bc5cp-27_b32 +! -0x1p-52_b32
  if ax == 0x5922AA80_u32
    return 0x1.115d7ep-1_b32 +! -0x1p-26_b32
  if ax == 0x5AA4542C_u32
    return 0x1.f48148p-2_b32 +! 0x1p-27_b32
  if ax == 0x5F18B878_u32
    return 0x1.fe2976p-1_b32 +! 0x1p-26_b32
  if ax == 0x6115CB11_u32
    return 0x1.f0285ep-1_b32 +! -0x1p-26_b32
  return B32(from: r)

### The cosine for |x| > 2^26, infinity and NaN.
### :param x: The argument.
### :returns: The correctly rounded cosine.
secret routine b32_cos_big(x: B32) -> B32
  var t = x.to_bits()
  var ax = t << 1
  if ax >= 0xFF000000_u32
    if ax << 8 != 0_u32
      return x +! x
    return B32.from_bits(bits: 0xFFC00000_u32)
  var red = b32_trig_reduce_big(u: t, bias: 147_u64)
  var z = red.item0
  var ia = red.item1
  var z2 = z *! z
  var z4 = z2 *! z2
  var aa = (0x1.921fb54442d17p-3 +! z2 *! -0x1.4abbce6256a39p-10) +! z4 *! (0x1.466bc5a518c16p-19 +! z2 *! -0x1.32bdc61074ff6p-29)
  var bb = (0x1.3bd3cc9be45dcp-6 +! z2 *! -0x1.03c1f081b0833p-14) +! z4 *! (0x1.55d3c6fc9ac1fp-24 +! z2 *! -0x1.e1d3ff281b40dp-35)
  var s0 = B64.from_bits(bits: B32_SIN_TB[(ia +% 16_u64) & 31_u64])
  var c0 = B64.from_bits(bits: B32_SIN_TB[(ia +% 8_u64) & 31_u64])
  var r = c0 +! z *! (aa *! s0 -! bb *! (z *! c0))
  # the result is close to a rounding boundary only for a few known arguments
  var tail = (r.to_bits() +% 6_u64) & 0xFFFFFFF_u64
  if tail <= 12_u64
    return b32_cos_database(x: x, r: r)
  return B32(from: r)
