module Core

# ============================================================================
# Correctly rounded base-10 exponential 10^x of B128
# ============================================================================
# Ported from CORE-MATH, src/binary128/exp10/exp10q.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2025 Alexei Sibidanov <sibid@uvic.ca>
# Distributed under the MIT license: see LICENSE-CORE-MATH next to this file. RazorForge has no dynamic
# rounding modes, so only the round-to-nearest path of the original is kept (its rounding-mode probe,
# exception-flag and errno handling are dropped).
# The work is done on 64-bit words. The tables, the 2^x evaluation and the fallback paths are shared with
# the exp and exp2 ports (B128ExpShared.rf).

### Returns 10 raised to this value, correctly rounded: the exact power rounded to the nearest `B128`
### (ties to even), identical on every platform, exact for x = 1, 2, ..., 48, with raw IEEE 754
### propagation (overflow -> +infinity, `exp10(-infinity) == 0`, NaN -> quiet NaN). No crash.
### :returns: The correctly rounded power of ten, possibly +infinity.
routine B128.exp10_unchecked() -> B128
  var u = me.to_bits()
  var hi = b128_expfam_hi(u: u)
  var lo = b128_expfam_lo(u: u)
  var b1 = hi & 0x7FFFFFFFFFFFFFFF_u64
  # |x| tiny: 10^x rounds to 1
  if b1 < 0x3F8BBCB7B1526E50_u64
    return B128.from_bits(bits: 0x3FFF0000000000000000000000000000_u128)
  if b1 >= 0x400B34413509F79F_u64
    # infinity: 10^+inf = +inf, 10^-inf = +0
    if b1 == 0x7FFF000000000000_u64 and lo == 0
      if hi >>> 63 == 0
        return me
      return B128.from_bits(bits: 0_u128)
    # NaN: quiet it, keeping sign and payload
    if b1 >= 0x7FFF000000000000_u64
      return B128.from_bits(bits: u | (1_u128 << 111))
    # x >= 0x1.34413509f79fef311f12b35816fap+12: overflow
    if hi >>> 63 == 0 and u >= 0x400B34413509F79FEF311F12B35816FA_u128
      return B128.from_bits(bits: 0x7FFF0000000000000000000000000000_u128)
    # x <= -0x1.3657d621f4e96893f84497c723c1p+12: underflow to +0
    if u >= 0xC00B3657D621F4E96893F84497C723C1_u128
      return B128.from_bits(bits: 0_u128)
  # x*log2(10) in fixed point: 3 words, the integer part above the 20 low bits of the top word
  var sm = b128_expfam_sar(v: hi, n: 63_u64)
  var mh = (hi & 0x0000FFFFFFFFFFFF_u64) | 0x0001000000000000_u64
  var fs = b128_expfam_mh3x2(a0: B128_EXPFAM_ILN102[4], a1: B128_EXPFAM_ILN102[5], a2: B128_EXPFAM_ILN102[6], b: b128_expfam_w(hi: mh, lo: lo))
  var e = (hi >>> 48) & 0x7FFF_u64
  var r = b128_expfam_ars3(w0: fs.item0 ^ sm, w1: fs.item1 ^ sm, w2: fs.item2 ^ sm, n: 0x4019_u64 -% e)
  # x = 1, 2, ..., 48: the result is exact
  if sm == 0 and lo == 0 and e >= 16383 and b128_expfam_shl(v: hi, n: e - 16367) == 0
    var k = b128_expfam_shr(v: mh, n: 16431_u64 - e)
    if k <= 48
      return b128_exp10_exact(k: k)
  return b128_expfam_finish(fs0: r.item0, fs1: r.item1, fs2: r.item2, x0: u, kind: 2_u64)

### 10^k for an integer k in 1..48, exact: 5^k fits 112 bits and is normalized, then scaled by 2^k.
secret routine b128_exp10_exact(k: U64) -> B128
  var p = 1_u128
  var i = 0_u64
  while i < k
    p = p *% 5_u128
    i = i + 1
  var nz = LLVM::int_truncate[U128, U64](p.leading_zeros())
  p = p << LLVM::int_truncate[U64, U32](nz - 15)
  return B128.from_bits(bits: p +% b128_expfam_w(hi: (16509_u64 - nz + k) << 48, lo: 0_u64))
