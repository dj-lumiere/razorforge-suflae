# src/binary64/atanh/atanh.c (https://core-math.gitlabpages.inria.fr/), which carry identical copies of
# these tables.
# Copyright (c) 2023-2025 Alexei Sibidanov <sibid@uvic.ca>.
# Copyright (c) 2023 Alexei Sibidanov.
# Distributed under the MIT license: see LICENSE-CORE-MATH next to this file. Floating-point entries are
# stored as their IEEE 754 bit patterns and read with `B64.from_bits`.

# Coefficients of a piecewise linear approximation of log2 on [1, 2], used to pick the reduction index:
# c0 (unsigned 16-bit in the original) and c1 (signed 16-bit), for each of 32 subintervals.
