module Core

# ============================================================================
# Shared kernel of the correctly rounded arc tangent (atan, atan2) of B128
# ============================================================================
# Ported from CORE-MATH, src/binary128/atan/atanq.c and src/binary128/atan2/atan2q.c
# (https://core-math.gitlabpages.inria.fr/). The two files carry identical integer helpers, tables and
# evaluation kernels; they live here once and B128Atan.rf / B128Atan2.rf keep only their own argument
# reduction and final reconstruction.
# Copyright (c) 2026 Alexei Sibidanov <sibid@uvic.ca>
# Distributed under the MIT license: see LICENSE-CORE-MATH next to this file. RazorForge has no dynamic
# rounding modes, so only the round-to-nearest path of the original is kept (its rounding-mode probe,
# errno and exception-flag handling are dropped).
#
# Everything runs on integers: the reduced argument is a 128-bit fixed-point fraction, the fast path
# evaluates the arc tangent series in 128-bit words and the accurate path in up to 8 64-bit limbs held in
# an `Array[U64, 8]` (limb 0 least significant) together with an explicit limb count.

# --- word helpers -----------------------------------------------------------------------------------

@inline
secret routine b128_atanfam_lo(v: U128) -> U64
  return LLVM::int_truncate[U128, U64](v)

@inline
secret routine b128_atanfam_hi(v: U128) -> U64
  return LLVM::int_truncate[U128, U64](v >>> 64)

@inline
secret routine b128_atanfam_mk(hi: U64, lo: U64) -> U128
  return (LLVM::zero_extend[U64, U128](hi) << 64) | LLVM::zero_extend[U64, U128](lo)

# full 64x64 -> 128-bit product
@inline
secret routine b128_atanfam_mul(a: U64, b: U64) -> U128
  return LLVM::zero_extend[U64, U128](a) *% LLVM::zero_extend[U64, U128](b)

# a non-negative shift amount as the U32 the shift operators take
@inline
secret routine b128_atanfam_sa(n: S64) -> U32
  return LLVM::int_truncate[S64, U32](n)

# leading zero count of a 64-bit word as a signed int (64 for zero)
@inline
secret routine b128_atanfam_clz(v: U64) -> S64
  return LLVM::reinterpret_bits[U64, S64](LLVM::leading_zeros(v))

# high 64 bits of the 64x64 product
@inline
secret routine b128_atanfam_mhuu(a: U64, b: U64) -> U64
  return b128_atanfam_hi(v: b128_atanfam_mul(a: a, b: b))

# high 128 bits of the 64x128 product
@inline
secret routine b128_atanfam_mhuu128(y: U64, x: U128) -> U128
  var xy0 = b128_atanfam_mul(a: b128_atanfam_lo(v: x), b: y)
  var xy1 = b128_atanfam_mul(a: b128_atanfam_hi(v: x), b: y)
  return xy1 +% (xy0 >>> 64)

# approximate high 128 bits of the square of a 128-bit word
@inline
secret routine b128_atanfam_sqrh(a: U128) -> U128
  var a1 = b128_atanfam_hi(v: a)
  var a10 = b128_atanfam_mul(a: a1, b: b128_atanfam_lo(v: a))
  var a11 = b128_atanfam_mul(a: a1, b: a1)
  a11 = a11 +% (a10 >>> 64)
  a11 = a11 +% (a10 >>> 64)
  return a11

# approximate high 128 bits of the 128x128 product
@inline
secret routine b128_atanfam_mhuu256(a: U128, b: U128) -> U128
  var a0 = b128_atanfam_lo(v: a)
  var a1 = b128_atanfam_hi(v: a)
  var b0 = b128_atanfam_lo(v: b)
  var b1 = b128_atanfam_hi(v: b)
  var a1b0 = b128_atanfam_mul(a: a1, b: b0)
  var a0b1 = b128_atanfam_mul(a: a0, b: b1)
  var a1b1 = b128_atanfam_mul(a: a1, b: b1)
  a1b1 = a1b1 +% (a1b0 >>> 64)
  a1b1 = a1b1 +% (a0b1 >>> 64)
  return a1b1

# 2^255 / kd rounded to 128 bits for a normalized kd (top bit set): one Newton step on a 64-bit quotient
@inline
secret routine b128_atanfam_reciprocal(kd: U128) -> U128
  var kdh = kd >>> 64
  var kdl = kd & 0xFFFFFFFFFFFFFFFF_u128
  # r = 2^127 / kdh truncated to 64 bits (all ones when the quotient is 2^64), a single 128/64 divide
  var d = LLVM::int_truncate[U128, U64](kdh)
  var r = 0xFFFFFFFFFFFFFFFF_u64
  if d != 0x8000000000000000_u64
    r = div2by1(u1: 0x8000000000000000_u64, u0: 0_u64, d: d, v: reciprocal_word(d: d)).q
  var rr = LLVM::zero_extend[U64, U128](r)
  var hh = kdh *% rr
  var hl = kdl *% rr
  hh = hh +% (hl >>> 64)
  hh = hh << 57
  hh = hh | LLVM::zero_extend[U64, U128](b128_atanfam_lo(v: hl) >>> 7)
  var hh64 = LLVM::int_truncate[S128, S64](LLVM::reinterpret_bits[U128, S128](hh) >> 92)
  var corr = 0_u128
  if hh64 < 0
    corr = rr << 64
  var dr = b128_atanfam_mhuu128(y: r, x: hh) -% corr
  var drs = LLVM::reinterpret_bits[U128, S128](dr) >> 56
  return (rr << 64) -% LLVM::reinterpret_bits[S128, U128](drs)

# class of a sign-stripped binary128: 0 ordinary number, 1 infinity, 2 signaling NaN, 3 quiet NaN
@inline
secret routine b128_atanfam_class(xh: U64, xl: U64) -> U64
  var t = xh >>> 32
  if ((xh << 32) | xl) != 0
    t = t | 1_u64
  var c = 0_u64
  if t >= 0x7FFF0000_u64
    c = c +% 1
  if t >= 0x7FFF0001_u64
    c = c +% 1
  if t >= 0x7FFF8000_u64
    c = c +% 1
  return c

# --- fast path: arc tangent series in 128-bit words ----------------------------------------------------

# kn / kd is the reduced argument scaled by 2^-dn (kd normalized); returns the 128-bit fixed-point
# atan(kn/kd * 2^-dn) * 2^dn before the table angle is added
@inline
secret routine b128_atanfam_fast_core(kn: U128, kd: U128, dn: S64) -> U128
  var rcp = b128_atanfam_reciprocal(kd: kd)
  var t = b128_atanfam_mhuu256(a: kn, b: rcp)
  var t2 = b128_atanfam_sqrh(a: t)
  var dn2 = 2 *% dn -% 12
  if dn2 < 128
    t2 = t2 >>> b128_atanfam_sa(n: dn2)
  else
    t2 = 0_u128
  var t2h = b128_atanfam_hi(v: t2)
  var fl = B128_ATANFAM_C[16]
  fl = B128_ATANFAM_C[14] -% b128_atanfam_mhuu(a: t2h, b: fl)
  fl = B128_ATANFAM_C[12] -% b128_atanfam_mhuu(a: t2h, b: fl)
  var f = b128_atanfam_mk(hi: B128_ATANFAM_C[11], lo: B128_ATANFAM_C[10] -% t2h -% b128_atanfam_mhuu(a: t2h, b: fl))
  var i = 4_u64
  while i >= 1
    var ci = b128_atanfam_mk(hi: B128_ATANFAM_C[2 *% i +% 1], lo: B128_ATANFAM_C[2 *% i])
    f = ci -% b128_atanfam_mhuu256(a: t2, b: f)
    i = i -% 1
  f = b128_atanfam_mhuu256(a: t2, b: f)
  f = b128_atanfam_mhuu256(a: t, b: f)
  return t -% f

# --- accurate path: multi-limb arithmetic on Array[U64, 8] -----------------------------------------------

# a + v * 2^(64*pos), modulo 2^(64*n)
@inline
secret routine b128_atanfam_addat(a: Array[U64, 8], pos: U64, v: U128, n: U64) -> Array[U64, 8]
  var o = a
  var c = v
  var q = pos
  while q < n and c != 0
    var s = LLVM::zero_extend[U64, U128](o[q]) +% (c & 0xFFFFFFFFFFFFFFFF_u128)
    o[q] = LLVM::int_truncate[U128, U64](s)
    c = (c >>> 64) +% (s >>> 64)
    q = q +% 1
  return o

# a + b modulo 2^(64*n)
secret routine b128_atanfam_add(a: Array[U64, 8], b: Array[U64, 8], n: U64) -> Array[U64, 8]
  var o = a
  var c = 0_u128
  var i = 0_u64
  while i < n
    var s = LLVM::zero_extend[U64, U128](a[i]) +% LLVM::zero_extend[U64, U128](b[i]) +% c
    o[i] = LLVM::int_truncate[U128, U64](s)
    c = s >>> 64
    i = i +% 1
  return o

# a - b modulo 2^(64*n)
secret routine b128_atanfam_sub(a: Array[U64, 8], b: Array[U64, 8], n: U64) -> Array[U64, 8]
  var o = a
  var c = 0_u128
  var i = 0_u64
  while i < n
    var s = LLVM::zero_extend[U64, U128](a[i]) -% LLVM::zero_extend[U64, U128](b[i]) -% c
    o[i] = LLVM::int_truncate[U128, U64](s)
    c = (s >>> 64) & 1_u128
    i = i +% 1
  return o

# exact product of the na-limb a and the nb-limb b (na + nb limbs)
secret routine b128_atanfam_mulfull(a: Array[U64, 8], na: U64, b: Array[U64, 8], nb: U64) -> Array[U64, 8]
  var o = Array[U64, 8]()
  var n = na +% nb
  var j = 0_u64
  while j < nb
    var i = 0_u64
    while i < na
      o = b128_atanfam_addat(a: o, pos: i +% j, v: b128_atanfam_mul(a: a[i], b: b[j]), n: n)
      i = i +% 1
    j = j +% 1
  return o

# approximate high n limbs of the product of the n-limb numbers b[bo..] and a[ao..]: the partial products of
# column n-1 contribute their high words, the columns above contribute in full, modulo 2^(64*n)
# (the mhu2u2u2 .. mhu6u6u6 and sqrhu6 helpers of the original)
secret routine b128_atanfam_mh(b: Array[U64, 8], bo: U64, a: Array[U64, 8], ao: U64, n: U64) -> Array[U64, 8]
  var o = Array[U64, 8]()
  var j = 0_u64
  while j < n
    var i = 0_u64
    while i < n
      var s = i +% j
      if s +% 1 >= n
        var p = b128_atanfam_mul(a: a[ao +% i], b: b[bo +% j])
        if s +% 1 == n
          o = b128_atanfam_addat(a: o, pos: 0_u64, v: p >>> 64, n: n)
        else
          o = b128_atanfam_addat(a: o, pos: s -% n, v: p, n: n)
      i = i +% 1
    j = j +% 1
  return o

# logical left shift of the n-limb a by k >= 0 bits
secret routine b128_atanfam_shl_pos(a: Array[U64, 8], n: U64, k: S64) -> Array[U64, 8]
  var o = a
  var off = k >> 6
  var dst = LLVM::reinterpret_bits[U64, S64](n) -% 1
  var src = dst -% off
  if src >= 0
    var s = b128_atanfam_sa(n: k & 63)
    var q = b128_atanfam_sa(n: (k ^ -1) & 63)
    var c = o[LLVM::reinterpret_bits[S64, U64](src)]
    src = src -% 1
    while src >= 0
      var nt = o[LLVM::reinterpret_bits[S64, U64](src)]
      src = src -% 1
      o[LLVM::reinterpret_bits[S64, U64](dst)] = (c << s) | ((nt >>> 1) >>> q)
      dst = dst -% 1
      c = nt
    o[LLVM::reinterpret_bits[S64, U64](dst)] = c << s
    dst = dst -% 1
  while dst >= 0
    o[LLVM::reinterpret_bits[S64, U64](dst)] = 0_u64
    dst = dst -% 1
  return o

# logical right shift of the n-limb a by k >= 0 bits
secret routine b128_atanfam_shr_pos(a: Array[U64, 8], n: U64, k: S64) -> Array[U64, 8]
  var o = a
  var off = LLVM::reinterpret_bits[S64, U64](k >> 6)
  var src = off
  var dst = 0_u64
  if src < n
    var c = o[src]
    src = src +% 1
    var s = k & 63
    if s != 0
      var su = b128_atanfam_sa(n: s)
      var q = b128_atanfam_sa(n: (0 -% k) & 63)
      while src < n
        var nt = o[src]
        src = src +% 1
        o[dst] = (c >>> su) | (nt << q)
        dst = dst +% 1
        c = nt
      o[dst] = c >>> su
      dst = dst +% 1
    else
      while src < n
        var nt = o[src]
        src = src +% 1
        o[dst] = c
        dst = dst +% 1
        c = nt
      o[dst] = c
      dst = dst +% 1
  while dst < n
    o[dst] = 0_u64
    dst = dst +% 1
  return o

# shift left by k bits (right by -k when k < 0)
secret routine b128_atanfam_shl(a: Array[U64, 8], n: U64, k: S64) -> Array[U64, 8]
  if k < 0
    return b128_atanfam_shr_pos(a: a, n: n, k: 0 -% k)
  return b128_atanfam_shl_pos(a: a, n: n, k: k)

# logical shift right by k bits (left by -k when k < 0)
secret routine b128_atanfam_shr(a: Array[U64, 8], n: U64, k: S64) -> Array[U64, 8]
  if k < 0
    return b128_atanfam_shl_pos(a: a, n: n, k: 0 -% k)
  return b128_atanfam_shr_pos(a: a, n: n, k: k)

# arithmetic shift right by k bits (left by -k when k < 0)
secret routine b128_atanfam_sar(a: Array[U64, 8], n: U64, k: S64) -> Array[U64, 8]
  if k < 0
    return b128_atanfam_shl_pos(a: a, n: n, k: 0 -% k)
  var o = a
  var off = LLVM::reinterpret_bits[S64, U64](k >> 6)
  var src = off
  var dst = 0_u64
  var c = 0_s64
  if src < n
    var s = b128_atanfam_sa(n: k & 63)
    var q = b128_atanfam_sa(n: (k ^ -1) & 63)
    c = LLVM::reinterpret_bits[U64, S64](o[src])
    src = src +% 1
    while src < n
      var nt = o[src]
      src = src +% 1
      o[dst] = (LLVM::reinterpret_bits[S64, U64](c) >>> s) | ((nt << 1) << q)
      dst = dst +% 1
      c = LLVM::reinterpret_bits[U64, S64](nt)
    o[dst] = LLVM::reinterpret_bits[S64, U64](c >> s)
    dst = dst +% 1
  else
    c = LLVM::reinterpret_bits[U64, S64](o[n -% 1])
  var fill = LLVM::reinterpret_bits[S64, U64](c >> 63)
  while dst < n
    o[dst] = fill
    dst = dst +% 1
  return o

# f = CP[ck..ck+n-1] - f, modulo 2^(64*n)
secret routine b128_atanfam_cpsub(ck: U64, f: Array[U64, 8], n: U64) -> Array[U64, 8]
  var c = Array[U64, 8]()
  var i = 0_u64
  while i < n
    c[i] = B128_ATANFAM_CP[ck +% i]
    i = i +% 1
  return b128_atanfam_sub(a: c, b: f, n: n)

# kn / (kd2:kd1:kd0) is the reduced argument scaled by 2^-dn; returns the 6-limb fixed-point
# atan(kn/kd * 2^-dn) * 2^dn before the table angle is added
secret routine b128_atanfam_accurate_core(kn: U128, kd0: U64, kd1: U64, kd2: U64, dn: S64) -> Array[U64, 8]
  var rcp = b128_atanfam_reciprocal(kd: b128_atanfam_mk(hi: kd2, lo: kd1))
  var r = Array[U64, 8]()
  r[4] = b128_atanfam_lo(v: rcp)
  r[5] = b128_atanfam_hi(v: rcp)
  var r4 = Array[U64, 8]()
  r4[0] = r[4]
  r4[1] = r[5]
  var kd = Array[U64, 8]()
  kd[0] = kd0
  kd[1] = kd1
  kd[2] = kd2
  var h = b128_atanfam_mulfull(a: r4, na: 2_u64, b: kd, nb: 3_u64)
  # signed square of the 3-limb sH = H >> 58
  var sh = Array[U64, 8]()
  sh[0] = (h[0] >>> 58) | (h[1] << 6)
  sh[1] = (h[1] >>> 58) | (h[2] << 6)
  sh[2] = (h[2] >>> 58) | (h[3] << 6)
  var h2 = b128_atanfam_mulfull(a: sh, na: 3_u64, b: sh, nb: 3_u64)
  if (sh[2] >>> 63) != 0
    var tw = Array[U64, 8]()
    tw[3] = sh[0] << 1
    tw[4] = (sh[1] << 1) | (sh[0] >>> 63)
    tw[5] = (sh[2] << 1) | (sh[1] >>> 63)
    h2 = b128_atanfam_sub(a: h2, b: tw, n: 6_u64)
  h = b128_atanfam_shl(a: h, n: 5_u64, k: 75)
  var hs = Array[U64, 8]()
  hs[0] = h2[2]
  hs[1] = h2[3]
  hs[2] = h2[4]
  h = b128_atanfam_sub(a: h, b: hs, n: 5_u64)
  var dr = b128_atanfam_mulfull(a: h, na: 5_u64, b: r4, nb: 2_u64)
  if (h[4] >>> 63) != 0
    var rc = Array[U64, 8]()
    rc[5] = r[4]
    rc[6] = r[5]
    dr = b128_atanfam_sub(a: dr, b: rc, n: 7_u64)
  dr = b128_atanfam_sar(a: dr, n: 7_u64, k: 10)
  var ds = Array[U64, 8]()
  ds[0] = dr[2]
  ds[1] = dr[3]
  ds[2] = dr[4]
  ds[3] = dr[5]
  ds[4] = dr[6]
  ds[5] = LLVM::reinterpret_bits[S64, U64](LLVM::reinterpret_bits[U64, S64](dr[6]) >> 63)
  r = b128_atanfam_sub(a: r, b: ds, n: 6_u64)
  var nn = Array[U64, 8]()
  nn[0] = b128_atanfam_lo(v: kn)
  nn[1] = b128_atanfam_hi(v: kn)
  var t = b128_atanfam_mulfull(a: r, na: 6_u64, b: nn, nb: 2_u64)
  var tt = Array[U64, 8]()
  var i = 0_u64
  while i < 6
    tt[i] = t[i +% 2]
    i = i +% 1
  var t2 = b128_atanfam_mh(b: tt, bo: 0_u64, a: tt, ao: 0_u64, n: 6_u64)
  t2 = b128_atanfam_shr(a: t2, n: 6_u64, k: 2 *% dn -% 14)
  # odd series of atan in 25 terms, widening the working precision from 2 to 6 limbs
  var f = Array[U64, 8]()
  f[0] = B128_ATANFAM_CP[0]
  f[1] = B128_ATANFAM_CP[1]
  var ck = 0_u64
  var k = 25
  while k > 20
    ck = ck +% 2
    f = b128_atanfam_cpsub(ck: ck, f: b128_atanfam_mh(b: f, bo: 0_u64, a: t2, ao: 4_u64, n: 2_u64), n: 2_u64)
    k = k -% 1
  f[2] = B128_ATANFAM_CP[ck +% 2]
  while k > 15
    ck = ck +% 3
    f = b128_atanfam_cpsub(ck: ck, f: b128_atanfam_mh(b: f, bo: 0_u64, a: t2, ao: 3_u64, n: 3_u64), n: 3_u64)
    k = k -% 1
  f[3] = B128_ATANFAM_CP[ck +% 3]
  while k > 10
    ck = ck +% 4
    f = b128_atanfam_cpsub(ck: ck, f: b128_atanfam_mh(b: f, bo: 0_u64, a: t2, ao: 2_u64, n: 4_u64), n: 4_u64)
    k = k -% 1
  f[4] = B128_ATANFAM_CP[ck +% 4]
  while k > 5
    ck = ck +% 5
    f = b128_atanfam_cpsub(ck: ck, f: b128_atanfam_mh(b: f, bo: 0_u64, a: t2, ao: 1_u64, n: 5_u64), n: 5_u64)
    k = k -% 1
  f[5] = B128_ATANFAM_CP[ck +% 5]
  while k > 1
    ck = ck +% 6
    f = b128_atanfam_cpsub(ck: ck, f: b128_atanfam_mh(b: f, bo: 0_u64, a: t2, ao: 0_u64, n: 6_u64), n: 6_u64)
    k = k -% 1
  f = b128_atanfam_mh(b: f, bo: 0_u64, a: t2, ao: 0_u64, n: 6_u64)
  f = b128_atanfam_mh(b: tt, bo: 0_u64, a: f, ao: 0_u64, n: 6_u64)
  return b128_atanfam_sub(a: tt, b: f, n: 6_u64)

# (a2:a1:a0) + (b2:b1:b0) modulo 2^192
@inline
secret routine b128_atanfam_add3(a0: U64, a1: U64, a2: U64, b0: U64, b1: U64, b2: U64) -> (U64, U64, U64)
  var al = b128_atanfam_mk(hi: a1, lo: a0)
  var s = al +% b128_atanfam_mk(hi: b1, lo: b0)
  var top = a2 +% b2
  if s < al
    top = top +% 1
  return (b128_atanfam_lo(v: s), b128_atanfam_hi(v: s), top)

# PHI0 row i (6 limbs) as an array
secret routine b128_atanfam_phi0(i: U64) -> Array[U64, 8]
  var o = Array[U64, 8]()
  var j = 0_u64
  while j < 6
    o[j] = B128_ATANFAM_PHI0[6 *% i +% j]
    j = j +% 1
  return o

# QOFF row i (6 limbs: 0, pi/2, pi) as an array
secret routine b128_atanfam_qoff(i: U64) -> Array[U64, 8]
  var o = Array[U64, 8]()
  var j = 0_u64
  while j < 6
    o[j] = B128_ATANFAM_QOFF[6 *% i +% j]
    j = j +% 1
  return o

# --- tables -------------------------------------------------------------------------------------------

# a 15-bit approximation of tan(i*pi/4/64)
secret preset B128_ATANFAM_TN: Array[U64, 65] = [
  0_u64, 402_u64, 804_u64, 1207_u64, 1610_u64, 2013_u64, 2417_u64, 2822_u64, 3227_u64, 3634_u64,
  4042_u64, 4450_u64, 4861_u64, 5272_u64, 5686_u64, 6101_u64, 6518_u64, 6937_u64, 7358_u64, 7782_u64,
