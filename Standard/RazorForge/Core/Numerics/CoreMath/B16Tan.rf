module Core

# ============================================================================
# Correctly rounded tangent of B16
# ============================================================================
# Ported from CORE-MATH, src/binary16/tan/tanf16.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2025 Paul Zimmermann. Distributed under the MIT license: see LICENSE-CORE-MATH next
# to this file. RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the
# original is kept (its errno underflow/overflow reports are dropped).
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats.
#
# The input x splits into x1 + x2, where x1 keeps the top 11 bits of the B16 encoding and x2 the
# exponent plus the low 5 mantissa bits. Then tan(x) = sin(x1+x2) / cos(x1+x2), both expanded with the
# addition formulas over B32 approximations of sin and cos of x1 and x2 (tabulated and tuned so that
# the B32 quotient rounds correctly to B16 everywhere except the few inputs handled explicitly).

### Returns the tangent of this value (in radians), correctly rounded: the exact tangent rounded to the
### nearest `B16` (ties to even), identical on every platform. ±infinity and NaN give NaN.
### :returns: The correctly rounded tangent.
routine B16.tan() -> B16
  var u = me.to_bits()
  var au = u & 0x7FFF_u16
  # for |x| <= 0x1.d1p-6, tan(x) rounds to x
  if au <= 0x2744_u16
    var t = B32(from: me)
    return B16(from: LLVM::fma[B32](a: t, b: 0x1p-12_b32, c: t))
  # inputs whose B32 quotient would round wrongly
  if au == 0x55ED_u16
    # |x| = 0x1.7b4p+6
    var r = B16(from: 0x1.445ffep-1_b32)
    return if au == u then r else -r
  if au == 0x658C_u16
    # |x| = 0x1.63p+10
    var r = B16(from: 0x1.f9bd04p-14_b32)
    return if au == u then r else -r
  if au == 0x6429_u16
    # |x| = 0x1.0a4p+10
    var r = B16(from: 0x1.7b4dc2p-14_b32)
    return if au == u then r else -r
  if u == 0x681E_u16
    # x = 0x1.078p+11
    return B16(from: -0x1.1c1fbep-7_b32)
  if u == 0xE74E_u16
    # x = -0x1.d38p+10
    return B16(from: -0x1.df4002p-1_b32)
  if u == 0xE807_u16
    # x = -0x1.01cp+11
    return B16(from: -0x1.053ffep+1_b32)
  if u == 0x6F4D_u16
    # x = 0x1.d34p+12
    return B16(from: -0x1.867ffep+0_b32)
  var i1 = LLVM::zero_extend[U16, U64](u >>> 5)
  var i2 = LLVM::zero_extend[U16, U64](((u >>> 10) << 5) | (u & 0x1F_u16))
  var s1 = B32.from_bits(bits: B16_TAN_S1[i1])
  var c1 = B32.from_bits(bits: B16_TAN_C1[i1])
  var s2 = B32.from_bits(bits: B16_TAN_S2[i2])
  var c2 = B32.from_bits(bits: B16_TAN_C2[i2])
  # the fmas fix the evaluation order
  var s = LLVM::fma[B32](a: s1, b: c2, c: c1 *! s2)
  var c = LLVM::fma[B32](a: c1, b: c2, c: (-s1) *! s2)
  return B16(from: s /! c)

### B32 approximations of sin(x1), where the B16 encoding of x1 is i1 * 2^5 (from tanf16.c).
