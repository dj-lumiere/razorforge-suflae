module Core

# ============================================================================
# Correctly rounded exp(x) - 1 of B32
# ============================================================================
# Ported from CORE-MATH, src/binary32/expm1/expm1f.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2022-2025 Alexei Sibidanov. Distributed under the MIT license: see LICENSE-CORE-MATH next
# to this file. RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the original
# is kept (its errno handling is dropped). Arithmetic uses the unchecked operators `+! -! *! /!`, which are
# raw IEEE 754 on floats.

### `2^(i/32)` for i in 0..31, as B64 bit patterns.
secret preset B32_EXPM1_TD: Array[U64, 32] = [0x3FF0000000000000_u64, 0x3FF059B0D3158574_u64, 0x3FF0B5586CF9890F_u64, 0x3FF11301D0125B51_u64, 0x3FF172B83C7D517B_u64, 0x3FF1D4873168B9AA_u64, 0x3FF2387A6E756238_u64, 0x3FF29E9DF51FDEE1_u64, 0x3FF306FE0A31B715_u64, 0x3FF371A7373AA9CB_u64, 0x3FF3DEA64C123422_u64, 0x3FF44E086061892D_u64, 0x3FF4BFDAD5362A27_u64, 0x3FF5342B569D4F82_u64, 0x3FF5AB07DD485429_u64, 0x3FF6247EB03A5585_u64, 0x3FF6A09E667F3BCD_u64, 0x3FF71F75E8EC5F74_u64, 0x3FF7A11473EB0187_u64, 0x3FF82589994CCE13_u64, 0x3FF8ACE5422AA0DB_u64, 0x3FF93737B0CDC5E5_u64, 0x3FF9C49182A3F090_u64, 0x3FFA5503B23E255D_u64, 0x3FFAE89F995AD3AD_u64, 0x3FFB7F76F2FB5E47_u64, 0x3FFC199BDD85529C_u64, 0x3FFCB720DCEF9069_u64, 0x3FFD5818DCFBA487_u64, 0x3FFDFC97337B9B5F_u64, 0x3FFEA4AFA2A490DA_u64, 0x3FFF50765B6E4540_u64]

### `e^me - 1`, correctly rounded: the exact value rounded to the nearest `B32` (ties to even), identical
### on every platform, and accurate near zero. Raw IEEE 754 propagation: overflow gives +infinity,
### `expm1(-infinity) == -1`, ±0 map to themselves and NaN maps to NaN.
### :returns: The correctly rounded `exp(me) - 1`.
routine B32.expm1_unchecked() -> B32
  var ux = me.to_bits()
  var z = B64(from: me)
  var ax = ux << 1
  if ax < 0x7C400000_u32
    # |x| < 0.15625
    if ax < 0x676A09E8_u32
      # |x| < 0x1.6a09e8p-24: expm1(x) rounds like x + |x| * 2^-25
      if ax == 0
        return me
      return LLVM::fma[B32](a: me.abs(), b: 0x1p-25_b32, c: me)
    var z2 = z *! z
    var z4 = z2 *! z2
    var p01 = 0x1.fffffffffffc2p-2 +! z *! 0x1.55555555555fep-3
    var p23 = 0x1.555555559767fp-5 +! z *! 0x1.1111111098dc1p-7
    var p45 = 0x1.6c16bca988aa9p-10 +! z *! 0x1.a01a07658483fp-13
    var p67 = 0x1.a05b04d2c3503p-16 +! z *! 0x1.71de3a960b5e3p-19
    var r0 = z +! z2 *! ((p01 +! z2 *! p23) +! z4 *! (p45 +! z2 *! p67))
    return B32(from: r0)
  if ax >= 0x8562E430_u32
    # |x| >= 0x1.62e43p+6
    if ax > 0xFF000000_u32
      return me +! me
    if ux >>> 31 == 1
      # x < 0: the result is -1 or the float just above it
      if ax == 0xFF000000_u32
        return -1.0_b32
      return -1.0_b32 +! 0x1p-26_b32
    if ax == 0xFF000000_u32
      return me *! me
    # overflow
    return 0x1.fffffep+127_b32 *! me
  var a = 0x1.71547652b82fep+5 *! z
  var ia = a.rint()
  var h = a -! ia
  var h2 = h *! h
  var uu = (ia +! 0x1.8p+52).to_bits()
  var c2 = 0x1.ebfd1b232f475p-13 +! h *! 0x1.c6b19384ecd93p-20
  var c0 = 1.0 +! h *! 0x1.62e42fef4c4e7p-6
  var sv = B64.from_bits(bits: B32_EXPM1_TD[uu & 0x1F_u64] +% ((uu >>> 5) << 52))
  var r = (c0 +! h2 *! c2) *! sv -! 1.0
  var ub = B32(from: r)
  var lb = B32(from: r -! sv *! 0x1.3b3p-33)
  if ub != lb
    # the fast path cannot decide the rounding
    if ux > 0xC18AA123_u32
      # x < -17.32
      return -1.0_b32 +! 0x1p-26_b32
    var s = sv
    h = (0x1.7154765p+5 *! z -! ia) +! 0x1.5c17f0bbbe88p-26 *! z
    h2 = h *! h
    var w = s *! h
    var q01 = 0x1.62e42fefa39efp-6 +! h *! 0x1.ebfbdff82c58fp-13
    var q23 = 0x1.c6b08d702e0edp-20 +! h *! 0x1.3b2ab6fb92e5ep-27
    var q45 = 0x1.5d886e6d54203p-35 +! h *! 0x1.430976b8ce6efp-43
    r = (s -! 1.0) +! w *! (q01 +! h2 *! (q23 +! h2 *! q45))
    ub = B32(from: r)
  return ub
