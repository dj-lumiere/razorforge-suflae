module Core

# ============================================================================
# Correctly rounded natural logarithm of B16
# ============================================================================
# Ported from CORE-MATH, src/binary16/log/logf16.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2025 Maxence Ponsardin and Paul Zimmermann. Distributed under the MIT license: see LICENSE-CORE-MATH next to this file.
# RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the original is kept (its
# errno and exception-flag handling are dropped). Arithmetic uses the unchecked operators `+! -! *! /!`,
# which are raw IEEE 754 on floats.

### Returns the natural logarithm of this value, correctly rounded: the exact result rounded to the nearest `B16` (ties to even),
### identical on every platform. `log(±0)` is -infinity, a negative input gives NaN, `log(+infinity)`
### is +infinity and a NaN input gives a quiet NaN.
### :returns: The correctly rounded log.
routine B16.log_unchecked() -> B16
  var u = LLVM::zero_extend[U16, U64](me.to_bits())
  var i1 = u >>> 10
  var i2 = u & 0x3FF_u64
  if u >>> 15 != 0
    # -0 gives -infinity, x < 0 gives NaN (a NaN input is quieted and passed through)
    if u == 0x8000_u64
      return B16.from_bits(bits: 0xFC00_u16)
    if me.is_nan()
      return me +! me
    return B16.from_bits(bits: 0x7E01_u16)
  # +infinity or NaN
  if i1 == 0x1F_u64
    return me +! me
  # subnormal (and +0): tabulated directly
  if i1 == 0
    return B16(from: B32.from_bits(bits: B16_LOG_T3[i2]))
  return B16(from: B32.from_bits(bits: B16_LOG_T1[i1]) +! B32.from_bits(bits: B16_LOG_T2[i2]))

