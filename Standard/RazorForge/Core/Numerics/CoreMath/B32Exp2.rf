module Core

# ============================================================================
# Correctly rounded base-2 exponential of B32
# ============================================================================
# Ported from CORE-MATH, src/binary32/exp2/exp2f.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2023-2025 Alexei Sibidanov. Distributed under the MIT license: see LICENSE-CORE-MATH next
# to this file. RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the original
# is kept (its errno handling is dropped). Arithmetic uses the unchecked operators `+! -! *! /!`, which are
# raw IEEE 754 on floats.

### `2^(i/64)` for i in 0..63, as B64 bit patterns.
secret preset B32_EXP2_TB: Array[U64, 64] = [0x3FF0000000000000_u64, 0x3FF02C9A3E778061_u64, 0x3FF059B0D3158574_u64, 0x3FF0874518759BC8_u64, 0x3FF0B5586CF9890F_u64, 0x3FF0E3EC32D3D1A2_u64, 0x3FF11301D0125B51_u64, 0x3FF1429AAEA92DE0_u64, 0x3FF172B83C7D517B_u64, 0x3FF1A35BEB6FCB75_u64, 0x3FF1D4873168B9AA_u64, 0x3FF2063B88628CD6_u64, 0x3FF2387A6E756238_u64, 0x3FF26B4565E27CDD_u64, 0x3FF29E9DF51FDEE1_u64, 0x3FF2D285A6E4030B_u64, 0x3FF306FE0A31B715_u64, 0x3FF33C08B26416FF_u64, 0x3FF371A7373AA9CB_u64, 0x3FF3A7DB34E59FF7_u64, 0x3FF3DEA64C123422_u64, 0x3FF4160A21F72E2A_u64, 0x3FF44E086061892D_u64, 0x3FF486A2B5C13CD0_u64, 0x3FF4BFDAD5362A27_u64, 0x3FF4F9B2769D2CA7_u64, 0x3FF5342B569D4F82_u64, 0x3FF56F4736B527DA_u64, 0x3FF5AB07DD485429_u64, 0x3FF5E76F15AD2148_u64, 0x3FF6247EB03A5585_u64, 0x3FF6623882552225_u64, 0x3FF6A09E667F3BCD_u64, 0x3FF6DFB23C651A2F_u64, 0x3FF71F75E8EC5F74_u64, 0x3FF75FEB564267C9_u64, 0x3FF7A11473EB0187_u64, 0x3FF7E2F336CF4E62_u64, 0x3FF82589994CCE13_u64, 0x3FF868D99B4492ED_u64, 0x3FF8ACE5422AA0DB_u64, 0x3FF8F1AE99157736_u64, 0x3FF93737B0CDC5E5_u64, 0x3FF97D829FDE4E50_u64, 0x3FF9C49182A3F090_u64, 0x3FFA0C667B5DE565_u64, 0x3FFA5503B23E255D_u64, 0x3FFA9E6B5579FDBF_u64, 0x3FFAE89F995AD3AD_u64, 0x3FFB33A2B84F15FB_u64, 0x3FFB7F76F2FB5E47_u64, 0x3FFBCC1E904BC1D2_u64, 0x3FFC199BDD85529C_u64, 0x3FFC67F12E57D14B_u64, 0x3FFCB720DCEF9069_u64, 0x3FFD072D4A07897C_u64, 0x3FFD5818DCFBA487_u64, 0x3FFDA9E603DB3285_u64, 0x3FFDFC97337B9B5F_u64, 0x3FFE502EE78B3FF6_u64, 0x3FFEA4AFA2A490DA_u64, 0x3FFEFA1BEE615A27_u64, 0x3FFF50765B6E4540_u64, 0x3FFFA7C1819E90D8_u64]

### Base-2 exponential `2^me`, correctly rounded: the exact value rounded to the nearest `B32` (ties to
### even), identical on every platform. Raw IEEE 754 propagation: overflow gives +infinity, underflow
### rounds to a subnormal or zero, `exp2(-infinity) == 0` and NaN maps to NaN. Integer inputs give exact
### powers of two.
### :returns: The correctly rounded base-2 exponential.
routine B32.exp2_unchecked() -> B32
  var tu = me.to_bits()
  if (tu & 0xFFFF_u32) == 0
    # x may be an integer
    var k = LLVM::reinterpret_bits[U64, S64](LLVM::zero_extend[U32, U64]((tu >>> 23) & 0xFF_u32)) - 127
    # 2^k <= |x| < 2^(k+1)
    if k >= 0 and k < 9
      if (tu << LLVM::int_truncate[S64, U32](9 + k)) == 0
        # x is an integer with 1 <= |x| < 2^9: the result is an exact power of two (or a subnormal)
        var mant = LLVM::zero_extend[U32, U64]((tu & 0x7FFFFF_u32) | 0x800000_u32)
        var m = LLVM::reinterpret_bits[U64, S64](mant >>> LLVM::int_truncate[S64, U32](23 - k))
        if tu >>> 31 == 1
          m = -m
        m = m + 127
        if m > 0 and m < 255
          return B32.from_bits(bits: LLVM::int_truncate[S64, U32](m) << 23)
        if m <= 0 and m > -23
          return B32.from_bits(bits: 1_u32 << LLVM::int_truncate[S64, U32](22 + m))
  var ux = tu << 1
  if ux >= 0x86000000_u32 or ux < 0x65000000_u32
    # |x| >= 128, x = NaN or |x| < 0x1p-26
    if ux < 0x65000000_u32
      return 1.0_b32 +! me
    # x < -149 or 128 <= x (or infinity / NaN)
    if not (tu >= 0xC3000000_u32 and tu < 0xC3150000_u32)
      return b32_exp2_special(x: me)
  var xd = B64(from: me)
  var h = xd -! ((xd +! 0x1.8p+46) -! 0x1.8p+46)
  var h2 = h *! h
  var u = (me +! 0x1.8p+17_b32).to_bits()
  var svb = B32_EXP2_TB[LLVM::zero_extend[U32, U64](u & 0x3F_u32)] +% (LLVM::zero_extend[U32, U64](u >>> 6) << 52)
  var sv = B64.from_bits(bits: svb)
  var r = sv *! ((1.0 +! h *! 0x1.62e42fef4c4e7p-1) +! h2 *! (0x1.ebfd1b232f475p-3 +! h *! 0x1.c6b19384ecd93p-5))
  var ub = B32(from: r)
  var lb = B32(from: r -! r *! 0x1.3d8p-33)
  if ub != lb
    # the fast path cannot decide the rounding: three hard cases, then a longer polynomial
    if ux <= 0x79E7526E_u32
      if tu == 0x3B429D37_u32
        return 0x1.00870ap+0_b32 -! 0x1p-25_b32
      if tu == 0xBCF3A937_u32
        return 0x1.f58d62p-1_b32 -! 0x1p-26_b32
      if tu == 0xB8D3D026_u32
        return 0x1.fff6d2p-1_b32 +! 0x1p-26_b32
    var c01 = 0x1.62e42fefa39efp-1 +! h *! 0x1.ebfbdff82c58fp-3
    var c23 = 0x1.c6b08d702e0edp-5 +! h *! 0x1.3b2ab6fb92e5ep-7
    var c45 = 0x1.5d886e6d54203p-10 +! h *! 0x1.430976b8ce6efp-13
    r = sv +! (sv *! h) *! (c01 +! h2 *! (c23 +! h2 *! c45))
    ub = B32(from: r)
  return ub

### exp2 of an infinity, a NaN, an x below -149 (underflow) or an x of at least 128 (overflow).
### :param x: The special input.
### :returns: +infinity, 0, NaN, the underflowed result or +infinity from overflow.
secret routine b32_exp2_special(x: B32) -> B32
  var tu = x.to_bits()
  var ux = tu << 1
  if ux >= 0xFF000000_u32
    # x is infinity or NaN
    if ux > 0xFF000000_u32
      return x +! x
    return if tu >>> 31 == 0 then B32.from_bits(bits: 0x7F800000_u32) else 0.0_b32
  if tu >= 0xC3150000_u32
    # x < -149
    var z = B64(from: x)
    var y = 0x1p-149 +! (z +! 149.0) *! 0x1p-150
    y = y.fmax(you: 0x1p-151)
    return B32(from: y)
  # x >= 128
  return 0x1p+127_b32 *! 0x1p+127_b32
