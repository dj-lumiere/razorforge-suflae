module Core

# ============================================================================
# Correctly rounded base-2 logarithm of B16
# ============================================================================
# Ported from CORE-MATH, src/binary16/log2/log2f16.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2025 Maxence Ponsardin and Paul Zimmermann. Distributed under the MIT license: see LICENSE-CORE-MATH next to this file.
# RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the original is kept (its
# errno and exception-flag handling are dropped). Arithmetic uses the unchecked operators `+! -! *! /!`,
# which are raw IEEE 754 on floats.

### Returns the base-2 logarithm of this value, correctly rounded: the exact result rounded to the nearest `B16` (ties to even),
### identical on every platform. `log2(±0)` is -infinity, a negative input gives NaN, `log2(+infinity)`
### is +infinity and a NaN input gives a quiet NaN.
### :returns: The correctly rounded log2.
routine B16.log2_unchecked() -> B16
  var u = LLVM::zero_extend[U16, U64](me.to_bits())
  var i1 = u >>> 10
  var i2 = u & 0x3FF_u64
  if u >>> 15 != 0
    # -0 gives -infinity, x < 0 gives NaN (a NaN input is quieted and passed through)
    if u == 0x8000_u64
      return B16.from_bits(bits: 0xFC00_u16)
    if me.is_nan()
      return me +! me
    return B16.from_bits(bits: 0x7E01_u16)
  # +infinity or NaN
  if i1 == 0x1F_u64
    return me +! me
  # subnormal (and +0): tabulated directly
  if i1 == 0
    return B16(from: B32.from_bits(bits: B16_LOG2_T3[i2]))
  return B16(from: B32.from_bits(bits: B16_LOG2_T1[i1]) +! B32.from_bits(bits: B16_LOG2_T2[i2]))

### B32 bit patterns of log2(x1), where the B16 encoding of x1 is `i1 * 2^10` (i1 encodes the exponent).
secret preset B16_LOG2_T1: Array[U32, 32] = [0x00000000_u32, 0xC1600000_u32, 0xC1500000_u32, 0xC1400000_u32, 0xC1300000_u32, 0xC1200000_u32, 0xC1100000_u32, 0xC1000000_u32, 0xC0E00000_u32, 0xC0C00000_u32, 0xC0A00000_u32, 0xC0800000_u32, 0xC0400000_u32, 0xC0000000_u32, 0xBF800000_u32, 0x00000000_u32, 0x3F800000_u32, 0x40000000_u32, 0x40400000_u32, 0x40800000_u32, 0x40A00000_u32, 0x40C00000_u32, 0x40E00000_u32, 0x41000000_u32, 0x41100000_u32, 0x41200000_u32, 0x41300000_u32, 0x41400000_u32, 0x41500000_u32, 0x41600000_u32, 0x41700000_u32, 0x00000000_u32]

