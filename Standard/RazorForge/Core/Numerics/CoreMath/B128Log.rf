module Core

# ============================================================================
# Correctly rounded natural logarithm of B128
# ============================================================================
# Ported from CORE-MATH, src/binary128/log/logq.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2025 Alexei Sibidanov <sibid@uvic.ca>
# Distributed under the MIT license: see LICENSE-CORE-MATH next to this file. RazorForge has no dynamic
# rounding modes, so only the round-to-nearest path of the original is kept (its rounding-mode probe,
# exception flags, errno and directed-rounding branches are dropped). The computation works on 64-bit and
# 128-bit integer words, like the original, and never uses the software B128 arithmetic. The multi-word
# helpers (b128_wide_*) live in B128Wide.rf.

### `ln(me)`, correctly rounded: the exact natural logarithm rounded to the nearest `B128` (ties to even),
### identical on every platform. Raw IEEE 754 propagation, no crash: ±0 -> -infinity, x < 0 -> NaN,
### +infinity -> +infinity, NaN -> quiet NaN.
### :returns: The correctly rounded natural logarithm.
routine B128.log_unchecked() -> B128
  var u = me.to_bits()
  var hi = b128_wide_hi(x: u)
  var lo = b128_wide_lo(x: u)
  if hi >= 0x7FFF000000000000_u64
    var b1 = hi & 0x7FFFFFFFFFFFFFFF_u64
    if b1 > 0x7FFF000000000000_u64 or (b1 == 0x7FFF000000000000_u64 and lo != 0)
      # NaN: quieted, sign and payload kept
      return B128.from_bits(bits: b128_wide_u128(hi: hi | 0x0000800000000000_u64, lo: lo))
    if hi == 0x7FFF000000000000_u64 and lo == 0
      return me
    if b1 == 0 and lo == 0
      return B128.from_bits(bits: b128_wide_u128(hi: 0xFFFF000000000000_u64, lo: 0_u64))
    # x < 0: the NaN the original returns
    return B128.from_bits(bits: b128_wide_u128(hi: 0xFFFF800000000000_u64, lo: 11_u64))
  if 0x3FFEFFFFF0000040_u64 <= hi and hi <= 0x3FFF000008000020_u64
    # too close to 1: specific treatment
    return b128_log_nearone(x: u)
  var mh = hi
  var ml = lo
  var e = hi & 0xFFFF000000000000_u64
  if e == 0
    if u == 0
      return B128.from_bits(bits: b128_wide_u128(hi: 0xFFFF000000000000_u64, lo: 0_u64))
    var nz = 0_u64
    if hi != 0
      nz = hi.leading_zeros()
    else
      nz = lo.leading_zeros() +% 64
    var mm = u << b128_wide_s(n: nz -% 15)
    mh = b128_wide_hi(x: mm)
    ml = b128_wide_lo(x: mm)
    e = e -% ((nz -% 16) << 48)
  e = e +% (112_u64 << 48)
  # crude approximation of log2
  var l = b128_log_log2(x: mh)
  var j0 = l >>> 59
  var j1 = (l >>> 54) & 31
  var j2 = (l >>> 49) & 31
  var j3 = (l >>> 44) & 31
  mh = (mh & 0x0000FFFFFFFFFFFF_u64) | 0x0001000000000000_u64
  var r01 = B128_LOG_RT1[j1] *% B128_LOG_RT0[j0]
  var r23 = B128_LOG_RT2[j2] *% B128_LOG_RT3[j3]
  var rr = b128_wide_mUU(a: b128_wide_u128(hi: mh, lo: ml), b: b128_wide_muu(a: r01, b: r23))
  var rhh = b128_wide_hi(x: rr.item0)
  var rhl = b128_wide_lo(x: rr.item0)
  var rlh = b128_wide_hi(x: rr.item1)
  mh = (rhh << 40) | (rhl >>> 24)
  ml = (rhl << 40) | (rlh >>> 24)
  var m = b128_wide_u128(hi: mh, lo: ml)
  var fs = b128_wide_mahu3(a: e, b0: B128_LOG_LN2A[0], b1: B128_LOG_LN2A[1], b2: B128_LOG_LN2A[2], c0: B128_LOG_OFFA[0], c1: B128_LOG_OFFA[1], c2: B128_LOG_OFFA[2])
  fs = b128_wide_add3(a0: fs.item0, a1: fs.item1, a2: fs.item2, b0: B128_LOG_LT0[3 *% j0], b1: B128_LOG_LT0[3 *% j0 +% 1], b2: B128_LOG_LT0[3 *% j0 +% 2])
  fs = b128_wide_add3(a0: fs.item0, a1: fs.item1, a2: fs.item2, b0: B128_LOG_LT1[3 *% j1], b1: B128_LOG_LT1[3 *% j1 +% 1], b2: B128_LOG_LT1[3 *% j1 +% 2])
  fs = b128_wide_add3(a0: fs.item0, a1: fs.item1, a2: fs.item2, b0: B128_LOG_LT2[3 *% j2], b1: B128_LOG_LT2[3 *% j2 +% 1], b2: B128_LOG_LT2[3 *% j2 +% 2])
  fs = b128_wide_add3(a0: fs.item0, a1: fs.item1, a2: fs.item2, b0: B128_LOG_LT3[3 *% j3], b1: B128_LOG_LT3[3 *% j3 +% 1], b2: B128_LOG_LT3[3 *% j3 +% 2])
  var f = b128_wide_u128(hi: B128_LOG_C[7], lo: B128_LOG_C[6] -% b128_wide_mhuu(a: mh, b: B128_LOG_C[8] -% b128_wide_mhuu(a: mh, b: B128_LOG_C[10])))
  f = b128_wide_u128(hi: B128_LOG_C[5], lo: B128_LOG_C[4]) -% b128_wide_mhUU(a: m, b: f)
  f = b128_wide_u128(hi: B128_LOG_C[3], lo: B128_LOG_C[2]) -% b128_wide_mhUU(a: m, b: f)
  f = b128_wide_u128(hi: B128_LOG_C[1], lo: B128_LOG_C[0]) -% b128_wide_mhUU(a: m, b: f)
  var res = b128_wide_mhUU(a: m, b: f)
  fs = b128_wide_add3(a0: fs.item0, a1: fs.item1, a2: fs.item2, b0: b128_wide_lo(x: res), b1: b128_wide_hi(x: res), b2: 0_u64)
  var msk = b128_wide_sar(x: fs.item2, s: 63)
  var f0 = fs.item0 ^ msk
  var f1 = fs.item1 ^ msk
  var f2 = fs.item2 ^ msk
  var nz = 0_u64
  if f2 != 0
    nz = f2.leading_zeros()
  else
    nz = f1.leading_zeros() +% 64
  var ns = nz -% 15
  var tm = 0xFFFFFFFFFFFFFFFF_u64 >>> b128_wide_s(n: ns & 63)
  var rnd = (f0 >>> b128_wide_s(n: (63 -% ns) & 63)) & 1
  var el = (0x4029_u64 -% nz) | (msk << 15)
  if (((f0 +% (1_u64 << b128_wide_s(n: (63 -% ns) & 63))) +% 12) & tm) <= 24
    # rounding test failed: decide the rounding exactly
    var ls = nz -% 14
    var rs = (64 -% ls) & 63
    var rh = (f2 << b128_wide_s(n: ls & 63)) | (f1 >>> b128_wide_s(n: rs))
    var rl = (f1 << b128_wide_s(n: ls & 63)) | (f0 >>> b128_wide_s(n: rs))
    res = b128_wide_u128(hi: rh, lo: rl) +% LLVM::zero_extend[U64, U128]((f0 >>> b128_wide_s(n: (63 -% ls) & 63)) & 1)
    var rf = b128_log_refine(el: el, m: res, x: u)
    rnd = rf.item0
    res = rf.item1
  else
    var rs = (64 -% ns) & 63
    res = b128_wide_u128(hi: (f2 << b128_wide_s(n: ns & 63)) | (f1 >>> b128_wide_s(n: rs)), lo: (f1 << b128_wide_s(n: ns & 63)) | (f0 >>> b128_wide_s(n: rs)))
  return B128.from_bits(bits: res +% b128_wide_u128(hi: el << 48, lo: rnd))

### Crude approximation of log2 of the high significand word x (fixed point), selecting the table indices.
secret routine b128_log_log2(x: U64) -> U64
  var j = (x >>> 43) & 31
  var z = (x >>> 11) & 0xFFFFFFFF_u64
  var z2 = (z *% z) >>> 32
  var t0 = (B128_LOG_L2C[4 *% j] -% ((z *% B128_LOG_L2C[4 *% j +% 1]) >>> 38)) & 0xFFFFFFFF_u64
  var t2 = (B128_LOG_L2C[4 *% j +% 2] -% ((z *% B128_LOG_L2C[4 *% j +% 3]) >>> 32)) & 0xFFFFFFFF_u64
  t0 = (t0 +% ((z2 *% t2) >>> 44)) & 0xFFFFFFFF_u64
  return B128_LOG_L2C0[j] +% ((z *% t0) >>> 4)

### (w2, w1, w0) >> s (logical, s < 192).
secret routine b128_log_rlshft(t0: U64, t1: U64, t2: U64, s: U64) -> (U64, U64, U64)
  var a0 = t0
  var a1 = t1
  var a2 = t2
  var rs = s & 63
  if rs != 0
    var ls = (64 -% rs) & 63
    a0 = (a0 >>> b128_wide_s(n: rs)) | (a1 << b128_wide_s(n: ls))
    a1 = (a1 >>> b128_wide_s(n: rs)) | (a2 << b128_wide_s(n: ls))
    a2 = a2 >>> b128_wide_s(n: rs)
  var k = s
  while k >= 64
    a0 = a1
    a1 = a2
    a2 = 0_u64
    k = k -% 64
  return (a0, a1, a2)

### ln(x) for x within about 2^-29 of 1, where the general reduction would lose accuracy.
secret routine b128_log_nearone(x: U128) -> B128
  var one = 0x3FFF000000000000_u64
  var hi = b128_wide_hi(x: x)
  var lo = b128_wide_lo(x: x)
  var e = 0_u64
  var neg = 0_u64
  var crnd = false
  var res = 0_u128
  if hi >= one
    # x >= 1
    hi = hi -% one
    var nz = 0_u64
    if hi != 0
      nz = hi.leading_zeros()
    elseif lo != 0
      nz = lo.leading_zeros() +% 64
    else
      return B128.from_bits(bits: 0_u128)
    var u = b128_wide_u128(hi: hi, lo: lo) << b128_wide_s(n: nz)
    e = nz -% 16
    var u2 = b128_wide_mhUU(a: u, b: u)
    var m = u >>> b128_wide_s(n: e -% 20)
    var mh = b128_wide_hi(x: m)
    var f = b128_wide_u128(hi: B128_LOG_NCP[7], lo: B128_LOG_NCP[6] -% b128_wide_mhuu(a: mh, b: B128_LOG_NCP[8] -% b128_wide_mhuu(a: mh, b: B128_LOG_NCP[10])))
    f = b128_wide_u128(hi: B128_LOG_NCP[5], lo: B128_LOG_NCP[4]) -% b128_wide_mhUU(a: m, b: f)
    f = b128_wide_u128(hi: B128_LOG_NCP[3], lo: B128_LOG_NCP[2]) -% b128_wide_mhUU(a: m, b: f)
    f = b128_wide_u128(hi: B128_LOG_NCP[1], lo: B128_LOG_NCP[0]) -% b128_wide_mhUU(a: m, b: f)
    m = b128_wide_mhUU(a: u2, b: f)
    var t = b128_log_rlshft(t0: 0_u64, t1: b128_wide_lo(x: m), t2: b128_wide_hi(x: m), s: e)
    var z = b128_wide_sub3(a0: 0_u64, a1: b128_wide_lo(x: u), a2: b128_wide_hi(x: u), b0: t.item0, b1: t.item1, b2: t.item2)
    var eps = 12_u64
    var tl = b128_wide_u128(hi: z.item1, lo: z.item0)
    var zs = z.item2 >>> 63
    var msk = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF_u128 >>> b128_wide_s(n: 50 -% zs)
    var nrnd = 1_u128 << b128_wide_s(n: 13 +% zs)
    if e < 64
      tl = tl >>> b128_wide_s(n: 64 -% e)
      msk = msk >>> b128_wide_s(n: 64 -% e)
      nrnd = (nrnd << b128_wide_s(n: e)) | LLVM::zero_extend[U64, U128](eps)
    else
      eps = 1 +% (eps >>> b128_wide_s(n: e -% 64))
      nrnd = (nrnd << 64) | LLVM::zero_extend[U64, U128](eps)
    tl = msk & (tl +% nrnd)
    crnd = tl <= LLVM::zero_extend[U64, U128](2 *% eps)
    res = b128_wide_u128(hi: z.item2, lo: z.item1)
  else
    # x < 1
    neg = 1_u64
    var u = b128_wide_u128(hi: one, lo: 0_u64) -% x
    var uh = b128_wide_hi(x: u)
    var nz = 0_u64
    if uh != 0
      nz = uh.leading_zeros()
    else
      nz = b128_wide_lo(x: u).leading_zeros() +% 64
    u = u << b128_wide_s(n: nz)
    e = nz -% 16
    var u2 = b128_wide_mhUU(a: u, b: u)
    var m = u >>> b128_wide_s(n: e -% 20)
    var mh = b128_wide_hi(x: m)
    var f = b128_wide_u128(hi: B128_LOG_NCN[5], lo: B128_LOG_NCN[4]) +% LLVM::zero_extend[U64, U128](b128_wide_mhuu(a: mh, b: B128_LOG_NCN[6] +% b128_wide_mhuu(a: mh, b: B128_LOG_NCN[8] +% b128_wide_mhuu(a: mh, b: B128_LOG_NCN[10]))))
    f = b128_wide_u128(hi: B128_LOG_NCN[3], lo: B128_LOG_NCN[2]) +% b128_wide_mhUU(a: m, b: f)
    f = b128_wide_u128(hi: B128_LOG_NCN[1], lo: B128_LOG_NCN[0]) +% b128_wide_mhUU(a: m, b: f)
    m = b128_wide_mhUU(a: u2, b: f)
    u = u >>> 1
    var t = b128_log_rlshft(t0: 0_u64, t1: b128_wide_lo(x: m), t2: b128_wide_hi(x: m), s: e +% 2)
    var z = b128_wide_add3(a0: 0_u64, a1: b128_wide_lo(x: u), a2: b128_wide_hi(x: u), b0: t.item0, b1: t.item1, b2: t.item2)
    var eps = 12_u64
    var tl = b128_wide_u128(hi: z.item1, lo: z.item0)
    var zs = z.item2 >>> 63
    var msk = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF_u128 >>> b128_wide_s(n: 50 -% zs)
    var nrnd = 1_u128 << b128_wide_s(n: 13 +% zs)
    if e <= 62
      tl = tl >>> b128_wide_s(n: 62 -% e)
      msk = msk >>> b128_wide_s(n: 62 -% e)
      nrnd = (nrnd << b128_wide_s(n: e)) | LLVM::zero_extend[U64, U128](eps)
    else
      eps = 1 +% (eps >>> b128_wide_s(n: e -% 62))
      nrnd = (nrnd << 62) | LLVM::zero_extend[U64, U128](eps)
    tl = msk & (tl +% nrnd)
    crnd = tl <= LLVM::zero_extend[U64, U128](2 *% eps)
    res = b128_wide_u128(hi: z.item2, lo: z.item1)
  if (b128_wide_hi(x: res) >>> 63) == 0
    res = res << 1
    e = e +% 1
  var rnd = (b128_wide_lo(x: res) >>> 14) & 1
  e = 16381 -% e
  if crnd
    res = (res +% (1_u128 << 13)) >>> 14
    var rf = b128_log_refine(el: e | (neg << 15), m: res, x: x)
    rnd = rf.item0
    res = rf.item1
  else
    res = res >>> 15
  return B128.from_bits(bits: res +% b128_wide_u128(hi: (e << 48) | (neg << 63), lo: rnd))

### Decides the rounding exactly: evaluates 2^(m / ln 2) for the candidate result m (113 bits plus one) to
### about 380 bits and compares it with x. Returns the round bit and the adjusted significand.
secret routine b128_log_refine(el: U64, m: U128, x: U128) -> (U64, U128)
  var sm = 0_u64 -% ((el >>> 15) & 1)
  var xw = b128_wide_mhu7xu2(a: B128_WIDE_ILN2, b: m)
  var i = 0_u64
  while i < 7
    xw[i] = xw[i] ^ sm
    i = i +% 1
  xw = b128_wide_arsu7(x: xw, n: 0x402E_u64 -% (el & 0x7FFF))
  var ft = b128_wide_exp2_frac(x: xw)
  if (ft[0] | ft[1] | ft[2] | ft[3]) != 0
    ft[4] = ft[4] | 1
  var d = ft[4] -% (b128_wide_lo(x: x) << 12)
  var down = (d >>> 63) == 0
  if sm != 0
    down = not down
  var mm = m << 1
  if down
    mm = mm -% 1_u128
  else
    mm = mm +% 1_u128
  return (b128_wide_lo(x: mm >>> 1) & 1, mm >>> 2)

