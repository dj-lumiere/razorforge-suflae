secret preset B16_POW_EXP_TB: Array[U64, 64] = [0x3FF0000000000000_u64, 0x3FF02C9A3E778061_u64, 0x3FF059B0D3158574_u64, 0x3FF0874518759BC8_u64, 0x3FF0B5586CF9890F_u64, 0x3FF0E3EC32D3D1A2_u64, 0x3FF11301D0125B51_u64, 0x3FF1429AAEA92DE0_u64, 0x3FF172B83C7D517B_u64, 0x3FF1A35BEB6FCB75_u64, 0x3FF1D4873168B9AA_u64, 0x3FF2063B88628CD6_u64, 0x3FF2387A6E756238_u64, 0x3FF26B4565E27CDD_u64, 0x3FF29E9DF51FDEE1_u64, 0x3FF2D285A6E4030B_u64, 0x3FF306FE0A31B715_u64, 0x3FF33C08B26416FF_u64, 0x3FF371A7373AA9CB_u64, 0x3FF3A7DB34E59FF7_u64, 0x3FF3DEA64C123422_u64, 0x3FF4160A21F72E2A_u64, 0x3FF44E086061892D_u64, 0x3FF486A2B5C13CD0_u64, 0x3FF4BFDAD5362A27_u64, 0x3FF4F9B2769D2CA7_u64, 0x3FF5342B569D4F82_u64, 0x3FF56F4736B527DA_u64, 0x3FF5AB07DD485429_u64, 0x3FF5E76F15AD2149_u64, 0x3FF6247EB03A5585_u64, 0x3FF6623882552225_u64, 0x3FF6A09E667F3BCC_u64, 0x3FF6DFB23C651A2F_u64, 0x3FF71F75E8EC5F74_u64, 0x3FF75FEB564267C9_u64, 0x3FF7A11473EB0187_u64, 0x3FF7E2F336CF4E62_u64, 0x3FF82589994CCE13_u64, 0x3FF868D99B4492EC_u64, 0x3FF8ACE5422AA0DB_u64, 0x3FF8F1AE99157736_u64, 0x3FF93737B0CDC5E5_u64, 0x3FF97D829FDE4E4F_u64, 0x3FF9C49182A3F090_u64, 0x3FFA0C667B5DE565_u64, 0x3FFA5503B23E255D_u64, 0x3FFA9E6B5579FDC0_u64, 0x3FFAE89F995AD3AD_u64, 0x3FFB33A2B84F15FB_u64, 0x3FFB7F76F2FB5E47_u64, 0x3FFBCC1E904BC1D2_u64, 0x3FFC199BDD85529C_u64, 0x3FFC67F12E57D14B_u64, 0x3FFCB720DCEF9069_u64, 0x3FFD072D4A07897B_u64, 0x3FFD5818DCFBA487_u64, 0x3FFDA9E603DB3285_u64, 0x3FFDFC97337B9B5F_u64, 0x3FFE502EE78B3FF6_u64, 0x3FFEA4AFA2A490D9_u64, 0x3FFEFA1BEE615A27_u64, 0x3FFF50765B6E4541_u64, 0x3FFFA7C1819E90D8_u64]
