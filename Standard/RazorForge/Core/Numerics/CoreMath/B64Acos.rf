module Core

# ============================================================================
# Correctly rounded arc cosine of B64
# ============================================================================
# Ported from CORE-MATH, src/binary64/acos/acos.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2024-2025 Alexei Sibidanov. Distributed under the MIT license: see LICENSE-CORE-MATH next
# to this file. RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the original
# is kept (its errno handling is dropped). The NaN for |x| > 1 is the x86 default NaN the original produces
# at runtime there (0./0.), fixed so every platform returns the same bits.
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats.

### Arc cosine (radians) with raw IEEE 754 propagation, correctly rounded: the exact arc cosine rounded to
### the nearest `B64` (ties to even), identical on every platform. The result lies in [0, pi], and
### `|me| > 1`, ±infinity and NaN give NaN.
### :returns: The correctly rounded arc cosine.
routine B64.acos_unchecked() -> B64
  var x = me
  var xu = x.to_bits()
  var ax = xu << 1
  var t = 0.0
  var z = 0.0
  var zl = 0.0
  var jd = 0.0
  var f0h = 0.0
  var f0l = 0.0
  var eps = 0.0
  if ax > 0x7FC0000000000000_u64
    # |x| > 0.5
    if (xu >>> 63) != 0
      f0h = 0x1.921fb54442d18p+1
      f0l = 0x1.1a62633145c07p-53
    if ax >= 0x7FE0000000000000_u64
      # |x| >= 1
      if ax == 0x7FE0000000000000_u64
        # |x| = 1
        return f0h +! f0l
      if ax > 0xFFE0000000000000_u64
        # NaN
        return x +! x
      # |x| > 1
      return B64.from_bits(bits: 0xFFF8000000000000_u64)
    # for x > 0.5 the range reduction uses the double angle formula acos(x) = 2*asin(sqrt((1-x)/2)), and
    # for x < -0.5 acos(x) = pi - 2*asin(sqrt((1+x)/2))
    t = 2.0 -! 2.0 *! x.abs()
    jd = LLVM::rint[B64](value: t *! 0x1p5)
    z = LLVM::sqrt[B64](t).copysign(sign: x)
    zl = LLVM::fma[B64](a: z, b: z, c: -t) *! ((-0.5 /! t) *! z)
    t = 0.25 *! t -! jd *! 0x1p-7
    eps = (z *! t).abs() *! 0x1.8cp-52 +! 0x1p-105
  else
    # |x| <= 0.5
    f0h = 0x1.921fb54442d18p+0
    f0l = 0x1.1a62633145c07p-54
    if ax <= 0x7E00000000000000_u64
      # |x| < 2^-15; for |x| <= 0x1.cb3b3869747f4p-55 the cubic term is dropped (lb == ub there)
      var v = 0.0
      if ax > 0x791967670D2E8FE8_u64
        v = (x *! x) *! (-0x1.5555555555555p-3 *! x)
      var hw = b64_acos_fasttwosum(x: f0h, y: -x)
      var h = hw.item0
      var l = v +! (hw.item1 +! f0l)
      var lb0 = h +! (l -! 0x1.34p-79)
      var ub0 = h +! (l +! 0x1.34p-79)
      if lb0 != ub0
        return b64_acos_refine(x: x, phi: lb0)
      return lb0
    # for 2^-15 <= |x| <= 0.5, acos(x) = pi/2 - asin(x), sharing the asin tables
    t = x *! x
    jd = LLVM::rint[B64](value: t *! 0x1p7)
    t = LLVM::fma[B64](a: x, b: x, c: -0x1p-7 *! jd)
    z = -x
    # eps < 0 for x > 0, but the rounding test is still correct
    eps = (z *! t) *! 0x1.81p-52
  # asin(z + zl) = (z + zl)*(cc[j][0] + (cc[j][1] + t*P(t, cc[j] + 2))), where t = z^2 - j/128 and
  # j = round(128*z^2)
  var j = LLVM::float_to_unsigned[B64, U64](jd) *% 8
  var c2 = B64.from_bits(bits: B64_ACOS_CC[j + 2])
  var c3 = B64.from_bits(bits: B64_ACOS_CC[j + 3])
  var c4 = B64.from_bits(bits: B64_ACOS_CC[j + 4])
  var c5 = B64.from_bits(bits: B64_ACOS_CC[j + 5])
  var c6 = B64.from_bits(bits: B64_ACOS_CC[j + 6])
  var c7 = B64.from_bits(bits: B64_ACOS_CC[j + 7])
  var t2 = t *! t
  var d = t *! ((c2 +! t *! c3) +! t2 *! ((c4 +! t *! c5) +! t2 *! (c6 +! t *! c7)))
  var fh = B64.from_bits(bits: B64_ACOS_CC[j])
  var fl = B64.from_bits(bits: B64_ACOS_CC[j + 1]) +! d
  var p = b64_acos_muldd(xh: z, xl: zl, ch: fh, cl: fl)
  p = b64_acos_fastsum(xh: f0h, xl: f0l, yh: p.item0, yl: p.item1)
  fh = p.item0
  fl = p.item1
  var lb = fh +! (fl -! eps)
  var ub = fh +! (fl +! eps)
  if lb != ub
    return b64_acos_refine(x: x, phi: lb)
  return lb

### Sum `x + y` as a double-double (s, e), assuming |x| >= |y| or x == 0.
### :param x: The larger addend.
### :param y: The smaller addend.
### :returns: The rounded sum and its error.
secret routine b64_acos_fasttwosum(x: B64, y: B64) -> (B64, B64)
  var s = x +! y
  var z = s -! x
  return (s, y -! z)

### Sum `a + b` as a double-double (s, t), with no condition on the operands.
### :param a: The first addend.
### :param b: The second addend.
### :returns: The rounded sum and its error.
secret routine b64_acos_twosum(a: B64, b: B64) -> (B64, B64)
  var s = a +! b
  var ap = s -! b
  var bp = s -! ap
  var da = a -! ap
  var db = b -! bp
  return (s, da +! db)

### Double-double sum (xh + xl) + (yh + yl), assuming |xh| >= |yh| or xh == 0.
### :param xh: The high part of the first operand.
### :param xl: The low part of the first operand.
### :param yh: The high part of the second operand.
### :param yl: The low part of the second operand.
### :returns: The high and low parts of the sum.
secret routine b64_acos_fastsum(xh: B64, xl: B64, yh: B64, yl: B64) -> (B64, B64)
  var s = b64_acos_fasttwosum(x: xh, y: yh)
  return (s.item0, (xl +! yl) +! s.item1)

### Double-double product (xh + xl) * (ch + cl).
### :param xh: The high part of the first factor.
### :param xl: The low part of the first factor.
### :param ch: The high part of the second factor.
### :param cl: The low part of the second factor.
### :returns: The high and low parts of the product.
secret routine b64_acos_muldd(xh: B64, xl: B64, ch: B64, cl: B64) -> (B64, B64)
  var ahhh = xh *! ch
  var l = (xh *! cl +! xl *! ch) +! LLVM::fma[B64](a: xh, b: ch, c: -ahhh)
  return (ahhh, l)

### The accurate path, reached when the fast path cannot decide the rounding: with x = cos(phi), rotates
### the angle by a multiple of pi/64 close to phi and evaluates the arc sine of the small remainder in
### double-double arithmetic.
### :param x: The argument, with |x| < 1.
### :param phi: The fast-path approximation of acos(x).
### :returns: The correctly rounded arc cosine.
secret routine b64_acos_refine(x: B64, phi: B64) -> B64
  var s2 = x *! x
  var dx2 = LLVM::fma[B64](a: x, b: x, c: -s2)
  # s2 + dx2 = x^2
  var c2 = b64_acos_fasttwosum(x: 1.0, y: -s2)
  var c2h = c2.item0
  var c2l = c2.item1 -! dx2
  c2 = b64_acos_fasttwosum(x: c2h, y: c2l)
  c2h = c2.item0
  c2l = c2.item1
  # c2h + c2l approximates 1 - x^2
  var ch = LLVM::sqrt[B64](c2h)
  var cl = (c2l -! LLVM::fma[B64](a: ch, b: ch, c: -c2h)) *! (0.5 /! ch)
  # ch + cl approximates sqrt(1 - x^2); jf = round(|phi - pi/2|*64/pi), 0 <= jf <= 32
  var jfd = LLVM::rint[B64](value: (phi -! 0x1.921fb54442d18p+0).abs() *! 0x1.45f306dc9c883p+4)
  var jf = LLVM::float_to_unsigned[B64, U64](jfd)
  # the table holds sin(pi/64*j) as double-doubles, the smallest term first
  var bigch = B64.from_bits(bits: B64_ACOS_S[(32 - jf) * 2 + 1])
  var bigcl = B64.from_bits(bits: B64_ACOS_S[(32 - jf) * 2])
  var bigsh = B64.from_bits(bits: B64_ACOS_S[jf * 2 + 1])
  var bigsl = B64.from_bits(bits: B64_ACOS_S[jf * 2])
  var ax = x.abs()
  var dsh = ax -! bigsh
  var dsl = -bigsl
  var dch = ch -! bigch
  var dcl = cl -! bigcl
  var magic = 0x1.8p-4
  var sc = LLVM::fma[B64](a: bigsh, b: dch, c: magic) -! magic
  var dsc = LLVM::fma[B64](a: bigsh, b: dch, c: -sc)
  var cs = LLVM::fma[B64](a: bigch, b: dsh, c: magic) -! magic
  var dcs = LLVM::fma[B64](a: bigch, b: dsh, c: -cs)
  # exact, since |cs - sc| is a multiple of 2^-56 below 2^-4
  var v = cs -! sc
  var dv = ((bigch *! dsl +! bigcl *! dsh) -! (bigsh *! dcl +! bigsl *! dch)) -! (dsc -! dcs)
  var vv = b64_acos_fasttwosum(x: v, y: dv)
  v = vv.item0
  dv = vv.item1
  var one: B64 = 1.0
  var sgn = one.copysign(sign: x)
  # pi/2 -/+ jf*pi/64 = jt*pi/64, with 0 <= jt <= 64
  var jt = 32.0 -! jfd *! sgn
  var sq = b64_acos_muldd(xh: v, xl: dv, ch: v, cl: dv)
  var v2 = sq.item0
  var dv2 = sq.item1
  v = v *! -sgn
  dv = dv *! -sgn
  var fl = v2 *! (0x1.6e8ba2ec8cb69p-6 +! v2 *! (0x1.1c4ea7a15c997p-6 +! v2 *! 0x1.ca8355d39bb67p-7))
  # the double-double polynomial over c[0..4], Horner from the top coefficient
  var hp = b64_acos_fasttwosum(x: 0x1.f1c71c71c6d5bp-6, y: fl)
  var fh = hp.item0
  fl = 0x1.b125bccdcc89ep-60 +! hp.item1
  hp = b64_acos_muldd(xh: v2, xl: dv2, ch: fh, cl: fl)
  hp = b64_acos_fastsum(xh: 0x1.6db6db6db6db7p-5, xl: -0x1.cb95ff08658e6p-62, yh: hp.item0, yl: hp.item1)
  hp = b64_acos_muldd(xh: v2, xl: dv2, ch: hp.item0, cl: hp.item1)
  hp = b64_acos_fastsum(xh: 0x1.3333333333333p-4, xl: 0x1.9997e3427441bp-59, yh: hp.item0, yl: hp.item1)
  hp = b64_acos_muldd(xh: v2, xl: dv2, ch: hp.item0, cl: hp.item1)
  hp = b64_acos_fastsum(xh: 0x1.5555555555555p-3, xl: 0x1.5555555623513p-57, yh: hp.item0, yl: hp.item1)
  hp = b64_acos_muldd(xh: v2, xl: dv2, ch: hp.item0, cl: hp.item1)
  hp = b64_acos_fastsum(xh: 1.0, xl: -0x1.fc2c76456515bp-108, yh: hp.item0, yl: hp.item1)
  hp = b64_acos_muldd(xh: v, xl: dv, ch: hp.item0, cl: hp.item1)
  # now fh + fl approximates -delta
  fh = hp.item0
  fl = hp.item1
  # since 0 <= jt <= 64, ph and pl are exact
  var ph = jt *! 0x1.921fb54442dp-5
  var pl = 0x1.8469898cc518p-53 *! jt
  var ps = -0x1.fc8f8cbb5bf6cp-102 *! jt
  var q = b64_acos_twosum(a: fh, b: pl)
  pl = q.item0
  ps = (fl +! ps) +! q.item1
  q = b64_acos_fasttwosum(x: ph, y: pl)
  ph = q.item0
  pl = q.item1
  q = b64_acos_fasttwosum(x: pl, y: ps)
  pl = q.item0
  ps = q.item1
  q = b64_acos_fasttwosum(x: ph, y: pl)
  ph = q.item0
  pl = q.item1
  q = b64_acos_fasttwosum(x: pl, y: ps)
  pl = q.item0
  ps = q.item1
  var tu = pl.to_bits()
  var e = LLVM::reinterpret_bits[U64, S64]((tu >>> 52) & 0x7FF_u64) - 1023
  e = 52 - (107 + e)
  if e < 0
    e = 0
  if e > 52
    e = 52
  var eu = LLVM::int_truncate[U64, U32](LLVM::reinterpret_bits[S64, U64](e))
  var m = (1_u64 << 52) -% (1_u64 << eu)
  if eu == 0
    eu = 64
  if ((tu +% (1_u64 << (eu - 1))) & m) == 0
    # the result lies too close to a rounding boundary
    if x == 0x1.ffffffffffdc0p-1
      return 0x1.8000000000024p-22 +! 0x1p-76
    if x == 0x1.53ea6c7255e88p-4
      return 0x1.7cdacb6bbe707p+0 +! 0x1p-54
    if x == 0x1.fd737be914578p-11
      return 0x1.91e006d41d8d8p+0 +! 0x1.8p-53
    if x == 0x1.fffffffffff70p-1
      return 0x1.8000000000009p-23 +! 0x1p-77
    if x == 0x1.390e6939cd1a6p-5
      return 0x1.8856a5d3296a4p+0 -! 0x1p-109
    var w = ps.to_bits()
    if ((w ^ tu) >>> 63) != 0
      tu = tu -% 1
    else
      tu = tu +% 1
    pl = B64.from_bits(bits: tu)
  return ph +! pl

# Float tables are stored as IEEE 754 bit patterns (read back with B64.from_bits).
# cc[j][0..7], row-major: asin(x) = x*(cc[j][0] + cc[j][1] + t*P(t, cc[j] + 2)) with t = x^2 - j/128
