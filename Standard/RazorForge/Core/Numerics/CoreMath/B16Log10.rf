module Core

# ============================================================================
# Correctly rounded base-10 logarithm of B16
# ============================================================================
# Ported from CORE-MATH, src/binary16/log10/log10f16.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2025 Maxence Ponsardin and Paul Zimmermann. Distributed under the MIT license: see LICENSE-CORE-MATH next to this file.
# RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the original is kept (its
# errno and exception-flag handling are dropped). Arithmetic uses the unchecked operators `+! -! *! /!`,
# which are raw IEEE 754 on floats.

### Returns the base-10 logarithm of this value, correctly rounded: the exact result rounded to the nearest `B16` (ties to even),
### identical on every platform. `log10(±0)` is -infinity, a negative input gives NaN, `log10(+infinity)`
### is +infinity and a NaN input gives a quiet NaN.
### :returns: The correctly rounded log10.
routine B16.log10_unchecked() -> B16
  var u = LLVM::zero_extend[U16, U64](me.to_bits())
  var i1 = u >>> 10
  var i2 = u & 0x3FF_u64
  if u >>> 15 != 0
    # -0 gives -infinity, x < 0 gives NaN (a NaN input is quieted and passed through)
    if u == 0x8000_u64
      return B16.from_bits(bits: 0xFC00_u16)
    if me.is_nan()
      return me +! me
    return B16.from_bits(bits: 0x7E01_u16)
  # +infinity or NaN
  if i1 == 0x1F_u64
    return me +! me
  # subnormal (and +0): tabulated directly
  if i1 == 0
    return B16(from: B32.from_bits(bits: B16_LOG10_T3[i2]))
  return B16(from: B32.from_bits(bits: B16_LOG10_T1[i1]) +! B32.from_bits(bits: B16_LOG10_T2[i2]))

### B32 bit patterns of log10(x1), where the B16 encoding of x1 is `i1 * 2^10` (i1 encodes the exponent).
secret preset B16_LOG10_T1: Array[U32, 32] = [0x00000000_u32, 0xC086DC87_u32, 0xC07A74FB_u32, 0xC06730E8_u32, 0xC053ECD4_u32, 0xC040A8C1_u32, 0xC02D64AE_u32, 0xC01A209B_u32, 0xC006DC87_u32, 0xBFE730E8_u32, 0xBFC0A8C1_u32, 0xBF9A209B_u32, 0xBF6730E8_u32, 0xBF1A209B_u32, 0xBE9A209B_u32, 0x00000000_u32, 0x3E9A209B_u32, 0x3F1A209B_u32, 0x3F6730E8_u32, 0x3F9A209B_u32, 0x3FC0A8C1_u32, 0x3FE730E8_u32, 0x4006DC87_u32, 0x401A209B_u32, 0x402D64AE_u32, 0x4040A8C1_u32, 0x4053ECD4_u32, 0x406730E8_u32, 0x407A74FB_u32, 0x4086DC87_u32, 0x40907E91_u32, 0x00000000_u32]

