### A U128 from its high and low words.
@inline
secret routine b128_expfam_w(hi: U64, lo: U64) -> U128
  return (LLVM::zero_extend[U64, U128](hi) << 64) | LLVM::zero_extend[U64, U128](lo)

### The high word of a U128.
@inline
secret routine b128_expfam_hi(u: U128) -> U64
  return LLVM::int_truncate[U128, U64](u >>> 64)

### The low word of a U128.
@inline
secret routine b128_expfam_lo(u: U128) -> U64
  return LLVM::int_truncate[U128, U64](u)

### The full 128-bit product of two words.
@inline
secret routine b128_expfam_mul(a: U64, b: U64) -> U128
  return LLVM::zero_extend[U64, U128](a) *% LLVM::zero_extend[U64, U128](b)

### The high word of the product of two words.
@inline
secret routine b128_expfam_mhuu(a: U64, b: U64) -> U64
  return b128_expfam_hi(u: b128_expfam_mul(a: a, b: b))

### The approximate high half of a 128x128-bit product (the a0*b0 word and the carries out of the low
### words are dropped).
@inline
secret routine b128_expfam_mhuu128(a: U128, b: U128) -> U128
  var a0 = b128_expfam_lo(u: a)
  var a1 = b128_expfam_hi(u: a)
  var b0 = b128_expfam_lo(u: b)
  var b1 = b128_expfam_hi(u: b)
  var r = b128_expfam_mul(a: a1, b: b1)
  r = r +% LLVM::zero_extend[U64, U128](b128_expfam_mhuu(a: a1, b: b0))
  r = r +% LLVM::zero_extend[U64, U128](b128_expfam_mhuu(a: a0, b: b1))
  return r

### a*b/2^64 + c for a word a and 128-bit b and c, the low product word truncated.
@inline
secret routine b128_expfam_mahu128(a: U64, b: U128, c: U128) -> U128
  var s = c +% LLVM::zero_extend[U64, U128](b128_expfam_mhuu(a: a, b: b128_expfam_lo(u: b)))
  return b128_expfam_mul(a: a, b: b128_expfam_hi(u: b)) +% s

### Arithmetic (sign-propagating) right shift of a word by n (n < 64).
@inline
secret routine b128_expfam_sar(v: U64, n: U64) -> U64
  var s = LLVM::reinterpret_bits[U64, S64](v) >> LLVM::int_truncate[U64, U32](n)
  return LLVM::reinterpret_bits[S64, U64](s)

### Left shift of a word by n (n < 64).
@inline
secret routine b128_expfam_shl(v: U64, n: U64) -> U64
  return v << LLVM::int_truncate[U64, U32](n)

### Logical right shift of a word by n (n < 64).
@inline
secret routine b128_expfam_shr(v: U64, n: U64) -> U64
  return v >>> LLVM::int_truncate[U64, U32](n)

### The approximate high part of a 3-word by 2-word product: the words from position 2 up, with the a0*b0
### product and the low words of a0*b1 and a1*b0 dropped (a = a0 + a1*2^64 + a2*2^128).
@inline
secret routine b128_expfam_mh3x2(a0: U64, a1: U64, a2: U64, b: U128) -> (U64, U64, U64)
  var b0 = b128_expfam_lo(u: b)
  var b1 = b128_expfam_hi(u: b)
  var p01 = b128_expfam_mul(a: a0, b: b1)
  var p10 = b128_expfam_mul(a: a1, b: b0)
  var p11 = b128_expfam_mul(a: a1, b: b1)
  var p20 = b128_expfam_mul(a: a2, b: b0)
  var p21 = b128_expfam_mul(a: a2, b: b1)
  var col2 = LLVM::zero_extend[U64, U128](b128_expfam_lo(u: p11)) +% LLVM::zero_extend[U64, U128](b128_expfam_lo(u: p20))
  col2 = col2 +% LLVM::zero_extend[U64, U128](b128_expfam_hi(u: p01)) +% LLVM::zero_extend[U64, U128](b128_expfam_hi(u: p10))
  var col3 = (col2 >>> 64) +% LLVM::zero_extend[U64, U128](b128_expfam_hi(u: p11)) +% LLVM::zero_extend[U64, U128](b128_expfam_hi(u: p20))
  col3 = col3 +% LLVM::zero_extend[U64, U128](b128_expfam_lo(u: p21))
  var w2 = b128_expfam_hi(u: col3) +% b128_expfam_hi(u: p21)
  return (b128_expfam_lo(u: col2), b128_expfam_lo(u: col3), w2)

### Arithmetic right shift of the 3-word value (w0, w1, w2) by n bits (n < 192).
@inline
secret routine b128_expfam_ars3(w0: U64, w1: U64, w2: U64, n: U64) -> (U64, U64, U64)
  var sgn = b128_expfam_sar(v: w2, n: 63_u64)
  var rk = n & 63
  var qk = n >>> 6
  if qk == 0
    if rk == 0
      return (w0, w1, w2)
    var lk = 64_u64 -% rk
    return (b128_expfam_shl(v: w1, n: lk) | b128_expfam_shr(v: w0, n: rk), b128_expfam_shl(v: w2, n: lk) | b128_expfam_shr(v: w1, n: rk), b128_expfam_sar(v: w2, n: rk))
  if qk == 1
    if rk == 0
      return (w1, w2, sgn)
    var lk1 = 64_u64 -% rk
    return (b128_expfam_shl(v: w2, n: lk1) | b128_expfam_shr(v: w1, n: rk), b128_expfam_sar(v: w2, n: rk), sgn)
  return (b128_expfam_sar(v: w2, n: rk), sgn, sgn)

### Finishes exp, exp2 or exp10 from the reduced argument (fs0, fs1, fs2): a 2's complement fixed-point
### value of x*log2(base) whose integer part sits above the 20 low bits of fs2. x0 is the input's bit
### pattern (for the fallback paths). Returns the correctly rounded result.
@inline
secret routine b128_expfam_finish(fs0: U64, fs1: U64, fs2: U64, x0: U128, kind: U64) -> B128
  var el = LLVM::reinterpret_bits[U64, S64](fs2) >> 20
  var i0 = (fs2 >>> 15) & 31
  var i1 = (fs2 >>> 10) & 31
  var i2 = (fs2 >>> 5) & 31
  var i3 = fs2 & 31
  var z = fs1
  # 2^(z * 2^-84) by a degree-5 polynomial, the top terms in single words
  var f0 = b128_expfam_mhuu(a: z, b: B128_EXPFAM_C2[6] +% b128_expfam_mhuu(a: z, b: B128_EXPFAM_C2[8] +% b128_expfam_mhuu(a: z, b: B128_EXPFAM_C2[10])))
  var res = b128_expfam_w(hi: B128_EXPFAM_C2[5], lo: B128_EXPFAM_C2[4]) +% LLVM::zero_extend[U64, U128](f0)
  res = b128_expfam_mahu128(a: z, b: res, c: b128_expfam_w(hi: B128_EXPFAM_C2[3], lo: B128_EXPFAM_C2[2]))
  res = b128_expfam_mahu128(a: z, b: res, c: b128_expfam_w(hi: B128_EXPFAM_C2[1], lo: B128_EXPFAM_C2[0]))
  # 2^(i0/2^5 + i1/2^10 + i2/2^15 + i3/2^20) from the four tables
  var t0 = b128_expfam_w(hi: B128_EXPFAM_R0[(i0 << 1) | 1], lo: B128_EXPFAM_R0[i0 << 1])
  var t1 = b128_expfam_w(hi: B128_EXPFAM_R1[(i1 << 1) | 1], lo: B128_EXPFAM_R1[i1 << 1])
  var t2 = b128_expfam_w(hi: B128_EXPFAM_R2[(i2 << 1) | 1], lo: B128_EXPFAM_R2[i2 << 1])
  var t3 = b128_expfam_w(hi: B128_EXPFAM_R3[(i3 << 1) | 1], lo: B128_EXPFAM_R3[i3 << 1])
  var m = b128_expfam_mhuu128(a: b128_expfam_mhuu128(a: t0, b: t1), b: b128_expfam_mhuu128(a: t2, b: t3))
  # the lowest word of the reduced argument, times ln(2), as a first-order correction
  var k = b128_expfam_mhuu(a: 0xB17217F7D1CF79AC_u64, b: fs0)
  m = m +% (b128_expfam_mul(a: b128_expfam_hi(u: m), b: k) >>> 84)
  res = b128_expfam_mhuu128(a: res, b: m)
  var rnd = 0_u64
  if el >= -16382
    # rounding test: fall back when the 11 dropped bits are too close to a rounding boundary
    if ((b128_expfam_lo(u: res) +% 1030_u64) & 0x7FF_u64) <= 6
      var acc = b128_expfam_accurate(x0: x0, kind: kind)
      el = acc.item0
      res = acc.item1
    rnd = (b128_expfam_lo(u: res) >>> 10) & 1
    res = res >>> 11
    el = el +% 16382
  else
    # subnormal result
    if el > -16499
      var sh = LLVM::int_truncate[U64, U32](LLVM::reinterpret_bits[S64, U64](-16372 -% el))
      var s = 1_u128 << sh
      var msk = (2_u128 << sh) -% 1_u128
      if ((res +% s +% 6_u128) & msk) <= 6_u128
        var acc2 = b128_expfam_accurate(x0: x0, kind: kind)
        el = acc2.item0
        res = acc2.item1
      var sh2 = LLVM::int_truncate[U64, U32](LLVM::reinterpret_bits[S64, U64](-16372 -% el))
      rnd = b128_expfam_lo(u: res >>> sh2) & 1
      res = res >>> (sh2 +% 1)
    else
      rnd = 0_u64
      res = 0_u128
    el = 0
  res = res +% b128_expfam_w(hi: LLVM::reinterpret_bits[S64, U64](el) << 48, lo: rnd)
  return B128.from_bits(bits: res)

### The words at positions p .. p+nout-1 of the product of the na-word a and the nb-word b, keeping every
### partial-product word at a position >= p (lower words and their carries are dropped).
secret routine b128_expfam_tmul(a: Array[U64, 8], na: U64, b: Array[U64, 8], nb: U64, p: U64, nout: U64) -> Array[U64, 8]
  var lo = Array[U64, 16]()
  var hi = Array[U64, 16]()
  var i = 0_u64
  while i < na
    var j = 0_u64
    while j < nb
      var pr = b128_expfam_mul(a: a[i], b: b[j])
      var pos = i + j
      if pos >= p and pos - p < nout
        var s = LLVM::zero_extend[U64, U128](lo[pos - p]) +% LLVM::zero_extend[U64, U128](b128_expfam_lo(u: pr))
        lo[pos - p] = b128_expfam_lo(u: s)
        hi[pos - p] = hi[pos - p] +% b128_expfam_hi(u: s)
      if pos + 1 >= p and pos + 1 - p < nout
        var s2 = LLVM::zero_extend[U64, U128](lo[pos + 1 - p]) +% LLVM::zero_extend[U64, U128](b128_expfam_hi(u: pr))
        lo[pos + 1 - p] = b128_expfam_lo(u: s2)
        hi[pos + 1 - p] = hi[pos + 1 - p] +% b128_expfam_hi(u: s2)
      j = j + 1
    i = i + 1
  var o = Array[U64, 8]()
  var carry = 0_u128
  var q = 0_u64
  while q < nout
    var v = LLVM::zero_extend[U64, U128](lo[q]) +% carry
    o[q] = b128_expfam_lo(u: v)
    carry = (v >>> 64) +% LLVM::zero_extend[U64, U128](hi[q])
    q = q + 1
  return o

### floor(a*b/2^64) + c modulo 2^(64n), for a word a and n-word b and c.
secret routine b128_expfam_mahu(a: U64, b: Array[U64, 8], c: Array[U64, 8], n: U64) -> Array[U64, 8]
  var o = Array[U64, 8]()
  var carry = 0_u128
  var prev = b128_expfam_mul(a: a, b: b[0])
  var k = 0_u64
  while k < n
    var nxt = 0_u128
    if k + 1 < n
      nxt = b128_expfam_mul(a: a, b: b[k + 1])
    var acc = LLVM::zero_extend[U64, U128](b128_expfam_hi(u: prev)) +% LLVM::zero_extend[U64, U128](b128_expfam_lo(u: nxt))
    acc = acc +% LLVM::zero_extend[U64, U128](c[k]) +% carry
    o[k] = b128_expfam_lo(u: acc)
    carry = acc >>> 64
    prev = nxt
    k = k + 1
  return o

### Arithmetic right shift of the len-word value o by n bits (n < 64*len).
secret routine b128_expfam_ars(o: Array[U64, 8], len: U64, n: U64) -> Array[U64, 8]
  var r = o
  var rk = n & 63
  var qk = n >>> 6
  var h = o[len - 1]
  var j = 0_u64
  while j + qk + 1 < len
    if rk == 0
      r[j] = o[j + qk]
    else
      r[j] = b128_expfam_shl(v: o[j + qk + 1], n: 64_u64 - rk) | b128_expfam_shr(v: o[j + qk], n: rk)
    j = j + 1
  r[len - 1 - qk] = b128_expfam_sar(v: h, n: rk)
  var sgn = b128_expfam_sar(v: h, n: 63_u64)
  var t = len - qk
  while t < len
    r[t] = sgn
    t = t + 1
  return r

### Row `idx` of a flattened 3-word table: 0 = 2^(j/16), 1 = 2^(j/256), 2 = the accurate coefficients.
secret routine b128_expfam_row3(which: U64, idx: U64) -> Array[U64, 8]
  var o = Array[U64, 8]()
  var k = 0_u64
  while k < 3
    if which == 0
      o[k] = B128_EXPFAM_TBL0[3 * idx + k]
    elseif which == 1
      o[k] = B128_EXPFAM_TBL1[3 * idx + k]
    else
      o[k] = B128_EXPFAM_C3[3 * idx + k]
    k = k + 1
  return o

### Row `idx` of a flattened 6-word table: 0 = 2^(j/16), 1 = the superaccurate coefficients.
secret routine b128_expfam_row6(which: U64, idx: U64) -> Array[U64, 8]
  var o = Array[U64, 8]()
  var k = 0_u64
  while k < 6
    if which == 0
      o[k] = B128_EXPFAM_TBL6[6 * idx + k]
    else
      o[k] = B128_EXPFAM_C6[6 * idx + k]
    k = k + 1
  return o

### The fixed-point significand of x0 (with its implicit bit) times log2(base) in `len` words (4 or 7), the
### sign applied as a 1's complement after the product (exp, exp10) or a 2's complement (exp2), before the
### exponent shift.
secret routine b128_expfam_reduce_wide(x0: U128, kind: U64, len: U64) -> Array[U64, 8]
  var sm = b128_expfam_sar(v: b128_expfam_hi(u: x0), n: 63_u64)
  var t = (x0 & 0x0000FFFFFFFFFFFFFFFFFFFFFFFFFFFF_u128) | (1_u128 << 112)
  var x = Array[U64, 8]()
  if kind == 1
    var smw = b128_expfam_w(hi: sm, lo: sm)
    t = (t ^ smw) -% smw
    x[len - 2] = b128_expfam_lo(u: t)
    x[len - 1] = b128_expfam_hi(u: t)
    return x
  var a = Array[U64, 8]()
  var k = 0_u64
  while k < len
    if kind == 0
      a[k] = B128_EXPFAM_ILN2[7 - len + k]
    else
      a[k] = B128_EXPFAM_ILN102[7 - len + k]
    k = k + 1
  var b = Array[U64, 8]()
  b[0] = b128_expfam_lo(u: t)
  b[1] = b128_expfam_hi(u: t)
  x = b128_expfam_tmul(a: a, na: len, b: b, nb: 2_u64, p: 2_u64, nout: len)
  var q = 0_u64
  while q < len
    x[q] = x[q] ^ sm
    q = q + 1
  return x

### The exponent shift of the wide reductions: 0x402e (exp), 0x402f (exp2) or 0x402d (exp10) minus the
### biased exponent of x0.
secret routine b128_expfam_wide_shift(x0: U128, kind: U64) -> U64
  var e = (b128_expfam_hi(u: x0) >>> 48) & 0x7FFF_u64
  if kind == 0
    return 0x402E_u64 - e
  if kind == 1
    return 0x402F_u64 - e
  return 0x402D_u64 - e

### The accurate path: returns the unbiased exponent and the 2^x significand for the finishing step, or
### defers to the superaccurate path when this result is still too close to a rounding boundary.
secret routine b128_expfam_accurate(x0: U128, kind: U64) -> (S64, U128)
  var x = b128_expfam_reduce_wide(x0: x0, kind: kind, len: 4_u64)
  x = b128_expfam_ars(o: x, len: 4_u64, n: b128_expfam_wide_shift(x0: x0, kind: kind))
  var el = LLVM::reinterpret_bits[U64, S64](x[3])
  var jt0 = x[2] >>> 60
  var jt1 = (x[2] >>> 56) & 15
  x[2] = x[2] & 0x00FFFFFFFFFFFFFF_u64
  var ft = b128_expfam_tmul(a: b128_expfam_row3(which: 0_u64, idx: jt0), na: 3_u64, b: b128_expfam_row3(which: 1_u64, idx: jt1), nb: 3_u64, p: 3_u64, nout: 3_u64)
  # degree-14 polynomial in the top fraction word
  var f = b128_expfam_row3(which: 2_u64, idx: 14_u64)
  var i = 14_u64
  while i > 0
    i = i - 1
    f = b128_expfam_mahu(a: x[2], b: f, c: b128_expfam_row3(which: 2_u64, idx: i), n: 3_u64)
  ft = b128_expfam_tmul(a: f, na: 3_u64, b: ft, nb: 3_u64, p: 3_u64, nout: 3_u64)
  # the two low fraction words, by a first-order correction
  var c1 = b128_expfam_w(hi: B128_EXPFAM_C3[5], lo: B128_EXPFAM_C3[4])
  var f2 = b128_expfam_mhuu128(a: b128_expfam_w(hi: x[1], lo: x[0]), b: c1 +% LLVM::zero_extend[U64, U128](b128_expfam_mhuu(a: B128_EXPFAM_C3[8], b: x[1])))
  var f1 = Array[U64, 8]()
  f1[0] = b128_expfam_lo(u: f2)
  f1[1] = b128_expfam_hi(u: f2)
  f1[2] = B128_EXPFAM_C3[2]
  f = b128_expfam_tmul(a: ft, na: 3_u64, b: f1, nb: 3_u64, p: 3_u64, nout: 3_u64)
  var m = b128_expfam_w(hi: f[2] >>> 1, lo: (f[1] >>> 1) | (f[2] << 63))
  var rndfail = false
  if el >= -16382
    var g = b128_expfam_w(hi: f[1], lo: f[0])
    var d = (g +% 8_u128) & 0x000000000000000007FFFFFFFFFFFFFF_u128
    rndfail = d <= 16_u128
  else
    var s = LLVM::reinterpret_bits[S64, U64](-16371 - el)
    var w = b128_expfam_w(hi: f[1], lo: f[0]) +% 8_u128
    var ff0 = b128_expfam_lo(u: w)
    var ff1 = b128_expfam_hi(u: w)
    var ff2 = f[2]
    if w < 8_u128
      ff2 = ff2 +% 1
    if s < 64
      ff1 = ff1 & (b128_expfam_shl(v: 1_u64, n: s) -% 1)
      ff2 = 0_u64
    elseif s < 128
      ff2 = ff2 & (b128_expfam_shl(v: 1_u64, n: s - 64) -% 1)
    rndfail = ff0 <= 16 and (ff1 | ff2) == 0
  if rndfail
    return b128_expfam_superaccurate(x0: x0, kind: kind)
  return (el, m)

### The superaccurate path, used when the accurate result is too close to a rounding boundary: returns the
### unbiased exponent and the 2^x significand like the accurate path.
secret routine b128_expfam_superaccurate(x0: U128, kind: U64) -> (S64, U128)
  var x = b128_expfam_reduce_wide(x0: x0, kind: kind, len: 7_u64)
  x = b128_expfam_ars(o: x, len: 7_u64, n: b128_expfam_wide_shift(x0: x0, kind: kind))
  var el = LLVM::reinterpret_bits[U64, S64](x[6])
  var jt = x[5] >>> 60
  x[5] = x[5] & 0x0FFFFFFFFFFFFFFF_u64
  # degree-36 polynomial in the top fraction word
  var f = b128_expfam_row6(which: 1_u64, idx: 36_u64)
  var i = 36_u64
  while i > 0
    i = i - 1
    f = b128_expfam_mahu(a: x[5], b: f, c: b128_expfam_row6(which: 1_u64, idx: i), n: 6_u64)
  # the same series truncated per degree, in the next fraction word
  var a = Array[U64, 8]()
  var r = 5_u64
  while r >= 1
    var bb = Array[U64, 8]()
    var kk = 0_u64
    while r + kk < 6
      bb[kk] = B128_EXPFAM_C6[6 * r + r + kk]
      kk = kk + 1
    a = b128_expfam_mahu(a: x[4], b: a, c: bb, n: 6_u64)
    r = r - 1
  var f1 = b128_expfam_mahu(a: x[4], b: a, c: b128_expfam_row6(which: 1_u64, idx: 0_u64), n: 6_u64)
  # the four low fraction words, by a second-order correction
  var xs = Array[U64, 8]()
  xs[2] = x[0]
  xs[3] = x[1]
  xs[4] = x[2]
  xs[5] = x[3]
  var p2 = b128_expfam_tmul(a: xs, na: 6_u64, b: b128_expfam_row6(which: 1_u64, idx: 2_u64), nb: 6_u64, p: 6_u64, nout: 6_u64)
  var g = Array[U64, 8]()
  g[0] = p2[2]
  g[1] = p2[3]
  g[2] = p2[4]
  g[3] = p2[5]
  var carry = 0_u128
  var q = 0_u64
  while q < 6
    var v = LLVM::zero_extend[U64, U128](g[q]) +% LLVM::zero_extend[U64, U128](B128_EXPFAM_C6[6 + q]) +% carry
    g[q] = b128_expfam_lo(u: v)
    carry = v >>> 64
    q = q + 1
  p2 = b128_expfam_tmul(a: xs, na: 6_u64, b: g, nb: 6_u64, p: 6_u64, nout: 6_u64)
  var h = Array[U64, 8]()
  h[0] = p2[2]
  h[1] = p2[3]
  h[2] = p2[4]
  h[3] = p2[5]
  h[4] = B128_EXPFAM_C6[4]
  h[5] = B128_EXPFAM_C6[5]
  var ft = b128_expfam_tmul(a: f, na: 6_u64, b: f1, nb: 6_u64, p: 6_u64, nout: 6_u64)
  ft = b128_expfam_tmul(a: ft, na: 6_u64, b: h, nb: 6_u64, p: 6_u64, nout: 6_u64)
  ft = b128_expfam_tmul(a: ft, na: 6_u64, b: b128_expfam_row6(which: 0_u64, idx: jt), nb: 6_u64, p: 6_u64, nout: 6_u64)
  return (el, b128_expfam_w(hi: ft[5] >>> 1, lo: (ft[4] >>> 1) | (ft[5] << 63)))
