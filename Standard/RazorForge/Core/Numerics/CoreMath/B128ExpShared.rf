# Fixed-point log2(10) = ln(10)/ln(2), 7 words, least significant first.
secret preset B128_EXPFAM_ILN102: Array[U64, 7] = [
  0x1435EE480565CA55_u64, 0x3E24BEAB63AD0BD6_u64, 0x06650FDE9DD51F3A_u64, 0x91B6AC8082E7859D_u64,
