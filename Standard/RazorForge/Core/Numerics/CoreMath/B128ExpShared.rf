module Core

# ============================================================================
# Shared core of the correctly rounded B128 exp, exp2 and exp10
# ============================================================================
# Ported from CORE-MATH, src/binary128/exp/expq.c, src/binary128/exp2/exp2q.c and
# src/binary128/exp10/exp10q.c (https://core-math.gitlabpages.inria.fr/), which carry identical copies of
# these tables, of the 2^x evaluation and of its two fallback paths. The three functions differ only in how
# the argument becomes a fixed-point multiple of log2 (times 1/ln(2), times 1, times log2(10)).
# Copyright (c) 2025 Alexei Sibidanov <sibid@uvic.ca>
# Distributed under the MIT license: see LICENSE-CORE-MATH next to this file. RazorForge has no dynamic
# rounding modes, so only the round-to-nearest path of the original is kept (its rounding-mode probe,
# exception-flag and errno handling are dropped).
# All arithmetic is on 64-bit words. The multi-word products keep every partial-product word at or above
# the first output word and propagate all carries, which is exactly what the original carry chains compute.
# The `kind` parameter selects the argument reduction: 0 = exp, 1 = exp2, 2 = exp10.

# Fixed-point 1/ln(2), 7 words, least significant first.
secret preset B128_EXPFAM_ILN2: Array[U64, 7] = [
  0xEA90B9E60C4A90A0_u64, 0x24D92F75C16BE0B3_u64, 0xDE1C43F755176CD6_u64, 0x8B25166CD1A13247_u64,
  0xEB577AA8DD695A58_u64, 0xBE87FED0691D3E88_u64, 0xB8AA3B295C17F0BB_u64
]

