module Core

# ============================================================================
# Correctly rounded two-argument arc tangent of B64
# ============================================================================
# Ported from CORE-MATH, src/binary64/atan2/atan2.c and its 192-bit arithmetic header tint.h
# (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2024-2025 Paul Zimmermann and Alexei Sibidanov (atan2.c)
# Copyright (c) 2023-2024 Paul Zimmermann and Alexei Sibidanov (tint.h)
# Distributed under the MIT license: see LICENSE-CORE-MATH next to this file. RazorForge has no dynamic
# rounding modes, so only the round-to-nearest path of the original is kept (its errno and exception-flag
# handling are dropped).
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats.
#
# The accurate path works on "tint" values (-1)^sgn * (hm/2^128 + l/2^192) * 2^ex held in a tuple
# (hm: U128, l: U64, ex: S64, sgn: U64), where hm packs the two upper 64-bit words of the significand and
# its top bit is 1 unless the value is zero.

### Two-argument arc tangent atan2(y, x), correctly rounded: the exact angle of the point (x, y) rounded to
### the nearest `B64` (ties to even), identical on every platform. The result lies in [-pi, pi]; the signs
### of zero and infinite coordinates select the quadrant as in IEEE 754, and a NaN coordinate gives NaN.
### :param y: The y-coordinate.
### :param x: The x-coordinate.
### :returns: The correctly rounded angle in radians.
routine atan2(y: B64, x: B64) -> B64
  var iy = y.to_bits()
  var ix = x.to_bits()
  var aiy = iy & 0x7FFFFFFFFFFFFFFF_u64
  if aiy == 0 or aiy >= 0x7FF0000000000000_u64
    return b64_atan2_special(y: y, x: x)
  var aix = ix & 0x7FFFFFFFFFFFFFFF_u64
  if aix == 0 or aix >= 0x7FF0000000000000_u64
    return b64_atan2_special(y: y, x: x)
  # xm = max(|x|, |y|), ym = min(|x|, |y|)
  var xm = x.abs()
  var ym = y.abs()
  if ym > xm
    xm = y.abs()
    ym = x.abs()
  var sy = iy >>> 63
  var sx = ix >>> 63
  var gt = 0_u64
  if aix < aiy
    gt = 1_u64
  var dxy = (aix -% aiy) ^ (0_u64 -% gt)
  if dxy >= 0x0350000000000000_u64
    # the exponents differ by 53 or more
    return b64_atan2_accurate(y: y, x: x)
  var cs = 1.0
  if (gt ^ sx ^ sy) != 0
    cs = -1.0
  var kw = (sx << 2) | (sy << 1) | gt
  var jj = (ym /! xm) +! 2.0078125
  var jt = (jj.to_bits() >>> 45) & 127_u64
  var fh = B64.from_bits(bits: B64_ATAN2_F2H[jt]) *! cs
  var fl = B64.from_bits(bits: B64_ATAN2_F2L[jt]) *! cs
  fh = fh +! B64.from_bits(bits: B64_ATAN2_OH[kw])
  fl = fl +! B64.from_bits(bits: B64_ATAN2_OL[kw])
  if xm < 0x1p-920
    xm = xm *! 0x1p920
    ym = ym *! 0x1p920
  if xm > 0x1p1022
    if jt != 0
      xm = xm *! 0.5
      ym = ym *! 0.5
  var t0 = B64.from_bits(bits: B64_ATAN2_T2[jt])
  var zn = LLVM::fma[B64](a: -t0, b: xm, c: ym)
  var zd = LLVM::fma[B64](a: t0, b: ym, c: xm)
  var z = zn /! zd
  var z2 = z *! z
  z = z *! cs
  var dz = (z *! z2) *! (-0x1.55555555554d2p-2 +! (z2 *! (0x1.999999860e1cap-3 +! (z2 *! -0x1.248ad469844a1p-3))))
  var eps = (z.abs() *! 0x1.051p-51) +! 0x1p-90
  var s = b64_atan2_fasttwosum(x: fh, y: z)
  var rh = s.item0
  z = s.item1
  var rl = (fl +! dz) +! z
  var lb = rh +! (rl -! eps)
  var ub = rh +! (rl +! eps)
  if lb != ub
    var dh = ym *! t0
    var dl = LLVM::fma[B64](a: ym, b: t0, c: -dh)
    var s2 = b64_atan2_fasttwosum(x: xm, y: dh)
    dh = s2.item0
    var e = s2.item1
    var rdh = 1.0 /! dh
    dl = dl +! e
    var nh = xm *! t0
    var nl = LLVM::fma[B64](a: xm, b: t0, c: -nh)
    var dt = ym -! nh
    var y1 = dt +! nh
    var s3 = b64_atan2_fasttwosum(x: dt, y: -nl)
    if y1 != ym
      s3 = b64_atan2_fasttwosum(x: dt, y: (ym -! y1) -! nl)
    nh = s3.item0
    nl = s3.item1
    var zh = nh *! rdh
    z2 = zh *! zh
    var zl = rdh *! (LLVM::fma[B64](a: dh, b: -zh, c: nh) +! (nl -! ((nh *! rdh) *! dl)))
    var pa = -0x1.5555555555555p-2 +! (z2 *! 0x1.999999999755ep-3)
    var pb = -0x1.24924883596f8p-3 +! (z2 *! 0x1.c6f7d73531bc2p-4)
    zl = zl +! ((zh *! z2) *! (pa +! ((z2 *! z2) *! pb)))
    zh = zh *! cs
    zl = zl *! cs
    eps = 0x1.4p-50 *! ((zh.abs() *! z2) +! 0x1p-51)
    var f = b64_atan2_fastsum(xh: fh, xl: fl, yh: zh, yl: zl)
    fh = f.item0
    fl = f.item1
    lb = fh +! (fl -! eps)
    ub = fh +! (fl +! eps)
    if lb != ub
      return b64_atan2_accurate(y: y, x: x)
  return ub

### Sum `x + y` as a double-double (s, e), assuming |x| >= |y| or x == 0.
### :param x: The larger addend.
### :param y: The smaller addend.
### :returns: The rounded sum and its error.
secret routine b64_atan2_fasttwosum(x: B64, y: B64) -> (B64, B64)
  var s = x +! y
  var z = s -! x
  return (s, y -! z)

### Double-double sum (xh + xl) + (yh + yl), assuming |xh| >= |yh| or xh == 0.
### :param xh: The high part of the first operand.
### :param xl: The low part of the first operand.
### :param yh: The high part of the second operand.
### :param yl: The low part of the second operand.
### :returns: The high and low parts of the sum.
secret routine b64_atan2_fastsum(xh: B64, xl: B64, yh: B64, yl: B64) -> (B64, B64)
  var s = b64_atan2_fasttwosum(x: xh, y: yh)
  return (s.item0, (xl +! yl) +! s.item1)

### atan2 when a coordinate is zero, infinite or NaN.
### :param y: The y-coordinate.
### :param x: The x-coordinate.
### :returns: The correctly rounded angle.
secret routine b64_atan2_special(y: B64, x: B64) -> B64
  var iy = y.to_bits()
  var ix = x.to_bits()
  var aiy = iy << 1
  var aix = ix << 1
  var inf2 = 0xFFE0000000000000_u64
  var pih: B64 = 0x1.921fb54442d18p+1
  var pil: B64 = 0x1.1a62633145c07p-53
  var pi2h: B64 = 0x1.921fb54442d18p+0
  var pi2l: B64 = 0x1.1a62633145c07p-54
  if aiy >= inf2 or aix >= inf2
    if aiy > inf2 or aix > inf2
      # a NaN operand: like the x86 sum y + x, the first NaN operand wins, quieted
      if y.is_nan()
        return y +! y
      return x +! x
    # neither is NaN, at least one is infinite
    if aiy == inf2 and aix == inf2
      if (ix >>> 63) != 0
        # atan2(+/-Inf, -Inf) = +/-3pi/4
        var h3: B64 = 0x1.2d97c7f3321d2p+1
        var l3: B64 = 0x1p-54
        return h3.copysign(sign: y) +! l3.copysign(sign: y)
      # atan2(+/-Inf, +Inf) = +/-pi/4
      var h1: B64 = 0x1.921fb54442d18p-1
      var l1: B64 = 0x1p-55
      return h1.copysign(sign: y) +! l1.copysign(sign: y)
    if aix == inf2
      if x < 0.0
        return pih.copysign(sign: y) +! pil.copysign(sign: y)
      var zero = 0.0
      return zero.copysign(sign: y)
    # y = +/-Inf with finite x
    return pi2h.copysign(sign: y) +! pi2l.copysign(sign: y)
  if aiy == 0 or aix == 0
    if aiy == 0 and aix == 0
      if ix == 0
        return y
      if iy == 0
        return pih +! pil
      return -pih -! pil
    if aiy == 0
      if x > 0.0
        return y /! x
      if (iy >>> 63) == 0
        return pih +! pil
      return -pih -! pil
    if y > 0.0
      return pi2h +! pi2l
    return -pi2h -! pi2l
  return 0.0

### The accurate path: evaluates atan2(y, x) with a [29,29] rational approximation of atan in 192-bit
### tint arithmetic.
### :param y: The y-coordinate, finite and non-zero.
### :param x: The x-coordinate, finite and non-zero.
### :returns: The correctly rounded angle.
secret routine b64_atan2_accurate(y: B64, x: B64) -> B64
  var pih: B64 = 0x1.921fb54442d18p+1
  var pil: B64 = 0x1.1a62633145c07p-53
  var t = y /! x
  if t == 0.0
    if x > 0.0
      return t
    if y > 0.0
      return pih +! pil
    return -pih -! pil
  var corr = LLVM::fma[B64](a: t, b: x, c: -y)
  if corr == 0.0 and x > 0.0
    # t is exact
    if t.abs() <= 0x1.d12ed0af1a27fp-27
      if y.abs() >= 0x1p-915
        return LLVM::fma[B64](a: t, b: -0x1p-54, c: t)
      corr = LLVM::fma[B64](a: t *! 0x1p105, b: x, c: -y *! 0x1p105)
      if corr == 0.0
        return LLVM::fma[B64](a: t, b: -0x1p-54, c: t)
  var inv = y.abs() > x.abs()
  var z = b64_atan2_div(b: b64_atan2_from_b64(x: y), a: b64_atan2_from_b64(x: x))
  if inv
    z = b64_atan2_div(b: b64_atan2_from_b64(x: x), a: b64_atan2_from_b64(x: y))
  if not inv and x > 0.0 and z.item2 <= -96
    # atan(y/x) rounds like y/x perturbed slightly toward zero
    var zl = z.item1 -% 2
    var zh = LLVM::int_truncate[U128, U64](z.item0 >>> 64)
    var zm = LLVM::int_truncate[U128, U64](z.item0)
    if zl < 2
      zm = zm -% 1
    if zm < 1
      zh = zh -% 1
    return b64_atan2_to_b64(a: (b64_atan2_u128(hi: zh, lo: zm), zl, z.item2, z.item3), err: 1)
  # the rational approximation is only for z > 0
  var sz = z.item3
  z = (z.item0, z.item1, z.item2, 0_u64)
  var p = b64_atan2_p_coeff(i: 29)
  var q = b64_atan2_q_coeff(i: 29)
  var i = 29_u64
  while i > 0
    i = i - 1
    p = b64_atan2_mul(a: p, b: z)
    q = b64_atan2_mul(a: q, b: z)
    p = b64_atan2_add(a: p, b: b64_atan2_p_coeff(i: i))
    q = b64_atan2_add(a: q, b: b64_atan2_q_coeff(i: i))
  p = b64_atan2_mul(a: p, b: z)
  z = b64_atan2_div(b: p, a: q)
  var err = 662_u64
  z = (z.item0, z.item1, z.item2, sz)
  # z approximates atan(y/x) (or atan(x/y) when inv), with -pi/4 < z < pi/4
  var pi2 = b64_atan2_pi(ex: 1)
  if inv
    if z.item3 == 0
      # pi/2 - atan(x/y)
      z = b64_atan2_add(a: pi2, b: (z.item0, z.item1, z.item2, 1_u64))
    else
      # -pi/2 - atan(x/y)
      z = b64_atan2_add(a: z, b: pi2)
      z = (z.item0, z.item1, z.item2, 1_u64)
    err = 524
  # now -pi/2 < z < pi/2, a negative x moves to the opposite quadrant
  if x < 0.0
    var pi = b64_atan2_pi(ex: 2)
    if z.item3 == 0
      z = b64_atan2_add(a: pi, b: (z.item0, z.item1, z.item2, 1_u64))
      z = (z.item0, z.item1, z.item2, 1_u64)
    else
      z = b64_atan2_add(a: z, b: pi)
    err = 266
  return b64_atan2_to_b64(a: z, err: err)

### Builds a 128-bit integer from its two 64-bit halves.
### :param hi: The high 64 bits.
### :param lo: The low 64 bits.
### :returns: hi * 2^64 + lo.
secret routine b64_atan2_u128(hi: U64, lo: U64) -> U128
  return (LLVM::zero_extend[U64, U128](hi) << 64) | LLVM::zero_extend[U64, U128](lo)

### The tint pi (ex = 2) or pi/2 (ex = 1), with error below 2^-196.
### :param ex: The exponent, 2 for pi or 1 for pi/2.
### :returns: The tint constant.
secret routine b64_atan2_pi(ex: S64) -> (U128, U64, S64, U64)
  return (b64_atan2_u128(hi: 0xC90FDAA22168C234_u64, lo: 0xC4C6628B80DC1CD1_u64), 0x29024E088A67CC74_u64, ex, 0_u64)

### Coefficient i of the numerator polynomial P.
### :param i: The coefficient index, 0 to 29.
### :returns: The tint coefficient.
secret routine b64_atan2_p_coeff(i: U64) -> (U128, U64, S64, U64)
  return (b64_atan2_u128(hi: B64_ATAN2_PH[i], lo: B64_ATAN2_PM[i]), B64_ATAN2_PL[i], B64_ATAN2_PEX[i], B64_ATAN2_PSGN[i])

### Coefficient i of the denominator polynomial Q.
### :param i: The coefficient index, 0 to 29.
### :returns: The tint coefficient.
secret routine b64_atan2_q_coeff(i: U64) -> (U128, U64, S64, U64)
  return (b64_atan2_u128(hi: B64_ATAN2_QH[i], lo: B64_ATAN2_QM[i]), B64_ATAN2_QL[i], B64_ATAN2_QEX[i], B64_ATAN2_QSGN[i])

### Product of two tints, with error below 10 ulps.
### :param a: The first factor.
### :param b: The second factor.
### :returns: The tint product.
secret routine b64_atan2_mul(a: (U128, U64, S64, U64), b: (U128, U64, S64, U64)) -> (U128, U64, S64, U64)
  var mask = 0xFFFFFFFFFFFFFFFF_u128
  var ah = a.item0 >>> 64
  var am = a.item0 & mask
  var al = LLVM::zero_extend[U64, U128](a.item1)
  var bh = b.item0 >>> 64
  var bm = b.item0 & mask
  var bl = LLVM::zero_extend[U64, U128](b.item1)
  var rh = ah *% bh
  var rm1 = ah *% bm
  var rm2 = am *% bh
  var rl1 = ah *% bl
  var rl2 = am *% bm
  var rl3 = al *% bh
  var h = LLVM::int_truncate[U128, U64](rh >>> 64)
  var m = LLVM::int_truncate[U128, U64](rh)
  # accumulate rm1
  var l = LLVM::int_truncate[U128, U64](rm1)
  var t = LLVM::int_truncate[U128, U64](rm1 >>> 64)
  m = m +% t
  if m < t
    h = h +% 1
  # accumulate rm2
  var l2 = LLVM::int_truncate[U128, U64](rm2)
  t = LLVM::int_truncate[U128, U64](rm2 >>> 64)
  l = l +% l2
  var cm = 0_u64
  if l < l2
    cm = 1_u64
  m = m +% t
  if m < t
    h = h +% 1
  # accumulate rl1 + rl2 + rl3
  var sl = ((rl1 >>> 64) +% (rl2 >>> 64)) +% (rl3 >>> 64)
  var l3 = LLVM::int_truncate[U128, U64](sl)
  cm = cm +% LLVM::int_truncate[U128, U64](sl >>> 64)
  l = l +% l3
  if l < l3
    cm = cm +% 1
  # accumulate cm
  m = m +% cm
  if m < cm
    h = h +% 1
  var ex = a.item2 + b.item2
  if (h >>> 63) == 0
    # normalize
    h = (h << 1) | (m >>> 63)
    m = (m << 1) | (l >>> 63)
    l = l << 1
    ex = ex - 1
  return (b64_atan2_u128(hi: h, lo: m), l, ex, a.item3 ^ b.item3)

### Compares the absolute values of two tints.
### :param a: The first tint.
### :param b: The second tint.
### :returns: -1, 0 or +1 as |a| is below, equal to or above |b|.
secret routine b64_atan2_cmp_abs(a: (U128, U64, S64, U64), b: (U128, U64, S64, U64)) -> S64
  var az = (a.item0 >>> 64) == 0
  var bz = (b.item0 >>> 64) == 0
  if az
    if bz
      return 0
    return -1
  if bz
    return 1
  if a.item2 > b.item2
    return 1
  if a.item2 < b.item2
    return -1
  if a.item0 > b.item0
    return 1
  if a.item0 < b.item0
    return -1
  if a.item1 > b.item1
    return 1
  if a.item1 < b.item1
    return -1
  return 0

### Shifts a 192-bit significand right by k bits.
### :param h: The upper 128 bits.
### :param l: The lower 64 bits.
### :param k: The shift amount.
### :returns: The shifted significand (upper 128 bits, lower 64 bits).
secret routine b64_atan2_rshift(h: U128, l: U64, k: U64) -> (U128, U64)
  if k == 0
    return (h, l)
  if k < 64
    var s = LLVM::int_truncate[U64, U32](k)
    var c = LLVM::int_truncate[U64, U32](64 - k)
    return (h >>> s, LLVM::int_truncate[U128, U64](h << c) | (l >>> s))
  if k == 64
    return (h >>> 64, LLVM::int_truncate[U128, U64](h))
  if k < 128
    var s = LLVM::int_truncate[U64, U32](k)
    var c = LLVM::int_truncate[U64, U32](k - 64)
    return (h >>> s, LLVM::int_truncate[U128, U64](h >>> c))
  if k < 192
    var c = LLVM::int_truncate[U64, U32](k - 64)
    return (0_u128, LLVM::int_truncate[U128, U64](h >>> c))
  return (0_u128, 0_u64)

### Shifts a 192-bit significand left by k bits.
### :param h: The upper 128 bits.
### :param l: The lower 64 bits.
### :param k: The shift amount.
### :returns: The shifted significand (upper 128 bits, lower 64 bits).
secret routine b64_atan2_lshift(h: U128, l: U64, k: U64) -> (U128, U64)
  if k == 0
    return (h, l)
  var wl = LLVM::zero_extend[U64, U128](l)
  if k < 64
    var s = LLVM::int_truncate[U64, U32](k)
    var c = LLVM::int_truncate[U64, U32](64 - k)
    return ((h << s) | LLVM::zero_extend[U64, U128](l >>> c), l << s)
  if k == 64
    return ((h << 64) | wl, 0_u64)
  if k < 128
    var s = LLVM::int_truncate[U64, U32](k)
    var c = LLVM::int_truncate[U64, U32](k - 64)
    return ((h << s) | (wl << c), 0_u64)
  if k < 192
    var c = LLVM::int_truncate[U64, U32](k - 64)
    return (wl << c, 0_u64)
  return (0_u128, 0_u64)

### Leading zero count of a 192-bit significand.
### :param h: The upper 128 bits.
### :param l: The lower 64 bits.
### :returns: The number of leading zero bits.
secret routine b64_atan2_clz(h: U128, l: U64) -> U64
  if h != 0
    return LLVM::int_truncate[U128, U64](h.leading_zeros())
  return 128 + l.leading_zeros()

### Sum of two tints, with error below 2 ulps.
### :param a: The first addend.
### :param b: The second addend.
### :returns: The tint sum.
secret routine b64_atan2_add(a: (U128, U64, S64, U64), b: (U128, U64, S64, U64)) -> (U128, U64, S64, U64)
  var c = b64_atan2_cmp_abs(a: a, b: b)
  if c == 0
    if (a.item3 ^ b.item3) != 0
      return (0_u128, 0_u64, -1076, 0_u64)
    return (a.item0, a.item1, a.item2 + 1, a.item3)
  var u = a
  var v = b
  if c < 0
    u = b
    v = a
  # from now on |u| > |v|, thus u.ex >= v.ex
  var sh = LLVM::reinterpret_bits[S64, U64](u.item2) -% LLVM::reinterpret_bits[S64, U64](v.item2)
  var t = b64_atan2_rshift(h: v.item0, l: v.item1, k: sh)
  if (u.item3 ^ v.item3) != 0
    # opposite signs, a subtraction
    var tl = u.item1 -% t.item1
    var th = u.item0 -% t.item0
    if tl > u.item1
      th = th -% 1
    var ex = b64_atan2_clz(h: th, l: tl)
    if ex <= 1 or sh == 0
      var r = b64_atan2_lshift(h: th, l: tl, k: ex)
      return (r.item0, r.item1, u.item2 - LLVM::reinterpret_bits[U64, S64](ex), u.item3)
    # ex >= 2 and sh >= 1: redo the subtraction without neglecting the low part of v
    var t2 = b64_atan2_lshift(h: v.item0, l: v.item1, k: ex -% sh)
    var r0 = b64_atan2_lshift(h: u.item0, l: u.item1, k: ex)
    var ul = r0.item1 -% t2.item1
    var uh = r0.item0 -% t2.item0
    if ul > r0.item1
      uh = uh -% 1
    var ex1 = b64_atan2_clz(h: uh, l: ul)
    var r1 = b64_atan2_lshift(h: uh, l: ul, k: ex1)
    return (r1.item0, r1.item1, u.item2 - LLVM::reinterpret_bits[U64, S64](ex + ex1), u.item3)
  # same signs, an addition
  var ah = u.item0
  var al = u.item1
  var rl = al +% t.item1
  var cl = 0_u128
  if rl < al
    cl = 1_u128
  var rh = ah +% t.item0
  var ch = 0_u128
  if rh < ah
    ch = 1_u128
  rh = rh +% cl
  if rh < cl
    ch = ch +% 1
  if ch != 0
    rl = LLVM::int_truncate[U128, U64](rh << 63) | (rl >>> 1)
    rh = (ch << 127) | (rh >>> 1)
    return (rh, rl, u.item2 + 1, u.item3)
  return (rh, rl, u.item2, u.item3)

### Converts a finite non-zero B64 to a tint (exact).
### :param x: The value to convert.
### :returns: The tint equal to x.
secret routine b64_atan2_from_b64(x: B64) -> (U128, U64, S64, U64)
  var u = x.to_bits()
  var sgn = u >>> 63
  var ax = u & 0x7FFFFFFFFFFFFFFF_u64
  var e = ax >>> 52
  if e != 0
    # normal
    var hn = 0x8000000000000000_u64 | (ax << 11)
    return (LLVM::zero_extend[U64, U128](hn) << 64, 0_u64, LLVM::reinterpret_bits[U64, S64](e) - 0x3FE, sgn)
  # subnormal
  var lz = ax.leading_zeros()
  var hs = ax << LLVM::int_truncate[U64, U32](lz)
  return (LLVM::zero_extend[U64, U128](hs) << 64, 0_u64, -0x3F2 - LLVM::reinterpret_bits[U64, S64](lz), sgn)

### Rounds a tint to the nearest B64.
### :param a: The tint.
### :param err: 0 to truncate an exact double value, otherwise a bound in ulps on the error of the low word.
### :returns: The rounded value.
secret routine b64_atan2_to_b64(a: (U128, U64, S64, U64), err: U64) -> B64
  var sgn = a.item3
  var ex = a.item2
  if ex >= 1025
    # overflow: |a| >= 2^1024
    return B64.from_bits(bits: (sgn << 63) | 0x7FF0000000000000_u64)
  var hh = LLVM::int_truncate[U128, U64](a.item0 >>> 64)
  var mm = LLVM::int_truncate[U128, U64](a.item0)
  var ll = a.item1
  if ex <= -1074
    # underflow: |a| < 2^-1074
    if ex < -1074
      return B64.from_bits(bits: sgn << 63)
    # 2^-1075 <= |a| < 2^-1074: exactly 2^-1075 rounds to zero, anything above to 2^-1074
    if hh == 0x8000000000000000_u64 and mm == 0 and ll == 0
      return B64.from_bits(bits: sgn << 63)
    return B64.from_bits(bits: (sgn << 63) | 1_u64)
  var low = hh & 0x7FF_u64
  if ex <= -1022
    # subnormal result
    var sh = -1021 - ex
    var s = LLVM::int_truncate[U64, U32](LLVM::reinterpret_bits[S64, U64](sh))
    var c = LLVM::int_truncate[U64, U32](LLVM::reinterpret_bits[S64, U64](64 - sh))
    var sticky = 0_u64
    if ll > 0
      sticky = 1_u64
    ll = (mm << c) | (ll >>> s) | sticky
    mm = (hh << c) | (mm >>> s)
    hh = hh >>> s
    low = hh & 0x7FF_u64
    ex = ex + sh
  var h = LLVM::unsigned_to_float[U64, B64](hh >>> 11)
  var l = 0.0
  if err == 0
    l = 0.0
  elseif low < 0x400_u64
    # round toward zero
    l = 0.25
  elseif low > 0x400_u64
    # round away
    l = 0.75
  elseif mm == 0 and ll == 0
    # the middle case
    l = 0.5
  else
    l = 0.75
  var sg = 1.0
  if sgn != 0
    sg = -1.0
  h = LLVM::fma[B64](a: l, b: sg, c: sg *! h)
  h = h *! 0x1p-52
  # now -1021 <= ex <= 1024, thus 2^(ex-1) is a normal number
  var scale = B64.from_bits(bits: 0x3FF0000000000000_u64 +% (LLVM::reinterpret_bits[S64, U64](ex - 1) << 52))
  return h *! scale

### An approximation of 1/A, with absolute error below 2^-103.9 when 1 <= 1/A <= 2.
### :param a: The non-zero tint A.
### :returns: The tint approximating 1/A.
secret routine b64_atan2_inv(a: (U128, U64, S64, U64)) -> (U128, U64, S64, U64)
  var d = b64_atan2_to_b64(a: a, err: 0)
  var subnormal = d.abs() < 0x1p-1022
  if subnormal
    d = d *! 0x1p53
  var r = b64_atan2_from_b64(x: 1.0 /! d)
  if subnormal
    r = (r.item0, r.item1, r.item2 + 53, r.item3)
  # one Newton step r + r*(1 - a*r)
  var q = b64_atan2_mul(a: a, b: r)
  q = (q.item0, q.item1, q.item2, 1_u64 -% q.item3)
  q = b64_atan2_add(a: (0x80000000000000000000000000000000_u128, 0_u64, 1, 0_u64), b: q)
  q = b64_atan2_mul(a: r, b: q)
  return b64_atan2_add(a: r, b: q)

### An approximation of b/a, with relative error below 2^-185.53.
### :param b: The dividend.
### :param a: The non-zero divisor.
### :returns: The tint approximating b/a.
secret routine b64_atan2_div(b: (U128, U64, S64, U64), a: (U128, U64, S64, U64)) -> (U128, U64, S64, U64)
  var y = b64_atan2_inv(a: a)
  var r = b64_atan2_mul(a: y, b: b)
  # Karp-Markstein: r + y*(b - a*r)
  var z = b64_atan2_mul(a: a, b: r)
  z = (z.item0, z.item1, z.item2, 1_u64 -% z.item3)
  z = b64_atan2_add(a: b, b: z)
  z = b64_atan2_mul(a: y, b: z)
  return b64_atan2_add(a: r, b: z)

