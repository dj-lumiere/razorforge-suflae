module Core

# ============================================================================
# Correctly rounded arc cosine of B128
# ============================================================================
# Ported from CORE-MATH, src/binary128/acos/acosq.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2026 Alexei Sibidanov <sibid@uvic.ca>
# Distributed under the MIT license: see LICENSE-CORE-MATH next to this file. RazorForge has no dynamic
# rounding modes, so only the round-to-nearest path of the original is kept (its rounding-mode probe,
# exception-flag and errno handling and directed-rounding branches are dropped).
# Everything works on integers, never on the B128 arithmetic operators. The helpers and tables shared with
# the arc sine live in CoreMath/B128AsinFam.rf.
#
# acos(x) = pi/2 - asin(x): the arc sine is reduced as in B128Asin.rf (with the table of asin(s_j)/2 kept at
# half scale) and subtracted from pi/2. For x close to 1 (the last table points, x > 0) the result is
# computed directly from sqrt(1 - x^2) instead, which avoids the cancellation. A 128-bit fast path is
# checked against its error bound and falls back to a 320-bit accurate path.

### `acos(me)`, correctly rounded: the exact arc cosine rounded to the nearest `B128` (ties to even),
### identical on every platform. The result lies in [0, pi]. |me| > 1, ±infinity and a signaling NaN give
### NaN, and a quiet NaN is returned unchanged. No crash.
### :returns: The correctly rounded arc cosine in radians.
routine B128.acos_unchecked() -> B128
  var u = me.to_bits()
  var xb0 = LLVM::int_truncate[U128, U64](u)
  var xb1 = LLVM::int_truncate[U128, U64](u >>> 64)
  var xsgn = xb1 & 0x8000000000000000_u64
  xb1 = xb1 & 0x7FFFFFFFFFFFFFFF_u64
  var xn = b128_asinfam_s(u: xb1 >>> 48)
  if xn >= 0x3FFF
    # |x| >= 1, infinity or NaN
    if xb0 == 0_u64 and xb1 == 0x3FFF000000000000_u64
      if xsgn != 0_u64
        return B128.from_bits(bits: b128_asinfam_join(hi: 0x4000921FB54442D1_u64, lo: 0x8469898CC51701B8_u64))
      return B128.from_bits(bits: 0_u128)
    if xb1 >= 0x7FFF800000000000_u64
      return me
    return B128.from_bits(bits: b128_asinfam_join(hi: 0xFFFF800000000000_u64, lo: 0_u64))
  var j = b128_asinfam_jget(x: xb1)
  xb1 = xb1 | 0x0001000000000000_u64
  var xa = b128_asinfam_join(hi: xb1, lo: xb0) << 15
  xb0 = b128_asinfam_lo(u: xa)
  xb1 = b128_asinfam_hi(u: xa)
  var t = xa
  var nz = 0x3FFF -% xn
  # the reduced arc sine is subtracted from pi/2, except for x > 0 on the last table points
  var viapi2 = xsgn != 0_u64 or j < 71_u64
  var xc0 = 0_u64
  var xc1 = 0_u64
  var xc2 = 0_u64
  if j != 0_u64
    var red = b128_asinfam_fast_sqrt(x0: xb0, x1: xb1, nz: nz, mode: 1_u64)
    var e = red.item3
    if viapi2
      var xs = xa >>> b128_asinfam_sh(n: nz)
      var ci = j *% 5_u64
      var p = b128_asinfam_mh3d(y0: b128_asinfam_lo(u: xs), y1: b128_asinfam_hi(u: xs), x0: B128_ASINFAM_CTH[ci +% 2_u64], x1: B128_ASINFAM_CTH[ci +% 3_u64], x2: B128_ASINFAM_CTH[ci +% 4_u64])
      var sj = B128_ASINFAM_PTH[j]
      var sp = 43 -% (e >> 1)
      var sx0 = 0_u64
      var sx1 = 0_u64
      var sx2 = 0_u64
      if sp >= 0
        sj = sj << b128_asinfam_sh(n: sp)
        var m = b128_asinfam_mh3w(y: sj, x0: red.item0, x1: red.item1, x2: red.item2)
        sx0 = m.item0
        sx1 = m.item1
        sx2 = m.item2
      else
        var m = b128_asinfam_mh3w(y: sj, x0: red.item0, x1: red.item1, x2: red.item2)
        var rk = b128_asinfam_sh(n: 0 -% sp)
        var lk = b128_asinfam_sh(n: sp)
        sx0 = (m.item0 >>> rk) | (m.item1 << lk)
        sx1 = (m.item1 >>> rk) | (m.item2 << lk)
        sx2 = m.item2 >>> rk
      var d = b128_asinfam_sub3(a0: p.item0, a1: p.item1, a2: p.item2, b0: sx0, b1: sx1, b2: sx2)
      xc0 = d.item0
      xc1 = d.item1
      xc2 = d.item2
      nz = b128_asinfam_clz(x: xc2)
      var l = b128_asinfam_sh(n: nz)
      var r = b128_asinfam_sh(n: 0 -% nz)
      t = b128_asinfam_join(hi: (xc2 << l) | (xc1 >>> r), lo: (xc1 << l) | (xc0 >>> r))
    else
      nz = e >> 1
      xc0 = red.item0
      xc1 = red.item1
      xc2 = red.item2
      t = b128_asinfam_join(hi: xc2, lo: xc1)
  else
    if nz < 64
      xc0 = xb0 << b128_asinfam_sh(n: 0 -% nz)
      xc1 = (xb1 << b128_asinfam_sh(n: 0 -% nz)) | (xb0 >>> b128_asinfam_sh(n: nz))
      xc2 = xb1 >>> b128_asinfam_sh(n: nz)
    elseif nz < 128
      xc0 = ((xb1 << 1) << b128_asinfam_sh(n: nz ^ -1)) | (xb0 >>> b128_asinfam_sh(n: nz))
      xc1 = xb1 >>> b128_asinfam_sh(n: nz)
    elseif nz < 192
      xc0 = xb1 >>> b128_asinfam_sh(n: nz)
  var f = b128_asinfam_fast_poly(t: t, s2: 2 *% (nz -% 6))
  var f2 = b128_asinfam_hi(u: f)
  var f1 = b128_asinfam_lo(u: f)
  var f0 = 0_u64
  var v = 0_u128
  var rnd = 0_u64
  var msk = 0_u128
  var tl = 0_u128
  var eps = 0_u64
  if viapi2
    var sf = 3 *% nz +% 1
    if sf < 64
      f0 = f1 << b128_asinfam_sh(n: 0 -% sf)
      f1 = (f1 >>> b128_asinfam_sh(n: sf)) | (f2 << b128_asinfam_sh(n: 0 -% sf))
      f2 = f2 >>> b128_asinfam_sh(n: sf)
    elseif sf < 128
      f0 = (f1 >>> b128_asinfam_sh(n: sf)) | ((f2 << 1) << b128_asinfam_sh(n: sf ^ -1))
      f1 = f2 >>> b128_asinfam_sh(n: sf)
      f2 = 0_u64
    elseif sf < 192
      f0 = f2 >>> b128_asinfam_sh(n: sf)
      f1 = 0_u64
      f2 = 0_u64
    else
      f1 = 0_u64
      f2 = 0_u64
    var h0 = (xc0 >>> 1) | (xc1 << 63)
    var h1 = (xc1 >>> 1) | (xc2 << 63)
    var h2 = xc2 >>> 1
    var pi = j *% 5_u64
    var s = b128_asinfam_add3(a0: h0, a1: h1, a2: h2, b0: B128_ACOS_PHI0[pi +% 2_u64], b1: B128_ACOS_PHI0[pi +% 3_u64], b2: B128_ACOS_PHI0[pi +% 4_u64])
    s = b128_asinfam_add3(a0: s.item0, a1: s.item1, a2: s.item2, b0: f0, b1: f1, b2: f2)
    var m = 0_u64
    if xsgn != 0_u64
      m = 0xFFFFFFFFFFFFFFFF_u64
    s = b128_asinfam_sub3(a0: B128_ACOS_PHI0[362], a1: B128_ACOS_PHI0[363], a2: B128_ACOS_PHI0[364], b0: s.item0 ^ m, b1: s.item1 ^ m, b2: s.item2 ^ m)
    xc0 = s.item0
    xc1 = s.item1
    xc2 = s.item2
    var k = b128_asinfam_clz(x: xc2)
    rnd = (xc1 >>> b128_asinfam_sh(n: 14 -% k)) & 1_u64
    xn = 0x3FFF -% k
    if sf > 60
      sf = 60
    eps = 1_u64 << b128_asinfam_sh(n: 69 -% sf)
    msk = b128_asinfam_join(hi: 0xFFFFFFFFFFFFFFFF_u64 >>> b128_asinfam_sh(n: k +% 0x31 +% 1), lo: 0xFFFFFFFFFFFFFFFF_u64)
    tl = (b128_asinfam_join(hi: xc1, lo: xc0) +% LLVM::zero_extend[U64, U128](eps)) & msk
    if tl < LLVM::zero_extend[U64, U128](eps *% 2_u64)
      return b128_acos_accurate(x: me)
    v = b128_asinfam_join(hi: xc2 >>> b128_asinfam_sh(n: 15 -% k), lo: (xc1 >>> b128_asinfam_sh(n: 15 -% k)) | (xc2 << b128_asinfam_sh(n: 49 +% k)))
  else
    var sf = 2 *% nz
    if sf < 64
      f0 = f1 << b128_asinfam_sh(n: 0 -% sf)
      f1 = (f1 >>> b128_asinfam_sh(n: sf)) | (f2 << b128_asinfam_sh(n: 0 -% sf))
      f2 = f2 >>> b128_asinfam_sh(n: sf)
    else
      f0 = (f1 >>> b128_asinfam_sh(n: sf)) | ((f2 << 1) << b128_asinfam_sh(n: sf ^ -1))
      f1 = f2 >>> b128_asinfam_sh(n: sf)
      f2 = 0_u64
    var s = b128_asinfam_add3(a0: xc0, a1: xc1, a2: xc2, b0: f0, b1: f1, b2: f2)
    xc0 = s.item0
    xc1 = s.item1
    xc2 = s.item2
    var k = b128_asinfam_s(u: xc2 >>> 63)
    rnd = (xc1 >>> b128_asinfam_sh(n: 13 +% k)) & 1_u64
    v = b128_asinfam_join(hi: xc2, lo: xc1) >>> b128_asinfam_sh7(n: 14 +% k)
    v = v & 0x0000FFFFFFFFFFFFFFFFFFFFFFFFFFFF_u128
    xn = xn +% k -% nz
    if sf > 60
      sf = 60
    eps = 1_u64 << b128_asinfam_sh(n: 68 -% sf)
    msk = b128_asinfam_join(hi: 0xFFFFFFFFFFFFFFFF_u64 >>> b128_asinfam_sh(n: k +% 0x31 +% 1), lo: 0xFFFFFFFFFFFFFFFF_u64)
    tl = (b128_asinfam_join(hi: xc1, lo: xc0) +% LLVM::zero_extend[U64, U128](eps)) & msk
    if tl < LLVM::zero_extend[U64, U128](eps *% 2_u64)
      return b128_acos_accurate(x: me)
  v = v +% b128_asinfam_join(hi: b128_asinfam_u(n: xn) << 48, lo: rnd)
  return B128.from_bits(bits: v)

### Row j of the half-scale asin(s_j)/2 table as five words (row 72 is pi/4, i.e. (pi/2)/2).
secret routine b128_acos_phi0(j: U64) -> B128AsinFamW5
  var i = j *% 5_u64
  return B128AsinFamW5(w0: B128_ACOS_PHI0[i], w1: B128_ACOS_PHI0[i +% 1_u64], w2: B128_ACOS_PHI0[i +% 2_u64], w3: B128_ACOS_PHI0[i +% 3_u64], w4: B128_ACOS_PHI0[i +% 4_u64])

### The 320-bit accurate path of `acos_unchecked` for the inputs whose fast result cannot be rounded
### safely (the C as_acosq_accurate).
### :param x: The argument, with |x| < 1.
### :returns: The correctly rounded arc cosine.
secret routine b128_acos_accurate(x: B128) -> B128
  var u = x.to_bits()
  var xb0 = LLVM::int_truncate[U128, U64](u)
  var xb1 = LLVM::int_truncate[U128, U64](u >>> 64)
  var xsgn = xb1 & 0x8000000000000000_u64
  xb1 = xb1 & 0x7FFFFFFFFFFFFFFF_u64
  var xn = b128_asinfam_s(u: xb1 >>> 48)
  var j = b128_asinfam_jget(x: xb1)
  xb1 = xb1 | 0x0001000000000000_u64
  var xa = b128_asinfam_join(hi: xb1, lo: xb0) << 15
  xb0 = b128_asinfam_lo(u: xa)
  xb1 = b128_asinfam_hi(u: xa)
  var nz = 0x3FFF -% xn
  var viapi2 = xsgn != 0_u64 or j < 71_u64
  var t = B128AsinFamW5(w0: 0_u64, w1: 0_u64, w2: 0_u64, w3: xb0, w4: xb1)
  var xc = t
  if j != 0_u64
    var gc = b128_asinfam_getcos(ex: nz, x0: xb0, x1: xb1)
    var sq = gc.item0
    var e = gc.item1
    if viapi2
      var xs = xa >>> b128_asinfam_sh(n: nz)
      xc = b128_asinfam_mh5d(b0: b128_asinfam_lo(u: xs), b1: b128_asinfam_hi(u: xs), a: b128_asinfam_cth(j: j))
      var sj = B128_ASINFAM_PTH[j]
      var sp = 43 -% (e >> 1)
      if sp >= 0
        sj = sj << b128_asinfam_sh(n: sp)
      sq = b128_asinfam_mh5w(b0: sj, a: sq)
      if sp < 0
        sq = b128_asinfam_shrn5(a: sq, k: 0 -% sp)
      xc = b128_asinfam_sub5(a: xc, b: sq)
      t = xc
      if t.w4 != 0_u64
        nz = b128_asinfam_clz(x: t.w4)
      elseif t.w3 != 0_u64
        nz = b128_asinfam_clz(x: t.w3) +% 64
      elseif t.w2 != 0_u64
        nz = b128_asinfam_clz(x: t.w2) +% 128
      elseif t.w1 != 0_u64
        nz = b128_asinfam_clz(x: t.w1) +% 192
      elseif t.w0 != 0_u64
        nz = b128_asinfam_clz(x: t.w0) +% 256
      t = b128_asinfam_shln5(a: t, k: nz)
    else
      nz = e >> 1
      xc = sq
      t = sq
  else
    xc = b128_asinfam_shrn5(a: xc, k: nz)
  var t2 = b128_asinfam_sqrh5(a: t)
  var t3 = b128_asinfam_mh5(b: t, a: t2)
  t2 = b128_asinfam_shrn5(a: t2, k: 2 *% (nz -% 6) -% 1)
  var f = b128_asinfam_evalpoly(t2: t2)
  f = b128_asinfam_mh5(b: t3, a: f)
  var v = 0_u128
  var rnd = 0_u64
  if viapi2
    f = b128_asinfam_shrn5(a: f, k: 3 *% nz +% 1)
    xc = b128_asinfam_shrn5(a: xc, k: 1)
    xc = b128_asinfam_add5(a: b128_acos_phi0(j: j), b: xc)
    xc = b128_asinfam_add5(a: xc, b: f)
    if xsgn != 0_u64
      xc = b128_asinfam_add5(a: b128_acos_phi0(j: 72_u64), b: xc)
    else
      xc = b128_asinfam_sub5(a: b128_acos_phi0(j: 72_u64), b: xc)
    var k = b128_asinfam_clz(x: xc.w4)
    rnd = (xc.w3 >>> b128_asinfam_sh(n: 14 -% k)) & 1_u64
    xn = 0x3FFF -% k
    v = b128_asinfam_join(hi: xc.w4 >>> b128_asinfam_sh(n: 15 -% k), lo: (xc.w3 >>> b128_asinfam_sh(n: 15 -% k)) | (xc.w4 << b128_asinfam_sh(n: 49 +% k)))
  else
    f = b128_asinfam_shrn5(a: f, k: 2 *% nz)
    xc = b128_asinfam_add5(a: xc, b: f)
    var k = b128_asinfam_s(u: xc.w4 >>> 63)
    rnd = (xc.w3 >>> b128_asinfam_sh(n: 13 +% k)) & 1_u64
    v = b128_asinfam_join(hi: xc.w4, lo: xc.w3) >>> b128_asinfam_sh(n: 14 +% k)
    xn = xn +% k -% nz
    v = v & 0x0000FFFFFFFFFFFFFFFFFFFFFFFFFFFF_u128
  v = v +% b128_asinfam_join(hi: b128_asinfam_u(n: xn) << 48, lo: rnd)
  return B128.from_bits(bits: v)

# asin(PTH[j])/2 as five-word fixed-point values, one row per table point; row 72 is (pi/2)/2
secret preset B128_ACOS_PHI0: Array[U64, 365] = [
  0x0000000000000000_u64, 0x0000000000000000_u64, 0x0000000000000000_u64, 0x0000000000000000_u64, 0x0000000000000000_u64,
  0x98EE01DC297EF137_u64, 0x833839E554B92130_u64, 0x0A35967BC3749AFB_u64, 0x09800DF8DDC2A5E2_u64, 0x016587438F269B93_u64,
  0xCFEC743AC824B7B9_u64, 0x66EC76EB4FB09DF3_u64, 0x5265DF8B7C3F33C1_u64, 0xDBF35587E9E2CD87_u64, 0x02CAFA166DC09244_u64,
  0xD9EA018B49A9A7AC_u64, 0x2E80D2FD5768E869_u64, 0x7F990060E27CA191_u64, 0xACFB3347CDAB5663_u64, 0x0430C42FFB6051AE_u64,
  0x5A7D59FE33FBD45C_u64, 0xFAC32E4E4B697D19_u64, 0x14A12D811A08C9D1_u64, 0xA458339E940758E1_u64, 0x0595D06EA0A22010_u64,
  0xBC86EFE2E5F48417_u64, 0x8E3EE3AE76D8513A_u64, 0x640A9FC17520D677_u64, 0xB5CAB3F8D569E3B5_u64, 0x06FB8B520DDDC5BE_u64,
