module Core

# ============================================================================
# Correctly rounded complementary error function of B32
# ============================================================================
# Ported from CORE-MATH, src/binary32/erfc/erfcf.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2023-2025 Alexei Sibidanov. Distributed under the MIT license: see LICENSE-CORE-MATH next to
# this file. RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the original
# is kept (its errno handling is dropped).
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats.

### Complementary error function `1 - erf(x)`, correctly rounded: the exact erfc rounded to the nearest
### `B32` (ties to even), identical on every platform. `-infinity` maps to 2, `+infinity` to 0, and NaN
### stays NaN.
### :returns: The correctly rounded complementary error function.
routine B32.erfc() -> B32
  var ax = me.abs()
  var axd = B64(from: ax)
  var x2 = axd *! axd
  var tu = me.to_bits()
  var at = tu & 0x7FFFFFFF_u32
  var sgn = LLVM::zero_extend[U32, U64](tu >>> 31)
  var i = 0_u64
  if at > 0x40051000_u32
    i = 1
  if tu > 0xC07547CA_u32
    # x < -0x1.ea8f94p+1: erfc(x) rounds to 2
    if tu >= 0xFF800000_u32
      if tu == 0xFF800000_u32
        return 2.0_b32
      return me +! me
    return 2.0_b32 -! 0x1p-25_b32
  if at >= 0x4120DDFC_u32
    # |x| >= 0x1.41bbf8p+3: erfc(x) < 2^-150 rounds to 0
    if at >= 0x7F800000_u32
      if at == 0x7F800000_u32
        return 0.0_b32
      return me +! me
    return 0x1p-149_b32 *! 0.25_b32
  if at <= 0x3DB80000_u32
    # |x| <= 0x1.7p-4
    if tu == 0xB76C9F62_u32
      # x = -0x1.d93ec4p-17, an exceptional case
      return 0x1.00010ap+0_b32 +! 0x1p-25_b32
    if at <= 0x32E2DFC4_u32
      # |x| <= 0x1.c5bf88p-26: erfc(x) rounds to 1
      if at == 0
        return 1.0_b32
      if sgn == 0
        return 1.0_b32 +! -0x1p-26_b32
      return 1.0_b32 +! 0x1p-25_b32
    # around 0, erfc(x) behaves as 1 - (odd polynomial)
    var f0 = B64(from: me) *! (0x1.20dd750429b6dp+0 +! x2 *! (-0x1.812746b03610bp-2 +! x2 *! (0x1.ce2f218831d2fp-4 +! x2 *! (-0x1.b82c609607dcbp-6 +! x2 *! 0x1.553af09b8008ep-8))))
    return B32(from: 1.0 -! f0)
  # now -0x1.ea8f94p+1 <= x <= 0x1.41bbf8p+3, with |x| > 0x1.7p-4: erfc(x) = exp(-x^2) * s(x)
  var jt = x2 *! 0x1.71547652b82fep+0 -! 0x1.00004p+10
  var j = LLVM::reinterpret_bits[U64, S64](jt.to_bits() << 12) >> 48
  var sc = B64.from_bits(bits: LLVM::reinterpret_bits[S64, U64]((j >> 7) + LLVM::reinterpret_bits[U64, S64](0x3FF_u64 | (sgn << 11))) << 52)
  var jf = B64(from: j)
  var d = (x2 +! 0x1.62e42fefap-8 *! jf) +! 0x1.cf79abd6f5dc8p-47 *! jf
  var d2 = d *! d
  var ej = LLVM::reinterpret_bits[S64, U64](j & 127)
  var e0 = B64.from_bits(bits: B32_ERFC_E[ej])
  var f = d +! d2 *! ((-0x1.ffffffffff333p-2 +! d *! 0x1.5555555556a14p-3) +! d2 *! (-0x1.55556666659b4p-5 +! d *! 0x1.1111074cc7b22p-7))
  var b = i * 16
  var z = (axd -! B64.from_bits(bits: B32_ERFC_CT[b])) /! (axd +! B64.from_bits(bits: B32_ERFC_CT[b + 1]))
  var z2 = z *! z
  var z4 = z2 *! z2
  var z8 = z4 *! z4
  var c = b + 3
  var s = (((B64.from_bits(bits: B32_ERFC_CT[c]) +! z *! B64.from_bits(bits: B32_ERFC_CT[c + 1])) +! z2 *! (B64.from_bits(bits: B32_ERFC_CT[c + 2]) +! z *! B64.from_bits(bits: B32_ERFC_CT[c + 3]))) +! z4 *! ((B64.from_bits(bits: B32_ERFC_CT[c + 4]) +! z *! B64.from_bits(bits: B32_ERFC_CT[c + 5])) +! z2 *! (B64.from_bits(bits: B32_ERFC_CT[c + 6]) +! z *! B64.from_bits(bits: B32_ERFC_CT[c + 7])))) +! z8 *! (((B64.from_bits(bits: B32_ERFC_CT[c + 8]) +! z *! B64.from_bits(bits: B32_ERFC_CT[c + 9])) +! z2 *! (B64.from_bits(bits: B32_ERFC_CT[c + 10]) +! z *! B64.from_bits(bits: B32_ERFC_CT[c + 11]))) +! z4 *! B64.from_bits(bits: B32_ERFC_CT[c + 12]))
  s = B64.from_bits(bits: B32_ERFC_CT[b + 2]) +! z *! s
  var r = (sc *! (e0 -! f *! e0)) *! s
  var off = 0.0
  if sgn == 1
    off = 2.0
  return B32(from: off +! r)

### Table of 2^(j/128) for j in 0..127, as B64 bit patterns.
secret preset B32_ERFC_E: Array[U64, 128] = [0x3FF0000000000000_u64, 0x3FF0163DA9FB3335_u64, 0x3FF02C9A3E778061_u64, 0x3FF04315E86E7F85_u64, 0x3FF059B0D3158574_u64, 0x3FF0706B29DDF6DE_u64, 0x3FF0874518759BC8_u64, 0x3FF09E3ECAC6F383_u64, 0x3FF0B5586CF9890F_u64, 0x3FF0CC922B7247F7_u64, 0x3FF0E3EC32D3D1A2_u64, 0x3FF0FB66AFFED31B_u64, 0x3FF11301D0125B51_u64, 0x3FF12ABDC06C31CC_u64, 0x3FF1429AAEA92DE0_u64, 0x3FF15A98C8A58E51_u64, 0x3FF172B83C7D517B_u64, 0x3FF18AF9388C8DEA_u64, 0x3FF1A35BEB6FCB75_u64, 0x3FF1BBE084045CD4_u64, 0x3FF1D4873168B9AA_u64, 0x3FF1ED5022FCD91D_u64, 0x3FF2063B88628CD6_u64, 0x3FF21F49917DDC96_u64, 0x3FF2387A6E756238_u64, 0x3FF251CE4FB2A63F_u64, 0x3FF26B4565E27CDD_u64, 0x3FF284DFE1F56381_u64, 0x3FF29E9DF51FDEE1_u64, 0x3FF2B87FD0DAD990_u64, 0x3FF2D285A6E4030B_u64, 0x3FF2ECAFA93E2F56_u64, 0x3FF306FE0A31B715_u64, 0x3FF32170FC4CD831_u64, 0x3FF33C08B26416FF_u64, 0x3FF356C55F929FF1_u64, 0x3FF371A7373AA9CB_u64, 0x3FF38CAE6D05D866_u64, 0x3FF3A7DB34E59FF7_u64, 0x3FF3C32DC313A8E5_u64, 0x3FF3DEA64C123422_u64, 0x3FF3FA4504AC801C_u64, 0x3FF4160A21F72E2A_u64, 0x3FF431F5D950A897_u64, 0x3FF44E086061892D_u64, 0x3FF46A41ED1D0057_u64, 0x3FF486A2B5C13CD0_u64, 0x3FF4A32AF0D7D3DE_u64, 0x3FF4BFDAD5362A27_u64, 0x3FF4DCB299FDDD0D_u64, 0x3FF4F9B2769D2CA7_u64, 0x3FF516DAA2CF6642_u64, 0x3FF5342B569D4F82_u64, 0x3FF551A4CA5D920F_u64, 0x3FF56F4736B527DA_u64, 0x3FF58D12D497C7FD_u64, 0x3FF5AB07DD485429_u64, 0x3FF5C9268A5946B7_u64, 0x3FF5E76F15AD2148_u64, 0x3FF605E1B976DC09_u64, 0x3FF6247EB03A5585_u64, 0x3FF6434634CCC320_u64, 0x3FF6623882552225_u64, 0x3FF68155D44CA973_u64, 0x3FF6A09E667F3BCD_u64, 0x3FF6C012750BDABF_u64, 0x3FF6DFB23C651A2F_u64, 0x3FF6FF7DF9519484_u64, 0x3FF71F75E8EC5F74_u64, 0x3FF73F9A48A58174_u64, 0x3FF75FEB564267C9_u64, 0x3FF780694FDE5D3F_u64, 0x3FF7A11473EB0187_u64, 0x3FF7C1ED0130C132_u64, 0x3FF7E2F336CF4E62_u64, 0x3FF80427543E1A12_u64, 0x3FF82589994CCE13_u64, 0x3FF8471A4623C7AD_u64, 0x3FF868D99B4492ED_u64, 0x3FF88AC7D98A6699_u64, 0x3FF8ACE5422AA0DB_u64, 0x3FF8CF321