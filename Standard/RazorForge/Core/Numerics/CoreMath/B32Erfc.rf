### Two rational-reduction rows of 16 coefficients (for |x| <= 0x1.0a2p+1 and above), as B64 bit patterns:
### the shift and pole of z = (|x| - a)/(|x| + b), then the polynomial s(z).
secret preset B32_ERFC_CT: Array[U64, 32] = [0x3FEC162355429B28_u64, 0x400D99999999999A_u64, 0x3FDDA951CECE2B85_u64, 0xBFF70EF6CFF4BCC4_u64, 0x4003D7F7B3D617DE_u64, 0xC009D0AA47537C51_u64, 0x4009754EA9A3FCB1_u64, 0xC0027A5453FCC015_u64, 0x3FF1EF2E0531AEBA_u64, 0xBFCECA090F5A1C06_u64, 0xBFB7A3CD173A063C_u64, 0x3FB30FA68A68FDDD_u64, 0x3F555AD9A326993A_u64, 0xBF907E7B0BB39FBF_u64, 0x3F52328706C0E950_u64, 0x3F6D6AA0B7B19CFE_u64, 0x401137C8983F8516_u64, 0x400799999999999A_u64, 0x3FC05B53AA241333_u64, 0xBFCA3F53872BF870_u64, 0x3FBDE4C30742C9D5_u64, 0xBFACB24BFA591986_u64, 0x3F9666AEC059CA5F_u64, 0xBF7A61250EB26B0B_u64, 0x3F52B28B7924B34D_u64, 0x3F041B13A9D45013_u64, 0xBF16DD5E8A273613_u64, 0x3EF09CE8EA5E8DA5_u64, 0x3ED33923B4102981_u64, 0xBEC1DFD161E3F984_u64, 0xBE8C87618FCAE3B3_u64, 0x3E8E8A6FFA0BA2C7_u64]
