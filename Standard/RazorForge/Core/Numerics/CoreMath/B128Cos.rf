module Core

# ============================================================================
# Correctly rounded cosine of B128
# ============================================================================
# Ported from CORE-MATH, src/binary128/cos/cosq.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2026 Chen-Pang He <jdh863@gmail.com>
# Distributed under the MIT license: see LICENSE-CORE-MATH next to this file. RazorForge has no dynamic
# rounding modes, so only the round-to-nearest path of the original is kept (its rounding-mode probe,
# errno and exception-flag handling are dropped). The reduction, evaluation and rounding pipeline it shares
# with the sine lives in B128TrigShared.rf.

### Returns the cosine, correctly rounded: the exact cosine of this value (in radians) rounded to the nearest
### `B128` (ties to even), identical on every platform. `cos(-x) == cos(x)`, and ±infinity and NaN give
### NaN.
### :returns: The correctly rounded cosine.
routine B128.cos() -> B128
  return B128.from_bits(bits: b128_trig(bits: me.to_bits(), cosine: true))
