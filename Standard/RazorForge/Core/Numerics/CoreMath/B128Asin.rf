module Core

# ============================================================================
# Correctly rounded arc sine of B128
# ============================================================================
# Ported from CORE-MATH, src/binary128/asin/asinq.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2026 Alexei Sibidanov <sibid@uvic.ca>
# Distributed under the MIT license: see LICENSE-CORE-MATH next to this file. RazorForge has no dynamic
# rounding modes, so only the round-to-nearest path of the original is kept (its rounding-mode probe,
# exception-flag and errno handling and directed-rounding branches are dropped).
# Everything works on integers, never on the B128 arithmetic operators. The helpers and tables shared with
# the arc cosine live in CoreMath/B128AsinFam.rf.
#
# For |x| >= 0.022 the argument is reduced with the table point s_j = sin(pi/2/72*j):
# asin(x) = asin(s_j) + asin(x*sqrt(1 - s_j^2) - s_j*sqrt(1 - x^2)), and the small remainder goes through
# an odd polynomial. A 128-bit fast path is checked against its error bound and falls back to a 320-bit
# accurate path.

### `asin(me)`, correctly rounded: the exact arc sine rounded to the nearest `B128` (ties to even),
### identical on every platform. The result lies in [-pi/2, pi/2] and `asin(-x) == -asin(x)`. ±0 map to
### themselves; |me| > 1, ±infinity and a signaling NaN give NaN, and a quiet NaN is returned unchanged.
### No crash.
### :returns: The correctly rounded arc sine in radians.
routine B128.asin_unchecked() -> B128
  var u = me.to_bits()
  var xb0 = LLVM::int_truncate[U128, U64](u)
  var xb1 = LLVM::int_truncate[U128, U64](u >>> 64)
  var xsgn = xb1 & 0x8000000000000000_u64
  xb1 = xb1 & 0x7FFFFFFFFFFFFFFF_u64
  var xn = b128_asinfam_s(u: xb1 >>> 48)
  # for |x| < 2^-56 the difference asin(x) - x is below half an ulp
  if xn < 0x3FFF -% 56
    return me
  if xn >= 0x3FFF
    # |x| >= 1, infinity or NaN
    if xb0 == 0_u64 and xb1 == 0x3FFF000000000000_u64
      return B128.from_bits(bits: b128_asinfam_join(hi: 0x3FFF921FB54442D1_u64 | xsgn, lo: 0x8469898CC51701B8_u64))
    if xb1 >= 0x7FFF800000000000_u64
      return me
    return B128.from_bits(bits: b128_asinfam_join(hi: 0xFFFF800000000000_u64, lo: 0_u64))
  var j = b128_asinfam_jget(x: xb1)
  xb1 = xb1 | 0x0001000000000000_u64
  var xa = b128_asinfam_join(hi: xb1, lo: xb0) << 15
  xb0 = b128_asinfam_lo(u: xa)
  xb1 = b128_asinfam_hi(u: xa)
  var t = xa
  var nz = 0x3FFF -% xn
  var xc0 = 0_u64
  var xc1 = 0_u64
  var xc2 = 0_u64
  if j != 0_u64
    var red = b128_asinfam_fast_sqrt(x0: xb0, x1: xb1, nz: nz, mode: 0_u64)
    var e = red.item3
    var xs = xa >>> b128_asinfam_sh(n: nz)
    var ci = j *% 5_u64
    var p = b128_asinfam_mh3d(y0: b128_asinfam_lo(u: xs), y1: b128_asinfam_hi(u: xs), x0: B128_ASINFAM_CTH[ci +% 2_u64], x1: B128_ASINFAM_CTH[ci +% 3_u64], x2: B128_ASINFAM_CTH[ci +% 4_u64])
    var sj = B128_ASINFAM_PTH[j]
    var sp = 43 -% (e >> 1)
    var sx0 = 0_u64
    var sx1 = 0_u64
    var sx2 = 0_u64
    if sp >= 0
      sj = sj << b128_asinfam_sh(n: sp)
      var m = b128_asinfam_mh3w(y: sj, x0: red.item0, x1: red.item1, x2: red.item2)
      sx0 = m.item0
      sx1 = m.item1
      sx2 = m.item2
    else
      var m = b128_asinfam_mh3w(y: sj, x0: red.item0, x1: red.item1, x2: red.item2)
      var rk = b128_asinfam_sh(n: 0 -% sp)
      var lk = b128_asinfam_sh(n: 64 +% sp)
      sx0 = (m.item0 >>> rk) | (m.item1 << lk)
      sx1 = (m.item1 >>> rk) | (m.item2 << lk)
      sx2 = m.item2 >>> rk
    var d = b128_asinfam_sub3(a0: p.item0, a1: p.item1, a2: p.item2, b0: sx0, b1: sx1, b2: sx2)
    nz = b128_asinfam_clz(x: d.item2)
    var l = b128_asinfam_sh(n: nz)
    var r = b128_asinfam_sh(n: 0 -% nz)
    t = b128_asinfam_join(hi: (d.item2 << l) | (d.item1 >>> r), lo: (d.item1 << l) | (d.item0 >>> r))
    var pi = j *% 5_u64
    var s = b128_asinfam_add3(a0: d.item0, a1: d.item1, a2: d.item2, b0: B128_ASIN_PHI0[pi +% 2_u64], b1: B128_ASIN_PHI0[pi +% 3_u64], b2: B128_ASIN_PHI0[pi +% 4_u64])
    xc0 = s.item0
    xc1 = s.item1
    xc2 = s.item2
  var f = b128_asinfam_fast_poly(t: t, s2: 2 *% (nz -% 6))
  var v = 0_u128
  var rnd = 0_u64
  if j != 0_u64
    var sf = 3 *% nz
    var f2 = b128_asinfam_hi(u: f)
    var f1 = b128_asinfam_lo(u: f)
    var f0 = 0_u64
    if sf < 64
      f0 = f1 << b128_asinfam_sh(n: 0 -% sf)
      f1 = (f1 >>> b128_asinfam_sh(n: sf)) | (f2 << b128_asinfam_sh(n: 0 -% sf))
      f2 = f2 >>> b128_asinfam_sh(n: sf)
    elseif sf < 128
      var s1 = sf -% 64
      f0 = (f1 >>> b128_asinfam_sh(n: s1)) | ((f2 << 1) << b128_asinfam_sh(n: s1 ^ -1))
      f1 = f2 >>> b128_asinfam_sh(n: s1)
      f2 = 0_u64
    elseif sf < 192
      f0 = f2 >>> b128_asinfam_sh(n: sf -% 128)
      f1 = 0_u64
      f2 = 0_u64
    else
      f1 = 0_u64
      f2 = 0_u64
    var s = b128_asinfam_add3(a0: xc0, a1: xc1, a2: xc2, b0: f0, b1: f1, b2: f2)
    xc0 = s.item0
    xc1 = s.item1
    xc2 = s.item2
    var k = b128_asinfam_clz(x: xc2)
    rnd = (xc1 >>> b128_asinfam_sh(n: 14 -% k)) & 1_u64
    xn = 0x3FFE -% k
    var eps = 64_u64
    if 3 *% nz -% 6 <= 57
      eps = 0x8000000000000000_u64 >>> b128_asinfam_sh(n: 3 *% nz -% 6)
    var msk = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF_u128 >>> b128_asinfam_sh7(n: k +% 0x31 +% 1)
    var tl = (b128_asinfam_join(hi: xc1, lo: xc0) +% LLVM::zero_extend[U64, U128](eps)) & msk
    if tl < LLVM::zero_extend[U64, U128](eps *% 2_u64)
      return b128_asin_accurate(x: me)
    v = b128_asinfam_join(hi: xc2 >>> b128_asinfam_sh(n: 15 -% k), lo: (xc1 >>> b128_asinfam_sh(n: 15 -% k)) | (xc2 << b128_asinfam_sh(n: 49 +% k)))
  else
    var sf = 2 *% nz +% 1
    var g3 = b128_asinfam_hi(u: f)
    var g2 = b128_asinfam_lo(u: f)
    var g1 = 0_u64
    var g0 = 0_u64
    if sf < 64
      g1 = g2 << b128_asinfam_sh(n: 0 -% sf)
      g2 = (g2 >>> b128_asinfam_sh(n: sf)) | (g3 << b128_asinfam_sh(n: 0 -% sf))
      g3 = g3 >>> b128_asinfam_sh(n: sf)
    elseif sf < 128
      var s1 = sf -% 64
      g0 = g2 << b128_asinfam_sh(n: 0 -% s1)
      g1 = (g2 >>> b128_asinfam_sh(n: s1)) | ((g3 << 1) << b128_asinfam_sh(n: s1 ^ -1))
      g2 = g3 >>> b128_asinfam_sh(n: s1)
      g3 = 0_u64
    elseif sf < 192
      var s2 = sf -% 128
      g0 = (g2 >>> b128_asinfam_sh(n: s2)) | ((g3 << 1) << b128_asinfam_sh(n: s2 ^ -1))
      g1 = g2 >>> b128_asinfam_sh(n: s2)
      g2 = 0_u64
      g3 = 0_u64
    else
      g2 = 0_u64
      g3 = 0_u64
    var xh = xa >>> 1
    var a2 = b128_asinfam_ac(a: b128_asinfam_lo(u: xh), b: g2, c: 0_u64)
    var a3 = b128_asinfam_ac(a: b128_asinfam_hi(u: xh), b: g3, c: a2.item1)
    g2 = a2.item0
    g3 = a3.item0
    v = b128_asinfam_join(hi: g3, lo: g2)
    var k = b128_asinfam_s(u: g3 >>> 63)
    rnd = (g2 >>> b128_asinfam_sh(n: 13 +% k)) & 1_u64
    v = v >>> b128_asinfam_sh7(n: 14 +% k)
    v = v & 0x0000FFFFFFFFFFFFFFFFFFFFFFFFFFFF_u128
    xn = xn +% k
    var lk = 64 -% 13 -% k
    var rk = 64 -% lk
    var th = (g2 << b128_asinfam_sh(n: lk)) | (g1 >>> b128_asinfam_sh(n: rk))
    var tlo = (g1 << b128_asinfam_sh(n: lk)) | (g0 >>> b128_asinfam_sh(n: rk))
    var eps = 0x80000000000000000000000000000000_u128 >>> b128_asinfam_sh7(n: 8 +% 2 *% nz +% k)
    var tt = b128_asinfam_join(hi: th, lo: tlo) +% eps
    if tt < eps
      return b128_asin_accurate(x: me)
  v = v +% b128_asinfam_join(hi: (b128_asinfam_u(n: xn) << 48) | xsgn, lo: rnd)
  return B128.from_bits(bits: v)

### The 320-bit accurate path of `asin_unchecked` for the inputs whose fast result cannot be rounded
### safely (the C as_asinq_accurate).
### :param x: The argument, with 2^-57 <= |x| < 1.
### :returns: The correctly rounded arc sine.
secret routine b128_asin_accurate(x: B128) -> B128
  var u = x.to_bits()
  var xb0 = LLVM::int_truncate[U128, U64](u)
  var xb1 = LLVM::int_truncate[U128, U64](u >>> 64)
  var xsgn = xb1 & 0x8000000000000000_u64
  xb1 = xb1 & 0x7FFFFFFFFFFFFFFF_u64
  var xn = b128_asinfam_s(u: xb1 >>> 48)
  var j = b128_asinfam_jget(x: xb1)
  xb1 = xb1 | 0x0001000000000000_u64
  var xa = b128_asinfam_join(hi: xb1, lo: xb0) << 15
  xb0 = b128_asinfam_lo(u: xa)
  xb1 = b128_asinfam_hi(u: xa)
  var t = B128AsinFamW5(w0: 0_u64, w1: 0_u64, w2: 0_u64, w3: xb0, w4: xb1)
  var nz = 0x3FFF -% xn
  var xc = B128AsinFamW5(w0: 0_u64, w1: 0_u64, w2: 0_u64, w3: 0_u64, w4: 0_u64)
  if j != 0_u64
    var gc = b128_asinfam_getcos(ex: nz, x0: xb0, x1: xb1)
    var sq = gc.item0
    var e = gc.item1
    var xs = xa >>> b128_asinfam_sh(n: nz)
    xc = b128_asinfam_mh5d(b0: b128_asinfam_lo(u: xs), b1: b128_asinfam_hi(u: xs), a: b128_asinfam_cth(j: j))
    var sj = B128_ASINFAM_PTH[j]
    var sp = 43 -% (e >> 1)
    if sp >= 0
      sj = sj << b128_asinfam_sh(n: sp)
    sq = b128_asinfam_mh5w(b0: sj, a: sq)
    if sp < 0
      sq = b128_asinfam_shrn5(a: sq, k: 0 -% sp)
    xc = b128_asinfam_sub5(a: xc, b: sq)
    t = xc
    if t.w4 != 0_u64
      nz = b128_asinfam_clz(x: t.w4)
    elseif t.w3 != 0_u64
      nz = b128_asinfam_clz(x: t.w3) +% 64
    elseif t.w2 != 0_u64
      nz = b128_asinfam_clz(x: t.w2) +% 128
    elseif t.w1 != 0_u64
      nz = b128_asinfam_clz(x: t.w1) +% 192
    elseif t.w0 != 0_u64
      nz = b128_asinfam_clz(x: t.w0) +% 256
    t = b128_asinfam_shln5(a: t, k: nz)
    var pi = j *% 5_u64
    var ph = B128AsinFamW5(w0: B128_ASIN_PHI0[pi], w1: B128_ASIN_PHI0[pi +% 1_u64], w2: B128_ASIN_PHI0[pi +% 2_u64], w3: B128_ASIN_PHI0[pi +% 3_u64], w4: B128_ASIN_PHI0[pi +% 4_u64])
    xc = b128_asinfam_add5(a: ph, b: xc)
  var t2 = b128_asinfam_sqrh5(a: t)
  var t3 = b128_asinfam_mh5(b: t, a: t2)
  t2 = b128_asinfam_shrn5(a: t2, k: 2 *% (nz -% 6) -% 1)
  var f = b128_asinfam_evalpoly(t2: t2)
  f = b128_asinfam_mh5(b: t3, a: f)
  var v = 0_u128
  var rnd = 0_u64
  if j != 0_u64
    f = b128_asinfam_shrn5(a: f, k: 3 *% nz)
    xc = b128_asinfam_add5(a: xc, b: f)
    var k = b128_asinfam_clz(x: xc.w4)
    rnd = (xc.w3 >>> b128_asinfam_sh(n: 14 -% k)) & 1_u64
    xn = 0x3FFE -% k
    v = b128_asinfam_join(hi: xc.w4 >>> b128_asinfam_sh(n: 15 -% k), lo: (xc.w3 >>> b128_asinfam_sh(n: 15 -% k)) | (xc.w4 << b128_asinfam_sh(n: 49 +% k)))
  else
    f = b128_asinfam_shrn5(a: f, k: 2 *% nz +% 1)
    var xh = xa >>> 1
    var a3 = b128_asinfam_ac(a: b128_asinfam_lo(u: xh), b: f.w3, c: 0_u64)
    var a4 = b128_asinfam_ac(a: b128_asinfam_hi(u: xh), b: f.w4, c: a3.item1)
    var k = b128_asinfam_s(u: a4.item0 >>> 63)
    rnd = (a3.item0 >>> b128_asinfam_sh(n: 13 +% k)) & 1_u64
    v = b128_asinfam_join(hi: a4.item0, lo: a3.item0) >>> b128_asinfam_sh(n: 14 +% k)
    xn = xn +% k
    v = v & 0x0000FFFFFFFFFFFFFFFFFFFFFFFFFFFF_u128
  v = v +% b128_asinfam_join(hi: (b128_asinfam_u(n: xn) << 48) | xsgn, lo: rnd)
  return B128.from_bits(bits: v)

# asin(PTH[j]) as five-word fixed-point values, one row per table point
secret preset B128_ASIN_PHI0: Array[U64, 360] = [
  0x0000000000000000_u64, 0x0000000000000000_u64, 0x0000000000000000_u64, 0x0000000000000000_u64, 0x0000000000000000_u64,
  0x31DC03B852FDE26E_u64, 0x067073CAA9724261_u64, 0x146B2CF786E935F7_u64, 0x13001BF1BB854BC4_u64, 0x02CB0E871E4D3726_u64,
  0x9FD8E87590496F73_u64, 0xCDD8EDD69F613BE7_u64, 0xA4CBBF16F87E6782_u64, 0xB7E6AB0FD3C59B0E_u64, 0x0595F42CDB812489_u64,
  0xB3D4031693534F58_u64, 0x5D01A5FAAED1D0D3_u64, 0xFF3200C1C4F94322_u64, 0x59F6668F9B56ACC6_u64, 0x0861885FF6C0A35D_u64,
  0xB4FAB3FC67F7A8B9_u64, 0xF5865C9C96D2FA32_u64, 0x29425B02341193A3_u64, 0x48B0673D280EB1C2_u64, 0x0B2BA0DD41444021_u64,
  0x790DDFC5CBE9082F_u64, 0x1C7DC75CEDB0A275_u64, 0xC8153F82EA41ACEF_u64, 0x6B9567F1AAD3C76A_u64, 0x0DF716A41BBB8B7D_u64,
  0x6ED0830E8BE51BB2_u64, 0xF0E929895ECC82ED_u64, 0x7DE84CFCC54FE6F6_u64, 0x76BC77009FD70571_u64, 0x10C23F2FD8E3E9A0_u64,
  0x2AD1C043C574F910_u64, 0x713AD3D086FF14D2_u64, 0xBA270541AA876034_u64, 0x92D9E59DBF55C60D_u64, 0x138D717BA27EEABC_u64,
  0xB303FD12510F210A_u64, 0x94A653871859E237_u64, 0x0D1502EE17EB1BD7_u64, 0x3739065AEC5C06AB_u64, 0x1659054AE2B44A81_u64,
  0x006D05B30DABA4C3_u64, 0x6908BE7DDFD7775B_u64, 0xC00A83FEF85D99D7_u64, 0x795FA4F368B70F06_u64, 0x192349840A184357_u64,
