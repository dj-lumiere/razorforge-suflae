  r = b64_pow_mul_qint(a: b64_pow_t2_3(i: i1), b: r)
  r.ex = r.ex + big_m
  return r

### Rounds a `B64PowQint` in the subnormal range to its precision there (to nearest).
### :param a: The value.
### :returns: The value rounded at the subnormal precision, unchanged when a.ex > -1023.
secret routine b64_pow_subnormalize_qint(a: B64PowQint) -> B64PowQint
  if a.ex > -1023
    return a
  # a shift by 64 or more is masked to 6 bits, as the x86 shift instructions of the C original do
  var ex = b64_pow_u(n: 0 - (1011 + a.ex))
  var hh = b64_pow_hi(v: a.rh)
  var hi = hh >>> b64_pow_sh(n: ex & 63_u64)
  var md = (hh >>> b64_pow_sh(n: (ex - 1_u64) & 63_u64)) & 1_u64
  var lo = (hh & (0xFFFFFFFFFFFFFFFF_u64 >>> b64_pow_sh(n: ex & 63_u64))) != 0_u64 or b64_pow_lo(v: a.rh) != 0_u64 or a.rl != 0_u128
  if lo
    hi = hi +% md
  else
    hi = hi +% (hi & md)
  hh = hi << b64_pow_sh(n: ex & 63_u64)
  if hh == 0_u64
    return B64PowQint(rh: 1_u128 << 127, rl: 0_u128, ex: a.ex + 1, sgn: a.sgn)
  return B64PowQint(rh: b64_pow_join(hi: hh, lo: 0_u64), rl: 0_u128, ex: a.ex, sgn: a.sgn)

### Rounds a `B64PowQint` to the nearest `B64`.
### :param a: The value.
### :returns: The rounded value.
secret routine b64_pow_qint_tod(a: B64PowQint) -> B64
  var q = b64_pow_subnormalize_qint(a: a)
  var hh = b64_pow_hi(v: q.rh)
  var r = B64.from_bits(bits: (hh >>> 11) | 0x3FF0000000000000_u64)
  var rd = 0.0
  if (hh & 0x400_u64) != 0_u64
    rd = rd +! 0x1p-53
  if (hh & 0x3FF_u64) != 0_u64 or b64_pow_lo(v: q.rh) != 0_u64 or q.rl != 0_u128
    rd = rd +! 0x1p-54
  if q.sgn != 0_u64
    rd = -rd
  r = B64.from_bits(bits: r.to_bits() | (q.sgn << 63))
  r = r +! rd
  var e = 0.0
  if q.ex > -1023
    if q.ex > 1023
      if q.ex == 1024
        r = r *! 2.0
        e = 0x1p+1023
      else
        r = 0x1.fffffffffffffp+1023
        e = 0x1.fffffffffffffp+1023
    else
      e = B64.from_bits(bits: (b64_pow_u(n: q.ex + 1023) & 0x7FF_u64) << 52)
  else
    if q.ex < -1074
      if q.ex == -1075
        r = r *! 0.5
        e = B64.from_bits(bits: 1_u64)
      else
        r = B64.from_bits(bits: 1_u64)
        e = B64.from_bits(bits: 1_u64)
    else
      e = B64.from_bits(bits: 1_u64 << b64_pow_ssh(n: q.ex + 1074))
  return r *! e

