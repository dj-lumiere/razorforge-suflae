  r = b64_pow_add_qint_22(a: b64_pow_q_3_at(i: 1_u64), b: r)
  var k = 2_u64
  while k < 7_u64
    r = b64_pow_mul_qint_22(a: y, b: r)
    r = b64_pow_add_qint_22(a: b64_pow_q_3_at(i: k), b: r)
    k = k + 1_u64
  while k < 12_u64
    r = b64_pow_mul_qint_33(a: y, b: r)
    r = b64_pow_add_qint(a: b64_pow_q_3_at(i: k), b: r)
    k = k + 1_u64
  while k < 15_u64
    r = b64_pow_mul_qint(a: y, b: r)
    r = b64_pow_add_qint(a: b64_pow_q_3_at(i: k), b: r)
    k = k + 1_u64
  return r

### Approximates log(x) with relative error below 2^-250.74.
### :param x: The positive argument.
### :returns: The approximation.
secret routine b64_pow_log_3(x: B64PowQint) -> B64PowQint
  var big_e = x.ex
  var xh = b64_pow_hi(v: x.rh)
