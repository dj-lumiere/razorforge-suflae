module Core

# ============================================================================
# Correctly rounded power function of B64
# ============================================================================
# Ported from CORE-MATH, src/binary64/pow/pow.c (with its headers pow.h, dint.h and qint.h)
# (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2022-2025 CERN and Inria
# Authors: Tom Hubrecht and Paul Zimmermann
# Distributed under the MIT license: see LICENSE-CORE-MATH next to this file. RazorForge has no dynamic
# rounding modes, so only the round-to-nearest path of the original is kept (its rounding-mode probes,
# exception-flag save/restore, errno updates and directed-rounding branches are dropped).
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats.
#
# The algorithm has three phases: a fast double-double evaluation of exp(y * log(x)) with a rounding test,
# then a 128-bit evaluation (B64PowDint, the C `dint64_t`), an exact/midpoint detector, and finally a
# 256-bit evaluation (B64PowQint, the C `qint64_t`) for the hardest cases.

### Raises this value to the power `exp`, correctly rounded: the exact `me^exp` rounded to the nearest `B64`
### (ties to even), identical on every platform. Raw IEEE 754 propagation: overflow gives ±infinity, a
### domain error such as `(-1)^0.5` gives NaN, and `x^±0 == 1` and `1^y == 1` for every `x` and `y`
### (even NaN), following the IEEE 754 `pow` definition.
### :param exp: The exponent applied to `me`.
### :returns: `me` raised to `exp`, correctly rounded, possibly ±infinity or NaN.
routine B64.pow_unchecked(exp: B64) -> B64
  var x = me
  var y = exp
  # sign of the result
  var s = 1.0
  var x0 = x
  var xu = x.to_bits()
  var yu = y.to_bits()
  if xu >= 0x7FF0000000000000_u64 or yu >= 0x7FF0000000000000_u64
    if x.is_nan()
      # pow(x, ±0) = 1 when x is not a signaling NaN, x + x quiets a signaling NaN
      if y == 0.0 and (xu & 0x0008000000000000_u64) != 0
        return 1.0
      return x +! x
    if y.is_nan()
      # pow(1, y) = 1 for any y, even a quiet NaN
      if x == 1.0 and (yu & 0x0008000000000000_u64) != 0
        return 1.0
      return y +! y
    if xu == 0x7FF0000000000000_u64
      if y == 0.0
        return 1.0
      if y < 0.0
        return 0.0
      if y > 0.0
        return B64.from_bits(bits: 0x7FF0000000000000_u64)
    if xu == 0xFFF0000000000000_u64
      if yu == 0x7FF0000000000000_u64
        return y
      if yu == 0xFFF0000000000000_u64
        return 0.0
      # y is an odd integer
      if b64_pow_is_int(x: y) and not b64_pow_is_int(x: y *! 0.5)
        if y < 0.0
          return -0.0
        return B64.from_bits(bits: 0xFFF0000000000000_u64)
      if y < 0.0
        return 0.0
      if y > 0.0
        return B64.from_bits(bits: 0x7FF0000000000000_u64)
    if yu == 0x7FF0000000000000_u64
      if x == 0.0
        return 0.0
      if x == -1.0 or x == 1.0
        return 1.0
      if -1.0 < x and x < 1.0
        return 0.0
      if x < -1.0 or 1.0 < x
        return B64.from_bits(bits: 0x7FF0000000000000_u64)
    if yu == 0xFFF0000000000000_u64
      if x == 0.0
        return B64.from_bits(bits: 0x7FF0000000000000_u64)
      if x == -1.0 or x == 1.0
        return 1.0
      if -1.0 < x and x < 1.0
        return B64.from_bits(bits: 0x7FF0000000000000_u64)
      if x < -1.0 or 1.0 < x
        return 0.0
  # from now on, x and y are finite
  if x <= 0.0
    if y == 0.0
      return 1.0
    if xu == 0_u64
      # y is an odd integer
      if b64_pow_is_int(x: y) and not b64_pow_is_int(x: y *! 0.5)
        if y < 0.0
          return B64.from_bits(bits: 0x7FF0000000000000_u64)
        return 0.0
      if y > 0.0
        return 0.0
      return B64.from_bits(bits: 0x7FF0000000000000_u64)
    if xu == 0x8000000000000000_u64
      if b64_pow_is_int(x: y) and not b64_pow_is_int(x: y *! 0.5)
        if y < 0.0
          return B64.from_bits(bits: 0xFFF0000000000000_u64)
        return -0.0
      if y > 0.0
        return 0.0
      return B64.from_bits(bits: 0x7FF0000000000000_u64)
    if not b64_pow_is_int(x: y)
      return B64.from_bits(bits: B64_POW_NAN_BITS)
    # the result is negative when y is odd
    if y.abs() < 0x1p53
      var yi = LLVM::float_to_signed[B64, S64](y)
      if (LLVM::reinterpret_bits[S64, U64](yi) & 1_u64) != 0
        s = -1.0
    x = -x
  # ---------------------------------------------------------------- phase 1
  var lg = b64_pow_log_1(x: x)
  var lh = lg.h
  var ll = lg.l
  # avoid a spurious underflow or overflow in y * log(x)
  var ey = (yu >>> 52) & 0x7FF_u64
  if ey < 0x36_u64 or ey >= 0x7F5_u64
    lh = B64.from_bits(bits: B64_POW_NAN_BITS)
    ll = lh
  # approximate y * log(x)
  var rh = y *! lh
  var rs = LLVM::fma[B64](a: y, b: lh, c: -rh)
  var rl = LLVM::fma[B64](a: y, b: ll, c: rs)
  var ex1 = b64_pow_exp_1(rh: rh, rl: rl, s: s)
  var res_h = ex1.hi
  var res_l = ex1.lo
  var err = 0x1.27p-64
  if lg.cancel
    err = 0x1.57p-58
  var res_min = res_h +! LLVM::fma[B64](a: err, b: -res_h, c: res_l)
  var res_max = res_h +! LLVM::fma[B64](a: err, b: res_h, c: res_l)
  var exact = b64_pow_is_exact(x: x, y: y)
  if res_min == res_max
    return res_max
  # easy cases
  if y == 1.0
    return s *! x
  if y == 2.0
    return x *! x
  if y == 0.5
    return LLVM::sqrt[B64](x)
  if y == 0.0
    return 1.0
  # ---------------------------------------------------------------- phase 2
  var dx = b64_pow_dint_fromd(b: x)
  var dy = b64_pow_dint_fromd(b: y)
  dx.sgn = 0_u64
  var br = b64_pow_log_2(x: dx)
  br = b64_pow_mul_dint_21(a: br, b: dy)
  br = b64_pow_exp_2(x: br)
  # rounding test: 2^br.ex <= br < 2^(br.ex + 1)
  if br.ex < -1075
    # underflow
    return 0.5 *! (s *! B64.from_bits(bits: 1_u64))
  var rd = false
  if br.ex < -1022
    # subnormal case: the significand has to be shifted right by 1 <= sh <= 53 bits
    var sh = LLVM::reinterpret_bits[S64, U64](0 - (1022 + br.ex))
    var m = (b64_pow_lo(v: br.r) >>> b64_pow_sh(n: 10_u64 + sh)) | (b64_pow_hi(v: br.r) << b64_pow_sh(n: 54_u64 - sh))
    rd = m +% 14_u64 > 28_u64
  else
    # the 64 bits after the round bit
    var lo = (b64_pow_lo(v: br.r) >>> 10) | (b64_pow_hi(v: br.r) << 54)
    rd = lo +% 28_u64 > 56_u64
  if s == -1.0
    br.sgn = 1_u64
  else
    br.sgn = 0_u64
  if rd
    return b64_pow_dint_tod(a: br, exact: exact)
  # exact and midpoint cases
  var ep = b64_pow_exact_pow(x: x0, y: y, z: br, exact: exact)
  if not ep.is_nan()
    return ep
  # ---------------------------------------------------------------- phase 3
  var qx = b64_pow_qint_fromd(b: x)
  var qy = b64_pow_qint_fromd(b: y)
  qx.sgn = 0_u64
  var qr = b64_pow_log_3(x: qx)
  qr = b64_pow_mul_qint_41(a: qr, b: qy)
  var qz = b64_pow_exp_3(x: qr)
  var hh = b64_pow_hi(v: qz.rh)
  var hl = b64_pow_lo(v: qz.rh)
  var lh2 = b64_pow_hi(v: qz.rl)
  var ll2 = b64_pow_lo(v: qz.rl)
  var r1 = (hh << 54) | (hl >>> 10)
  var r2 = (hl << 54) | (lh2 >>> 10)
  var r3 = (lh2 << 54) | (ll2 >>> 10)
  var hard = false
  if r1 == 0_u64 and r2 == 0_u64 and r3 <= 60_u64
    hard = true
  if r1.bitnot() == 0_u64 and r2.bitnot() == 0_u64 and r3 +% 120_u64 <= 60_u64
    hard = true
  if not hard
    if s == -1.0
      qz.sgn = 1_u64
    else
      qz.sgn = 0_u64
    qz.rl = qz.rl & 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFC00_u128
    return b64_pow_qint_tod(a: qz)
  # x^y very close to 1: exp(qr) rounds to 1 (the sign of qr picks the side, which rounds to 1 anyway)
  if qr.ex < -56
    if qr.sgn == 0_u64
      return 1.0 +! 0x1p-100
    return 1.0 -! 0x1p-100
  # not reachable (CORE-MATH reports an unexpected worst case here)
  return b64_pow_qint_tod(a: qz)

### The quiet NaN produced by a domain error (the C `NAN`).
secret preset B64_POW_NAN_BITS: U64 = 0x7FF8000000000000_u64

# ============================================================================
# Small helpers
# ============================================================================

### Whether `x` is an integer (`x` finite).
### :param x: The value to test.
### :returns: True when `x` equals its round-to-nearest-even integer.
secret routine b64_pow_is_int(x: B64) -> Bool
  return x == LLVM::rint[B64](x)

### The 128-bit value `hi * 2^64 + lo`.
### :param hi: The upper 64 bits.
### :param lo: The lower 64 bits.
### :returns: The joined value.
secret routine b64_pow_join(hi: U64, lo: U64) -> U128
  return (LLVM::zero_extend[U64, U128](hi) << 64) | LLVM::zero_extend[U64, U128](lo)

### The upper 64 bits of `v`.
### :param v: A 128-bit value.
### :returns: `v >> 64`.
secret routine b64_pow_hi(v: U128) -> U64
  return LLVM::int_truncate[U128, U64](v >>> 64)

### The lower 64 bits of `v`.
### :param v: A 128-bit value.
### :returns: `v mod 2^64`.
secret routine b64_pow_lo(v: U128) -> U64
  return LLVM::int_truncate[U128, U64](v)

### The full 128-bit product of two 64-bit values.
### :param a: The first factor.
### :param b: The second factor.
### :returns: `a * b`, exact.
secret routine b64_pow_mul64(a: U64, b: U64) -> U128
  return LLVM::zero_extend[U64, U128](a) *% LLVM::zero_extend[U64, U128](b)

### A shift amount as the `U32` the shift operators take.
### :param n: The shift amount.
### :returns: `n` narrowed to `U32`.
secret routine b64_pow_sh(n: U64) -> U32
  return LLVM::int_truncate[U64, U32](n)

### A signed shift amount (known to be non-negative) as a `U32`.
### :param n: The shift amount.
### :returns: `n` narrowed to `U32`.
secret routine b64_pow_ssh(n: S64) -> U32
  return LLVM::int_truncate[U64, U32](LLVM::reinterpret_bits[S64, U64](n))

### A signed value reinterpreted as unsigned (two's complement).
### :param n: The signed value.
### :returns: The same bits as `U64`.
secret routine b64_pow_u(n: S64) -> U64
  return LLVM::reinterpret_bits[S64, U64](n)

### An unsigned value reinterpreted as signed (two's complement).
### :param n: The unsigned value.
### :returns: The same bits as `S64`.
secret routine b64_pow_s(n: U64) -> S64
  return LLVM::reinterpret_bits[U64, S64](n)

### The number of leading zero bits of a 128-bit value.
### :param v: The value.
### :returns: The leading zero count (128 for 0).
secret routine b64_pow_clz128(v: U128) -> U64
  var h = b64_pow_hi(v: v)
  if h != 0_u64
    return h.leading_zeros()
  return 64_u64 + b64_pow_lo(v: v).leading_zeros()

### The carry of an unsigned 128-bit addition `sum = a + b`.
### :param sum: The wrapped sum.
### :param a: One of the addends.
### :returns: 1 when the addition wrapped, else 0.
secret routine b64_pow_carry(sum: U128, a: U128) -> U128
  if sum < a
    return 1_u128
  return 0_u128

### `v >> n` for a 128-bit value, 0 when `n >= 128`.
### :param v: The value.
### :param n: The shift amount.
### :returns: The shifted value.
secret routine b64_pow_shr128(v: U128, n: U64) -> U128
  if n >= 128_u64
    return 0_u128
  return v >>> b64_pow_sh(n: n)

### `v << n` for a 128-bit value, 0 when `n >= 128`.
### :param v: The value.
### :param n: The shift amount.
### :returns: The shifted value.
secret routine b64_pow_shl128(v: U128, n: U64) -> U128
  if n >= 128_u64
    return 0_u128
  return v << b64_pow_sh(n: n)

### Multiplies `x` by `2^e` in two steps (so that the intermediate stays representable).
### :param x: The value to scale.
### :param e: The power of two.
### :returns: `x * 2^e`.
secret routine b64_pow_pow2(x: B64, e: S64) -> B64
  var r = x
  if (b64_pow_u(n: e) & 1_u64) != 0
    r = r *! 2.0
  var e2 = B64.from_bits(bits: ((b64_pow_u(n: e >> 1) +% 0x3FF_u64) & 0x7FF_u64) << 52)
  return (r *! e2) *! e2

# ============================================================================
# Phase 1: double-double
# ============================================================================

### The phase-1 logarithm: `h + l` approximates log(x), and `cancel` tells whether the tighter error bound
### for 1/sqrt(2) < x < sqrt(2) applies.
secret record B64PowLog1
  h: B64
  l: B64
  cancel: Bool

### `a + b` as a double-double, assuming `|a| >= |b|`.
### :param a: The larger addend.
### :param b: The smaller addend.
### :returns: The exact sum as (hi, lo).
secret routine b64_pow_fast_two_sum(a: B64, b: B64) -> DD
  var hi = a +! b
  var e = hi -! a
  return DD(hi: hi, lo: b -! e)

### `a + (bh + bl)` as a double-double, assuming `|a| >= |bh|`.
### :param a: The larger addend.
### :param bh: The high part of the other addend.
### :param bl: The low part of the other addend.
### :returns: The sum as (hi, lo).
secret routine b64_pow_fast_sum(a: B64, bh: B64, bl: B64) -> DD
  var t = b64_pow_fast_two_sum(a: a, b: bh)
  return DD(hi: t.hi, lo: t.lo +! bl)

### `(ah + al) * (bh + bl)`, ignoring `al * bl`.
### :param ah: High part of the first factor.
### :param al: Low part of the first factor.
### :param bh: High part of the second factor.
### :param bl: Low part of the second factor.
### :returns: The product as (hi, lo).
secret routine b64_pow_d_mul(ah: B64, al: B64, bh: B64, bl: B64) -> DD
  var hi = ah *! bh
  var s = LLVM::fma[B64](a: ah, b: bh, c: -hi)
  var t = LLVM::fma[B64](a: al, b: bh, c: s)
  return DD(hi: hi, lo: LLVM::fma[B64](a: ah, b: bl, c: t))

### The phase-1 table value `B64_POW_*` bit pattern `bits[i]` as a `B64`.
### :param bits: The bit pattern.
### :returns: The value.
secret routine b64_pow_f(bits: U64) -> B64
  return B64.from_bits(bits: bits)

### Approximates log(1+z) - z for |z| <= 33*2^-13, with z an integer multiple of 2^-61.
### :param z: The reduced argument.
### :returns: The approximation as (ph, pl).
secret routine b64_pow_p_1(z: B64) -> DD
  var wh = z *! z
  var wl = LLVM::fma[B64](a: z, b: z, c: -wh)
  var t = LLVM::fma[B64](a: b64_pow_f(bits: B64_POW_P1[5_u64]), b: z, c: b64_pow_f(bits: B64_POW_P1[4_u64]))
  var u = LLVM::fma[B64](a: b64_pow_f(bits: B64_POW_P1[3_u64]), b: z, c: b64_pow_f(bits: B64_POW_P1[2_u64]))
  var v = LLVM::fma[B64](a: b64_pow_f(bits: B64_POW_P1[1_u64]), b: z, c: b64_pow_f(bits: B64_POW_P1[0_u64]))
  u = LLVM::fma[B64](a: t, b: wh, c: u)
  v = LLVM::fma[B64](a: u, b: wh, c: v)
  u = v *! wh
  return DD(hi: -0.5 *! wh, lo: LLVM::fma[B64](a: u, b: z, c: -0.5 *! wl))

### Approximates exp(z) for |z| < 2^-12.905.
### :param z: The reduced argument.
### :returns: The approximation as (qh, ql).
secret routine b64_pow_q_1(z: B64) -> DD
  var q = LLVM::fma[B64](a: b64_pow_f(bits: B64_POW_Q1[4_u64]), b: z, c: b64_pow_f(bits: B64_POW_Q1[3_u64]))
  q = LLVM::fma[B64](a: q, b: z, c: b64_pow_f(bits: B64_POW_Q1[2_u64]))
  var h0 = LLVM::fma[B64](a: q, b: z, c: b64_pow_f(bits: B64_POW_Q1[1_u64]))
  var h1 = z *! h0
  var l1 = LLVM::fma[B64](a: z, b: h0, c: -h1)
  return b64_pow_fast_sum(a: b64_pow_f(bits: B64_POW_Q1[0_u64]), bh: h1, bl: l1)

### Approximates log(x) for 2^-1074 <= x <= the largest finite `B64`.
### :param x: The positive finite argument.
### :returns: `h + l` approximating log(x), and the cancellation flag.
secret routine b64_pow_log_1(x: B64) -> B64PowLog1
  var xu = x.to_bits()
  var m = xu & 0x000FFFFFFFFFFFFF_u64
  var e = b64_pow_s(n: (xu >>> 52) & 0x7FF_u64)
  var tu = 0_u64
  if e != 0
    tu = m | 0x3FF0000000000000_u64
    m = m + 0x0010000000000000_u64
    e = e - 0x3FF
  else
    # x is subnormal
    var k = m.leading_zeros() - 11_u64
    e = -0x3FE - b64_pow_s(n: k)
    m = m << b64_pow_sh(n: k)
    tu = m | 0x3FF0000000000000_u64
  # now x = 2^e * t with 1 <= t < 2, and 2^52 <= m < 2^53
  var t = B64.from_bits(bits: tu)
  var i = 0_u64
  if m >= 0x16A09E667F3BCD_u64
    # divide by 2 so that 1/sqrt(2) < t < sqrt(2)
    e = e + 1
    i = m >>> 45
    t = t *! 0.5
  else
    i = m >>> 44
  var big_e = LLVM::signed_to_float[S64, B64](e)
  var r = b64_pow_f(bits: B64_POW_INVERSE[i - 181_u64])
  var l1 = b64_pow_f(bits: B64_POW_LOG_INV[2_u64 * (i - 181_u64)])
  var l2 = b64_pow_f(bits: B64_POW_LOG_INV[2_u64 * (i - 181_u64) + 1_u64])
  var z = LLVM::fma[B64](a: r, b: t, c: -1.0)
  var th = LLVM::fma[B64](a: big_e, b: 0x1.62e42fefa38p-1, c: l1)
  var tl = LLVM::fma[B64](a: big_e, b: 0x1.ef35793c7673p-45, c: l2)
  var hl = b64_pow_fast_sum(a: th, bh: z, bl: tl)
  var p = b64_pow_p_1(z: z)
  hl = b64_pow_fast_sum(a: hl.hi, bh: p.hi, bl: hl.lo +! p.lo)
  if e == 0 and hl.lo.abs() > hl.hi.abs() *! 0x1p-24
    hl = b64_pow_fast_two_sum(a: hl.hi, b: hl.lo)
    return B64PowLog1(h: hl.hi, l: hl.lo, cancel: true)
  return B64PowLog1(h: hl.hi, l: hl.lo, cancel: false)

### Approximates `s * exp(rh + rl)` as a double-double; returns NaN when the result may underflow or
### overflow (deferred to the next phase).
### :param rh: The high part of the argument.
### :param rl: The low part of the argument.
### :param s: The sign of the result (1 or -1).
### :returns: The approximation as (eh, el).
secret routine b64_pow_exp_1(rh: B64, rl: B64, s: B64) -> DD
  var nan = B64.from_bits(bits: B64_POW_NAN_BITS)
  if rh.is_nan() or rh > 0x1.62e42e709a95bp+9
    if not rh.is_nan() and rh > 0x1.62e4316ea5df9p+9
      # sure overflow
      var big = 0x1.fffffffffffffp+1023 *! s
      return DD(hi: big, lo: big)
    return DD(hi: nan, lo: nan)
  if rh < -0x1.483b8cca421afp+9
    if rh < -0x1.74910ee4e8a27p+9
      # sure underflow
      return DD(hi: 0.0 *! s, lo: B64.from_bits(bits: 1_u64) *! (0.5 *! s))
    return DD(hi: nan, lo: nan)
  var k = LLVM::rint[B64](rh *! 0x1.71547652b82fep+12)
  var zh = LLVM::fma[B64](a: 0x1.62e42fefa39efp-13, b: -k, c: rh)
  var zl = LLVM::fma[B64](a: 0x1.abc9e3b39803fp-68, b: -k, c: rl)
  var big_k = LLVM::float_to_signed[B64, S64](k)
  var big_m = (big_k >> 12) + 0x3FF
  var i2 = b64_pow_u(n: big_k >> 6) & 0x3F_u64
  var i1 = b64_pow_u(n: big_k) & 0x3F_u64
  var e = b64_pow_d_mul(ah: b64_pow_f(bits: B64_POW_T2[2_u64 * i1]), al: b64_pow_f(bits: B64_POW_T2[2_u64 * i1 + 1_u64]), bh: b64_pow_f(bits: B64_POW_T1[2_u64 * i2]), bl: b64_pow_f(bits: B64_POW_T1[2_u64 * i2 + 1_u64]))
  var q = b64_pow_q_1(z: zh +! zl)
  e = b64_pow_d_mul(ah: e.hi, al: e.lo, bh: q.hi, bl: q.lo)
  var d = B64.from_bits(bits: b64_pow_u(n: big_m) << 52) *! s
  return DD(hi: e.hi *! d, lo: e.lo *! d)

### Largest odd m such that m^y fits in 53 bits, for 0 <= y <= 33.
secret preset B64_POW_XMAX: Array[U64, 34] = [0_u64, 0xFFFFFFFFFFFFFFFF_u64, 94906265_u64, 208063_u64, 9741_u64, 1551_u64, 455_u64, 189_u64, 97_u64, 59_u64, 39_u64, 27_u64, 21_u64, 15_u64, 13_u64, 11_u64, 9_u64, 7_u64, 7_u64, 5_u64, 5_u64, 5_u64, 5_u64, 4_u64, 3_u64, 3_u64, 3_u64, 3_u64, 3_u64, 3_u64, 3_u64, 3_u64, 3_u64, 3_u64]

### Whether x^y is exact (exactly representable as a `B64`), for x > 0 finite and y finite.
### :param x: The positive base.
### :param y: The exponent.
### :returns: True when x^y is exactly representable.
secret routine b64_pow_is_exact(x: B64, y: B64) -> Bool
  var vu = x.to_bits()
  var wu = y.to_bits()
  # in all exact cases other than |x| = 1, the low 42 bits of the encoding of y are zero
  if (vu << 1) != 0x7FE0000000000000_u64 and (wu << 22) != 0_u64
    return false
  if (vu << 1) == 0x7FE0000000000000_u64
    return true
  if y >= 0.0 and b64_pow_is_int(x: y)
    var m = vu & 0x000FFFFFFFFFFFFF_u64
    var e = b64_pow_s(n: (vu << 1) >>> 53) - 0x433
    if e >= -1074
      m = m | 0x0010000000000000_u64
    else
      e = e + 1
    var t = m.trailing_zeros()
    m = m >>> b64_pow_sh(n: t)
    e = e + b64_pow_s(n: t)
    # x = m * 2^e
    if y == 0.0 or y == 1.0
      return true
    if m == 1_u64
      var ye = y *! LLVM::signed_to_float[S64, B64](e)
      return -1074.0 <= ye and ye < 1024.0
    if y < 0.0 or 33.0 < y
      return false
    var y_int = LLVM::float_to_signed[B64, S64](y)
    if m > B64_POW_XMAX[b64_pow_u(n: y_int)]
      return false
    var tb = b64_pow_s(n: 64_u64 - m.leading_zeros())
    var ez = e * y_int + tb
    if ez <= -1074 or 1024 < ez
      return false
    # x^y is an odd multiple of 2^(e*y)
    return e * y_int >= -1074
  var n = wu & 0x000FFFFFFFFFFFFF_u64
  var f = b64_pow_s(n: (wu << 1) >>> 53) - 0x433
  if f >= -1074
    n = n | 0x0010000000000000_u64
  else
    f = f + 1
  var tn = n.trailing_zeros()
  n = n >>> b64_pow_sh(n: tn)
  f = f + b64_pow_s(n: tn)
  # |y| = n * 2^f with n odd
  var m = vu & 0x000FFFFFFFFFFFFF_u64
  var e = b64_pow_s(n: (vu << 1) >>> 53) - 0x433
  if e >= -1074
    m = m | 0x0010000000000000_u64
  else
    e = e + 1
  var tm = m.trailing_zeros()
  m = m >>> b64_pow_sh(n: tm)
  e = e + b64_pow_s(n: tm)
  # |x| = m * 2^e with m odd
  if y < 0.0
    # the only exact case is x = 2^e with n*e*2^f an integer
    if m != 1_u64
      return false
    var ez = 0_s64
    if f >= 0
      if f < 12
        ez = b64_pow_s(n: ((0_u64 -% n) *% b64_pow_u(n: e)) << b64_pow_ssh(n: f))
      else
        ez = 1024
    else
      var te = b64_pow_u(n: e).trailing_zeros()
      if b64_pow_u(n: -f) > te
        return false
      ez = b64_pow_s(n: b64_pow_u(n: (0 - e) >> b64_pow_ssh(n: -f)) *% n)
    return -1074 <= ez and ez < 1024
  # y > 0 is not an integer: y = n * 2^f with n odd and f < 0, so x must be a (2^-f)th power
  while f != 0
    f = f + 1
    if (b64_pow_u(n: e) & 1_u64) != 0
      return false
    e = e >> 1
    var dm = LLVM::unsigned_to_float[U64, B64](m)
    var sq = LLVM::round[B64](LLVM::sqrt[B64](dm))
    if sq *! sq != dm
      return false
    m = LLVM::float_to_unsigned[B64, U64](sq)
  # now |x^y| = (m * 2^e)^n with m and n odd
  if m > 1_u64
    if 33_u64 < n
      return false
    if m > B64_POW_XMAX[n]
      return false
  var my = m
  var n0 = n
  while n0 > 1_u64
    n0 = n0 - 1_u64
    my = my *% m
  var tb = b64_pow_s(n: 64_u64 - my.leading_zeros())
  var en = e * b64_pow_s(n: n)
  return -1074 <= en and en + tb <= 1024

### Computes x^y exactly for exact and midpoint cases (Algorithm detectRoundingBoundaryCase of Lauter and
### Lefevre), given the phase-2 approximation `z` of x^y with relative error below 2^-117.
### :param x: The original base.
### :param y: The exponent.
### :param z: The phase-2 approximation of |x|^y, carrying the sign of the result.
### :param exact: Whether x^y is exactly representable.
### :returns: x^y when it fits into 54 bits, else NaN.
secret routine b64_pow_exact_pow(x: B64, y: B64, z: B64PowDint, exact: Bool) -> B64
  var nan = B64.from_bits(bits: B64_POW_NAN_BITS)
  var sg = 1_s64
  if z.sgn != 0_u64
    sg = -1
  # x = 2^big_e * m with m odd
  var xu = x.to_bits()
  var big_e = b64_pow_s(n: (xu >>> 52) & 0x7FF_u64)
  var m = xu & 0x000FFFFFFFFFFFFF_u64
  var sub_x = 1_s64
  if big_e != 0
    m = m + 0x0010000000000000_u64
    sub_x = 0
  var tx = m.trailing_zeros()
  m = m >>> b64_pow_sh(n: tx)
  big_e = big_e + b64_pow_s(n: tx) - (0x433 - sub_x)
  if m == 1_u64
    # x is a power of 2
    var g = LLVM::signed_to_float[S64, B64](big_e) *! y
    if b64_pow_is_int(x: g)
      var r = 1.0
      if z.sgn != 0_u64
        r = -1.0
      return b64_pow_pow2(x: r, e: LLVM::float_to_signed[B64, S64](g))
    return nan
  if y < 0.0 or y > 34.0
    return nan
  # y = 2^big_f * n with n odd
  var yu = y.to_bits()
  var big_f = b64_pow_s(n: (yu >>> 52) & 0x7FF_u64)
  var n = yu & 0x000FFFFFFFFFFFFF_u64
  var sub_y = 1_s64
  if big_f != 0
    n = n + 0x0010000000000000_u64
    sub_y = 0
  var ty = n.trailing_zeros()
  n = n >>> b64_pow_sh(n: ty)
  big_f = big_f + b64_pow_s(n: ty) - (0x433 - sub_y)
  if n > 34_u64 or big_f < -5
    return nan
  if big_f < 0
    # x = 2^E * m with m odd and y = 2^F * n with -5 <= F < 0: big_e must be divisible by 2^-F
    if (b64_pow_u(n: big_e) & (0xFFFFFFFFFFFFFFFF_u64 >>> b64_pow_ssh(n: 64 + big_f))) != 0_u64
      return nan
    var g = b64_pow_s(n: b64_pow_u(n: big_e >> b64_pow_ssh(n: -big_f)) *% n)
    # round z to 54 bits: k * 2^big_g
    var zh = b64_pow_hi(v: z.r)
    var big_g = z.ex - 53
    var k = b64_pow_s(n: (zh >>> 10) + ((zh >>> 9) & 1_u64))
    if not exact
      # check that |2^big_g * k - z| < 2^-116 * z
      var cnt = b64_pow_u(n: k).leading_zeros()
      var d = B64PowDint(r: b64_pow_join(hi: b64_pow_u(n: k) << b64_pow_sh(n: cnt), lo: 0_u64), ex: big_g + 63 - b64_pow_s(n: cnt), sgn: 1_u64 - z.sgn)
      d = b64_pow_add_dint(a: z, b: d)
      d.ex = d.ex + 116
      if b64_pow_cmp_dint_abs(a: d, b: z) >= 0
        return nan
    if big_g > g
      return nan
    # k must be an odd number times 2^(g - big_g)
    var gg = b64_pow_u(n: g - big_g)
    var mask = (0xFFFFFFFFFFFFFFFE_u64 << b64_pow_sh(n: gg)).bitnot()
    if (b64_pow_u(n: k) & mask) == (1_u64 << b64_pow_sh(n: gg))
      var q = (k >> b64_pow_sh(n: gg)) * sg
      return b64_pow_pow2(x: LLVM::signed_to_float[S64, B64](q), e: g)
    return nan
  # y is an integer, 2 <= y <= 34: compute k = m^t, which should fit into 54 bits
  var t = n << b64_pow_ssh(n: big_f)
  var k = 1_u64
  var mm = m
  while t != 0_u64
    if (t & 1_u64) != 0_u64
      var p = b64_pow_mul64(a: mm, b: k)
      if p > 0x7FFFFFFFFFFFFFFF_u128
        return nan
      k = b64_pow_lo(v: p)
    t = t >>> 1
    if t != 0_u64
      var p2 = b64_pow_mul64(a: mm, b: mm)
      if (p2 >>> 64) != 0_u128
        return nan
      mm = b64_pow_lo(v: p2)
  if (k >>> 54) != 0_u64
    return nan
  var r = LLVM::signed_to_float[S64, B64](b64_pow_s(n: k) * sg)
  return b64_pow_pow2(x: r, e: big_e * b64_pow_s(n: n << b64_pow_ssh(n: big_f)))

# ============================================================================
# 128-bit floating-point numbers (the C dint64_t): (-1)^sgn * r * 2^(ex - 127), where the most
# significant bit of r is set for a normalized nonzero value
# ============================================================================

### A 128-bit floating-point value: `r` holds the significand (hi limb = r >> 64), `ex` the exponent and
### `sgn` the sign bit.
secret record B64PowDint
  r: U128
  ex: S64
  sgn: U64

### The zero `B64PowDint` (the C `ZERO`).
### :returns: Zero.
secret routine b64_pow_dint_zero() -> B64PowDint
  return B64PowDint(r: 0_u128, ex: -1076, sgn: 0_u64)

### -1 as a `B64PowDint`.
### :returns: -1.
secret routine b64_pow_dint_m_one() -> B64PowDint
  return B64PowDint(r: 1_u128 << 127, ex: 0, sgn: 1_u64)

### log(2) as a `B64PowDint`, with absolute error below 2^-129.97.
### :returns: log(2).
secret routine b64_pow_dint_log2() -> B64PowDint
  return B64PowDint(r: b64_pow_join(hi: 0xB17217F7D1CF79AB_u64, lo: 0xC9E3B39803F2F6AF_u64), ex: -1, sgn: 0_u64)

### 2^12/log(2) as a `B64PowDint`, with absolute error below 2^-52.96.
### :returns: 2^12/log(2).
secret routine b64_pow_dint_log2_inv() -> B64PowDint
  return B64PowDint(r: b64_pow_join(hi: 0xB8AA3B295C17F0BC_u64, lo: 0_u64), ex: 12, sgn: 0_u64)

### Compares |a| and |b|.
### :param a: The first value.
### :param b: The second value.
### :returns: -1, 0 or 1.
secret routine b64_pow_cmp_dint_abs(a: B64PowDint, b: B64PowDint) -> S64
  if b64_pow_hi(v: a.r) == 0_u64
    if b64_pow_hi(v: b.r) == 0_u64
      return 0
    return -1
  if b64_pow_hi(v: b.r) == 0_u64
    return 1
  if a.ex > b.ex
    return 1
  if a.ex < b.ex
    return -1
  if a.r > b.r
    return 1
  if a.r < b.r
    return -1
  return 0

### Compares |a| and |b| using only their upper limbs.
### :param a: The first value.
### :param b: The second value.
### :returns: -1, 0 or 1.
secret routine b64_pow_cmp_dint_11(a: B64PowDint, b: B64PowDint) -> S64
  if a.ex > b.ex
    return 1
  if a.ex < b.ex
    return -1
  var ah = b64_pow_hi(v: a.r)
  var bh = b64_pow_hi(v: b.r)
  if ah > bh
    return 1
  if ah < bh
    return -1
  return 0

### `a + b` with error below 2 ulps (exact in the Sterbenz case).
### :param a: The first addend.
### :param b: The second addend.
### :returns: The sum.
secret routine b64_pow_add_dint(a: B64PowDint, b: B64PowDint) -> B64PowDint
  if a.r == 0_u128
    return b
  var c = b64_pow_cmp_dint_abs(a: a, b: b)
  if c == 0
    if (a.sgn ^ b.sgn) != 0_u64
      return b64_pow_dint_zero()
    return B64PowDint(r: a.r, ex: a.ex + 1, sgn: a.sgn)
  var aa = a
  var bb = b
  if c < 0
    aa = b
    bb = a
  # now |aa| > |bb|
  var big_a = aa.r
  var big_b = bb.r
  var k = b64_pow_u(n: aa.ex -% bb.ex)
  if k > 0_u64
    big_b = b64_pow_shr128(v: big_b, n: k)
  var rex = aa.ex
  var cc = 0_u128
  if (aa.sgn ^ bb.sgn) != 0_u64
    cc = big_a -% big_b
    var ex = b64_pow_clz128(v: cc)
    if ex > 0_u64
      if k == 1_u64
        cc = (big_a << b64_pow_sh(n: ex)) -% (bb.r << b64_pow_sh(n: ex - 1_u64))
      else
        cc = (big_a << b64_pow_sh(n: ex)) -% (big_b << b64_pow_sh(n: ex))
      rex = rex - b64_pow_s(n: ex)
      ex = b64_pow_hi(v: cc).leading_zeros()
    cc = cc << b64_pow_sh(n: ex)
    rex = rex - b64_pow_s(n: ex)
  else
    cc = big_a +% big_b
    if cc < big_a
      cc = (1_u128 << 127) | (cc >>> 1)
      rex = rex + 1
  return B64PowDint(r: cc, ex: rex, sgn: aa.sgn)

### `a + b` using only the upper limbs of `a` and `b`, with error below 2 ulps (64-bit ulps); the lower
### limb of the result keeps the lower limb of `b`, as the C code (which writes into `b`) does.
### :param a: The first addend.
### :param b: The second addend.
### :returns: The sum.
secret routine b64_pow_add_dint_11(a: B64PowDint, b: B64PowDint) -> B64PowDint
  if b64_pow_hi(v: a.r) == 0_u64
    return b
  if b64_pow_hi(v: b.r) == 0_u64
    return a
  var stale = b64_pow_lo(v: b.r)
  var c = b64_pow_cmp_dint_11(a: a, b: b)
  if c == 0
    if (a.sgn ^ b.sgn) != 0_u64
      return b64_pow_dint_zero()
    return B64PowDint(r: a.r, ex: a.ex + 1, sgn: a.sgn)
  var aa = a
  var bb = b
  if c < 0
    aa = b
    bb = a
  var big_a = b64_pow_hi(v: aa.r)
  var big_b = b64_pow_hi(v: bb.r)
  if aa.ex > bb.ex
    var k = b64_pow_u(n: aa.ex - bb.ex)
    if k < 64_u64
      big_b = big_b >>> b64_pow_sh(n: k)
    else
      big_b = 0_u64
  var rex = aa.ex
  var cc = 0_u64
  if (aa.sgn ^ bb.sgn) != 0_u64
    cc = big_a -% big_b
    var ex = cc.leading_zeros()
    if ex > 0_u64
      cc = (big_a << b64_pow_sh(n: ex)) -% (big_b << b64_pow_sh(n: ex))
      rex = rex - b64_pow_s(n: ex)
      ex = cc.leading_zeros()
    cc = cc << b64_pow_sh(n: ex)
    rex = rex - b64_pow_s(n: ex)
  else
    cc = big_a +% big_b
    if cc < big_a
      cc = 0x8000000000000000_u64 | (cc >>> 1)
      rex = rex + 1
  return B64PowDint(r: b64_pow_join(hi: cc, lo: stale), ex: rex, sgn: aa.sgn)

### Normalizes a 128-bit product whose top bit is at position 126 or 127.
### :param r: The product.
### :param ex: The sum of the exponents of the factors.
### :param sgn: The sign of the product.
### :returns: The normalized product.
secret routine b64_pow_dint_norm(r: U128, ex: S64, sgn: U64) -> B64PowDint
  if (r >>> 127) != 0_u128
    return B64PowDint(r: r, ex: ex + 1, sgn: sgn)
  return B64PowDint(r: r << 1, ex: ex, sgn: sgn)

### `a * b` with error below 6 ulps.
### :param a: The first factor.
### :param b: The second factor.
### :returns: The product.
secret routine b64_pow_mul_dint(a: B64PowDint, b: B64PowDint) -> B64PowDint
  var bh = b64_pow_hi(v: b.r)
  var bl = b64_pow_lo(v: b.r)
  var ah = b64_pow_hi(v: a.r)
  var m1 = b64_pow_mul64(a: ah, b: bl)
  var m2 = b64_pow_mul64(a: b64_pow_lo(v: a.r), b: bh)
  var r = b64_pow_mul64(a: ah, b: bh)
  r = r +% ((m1 >>> 64) +% (m2 >>> 64))
  return b64_pow_dint_norm(r: r, ex: a.ex + b.ex, sgn: a.sgn ^ b.sgn)

### `a * b` assuming the lower limb of `b` is zero, with error below 2 ulps.
### :param a: The first factor.
### :param b: The second factor.
### :returns: The product.
secret routine b64_pow_mul_dint_21(a: B64PowDint, b: B64PowDint) -> B64PowDint
  var bh = b64_pow_hi(v: b.r)
  var hi = b64_pow_mul64(a: b64_pow_hi(v: a.r), b: bh)
  var lo = b64_pow_mul64(a: b64_pow_lo(v: a.r), b: bh)
  return b64_pow_dint_norm(r: hi +% (lo >>> 64), ex: a.ex + b.ex, sgn: a.sgn ^ b.sgn)

### `a * b` using only the upper limbs of `a` and `b` (exact).
### :param a: The first factor.
### :param b: The second factor.
### :returns: The product.
secret routine b64_pow_mul_dint_11(a: B64PowDint, b: B64PowDint) -> B64PowDint
  var r = b64_pow_mul64(a: b64_pow_hi(v: a.r), b: b64_pow_hi(v: b.r))
  return b64_pow_dint_norm(r: r, ex: a.ex + b.ex, sgn: a.sgn ^ b.sgn)

### `a * b` for an integer `b`, with error below 1 ulp.
### :param a: The `B64PowDint` factor.
### :param b: The integer factor.
### :returns: The product.
secret routine b64_pow_mul_dint_int64(a: B64PowDint, b: S64) -> B64PowDint
  if b == 0
    return b64_pow_dint_zero()
  var c = b64_pow_u(n: b)
  var sgn = a.sgn
  if b < 0
    c = 0_u64 -% c
    sgn = a.sgn ^ 1_u64
  var rex = a.ex + 64
  var r = b64_pow_mul64(a: b64_pow_hi(v: a.r), b: c)
  var m = 64_u64
  if b64_pow_hi(v: r) != 0_u64
    m = b64_pow_hi(v: r).leading_zeros()
  r = r << b64_pow_sh(n: m)
  rex = rex - b64_pow_s(n: m)
  var l = b64_pow_mul64(a: b64_pow_lo(v: a.r), b: c)
  l = (l << b64_pow_sh(n: m - 1_u64)) >>> 63
  r = r +% l
  if r < l
    r = (1_u128 << 127) | (r >>> 1)
    rex = rex + 1
  return B64PowDint(r: r, ex: rex, sgn: sgn)

### Converts a nonzero finite `B64` to a `B64PowDint` (exact).
### :param b: The value.
### :returns: The same value.
secret routine b64_pow_dint_fromd(b: B64) -> B64PowDint
  var u = b.to_bits()
  var e = b64_pow_s(n: (u >>> 52) & 0x7FF_u64)
  var m = u & 0x000FFFFFFFFFFFFF_u64
  if e != 0
    m = m + 0x0010000000000000_u64
  e = e - 0x3FF
  var t = m.leading_zeros()
  var sgn = 0_u64
  if b < 0.0
    sgn = 1_u64
  m = m << b64_pow_sh(n: t)
  if t > 11_u64
    e = e - (b64_pow_s(n: t) - 12)
  return B64PowDint(r: b64_pow_join(hi: m, lo: 0_u64), ex: e, sgn: sgn)

### Converts a `B64PowDint` to an integer, rounding toward zero.
### :param a: The value.
### :returns: The truncated integer.
secret routine b64_pow_dint_toi(a: B64PowDint) -> S64
  if a.ex < 0
    return 0
  var r = b64_pow_s(n: b64_pow_hi(v: a.r) >>> b64_pow_ssh(n: 63 - a.ex))
  if a.sgn != 0_u64
    return 0 - r
  return r

### Approximates log(1+z) for |z| <= 2^-13 (lower limb of z zero), relative error below 2^-124.82.
### :param z: The reduced argument.
### :returns: The approximation.
secret routine b64_pow_p_2(z: B64PowDint) -> B64PowDint
  var r = b64_pow_mul_dint_11(a: z, b: b64_pow_p_2_at(i: 0_u64))
  r = b64_pow_add_dint_11(a: b64_pow_p_2_at(i: 1_u64), b: r)
  r = b64_pow_mul_dint_11(a: z, b: r)
  r = b64_pow_add_dint_11(a: b64_pow_p_2_at(i: 2_u64), b: r)
  r = b64_pow_mul_dint_11(a: z, b: r)
  r = b64_pow_add_dint_11(a: b64_pow_p_2_at(i: 3_u64), b: r)
  r = b64_pow_mul_dint_11(a: z, b: r)
  r = b64_pow_add_dint(a: b64_pow_p_2_at(i: 4_u64), b: r)
  var k = 5_u64
  while k < 9_u64
    r = b64_pow_mul_dint_21(a: r, b: z)
    r = b64_pow_add_dint(a: b64_pow_p_2_at(i: k), b: r)
    k = k + 1_u64
  return b64_pow_mul_dint_21(a: r, b: z)

### Approximates exp(y) for |y| < 0.00016923, relative error below 2^-122.29.
### :param y: The reduced argument.
### :returns: The approximation.
secret routine b64_pow_q_2(y: B64PowDint) -> B64PowDint
  var r = b64_pow_mul_dint_11(a: y, b: b64_pow_q_2_at(i: 0_u64))
  r = b64_pow_add_dint_11(a: b64_pow_q_2_at(i: 1_u64), b: r)
  r = b64_pow_mul_dint_11(a: y, b: r)
  r = b64_pow_add_dint_11(a: b64_pow_q_2_at(i: 2_u64), b: r)
  r = b64_pow_mul_dint_11(a: y, b: r)
  r = b64_pow_add_dint(a: b64_pow_q_2_at(i: 3_u64), b: r)
  var k = 4_u64
  while k < 8_u64
    r = b64_pow_mul_dint(a: y, b: r)
    r = b64_pow_add_dint(a: b64_pow_q_2_at(i: k), b: r)
    k = k + 1_u64
  return r

### Approximates log(x) with relative error below 2^-122.88.
### :param x: The positive argument.
### :returns: The approximation.
secret routine b64_pow_log_2(x: B64PowDint) -> B64PowDint
  var big_e = x.ex
  var xh = b64_pow_hi(v: x.r)
  var i = 0_u64
  if xh > 0xB504F333F9DE6484_u64
    big_e = big_e + 1
    i = xh >>> 57
  else
    i = xh >>> 56
  # now 90 <= i <= 181 and sqrt(2)/2 < x < sqrt(2)
  var xx = B64PowDint(r: x.r, ex: x.ex - big_e, sgn: x.sgn)
  var z = b64_pow_mul_dint_11(a: xx, b: b64_pow_inverse_2_1(i: i - 90_u64))
  var j = b64_pow_hi(v: z.r) >>> b64_pow_ssh(n: 50 - z.ex)
  z = b64_pow_mul_dint_11(a: z, b: b64_pow_inverse_2_2(i: j - 8128_u64))
  z = b64_pow_add_dint(a: b64_pow_dint_m_one(), b: z)
  var r = b64_pow_mul_dint_int64(a: b64_pow_dint_log2(), b: big_e)
  var p = b64_pow_p_2(z: z)
  p = b64_pow_add_dint(a: b64_pow_log_inv_2_2(i: j - 8128_u64), b: p)
  p = b64_pow_add_dint(a: b64_pow_log_inv_2_1(i: i - 90_u64), b: p)
  return b64_pow_add_dint(a: p, b: r)

### Approximates exp(x) for |x| < 744.45 with relative error below 2^-121.70; for larger |x| returns a
### value whose exponent marks the underflow or overflow.
### :param x: The argument.
### :returns: The approximation.
secret routine b64_pow_exp_2(x: B64PowDint) -> B64PowDint
  if x.ex >= 10
    if x.sgn == 1_u64
      return B64PowDint(r: x.r, ex: -1076, sgn: 0_u64)
    return B64PowDint(r: x.r, ex: 1025, sgn: 0_u64)
  var kk = b64_pow_mul_dint_11(a: x, b: b64_pow_dint_log2_inv())
  var k = b64_pow_dint_toi(a: kk)
  kk = b64_pow_mul_dint_int64(a: b64_pow_dint_log2(), b: k)
  kk = B64PowDint(r: kk.r, ex: kk.ex - 12, sgn: kk.sgn ^ 1_u64)
  var y = b64_pow_add_dint(a: x, b: kk)
  var big_m = k >> 12
  var i2 = b64_pow_u(n: k >> 6) & 0x3F_u64
  var i1 = b64_pow_u(n: k) & 0x3F_u64
  var r = b64_pow_q_2(y: y)
  r = b64_pow_mul_dint(a: b64_pow_t1_2(i: i2), b: r)
  r = b64_pow_mul_dint(a: b64_pow_t2_2(i: i1), b: r)
  r.ex = r.ex + big_m
  return r

### Rounds a `B64PowDint` in the subnormal range to the nearest `B64`.
### :param a: The value, with a.ex < -1022.
### :returns: The rounded value.
secret routine b64_pow_dint_tod_subnormal(a: B64PowDint) -> B64
  var ah = b64_pow_hi(v: a.r)
  var al = b64_pow_lo(v: a.r)
  var ex = b64_pow_u(n: 0 - (1011 + a.ex))
  if ex >= 64_u64
    # all bits disappear: |a| < 2^-1074
    var rb0 = ah >>> 63
    var sb0 = (ah << 1) | al
    var ret = 0.0
    if not (ex > 64_u64 or rb0 == 0_u64 or sb0 == 0_u64)
      ret = B64.from_bits(bits: 1_u64)
    if a.sgn != 0_u64
      return -ret
    return ret
  var hi = ah >>> b64_pow_sh(n: ex)
  var rb = (ah >>> b64_pow_sh(n: ex - 1_u64)) & 1_u64
  var sticky = (ah << b64_pow_sh(n: 65_u64 - ex)) != 0_u64 or al != 0_u64
  if sticky
    hi = hi + rb
  else
    hi = hi + (hi & rb)
  return B64.from_bits(bits: hi | (a.sgn << 63))

### Rounds a `B64PowDint` to the nearest `B64`.
### :param a: The value.
### :param exact: Whether x^y is exact (only used for flags in the C original).
### :returns: The rounded value.
secret routine b64_pow_dint_tod(a: B64PowDint, exact: Bool) -> B64
  if a.ex < -1022
    return b64_pow_dint_tod_subnormal(a: a)
  var ah = b64_pow_hi(v: a.r)
  var al = b64_pow_lo(v: a.r)
  # the significand in [1, 2)
  var r = B64.from_bits(bits: (ah >>> 11) | 0x3FF0000000000000_u64)
  var rd = 0.0
  if ((ah >>> 10) & 1_u64) != 0_u64
    rd = rd +! 0x1p-53
  if (ah & 0x3FF_u64) != 0_u64 or al != 0_u64
    rd = rd +! 0x1p-54
  if a.sgn != 0_u64
    rd = -rd
  r = B64.from_bits(bits: r.to_bits() | (a.sgn << 63))
  r = r +! rd
  var e = 0.0
  if a.ex > -1023
    if a.ex > 1023
      if a.ex == 1024
        r = r *! 2.0
        e = 0x1p+1023
      else
        r = 0x1.fffffffffffffp+1023
        e = 0x1.fffffffffffffp+1023
    else
      e = B64.from_bits(bits: (b64_pow_u(n: a.ex + 1023) & 0x7FF_u64) << 52)
  else
    if a.ex < -1074
      if a.ex == -1075
        r = r *! 0.5
        e = B64.from_bits(bits: 1_u64)
      else
        r = B64.from_bits(bits: 1_u64)
        e = B64.from_bits(bits: 1_u64)
    else
      e = B64.from_bits(bits: 1_u64 << b64_pow_ssh(n: a.ex + 1074))
  return r *! e

# ============================================================================
# 256-bit floating-point numbers (the C qint64_t): (-1)^sgn * (rh * 2^128 + rl) * 2^(ex - 255)
# ============================================================================

### A 256-bit floating-point value: `rh` holds the limbs hh:hl, `rl` the limbs lh:ll, `ex` the exponent
### and `sgn` the sign bit.
secret record B64PowQint
  rh: U128
  rl: U128
  ex: S64
  sgn: U64

### The zero `B64PowQint` (the C `ZERO_Q`).
### :returns: Zero.
secret routine b64_pow_qint_zero() -> B64PowQint
  return B64PowQint(rh: 0_u128, rl: 0_u128, ex: 0, sgn: 0_u64)

### log(2) as a `B64PowQint`, with absolute error below 2^-256.14.
### :returns: log(2).
secret routine b64_pow_qint_log2() -> B64PowQint
  var h = b64_pow_join(hi: 0xB17217F7D1CF79AB_u64, lo: 0xC9E3B39803F2F6AF_u64)
  var l = b64_pow_join(hi: 0x40F343267298B62D_u64, lo: 0x8A0D175B8BAAFA2B_u64)
  return B64PowQint(rh: h, rl: l, ex: -1, sgn: 0_u64)

### Compares |a| and |b|.
### :param a: The first value.
### :param b: The second value.
### :returns: -1, 0 or 1.
secret routine b64_pow_cmp_qint(a: B64PowQint, b: B64PowQint) -> S64
  if a.ex > b.ex
    return 1
  if a.ex < b.ex
    return -1
  if a.rh > b.rh
    return 1
  if a.rh < b.rh
    return -1
  if a.rl > b.rl
    return 1
  if a.rl < b.rl
    return -1
  return 0

### Compares |a| and |b| using only their upper two limbs.
### :param a: The first value.
### :param b: The second value.
### :returns: -1, 0 or 1.
secret routine b64_pow_cmp_qint_22(a: B64PowQint, b: B64PowQint) -> S64
  if a.ex > b.ex
    return 1
  if a.ex < b.ex
    return -1
  if a.rh > b.rh
    return 1
  if a.rh < b.rh
    return -1
  return 0

### The number of leading zero bits of the 256-bit value ch:cl.
### :param ch: The upper 128 bits.
### :param cl: The lower 128 bits.
### :returns: The leading zero count.
secret routine b64_pow_clz256(ch: U128, cl: U128) -> U64
  if ch != 0_u128
    return b64_pow_clz128(v: ch)
  return 128_u64 + b64_pow_clz128(v: cl)

### `a + b` with error below 2 ulps (exact in the Sterbenz case).
### :param a: The first addend.
### :param b: The second addend.
### :returns: The sum.
secret routine b64_pow_add_qint(a: B64PowQint, b: B64PowQint) -> B64PowQint
  if a.rh == 0_u128 and a.rl == 0_u128
    return b
  if b.rh == 0_u128 and b.rl == 0_u128
    return a
  var c = b64_pow_cmp_qint(a: a, b: b)
  if c == 0
    if (a.sgn ^ b.sgn) != 0_u64
      return b64_pow_qint_zero()
    return B64PowQint(rh: a.rh, rl: a.rl, ex: a.ex + 1, sgn: a.sgn)
  var aa = a
  var bb = b
  if c < 0
    aa = b
    bb = a
  # now |aa| > |bb|
  var ah = aa.rh
  var al = aa.rl
  var bh = bb.rh
  var bl = bb.rl
  var k = aa.ex - bb.ex
  if k > 0
    if k >= 128
      if k < 256
        bl = bh >>> b64_pow_ssh(n: k - 128)
      else
        bl = 0_u128
      bh = 0_u128
    else
      bl = (bl >>> b64_pow_ssh(n: k)) | (bh << b64_pow_ssh(n: 128 - k))
      bh = bh >>> b64_pow_ssh(n: k)
  var rex = aa.ex
  var ch = 0_u128
  var cl = 0_u128
  if (aa.sgn ^ bb.sgn) != 0_u64
    # subtraction
    ch = ah -% bh
    if al < bl
      ch = ch -% 1_u128
    cl = al -% bl
    var ex = b64_pow_clz256(ch: ch, cl: cl)
    if ex > 0_u64
      # shift aa by ex bits to the left, and bb by ex - k bits to the left
      if ex >= 128_u64
        ah = al << b64_pow_sh(n: ex - 128_u64)
        al = 0_u128
      else
        ah = (ah << b64_pow_sh(n: ex)) | (al >>> b64_pow_sh(n: 128_u64 - ex))
        al = al << b64_pow_sh(n: ex)
      var sh = b64_pow_s(n: ex) - k
      bh = bb.rh
      bl = bb.rl
      if sh >= 0
        if sh >= 128
          bh = bl << b64_pow_ssh(n: sh - 128)
          bl = 0_u128
        else
          if sh > 0
            bh = (bh << b64_pow_ssh(n: sh)) | (bl >>> b64_pow_ssh(n: 128 - sh))
            bl = bl << b64_pow_ssh(n: sh)
      else
        var j = 0 - sh
        if j >= 128
          bl = b64_pow_shr128(v: bh, n: b64_pow_u(n: j - 128))
          bh = 0_u128
        else
          bl = (bh << b64_pow_ssh(n: 128 - j)) | (bl >>> b64_pow_ssh(n: j))
          bh = bh >>> b64_pow_ssh(n: j)
      rex = rex - b64_pow_s(n: ex)
      ch = ah -% bh
      if al < bl
        ch = ch -% 1_u128
      cl = al -% bl
      ex = b64_pow_clz256(ch: ch, cl: cl)
    if ex != 0_u64
      ch = (ch << b64_pow_sh(n: ex)) | (cl >>> b64_pow_sh(n: 128_u64 - ex))
      cl = cl << b64_pow_sh(n: ex)
    rex = rex - b64_pow_s(n: ex)
  else
    # addition
    ch = ah +% bh
    var cy = b64_pow_carry(sum: ch, a: ah)
    cl = al +% bl
    if cl < al
      ch = ch +% 1_u128
      if ch == 0_u128
        cy = cy +% 1_u128
    if cy != 0_u128
      cl = (ch << 127) | (cl >>> 1)
      ch = (1_u128 << 127) | (ch >>> 1)
      rex = rex + 1
  return B64PowQint(rh: ch, rl: cl, ex: rex, sgn: aa.sgn)

### `a + b` using only the upper two limbs of `a` and `b`, with error below 2 ulps (128-bit ulps).
### :param a: The first addend.
### :param b: The second addend.
### :returns: The sum (lower two limbs zero).
secret routine b64_pow_add_qint_22(a: B64PowQint, b: B64PowQint) -> B64PowQint
  if a.rh == 0_u128
    return b
  if b.rh == 0_u128
    return a
  var c = b64_pow_cmp_qint_22(a: a, b: b)
  if c == 0
    if (a.sgn ^ b.sgn) != 0_u64
      return b64_pow_qint_zero()
    return B64PowQint(rh: a.rh, rl: a.rl, ex: a.ex + 1, sgn: a.sgn)
  var aa = a
  var bb = b
  if c < 0
    aa = b
    bb = a
  var ah = aa.rh
  var bh = bb.rh
  var k = b64_pow_u(n: aa.ex - bb.ex)
  if k > 0_u64
    bh = b64_pow_shr128(v: bh, n: k)
  var rex = aa.ex
  var ch = 0_u128
  if (aa.sgn ^ bb.sgn) != 0_u64
    ch = ah -% bh
    var ex = b64_pow_clz128(v: ch)
    if ex > 0_u64
      ah = ah << b64_pow_sh(n: ex)
      if ex >= k
        bh = b64_pow_shl128(v: bb.rh, n: ex - k)
      else
        bh = b64_pow_shr128(v: bb.rh, n: k - ex)
      rex = rex - b64_pow_s(n: ex)
      ch = ah -% bh
      ex = b64_pow_clz128(v: ch)
    ch = ch << b64_pow_sh(n: ex)
    rex = rex - b64_pow_s(n: ex)
  else
    ch = ah +% bh
    if ch < ah
      ch = (1_u128 << 127) | (ch >>> 1)
      rex = rex + 1
  return B64PowQint(rh: ch, rl: 0_u128, ex: rex, sgn: aa.sgn)

### Normalizes a 256-bit product t6:t5 whose top bit is at position 254 or 255.
### :param t6: The upper 128 bits.
### :param t5: The lower 128 bits.
### :param ex: The sum of the exponents of the factors.
### :param sgn: The sign of the product.
### :returns: The normalized product.
secret routine b64_pow_qint_norm(t6: U128, t5: U128, ex: S64, sgn: U64) -> B64PowQint
  if (t6 >>> 127) == 0_u128
    return B64PowQint(rh: (t6 << 1) | (t5 >>> 127), rl: t5 << 1, ex: ex, sgn: sgn)
  return B64PowQint(rh: t6, rl: t5, ex: ex + 1, sgn: sgn)

### The mask of the lower 64 bits of a 128-bit value.
### :returns: 2^64 - 1.
secret routine b64_pow_mask64() -> U128
  return 0xFFFFFFFFFFFFFFFF_u128

### `a * b` with error below 14 ulps.
### :param a: The first factor.
### :param b: The second factor.
### :returns: The product.
secret routine b64_pow_mul_qint(a: B64PowQint, b: B64PowQint) -> B64PowQint
  var ahh = b64_pow_hi(v: a.rh)
  var ahl = b64_pow_lo(v: a.rh)
  var alh = b64_pow_hi(v: a.rl)
  var all = b64_pow_lo(v: a.rl)
  var bhh = b64_pow_hi(v: b.rh)
  var bhl = b64_pow_lo(v: b.rh)
  var blh = b64_pow_hi(v: b.rl)
  var bll = b64_pow_lo(v: b.rl)
  var r33 = b64_pow_mul64(a: ahh, b: bhh)
  var r32 = b64_pow_mul64(a: ahh, b: bhl)
  var r23 = b64_pow_mul64(a: ahl, b: bhh)
  var r31 = b64_pow_mul64(a: ahh, b: blh)
  var r13 = b64_pow_mul64(a: alh, b: bhh)
  var r22 = b64_pow_mul64(a: ahl, b: bhl)
  var r30 = b64_pow_mul64(a: ahh, b: bll)
  var r03 = b64_pow_mul64(a: all, b: bhh)
  var r21 = b64_pow_mul64(a: ahl, b: blh)
  var r12 = b64_pow_mul64(a: alh, b: bhl)
  var t3 = (r12 >>> 64) +% (r21 >>> 64) +% (r03 >>> 64) +% (r30 >>> 64)
  var t4 = r22 +% t3
  var c4 = b64_pow_carry(sum: t4, a: r22)
  var t4b = r13 +% t4
  c4 = c4 +% b64_pow_carry(sum: t4b, a: r13)
  var t4c = r31 +% t4b
  c4 = c4 +% b64_pow_carry(sum: t4c, a: r31)
  var t5 = r23 +% (t4c >>> 64)
  var c5 = b64_pow_carry(sum: t5, a: r23)
  var t5b = r32 +% t5
  c5 = c5 +% b64_pow_carry(sum: t5b, a: r32)
  var t6 = r33 +% ((c5 << 64) | (t5b >>> 64)) +% c4
  var t5f = (t5b << 64) | (t4c & b64_pow_mask64())
  return b64_pow_qint_norm(t6: t6, t5: t5f, ex: a.ex + b.ex, sgn: a.sgn ^ b.sgn)

### `a * b` using only the upper three limbs of `a` and `b`, with error below 6 ulps.
### :param a: The first factor.
### :param b: The second factor.
### :returns: The product.
secret routine b64_pow_mul_qint_33(a: B64PowQint, b: B64PowQint) -> B64PowQint
  var ahh = b64_pow_hi(v: a.rh)
  var ahl = b64_pow_lo(v: a.rh)
  var alh = b64_pow_hi(v: a.rl)
  var bhh = b64_pow_hi(v: b.rh)
  var bhl = b64_pow_lo(v: b.rh)
  var blh = b64_pow_hi(v: b.rl)
  var r33 = b64_pow_mul64(a: ahh, b: bhh)
  var r32 = b64_pow_mul64(a: ahh, b: bhl)
  var r23 = b64_pow_mul64(a: ahl, b: bhh)
  var r31 = b64_pow_mul64(a: ahh, b: blh)
  var r13 = b64_pow_mul64(a: alh, b: bhh)
  var r22 = b64_pow_mul64(a: ahl, b: bhl)
  var r21 = b64_pow_mul64(a: ahl, b: blh)
  var r12 = b64_pow_mul64(a: alh, b: bhl)
  var t3 = (r12 >>> 64) +% (r21 >>> 64)
  var t4 = r22 +% t3
  var c4 = b64_pow_carry(sum: t4, a: r22)
  var t4b = r13 +% t4
  c4 = c4 +% b64_pow_carry(sum: t4b, a: r13)
  var t4c = r31 +% t4b
  c4 = c4 +% b64_pow_carry(sum: t4c, a: r31)
  var t5 = r23 +% (t4c >>> 64)
  var c5 = b64_pow_carry(sum: t5, a: r23)
  var t5b = r32 +% t5
  c5 = c5 +% b64_pow_carry(sum: t5b, a: r32)
  var t6 = r33 +% ((c5 << 64) | (t5b >>> 64)) +% c4
  var t5f = (t5b << 64) | (t4c & b64_pow_mask64())
  return b64_pow_qint_norm(t6: t6, t5: t5f, ex: a.ex + b.ex, sgn: a.sgn ^ b.sgn)

### `a * b` using only the upper limb of `b`, with error below 2 ulps.
### :param a: The first factor.
### :param b: The second factor.
### :returns: The product.
secret routine b64_pow_mul_qint_41(a: B64PowQint, b: B64PowQint) -> B64PowQint
  var bhh = b64_pow_hi(v: b.rh)
  var r33 = b64_pow_mul64(a: b64_pow_hi(v: a.rh), b: bhh)
  var r23 = b64_pow_mul64(a: b64_pow_lo(v: a.rh), b: bhh)
  var r13 = b64_pow_mul64(a: b64_pow_hi(v: a.rl), b: bhh)
  var r03 = b64_pow_mul64(a: b64_pow_lo(v: a.rl), b: bhh)
  var t3 = r03 >>> 64
  var t4 = r13 +% t3
  var c4 = b64_pow_carry(sum: t4, a: r13)
  var t5 = r23 +% (t4 >>> 64)
  var c5 = b64_pow_carry(sum: t5, a: r23)
  var t6 = r33 +% ((c5 << 64) | (t5 >>> 64)) +% c4
  var t5f = (t5 << 64) | (t4 & b64_pow_mask64())
  return b64_pow_qint_norm(t6: t6, t5: t5f, ex: a.ex + b.ex, sgn: a.sgn ^ b.sgn)

### `a * b` using only the upper three limbs of `a` and the upper limb of `b` (exact).
### :param a: The first factor.
### :param b: The second factor.
### :returns: The product.
secret routine b64_pow_mul_qint_31(a: B64PowQint, b: B64PowQint) -> B64PowQint
  var bhh = b64_pow_hi(v: b.rh)
  var r33 = b64_pow_mul64(a: b64_pow_hi(v: a.rh), b: bhh)
  var r23 = b64_pow_mul64(a: b64_pow_lo(v: a.rh), b: bhh)
  var r13 = b64_pow_mul64(a: b64_pow_hi(v: a.rl), b: bhh)
  var t4 = r13
  var t5 = r23 +% (t4 >>> 64)
  var c5 = b64_pow_carry(sum: t5, a: r23)
  var t6 = r33 +% ((c5 << 64) | (t5 >>> 64))
  var t5f = (t5 << 64) | (t4 & b64_pow_mask64())
  return b64_pow_qint_norm(t6: t6, t5: t5f, ex: a.ex + b.ex, sgn: a.sgn ^ b.sgn)

### `a * b` using only the upper two limbs of `a` and `b` (exact).
### :param a: The first factor.
### :param b: The second factor.
### :returns: The product.
secret routine b64_pow_mul_qint_22(a: B64PowQint, b: B64PowQint) -> B64PowQint
  var ahh = b64_pow_hi(v: a.rh)
  var ahl = b64_pow_lo(v: a.rh)
  var bhh = b64_pow_hi(v: b.rh)
  var bhl = b64_pow_lo(v: b.rh)
  var r33 = b64_pow_mul64(a: ahh, b: bhh)
  var r32 = b64_pow_mul64(a: ahh, b: bhl)
  var r23 = b64_pow_mul64(a: ahl, b: bhh)
  var r22 = b64_pow_mul64(a: ahl, b: bhl)
  var t4 = r22
  var t5 = r23 +% (t4 >>> 64)
  var c5 = b64_pow_carry(sum: t5, a: r23)
  var t5b = r32 +% t5
  c5 = c5 +% b64_pow_carry(sum: t5b, a: r32)
  var t6 = r33 +% ((c5 << 64) | (t5b >>> 64))
  var t5f = (t5b << 64) | (t4 & b64_pow_mask64())
  return b64_pow_qint_norm(t6: t6, t5: t5f, ex: a.ex + b.ex, sgn: a.sgn ^ b.sgn)

### `a * b` using only the upper two limbs of `a` and the upper limb of `b` (exact).
### :param a: The first factor.
### :param b: The second factor.
### :returns: The product.
secret routine b64_pow_mul_qint_21(a: B64PowQint, b: B64PowQint) -> B64PowQint
  var bhh = b64_pow_hi(v: b.rh)
  var r33 = b64_pow_mul64(a: b64_pow_hi(v: a.rh), b: bhh)
  var r23 = b64_pow_mul64(a: b64_pow_lo(v: a.rh), b: bhh)
  var t6 = r33 +% (r23 >>> 64)
  return b64_pow_qint_norm(t6: t6, t5: r23 << 64, ex: a.ex + b.ex, sgn: a.sgn ^ b.sgn)

### `a * b` using only the upper limbs of `a` and `b` (exact).
### :param a: The first factor.
### :param b: The second factor.
### :returns: The product.
secret routine b64_pow_mul_qint_11(a: B64PowQint, b: B64PowQint) -> B64PowQint
  var t6 = b64_pow_mul64(a: b64_pow_hi(v: a.rh), b: b64_pow_hi(v: b.rh))
  return b64_pow_qint_norm(t6: t6, t5: 0_u128, ex: a.ex + b.ex, sgn: a.sgn ^ b.sgn)

### `b * a` for an integer `b`, with error below 2 ulps.
### :param b: The integer factor.
### :param a: The `B64PowQint` factor.
### :returns: The product.
secret routine b64_pow_mul_qint_2(b: S64, a: B64PowQint) -> B64PowQint
  if b == 0
    return b64_pow_qint_zero()
  var c = b64_pow_u(n: b)
  var neg = 0_u64
  if b < 0
    c = 0_u64 -% c
    neg = 1_u64
  if c == 1_u64
    return B64PowQint(rh: a.rh, rl: a.rl, ex: a.ex, sgn: neg ^ a.sgn)
  var sgn = neg ^ a.sgn
  var rex = a.ex + 64
  # scale c so that 2^63 <= c < 2^64
  var k = c.leading_zeros()
  c = c << b64_pow_sh(n: k)
  rex = rex - b64_pow_s(n: k)
  var t3 = b64_pow_mul64(a: b64_pow_hi(v: a.rh), b: c)
  var t2 = b64_pow_mul64(a: b64_pow_lo(v: a.rh), b: c)
  var t1 = b64_pow_mul64(a: b64_pow_hi(v: a.rl), b: c)
  var t0 = b64_pow_mul64(a: b64_pow_lo(v: a.rl), b: c)
  var t = t0 >>> 64
  var t1s = t +% t1
  var cy = b64_pow_carry(sum: t1s, a: t)
  t = (cy << 64) | (t1s >>> 64)
  var t2s = t +% t2
  cy = b64_pow_carry(sum: t2s, a: t)
  t3 = t3 +% ((cy << 64) | (t2s >>> 64))
  var ex = b64_pow_hi(v: t3).leading_zeros()
  var t2f = (t2s << 64) | (t1s & b64_pow_mask64())
  if ex != 0_u64
    return B64PowQint(rh: (t3 << 1) | (t2f >>> 127), rl: t2f << 1, ex: rex - 1, sgn: sgn)
  return B64PowQint(rh: t3, rl: t2f, ex: rex, sgn: sgn)

### Converts a nonzero finite `B64` to a `B64PowQint` (exact).
### :param b: The value.
### :returns: The same value.
secret routine b64_pow_qint_fromd(b: B64) -> B64PowQint
  var d = b64_pow_dint_fromd(b: b)
  return B64PowQint(rh: b64_pow_join(hi: b64_pow_hi(v: d.r), lo: 0_u64), rl: 0_u128, ex: d.ex, sgn: d.sgn)

### Converts a `B64PowQint` to an integer, rounding toward zero.
### :param a: The value.
### :returns: The truncated integer.
secret routine b64_pow_qint_toi(a: B64PowQint) -> S64
  if a.ex < 0
    return 0
  var r = b64_pow_s(n: b64_pow_hi(v: a.rh) >>> b64_pow_ssh(n: 63 - a.ex))
  if a.sgn != 0_u64
    return 0 - r
  return r

### Approximates log(1+z) for |z| <= 2^-13 (only the upper limb of z nonzero), relative error below
### 2^-252.66.
### :param z: The reduced argument.
### :returns: The approximation.
secret routine b64_pow_p_3(z: B64PowQint) -> B64PowQint
