  z = b64_pow_add_qint(a: B64PowQint(rh: 1_u128 << 127, rl: 0_u128, ex: 0, sgn: 1_u64), b: z)
  var r = b64_pow_mul_qint_2(b: big_e, a: b64_pow_qint_log2())
  var p = b64_pow_p_3(z: z)
  p = b64_pow_add_qint(a: b64_pow_log_inv_3_2(i: j - 8128_u64), b: p)
  p = b64_pow_add_qint(a: b64_pow_log_inv_3_1(i: i - 90_u64), b: p)
  return b64_pow_add_qint(a: p, b: r)

### Approximates exp(x) for |x| < 744.45 with relative error below 2^-241.10.
### :param x: The argument.
### :returns: The approximation.
secret routine b64_pow_exp_3(x: B64PowQint) -> B64PowQint
