  r = b64_pow_add_qint_22(a: b64_pow_p_3_at(i: 1_u64), b: r)
  var k = 2_u64
  while k < 4_u64
    r = b64_pow_mul_qint_11(a: r, b: z)
    r = b64_pow_add_qint_22(a: b64_pow_p_3_at(i: k), b: r)
    k = k + 1_u64
  while k < 8_u64
    r = b64_pow_mul_qint_21(a: r, b: z)
    r = b64_pow_add_qint_22(a: b64_pow_p_3_at(i: k), b: r)
    k = k + 1_u64
  while k < 14_u64
    r = b64_pow_mul_qint_31(a: r, b: z)
    r = b64_pow_add_qint(a: b64_pow_p_3_at(i: k), b: r)
    k = k + 1_u64
  while k < 18_u64
    r = b64_pow_mul_qint_41(a: r, b: z)
    r = b64_pow_add_qint(a: b64_pow_p_3_at(i: k), b: r)
    k = k + 1_u64
  return b64_pow_mul_qint_41(a: r, b: z)

### Approximates exp(y) for |y| < 0.00016923, relative error below 2^-241.11.
### :param y: The reduced argument.
### :returns: The approximation.
secret routine b64_pow_q_3(y: B64PowQint) -> B64PowQint
