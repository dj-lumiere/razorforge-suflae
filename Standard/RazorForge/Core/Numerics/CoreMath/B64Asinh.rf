module Core

# ============================================================================
# Correctly rounded inverse hyperbolic sine of B64
# ============================================================================
# Ported from CORE-MATH, src/binary64/asinh/asinh.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2023-2025 Alexei Sibidanov <sibid@uvic.ca>.
# Distributed under the MIT license: see LICENSE-CORE-MATH next to this file. RazorForge has no dynamic
# rounding modes, so only the round-to-nearest path of the original is kept (its errno reporting is
# dropped). Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats. The
# log tables shared with acosh and atanh live in B64ArcHypShared.rf.

### Inverse hyperbolic sine, correctly rounded: the exact `asinh(me)` rounded to the nearest `B64` (ties
### to even), identical on every platform. `asinh(-x) == -asinh(x)`, and ±0, ±infinity and NaN map to
### themselves.
### :returns: The correctly rounded inverse hyperbolic sine.
routine B64.asinh() -> B64
  var x = me
  var ax = x.abs()
  var u = ax.to_bits()
  if u < 0x3FBB000000000000_u64
    # |x| < 0x1.bp-4
    if u < 0x3E57137449123EF7_u64
      # |x| < 0x1.7137449123ef7p-26: asinh(x) rounds to x (fma(-2^-60, -0, -0) would give +0)
      if u == 0
        return x
      return LLVM::fma[B64](a: -0x1p-60, b: x, c: x)
    var x2h = x *! x
    var x2l = LLVM::fma[B64](a: x, b: x, c: -x2h)
    var x3h = x2h *! x
    var sl = 0.0
    if u < 0x3F93000000000000_u64
      # |x| < 0x1.3p-6
      if u < 0x3F30000000000000_u64
        # |x| < 2^-12
        if u < 0x3E5A000000000000_u64
          # |x| < 0x1.ap-26
          sl = x3h *! -0x1.5555555555555p-3
        else
          sl = x3h *! (-0x1.5555555555555p-3 +! x2h *! 0x1.3333327c57c6p-4)
      else
        sl = x3h *! (-0x1.5555555555555p-3 +! x2h *! (0x1.333333332f2ffp-4 +! x2h *! (-0x1.6db6d9a665159p-5 +! x2h *! 0x1.f186866d775fp-6)))
    else
      # 0x1.3p-6 <= |x| < 0x1.bp-4: a minimax polynomial with relative error < 2^-63.091
      var c1 = 0x1.333333333331p-4 +! x2h *! -0x1.6db6db6da466cp-5
      var c3 = 0x1.f1c71c2ea7be4p-6 +! x2h *! -0x1.6e8b651b09d72p-6
      var c5 = 0x1.1c309fc0e69c2p-6 +! x2h *! -0x1.bab7833c1ep-7
      var x4 = x2h *! x2h
      sl = x3h *! (-0x1.5555555555555p-3 +! x2h *! (c1 +! x4 *! (c3 +! x4 *! c5)))
    var eps = 0x1.79p-53 *! x3h
    var lb = x +! (sl -! eps)
    var ub = x +! (sl +! eps)
    if lb == ub
      return lb
    return b64_asinh_zero(x: x, x2h: x2h, x2l: x2l)
  # |x| >= 0x1.bp-4
  var x2h = 0.0
  var x2l = 0.0
  var ah = 0.0
  var al = 0.0
  var off = 0x3FF_s64
  if u < 0x4190000000000000_u64
    # |x| < 2^26
    x2h = x *! x
    x2l = LLVM::fma[B64](a: x, b: x, c: -x2h)
    var s = b64_hyp_fasttwosum(x: x2h, y: 1.0)
    if u < 0x3FF0000000000000_u64
      s = b64_hyp_fasttwosum(x: 1.0, y: x2h)
    var th = s.item0
    var tl = s.item1 +! x2l
    ah = LLVM::sqrt[B64](th)
    var rs = 0.5 /! th
    al = (tl -! LLVM::fma[B64](a: ah, b: ah, c: -th)) *! (rs *! ah)
    s = b64_hyp_fasttwosum(x: ah, y: ax)
    ah = s.item0
    al = al +! s.item1
  elseif u < 0x4330000000000000_u64
    # |x| < 2^52
    ah = 2.0 *! ax
    al = 0.5 /! ax
  else
    # |x| >= 2^52
    if u >= 0x7FF0000000000000_u64
      return x +! x
    off = 0x3FE
    ah = ax
    al = 0.0
  var t = ah.to_bits()
  var e = LLVM::reinterpret_bits[U64, S64](t >>> 52) - off
  t = t & 0x000FFFFFFFFFFFFF_u64
  var ed = LLVM::signed_to_float[S64, B64](e)
  var i = t >>> 47
  var d = LLVM::reinterpret_bits[U64, S64](t & 0x00007FFFFFFFFFFF_u64)
  var bc0 = LLVM::reinterpret_bits[S64, U64](B64_AHYP_B_C0[i])
  var bc1 = B64_AHYP_B_C1[i] * (d >> 16)
  var j = (t +% (bc0 << 33) +% LLVM::reinterpret_bits[S64, U64](bc1)) >>> 42
  t = t | 0x3FF0000000000000_u64
  var i1 = j >>> 5
  var i2 = j & 0x1F_u64
  var r = B64.from_bits(bits: B64_AHYP_R1[i1]) *! B64.from_bits(bits: B64_AHYP_R2[i2])
  var dx = LLVM::fma[B64](a: r, b: B64.from_bits(bits: t), c: -1.0)
  var dx2 = dx *! dx
  var f = dx2 *! ((-0x1p-1 +! dx *! 0x1.555555555553p-2) +! dx2 *! ((-0x1.fffffffffffap-3 +! dx *! 0x1.99999e33a6366p-3) +! dx2 *! -0x1.555559ef9525fp-3))
  var l2h = 0x1.62e42fefa38p-1
  var l2l = 0x1.ef35793c7673p-45
  var lh = l2h *! ed +! (B64.from_bits(bits: B64_AHYP_L1_HI[i1]) +! B64.from_bits(bits: B64_AHYP_L2_HI[i2]))
  var ll = (((l2l *! ed +! B64.from_bits(bits: B64_AHYP_L1_LO[i1])) +! B64.from_bits(bits: B64_AHYP_L2_LO[i2])) +! al /! ah) +! f
  ll = ll +! dx
  var sgn: B64 = 1.0
  sgn = sgn.copysign(sign: x)
  lh = lh *! sgn
  ll = ll *! sgn
  # 1.63e-19 in the original
  var eps = 0x1.80df744ce99c7p-63
  var lb = lh +! (ll -! eps)
  var ub = lh +! (ll +! eps)
  if lb == ub
    return lb
  if ax < 0x1p-2
    return b64_asinh_zero(x: x, x2h: x2h, x2l: x2l)
  return b64_asinh_refine(x: x, zh: ah, zl: al, a: 0x1.71547652b82fep+0 *! lb.abs())

### Adds the double-doubles `xh + xl` and `ch + cl` (the high parts with an exact two-sum).
### :param xh: The high part of the first addend.
### :param xl: The low part of the first addend.
### :param ch: The high part of the second addend.
### :param cl: The low part of the second addend.
### :returns: The high and low parts of the sum.
secret routine b64_asinh_adddd(xh: B64, xl: B64, ch: B64, cl: B64) -> (B64, B64)
  var s = xh +! ch
  var d = s -! xh
  var l = ((ch -! d) +! (xh +! (d -! s))) +! (xl +! cl)
  return (s, l)

### Multiplies the double-double `xh + xl` by `ch + cl`, returning a renormalized double-double.
### :param xh: The high part of the first factor.
### :param xl: The low part of the first factor.
### :param ch: The high part of the second factor.
### :param cl: The low part of the second factor.
### :returns: The high and low parts of the product.
secret routine b64_asinh_muldd_acc(xh: B64, xl: B64, ch: B64, cl: B64) -> (B64, B64)
  var ahlh = ch *! xl
  var alhh = cl *! xh
  var ahhh = ch *! xh
  var ahhl = LLVM::fma[B64](a: ch, b: xh, c: -ahhh)
  ahhl = ahhl +! (alhh +! ahlh)
  var h = ahhh +! ahhl
  var l = (ahhh -! h) +! ahhl
  return (h, l)

### Multiplies the double-double `xh + xl` by the double `ch`, returning a renormalized double-double.
### :param xh: The high part of the first factor.
### :param xl: The low part of the first factor.
### :param ch: The second factor.
### :returns: The high and low parts of the product.
secret routine b64_asinh_mulddd(xh: B64, xl: B64, ch: B64) -> (B64, B64)
  var ahlh = ch *! xl
  var ahhh = ch *! xh
  var ahhl = LLVM::fma[B64](a: ch, b: xh, c: -ahhh)
  ahhl = ahhl +! ahlh
  var h = ahhh +! ahhl
  var l = (ahhh -! h) +! ahhl
  return (h, l)

### The first Horner step of a double-double polynomial: `(c_hi + c_lo) + l`.
### :param l: The value of the higher-degree tail, evaluated in double precision.
### :param c_hi: The high part of the top double-double coefficient.
### :param c_lo: The low part of the top double-double coefficient.
### :returns: The running value as a double-double.
secret routine b64_asinh_polydd_init(l: B64, c_hi: B64, c_lo: B64) -> (B64, B64)
  var ch = c_hi +! l
  var cl = ((c_hi -! ch) +! l) +! c_lo
  return (ch, cl)

### One Horner step of a double-double polynomial: `(ch + cl) * (xh + xl) + (c_hi + c_lo)`.
### :param xh: The high part of the variable.
### :param xl: The low part of the variable.
### :param ch: The high part of the running value.
### :param cl: The low part of the running value.
### :param c_hi: The high part of the next coefficient.
### :param c_lo: The low part of the next coefficient.
### :returns: The new running value as a double-double.
secret routine b64_asinh_polydd_step(xh: B64, xl: B64, ch: B64, cl: B64, c_hi: B64, c_lo: B64) -> (B64, B64)
  var p = b64_asinh_muldd_acc(xh: xh, xl: xl, ch: ch, cl: cl)
  var th = p.item0 +! c_hi
  var tl = (c_hi -! th) +! p.item0
  var l = p.item1 +! (tl +! c_lo)
  return (th, l)

### The accurate path of asinh for small |x|, using a double-double odd polynomial.
### :param x: The argument.
### :param x2h: The high part of x^2.
### :param x2l: The low part of x^2.
### :returns: The correctly rounded asinh(x).
secret routine b64_asinh_zero(x: B64, x2h: B64, x2l: B64) -> B64
  var y2 = x2h *! (-0x1.7828d553ec8p-8 +! x2h *! (0x1.51712f7bee368p-8 +! x2h *! (-0x1.2e6d98527bcc6p-8 +! x2h *! (0x1.0095da47b392cp-8 +! x2h *! -0x1.3b92d6368192cp-9))))
  var p = b64_asinh_polydd_init(l: y2, c_hi: 0x1.a685fc5de7a04p-8, c_lo: 0x1.40d284a1d67f9p-62)
  p = b64_asinh_polydd_step(xh: x2h, xl: x2l, ch: p.item0, cl: p.item1, c_hi: -0x1.df3bd104aa267p-8, c_lo: -0x1.546da9bc5b32ap-62)
  p = b64_asinh_polydd_step(xh: x2h, xl: x2l, ch: p.item0, cl: p.item1, c_hi: 0x1.12ef3ceae4d12p-7, c_lo: -0x1.ba9c13deb261fp-61)
  p = b64_asinh_polydd_step(xh: x2h, xl: x2l, ch: p.item0, cl: p.item1, c_hi: -0x1.3fde50d764083p-7, c_lo: -0x1.d024df7fa0542p-61)
  p = b64_asinh_polydd_step(xh: x2h, xl: x2l, ch: p.item0, cl: p.item1, c_hi: 0x1.7a87878786c7ep-7, c_lo: 0x1.a83c7bace55ebp-61)
  p = b64_asinh_polydd_step(xh: x2h, xl: x2l, ch: p.item0, cl: p.item1, c_hi: -0x1.c999999999977p-7, c_lo: -0x1.38e7a467ecc55p-61)
  p = b64_asinh_polydd_step(xh: x2h, xl: x2l, ch: p.item0, cl: p.item1, c_hi: 0x1.1c4ec4ec4ec4fp-6, c_lo: -0x1.74e3c1dfd4c3dp-60)
  p = b64_asinh_polydd_step(xh: x2h, xl: x2l, ch: p.item0, cl: p.item1, c_hi: -0x1.6e8ba2e8ba2e9p-6, c_lo: 0x1.17f937248cf81p-60)
  p = b64_asinh_polydd_step(xh: x2h, xl: x2l, ch: p.item0, cl: p.item1, c_hi: 0x1.f1c71c71c71c7p-6, c_lo: 0x1.c71a35cfa0671p-62)
  p = b64_asinh_polydd_step(xh: x2h, xl: x2l, ch: p.item0, cl: p.item1, c_hi: -0x1.6db6db6db6db7p-5, c_lo: 0x1.2492496091b0cp-60)
  p = b64_asinh_polydd_step(xh: x2h, xl: x2l, ch: p.item0, cl: p.item1, c_hi: 0x1.3333333333333p-4, c_lo: 0x1.99999999949dfp-59)
  p = b64_asinh_polydd_step(xh: x2h, xl: x2l, ch: p.item0, cl: p.item1, c_hi: -0x1.5555555555555p-3, c_lo: -0x1.5555555555555p-57)
  p = b64_asinh_muldd_acc(xh: p.item0, xl: p.item1, ch: x2h, cl: x2l)
  p = b64_asinh_mulddd(xh: p.item0, xl: p.item1, ch: x)
  var s0 = b64_hyp_fasttwosum(x: x, y: p.item0)
  var y0 = s0.item0
  var s1 = b64_hyp_fasttwosum(x: s0.item1, y: p.item1)
  var y1 = s1.item0
  y2 = s1.item1
  var tu = y1.to_bits()
  if tu & 0x000FFFFFFFFFFFFF_u64 == 0
    # y1 is a power of two: nudge it by one ulp toward y2 so the final rounding sees the sticky bits
    if (y2.to_bits() ^ tu) >>> 63 == 1
      tu = tu -% 1
    else
      tu = tu +% 1
    y1 = B64.from_bits(bits: tu)
  return y0 +! y1

### The accurate path of asinh: log(zh + zl) to about 150 bits, where `zh + zl` approximates
### `|x| + sqrt(x^2 + 1)` and `a` approximates `log2(zh + zl)`.
### :param x: The argument (only its sign is used, and for the database lookup).
### :param zh: The high part of `|x| + sqrt(x^2 + 1)` (or of `2|x|`, or of `|x|` for huge `|x|`).
### :param zl: The low part.
### :param a: An approximation of `log2(zh + zl)`.
### :returns: The correctly rounded asinh(x).
secret routine b64_asinh_refine(x: B64, zh: B64, zl: B64, a: B64) -> B64
  var t = zh.to_bits()
  var e = LLVM::reinterpret_bits[U64, S64](t >>> 52) - 0x3FF
  if zl == 0.0
    e = e + 1
  t = (t & 0x000FFFFFFFFFFFFF_u64) | 0x3FF0000000000000_u64
  var ed = LLVM::signed_to_float[S64, B64](e)
  var v = ((a -! ed) +! 0x1.00008p+0).to_bits()
  var i = (v -% 0x3FF0000000000000_u64) >>> 36
  var i1 = (i >>> 12) & 0x1F_u64
  var i2 = (i >>> 8) & 0xF_u64
  var i3 = (i >>> 4) & 0xF_u64
  var i4 = i & 0xF_u64
  var k1 = i2 + 17
  var k2 = i3 + 34
  var k3 = i4 + 51
  var el2 = -0x1.9ff0342542fc3p-91 *! ed
  var el1 = 0x1.ef35793c768p-46 *! ed
  var el0 = 0x1.62e42fefa38p-2 *! ed
  var big0 = (B64.from_bits(bits: B64_AHYP_LL0[i1]) +! B64.from_bits(bits: B64_AHYP_LL0[k1])) +! (B64.from_bits(bits: B64_AHYP_LL0[k2]) +! B64.from_bits(bits: B64_AHYP_LL0[k3]))
  var big1 = (B64.from_bits(bits: B64_AHYP_LL1[i1]) +! B64.from_bits(bits: B64_AHYP_LL1[k1])) +! (B64.from_bits(bits: B64_AHYP_LL1[k2]) +! B64.from_bits(bits: B64_AHYP_LL1[k3]))
  var big2 = (B64.from_bits(bits: B64_AHYP_LL2[i1]) +! B64.from_bits(bits: B64_AHYP_LL2[k1])) +! (B64.from_bits(bits: B64_AHYP_LL2[k2]) +! B64.from_bits(bits: B64_AHYP_LL2[k3]))
  big0 = big0 +! el0
  var t12 = B64.from_bits(bits: B64_AHYP_RT1[i1]) *! B64.from_bits(bits: B64_AHYP_RT2[i2])
  var t34 = B64.from_bits(bits: B64_AHYP_RT3[i3]) *! B64.from_bits(bits: B64_AHYP_RT4[i4])
  var th = t12 *! t34
  var tl = LLVM::fma[B64](a: t12, b: t34, c: -th)
  var tf = B64.from_bits(bits: t)
  var dh = th *! tf
  var dl = LLVM::fma[B64](a: th, b: tf, c: -dh)
  var sh = tl *! tf
  var sl = LLVM::fma[B64](a: tl, b: tf, c: -sh)
  var q = b64_hyp_fasttwosum(x: dh -! 1.0, y: dl)
  var xh = q.item0
  var xl = q.item1
  if zl != 0.0
    # zl / 2^e, scaled like t = zh / 2^e
    var zs = zl.to_bits() -% (LLVM::reinterpret_bits[S64, U64](e) << 52)
    xl = xl +! th *! B64.from_bits(bits: zs)
  q = b64_asinh_adddd(xh: xh, xl: xl, ch: sh, cl: sl)
  xh = q.item0
  xl = q.item1
  sl = xh *! (-0x1p-3 +! xh *! (0x1.9999999a0754fp-4 +! xh *! -0x1.55555555c3157p-4))
  q = b64_asinh_polydd_init(l: sl, c_hi: 0x1.5555555555555p-3, c_lo: 0x1.55540c15cf91fp-57)
  q = b64_asinh_polydd_step(xh: xh, xl: xl, ch: q.item0, cl: q.item1, c_hi: -0x1p-2, c_lo: -0x1.932ce43199a8dp-110)
  q = b64_asinh_polydd_step(xh: xh, xl: xl, ch: q.item0, cl: q.item1, c_hi: 0x1p-1, c_lo: 0x1.24b67ee516e3bp-111)
  q = b64_asinh_muldd_acc(xh: xh, xl: xl, ch: q.item0, cl: q.item1)
  q = b64_asinh_adddd(xh: q.item0, xl: q.item1, ch: el1, cl: el2)
  q = b64_asinh_adddd(xh: q.item0, xl: q.item1, ch: big1, cl: big2)
  sh = q.item0
  sl = q.item1
  var w = b64_hyp_fasttwosum(x: big0, y: sh)
  var v0 = w.item0
  w = b64_hyp_fasttwosum(x: w.item1, y: sl)
  var v1 = w.item0
  var v2 = w.item1
  w = b64_hyp_fasttwosum(x: v0, y: v1)
  v0 = w.item0
  v1 = w.item1
  w = b64_hyp_fasttwosum(x: v1, y: v2)
  v1 = w.item0
  v2 = w.item1
  var two: B64 = 2.0
  two = two.copysign(sign: x)
  v0 = v0 *! two
  v1 = v1 *! two
  v2 = v2 *! two
  var tu = v1.to_bits()
  if tu & 0x000FFFFFFFFFFFFF_u64 == 0
    # v1 is a power of two: nudge it by one ulp toward v2 so the final rounding sees the sticky bits
    if (v2.to_bits() ^ tu) >>> 63 == 1
      tu = tu -% 1
    else
      tu = tu +% 1
    v1 = B64.from_bits(bits: tu)
  var er = (tu +% 41) & 0x000FFFFFFFFFFFFF_u64
  var de = ((v0.to_bits() >>> 52) & 0x7FF_u64) -% ((tu >>> 52) & 0x7FF_u64)
  var res = v0 +! v1
  if de > 99 or er < 80
    return b64_asinh_database(x: x, f: res)
  return res

### Exact asinh values for the arguments whose rounding the fast paths cannot decide.
### :param x: The argument.
### :param f: The value to return when `|x|` is not in the table.
### :returns: The correctly rounded asinh(x), or `f`.
secret routine b64_asinh_database(x: B64, f: B64) -> B64
  var ax = x.abs()
  var a = 0_s64
  var b = 34_s64
  var sgn: B64 = 1.0
  sgn = sgn.copysign(sign: x)
  while a <= b
    var m = (a + b) // 2
    var mu = LLVM::reinterpret_bits[S64, U64](m)
    var key = B64.from_bits(bits: B64_ASINH_DB_X[mu])
    if key < ax
      a = m + 1
    elseif key == ax
      return sgn *! B64.from_bits(bits: B64_ASINH_DB_H[mu]) +! sgn *! B64.from_bits(bits: B64_ASINH_DB_L[mu])
    else
      b = m - 1
  return f

# The database: arguments |x| (sorted), then the high and low parts of asinh(|x|), as IEEE bit patterns.
secret preset B64_ASINH_DB_X: Array[U64, 35] = [
  0x3FD00F9476450863_u64, 0x3FD1F0A79315B287_u64, 0x3FD2B9618FF7ACB7_u64, 0x3FD389EF683F3AA7_u64,
  0x3FD3B07E0C779DDA_u64, 0x3FD48441DF33B6D3_u64, 0x3FD687BD068C1C1E_u64, 0x3FD8740C4453A056_u64,
  0x3FD891ACDA11167E_u64, 0x3FDBAFC3479FC9CC_u64, 0x3FDC59869F17B483_u64, 0x3FDC8BE879787986_u64,
  0x3FDE73B46ABB01E1_u64, 0x3FDED6236DA268B0_u64, 0x3FDF399EBAFC1951_u64, 0x3FDF70975AB0D471_u64,
