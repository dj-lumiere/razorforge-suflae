module Core

# ============================================================================
# Correctly rounded hyperbolic sine of B64
# ============================================================================
# Ported from CORE-MATH, src/binary64/sinh/sinh.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2023-2026 Alexei Sibidanov and Paul Zimmermann.
# Distributed under the MIT license: see LICENSE-CORE-MATH next to this file. RazorForge has no dynamic
# rounding modes, so only the round-to-nearest path of the original is kept (its errno reporting is
# dropped). Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats. The
# exp tables and double-double helpers shared with cosh live in B64HypShared.rf.

### Hyperbolic sine with raw IEEE 754 propagation (overflow -> ±infinity), correctly rounded: the exact
### `sinh(me)` rounded to the nearest `B64` (ties to even), identical on every platform. ±0, ±infinity
### and NaN map to themselves.
### :returns: The correctly rounded hyperbolic sine.
routine B64.sinh_unchecked() -> B64
  var x = me
  var ax = x.abs()
  var v0 = LLVM::fma[B64](a: ax, b: 0x1.71547652b82fep+12, c: 0x1.8000002p+26)
  var jt = v0.to_bits()
  var t = B64.from_bits(bits: jt & 0xFFFFFFFFFC000000_u64) -! 0x1.8p26
  var aix = ax.to_bits()
  if aix < 0x3FD0000000000000_u64
    # |x| < 2^-2
    if aix < 0x3E57137449123EF7_u64
      # |x| < 0x1.7137449123ef7p-26
      return LLVM::fma[B64](a: x, b: 0x1p-55, c: x)
    # q = x + p is a minimax approximation of sinh(x) on [x0, 1/4] with |q - sinh(x)|/x^3 < 2^-56.584
    var x2 = x *! x
    var x3 = x2 *! x
    var x4 = x2 *! x2
    var p = x3 *! ((0x1.5555555555555p-3 +! x2 *! 0x1.111111111151ep-7) +! x4 *! ((0x1.a01a019d0c767p-13 +! x2 *! 0x1.71de444a96e11p-19) +! x4 *! 0x1.ae8465375242p-26))
    var e = x3 *! 0x1.cp-53
    var lb = x +! (p -! e)
    var ub = x +! (p +! e)
    if lb == ub
      return lb
    return b64_sinh_zero(x: x)
  if aix > 0x408633CE8FB9F87D_u64
    # |x| >~ 710.47586
    if aix >= 0x7FF0000000000000_u64
      return x +! x
    var big: B64 = 0x1p1023
    return big.copysign(sign: x) *! 2.0
  # now 0.25 <= |x| < 710.47586
  var sgn: B64 = 1.0
  sgn = sgn.copysign(sign: x)
  var il = LLVM::reinterpret_bits[U64, S64]((jt << 14) >>> 40)
  var jl = -il
  var i1 = LLVM::reinterpret_bits[S64, U64](il & 0x3F)
  var i0 = LLVM::reinterpret_bits[S64, U64]((il >> 6) & 0x3F)
  var ie = il >> 12
  var j1 = LLVM::reinterpret_bits[S64, U64](jl & 0x3F)
  var j0 = LLVM::reinterpret_bits[S64, U64]((jl >> 6) & 0x3F)
  var je = jl >> 12
  var sp = B64.from_bits(bits: LLVM::reinterpret_bits[S64, U64](1022 + ie) << 52)
  var t0h = B64.from_bits(bits: B64_HYP_T0_HI[i0])
  var t0l = B64.from_bits(bits: B64_HYP_T0_LO[i0])
  var t1h = B64.from_bits(bits: B64_HYP_T1_HI[i1])
  var t1l = B64.from_bits(bits: B64_HYP_T1_LO[i1])
  var th = t0h *! t1h
  var tl = (t0h *! t1l +! t1h *! t0l) +! LLVM::fma[B64](a: t0h, b: t1h, c: -th)
  var l2h = 0x1.62e42ffp-13
  var l2l = 0x1.718432a1b0e26p-47
  var dx = (ax -! l2h *! t) +! l2l *! t
  var dx2 = dx *! dx
  var mx = -dx
  var ch0 = 0x1p+0
  var ch1 = 0x1p-1
  var ch2 = 0x1.5555555aaaaaep-3
  var ch3 = 0x1.55555551c98cp-5
  var pp = dx *! ((ch0 +! dx *! ch1) +! dx2 *! (ch2 +! dx *! ch3))
  var rh = 0.0
  var rl = 0.0
  if aix > 0x4014000000000000_u64
    # |x| > 5
    if aix > 0x40425E4F7B2737FA_u64
      # |x| >~ 36.736801: exp(-|x|) is negligible
      sp = B64.from_bits(bits: LLVM::reinterpret_bits[S64, U64](1021 + ie) << 52)
      rh = th
      rl = tl +! th *! pp
      rh = rh *! sgn
      rl = rl *! sgn
      var e = 0x1.1b6p-63 *! th
      var lb = rh +! (rl -! e)
      var ub = rh +! (rl +! e)
      if lb == ub
        return (lb *! sp) *! 2.0
      var acc = b64_hyp_exp_accurate(x: ax, t: t, th: th, tl: tl)
      acc = b64_hyp_fasttwosum(x: acc.item0, y: acc.item1)
      var bh = acc.item0 *! sgn
      var bl = acc.item1 *! sgn
      var eh = (bh.to_bits() >>> 52) & 0x7FF_u64
      var el = (bl.to_bits() >>> 52) & 0x7FF_u64
      var ml = (bl.to_bits() +% 8) & 0x000FFFFFFFFFFFFF_u64
      bh = bh +! bl
      bh = bh *! 2.0
      bh = bh *! sp
      if ml <= 16 or eh > el + 103
        return b64_sinh_database(x: x, f: bh)
      return bh
    # now 5 < |x| < 36.736801
    var sm = B64.from_bits(bits: LLVM::reinterpret_bits[S64, U64](1022 + je) << 52)
    var q0h = B64.from_bits(bits: B64_HYP_T0_HI[j0])
    var q1h = B64.from_bits(bits: B64_HYP_T1_HI[j1])
    var qh = q0h *! q1h
    th = th *! sp
    tl = tl *! sp
    qh = qh *! sm
    var pm = mx *! ((ch0 +! mx *! ch1) +! dx2 *! (ch2 +! mx *! ch3))
    var em = qh +! qh *! pm
    rh = th
    rl = (tl -! em) +! th *! pp
    rh = rh *! sgn
    rl = rl *! sgn
    var e = 0x1.202p-63 *! rh
    var lb = rh +! (rl -! e)
    var ub = rh +! (rl +! e)
    if lb == ub
      return lb
    var acc = b64_hyp_exp_accurate(x: ax, t: t, th: th, tl: tl)
    th = acc.item0
    tl = acc.item1
    if aix > 0x403F666666666666_u64
      # |x| > 31.4
      rh = th -! qh
      rl = ((th -! rh) -! qh) +! tl
    else
      # 5 < |x| <= 31.4
      qh = q0h *! q1h
      var q0l = B64.from_bits(bits: B64_HYP_T0_LO[j0])
      var q1l = B64.from_bits(bits: B64_HYP_T1_LO[j1])
      var ql = (q0h *! q1l +! q1h *! q0l) +! LLVM::fma[B64](a: q0h, b: q1h, c: -qh)
      qh = qh *! sm
      ql = ql *! sm
      var accm = b64_hyp_exp_accurate(x: -ax, t: -t, th: qh, tl: ql)
      qh = accm.item0
      ql = accm.item1
      rh = th -! qh
      rl = (((th -! rh) -! qh) -! ql) +! tl
  else
    # 0.25 <= |x| <= 5
    var sm = B64.from_bits(bits: LLVM::reinterpret_bits[S64, U64](1022 + je) << 52)
    var q0h = B64.from_bits(bits: B64_HYP_T0_HI[j0])
    var q0l = B64.from_bits(bits: B64_HYP_T0_LO[j0])
    var q1h = B64.from_bits(bits: B64_HYP_T1_HI[j1])
    var q1l = B64.from_bits(bits: B64_HYP_T1_LO[j1])
    var qh = q0h *! q1h
    var ql = (q0h *! q1l +! q1h *! q0l) +! LLVM::fma[B64](a: q0h, b: q1h, c: -qh)
    th = th *! sp
    tl = tl *! sp
    qh = qh *! sm
    ql = ql *! sm
    var pm = mx *! ((ch0 +! mx *! ch1) +! dx2 *! (ch2 +! mx *! ch3))
    var fph = th
    var fpl = tl +! th *! pp
    var fmh = qh
    var fml = ql +! qh *! pm
    rh = fph -! fmh
    rl = (((fph -! rh) -! fmh) -! fml) +! fpl
    rh = rh *! sgn
    rl = rl *! sgn
    var e = 0x1.c0ap-62 *! rh
    var lb = rh +! (rl -! e)
    var ub = rh +! (rl +! e)
    if lb == ub
      return lb
    var acc = b64_hyp_exp_accurate(x: ax, t: t, th: th, tl: tl)
    th = acc.item0
    tl = acc.item1
    var accm = b64_hyp_exp_accurate(x: -ax, t: -t, th: qh, tl: ql)
    qh = accm.item0
    ql = accm.item1
    rh = th -! qh
    rl = (((th -! rh) -! qh) -! ql) +! tl
  var s = b64_hyp_fasttwosum(x: rh, y: rl)
  rh = s.item0
  rl = s.item1
  var eh = (rh.to_bits() >>> 52) & 0x7FF_u64
  var el = (rl.to_bits() >>> 52) & 0x7FF_u64
  var ml = (rl.to_bits() +% 8) & 0x000FFFFFFFFFFFFF_u64
  rh = rh *! sgn
  rl = rl *! sgn
  rh = rh +! rl
  if ml <= 16 or eh > el + 103
    return b64_sinh_database(x: x, f: rh)
  return rh

### The accurate path of sinh for 0x1.7137449123ef7p-26 <= |x| < 1/4, using a double-double polynomial.
### :param x: The argument.
### :returns: The correctly rounded sinh(x).
secret routine b64_sinh_zero(x: B64) -> B64
  var x2 = x *! x
  var x2l = LLVM::fma[B64](a: x, b: x, c: -x2)
  var y2 = x2 *! (0x1.6124613aef206p-33 +! x2 *! (0x1.ae7f36beea815p-41 +! x2 *! 0x1.95785063cd974p-49))
  var p = b64_hyp_polydd_init(l: y2, c_hi: 0x1.ae64567f54482p-26, c_lo: -0x1.defcf17a6ab79p-81)
  p = b64_hyp_polydd_step(xh: x2, xl: x2l, ch: p.item0, cl: p.item1, c_hi: 0x1.71de3a556c734p-19, c_lo: -0x1.b4e2835532bcdp-73)
  p = b64_hyp_polydd_step(xh: x2, xl: x2l, ch: p.item0, cl: p.item1, c_hi: 0x1.a01a01a01a01ap-13, c_lo: 0x1.a0011c925b85cp-73)
  p = b64_hyp_polydd_step(xh: x2, xl: x2l, ch: p.item0, cl: p.item1, c_hi: 0x1.1111111111111p-7, c_lo: 0x1.11111115cf00dp-63)
  p = b64_hyp_polydd_step(xh: x2, xl: x2l, ch: p.item0, cl: p.item1, c_hi: 0x1.5555555555555p-3, c_lo: 0x1.555555555552fp-57)
  p = b64_hyp_mulddd(xh: p.item0, xl: p.item1, ch: x)
  p = b64_hyp_muldd(xh: p.item0, xl: p.item1, ch: x2, cl: x2l)
  var s0 = b64_hyp_fasttwosum(x: x, y: p.item0)
  var y0 = s0.item0
  var s1 = b64_hyp_fasttwosum(x: s0.item1, y: p.item1)
  var y1 = s1.item0
  y2 = s1.item1
  var tu = y1.to_bits()
  if tu & 0x000FFFFFFFFFFFFF_u64 == 0
    # y1 is a power of two: nudge it by one ulp toward y2 so the final rounding sees the sticky bits
    if (y2.to_bits() ^ tu) >>> 63 == 1
      tu = tu -% 1
    else
      tu = tu +% 1
    y1 = B64.from_bits(bits: tu)
  return y0 +! y1

### Exact sinh values for the arguments whose rounding the fast paths cannot decide.
### :param x: The argument.
### :param f: The value to return when `|x|` is not in the table.
### :returns: The correctly rounded sinh(x), or `f`.
secret routine b64_sinh_database(x: B64, f: B64) -> B64
  var ax = x.abs()
  var a = 0_s64
  var b = 50_s64
  var sgn: B64 = 1.0
  sgn = sgn.copysign(sign: x)
  while a <= b
    var m = (a + b) // 2
    var mu = LLVM::reinterpret_bits[S64, U64](m)
    var key = B64.from_bits(bits: B64_SINH_DB_X[mu])
    if key < ax
      a = m + 1
    elseif key == ax
      return sgn *! B64.from_bits(bits: B64_SINH_DB_H[mu]) +! sgn *! B64.from_bits(bits: B64_SINH_DB_L[mu])
    else
      b = m - 1
  return f

# The database: arguments |x| (sorted), then the high and low parts of sinh(|x|), as IEEE bit patterns.
secret preset B64_SINH_DB_X: Array[U64, 51] = [
  0x3FD364303E1AD8F6_u64, 0x3FD4169F234F23B9_u64, 0x3FD616CC75D49226_u64, 0x3FDAE3773250E7D2_u64,
  0x3FDB7EFA91915C95_u64, 0x3FDD68039861AB53_u64, 0x3FDE90F16EB88C09_u64, 0x3FEA3FC7E4DD47D1_u64,
  0x3FEAA3B649A96091_u64, 0x3FEC13876341B62E_u64, 0x3FF2F5D3B178914A_u64, 0x3FF3FFC12B81CBC2_u64,
