module Core

# ============================================================================
# Correctly rounded cos(pi * x) of B16
# ============================================================================
# Ported from CORE-MATH, src/binary16/cospi/cospif16.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2025 Paul Zimmermann. Distributed under the MIT license: see LICENSE-CORE-MATH next
# to this file. RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the
# original is kept.
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats.
#
# cospi is even, so only |x| is used. It splits into x1 + x2, where x1 keeps the top 11 bits of the
# B16 encoding and x2 the exponent plus the low 5 mantissa bits. Then
# cospi(x) = cospi(x1)*cospi(x2) + sinpi(x1)*(-sinpi(x2)), with B32 approximations of the four
# factors tabulated (tuned so that this single B32 evaluation rounds correctly to B16).

### Returns cos(pi * this value), correctly rounded: the exact value rounded to the nearest `B16`
### (ties to even), identical on every platform. A zero result is +0; ±infinity and NaN give NaN.
### :returns: The correctly rounded cos(pi * x).
routine B16.cospi() -> B16
  # cospi(-x) = cospi(x)
  var u = me.to_bits() & 0x7FFF_u16
  # |x| >= 2^9, so x is an integer or a half-integer
  if u >= 0x6000_u16
    if u >= 0x7C00_u16
      return b16_trig_pi_nan(x: me)
    if u < 0x6400_u16
      # |x| < 2^10: maybe a half-integer
      if (u & 1_u16) != 0_u16
        return B16.from_bits(bits: 0_u16)
      if (u & 3_u16) == 2_u16
        return B16.from_bits(bits: 0xBC00_u16)
      return B16.from_bits(bits: 0x3C00_u16)
    # |x| >= 2^10: an integer, odd only below 2^11 with its last bit set
    if u < 0x6800_u16 and (u & 1_u16) != 0_u16
      return B16.from_bits(bits: 0xBC00_u16)
    return B16.from_bits(bits: 0x3C00_u16)
  # around 0, cospi(x) = 1 - pi^2/2*x^2 + O(x^4)
  if u <= 0x1F34_u16
    # |x| <= 0x1.cdp-8
    var t = B32(from: me)
    return B16(from: LLVM::fma[B32](a: -0x1.3bd3ccp+2_b32 *! t, b: t, c: 1.0_b32))
  var i1 = LLVM::zero_extend[U16, U64](u >>> 5)
  var i2 = LLVM::zero_extend[U16, U64](((u >>> 10) << 5) | (u & 0x1F_u16))
  var s1 = B32.from_bits(bits: B16_COSPI_S1[i1])
  var c1 = B32.from_bits(bits: B16_COSPI_C1[i1])
  var s2 = B32.from_bits(bits: B16_COSPI_S2[i2])
  var c2 = B32.from_bits(bits: B16_COSPI_C2[i2])
  # the fma fixes the evaluation order
  var res = LLVM::fma[B32](a: c1, b: c2, c: s1 *! s2)
  # a zero result is +0
  if res == 0.0_b32
    return B16.from_bits(bits: 0_u16)
  return B16(from: res)

### B32 approximations of sinpi(x1), where the B16 encoding of x1 is i1 * 2^5 (from cospif16.c).
