module Core

# ============================================================================
# Correctly rounded error function of B16
# ============================================================================
# Ported from CORE-MATH, src/binary16/erf/erff16.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2022-2025 Alexei Sibidanov and Paul Zimmermann. Distributed under the MIT license: see
# LICENSE-CORE-MATH next to this file. RazorForge has no dynamic rounding modes, so only the
# round-to-nearest path of the original is kept. Arithmetic uses the unchecked operators `+! -! *! /!`,
# which are raw IEEE 754 on floats.

### Error function, correctly rounded: the exact erf rounded to the nearest `B16` (ties to even),
### identical on every platform. ±infinity gives ±1 and NaN gives NaN.
### :returns: The correctly rounded error function.
routine B16.erf() -> B16
  var x = B32(from: me)
  var ax = x.abs()
  var ux = ax.to_bits()
  var s = B64(from: x)
  var z = B64(from: ax)
  # for |x| > 0x1.f5a888p+1, erf(x) rounds to ±1
  if ux > 0x407AD444_u32
    var os = 1.0_b32.copysign(sign: x)
    if ux > 0x7F800000_u32
      return B16(from: x +! x)
    if ux == 0x7F800000_u32
      return B16(from: os)
    return B16(from: os -! 0x1p-25_b32 *! os)
  var v = LLVM::floor[B64](16.0 *! z)
  var i = LLVM::float_to_unsigned[B32, U64](16.0_b32 *! ax)
  if ux < 0x3EE00000_u32
    # |x| < 0x1.cp-2: an odd polynomial in x
    var z2 = s *! s
    var z4 = z2 *! z2
    var z8 = z4 *! z4
    var c0 = 0x1.20dd750429b6dp+0 +! z2 *! -0x1.812746b0375fbp-2
    var c2 = 0x1.ce2f219fd6f45p-4 +! z2 *! -0x1.b82ce2cbf0838p-6
    var c4 = 0x1.565bb655adb85p-8 +! z2 *! -0x1.c025bfc879c94p-11
    var c6 = 0x1.f81718f61309cp-14 +! z2 *! -0x1.cc67bd88f5867p-17
    c0 = c0 +! z4 *! c2
    c4 = c4 +! z4 *! c6
    c0 = c0 +! z8 *! c4
    return B16(from: s *! c0)
  # |x| in [i/16, (i+1)/16): a degree-7 polynomial around i/16 + 1/32
  z = (z -! 0.03125) -! 0.0625 *! v
  var row = (i - 7) * 8
  var zz2 = z *! z
  var zz4 = zz2 *! zz2
  var d0 = b16_erf_c(k: row) +! z *! b16_erf_c(k: row + 1)
  var d2 = b16_erf_c(k: row + 2) +! z *! b16_erf_c(k: row + 3)
  var d4 = b16_erf_c(k: row + 4) +! z *! b16_erf_c(k: row + 5)
  var d6 = b16_erf_c(k: row + 6) +! z *! b16_erf_c(k: row + 7)
  d0 = d0 +! zz2 *! d2
  d4 = d4 +! zz2 *! d6
  d0 = d0 +! zz4 *! d4
  return B16(from: d0.copysign(sign: s))

### Entry `k` of the flattened erf coefficient table.
### :param k: The flat index.
### :returns: The binary64 coefficient.
secret routine b16_erf_c(k: U64) -> B64
  return B64.from_bits(bits: B16_ERF_C[k])

# Row i-7 (8 binary64 coefficients, bit patterns): a degree-7 polynomial approximating erf(i/16 + 1/32 + z) for -1/32 <= z <= 1/32, for 7 <= i < 63.
