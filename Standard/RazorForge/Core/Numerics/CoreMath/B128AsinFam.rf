module Core

# ============================================================================
# Shared arithmetic and tables of the correctly rounded arc sine and arc cosine of B128
# ============================================================================
# Ported from CORE-MATH, src/binary128/asin/asinq.c and src/binary128/acos/acosq.c
# (https://core-math.gitlabpages.inria.fr/). The two C files carry identical copies of these helpers and
# tables, so they are kept once here and used by CoreMath/B128Asin.rf and CoreMath/B128Acos.rf.
# Copyright (c) 2026 Alexei Sibidanov <sibid@uvic.ca>
# Distributed under the MIT license: see LICENSE-CORE-MATH next to this file. RazorForge has no dynamic
# rounding modes, so only the round-to-nearest path of the original is kept (its rounding-mode probe,
# exception-flag and errno handling and directed-rounding branches are dropped).
# Everything works on integers (64-bit words, carry chains and 64x64->128-bit products), never on the
# B128 arithmetic operators. Multi-word values are held least significant word first.

### Five 64-bit words of a fixed-point value, least significant first (the C u5x64).
secret record B128AsinFamW5
  w0: U64
  w1: U64
  w2: U64
  w3: U64
  w4: U64

### Six 64-bit words of a fixed-point value, least significant first (the C u6x64).
secret record B128AsinFamW6
  w0: U64
  w1: U64
  w2: U64
  w3: U64
  w4: U64
  w5: U64

# ============================================================================
# Word helpers
# ============================================================================

### The full 128-bit product of two 64-bit words.
@inline
secret routine b128_asinfam_mul(a: U64, b: U64) -> U128
  return LLVM::zero_extend[U64, U128](a) *% LLVM::zero_extend[U64, U128](b)

### The high 64 bits of a 128-bit value.
@inline
secret routine b128_asinfam_hi(u: U128) -> U64
  return LLVM::int_truncate[U128, U64](u >>> 64)

### The low 64 bits of a 128-bit value.
@inline
secret routine b128_asinfam_lo(u: U128) -> U64
  return LLVM::int_truncate[U128, U64](u)

### Joins two 64-bit words into a 128-bit value.
@inline
secret routine b128_asinfam_join(hi: U64, lo: U64) -> U128
  return (LLVM::zero_extend[U64, U128](hi) << 64) | LLVM::zero_extend[U64, U128](lo)

### The high 64 bits of the unsigned product a*b.
@inline
secret routine b128_asinfam_mhuu(a: U64, b: U64) -> U64
  return b128_asinfam_hi(u: b128_asinfam_mul(a: a, b: b))

### The high 64 bits of the signed product a*b, both words read as two's complement.
@inline
secret routine b128_asinfam_mhii(a: U64, b: U64) -> U64
  var p = b128_asinfam_mhuu(a: a, b: b)
  if (a >>> 63) != 0_u64
    p = p -% b
  if (b >>> 63) != 0_u64
    p = p -% a
  return p

### Adds two words and a carry: returns (sum, carry out).
@inline
secret routine b128_asinfam_ac(a: U64, b: U64, c: U64) -> (U64, U64)
  var s = LLVM::zero_extend[U64, U128](a) +% LLVM::zero_extend[U64, U128](b) +% LLVM::zero_extend[U64, U128](c)
  return (LLVM::int_truncate[U128, U64](s), LLVM::int_truncate[U128, U64](s >>> 64))

### Subtracts a word and a borrow: returns (difference, borrow out).
@inline
secret routine b128_asinfam_sc(a: U64, b: U64, c: U64) -> (U64, U64)
  var s = LLVM::zero_extend[U64, U128](a) -% LLVM::zero_extend[U64, U128](b) -% LLVM::zero_extend[U64, U128](c)
  return (LLVM::int_truncate[U128, U64](s), LLVM::int_truncate[U128, U64](s >>> 64) & 1_u64)

### A 64-bit shift amount taken modulo 64, as the hardware does.
@inline
secret routine b128_asinfam_sh(n: S64) -> U32
  return LLVM::int_truncate[S64, U32](n & 63)

### A 128-bit shift amount taken modulo 128.
@inline
secret routine b128_asinfam_sh7(n: S64) -> U32
  return LLVM::int_truncate[S64, U32](n & 127)

### Reads a word as a signed integer.
@inline
secret routine b128_asinfam_s(u: U64) -> S64
  return LLVM::reinterpret_bits[U64, S64](u)

### Reads a signed integer as a word.
@inline
secret routine b128_asinfam_u(n: S64) -> U64
  return LLVM::reinterpret_bits[S64, U64](n)

### Count of leading zero bits of a word.
@inline
secret routine b128_asinfam_clz(x: U64) -> S64
  return LLVM::reinterpret_bits[U64, S64](x.leading_zeros())

# ============================================================================
# 128-bit helpers of the fast path
# ============================================================================

### Approximate high 128 bits of the unsigned 128x128-bit product (the C mhUU).
@inline
secret routine b128_asinfam_mhuu128(a: U128, b: U128) -> U128
  var a0 = b128_asinfam_lo(u: a)
  var a1 = b128_asinfam_hi(u: a)
  var b0 = b128_asinfam_lo(u: b)
  var b1 = b128_asinfam_hi(u: b)
  var a1b0 = b128_asinfam_mul(a: a1, b: b0)
  var a0b1 = b128_asinfam_mul(a: a0, b: b1)
  var a1b1 = b128_asinfam_mul(a: a1, b: b1)
  a1b1 = a1b1 +% (a1b0 >>> 64)
  a1b1 = a1b1 +% (a0b1 >>> 64)
  return a1b1

### Approximate high 128 bits of the square of a 128-bit value (the C sqrhU).
@inline
secret routine b128_asinfam_sqrhu128(a: U128) -> U128
  var a0 = b128_asinfam_lo(u: a)
  var a1 = b128_asinfam_hi(u: a)
  var a10 = b128_asinfam_mul(a: a1, b: a0) >>> 63
  return b128_asinfam_mul(a: a1, b: a1) +% a10

### High three words of the product of a word and a three-word value (the C mhu3uu3).
@inline
secret routine b128_asinfam_mh3w(y: U64, x0: U64, x1: U64, x2: U64) -> (U64, U64, U64)
  var xy0 = b128_asinfam_mul(a: x0, b: y)
  var xy1 = b128_asinfam_mul(a: x1, b: y)
  var xy2 = b128_asinfam_mul(a: x2, b: y)
  var r0 = b128_asinfam_ac(a: b128_asinfam_lo(u: xy1), b: b128_asinfam_hi(u: xy0), c: 0_u64)
  var r1 = b128_asinfam_ac(a: b128_asinfam_lo(u: xy2), b: b128_asinfam_hi(u: xy1), c: r0.item1)
  var r2 = b128_asinfam_ac(a: 0_u64, b: b128_asinfam_hi(u: xy2), c: r1.item1)
  return (r0.item0, r1.item0, r2.item0)

### High three words of the product of a two-word and a three-word value (the C mhu3u2u3).
@inline
secret routine b128_asinfam_mh3d(y0: U64, y1: U64, x0: U64, x1: U64, x2: U64) -> (U64, U64, U64)
  var x1y0 = b128_asinfam_mul(a: x1, b: y0)
  var x2y0 = b128_asinfam_mul(a: x2, b: y0)
  var x0y1 = b128_asinfam_mul(a: x0, b: y1)
  var x1y1 = b128_asinfam_mul(a: x1, b: y1)
  var x2y1 = b128_asinfam_mul(a: x2, b: y1)
  x2y0 = x2y0 +% (x1y0 >>> 64)
  x1y1 = x1y1 +% (x0y1 >>> 64)
  x2y1 = x2y1 +% (x1y1 >>> 64)
  var r0 = b128_asinfam_ac(a: b128_asinfam_lo(u: x1y1), b: b128_asinfam_lo(u: x2y0), c: 0_u64)
  var r1 = b128_asinfam_ac(a: b128_asinfam_lo(u: x2y1), b: b128_asinfam_hi(u: x2y0), c: r0.item1)
  var r2 = b128_asinfam_ac(a: 0_u64, b: b128_asinfam_hi(u: x2y1), c: r1.item1)
  return (r0.item0, r1.item0, r2.item0)

### Three-word sum a + b (the C addu3u3u3).
@inline
secret routine b128_asinfam_add3(a0: U64, a1: U64, a2: U64, b0: U64, b1: U64, b2: U64) -> (U64, U64, U64)
  var r0 = b128_asinfam_ac(a: a0, b: b0, c: 0_u64)
  var r1 = b128_asinfam_ac(a: a1, b: b1, c: r0.item1)
  var r2 = b128_asinfam_ac(a: a2, b: b2, c: r1.item1)
  return (r0.item0, r1.item0, r2.item0)

### Three-word difference a - b (the C subu3u3u3).
@inline
secret routine b128_asinfam_sub3(a0: U64, a1: U64, a2: U64, b0: U64, b1: U64, b2: U64) -> (U64, U64, U64)
  var r0 = b128_asinfam_sc(a: a0, b: b0, c: 0_u64)
  var r1 = b128_asinfam_sc(a: a1, b: b1, c: r0.item1)
  var r2 = b128_asinfam_sc(a: a2, b: b2, c: r1.item1)
  return (r0.item0, r1.item0, r2.item0)

# ============================================================================
# Range reduction and 1/sqrt
# ============================================================================

### Reciprocal square root of a 64-bit fixed-point m in [1, 2), to almost 64 bits (the C rsqrt9).
@inline
secret routine b128_asinfam_rsqrt9(m: U64) -> U64
  var ix = (m >>> 58) << 2
  var c0 = B128_ASINFAM_RSQRT[ix]
  var c1 = B128_ASINFAM_RSQRT[ix +% 1_u64]
  var c2 = B128_ASINFAM_RSQRT[ix +% 2_u64]
  var c3 = B128_ASINFAM_RSQRT[ix +% 3_u64]
  c0 = (c0 << 31) | 0x8000000000000000_u64
  c1 = c1 << 25
  var d = (m << 6) >>> 32
  var d2 = (d *% d) >>> 32
  var re = c0 +% ((d2 *% c2) >>> 13)
  var ro = (d *% ((c1 +% ((d2 *% c3) >>> 19)) >>> 26)) >>> 6
  var r = re -% ro
  # one Newton-Raphson step r1 = r0 - r0*(r0^2*x - 1)/2
  var r2 = b128_asinfam_mhuu(a: r, b: r)
  var h = b128_asinfam_mhuu(a: m, b: r2) +% r2
  var hr = b128_asinfam_mhii(a: h, b: r >>> 1)
  r = r -% hr
  if r == 0_u64
    r = r -% 1_u64
  return r

### Picks the table index j of the range reduction from the high word of 0 < |x| < 1 (the C jget).
@inline
secret routine b128_asinfam_jget(x: U64) -> U64
  var z = 0x3FFF000000000000_u64 -% x
  var mz = z << 16
  var e = b128_asinfam_s(u: z >>> 48)
  if e == 0
    var nz = b128_asinfam_clz(x: mz)
    mz = mz << b128_asinfam_sh(n: nz +% 1)
    e = e -% nz
  var lz = e *% 16 +% b128_asinfam_s(u: mz >>> 60) +% 161
  if lz < 0
    lz = 0
  var j = 0_u64
  if lz < 256
    j = B128_ASINFAM_IND[b128_asinfam_u(n: lz)]
  var tz = e *% 2048 +% b128_asinfam_s(u: mz >>> 53)
  if tz < B128_ASINFAM_STH[j]
    j = j +% 1_u64
  return j

### The full 256-bit square of a two-word value (the C sqrU).
@inline
secret routine b128_asinfam_sqru(x0: U64, x1: U64) -> (U64, U64, U64, U64)
  var p10 = b128_asinfam_mul(a: x1, b: x0)
  var p10x = b128_asinfam_hi(u: p10) >>> 63
  p10 = p10 << 1
  var p00 = b128_asinfam_mul(a: x0, b: x0)
  var p11 = b128_asinfam_mul(a: x1, b: x1)
  var r1 = b128_asinfam_ac(a: b128_asinfam_hi(u: p00), b: b128_asinfam_lo(u: p10), c: 0_u64)
  var r2 = b128_asinfam_ac(a: b128_asinfam_hi(u: p10), b: b128_asinfam_lo(u: p11), c: r1.item1)
  var r3 = b128_asinfam_ac(a: b128_asinfam_hi(u: p11), b: p10x, c: r2.item1)
  return (b128_asinfam_lo(u: p00), r1.item0, r2.item0, r3.item0)

### Normalized 1 - x^2 for the two-word x scaled by 2^-s: returns the four words and the exponent e. `mode`
### picks the C variant: 0 = asinq's omx2v2 (one's complement), 1 = acosq's omx2v2 (one's complement, plus
### one when the top word vanishes), 2 = omx2v3 (exact two's complement).
@inline
secret routine b128_asinfam_omx2(s: S64, x0: U64, x1: U64, mode: U64) -> (U64, U64, U64, U64, S64)
  var q = b128_asinfam_sqru(x0: x0, x1: x1)
  var ls = b128_asinfam_sh(n: s ^ -1)
  var rs = b128_asinfam_sh(n: s)
  var y0 = ((q.item1 << 1) << ls) | (q.item0 >>> rs)
  var y1 = ((q.item2 << 1) << ls) | (q.item1 >>> rs)
  var y2 = ((q.item3 << 1) << ls) | (q.item2 >>> rs)
  var y3 = q.item3 >>> rs
  if mode == 2_u64
    var n0 = b128_asinfam_sc(a: 0_u64, b: y0, c: 0_u64)
    var n1 = b128_asinfam_sc(a: 0_u64, b: y1, c: n0.item1)
    var n2 = b128_asinfam_sc(a: 0_u64, b: y2, c: n1.item1)
    var n3 = b128_asinfam_sc(a: 0_u64, b: y3, c: n2.item1)
    y0 = n0.item0
    y1 = n1.item0
    y2 = n2.item0
    y3 = n3.item0
  else
    y0 = y0 ^ 0xFFFFFFFFFFFFFFFF_u64
    y1 = y1 ^ 0xFFFFFFFFFFFFFFFF_u64
    y2 = y2 ^ 0xFFFFFFFFFFFFFFFF_u64
    y3 = y3 ^ 0xFFFFFFFFFFFFFFFF_u64
  var e = 1_s64
  if y3 != 0_u64
    var lk = b128_asinfam_clz(x: y3)
    var l = b128_asinfam_sh(n: lk)
    var r = b128_asinfam_sh(n: lk ^ -1)
    y3 = (y3 << l) | ((y2 >>> 1) >>> r)
    y2 = (y2 << l) | ((y1 >>> 1) >>> r)
    y1 = (y1 << l) | ((y0 >>> 1) >>> r)
    y0 = y0 << l
    e = e +% lk
  else
    if mode == 1_u64
      var i0 = b128_asinfam_ac(a: y0, b: 1_u64, c: 0_u64)
      var i1 = b128_asinfam_ac(a: y1, b: 0_u64, c: i0.item1)
      var i2 = b128_asinfam_ac(a: y2, b: 0_u64, c: i1.item1)
      y0 = i0.item0
      y1 = i1.item0
      y2 = i2.item0
    var lk = b128_asinfam_clz(x: y2)
    var l = b128_asinfam_sh(n: lk)
    var r = b128_asinfam_sh(n: lk ^ -1)
    y3 = (y2 << l) | ((y1 >>> 1) >>> r)
    y2 = (y1 << l) | ((y0 >>> 1) >>> r)
    y1 = y0 << l
    y0 = 0_u64
    e = e +% lk +% 64
  return (y0, y1, y2, y3, e)

### 2^64/sqrt(2)^(e&1), the scale that folds an odd exponent into the reciprocal square root.
@inline
secret routine b128_asinfam_rsqrt2(e: S64) -> U64
  if (e & 1) == 0
    return 0xFFFFFFFFFFFFFFFF_u64
  return 0xB504F333F9DE6484_u64

### The fast path's sqrt(1 - x^2) for the mantissa words x (shifted left by 15) and nz = 0x3fff - exponent:
### returns its three words and the exponent e of 1 - x^2. `mode` is passed on to `b128_asinfam_omx2`.
@inline
secret routine b128_asinfam_fast_sqrt(x0: U64, x1: U64, nz: S64, mode: U64) -> (U64, U64, U64, S64)
  var q = b128_asinfam_omx2(s: 2 *% nz -% 2, x0: x0, x1: x1, mode: mode)
  var e = q.item4
  var rx = (q.item3 << 1) | (q.item2 >>> 63)
  var r = b128_asinfam_rsqrt9(m: rx)
  r = b128_asinfam_mhuu(a: r, b: b128_asinfam_rsqrt2(e: e))
  var sx = b128_asinfam_mh3w(y: r, x0: q.item1, x1: q.item2, x2: q.item3)
  var hq = b128_asinfam_mh3w(y: r, x0: sx.item0, x1: sx.item1, x2: sx.item2)
  var h0 = (hq.item0 >>> 2) | (hq.item1 << 62)
  var h1 = (hq.item1 >>> 2) | (hq.item2 << 62)
  var h2 = b128_asinfam_mhii(a: h1, b: h1)
  h2 = h2 +% (h2 >>> 1)
  var hh = b128_asinfam_join(hi: h1, lo: h0)
  var lk = (e & 1) +% 2
  var rk = (64 -% lk) & 63
  var l = b128_asinfam_sh(n: lk)
  var rr = b128_asinfam_sh(n: rk)
  hh = hh -% b128_asinfam_join(hi: h2 >>> rr, lo: h2 << l)
  # D = high part of the (unsigned SX) x (signed hh) product
  var sa = b128_asinfam_join(hi: sx.item2, lo: sx.item1)
  var d = b128_asinfam_mhuu128(a: sa, b: hh)
  if (hh >>> 127) != 0_u128
    d = d -% sa
  var d0 = b128_asinfam_lo(u: d)
  var d1 = b128_asinfam_hi(u: d)
  var d2 = 0_u64
  if (d1 >>> 63) != 0_u64
    d2 = 0xFFFFFFFFFFFFFFFF_u64
  d2 = (d2 << l) | (d1 >>> rr)
  d1 = (d1 << l) | (d0 >>> rr)
  d0 = d0 << l
  var o = b128_asinfam_sub3(a0: sx.item0, a1: sx.item1, a2: sx.item2, b0: d0, b1: d1, b2: d2)
  return (o.item0, o.item1, o.item2, e)

### The fast path's odd polynomial t + t^3*P(t^2) part: returns t^3*P(t^2) for the normalized t and the
### shift s2 that aligns t^2.
@inline
secret routine b128_asinfam_fast_poly(t: U128, s2: S64) -> U128
  var t2 = b128_asinfam_sqrhu128(a: t)
  var t3 = b128_asinfam_mhuu128(a: t, b: t2)
  if s2 < 128
    t2 = t2 >>> b128_asinfam_sh7(n: s2)
  else
    t2 = 0_u128
  var t2h = b128_asinfam_hi(u: t2)
  var fl = B128_ASINFAM_C[18]
  fl = B128_ASINFAM_C[16] +% b128_asinfam_mhuu(a: t2h, b: fl)
  fl = B128_ASINFAM_C[14] +% b128_asinfam_mhuu(a: t2h, b: fl)
  fl = B128_ASINFAM_C[12] +% b128_asinfam_mhuu(a: t2h, b: fl)
  var f = b128_asinfam_join(hi: B128_ASINFAM_C[11], lo: B128_ASINFAM_C[10] +% b128_asinfam_mhuu(a: t2h, b: fl))
  var i = 10_u64
  while i > 0_u64
    i = i -% 2_u64
    f = b128_asinfam_join(hi: B128_ASINFAM_C[i +% 1_u64], lo: B128_ASINFAM_C[i]) +% b128_asinfam_mhuu128(a: t2, b: f)
  return b128_asinfam_mhuu128(a: t3, b: f)

# ============================================================================
# Five-word arithmetic of the accurate path
# ============================================================================

### Word i of a five-word value, 0 outside 0..4.
secret routine b128_asinfam_w5at(a: B128AsinFamW5, i: S64) -> U64
  if i == 0
    return a.w0
  if i == 1
    return a.w1
  if i == 2
    return a.w2
  if i == 3
    return a.w3
  if i == 4
    return a.w4
  return 0_u64

### Word i of a six-word value, 0 outside 0..5.
secret routine b128_asinfam_w6at(a: B128AsinFamW6, i: S64) -> U64
  if i == 0
    return a.w0
  if i == 1
    return a.w1
  if i == 2
    return a.w2
  if i == 3
    return a.w3
  if i == 4
    return a.w4
  if i == 5
    return a.w5
  return 0_u64

### Word i of a five-word value shifted right by k >= 0 bits.
secret routine b128_asinfam_w5r(a: B128AsinFamW5, i: S64, off: S64, s: S64) -> U64
  var lo = b128_asinfam_w5at(a: a, i: i +% off)
  if s == 0
    return lo
  return (lo >>> b128_asinfam_sh(n: s)) | (b128_asinfam_w5at(a: a, i: i +% off +% 1) << b128_asinfam_sh(n: 64 -% s))

### Word i of a six-word value shifted right by k >= 0 bits.
secret routine b128_asinfam_w6r(a: B128AsinFamW6, i: S64, off: S64, s: S64) -> U64
  var lo = b128_asinfam_w6at(a: a, i: i +% off)
  if s == 0
    return lo
  return (lo >>> b128_asinfam_sh(n: s)) | (b128_asinfam_w6at(a: a, i: i +% off +% 1) << b128_asinfam_sh(n: 64 -% s))

### Word i of a five-word value shifted left by k >= 0 bits.
secret routine b128_asinfam_w5l(a: B128AsinFamW5, i: S64, off: S64, s: S64) -> U64
  var hi = b128_asinfam_w5at(a: a, i: i -% off) << b128_asinfam_sh(n: s)
  return hi | ((b128_asinfam_w5at(a: a, i: i -% off -% 1) >>> 1) >>> b128_asinfam_sh(n: 63 -% s))

### A five-word value shifted right by k bits (left for k < 0), the C shrn(5, a, k).
secret routine b128_asinfam_shrn5(a: B128AsinFamW5, k: S64) -> B128AsinFamW5
  if k < 0
    return b128_asinfam_shln5(a: a, k: 0 -% k)
  var off = k >> 6
  var s = k & 63
  return B128AsinFamW5(w0: b128_asinfam_w5r(a: a, i: 0, off: off, s: s), w1: b128_asinfam_w5r(a: a, i: 1, off: off, s: s), w2: b128_asinfam_w5r(a: a, i: 2, off: off, s: s), w3: b128_asinfam_w5r(a: a, i: 3, off: off, s: s), w4: b128_asinfam_w5r(a: a, i: 4, off: off, s: s))

### A five-word value shifted left by k bits (right for k < 0), the C shln(5, a, k).
secret routine b128_asinfam_shln5(a: B128AsinFamW5, k: S64) -> B128AsinFamW5
  if k < 0
    return b128_asinfam_shrn5(a: a, k: 0 -% k)
  var off = k >> 6
  var s = k & 63
  return B128AsinFamW5(w0: b128_asinfam_w5l(a: a, i: 0, off: off, s: s), w1: b128_asinfam_w5l(a: a, i: 1, off: off, s: s), w2: b128_asinfam_w5l(a: a, i: 2, off: off, s: s), w3: b128_asinfam_w5l(a: a, i: 3, off: off, s: s), w4: b128_asinfam_w5l(a: a, i: 4, off: off, s: s))

### A six-word value shifted right by k >= 0 bits, the C shrn(6, a, k).
secret routine b128_asinfam_shrn6(a: B128AsinFamW6, k: S64) -> B128AsinFamW6
  var off = k >> 6
  var s = k & 63
  return B128AsinFamW6(w0: b128_asinfam_w6r(a: a, i: 0, off: off, s: s), w1: b128_asinfam_w6r(a: a, i: 1, off: off, s: s), w2: b128_asinfam_w6r(a: a, i: 2, off: off, s: s), w3: b128_asinfam_w6r(a: a, i: 3, off: off, s: s), w4: b128_asinfam_w6r(a: a, i: 4, off: off, s: s), w5: b128_asinfam_w6r(a: a, i: 5, off: off, s: s))

### Five-word sum a + b (the C addu5u5u5).
secret routine b128_asinfam_add5(a: B128AsinFamW5, b: B128AsinFamW5) -> B128AsinFamW5
  var r0 = b128_asinfam_ac(a: a.w0, b: b.w0, c: 0_u64)
  var r1 = b128_asinfam_ac(a: a.w1, b: b.w1, c: r0.item1)
  var r2 = b128_asinfam_ac(a: a.w2, b: b.w2, c: r1.item1)
  var r3 = b128_asinfam_ac(a: a.w3, b: b.w3, c: r2.item1)
  var r4 = b128_asinfam_ac(a: a.w4, b: b.w4, c: r3.item1)
  return B128AsinFamW5(w0: r0.item0, w1: r1.item0, w2: r2.item0, w3: r3.item0, w4: r4.item0)

### Five-word difference a - b (the C subu5u5u5).
secret routine b128_asinfam_sub5(a: B128AsinFamW5, b: B128AsinFamW5) -> B128AsinFamW5
  var r0 = b128_asinfam_sc(a: a.w0, b: b.w0, c: 0_u64)
  var r1 = b128_asinfam_sc(a: a.w1, b: b.w1, c: r0.item1)
  var r2 = b128_asinfam_sc(a: a.w2, b: b.w2, c: r1.item1)
  var r3 = b128_asinfam_sc(a: a.w3, b: b.w3, c: r2.item1)
  var r4 = b128_asinfam_sc(a: a.w4, b: b.w4, c: r3.item1)
  return B128AsinFamW5(w0: r0.item0, w1: r1.item0, w2: r2.item0, w3: r3.item0, w4: r4.item0)

### Row j of B128_ASINFAM_CTH, sqrt(1 - s_j^2), as five words.
secret routine b128_asinfam_cth(j: U64) -> B128AsinFamW5
  var i = j *% 5_u64
  return B128AsinFamW5(w0: B128_ASINFAM_CTH[i], w1: B128_ASINFAM_CTH[i +% 1_u64], w2: B128_ASINFAM_CTH[i +% 2_u64], w3: B128_ASINFAM_CTH[i +% 3_u64], w4: B128_ASINFAM_CTH[i +% 4_u64])

### Approximate high five words of the five-word product a*b (the C mhu5u5u5(o, b, a)).
secret routine b128_asinfam_mh5(b: B128AsinFamW5, a: B128AsinFamW5) -> B128AsinFamW5
  var a4b0 = b128_asinfam_mul(a: a.w4, b: b.w0)
  var o0 = b128_asinfam_hi(u: a4b0)
  var a3b1 = b128_asinfam_mul(a: a.w3, b: b.w1)
  var a4b1 = b128_asinfam_mul(a: a.w4, b: b.w1)
  var r = b128_asinfam_ac(a: b128_asinfam_lo(u: a4b1), b: b128_asinfam_hi(u: a3b1), c: 0_u64)
  var t = r.item0
  var c0 = r.item1
  r = b128_asinfam_ac(a: o0, b: t, c: 0_u64)
  o0 = r.item0
  var c1 = r.item1
  r = b128_asinfam_ac(a: b128_asinfam_hi(u: a4b1), b: 0_u64, c: c0)
  var o1 = r.item0
  c0 = r.item1
  r = b128_asinfam_ac(a: o1, b: 0_u64, c: c1)
  o1 = r.item0
  c1 = r.item1

  var a2b2 = b128_asinfam_mul(a: a.w2, b: b.w2)
  var a3b2 = b128_asinfam_mul(a: a.w3, b: b.w2)
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a3b2), b: b128_asinfam_hi(u: a2b2), c: 0_u64)
  t = r.item0
  c0 = r.item1
  r = b128_asinfam_ac(a: o0, b: t, c: 0_u64)
  o0 = r.item0
  c1 = r.item1
  var a4b2 = b128_asinfam_mul(a: a.w4, b: b.w2)
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a4b2), b: b128_asinfam_hi(u: a3b2), c: c0)
  t = r.item0
  c0 = r.item1
  r = b128_asinfam_ac(a: o1, b: t, c: c1)
  o1 = r.item0
  c1 = r.item1
  r = b128_asinfam_ac(a: b128_asinfam_hi(u: a4b2), b: 0_u64, c: c0)
  var o2 = r.item0
  c0 = r.item1
  r = b128_asinfam_ac(a: o2, b: 0_u64, c: c1)
  o2 = r.item0
  c1 = r.item1

  var a1b3 = b128_asinfam_mul(a: a.w1, b: b.w3)
  var a2b3 = b128_asinfam_mul(a: a.w2, b: b.w3)
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a2b3), b: b128_asinfam_hi(u: a1b3), c: 0_u64)
  t = r.item0
  c0 = r.item1
  r = b128_asinfam_ac(a: o0, b: t, c: 0_u64)
  o0 = r.item0
  c1 = r.item1
  var a3b3 = b128_asinfam_mul(a: a.w3, b: b.w3)
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a3b3), b: b128_asinfam_hi(u: a2b3), c: c0)
  t = r.item0
  c0 = r.item1
  r = b128_asinfam_ac(a: o1, b: t, c: c1)
  o1 = r.item0
  c1 = r.item1
  var a4b3 = b128_asinfam_mul(a: a.w4, b: b.w3)
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a4b3), b: b128_asinfam_hi(u: a3b3), c: c0)
  t = r.item0
  c0 = r.item1
  r = b128_asinfam_ac(a: o2, b: t, c: c1)
  o2 = r.item0
  c1 = r.item1
  r = b128_asinfam_ac(a: b128_asinfam_hi(u: a4b3), b: 0_u64, c: c0)
  var o3 = r.item0
  c0 = r.item1
  r = b128_asinfam_ac(a: o3, b: 0_u64, c: c1)
  o3 = r.item0
  c1 = r.item1

  var a0b4 = b128_asinfam_mul(a: a.w0, b: b.w4)
  var a1b4 = b128_asinfam_mul(a: a.w1, b: b.w4)
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a1b4), b: b128_asinfam_hi(u: a0b4), c: 0_u64)
  t = r.item0
  c0 = r.item1
  r = b128_asinfam_ac(a: o0, b: t, c: 0_u64)
  o0 = r.item0
  c1 = r.item1
  var a2b4 = b128_asinfam_mul(a: a.w2, b: b.w4)
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a2b4), b: b128_asinfam_hi(u: a1b4), c: c0)
  t = r.item0
  c0 = r.item1
  r = b128_asinfam_ac(a: o1, b: t, c: c1)
  o1 = r.item0
  c1 = r.item1
  var a3b4 = b128_asinfam_mul(a: a.w3, b: b.w4)
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a3b4), b: b128_asinfam_hi(u: a2b4), c: c0)
  t = r.item0
  c0 = r.item1
  r = b128_asinfam_ac(a: o2, b: t, c: c1)
  o2 = r.item0
  c1 = r.item1
  var a4b4 = b128_asinfam_mul(a: a.w4, b: b.w4)
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a4b4), b: b128_asinfam_hi(u: a3b4), c: c0)
  t = r.item0
  c0 = r.item1
  r = b128_asinfam_ac(a: o3, b: t, c: c1)
  o3 = r.item0
  c1 = r.item1
  r = b128_asinfam_ac(a: b128_asinfam_hi(u: a4b4), b: 0_u64, c: c0)
  var o4 = r.item0
  c0 = r.item1
  r = b128_asinfam_ac(a: o4, b: 0_u64, c: c1)
  o4 = r.item0
  return B128AsinFamW5(w0: o0, w1: o1, w2: o2, w3: o3, w4: o4)

### High five words of the product of a two-word b and a five-word a (the C mhu5u2u5).
secret routine b128_asinfam_mh5d(b0: U64, b1: U64, a: B128AsinFamW5) -> B128AsinFamW5
  var a1b0 = b128_asinfam_mul(a: a.w1, b: b0)
  var a2b0 = b128_asinfam_mul(a: a.w2, b: b0)
  var a3b0 = b128_asinfam_mul(a: a.w3, b: b0)
  var a4b0 = b128_asinfam_mul(a: a.w4, b: b0)
  var r = b128_asinfam_ac(a: b128_asinfam_lo(u: a2b0), b: b128_asinfam_hi(u: a1b0), c: 0_u64)
  var o0 = r.item0
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a3b0), b: b128_asinfam_hi(u: a2b0), c: r.item1)
  var o1 = r.item0
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a4b0), b: b128_asinfam_hi(u: a3b0), c: r.item1)
  var o2 = r.item0
  r = b128_asinfam_ac(a: 0_u64, b: b128_asinfam_hi(u: a4b0), c: r.item1)
  var o3 = r.item0

  var a0b1 = b128_asinfam_mul(a: a.w0, b: b1)
  var a1b1 = b128_asinfam_mul(a: a.w1, b: b1)
  var a2b1 = b128_asinfam_mul(a: a.w2, b: b1)
  var a3b1 = b128_asinfam_mul(a: a.w3, b: b1)
  var a4b1 = b128_asinfam_mul(a: a.w4, b: b1)
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a1b1), b: b128_asinfam_hi(u: a0b1), c: 0_u64)
  var t = r.item0
  var c0 = r.item1
  r = b128_asinfam_ac(a: o0, b: t, c: 0_u64)
  o0 = r.item0
  var c1 = r.item1
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a2b1), b: b128_asinfam_hi(u: a1b1), c: c0)
  t = r.item0
  c0 = r.item1
  r = b128_asinfam_ac(a: o1, b: t, c: c1)
  o1 = r.item0
  c1 = r.item1
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a3b1), b: b128_asinfam_hi(u: a2b1), c: c0)
  t = r.item0
  c0 = r.item1
  r = b128_asinfam_ac(a: o2, b: t, c: c1)
  o2 = r.item0
  c1 = r.item1
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a4b1), b: b128_asinfam_hi(u: a3b1), c: c0)
  t = r.item0
  c0 = r.item1
  r = b128_asinfam_ac(a: o3, b: t, c: c1)
  o3 = r.item0
  c1 = r.item1
  r = b128_asinfam_ac(a: 0_u64, b: b128_asinfam_hi(u: a4b1), c: c0)
  t = r.item0
  r = b128_asinfam_ac(a: 0_u64, b: t, c: c1)
  return B128AsinFamW5(w0: o0, w1: o1, w2: o2, w3: o3, w4: r.item0)

### High five words of the product of a word b0 and a five-word a (the C mhu5u1u5).
secret routine b128_asinfam_mh5w(b0: U64, a: B128AsinFamW5) -> B128AsinFamW5
  var a0b0 = b128_asinfam_mul(a: a.w0, b: b0)
  var a1b0 = b128_asinfam_mul(a: a.w1, b: b0)
  var a2b0 = b128_asinfam_mul(a: a.w2, b: b0)
  var a3b0 = b128_asinfam_mul(a: a.w3, b: b0)
  var a4b0 = b128_asinfam_mul(a: a.w4, b: b0)
  var r0 = b128_asinfam_ac(a: b128_asinfam_lo(u: a1b0), b: b128_asinfam_hi(u: a0b0), c: 0_u64)
  var r1 = b128_asinfam_ac(a: b128_asinfam_lo(u: a2b0), b: b128_asinfam_hi(u: a1b0), c: r0.item1)
  var r2 = b128_asinfam_ac(a: b128_asinfam_lo(u: a3b0), b: b128_asinfam_hi(u: a2b0), c: r1.item1)
  var r3 = b128_asinfam_ac(a: b128_asinfam_lo(u: a4b0), b: b128_asinfam_hi(u: a3b0), c: r2.item1)
  var r4 = b128_asinfam_ac(a: 0_u64, b: b128_asinfam_hi(u: a4b0), c: r3.item1)
  return B128AsinFamW5(w0: r0.item0, w1: r1.item0, w2: r2.item0, w3: r3.item0, w4: r4.item0)

### The full product of a word b0 and a four-word a (the C mu5u1u4).
secret routine b128_asinfam_mu5(b0: U64, a0: U64, a1: U64, a2: U64, a3: U64) -> B128AsinFamW5
  var a0b0 = b128_asinfam_mul(a: a0, b: b0)
  var a1b0 = b128_asinfam_mul(a: a1, b: b0)
  var a2b0 = b128_asinfam_mul(a: a2, b: b0)
  var a3b0 = b128_asinfam_mul(a: a3, b: b0)
  var r1 = b128_asinfam_ac(a: b128_asinfam_lo(u: a1b0), b: b128_asinfam_hi(u: a0b0), c: 0_u64)
  var r2 = b128_asinfam_ac(a: b128_asinfam_lo(u: a2b0), b: b128_asinfam_hi(u: a1b0), c: r1.item1)
  var r3 = b128_asinfam_ac(a: b128_asinfam_lo(u: a3b0), b: b128_asinfam_hi(u: a2b0), c: r2.item1)
  var r4 = b128_asinfam_ac(a: 0_u64, b: b128_asinfam_hi(u: a3b0), c: r3.item1)
  return B128AsinFamW5(w0: b128_asinfam_lo(u: a0b0), w1: r1.item0, w2: r2.item0, w3: r3.item0, w4: r4.item0)

### The full product of a word b0 and a five-word a (the C mu6u1u5).
secret routine b128_asinfam_mu6(b0: U64, a: B128AsinFamW5) -> B128AsinFamW6
  var a0b0 = b128_asinfam_mul(a: a.w0, b: b0)
  var a1b0 = b128_asinfam_mul(a: a.w1, b: b0)
  var a2b0 = b128_asinfam_mul(a: a.w2, b: b0)
  var a3b0 = b128_asinfam_mul(a: a.w3, b: b0)
  var a4b0 = b128_asinfam_mul(a: a.w4, b: b0)
  var r1 = b128_asinfam_ac(a: b128_asinfam_lo(u: a1b0), b: b128_asinfam_hi(u: a0b0), c: 0_u64)
  var r2 = b128_asinfam_ac(a: b128_asinfam_lo(u: a2b0), b: b128_asinfam_hi(u: a1b0), c: r1.item1)
  var r3 = b128_asinfam_ac(a: b128_asinfam_lo(u: a3b0), b: b128_asinfam_hi(u: a2b0), c: r2.item1)
  var r4 = b128_asinfam_ac(a: b128_asinfam_lo(u: a4b0), b: b128_asinfam_hi(u: a3b0), c: r3.item1)
  var r5 = b128_asinfam_ac(a: 0_u64, b: b128_asinfam_hi(u: a4b0), c: r4.item1)
  return B128AsinFamW6(w0: b128_asinfam_lo(u: a0b0), w1: r1.item0, w2: r2.item0, w3: r3.item0, w4: r4.item0, w5: r5.item0)

### Approximate high five words of the square of a five-word value (the C sqrhu5).
secret routine b128_asinfam_sqrh5(a: B128AsinFamW5) -> B128AsinFamW5
  var a4a0 = b128_asinfam_mul(a: a.w4, b: a.w0)
  var a3a1 = b128_asinfam_mul(a: a.w3, b: a.w1)
  var r = b128_asinfam_ac(a: b128_asinfam_hi(u: a4a0), b: b128_asinfam_hi(u: a3a1), c: 0_u64)
  var o0 = r.item0
  var c0 = r.item1
  var o1 = c0
  var a4a1 = b128_asinfam_mul(a: a.w4, b: a.w1)
  var a3a2 = b128_asinfam_mul(a: a.w3, b: a.w2)
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a4a1), b: b128_asinfam_lo(u: a3a2), c: 0_u64)
  var t = r.item0
  var c1 = r.item1
  r = b128_asinfam_ac(a: o0, b: t, c: c0)
  o0 = r.item0
  c0 = r.item1
  r = b128_asinfam_ac(a: b128_asinfam_hi(u: a4a1), b: b128_asinfam_hi(u: a3a2), c: c1)
  t = r.item0
  c1 = r.item1
  r = b128_asinfam_ac(a: o1, b: t, c: c0)
  o1 = r.item0
  c0 = r.item1
  var a4a2 = b128_asinfam_mul(a: a.w4, b: a.w2)
  r = b128_asinfam_ac(a: o1, b: b128_asinfam_lo(u: a4a2), c: c0)
  o1 = r.item0
  c0 = r.item1
  var a4a3 = b128_asinfam_mul(a: a.w4, b: a.w3)
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a4a3), b: b128_asinfam_hi(u: a4a2), c: c1)
  t = r.item0
  c1 = r.item1
  r = b128_asinfam_ac(a: 0_u64, b: t, c: c0)
  var o2 = r.item0
  r = b128_asinfam_ac(a: 0_u64, b: b128_asinfam_hi(u: a4a3), c: c1)
  var o3 = r.item0

  r = b128_asinfam_ac(a: o0, b: o0, c: 0_u64)
  o0 = r.item0
  r = b128_asinfam_ac(a: o1, b: o1, c: r.item1)
  o1 = r.item0
  r = b128_asinfam_ac(a: o2, b: o2, c: r.item1)
  o2 = r.item0
  r = b128_asinfam_ac(a: o3, b: o3, c: r.item1)
  o3 = r.item0
  var o4 = r.item1

  var a2a2 = b128_asinfam_mul(a: a.w2, b: a.w2)
  var a3a3 = b128_asinfam_mul(a: a.w3, b: a.w3)
  var a4a4 = b128_asinfam_mul(a: a.w4, b: a.w4)
  var q0 = b128_asinfam_ac(a: o0, b: b128_asinfam_hi(u: a2a2), c: 0_u64)
  var q1 = b128_asinfam_ac(a: o1, b: b128_asinfam_lo(u: a3a3), c: q0.item1)
  var q2 = b128_asinfam_ac(a: o2, b: b128_asinfam_hi(u: a3a3), c: q1.item1)
  var q3 = b128_asinfam_ac(a: o3, b: b128_asinfam_lo(u: a4a4), c: q2.item1)
  var q4 = b128_asinfam_ac(a: o4, b: b128_asinfam_hi(u: a4a4), c: q3.item1)
  return B128AsinFamW5(w0: q0.item0, w1: q1.item0, w2: q2.item0, w3: q3.item0, w4: q4.item0)

### Approximate high four words of the square of a four-word value (the C sqrhu4).
secret routine b128_asinfam_sqrh4(a0: U64, a1: U64, a2: U64, a3: U64) -> (U64, U64, U64, U64)
  var a2a1 = b128_asinfam_mul(a: a2, b: a1)
  var a3a0 = b128_asinfam_mul(a: a3, b: a0)
  var a3a1 = b128_asinfam_mul(a: a3, b: a1)
  var a3a2 = b128_asinfam_mul(a: a3, b: a2)
  var r = b128_asinfam_ac(a: b128_asinfam_lo(u: a3a1), b: b128_asinfam_hi(u: a3a0), c: 0_u64)
  var o0 = r.item0
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a3a2), b: b128_asinfam_hi(u: a3a1), c: r.item1)
  var o1 = r.item0
  r = b128_asinfam_ac(a: 0_u64, b: b128_asinfam_hi(u: a3a2), c: r.item1)
  var o2 = r.item0

  r = b128_asinfam_ac(a: o0, b: b128_asinfam_hi(u: a2a1), c: 0_u64)
  o0 = r.item0
  r = b128_asinfam_ac(a: o1, b: 0_u64, c: r.item1)
  o1 = r.item0
  r = b128_asinfam_ac(a: o2, b: 0_u64, c: r.item1)
  o2 = r.item0

  r = b128_asinfam_ac(a: o0, b: o0, c: 0_u64)
  o0 = r.item0
  r = b128_asinfam_ac(a: o1, b: o1, c: r.item1)
  o1 = r.item0
  r = b128_asinfam_ac(a: o2, b: o2, c: r.item1)
  o2 = r.item0
  var o3 = r.item1

  var a2a2 = b128_asinfam_mul(a: a2, b: a2)
  var a3a3 = b128_asinfam_mul(a: a3, b: a3)
  var q0 = b128_asinfam_ac(a: o0, b: b128_asinfam_lo(u: a2a2), c: 0_u64)
  var q1 = b128_asinfam_ac(a: o1, b: b128_asinfam_hi(u: a2a2), c: q0.item1)
  var q2 = b128_asinfam_ac(a: o2, b: b128_asinfam_lo(u: a3a3), c: q1.item1)
  var q3 = b128_asinfam_ac(a: o3, b: b128_asinfam_hi(u: a3a3), c: q2.item1)
  return (q0.item0, q1.item0, q2.item0, q3.item0)

### Approximate high two words of the square of a two-word value (the C sqrhu2).
secret routine b128_asinfam_sqrh2(a0: U64, a1: U64) -> (U64, U64)
  var a1a0 = b128_asinfam_mul(a: a1, b: a0)
  var a1a1 = b128_asinfam_mul(a: a1, b: a1) +% (a1a0 >>> 63)
  return (b128_asinfam_lo(u: a1a1), b128_asinfam_hi(u: a1a1))

### Approximate high two words of the two-word product a*b (the C mhu2u2u2(o, b, a)).
secret routine b128_asinfam_mh2(b0: U64, b1: U64, a0: U64, a1: U64) -> (U64, U64)
  var a1b0 = b128_asinfam_mul(a: a1, b: b0)
  var o0 = b128_asinfam_hi(u: a1b0)
  var a0b1 = b128_asinfam_mul(a: a0, b: b1)
  var a1b1 = b128_asinfam_mul(a: a1, b: b1)
  var r = b128_asinfam_ac(a: b128_asinfam_lo(u: a1b1), b: b128_asinfam_hi(u: a0b1), c: 0_u64)
  var t = r.item0
  var c0 = r.item1
  r = b128_asinfam_ac(a: o0, b: t, c: 0_u64)
  o0 = r.item0
  var c1 = r.item1
  r = b128_asinfam_ac(a: b128_asinfam_hi(u: a1b1), b: 0_u64, c: c0)
  r = b128_asinfam_ac(a: r.item0, b: 0_u64, c: c1)
  return (o0, r.item0)

### Approximate high three words of the three-word product a*b (the C mhu3u3u3(o, b, a)).
secret routine b128_asinfam_mh3(b0: U64, b1: U64, b2: U64, a0: U64, a1: U64, a2: U64) -> (U64, U64, U64)
  var a1b1 = b128_asinfam_mul(a: a1, b: b1)
  var a2b0 = b128_asinfam_mul(a: a2, b: b0)
  var a0b2 = b128_asinfam_mul(a: a0, b: b2)
  var a2b1 = b128_asinfam_mul(a: a2, b: b1)
  var a1b2 = b128_asinfam_mul(a: a1, b: b2)
  var a2b2 = b128_asinfam_mul(a: a2, b: b2)
  a2b1 = a2b1 +% (a2b0 >>> 64)
  a1b2 = a1b2 +% (a0b2 >>> 64)
  var r = b128_asinfam_ac(a: b128_asinfam_hi(u: a1b1), b: b128_asinfam_lo(u: a2b1), c: 0_u64)
  var o0 = r.item0
  r = b128_asinfam_ac(a: b128_asinfam_lo(u: a2b2), b: b128_asinfam_hi(u: a2b1), c: r.item1)
  var o1 = r.item0
  r = b128_asinfam_ac(a: b128_asinfam_hi(u: a2b2), b: 0_u64, c: r.item1)
  var o2 = r.item0
  var q0 = b128_asinfam_ac(a: o0, b: b128_asinfam_lo(u: a1b2), c: 0_u64)
  var q1 = b128_asinfam_ac(a: o1, b: b128_asinfam_hi(u: a1b2), c: q0.item1)
  var q2 = b128_asinfam_ac(a: o2, b: 0_u64, c: q1.item1)
  return (q0.item0, q1.item0, q2.item0)

### Approximate high four words of the four-word product a*b (the C mhu4u4u4(o, b, a)).
secret routine b128_asinfam_mh4(b0: U64, b1: U64, b2: U64, b3: U64, a0: U64, a1: U64, a2: U64, a3: U64) -> (U64, U64, U64, U64)
  var a3b0 = b128_asinfam_mul(a: a3, b: b0)
  var a3b2 = b128_asinfam_mul(a: a3, b: b2)
  var a2b1 = b128_asinfam_mul(a: a2, b: b1)
  var a3b1 = b128_asinfam_mul(a: a3, b: b1)
  var a1b2 = b128_asinfam_mul(a: a1, b: b2)
  var a2b2 = b128_asinfam_mul(a: a2, b: b2)
  var a0b3 = b128_asinfam_mul(a: a0, b: b3)
  var a1b3 = b128_asinfam_mul(a: a1, b: b3)
  var a2b3 = b128_asinfam_mul(a: a2, b: b3)
  var a3b3 = b128_asinfam_mul(a: a3, b: b3)
  a3b1 = a3b1 +% (a2b1 >>> 64)
  a2b2 = a2b2 +% (a1b2 >>> 64)

  var r = b128_asinfam_ac(a: b128_asinfam_hi(u: a0b3), b: b128_asinfam_lo(u: a1b3), c: 0_u64)
  var o0 = r.item0
  r = b128_asinfam_ac(a: b128_asinfam_hi(u: a1b3), b: b128_asinfam_lo(u: a2b3), c: r.item1)
  var o1 = r.item0
  r = b128_asinfam_ac(a: b128_asinfam_hi(u: a2b3), b: b128_asinfam_lo(u: a3b3), c: r.item1)
  var o2 = r.item0
  r = b128_asinfam_ac(a: b128_asinfam_hi(u: a3b3), b: 0_u64, c: r.item1)
  var o3 = r.item0

  r = b128_asinfam_ac(a: o0, b: b128_asinfam_hi(u: a3b0), c: 0_u64)
  o0 = r.item0
  r = b128_asinfam_ac(a: o1, b: b128_asinfam_lo(u: a3b2), c: r.item1)
  o1 = r.item0
  r = b128_asinfam_ac(a: o2, b: b128_asinfam_hi(u: a3b2), c: r.item1)
  o2 = r.item0
  r = b128_asinfam_ac(a: o3, b: 0_u64, c: r.item1)
  o3 = r.item0

  r = b128_asinfam_ac(a: o0, b: b128_asinfam_lo(u: a3b1), c: 0_u64)
  o0 = r.item0
  r = b128_asinfam_ac(a: o1, b: b128_asinfam_hi(u: a3b1), c: r.item1)
  o1 = r.item0
  r = b128_asinfam_ac(a: o2, b: 0_u64, c: r.item1)
  o2 = r.item0
  r = b128_asinfam_ac(a: o3, b: 0_u64, c: r.item1)
  o3 = r.item0

  r = b128_asinfam_ac(a: o0, b: b128_asinfam_lo(u: a2b2), c: 0_u64)
  o0 = r.item0
  r = b128_asinfam_ac(a: o1, b: b128_asinfam_hi(u: a2b2), c: r.item1)
  o1 = r.item0
  r = b128_asinfam_ac(a: o2, b: 0_u64, c: r.item1)
  o2 = r.item0
  r = b128_asinfam_ac(a: o3, b: 0_u64, c: r.item1)
  o3 = r.item0
  return (o0, o1, o2, o3)

# ============================================================================
# Accurate path: sqrt(1 - x^2) and the polynomial
# ============================================================================

### sqrt(1 - x^2) to five words for the mantissa words x (shifted left by 15) and ex = 0x3fff - exponent:
### returns the five words and the exponent e of 1 - x^2 (the C getcos).
secret routine b128_asinfam_getcos(ex: S64, x0: U64, x1: U64) -> (B128AsinFamW5, S64)
  var q = b128_asinfam_omx2(s: 2 *% (ex -% 1), x0: x0, x1: x1, mode: 2_u64)
  var e = q.item4
  var eo = e & 1
  var rx = (q.item3 << 1) | (q.item2 >>> 63)
  var r = b128_asinfam_rsqrt9(m: rx)
  r = b128_asinfam_mhuu(a: r, b: b128_asinfam_rsqrt2(e: e))
  var sq = b128_asinfam_mu5(b0: r, a0: q.item0, a1: q.item1, a2: q.item2, a3: q.item3)
  var h6 = b128_asinfam_shrn6(a: b128_asinfam_mu6(b0: r, a: sq), k: 2)
  var msk = 0_u64
  if (h6.w4 >>> 63) != 0_u64
    msk = 0xFFFFFFFFFFFFFFFF_u64
  var h0 = h6.w0 ^ msk
  var h1 = h6.w1 ^ msk
  var h2 = h6.w2 ^ msk
  var h3 = h6.w3 ^ msk
  var h4 = h6.w4 ^ msk
  var s = b128_asinfam_sqrh4(a0: h1, a1: h2, a2: h3, a3: h4)
  var h4s = b128_asinfam_sqrh2(a0: s.item2, a1: s.item3)
  var v = b128_asinfam_mh3(b0: h2, b1: h3, b2: h4, a0: s.item1, a1: s.item2, a2: s.item3)
  # h2s *= 1.5 (the C mu4x3)
  var m0 = b128_asinfam_ac(a: s.item0, b: (s.item1 << 63) | (s.item0 >>> 1), c: 0_u64)
  var m1 = b128_asinfam_ac(a: s.item1, b: (s.item2 << 63) | (s.item1 >>> 1), c: m0.item1)
  var m2 = b128_asinfam_ac(a: s.item2, b: (s.item3 << 63) | (s.item2 >>> 1), c: m1.item1)
  var m3 = b128_asinfam_ac(a: s.item3, b: s.item3 >>> 1, c: m2.item1)
  # h3s *= 1.25 (the C mu3x5)
  var n0 = b128_asinfam_ac(a: v.item0, b: (v.item1 << 62) | (v.item0 >>> 2), c: 0_u64)
  var n1 = b128_asinfam_ac(a: v.item1, b: (v.item2 << 62) | (v.item1 >>> 2), c: n0.item1)
  var n2 = b128_asinfam_ac(a: v.item2, b: v.item2 >>> 2, c: n1.item1)
  var t4u = b128_asinfam_join(hi: h4s.item1, lo: h4s.item0)
  t4u = t4u +% ((t4u *% 3_u128) >>> 5)
  var h2s = b128_asinfam_shrn5(a: B128AsinFamW5(w0: 0_u64, w1: m0.item0, w2: m1.item0, w3: m2.item0, w4: m3.item0), k: 62 -% eo)
  var h3s = b128_asinfam_shrn5(a: B128AsinFamW5(w0: 0_u64, w1: 0_u64, w2: n0.item0, w3: n1.item0, w4: n2.item0), k: 59 +% 64 -% 2 *% eo)
  var t4 = b128_asinfam_shrn5(a: B128AsinFamW5(w0: 0_u64, w1: 0_u64, w2: 0_u64, w3: b128_asinfam_lo(u: t4u), w4: b128_asinfam_hi(u: t4u)), k: 56 +% 128 -% 3 *% eo)
  var h = B128AsinFamW5(w0: h0, w1: h1, w2: h2, w3: h3, w4: h4)
  if msk != 0_u64
    h = b128_asinfam_add5(a: h, b: h2s)
    h = b128_asinfam_add5(a: h, b: h3s)
    h = b128_asinfam_add5(a: h, b: t4)
  else
    h = b128_asinfam_sub5(a: h, b: h2s)
    h = b128_asinfam_add5(a: h, b: h3s)
    h = b128_asinfam_sub5(a: h, b: t4)
  var g6 = b128_asinfam_mu6(b0: r, a: h)
  var x2l = B128AsinFamW5(w0: 0_u64, w1: q.item0, w2: q.item1, w3: q.item2, w4: q.item3)
  var hh = b128_asinfam_mh5(b: B128AsinFamW5(w0: g6.w1, w1: g6.w2, w2: g6.w3, w3: g6.w4, w4: g6.w5), a: x2l)
  hh = b128_asinfam_shrn5(a: hh, k: 62 -% eo)
  if msk == 0_u64
    sq = b128_asinfam_sub5(a: sq, b: hh)
  else
    sq = b128_asinfam_add5(a: sq, b: hh)
  return (sq, e)

### The accurate path's polynomial P(t^2) to five words (the C evalpoly).
secret routine b128_asinfam_evalpoly(t2: B128AsinFamW5) -> B128AsinFamW5
  var f0 = b128_asinfam_mhuu(a: t2.w4, b: B128_ASINFAM_CP[0])
  f0 = B128_ASINFAM_CP[1] +% f0
  var f1 = B128_ASINFAM_CP[2]
  var k = 3_u64
  var i = 0_u64
  while i < 6_u64
    var p2 = b128_asinfam_mh2(b0: f0, b1: f1, a0: t2.w3, a1: t2.w4)
    var s2 = b128_asinfam_ac(a: B128_ASINFAM_CP[k], b: p2.item0, c: 0_u64)
    var s2b = b128_asinfam_ac(a: B128_ASINFAM_CP[k +% 1_u64], b: p2.item1, c: s2.item1)
    f0 = s2.item0
    f1 = s2b.item0
    k = k +% 2_u64
    i = i +% 1_u64
  var f2 = B128_ASINFAM_CP[15]
  k = 16_u64
  i = 0_u64
  while i < 5_u64
    var p3 = b128_asinfam_mh3(b0: f0, b1: f1, b2: f2, a0: t2.w2, a1: t2.w3, a2: t2.w4)
    var s3 = b128_asinfam_add3(a0: B128_ASINFAM_CP[k], a1: B128_ASINFAM_CP[k +% 1_u64], a2: B128_ASINFAM_CP[k +% 2_u64], b0: p3.item0, b1: p3.item1, b2: p3.item2)
    f0 = s3.item0
    f1 = s3.item1
    f2 = s3.item2
    k = k +% 3_u64
    i = i +% 1_u64
  var f3 = B128_ASINFAM_CP[31]
  k = 32_u64
  i = 0_u64
  while i < 6_u64
    var p4 = b128_asinfam_mh4(b0: f0, b1: f1, b2: f2, b3: f3, a0: t2.w1, a1: t2.w2, a2: t2.w3, a3: t2.w4)
    var q0 = b128_asinfam_ac(a: B128_ASINFAM_CP[k], b: p4.item0, c: 0_u64)
    var q1 = b128_asinfam_ac(a: B128_ASINFAM_CP[k +% 1_u64], b: p4.item1, c: q0.item1)
    var q2 = b128_asinfam_ac(a: B128_ASINFAM_CP[k +% 2_u64], b: p4.item2, c: q1.item1)
    var q3 = b128_asinfam_ac(a: B128_ASINFAM_CP[k +% 3_u64], b: p4.item3, c: q2.item1)
    f0 = q0.item0
    f1 = q1.item0
    f2 = q2.item0
    f3 = q3.item0
    k = k +% 4_u64
    i = i +% 1_u64
  var f = B128AsinFamW5(w0: f0, w1: f1, w2: f2, w3: f3, w4: B128_ASINFAM_CP[56])
  k = 57_u64
  i = 0_u64
  while i < 5_u64
    var p5 = b128_asinfam_mh5(b: f, a: t2)
    var ck = B128AsinFamW5(w0: B128_ASINFAM_CP[k], w1: B128_ASINFAM_CP[k +% 1_u64], w2: B128_ASINFAM_CP[k +% 2_u64], w3: B128_ASINFAM_CP[k +% 3_u64], w4: B128_ASINFAM_CP[k +% 4_u64])
    f = b128_asinfam_add5(a: ck, b: p5)
    k = k +% 5_u64
    i = i +% 1_u64
  return f

# ============================================================================
# Tables
# ============================================================================
# B128_ASINFAM_RSQRT: 64 rows of 4 coefficients of the cubic 1/sqrt approximation (rsqrt9)
# B128_ASINFAM_STH: rounded sin(pi/2/72*j) in the format of the range reduction
# B128_ASINFAM_PTH: rounded sin(pi/2/72*j)
# B128_ASINFAM_CTH: sqrt(1 - PTH[j]^2), five words per row
# B128_ASINFAM_IND: the table index of the range reduction
# B128_ASINFAM_C: the fast polynomial, two words per coefficient
# B128_ASINFAM_CP: the accurate polynomial, coefficients of growing width packed back to back
secret preset B128_ASINFAM_RSQRT: Array[U64, 256] = [
  0x00000000FFFFFFFF_u64, 0x00000000FFFFF780_u64, 0x00000000BFF55815_u64, 0x000000009BB5B6E7_u64,
