# The arguments (bit patterns, sorted) whose e^x - 1 is too close to a rounding boundary for the accurate
# path.
secret preset B64_EXPM1_DB: Array[U64, 38] = [0x3FBE923C188EA79B_u64, 0x3FD1A0408712E00A_u64, 0x3FD1C38132777B26_u64, 0x3FD27F4980D511FF_u64, 0x3FD8172A0E02F90E_u64, 0x3FD8BBE2FB45C151_u64, 0x3FDBCAB27D05ABDE_u64, 0x3FE005AE04256BAB_u64, 0x3FEACCFBE46B4EF0_u64, 0x3FED086543694C5A_u64, 0x401273C188AA7B14_u64, 0x40183D4BCDEBB3F4_u64, 0x40308F51434652C3_u64, 0x4031D5C2DAEBE367_u64, 0x403C44CE0D716A1A_u64, 0x4042EE70220FB1C5_u64, 0x40489D56A0C38E6F_u64, 0x4057A60EE15E3E9D_u64, 0x4061F0DA93354198_u64, 0x40654CD1FEA7663A_u64, 0x406556C678D5E976_u64, 0x4072DA9E5E6AF0B0_u64, 0x4079E7B643238A14_u64, 0x407D6479EBA7C971_u64, 0x4080BC04AF1B09F5_u64, 0xBFBAB86CB1743B75_u64, 0xBFD119AAE6072D39_u64, 0xBFD175693A03B590_u64, 0xBFD474D4DE7C14BB_u64, 0xBFD789D025948EFA_u64, 0xBFD82B5DFAF59B4C_u64, 0xBFD9D871E078EBCE_u64, 0xBFE1397ADD4538AC_u64, 0xBFE22E24FA3D5CF9_u64, 0xBFEDC2B5DF1F7D3D_u64, 0xBFF0A54D87783D6F_u64, 0xBFF2A9CAD9998262_u64, 0xBFFE42A2ABB1BF0F_u64]
