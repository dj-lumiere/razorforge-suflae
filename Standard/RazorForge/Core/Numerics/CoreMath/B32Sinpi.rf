### Returns `sin(pi * me)`, correctly rounded: the exact value rounded to the nearest `B32` (ties to even),
### identical on every platform. Integers give a zero of the argument's sign, ±infinity gives NaN and NaN
### maps to NaN.
### :returns: The correctly rounded `sin(pi * me)`.
routine B32.sinpi() -> B32
  var ix = me.to_bits()
  var e = LLVM::reinterpret_bits[U64, S64](LLVM::zero_extend[U32, U64]((ix >>> 23) & 0xFF_u32))
  if e == 0xFF_s64
    if ix << 9 == 0_u32
      return B32.from_bits(bits: 0x7FC00000_u32)
    return me +! me
  # m is the signed significand (two's complement), sgn all ones for a negative argument
  var sgn = 0_u32
  if ix >>> 31 == 1_u32
    sgn = U32_MAX
  var m = (((ix & 0x7FFFFF_u32) | 0x800000_u32) ^ sgn) -% sgn
  var s = 143_s64 - e
  if s < 0_s64
    # |x| >= 0x1p+17
    if s < -6_s64
      # |x| >= 0x1p+23: x is an even integer
      return 0.0_b32.copysign(sign: me)
    var iq = (m << LLVM::int_truncate[S64, U32](-s - 1_s64)) & 127_u32
    if iq == 0_u32 or iq == 64_u32
      return 0.0_b32.copysign(sign: me)
    return B32(from: B64.from_bits(bits: B32_SINPI_S[LLVM::zero_extend[U32, U64](iq)]))
  if s > 30_s64
    # |x| < 0x1p-14
    var z = B64(from: me)
    var z2 = z *! z
    return B32(from: z *! (0x1.921fb54442d18p+1 +! z2 *! -0x1.4abbce625be53p+2))
  var si = 25_s64 - s
  if si >= 0_s64
    if m << LLVM::int_truncate[S64, U32](si) == 0_u32
      # x is an integer
      return 0.0_b32.copysign(sign: me)
  var k = LLVM::reinterpret_bits[U32, S32](m << LLVM::int_truncate[S64, U32](31_s64 - s))
  var z = LLVM::signed_to_float[S32, B64](k)
  var z2 = z *! z
  var fs = 0x1.921fb54442d0fp-37 +! z2 *! (-0x1.4abbce6102b94p-112 +! z2 *! 0x1.4669fa3c58463p-189)
  var fc = -0x1.3bd3cc9be45cfp-74 +! z2 *! (0x1.03c1f08088742p-150 +! z2 *! -0x1.55d1e5eff55a5p-228)
  var iq = LLVM::reinterpret_bits[S32, U32](LLVM::reinterpret_bits[U32, S32](m) >> LLVM::int_truncate[S64, U32](s))
  iq = (iq +% 1_u32) >>> 1
  var ts = B64.from_bits(bits: B32_SINPI_S[LLVM::zero_extend[U32, U64](iq & 127_u32)])
  var tc = B64.from_bits(bits: B32_SINPI_S[LLVM::zero_extend[U32, U64]((iq +% 32_u32) & 127_u32)])
  var r = (ts +! (ts *! z2) *! fc) +! (tc *! z) *! fs
  return B32(from: r)
