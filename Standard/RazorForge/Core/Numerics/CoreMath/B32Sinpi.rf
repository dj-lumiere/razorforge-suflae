module Core

# ============================================================================
# Correctly rounded sin(pi*x) of B32
# ============================================================================
# Ported from CORE-MATH, src/binary32/sinpi/sinpif.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2022-2025 Alexei Sibidanov. Distributed under the MIT license: see LICENSE-CORE-MATH next
# to this file. RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the original
# is kept (its errno handling and exception raising are dropped). Arithmetic uses the unchecked operators
# `+! -! *! /!`, which are raw IEEE 754 on floats.
# The table is shared with `B32.cospi()` (B32Cospi.rf).

### `sin(i*pi/64)` for i in 0..127, as B64 bit patterns.
secret preset B32_SINPI_S: Array[U64, 128] = [0x0000000000000000_u64, 0x3FA91F65F10DD814_u64, 0x3FB917A6BC29B42C_u64, 0x3FC2C8106E8E613A_u64, 0x3FC8F8B83C69A60B_u64, 0x3FCF19F97B215F1B_u64, 0x3FD294062ED59F06_u64, 0x3FD58F9A75AB1FDD_u64, 0x3FD87DE2A6AEA963_u64, 0x3FDB5D1009E15CC0_u64, 0x3FDE2B5D3806F63B_u64, 0x3FE073879922FFEE_u64, 0x3FE1C73B39AE68C8_u64, 0x3FE30FF7FCE17035_u64, 0x3FE44CF325091DD6_u64, 0x3FE57D69348CECA0_u64, 0x3FE6A09E667F3BCD_u64, 0x3FE7B5DF226AAFAF_u64, 0x3FE8BC806B151741_u64, 0x3FE9B3E047F38741_u64, 0x3FEA9B66290EA1A3_u64, 0x3FEB728345196E3E_u64, 0x3FEC38B2F180BDB1_u64, 0x3FECED7AF43CC773_u64, 0x3FED906BCF328D46_u64, 0x3FEE212104F686E5_u64, 0x3FEE9F4156C62DDA_u64, 0x3FEF0A7EFB9230D7_u64, 0x3FEF6297CFF75CB0_u64, 0x3FEFA7557F08A517_u64, 0x3FEFD88DA3D12526_u64, 0x3FEFF621E3796D7E_u64, 0x3FF0000000000000_u64, 0x3FEFF621E3796D7E_u64, 0x3FEFD88DA3D12526_u64, 0x3FEFA7557F08A517_u64, 0x3FEF6297CFF75CB0_u64, 0x3FEF0A7EFB9230D7_u64, 0x3FEE9F4156C62DDA_u64, 0x3FEE212104F686E5_u64, 0x3FED906BCF328D46_u64, 0x3FECED7AF43CC773_u64, 0x3FEC38B2F180BDB1_u64, 0x3FEB728345196E3E_u64, 0x3FEA9B66290EA1A3_u64, 0x3FE9B3E047F38741_u64, 0x3FE8BC806B151741_u64, 0x3FE7B5DF226AAFAF_u64, 0x3FE6A09E667F3BCD_u64, 0x3FE57D69348CECA0_u64, 0x3FE44CF325091DD6_u64, 0x3FE30FF7FCE17035_u64, 0x3FE1C73B39AE68C8_u64, 0x3FE073879922FFEE_u64, 0x3FDE2B5D3806F63B_u64, 0x3FDB5D1009E15CC0_u64, 0x3FD87DE2A6AEA963_u64, 0x3FD58F9A75AB1FDD_u64, 0x3FD294062ED59F06_u64, 0x3FCF19F97B215F1B_u64, 0x3FC8F8B83C69A60B_u64, 0x3FC2C8106E8E613A_u64, 0x3FB917A6BC29B42C_u64, 0x3FA91F65F10DD814_u64, 0x0000000000000000_u64, 0xBFA91F65F10DD814_u64, 0xBFB917A6BC29B42C_u64, 0xBFC2C8106E8E613A_u64, 0xBFC8F8B83C69A60B_u64, 0xBFCF19F97B215F1B_u64, 0xBFD294062ED59F06_u64, 0xBFD58F9A75AB1FDD_u64, 0xBFD87DE2A6AEA963_u64, 0xBFDB5D1009E15CC0_u64, 0xBFDE2B5D3806F63B_u64, 0xBFE073879922FFEE_u64, 0xBFE1C73B39AE68C8_u64, 0xBFE30FF7FCE17035_u64, 0xBFE44CF325091DD6_u64, 0xBFE57D69348CECA0_u64, 0xBFE6A09E667F3BCD_u64, 0xBFE7B5DF