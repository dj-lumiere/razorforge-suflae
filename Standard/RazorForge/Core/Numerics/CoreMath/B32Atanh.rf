module Core

# ============================================================================
# Correctly rounded inverse hyperbolic tangent of B32
# ============================================================================
# Ported from CORE-MATH, src/binary32/atanh/atanhf.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2023-2025 Alexei Sibidanov. Distributed under the MIT license: see LICENSE-CORE-MATH next to
# this file. RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the original
# is kept (its errno handling and floating-point exception raising are dropped).
# Arithmetic uses the unchecked operators `+! -! *! /!`, which are raw IEEE 754 on floats.

### Inverse hyperbolic tangent, correctly rounded: the exact atanh rounded to the nearest `B32` (ties to
### even), identical on every platform. Raw IEEE 754 propagation: `±1` gives ±infinity, `|me| > 1` (or
### NaN) gives NaN, and ±0 maps to itself.
### :returns: The correctly rounded inverse hyperbolic tangent.
routine B32.atanh_unchecked() -> B32
  # atanh(x) = (log(1 + x) - log(1 - x)) / 2
  var ux = me.to_bits()
  var ax = ux << 1
  if ax < 0x7A300000_u32 or ax >= 0x7F000000_u32
    if ax >= 0x7F000000_u32
      # |x| >= 1 or NaN
      if ax == 0x7F000000_u32
        return me /! 0.0_b32
      if ax > 0xFF000000_u32
        return me +! me
      return B32.from_bits(bits: 0xFFC00000_u32)
    if ax < 0x73713744_u32
      # |x| < 0x1.f5a956p-12
      if ax == 0
        return me
      return LLVM::fma[B32](a: me, b: 0x1p-25_b32, c: me)
    var z = B64(from: me)
    var z2 = z *! z
    var z4 = z2 *! z2
    var r = (0x1.5555555555527p-2 +! z2 *! 0x1.9999999ba4ee8p-3) +! z4 *! (0x1.24922c280990ap-3 +! z2 *! 0x1.c8236aae809c6p-4)
    return B32(from: z +! (z *! z2) *! r)
  var sgn = 1.0
  if (ux >>> 31) == 1
    sgn = -1.0
  var e = ax >>> 24
  var md = ((ux << 8) | 0x80000000_u32) >>> (126_u32 - e)
  var mn = 0_u32 -% md
  var nz = mn.leading_zeros() + 1
  mn = mn << nz
  var jn = LLVM::zero_extend[U32, U64](mn >>> 26)
  var jd = LLVM::zero_extend[U32, U64](md >>> 26)
  var tn = B64.from_bits(bits: (LLVM::zero_extend[U32, U64](mn) << 20) | (1023_u64 << 52))
  var td = B64.from_bits(bits: (LLVM::zero_extend[U32, U64](md) << 20) | (1023_u64 << 52))
  var zn = tn *! B64.from_bits(bits: B32_ATANH_TR[jn]) -! 1.0
  var zd = td *! B64.from_bits(bits: B32_ATANH_TR[jd]) -! 1.0
  var zn2 = zn *! zn
  var zd2 = zd *! zd
  var nzi = LLVM::zero_extend[U32, U64](nz)
  var rn = ((B64.from_bits(bits: B32_ATANH_TL[jn]) -! B64.from_bits(bits: B32_ATANH_LN2N[nzi - 1])) +! zn *! 0x1.fffffffce5a6ap-2) +! zn2 *! (-0x1.0001f81ec0ab8p-2 +! zn *! 0x1.555a0f53d79a5p-3)
  var rd = (B64.from_bits(bits: B32_ATANH_TL[jd]) +! zd *! 0x1.fffffffce5a6ap-2) +! zd2 *! (-0x1.0001f81ec0ab8p-2 +! zd *! 0x1.555a0f53d79a5p-3)
  var r = sgn *! (rd -! rn)
  var ub = B32(from: r)
  var lb = B32(from: r +! sgn *! 0x1.f0fab08151146p-33)
  if ub != lb
    # too close to a rounding boundary: evaluate both logarithms with longer polynomials
    var zn4 = zn2 *! zn2
    var zd4 = zd2 *! zd2
    var nzf = B64(from: nzi)
    var fn = zn *! (((0x1p-1 +! zn *! -0x1.000000000001bp-2) +! zn2 *! (0x1.55555555555bap-3 +! zn *! -0x1.fffffff26d72ep-4)) +! zn4 *! ((0x1.99999989035p-4 +! zn *! -0x1.555c39cb9ee8p-4) +! zn2 *! 0x1.24992d8b014a1p-4))
    fn = fn +! 0x1.0ca86c3898dp-50 *! nzf
    fn = fn +! B64.from_bits(bits: B32_ATANH_TL[jn])
    var en = nzf *! 0x1.62e42fefa3ap-2
    var fd = zd *! (((0x1p-1 +! zd *! -0x1.000000000001bp-2) +! zd2 *! (0x1.55555555555bap-3 +! zd *! -0x1.fffffff26d72ep-4)) +! zd4 *! ((0x1.99999989035p-4 +! zd *! -0x1.555c39cb9ee8p-4) +! zd2 *! 0x1.24992d8b014a1p-4))
    fd = fd +! B64.from_bits(bits: B32_ATANH_TL[jd])
    r = (fd -! fn) +! en
    ub = B32(from: sgn *! r)
  return ub

