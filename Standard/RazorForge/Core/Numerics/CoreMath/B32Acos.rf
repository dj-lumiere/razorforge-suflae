module Core

# ============================================================================
# Correctly rounded arc cosine of B32
# ============================================================================
# Ported from CORE-MATH, src/binary32/acos/acosf.c (https://core-math.gitlabpages.inria.fr/).
# Copyright (c) 2023 Alexei Sibidanov. Distributed under the MIT license: see LICENSE-CORE-MATH next to
# this file. RazorForge has no dynamic rounding modes, so only the round-to-nearest path of the original is
# kept (its errno handling is dropped). Arithmetic uses the unchecked operators `+! -! *! /!`, which are
# raw IEEE 754 on floats.
# The accurate-path polynomial `b32_asin_poly12` comes from B32Asin.rf (the original uses the same tables).

### Arc cosine with raw IEEE 754 propagation (`|me| > 1` -> NaN), correctly rounded: the exact arc cosine
### rounded to the nearest `B32` (ties to even), identical on every platform.
### :returns: The correctly rounded arc cosine, in [0, pi].
routine B32.acos_unchecked() -> B32
  var xs = B64(from: me)
  var t = me.to_bits()
  var ax = t << 1
  if ax >= 0x7F000000_u32
    # |x| >= 1 or NaN
    if t == 0x3F800000_u32
      return 0.0_b32
    if t == 0xBF800000_u32
      return 0x1.921fb6p+1_b32 +! -0x1p-24_b32
    if ax > 0xFF000000_u32
      return me +! me
    return B32.from_bits(bits: 0xFFC00000_u32)
  if ax < 0x7EC2A1DC_u32
    # |x| < 0x1.c2a1dcp-1
    if ax < 0x40000000_u32
      # |x| < 2^-63
      return 0x1.921fb6p+0_b32 +! -0x1.777a5cp-25_b32
    var z = xs
    var z2 = z *! z
    var z4 = z2 *! z2
    var z8 = z4 *! z4
    var z16 = z8 *! z8
    var p0 = ((0x1.fffffffd9ccb8p-1 +! z2 *! 0x1.5555c94838007p-3) +! z4 *! (0x1.32ded4b7c20fap-4 +! z2 *! 0x1.8566df703309ep-5)) +! z8 *! ((-0x1.980c959bec9a3p-6 +! z2 *! 0x1.56fbb04998344p-1) +! z4 *! (-0x1.403d8e4c49f52p+2 +! z2 *! 0x1.b06c3e9f311eap+4))
    var p1 = ((-0x1.9ea97c4e2c21fp+6 +! z2 *! 0x1.200b8261cc61bp+8) +! z4 *! (-0x1.2274c2799a5c7p+9 +! z2 *! 0x1.a558a59cc19d3p+9)) +! z8 *! ((-0x1.aca4b6a529ffp+9 +! z2 *! 0x1.228744703f813p+9) +! z4 *! (-0x1.d7dbb0b322228p+7 +! z2 *! 0x1.5c2018c0c0105p+5))
    var rf = z *! (p0 +! z16 *! p1)
    var ub = B32(from: 0x1.921fb54574191p+0 -! rf)
    var lb = B32(from: 0x1.921fb543118ap+0 -! rf)
    if ub == lb
      return ub
  # accurate path
  var r = 0.0
  if ax < 0x7E000000_u32
    # |x| < 1/2
    if t == 0x328885A3_u32
      return 0x1.921fb6p+0_b32 +! 0x1p-25_b32
    if t == 0x39826222_u32
      return 0x1.920f6ap+0_b32 +! 0x1p-25_b32
    var x2 = xs *! xs
    r = (0x1.921fb54442d18p+0 -! xs) -! (xs *! x2) *! b32_asin_poly12(z: x2, base: 0_u64)
  else
    var z = 1.0 -! xs.abs()
    var s = LLVM::sqrt[B64](value: z).copysign(sign: xs)
    var o = 0.0
    if t >>> 31 == 1_u32
      o = 0x1.921fb54442d18p+1
    r = o +! s *! b32_asin_poly12(z: z, base: 12_u64)
  return B32(from: r)
