module Core

import Collections
# Core B64 type definition - maps to LLVM double

### A 64-bit IEEE 754 binary floating-point value (double precision).
### `B64` is the default floating-point type for general scientific, financial,
### and system-level numeric code in RazorForge. With 53 bits of significand, it
### provides about 15–16 significant decimal digits of precision and can represent
### values up to approximately ±1.8 × 10³⁰⁸.
###
### Arithmetic operations throw {NumericOverflowError} when the result is
### non-finite (infinity or NaN). Use `truediv_unchecked` for raw IEEE 754
### semantics without the overflow guard.
@llvm("double")
record B64 obeys Numeric, Ordered, Assignable, Copyable, Splittable
  pass

# IEEE 754 double precision constants
preset B64_EPSILON: B64 = 2.220446049250313e-16_b64
preset B64_MIN: B64 = -1.7976931348623157e+308_b64
preset B64_MAX: B64 = 1.7976931348623157e+308_b64
preset B64_MIN_POSITIVE: B64 = 2.2250738585072014e-308_b64
preset B64_ZERO: B64 = 0.0_b64
preset B64_ONE: B64 = 1.0_b64
preset B64_NAN: B64 = nan_b64
preset B64_INFINITY: B64 = inf_b64
preset B64_PI: B64 = 3.141592653589793_b64
preset B64_E: B64 = 2.718281828459045_b64
preset B64_SQRT_2: B64 = 1.4142135623730951_b64
preset B64_LN_2: B64 = 0.6931471805599453_b64
preset B64_LN_10: B64 = 2.302585092994046_b64

# ============================================================================
# Creators
# ============================================================================

### Converts an `S8` to `B64`. The result is exact for all values.
### :param from: The signed 8-bit integer to convert.
### :returns: The corresponding `B64` value.
routine B64(from: S8) -> B64
  return LLVM::signed_to_float[S8, B64](from)

### Converts an `S16` to `B64`. The result is exact for all values.
### :param from: The signed 16-bit integer to convert.
### :returns: The corresponding `B64` value.
routine B64(from: S16) -> B64
  return LLVM::signed_to_float[S16, B64](from)

### Converts an `S32` to `B64`. The result is exact for all values.
### :param from: The signed 32-bit integer to convert.
### :returns: The corresponding `B64` value.
routine B64(from: S32) -> B64
  return LLVM::signed_to_float[S32, B64](from)

### Converts an `S64` to `B64`.
### Values with magnitude larger than 2⁵³ may be rounded to the nearest
### representable double.
### :param from: The signed 64-bit integer to convert.
### :returns: The closest representable `B64` value.
routine B64(from: S64) -> B64
  return LLVM::signed_to_float[S64, B64](from)

### Converts an `S128` to `B64`.
### Precision is limited to approximately 53 bits of significand.
### :param from: The signed 128-bit integer to convert.
### :returns: The closest representable `B64` value.
routine B64(from: S128) -> B64
  return LLVM::signed_to_float[S128, B64](from)

### Converts a `U8` to `B64`. The result is exact for all values.
### :param from: The unsigned 8-bit integer to convert.
### :returns: The corresponding `B64` value.
routine B64(from: U8) -> B64
  return LLVM::unsigned_to_float[U8, B64](from)

### Converts a `U16` to `B64`. The result is exact for all values.
### :param from: The unsigned 16-bit integer to convert.
### :returns: The corresponding `B64` value.
routine B64(from: U16) -> B64
  return LLVM::unsigned_to_float[U16, B64](from)

### Converts a `U32` to `B64`. The result is exact for all values.
### :param from: The unsigned 32-bit integer to convert.
### :returns: The corresponding `B64` value.
routine B64(from: U32) -> B64
  return LLVM::unsigned_to_float[U32, B64](from)

### Converts a `U64` to `B64`.
### Values larger than 2⁵³ may be rounded to the nearest representable double.
### :param from: The unsigned 64-bit integer to convert.
### :returns: The closest representable `B64` value.
routine B64(from: U64) -> B64
  return LLVM::unsigned_to_float[U64, B64](from)

### Converts a `U128` to `B64`.
### Precision is limited to approximately 53 bits of significand.
### :param from: The unsigned 128-bit integer to convert.
### :returns: The closest representable `B64` value.
routine B64(from: U128) -> B64
  return LLVM::unsigned_to_float[U128, B64](from)

### Converts an `S256` to `B64` (precision limited to ~53 bits of significand).
### :param from: The signed 256-bit integer to convert.
### :returns: The closest representable `B64` value.
routine B64(from: S256) -> B64
  return LLVM::signed_to_float[S256, B64](from)

### Converts a `U256` to `B64` (precision limited to ~53 bits of significand).
### :param from: The unsigned 256-bit integer to convert.
### :returns: The closest representable `B64` value.
routine B64(from: U256) -> B64
  return LLVM::unsigned_to_float[U256, B64](from)

### Widens a half-precision float to double precision.
### :param from: The `B16` value to widen.
### :returns: An `B64` carrying the same numeric value.
routine B64(from: B16) -> B64
  return LLVM::float_extend[B16, B64](from)

### Widens a single-precision float to double precision.
### :param from: The `B32` value to widen.
### :returns: An `B64` carrying the same numeric value.
routine B64(from: B32) -> B64
  return LLVM::float_extend[B32, B64](from)

### Returns an existing `B64` unchanged.
### :param from: The double-precision value to forward.
### :returns: `from`.
routine B64(from: B64) -> B64
  return from

### (`B64(from: B128)` is provided by the quadruple-precision engine — `B128.rf` — which owns
### the bit-surgery narrowing; a forwarding stub here would recurse into itself.)

### (`B64(from: D32)` is provided by the decimal32 engine — `D32Trans.rf`.)

### Converts a decimal64 value to double-precision binary floating point.
### :param from: The decimal floating-point input value.
### :returns: The closest representable `B64` value.
routine B64(from: D64) -> B64
  return d64_to_b128(x: from).B64()

### Converts a decimal128 value to double-precision binary floating point.
### :param from: The decimal floating-point input value.
### :returns: The closest representable `B64` value.
routine B64(from: D128) -> B64
  return d128_to_uf192(x: from).to_b128().B64()

# ============================================================================
# Arithmetic Operations
# ============================================================================

# Checked arithmetic crashes with a SPECIFIC cause when a result is non-finite, mirroring the
# `Decimal` contract: ±inf -> NumericOverflowError, NaN -> NumericDomainError, x/0 ->
# DivisionByZeroError.
# `@crash_only` makes each crash unconditional, so the wired operators that call them stay
# non-failable — a non-finite result is a bug surfaced loudly at its source, not a recoverable
# error.
# Opt out with the `*_unchecked` operators (raw IEEE 754 propagation) or `.finite()`
# (recoverable).

### Classifies a non-finite result: NaN -> domain crash, ±infinity -> overflow crash.

### Returns `me + you`. Checked: crashes if the IEEE result is ±infinity (overflow) or NaN
### (domain). Use `add_unchecked` for raw IEEE 754 propagation.
### :param you: The addend.
### :returns: The double-precision sum (always finite).
routine B64.add!(you: B64) -> B64
  var r = LLVM::float_add[B64](a: me, b: you)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `me - you`. Checked: crashes if the IEEE result is non-finite.
### Use `sub_unchecked` for raw IEEE 754 propagation.
### :param you: The value to subtract.
### :returns: The double-precision difference (always finite).
routine B64.sub!(you: B64) -> B64
  var r = LLVM::float_sub[B64](a: me, b: you)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `me + you`, promoting the real `me` to complex (imaginary part 0). Only `+`/`-` allow
### real↔complex mixing; the component width must match (B64 pairs with C128).
### :param you: The complex addend.
### :returns: The complex sum.
routine B64.add(you: C128) -> C128
  return C128(from: me).add(you)

### Returns `me - you`, promoting the real `me` to complex (imaginary part 0).
### :param you: The complex value to subtract.
### :returns: The complex difference.
routine B64.sub(you: C128) -> C128
  return C128(from: me).sub(you)

### Returns `me * you`. Checked: crashes if the IEEE result is non-finite.
### Use `mul_unchecked` for raw IEEE 754 propagation.
### :param you: The multiplier.
### :returns: The double-precision product (always finite).
routine B64.mul!(you: B64) -> B64
  var r = LLVM::float_mul[B64](a: me, b: you)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `me / you`. Checked: `x / 0` crashes with DivisionByZeroError, `0 / 0` with a domain
### error, and an overflow to ±infinity with an overflow error. Use `truediv_unchecked` for raw
### IEEE 754 (`x/0` -> ±inf, `0/0` -> NaN), or `(a / b).finite()` for recoverable handling.
### :param you: The divisor.
### :returns: The double-precision quotient (always finite).
routine B64.truediv!(you: B64) -> B64
  var r = LLVM::float_div[B64](a: me, b: you)
  if r.is_finite()
    return r
  if you.is_zero() and not me.is_zero()
    throw DivisionByZeroError()
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `me` if it is finite; throws (RECOVERABLE) if it is ±infinity or NaN. The bridge from
### raw IEEE propagation back to a handled result: run the unchecked operators, then recover, e.g.
### `var x = when (a *~ b +~ c).finite() { is err: fallback else v: v }`. (The checked `+ - * /`
### crash instead, so a checked `(a * b)` would already have crashed before reaching `finite!`.)
### :returns: `me`, when finite.
### :throws: {NumericOverflowError} if `me` is ±infinity or NaN.
routine B64.finite!() -> B64
  if not me.is_finite()
    throw NumericOverflowError(description: f"B64 value is non-finite: {me}")
  return me

### Returns the arithmetic negation of this value.
### :returns: `-me` in double precision.
routine B64.neg() -> B64
  return LLVM::float_neg[B64](me)

# Unchecked variants — raw IEEE 754 propagation (the float analog of integer `+%`/`+^`). inf/NaN
# are valid IEEE values, not memory hazards, so these are plain (NOT `dangerous`) — the operator
# spelling (`+~`/`-~`/`*~`/`/~`) and `_unchecked` name are the marker. Division by zero yields ±inf
# (x != 0) or NaN (0/0), never undefined behaviour.

### Returns `me / you` with raw IEEE 754 semantics: `x/0` -> ±infinity, `0/0` -> NaN. No crash.
### :param you: The divisor.
### :returns: The double-precision quotient, possibly ±infinity or NaN.
routine B64.truediv_unchecked(you: B64) -> B64
  return LLVM::float_div[B64](a: me, b: you)

### Returns `me + you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine B64.add_unchecked(you: B64) -> B64
  return LLVM::float_add[B64](a: me, b: you)

### Returns `me - you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine B64.sub_unchecked(you: B64) -> B64
  return LLVM::float_sub[B64](a: me, b: you)

### Returns `me * you` with raw IEEE 754 propagation (may yield ±infinity or NaN). No crash.
routine B64.mul_unchecked(you: B64) -> B64
  return LLVM::float_mul[B64](a: me, b: you)

# ============================================================================
# Comparison Operations (ordered - false if NaN)
# ============================================================================

### Returns `true` if both values are equal under IEEE 754 ordered comparison.
### :param you: The value to compare against.
### :returns: `true` if `me == you`; `false` if either operand is NaN.
routine B64.eq(you: B64) -> Bool
  return LLVM::float_eq[B64](a: me, b: you)

### Compares this value with `you` under IEEE 754 ordered comparison.
### :param you: The value to compare against.
### :returns: `ME_SMALL`, `ME_LARGE`, or `SAME`.
routine B64.cmp(you: B64) -> ComparisonSign
  if LLVM::float_lt[B64](a: me, b: you)
    return ME_SMALL
  if LLVM::float_gt[B64](a: me, b: you)
    return ME_LARGE
  return SAME

# ============================================================================
# Math Operations using intrinsics
# ============================================================================

### Returns the square root. Checked: crashes (domain error) if `me` is negative (`sqrt(<0)` ->
### NaN).
### Use `sqrt_unchecked` for raw IEEE 754 propagation.
### :returns: The double-precision square root (always finite).
routine B64.sqrt!() -> B64
  var r = me.sqrt_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns the square root with raw IEEE 754 propagation (`sqrt(<0)` -> NaN).
routine B64.sqrt_unchecked() -> B64
  return LLVM::sqrt[B64](me)

### Returns the absolute value.
### :returns: `|me|` in double precision.
routine B64.abs() -> B64
  return LLVM::float_abs[B64](me)

### Rounds this value toward negative infinity.
### :returns: The greatest integral-valued `B64` not larger than `me`.
routine B64.floor() -> B64
  return LLVM::floor[B64](me)

### Rounds this value toward positive infinity.
### :returns: The smallest integral-valued `B64` not smaller than `me`.
routine B64.ceil() -> B64
  return LLVM::ceil[B64](me)

### Rounds this value to the nearest integral-valued `B64`.
### :returns: The rounded result in double precision.
routine B64.round() -> B64
  return LLVM::round[B64](me)

### Discards the fractional part of this value toward zero.
### :returns: The truncated result in double precision.
routine B64.int_truncate() -> B64
  return LLVM::float_truncate[B64](me)

### Returns the sine of this value, interpreting it as radians.
### :returns: The double-precision sine result.
routine B64.sin() -> B64
  return LLVM::sin[B64](me)

### Returns the cosine of this value, interpreting it as radians.
### :returns: The double-precision cosine result.
routine B64.cos() -> B64
  return LLVM::cos[B64](me)

### Returns `e` raised to this value. Checked: crashes (overflow) if the result is ±infinity.
### Use `exp_unchecked` for raw IEEE 754 propagation.
### :returns: The double-precision exponential result (always finite).
routine B64.exp!() -> B64
  var r = me.exp_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns `e` raised to this value with raw IEEE 754 propagation (overflow -> +infinity).
routine B64.exp_unchecked() -> B64
  return LLVM::exp[B64](me)

### Returns the natural logarithm. Checked: crashes on a non-finite result (`log(0)` -> -inf,
### `log(<0)` -> NaN). Use `log_unchecked` for raw IEEE 754 propagation.
### :returns: The double-precision natural-log result (always finite).
routine B64.log!() -> B64
  var r = me.log_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns the natural logarithm with raw IEEE 754 propagation (`log(0)` -> -inf, `log(<0)` ->
### NaN).
routine B64.log_unchecked() -> B64
  return LLVM::log[B64](me)

### Returns the base-10 logarithm. Checked: crashes on a non-finite result.
### Use `log10_unchecked` for raw IEEE 754 propagation.
### :returns: The double-precision common-log result (always finite).
routine B64.log10!() -> B64
  var r = me.log10_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns the base-10 logarithm with raw IEEE 754 propagation.
routine B64.log10_unchecked() -> B64
  return LLVM::log10[B64](me)

### Raises this value to the power `exp`. Checked: crashes on a non-finite result (overflow -> inf,
### domain error like `(-1)^0.5` -> NaN). Use `pow_unchecked` for raw IEEE 754 propagation.
### NOTE: contrary to mathematical convention (where 0**0 is indeterminate), `0 ** 0 == 1`,
### following the IEEE 754 `pow` definition (which keeps `x ** 0 == 1` for every `x`).
### :param exp: The exponent applied to `me`.
### :returns: `me` raised to `exp` (always finite).
### Raises this value to `exp` with raw IEEE 754 propagation (inf/NaN on overflow/domain).
### :param exp: The exponent applied to `me`.
### :returns: `me` raised to `exp`, possibly ±infinity or NaN.
routine B64.pow_unchecked(exp: B64) -> B64
  return LLVM::pow[B64](me, exp)

### `**` operator: raises this value to `exp`, checked (crashes on non-finite result).
### NOTE: contrary to mathematical convention, `0 ** 0 == 1` (IEEE 754 `pow`).
### :param exp: The exponent applied to `me`.
### :returns: `me` raised to `exp` (always finite).
routine B64.pow!(exp: B64) -> B64
  var r = me.pow_unchecked(exp)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Returns this value with its sign bit replaced by the sign of `sign`.
### :param sign: The value supplying the sign bit.
### :returns: A value with the magnitude of `me` and the sign of `sign`.
routine B64.copysign(sign: B64) -> B64
  return LLVM::copysign[B64](me, sign)

# ============================================================================
# Convenience (recip / angle conversion / integer power / midpoint)
# ============================================================================

### Returns the reciprocal `1 / me` (`±∞` for `±0`, following IEEE rules).
### :returns: The multiplicative inverse.
routine B64.recip() -> B64
  return B64_ONE.truediv_unchecked(me)

### Returns `me` converted from radians to degrees (`me × 180 / π`).
### :returns: The angle in degrees.
routine B64.to_degrees() -> B64
  return me.mul_unchecked(180.0_b64).truediv_unchecked(B64_PI)

### Returns `me` converted from degrees to radians (`me × π / 180`).
### :returns: The angle in radians.
routine B64.to_radians() -> B64
  return me.mul_unchecked(B64_PI).truediv_unchecked(180.0_b64)

### Returns `me` raised to the integer power `n` via exponentiation by squaring.
### A negative `n` inverts the result. Exact for small exponents, unlike `pow` with a float exponent.
### :param n: The integer exponent.
### :returns: `me ** n`.
routine B64.powi(n: S32) -> B64
  var base = if n < 0_s32 then B64_ONE.truediv_unchecked(me) else me
  var count = n.unsigned_abs()
  var result = B64_ONE
  while count > 0_u32
    if count.bitand(1_u32) == 1_u32
      result = result.mul_unchecked(base)
    base = base.mul_unchecked(base)
    count = count.lshr(1_u32)
  return result

### Returns `(me + you) / 2`, computed without intermediate overflow.
### :param you: The other value.
### :returns: The arithmetic midpoint of `me` and `you`.
routine B64.midpoint(you: B64) -> B64
  var lo = B64_MIN_POSITIVE.mul_unchecked(2.0_b64)
  var hi = B64_MAX.truediv_unchecked(2.0_b64)
  var aa = me.abs()
  var ab = you.abs()
  if aa <= hi and ab <= hi
    return me.add_unchecked(you).truediv_unchecked(2.0_b64)
  if aa < lo
    return me.add_unchecked(you.truediv_unchecked(2.0_b64))
  if ab < lo
    return me.truediv_unchecked(2.0_b64).add_unchecked(you)
  return me.truediv_unchecked(2.0_b64).add_unchecked(you.truediv_unchecked(2.0_b64))

# ============================================================================
# Utility Methods
# ============================================================================

### Returns the smaller of this value and `you`.
### :param you: The value to compare against.
### :returns: The lower of the two values under the ordered comparison rules.
routine B64.min(you: B64) -> B64
  return if me <= you then me else you

### Returns the larger of this value and `you`.
### :param you: The value to compare against.
### :returns: The greater of the two values under the ordered comparison rules.
routine B64.max(you: B64) -> B64
  return if me >= you then me else you

### Restricts this value to the closed interval `[min_val, max_val]`.
### :param min_val: The lower bound to enforce.
### :param max_val: The upper bound to enforce.
### :returns: `me` if already in range, otherwise the nearest bound.
@positional
routine B64.clamp(min_val: B64, max_val: B64) -> B64
  return me.min(max_val).max(min_val)

### Returns `true` if this value is strictly positive (greater than zero).
### :returns: `true` if `me > 0.0`.
routine B64.is_positive() -> Bool
  return me > 0.0_b64

### Returns `true` if this value is strictly negative (less than zero).
### :returns: `true` if `me < 0.0`.
routine B64.is_negative() -> Bool
  return me < 0.0_b64

### Returns `true` if this value compares equal to zero.
### :returns: `true` if `me == 0.0`.
routine B64.is_zero() -> Bool
  return me == 0.0_b64

### Returns `true` when this value is neither NaN nor infinity.
### :returns: Whether the value is finite.
routine B64.is_finite() -> Bool
  return not me.is_nan() and not me.is_infinite()

### Returns `true` when this value encodes an IEEE 754 NaN.
### :returns: Whether the bit pattern represents a not-a-number payload.
routine B64.is_nan() -> Bool
  var bits = me.to_bits()
  var exponent = LLVM::bit_and(a: bits, b: 0x7FF0000000000000u64)
  var mantissa = LLVM::bit_and(a: bits, b: 0x000FFFFFFFFFFFFF_u64)
  return exponent == 0x7FF0000000000000u64 and mantissa != 0u64

### Returns `true` when this is a SIGNALING NaN (a NaN whose quiet bit is clear). RazorForge
### arithmetic only ever produces quiet NaN, so this holds only for values from raw bits or
### `signaling_nan()`. `is_nan` stays true for both kinds.
### :returns: Whether the value is a signaling NaN.
routine B64.is_signaling() -> Bool
  return me.is_nan() and LLVM::bit_and(a: me.to_bits(), b: 0x0008000000000000_u64) == 0_u64

### Returns `true` when this value encodes positive or negative infinity.
### :returns: Whether the bit pattern represents an infinity.
routine B64.is_infinite() -> Bool
  var bits = me.to_bits()
  var exponent = LLVM::bit_and(a: bits, b: 0x7FF0000000000000u64)
  var mantissa = LLVM::bit_and(a: bits, b: 0x000FFFFFFFFFFFFF_u64)
  return exponent == 0x7FF0000000000000u64 and mantissa == 0u64

### Returns the sign of this value as `-1.0`, `0.0`, or `1.0`.
### :returns: A unit-sign value describing the sign of `me`.
routine B64.signum() -> B64
  return when
    me > 0.0_b64 => 1.0_b64
    me < 0.0_b64 => -1.0_b64
    else => 0.0_b64

### Reinterprets this float as its raw IEEE 754 bit pattern.
### :returns: The underlying `U64` encoding of this value.
routine B64.to_bits() -> U64
  return LLVM::reinterpret_bits[B64, U64](me)

### Reinterprets a raw IEEE 754 bit pattern as an `B64`.
### :param bits: The exact double-precision encoding to decode.
### :returns: The `B64` value with that bit pattern.
common routine B64.from_bits(bits: U64) -> B64
  return LLVM::reinterpret_bits[U64, B64](bits)

### Returns a signaling NaN (exponent all-ones, quiet bit clear, nonzero payload). For interop /
### testing; RazorForge arithmetic never produces one, and consuming it in checked arithmetic
### crashes.
common routine B64.signaling_nan() -> B64
  return B64.from_bits(bits: 0x7FF0000000000001_u64)

# ============================================================================
# Text Representation and Parsing
# ============================================================================

### Returns the shortest decimal text that reads back as this exact value (`B64!(from_text:)`
### round-trips it bit for bit).
### :returns: The resulting `Text` value.
@override
routine B64.represent() -> Text
  if me.is_signaling()
    return "snan"
  return format_binary_shortest(raw: me.to_bits(), fmt: 0_s32)

### Renders this value to `sig_digits` significant decimal digits with C `%g`
### layout (pure-RF exact-rational conversion).
### :param sig_digits: The number of significant decimal digits (>= 1).
### :returns: The resulting `Text` value.
routine B64.to_text(sig_digits: U64) -> Text
  return format_binary(value: me, sig: sig_digits)

### Renders this value with exactly `places` digits after the point, rounded half to even from its
### exact value (`2.675.fixed(2)` is `2.67`, since the stored double is just below 2.675). The integer
### part is always written out in full, never in exponent form.
### :param places: The number of digits after the point (0 for none).
### :returns: The rendered `Text`.
@readonly
routine B64.fixed(places: U64) -> Text
  return format_binary_fixed(value: me, places: places)

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@override
routine B64.diagnose() -> Text
  return "B64(" + me.represent() + ")"

### Parses a decimal float literal into an `B64`.
### :param from_text: The text to parse. Accepts standard decimal notation and
###   the special values `nan`, `inf`, and `infinity` (case-insensitive, with
###   optional leading sign).
### :returns: The `B64` value parsed from the input.
### :throws: {InvalidValueError} if the text is not a valid float literal.
routine B64!(from_text: Text) -> B64
  var pc = parse_float_components(from_text: from_text, target: "B64")
  if pc.kind == 3_s32
    throw InvalidValueError(input: from_text, target: "B64")
  if pc.kind == 1_s32
    return B64_NAN
  if pc.kind == 2_s32
    if pc.is_neg
      return -B64_INFINITY
    return B64_INFINITY
  return b64_from_ratio(neg: pc.is_neg, digits: pc.digits, dec_exp: pc.dec_exp)

# ============================================================================
# Hashing
# ============================================================================

# ============================================================================
# Byte Representation
# ============================================================================

### Returns the raw bytes of this value in little-endian order.
### :returns: The resulting `Array[Byte, 8]` value.
routine B64.to_bytes_le() -> Array[Byte, 8]
  var raw = LLVM::reinterpret_bits[B64, U64](me)
  var result = Array[Byte, 8]()
  result = LLVM::set_byte_at(array: result, index: 0u64, value: LLVM::int_truncate[U64, U8](raw))
  result = LLVM::set_byte_at(array: result, index: 1_u64, value: LLVM::int_truncate[U64, U8](LLVM::shift_right_unsigned(raw, 8_u64)))
  result = LLVM::set_byte_at(array: result, index: 2_u64, value: LLVM::int_truncate[U64, U8](LLVM::shift_right_unsigned(raw, 16_u64)))
  result = LLVM::set_byte_at(array: result, index: 3_u64, value: LLVM::int_truncate[U64, U8](LLVM::shift_right_unsigned(raw, 24_u64)))
  result = LLVM::set_byte_at(array: result, index: 4_u64, value: LLVM::int_truncate[U64, U8](LLVM::shift_right_unsigned(raw, 32_u64)))
  result = LLVM::set_byte_at(array: result, index: 5_u64, value: LLVM::int_truncate[U64, U8](LLVM::shift_right_unsigned(raw, 40u64)))
  result = LLVM::set_byte_at(array: result, index: 6_u64, value: LLVM::int_truncate[U64, U8](LLVM::shift_right_unsigned(raw, 48_u64)))
  result = LLVM::set_byte_at(array: result, index: 7_u64, value: LLVM::int_truncate[U64, U8](LLVM::shift_right_unsigned(raw, 56_u64)))
  return result

### Returns the raw bytes of this value in big-endian order.
### :returns: The resulting `Array[Byte, 8]` value.
routine B64.to_bytes_be() -> Array[Byte, 8]
  var raw = LLVM::byte_swap(LLVM::reinterpret_bits[B64, U64](me))
  var result = Array[Byte, 8]()
  result = LLVM::set_byte_at(array: result, index: 0u64, value: LLVM::int_truncate[U64, U8](raw))
  result = LLVM::set_byte_at(array: result, index: 1_u64, value: LLVM::int_truncate[U64, U8](LLVM::shift_right_unsigned(raw, 8_u64)))
  result = LLVM::set_byte_at(array: result, index: 2_u64, value: LLVM::int_truncate[U64, U8](LLVM::shift_right_unsigned(raw, 16_u64)))
  result = LLVM::set_byte_at(array: result, index: 3_u64, value: LLVM::int_truncate[U64, U8](LLVM::shift_right_unsigned(raw, 24_u64)))
  result = LLVM::set_byte_at(array: result, index: 4_u64, value: LLVM::int_truncate[U64, U8](LLVM::shift_right_unsigned(raw, 32_u64)))
  result = LLVM::set_byte_at(array: result, index: 5_u64, value: LLVM::int_truncate[U64, U8](LLVM::shift_right_unsigned(raw, 40u64)))
  result = LLVM::set_byte_at(array: result, index: 6_u64, value: LLVM::int_truncate[U64, U8](LLVM::shift_right_unsigned(raw, 48_u64)))
  result = LLVM::set_byte_at(array: result, index: 7_u64, value: LLVM::int_truncate[U64, U8](LLVM::shift_right_unsigned(raw, 56_u64)))
  return result

### Returns a keyed hash of this value using SipHash-2-4.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: The resulting `U64` value.
routine B64.hash(k0: U64, k1: U64) -> U64
  return __secure_hash_u64(v: LLVM::reinterpret_bits[B64, U64](me), k0: k0, k1: k1)

# ============================================================================
# Platform libm (<math.h>) doubles via the runtime's UNIQUELY-NAMED rf_b64_*
# passthroughs (native/runtime/math_functions.c). Unique names are essential: a
# bare `atan`/`cbrt`/... (or a method `x.cbrt()`) resolves to UnpackedFloat's
# same-named 0-arg generic wherever the engine is in scope (a resolver quirk).
# erf/erfc/tgamma/lgamma have no rf_b64_ passthrough but also no UnpackedFloat
# twin, so their bare libm symbols bind fine.
# ============================================================================
### C libm extern (rf_b64_ passthrough): sine (radians).
routine C::rf_b64_sin(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): cosine (radians).
routine C::rf_b64_cos(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): tangent (radians).
routine C::rf_b64_tan(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): arc sine.
routine C::rf_b64_asin(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): arc cosine.
routine C::rf_b64_acos(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): arc tangent.
routine C::rf_b64_atan(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): two-argument arc tangent atan2(y, x).
routine C::rf_b64_atan2(y: B64, x: B64) -> B64
### C libm extern (rf_b64_ passthrough): hyperbolic sine.
routine C::rf_b64_sinh(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): hyperbolic cosine.
routine C::rf_b64_cosh(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): hyperbolic tangent.
routine C::rf_b64_tanh(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): inverse hyperbolic sine.
routine C::rf_b64_asinh(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): inverse hyperbolic cosine.
routine C::rf_b64_acosh(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): inverse hyperbolic tangent.
routine C::rf_b64_atanh(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): square root.
routine C::rf_b64_sqrt(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): cube root.
routine C::rf_b64_cbrt(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): natural exponential e^x.
routine C::rf_b64_exp(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): base-2 exponential 2^x.
routine C::rf_b64_exp2(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): exp(x) - 1, accurate near zero.
routine C::rf_b64_expm1(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): natural logarithm.
routine C::rf_b64_log(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): base-2 logarithm.
routine C::rf_b64_log2(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): base-10 logarithm.
routine C::rf_b64_log10(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): log(1 + x), accurate near zero.
routine C::rf_b64_log1p(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): base raised to exp.
routine C::rf_b64_pow(base: B64, exp: B64) -> B64
### C libm extern (rf_b64_ passthrough): hypotenuse sqrt(x^2 + y^2) without overflow.
routine C::rf_b64_hypot(x: B64, y: B64) -> B64
### C libm extern (rf_b64_ passthrough): fused multiply-add x*y + z with a single rounding.
routine C::rf_b64_fma(x: B64, y: B64, z: B64) -> B64
### C libm extern (bare symbol, no UnpackedFloat twin): error function.
routine C::erf(value: B64) -> B64
### C libm extern (bare symbol): complementary error function.
routine C::erfc(value: B64) -> B64
### C libm extern (bare symbol): gamma function.
routine C::tgamma(value: B64) -> B64
### C libm extern (bare symbol): natural log of the absolute value of gamma.
routine C::lgamma(value: B64) -> B64

# ============================================================================
# B64 libm methods (the C99 doubles B64 didn't already have via LLVM intrinsics),
# delegating to the rf_b64_* runtime passthroughs / bare libm externals above.
# ============================================================================
### exp(me) - 1, accurate near 0. Checked: crashes on overflow. Use `expm1_unchecked` for raw IEEE.
routine B64.expm1!() -> B64
  var r = me.expm1_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### exp(me) - 1 with raw IEEE 754 propagation.
routine B64.expm1_unchecked() -> B64
  return C::rf_b64_expm1(value: me)

### 2 raised to me. Checked: crashes on overflow. Use `exp2_unchecked` for raw IEEE.
routine B64.exp2!() -> B64
  var r = me.exp2_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### 2 raised to me with raw IEEE 754 propagation.
routine B64.exp2_unchecked() -> B64
  return LLVM::exp2[B64](value: me)

### log(1 + me), accurate near 0. Checked: crashes on a non-finite result. Use `log1p_unchecked` for
### raw IEEE.
routine B64.log1p!() -> B64
  var r = me.log1p_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### log(1 + me) with raw IEEE 754 propagation.
routine B64.log1p_unchecked() -> B64
  return C::rf_b64_log1p(value: me)

### Base-2 logarithm. Checked: crashes on a non-finite result. Use `log2_unchecked` for raw IEEE.
routine B64.log2!() -> B64
  var r = me.log2_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Base-2 logarithm with raw IEEE 754 propagation.
routine B64.log2_unchecked() -> B64
  return LLVM::log2[B64](value: me)

### Euclidean distance sqrt(x^2 + y^2). Checked: crashes on overflow. Use `hypot_unchecked` for
### raw IEEE.
### :param x: One leg.
### :param y: The other leg.
routine hypot!(x: B64, y: B64) -> B64
  var r = hypot_unchecked(x: x, y: y)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Euclidean distance with raw IEEE 754 propagation (overflow -> +infinity).
### :param x: One leg.
### :param y: The other leg.
routine hypot_unchecked(x: B64, y: B64) -> B64
  return C::rf_b64_hypot(x: x, y: y)

### 3D Euclidean distance sqrt(x^2 + y^2 + z^2). Checked: crashes on overflow. Use
### `hypot_unchecked` for raw IEEE.
### :param x: First leg.
### :param y: Second leg.
### :param z: Third leg.
routine hypot!(x: B64, y: B64, z: B64) -> B64
  var r = hypot_unchecked(x: x, y: y, z: z)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### 3D Euclidean distance with raw IEEE 754 propagation (overflow -> +infinity). Composed as
### `hypot(hypot(x, y), z)` — overflow-safe, libm has no 3-arg hypot.
### :param x: First leg.
### :param y: Second leg.
### :param z: Third leg.
routine hypot_unchecked(x: B64, y: B64, z: B64) -> B64
  return hypot_unchecked(x: hypot_unchecked(x: x, y: y), y: z)

### Fused multiply-add me*b + c (single rounding). Checked: crashes on overflow. Use `fma_unchecked`
### for raw IEEE.
routine B64.fma!(b: B64, c: B64) -> B64
  var r = me.fma_unchecked(b: b, c: c)
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Fused multiply-add with raw IEEE 754 propagation.
routine B64.fma_unchecked(b: B64, c: B64) -> B64
  return LLVM::fma[B64](a: me, b: b, c: c)

### Cube root.
routine B64.cbrt() -> B64
  return C::rf_b64_cbrt(value: me)

### Tangent (radians).
routine B64.tan() -> B64
  return LLVM::tan[B64](value: me)

### Arc sine. Checked: crashes (domain) if `me` is outside [-1, 1]. Use `asin_unchecked` for raw
### IEEE.
routine B64.asin!() -> B64
  var r = me.asin_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Arc sine with raw IEEE 754 propagation (`|me| > 1` -> NaN).
routine B64.asin_unchecked() -> B64
  return LLVM::asin[B64](value: me)

### Arc cosine. Checked: crashes (domain) if `me` is outside [-1, 1]. Use `acos_unchecked` for raw
### IEEE.
routine B64.acos!() -> B64
  var r = me.acos_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Arc cosine with raw IEEE 754 propagation (`|me| > 1` -> NaN).
routine B64.acos_unchecked() -> B64
  return LLVM::acos[B64](value: me)

### Arc tangent.
routine B64.atan() -> B64
  return LLVM::atan[B64](value: me)

### Two-argument arc tangent atan2(y, x).
### :param y: The y-coordinate.
### :param x: The x-coordinate.
routine atan2(y: B64, x: B64) -> B64
  return LLVM::atan2[B64](a: y, b: x)

### Hyperbolic sine. Checked: crashes on overflow. Use `sinh_unchecked` for raw IEEE.
routine B64.sinh!() -> B64
  var r = me.sinh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Hyperbolic sine with raw IEEE 754 propagation (overflow -> ±infinity).
routine B64.sinh_unchecked() -> B64
  return LLVM::sinh[B64](value: me)

### Hyperbolic cosine. Checked: crashes on overflow. Use `cosh_unchecked` for raw IEEE.
routine B64.cosh!() -> B64
  var r = me.cosh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Hyperbolic cosine with raw IEEE 754 propagation (overflow -> +infinity).
routine B64.cosh_unchecked() -> B64
  return LLVM::cosh[B64](value: me)

### Hyperbolic tangent.
routine B64.tanh() -> B64
  return LLVM::tanh[B64](value: me)

### Inverse hyperbolic sine.
routine B64.asinh() -> B64
  return C::rf_b64_asinh(value: me)

### Inverse hyperbolic cosine. Checked: crashes (domain) if `me < 1`. Use `acosh_unchecked` for raw
### IEEE.
routine B64.acosh!() -> B64
  var r = me.acosh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Inverse hyperbolic cosine with raw IEEE 754 propagation (`me < 1` -> NaN).
routine B64.acosh_unchecked() -> B64
  return C::rf_b64_acosh(value: me)

### Inverse hyperbolic tangent. Checked: crashes if `|me| >= 1` (`±1` -> ±inf, `|me| > 1` -> NaN).
### Use `atanh_unchecked` for raw IEEE.
routine B64.atanh!() -> B64
  var r = me.atanh_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Inverse hyperbolic tangent with raw IEEE 754 propagation (`±1` -> ±inf, `|me| > 1` -> NaN).
routine B64.atanh_unchecked() -> B64
  return C::rf_b64_atanh(value: me)

### Error function.
routine B64.erf() -> B64
  return C::erf(value: me)

### Complementary error function.
routine B64.erfc() -> B64
  return C::erfc(value: me)

### Gamma function. Checked: crashes on a non-finite result (overflow or pole). Use
### `tgamma_unchecked` for raw IEEE.
routine B64.tgamma!() -> B64
  var r = me.tgamma_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Gamma function with raw IEEE 754 propagation (overflow/pole -> ±infinity or NaN).
routine B64.tgamma_unchecked() -> B64
  return C::tgamma(value: me)

### Natural log of |gamma(me)|.
routine B64.lgamma() -> B64
  return C::lgamma(value: me)

# ============================================================================
# Extended libm parity: exp10, sinpi/cospi/tanpi, nextafter, scalbn/ldexp,
# frexp, modf, rint, fdim, fmod, remainder, fmax/fmin, trunc, frac, and
# classification (signbit/is_normal/is_subnormal/fpclassify).
# ============================================================================
### C libm extern (rf_b64_ passthrough): base-10 exponential 10^x.
routine C::rf_b64_exp10(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): sin(pi*x).
routine C::rf_b64_sinpi(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): cos(pi*x).
routine C::rf_b64_cospi(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): tan(pi*x).
routine C::rf_b64_tanpi(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): next representable value after x toward y.
routine C::rf_b64_nextafter(x: B64, y: B64) -> B64
### C libm extern (rf_b64_ passthrough): x * 2^n (C scalbn).
routine C::rf_b64_scalbn(value: B64, n: S64) -> B64
### C libm extern (rf_b64_ passthrough): unbiased radix-2 exponent as an integer (C ilogb).
routine C::rf_b64_ilogb(value: B64) -> S64
### C libm extern (rf_b64_ passthrough): round to nearest integer in the current mode (C rint).
routine C::rf_b64_rint(value: B64) -> B64
### C libm extern (rf_b64_ passthrough): positive difference max(x - y, 0) (C fdim).
routine C::rf_b64_fdim(x: B64, y: B64) -> B64
### C libm extern (rf_b64_ passthrough): floating-point remainder (C fmod).
routine C::rf_b64_fmod(x: B64, y: B64) -> B64
### C libm extern (rf_b64_ passthrough): IEEE remainder, ties to even (C remainder).
routine C::rf_b64_remainder(x: B64, y: B64) -> B64
### C libm extern (rf_b64_ passthrough): larger of x and y (C fmax).
routine C::rf_b64_fmax(x: B64, y: B64) -> B64
### C libm extern (rf_b64_ passthrough): smaller of x and y (C fmin).
routine C::rf_b64_fmin(x: B64, y: B64) -> B64

### Base-10 exponential 10**me. Checked: crashes on overflow. Use `exp10_unchecked` for raw IEEE.
routine B64.exp10!() -> B64
  var r = me.exp10_unchecked()
  if r.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### Base-10 exponential with raw IEEE 754 propagation (overflow -> +infinity).
routine B64.exp10_unchecked() -> B64
  return C::rf_b64_exp10(value: me)

### sin(pi*me), exact at integers/half-integers.
routine B64.sinpi() -> B64
  return C::rf_b64_sinpi(value: me)

### cos(pi*me).
routine B64.cospi() -> B64
  return C::rf_b64_cospi(value: me)

### tan(pi*me).
routine B64.tanpi() -> B64
  return C::rf_b64_tanpi(value: me)

### Next representable value after me toward you.
routine B64.nextafter(you: B64) -> B64
  return C::rf_b64_nextafter(x: me, y: you)

### me * 2^n (C scalbn).
routine B64.scalbn(n: S64) -> B64
  return C::rf_b64_scalbn(value: me, n: n)

### Alias of scalbn (C ldexp).
routine B64.ldexp(n: S64) -> B64
  return C::rf_b64_scalbn(value: me, n: n)

### Rounds to nearest integer in the current rounding mode (C rint).
routine B64.rint() -> B64
  return LLVM::rint[B64](value: me)

### Positive difference max(me - you, 0) (C fdim).
routine B64.fdim(you: B64) -> B64
  return C::rf_b64_fdim(x: me, y: you)

### Floating-point remainder of me/you (C fmod).
routine B64.fmod(you: B64) -> B64
  return LLVM::float_rem[B64](a: me, b: you)

### IEEE remainder of me/you, ties to even (C remainder).
routine B64.remainder(you: B64) -> B64
  return C::rf_b64_remainder(x: me, y: you)

### Larger of me and you (C fmax).
routine B64.fmax(you: B64) -> B64
  return LLVM::maxnum[B64](a: me, b: you)

### Smaller of me and you (C fmin).
routine B64.fmin(you: B64) -> B64
  return LLVM::minnum[B64](a: me, b: you)

### Truncates toward zero (C trunc; alias of int_truncate).
routine B64.trunc() -> B64
  return LLVM::float_truncate[B64](me)

### Fractional part me - trunc(me).
routine B64.frac() -> B64
  return me - LLVM::float_truncate[B64](me)

### Integer and fractional parts (C modf); both carry me's sign.
routine B64.modf() -> (B64, B64)
  var ip = LLVM::float_truncate[B64](me)
  return (ip, me - ip)

### Fraction in [0.5,1) and power-of-two exponent (C frexp).
routine B64.frexp() -> (B64, S64)
  if me.is_zero() or me.is_infinite() or me.is_nan()
    return (me, 0_s64)
  var e = LLVM::add(a: C::rf_b64_ilogb(value: me), b: 1_s64)
  return (C::rf_b64_scalbn(value: me, n: LLVM::sub(a: 0_s64, b: e)), e)

### True if the sign bit is set (C signbit; true for -0 and -NaN).
routine B64.signbit() -> Bool
  return LLVM::int_ne(a: LLVM::bit_and(a: me.to_bits(), b: 0x8000000000000000_u64), b: 0_u64)

### True for a subnormal (denormalized, nonzero) value.
routine B64.is_subnormal() -> Bool
  var bits = me.to_bits()
  var exponent = LLVM::bit_and(a: bits, b: 0x7FF0000000000000_u64)
  var mantissa = LLVM::bit_and(a: bits, b: 0x000FFFFFFFFFFFFF_u64)
  return exponent == 0_u64 and mantissa != 0_u64

### True for a finite, normal value (nonzero and not subnormal).
routine B64.is_normal() -> Bool
  return me.is_finite() and not me.is_zero() and not me.is_subnormal()

### C fpclassify: 0 NaN, 1 infinite, 2 zero, 3 subnormal, 4 normal.
routine B64.fpclassify() -> FpClass
  if me.is_signaling()
    return SIGNALING_NAN
  if me.is_nan()
    return NAN
  if me.is_infinite()
    return INFINITE
  if me.is_zero()
    return ZERO
  if me.is_subnormal()
    return SUBNORMAL
  return NORMAL

# ============================================================================
# IEEE 754 Tier 1 — total ordering predicates
# ============================================================================

### Sign-magnitude total-order key: negatives become small, non-negatives large, so an
### unsigned `<=` reproduces the IEEE 754 totalOrder ranking (-NaN < -inf < ... < +inf < +NaN).
routine b64_order_key(bits: U64) -> U64
  if LLVM::int_ne(a: LLVM::bit_and(a: bits, b: 0x8000000000000000_u64), b: 0_u64)
    return LLVM::bit_xor(a: bits, b: 0xFFFFFFFFFFFFFFFF_u64)
  return LLVM::bit_or(a: bits, b: 0x8000000000000000_u64)

### IEEE 754 totalOrder: a total order over all values including signed zeros and NaNs
### (-NaN < -inf < negatives < -0 < +0 < positives < +inf < +NaN). Never crashes.
### :param you: The value to compare against.
### :returns: Whether `me` precedes or equals `you` in the total order.
routine B64.total_order(you: B64) -> Bool
  return b64_order_key(bits: me.to_bits()) <= b64_order_key(bits: you.to_bits())

### IEEE 754 totalOrderMag: `total_order` applied to the magnitudes (sign bit cleared).
### :param you: The value whose magnitude to compare against.
### :returns: Whether `|me|` precedes or equals `|you|` in the total order.
routine B64.total_order_mag(you: B64) -> Bool
  return LLVM::bit_and(a: me.to_bits(), b: 0x7FFFFFFFFFFFFFFF_u64) <= LLVM::bit_and(a: you.to_bits(), b: 0x7FFFFFFFFFFFFFFF_u64)

# ============================================================================
# IEEE 754 Tier 2 — stepping, exponent extraction, scaling, selection, rounding
# ============================================================================

### IEEE 754 nextUp: the least value greater than `me` (nextUp(+inf)=+inf, nextUp(NaN)=NaN,
### nextUp(maxFinite)=+inf, nextUp(-0)=smallest positive subnormal). Propagating; never crashes.
### :returns: The next representable value toward +infinity.
routine B64.next_up() -> B64
  return me.nextafter(you: B64_INFINITY)

### IEEE 754 nextDown: the greatest value less than `me` (= -nextUp(-me)). Never crashes.
### :returns: The next representable value toward -infinity.
routine B64.next_down() -> B64
  return me.nextafter(you: -B64_INFINITY)

### IEEE 754 logb: the unbiased exponent of `me` as a floating value (logb(0)=-inf, logb(±inf)=+inf,
### logb(NaN)=NaN; otherwise floor(log2|me|)). Propagating; never crashes.
### :returns: The radix-2 exponent of `me`.
routine B64.logb() -> B64
  if me.is_nan()
    return me
  if me.is_infinite()
    return B64_INFINITY
  if me.is_zero()
    return -B64_INFINITY
  return B64(from: C::rf_b64_ilogb(value: me))

### IEEE 754 scaleB: `me * 2^n`, computed without intermediate rounding. Checked: crashes if a
### finite `me` overflows to ±infinity (use `scaleb_unchecked` for raw IEEE propagation).
### :param n: The power-of-two exponent to apply.
### :returns: `me` scaled by `2^n`.
routine B64.scaleb!(n: S64) -> B64
  var r = C::rf_b64_scalbn(value: me, n: n)
  if r.is_finite() or not me.is_finite()
    return r
  if r.is_nan()
    throw NumericDomainError(description: "domain error: no real result")
  throw NumericOverflowError(description: "overflow: out of range")

### `me * 2^n` with raw IEEE 754 propagation (overflow -> ±infinity).
### :param n: The power-of-two exponent to apply.
### :returns: `me` scaled by `2^n`.
routine B64.scaleb_unchecked(n: S64) -> B64
  return C::rf_b64_scalbn(value: me, n: n)

### IEEE 754-2008 minNum: the smaller operand, treating NaN as missing (returns the non-NaN
### operand; NaN only if both are NaN). Never crashes.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, ignoring NaN.
routine B64.min_num(you: B64) -> B64
  return LLVM::minnum[B64](a: me, b: you)

### IEEE 754-2008 maxNum: the larger operand, treating NaN as missing. Never crashes.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, ignoring NaN.
routine B64.max_num(you: B64) -> B64
  return LLVM::maxnum[B64](a: me, b: you)

### IEEE 754-2019 minimum: the smaller operand, propagating NaN, and ordering -0 below +0.
### :param you: The value to compare against.
### :returns: The minimum of `me` and `you`, NaN if either is NaN.
routine B64.minimum(you: B64) -> B64
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  if me == you
    if me.is_zero()
      return if me.signbit() then me else you
    return me
  return if me < you then me else you

### IEEE 754-2019 maximum: the larger operand, propagating NaN, and ordering +0 above -0.
### :param you: The value to compare against.
### :returns: The maximum of `me` and `you`, NaN if either is NaN.
routine B64.maximum(you: B64) -> B64
  if me.is_nan()
    return me
  if you.is_nan()
    return you
  if me == you
    if me.is_zero()
      return if me.signbit() then you else me
    return me
  return if me > you then me else you

### IEEE 754 roundToIntegralTiesToAway: rounds to the nearest integer, halves away from zero
### (round(0.5)=1, round(-2.5)=-3). Exact and never crashes (non-finite inputs pass through).
### :returns: `me` rounded to an integral value with ties away from zero.
routine B64.round_ties_away() -> B64
  if not me.is_finite()
    return me
  var a = me.abs()
  var t = a.trunc()
  var rounded = if a - t >= 0.5_b64 then t + 1.0_b64 else t
  return rounded.copysign(sign: me)
