#@target(os: "linux", "macos")
module Core

### Platform-width C integer FFI types for the LP64 data model (Linux, macOS): C `long` /
### `unsigned long` are 64-bit and `wchar_t` is 32-bit. The Windows (LLP64) widths live in the
### `#@target(os: "windows")` sibling file; conditional compilation selects exactly one per build.

### C `long` (LP64: 64-bit signed).
@llvm("i64")
record CLong
  pass

### C `unsigned long` (LP64: 64-bit unsigned).
@llvm("i64")
record CULong
  pass

### C `wchar_t` (Unix: 32-bit).
@llvm("i32")
record CWChar
  pass

### Widens a C `long` to `S64` (identity on LP64).
@readonly
routine S64(from: CLong) -> S64
  return LLVM::reinterpret_bits[CLong, S64](from)

### Narrows an `S64` to a C `long` (identity on LP64).
@readonly
routine CLong(from: S64) -> CLong
  return LLVM::reinterpret_bits[S64, CLong](from)

### Widens a C `unsigned long` to `U64` (identity on LP64).
@readonly
routine U64(from: CULong) -> U64
  return LLVM::reinterpret_bits[CULong, U64](from)

### Narrows a `U64` to a C `unsigned long` (identity on LP64).
@readonly
routine CULong(from: U64) -> CULong
  return LLVM::reinterpret_bits[U64, CULong](from)

### Widens a C `wchar_t` to a `U32` code unit (identity on Unix).
@readonly
routine U32(from: CWChar) -> U32
  return LLVM::reinterpret_bits[CWChar, U32](from)

### Narrows a `U32` code unit to a C `wchar_t` (identity on Unix).
@readonly
routine CWChar(from: U32) -> CWChar
  return LLVM::reinterpret_bits[U32, CWChar](from)
