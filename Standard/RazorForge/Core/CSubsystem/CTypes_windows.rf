#@target(os: "windows")
module Core

### Platform-width C integer FFI types for the LLP64 data model (Windows): C `long` /
### `unsigned long` are 32-bit and `wchar_t` is 16-bit. The Unix (LP64) widths live in the
### `#@target(os: "linux", "macos")` sibling file; conditional compilation selects exactly one per build.

### C `long` (LLP64: 32-bit signed).
@llvm("i32")
record CLong
  pass

### C `unsigned long` (LLP64: 32-bit unsigned).
@llvm("i32")
record CULong
  pass

### C `wchar_t` (Windows: 16-bit).
@llvm("i16")
record CWChar
  pass

### Widens a C `long` to `S64` (sign-extend, exact).
@readonly
routine S64(from: CLong) -> S64
  return LLVM::sign_extend[CLong, S64](from)

### Narrows an `S64` to a C `long`; fails when the value doesn't fit in 32 bits.
@readonly
routine CLong!(from: S64) -> CLong
  if not (-2147483648s64 <= from <= 2147483647s64)
    throw IntegerOverflowError()
  return LLVM::int_truncate[S64, CLong](from)

### Widens a C `unsigned long` to `U64` (zero-extend, exact).
@readonly
routine U64(from: CULong) -> U64
  return LLVM::zero_extend[CULong, U64](from)

### Narrows a `U64` to a C `unsigned long`; fails when the value doesn't fit in 32 bits.
@readonly
routine CULong!(from: U64) -> CULong
  if from > 4294967295u64
    throw IntegerOverflowError()
  return LLVM::int_truncate[U64, CULong](from)

### Widens a C `wchar_t` to a `U32` code unit (zero-extend, exact).
@readonly
routine U32(from: CWChar) -> U32
  return LLVM::zero_extend[CWChar, U32](from)

### Narrows a `U32` code unit to a C `wchar_t`; fails when the value doesn't fit in 16 bits.
@readonly
routine CWChar!(from: U32) -> CWChar
  if from > 65535u32
    throw IntegerOverflowError()
  return LLVM::int_truncate[U32, CWChar](from)
