module Core

# ============================================================================
# CLong — signed long (platform-dependent)
# ============================================================================

### Represents C `long` on Windows targets.
### The underlying layout matches the platform ABI rather than a fixed language-level width.
@config(target: "windows")
@llvm("i32")
record CLong
  pass

### Represents C `long` on Unix-like targets.
### The underlying layout matches the platform ABI rather than a fixed language-level width.
@config(target: "unix")
@llvm("i64")
record CLong
  pass

# ============================================================================
# Creators (Windows — i32 = S32)
# ============================================================================

### Wraps a Windows `S32` value as `CLong`.
### :param value: The signed value to wrap.
### :returns: The resulting `CLong` value.
@config(target: "windows")
routine CLong.$create(value: S32) -> CLong
  return reinterpret_bits[S32, CLong](value)

# ============================================================================
# Creators (Unix — i64 = S64)
# ============================================================================

### Wraps a Unix `S64` value as `CLong`.
### :param value: The signed value to wrap.
### :returns: The resulting `CLong` value.
@config(target: "unix")
routine CLong.$create(value: S64) -> CLong
  return reinterpret_bits[S64, CLong](value)

# ============================================================================
# Accessors (Windows)
# ============================================================================

### Returns the underlying signed value.
### :returns: The resulting `S32` value.
@config(target: "windows")
@readonly
routine CLong.value() -> S32
  return reinterpret_bits[CLong, S32](me)

# ============================================================================
# Accessors (Unix)
# ============================================================================

### Returns the underlying signed value.
### :returns: The resulting `S64` value.
@config(target: "unix")
@readonly
routine CLong.value() -> S64
  return reinterpret_bits[CLong, S64](me)

# ============================================================================
# Comparison (Windows)
# ============================================================================

### Returns whether both values are equal.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@config(target: "windows")
@readonly
routine CLong.$eq(you: CLong) -> Bool
  return me.value() == you.value()

### Compares this value with the other value.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@config(target: "windows")
@readonly
routine CLong.$cmp(you: CLong) -> ComparisonSign
  return me.value().$cmp(you.value())

# ============================================================================
# Comparison (Unix)
# ============================================================================

### Returns whether both values are equal.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@config(target: "unix")
@readonly
routine CLong.$eq(you: CLong) -> Bool
  return me.value() == you.value()

### Compares this value with the other value.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@config(target: "unix")
@readonly
routine CLong.$cmp(you: CLong) -> ComparisonSign
  return me.value().$cmp(you.value())

# ============================================================================
# Display (Windows)
# ============================================================================

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@config(target: "windows")
routine CLong.$represent() -> Text
  return f"{me.value()}"

### Returns the diagnostic representation of this value.
### :returns: The resulting `Text` value.
@config(target: "windows")
routine CLong.$diagnose() -> Text
  return f"Core.CLong({me.value()})"

# ============================================================================
# Display (Unix)
# ============================================================================

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@config(target: "unix")
routine CLong.$represent() -> Text
  return f"{me.value()}"

### Returns the diagnostic representation of this value.
### :returns: The resulting `Text` value.
@config(target: "unix")
routine CLong.$diagnose() -> Text
  return f"Core.CLong({me.value()})"
