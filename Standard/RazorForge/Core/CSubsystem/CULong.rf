module Core

# ============================================================================
# CULong — unsigned long (platform-dependent)
# ============================================================================

### Represents C `unsigned long` on Windows targets.
### The underlying layout matches the platform ABI rather than a fixed language-level width.
@config(target: "windows")
@llvm("i32")
record CULong
  pass

### Represents C `unsigned long` on Unix-like targets.
### The underlying layout matches the platform ABI rather than a fixed language-level width.
@config(target: "unix")
@llvm("i64")
record CULong
  pass

# ============================================================================
# Creators (Windows — i32 = U32)
# ============================================================================

### Wraps a Windows `U32` value as `CULong`.
### :param value: The unsigned value to wrap.
### :returns: The resulting `CULong` value.
@config(target: "windows")
routine CULong.$create(value: U32) -> CULong
  return reinterpret_bits[U32, CULong](value)

# ============================================================================
# Creators (Unix — i64 = U64)
# ============================================================================

### Wraps a Unix `U64` value as `CULong`.
### :param value: The unsigned value to wrap.
### :returns: The resulting `CULong` value.
@config(target: "unix")
routine CULong.$create(value: U64) -> CULong
  return reinterpret_bits[U64, CULong](value)

# ============================================================================
# Accessors (Windows)
# ============================================================================

### Returns the underlying unsigned value.
### :returns: The resulting `U32` value.
@config(target: "windows")
@readonly
routine CULong.value() -> U32
  return reinterpret_bits[CULong, U32](me)

# ============================================================================
# Accessors (Unix)
# ============================================================================

### Returns the underlying unsigned value.
### :returns: The resulting `U64` value.
@config(target: "unix")
@readonly
routine CULong.value() -> U64
  return reinterpret_bits[CULong, U64](me)

# ============================================================================
# Comparison (Windows)
# ============================================================================

### Returns whether both values are equal.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@config(target: "windows")
@readonly
routine CULong.$eq(you: CULong) -> Bool
  return me.value() == you.value()

### Compares this value with the other value.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@config(target: "windows")
@readonly
routine CULong.$cmp(you: CULong) -> ComparisonSign
  return me.value().$cmp(you.value())

# ============================================================================
# Comparison (Unix)
# ============================================================================

### Returns whether both values are equal.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@config(target: "unix")
@readonly
routine CULong.$eq(you: CULong) -> Bool
  return me.value() == you.value()

### Compares this value with the other value.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@config(target: "unix")
@readonly
routine CULong.$cmp(you: CULong) -> ComparisonSign
  return me.value().$cmp(you.value())

# ============================================================================
# Display (Windows)
# ============================================================================

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@config(target: "windows")
routine CULong.$represent() -> Text
  return f"{me.value()}"

### Returns the diagnostic representation of this value.
### :returns: The resulting `Text` value.
@config(target: "windows")
routine CULong.$diagnose() -> Text
  return f"Core.CULong({me.value()})"

# ============================================================================
# Display (Unix)
# ============================================================================

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@config(target: "unix")
routine CULong.$represent() -> Text
  return f"{me.value()}"

### Returns the diagnostic representation of this value.
### :returns: The resulting `Text` value.
@config(target: "unix")
routine CULong.$diagnose() -> Text
  return f"Core.CULong({me.value()})"
