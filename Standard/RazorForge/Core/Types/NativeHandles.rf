module Core

### Represents an opaque native handle for the runtime big-integer library.
### The handle is pointer-backed and is meaningful only to the integer runtime
### layer.
@llvm("ptr")
record BigIntHandle
  pass

### Returns the raw address stored in this handle.
### This is a low-level runtime integration surface, not a stable user API.
### :returns: The resulting `Address` value.
dangerous routine BigIntHandle.get_address() -> Address
  return pointer_to_int[BigIntHandle, Address](me)

### Reinterprets a raw address as `BigIntHandle`.
### This does not validate ownership or liveness of the pointed runtime object.
### :param from: The address to wrap.
### :returns: The resulting `BigIntHandle` value.
dangerous routine BigIntHandle.$create(from: Address) -> BigIntHandle
  return reinterpret_bits[Hijacked[BigIntHandle], BigIntHandle](int_to_pointer[Address, BigIntHandle](from))

### Returns the null `BigIntHandle` value.
### This sentinel indicates that no live runtime object is associated with the
### handle.
### :returns: The resulting `BigIntHandle` value.
routine bigint_handle_none() -> BigIntHandle
  return BigIntHandle(0_addr)

### Returns `true` when this handle is the null sentinel.
### :returns: The resulting `Bool` value.
@readonly
routine BigIntHandle.is_none() -> Bool
  return int_eq[BigIntHandle](me, bigint_handle_none())

### Represents an opaque native handle for the runtime decimal library.
### The handle is pointer-backed and is meaningful only to the decimal runtime
### layer.
@llvm("ptr")
record BigDecHandle
  pass

### Returns the raw address stored in this handle.
