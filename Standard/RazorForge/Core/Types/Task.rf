module Core

import BuilderService

### Represents an opaque runtime task handle.
### `Task[T]` identifies an asynchronous computation whose eventual result type is `T`.
### The handle itself is pointer-backed and is meaningful to the task runtime rather than to user code as raw memory.
### :typeparam T: The result type associated with the task.
### :see: {Concurrency-Primitives}, {Concurrency-Patterns}
@llvm("ptr")
record Task[T]
  pass

### Returns the raw runtime address stored by this task handle.
### This is a low-level escape hatch for runtime integration and should not be
### treated as a user-stable identifier.
### :returns: The resulting `Address` value.
dangerous routine Task[T].get_address() -> Address
  return pointer_to_int[Task[T], Address](me)

### Reinterprets a raw address as `Task[T]`.
### This does not validate that the address actually refers to a live task of
### the requested result type.
### :param from: The task runtime address to wrap.
### :returns: The resulting `Task[T]` value.
dangerous routine Task[T].$create(from: Address) -> Task[T]
  return reinterpret_bits[Hijacked[Task[T]], Task[T]](int_to_pointer[Address, Task[T]](from))

### Returns the null task handle.
### This is the task-handle equivalent of an absent pointer value.
### :returns: The resulting `Task[T]` value.
routine task_none[T]() -> Task[T]
  return Task[T](0_addr)

### Returns `true` when this task handle is the null sentinel.
### :returns: The resulting `Bool` value.
@readonly
routine Task[T].is_none() -> Bool
  return int_eq[Task[T]](me, task_none[T]())

### Returns the runtime task id associated with this handle.
### This identifier is suitable for diagnostics and runtime coordination, not
### for reconstructing a task handle.
### :returns: The resulting `U64` value.
@readonly
routine Task[T].id() -> U64
  danger!
    return rf_task_id(me.get_address())

### Returns the display form of this task handle.
### The display form intentionally keeps output concise and type-oriented.
### :returns: The resulting `Text` value.
@readonly
routine Task[T].$represent() -> Text
  return me.type_name()

### Returns the diagnostic form of this task handle.
### This includes the runtime task id so logs can distinguish between handles of
### the same type.
### :returns: The resulting `Text` value.
@readonly
routine Task[T].$diagnose() -> Text
  return me.full_type_name() + "(id: " + me.id().$represent() + ")"
