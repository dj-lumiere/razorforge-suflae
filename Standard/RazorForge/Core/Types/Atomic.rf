module Core

### Lock-free atomic wrapper for primitive integer and pointer types.
### Provides sequentially consistent atomic load/store/RMW operations on the
### inner value. Use for shared counters (e.g. `ImmutableSharedController.strong_count`)
### and lock-free protocols.
### :typeparam T: The atomic-capable inner type (integer or pointer-sized).
record Atomic[T] obeys Assignable
  ### The atomically accessed storage cell.
  secret value: T

### Creates a new atomic with the given initial value.
### :param initial: The starting value for the atomic cell.
### :returns: The resulting `Atomic[T]` value.
routine Atomic[T].$create(initial: T) -> ?Atomic[T]
  return Atomic[T](value: initial)

### Returns a bitwise duplicate of this atomic.
### Copying duplicates the cell — the new and old atomics are independent.
### :returns: A bitwise duplicate of this value.
@[readonly, inline]
routine Atomic[T].$copy() -> Me
  return Atomic[T](value: me.value)

### Atomically loads the current value with sequentially consistent ordering.
### :returns: The value currently stored in the atomic cell.
@readonly
dangerous routine Atomic[T].load() -> ?T
  return atomic_load[T](ptr: me.value.hijack())

### Atomically stores `new_value` with sequentially consistent ordering.
### :param new_value: The value to write into the cell.
dangerous routine Atomic[T].store(new_value: T)
  atomic_store[T](ptr: me.value.hijack(), value: new_value)
  return

### Atomically replaces the cell with `new_value` and returns the previous value.
### :param new_value: The replacement value to install.
### :returns: The value stored before the exchange.
dangerous routine Atomic[T].exchange(new_value: T) -> ?T
  return atomic_exchange[T](ptr: me.value.hijack(), value: new_value)

### Atomically adds `delta` and returns the value stored before the addition.
### :param delta: The increment to apply.
### :returns: The value stored before the addition.
dangerous routine Atomic[T].fetch_add(delta: T) -> ?T
  return atomic_add[T](ptr: me.value.hijack(), value: delta)

### Atomically subtracts `delta` and returns the value stored before the subtraction.
### :param delta: The decrement to apply.
### :returns: The value stored before the subtraction.
dangerous routine Atomic[T].fetch_sub(delta: T) -> ?T
  return atomic_sub[T](ptr: me.value.hijack(), value: delta)

### Atomically performs bitwise AND with `mask` and returns the previous value.
### :param mask: The bitmask to apply.
### :returns: The value stored before the update.
dangerous routine Atomic[T].fetch_and(mask: T) -> ?T
  return atomic_and[T](ptr: me.value.hijack(), value: mask)

### Atomically performs bitwise OR with `mask` and returns the previous value.
### :param mask: The bitmask to apply.
### :returns: The value stored before the update.
dangerous routine Atomic[T].fetch_or(mask: T) -> ?T
  return atomic_or[T](ptr: me.value.hijack(), value: mask)

### Atomically performs bitwise XOR with `mask` and returns the previous value.
### :param mask: The bitmask to apply.
### :returns: The value stored before the update.
dangerous routine Atomic[T].fetch_xor(mask: T) -> ?T
  return atomic_xor[T](ptr: me.value.hijack(), value: mask)

### Compares the current value against `expected`; if equal, replaces it with
### `desired`. Returns a tuple of the previously observed value and a success flag.
### :param expected: The value that must currently be present for the swap to succeed.
### :param desired: The replacement value to write on success.
### :returns: `(prev_value, success)` — `prev_value` is the value observed in the
###          cell; `success` is `true` when `prev_value == expected` and the
###          replacement occurred.
dangerous routine Atomic[T].compare_and_exchange(expected: T, desired: T) -> (T, Bool)
  return atomic_compare_and_exchange[T](ptr: me.value.hijack(), expected: expected, desired: desired)