module Core

### Represents a single atomically accessible storage cell.
### All routines on `Atomic[T]` use sequentially consistent ordering, so each
### operation participates in the strongest ordering guarantee RazorForge
### exposes for lock-free shared state.
### :typeparam T: The atomic-capable value type stored in the cell.
record Atomic[T]
needs T obeys AtomicType
  ### Stores the raw value accessed by the atomic intrinsics.
  ### Callers should treat this slot as implementation detail and use the
  ### atomic routines on `Atomic[T]` rather than reading or writing it directly.
  secret value: T

### Creates an atomic cell initialized with `initial`.
### Use this creator when a value must be shared across tasks without wrapping
### every access in an external lock.
### :param initial: The value visible to the first `load`.
### :returns: A new `Atomic[T]` containing `initial`.
routine Atomic[T].$create(initial: T) -> Atomic[T]
  return Atomic[T](value: initial)

### Loads the current value from this cell.
### The returned value is a sequentially consistent snapshot, so callers can
### use it as a synchronization point relative to other atomic operations.
### :returns: The value observed at the instant of the load.
routine Atomic[T].load() -> T
  # SAFETY: Atomic load with seq_cst ordering
  # Ensures proper synchronization across threads
  return atomic_load[T](me.value.get_address())

### Stores `new_value` into this cell.
### The write is published with sequentially consistent ordering, so later
### atomic loads from other tasks observe it in a globally ordered history.
### :param new_value: The replacement value to publish.
routine Atomic[T].store(new_value: T)
  # SAFETY: Atomic store with seq_cst ordering
  # Ensures proper synchronization across threads
  atomic_store[T](me.value.get_address(), new_value)
  return

### Replaces the stored value and returns the previous one.
### This is useful when the old state matters, such as taking ownership of a
### flag or exchanging handles between cooperating tasks.
### :param new_value: The value to install atomically.
### :returns: The value that was stored before the swap.
routine Atomic[T].swap(new_value: T) -> T
  # SAFETY: Atomic swap with seq_cst ordering
  return atomic_xchg[T](me.value.get_address(), new_value)

### Attempts to replace the stored value only when it currently equals `expected`.
### This is the standard compare-and-swap primitive used to build lock-free
### state machines and retry loops.
### :param expected: The value that must already be present for the exchange to succeed.
### :param desired: The value to store when the comparison succeeds.
### :returns: `true` when `desired` was written, or `false` when the cell held a different value.
routine Atomic[T].compare_exchange(expected: T, desired: T) -> Bool
  # SAFETY: Atomic compare-exchange with seq_cst ordering
  # Returns true if successful, false otherwise
  return atomic_cmpxchg[T](
    me.value.get_address(),
    expected,
    desired
  )

### Adds `delta` to the stored integer and returns the previous value.
### `fetch_add` is typically used for counters, ticket allocation, and other
### monotonic state that must be updated without races.
### :param delta: The signed or unsigned increment to apply atomically.
### :returns: The value that was stored before the addition.
routine Atomic[T].fetch_add(delta: T) -> T
  # SAFETY: Atomic fetch-add with seq_cst ordering
  # Hardware guarantees atomicity for supported integer types
  return atomic_add[T](me.value.get_address(), delta)

### Subtracts `delta` from the stored integer and returns the previous value.
### :param delta: The amount to subtract atomically.
### :returns: The value that was stored before the subtraction.
routine Atomic[T].fetch_sub(delta: T) -> T
  # SAFETY: Atomic fetch-sub with seq_cst ordering
  # Hardware guarantees atomicity for supported integer types
  return atomic_sub[T](me.value.get_address(), delta)

### Applies a bitwise AND with `mask` and returns the previous value.
### This is commonly used to clear feature flags or state bits without losing
### concurrent updates to unrelated bits.
### :param mask: The bit mask applied to the stored integer.
### :returns: The value that was stored before the update.
routine Atomic[T].fetch_and(mask: T) -> T
  # SAFETY: Atomic fetch-and with seq_cst ordering
  return atomic_and[T](me.value.get_address(), mask)

### Applies a bitwise OR with `mask` and returns the previous value.
### :param mask: The bit mask whose set bits are merged into the stored integer.
### :returns: The value that was stored before the update.
routine Atomic[T].fetch_or(mask: T) -> T
  # SAFETY: Atomic fetch-or with seq_cst ordering
  return atomic_or[T](me.value.get_address(), mask)

### Applies a bitwise XOR with `mask` and returns the previous value.
### :param mask: The bit mask used to toggle bits atomically.
### :returns: The value that was stored before the update.
routine Atomic[T].fetch_xor(mask: T) -> T
  # SAFETY: Atomic fetch-xor with seq_cst ordering
  return atomic_xor[T](me.value.get_address(), mask)

### Increments the stored integer by one and returns the previous value.
### :returns: The value that was stored before the increment.
routine Atomic[T].fetch_inc() -> T
  return me.fetch_add(1)

### Decrements the stored integer by one and returns the previous value.
### :returns: The value that was stored before the decrement.
routine Atomic[T].fetch_dec() -> T
  return me.fetch_sub(1)
