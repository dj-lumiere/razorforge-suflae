module Core

# xxHash64 primes used by the helper mix functions below.
preset XX_PRIME1: U64 = 11400714785074694791_u64
preset XX_PRIME2: U64 = 14029467366897019727_u64
preset XX_PRIME3: U64 = 1609587929392839161_u64
preset XX_PRIME4: U64 = 9650029242287828579_u64

### Hashes a single 64-bit value using the xxHash64 leaf-mix step.
### This helper is intended for per-field hashing before those field hashes are
### folded into a larger aggregate hash.
secret routine __hash_leaf(v: U64) -> U64
  var a = LLVM::mul(v, XX_PRIME3)
  var b = LLVM::bit_or(LLVM::shift_left(a, 27_u64), LLVM::shift_right_unsigned(a, 37_u64))
  var c = LLVM::mul(b, XX_PRIME1)
  return LLVM::add(c, XX_PRIME4)

### Folds one field hash into an accumulator using the xxHash64 round step.
### Repeated application of this helper produces the rolling state used for
### record and tuple hashing.
secret routine __hash_round(acc: U64, h: U64) -> U64
  var a = LLVM::add(acc, LLVM::mul(h, XX_PRIME2))
  var b = LLVM::bit_or(LLVM::shift_left(a, 31_u64), LLVM::shift_right_unsigned(a, 33_u64))
  return LLVM::mul(b, XX_PRIME1)

### Applies the xxHash64 avalanche finalization to an accumulator.
### Finalization should be performed after all fields have been folded into the
### accumulator.
secret routine __hash_finalize(h: U64) -> U64
  var a = LLVM::bit_xor(h, LLVM::shift_right_unsigned(h, 33_u64))
  var b = LLVM::mul(a, XX_PRIME2)
  var c = LLVM::bit_xor(b, LLVM::shift_right_unsigned(b, 29_u64))
  var d = LLVM::mul(c, XX_PRIME3)
  return LLVM::bit_xor(d, LLVM::shift_right_unsigned(d, 32_u64))

### Hashes a 128-bit value by splitting into two U64 rounds.
### This helper preserves all input bits while still producing the standard
### 64-bit hash output used by the runtime.
secret routine __hash_u128(v: U128) -> U64
  var lo = LLVM::int_truncate[U128, U64](v)
  var hi = LLVM::int_truncate[U128, U64](LLVM::shift_right_unsigned(v, 64_u128))
  var acc = __hash_round(acc: 0u64, h: lo)
  acc = __hash_round(acc: acc, h: hi)
  return __hash_finalize(h: acc)
