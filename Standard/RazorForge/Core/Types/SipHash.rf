module Core

# SipHash-2-4 initialization constants — "SipHash" magic in ASCII, big-endian.
# 0x736f6d6570736575 / 0x646f72616e646f6d / 0x6c7967656e657261 / 0x7465646279746573
preset SIP_C0: U64 = 8317987319222330741_u64
preset SIP_C1: U64 = 7237128888997146477_u64
preset SIP_C2: U64 = 7816392313619706465_u64
preset SIP_C3: U64 = 8387110413943045723_u64

### Internal state for a SipHash-2-4 computation.
### Holds four 64-bit words that are updated by each SipRound.
record SipState
  ### First 64-bit state word.
  v0: U64
  ### Second 64-bit state word.
  v1: U64
  ### Third 64-bit state word.
  v2: U64
  ### Fourth 64-bit state word.
  v3: U64

### Applies one SipRound to the state; returns the updated state.
secret routine SipState.round() -> SipState
  var v0 = LLVM::add(me.v0, me.v1)
  var v1 = LLVM::bit_or(LLVM::shift_left(me.v1, 13_u64), LLVM::shift_right_unsigned(me.v1, 51_u64))
  v1 = LLVM::bit_xor(v1, v0)
  v0 = LLVM::bit_or(LLVM::shift_left(v0, 32_u64), LLVM::shift_right_unsigned(v0, 32_u64))
  var v2 = LLVM::add(me.v2, me.v3)
  var v3 = LLVM::bit_or(LLVM::shift_left(me.v3, 16_u64), LLVM::shift_right_unsigned(me.v3, 48_u64))
  v3 = LLVM::bit_xor(v3, v2)
  v0 = LLVM::add(v0, v3)
  v3 = LLVM::bit_or(LLVM::shift_left(v3, 21_u64), LLVM::shift_right_unsigned(v3, 43_u64))
  v3 = LLVM::bit_xor(v3, v0)
  v2 = LLVM::add(v2, v1)
  v1 = LLVM::bit_or(LLVM::shift_left(v1, 17_u64), LLVM::shift_right_unsigned(v1, 47_u64))
  v1 = LLVM::bit_xor(v1, v2)
  v2 = LLVM::bit_or(LLVM::shift_left(v2, 32_u64), LLVM::shift_right_unsigned(v2, 32_u64))
  return SipState(v0: v0, v1: v1, v2: v2, v3: v3)

### Initializes SipHash state from k0/k1.
secret routine __sip_init(k0: U64, k1: U64) -> SipState
  return SipState(
    v0: LLVM::bit_xor(k0, SIP_C0),
    v1: LLVM::bit_xor(k1, SIP_C1),
    v2: LLVM::bit_xor(k0, SIP_C2),
    v3: LLVM::bit_xor(k1, SIP_C3)
  )

### Compresses one 64-bit block into state (2 SipRounds).
secret routine __sip_compress(state: SipState, m: U64) -> SipState
  var s = SipState(v0: state.v0, v1: state.v1, v2: state.v2, v3: LLVM::bit_xor(state.v3, m))
  s = s.round()
  s = s.round()
  return SipState(v0: LLVM::bit_xor(s.v0, m), v1: s.v1, v2: s.v2, v3: s.v3)

### Applies the SipHash-2-4 finalization (4 SipRounds); returns the 64-bit digest.
secret routine __sip_finalize(state: SipState) -> U64
  var s = SipState(v0: state.v0, v1: state.v1, v2: LLVM::bit_xor(state.v2, 255_u64), v3: state.v3)
  s = s.round()
  s = s.round()
  s = s.round()
  s = s.round()
  return LLVM::bit_xor(LLVM::bit_xor(LLVM::bit_xor(s.v0, s.v1), s.v2), s.v3)

### Secure-hashes a single 64-bit value via SipHash-2-4.
secret routine __secure_hash_u64(v: U64, k0: U64, k1: U64) -> U64
  var s = __sip_init(k0: k0, k1: k1)
  # Single 8-byte block; SipHash encodes total byte count in the top byte of the last block.
  var last = LLVM::bit_or(LLVM::shift_left(8_u64, 56_u64), v)
  s = __sip_compress(state: s, m: last)
  return __sip_finalize(state: s)

### Secure-hashes a 128-bit value by processing it as two 64-bit blocks.
secret routine __secure_hash_u128(v: U128, k0: U64, k1: U64) -> U64
  var lo = LLVM::int_truncate[U128, U64](v)
  var hi = LLVM::int_truncate[U128, U64](LLVM::shift_right_unsigned(v, 64_u128))
  var s = __sip_init(k0: k0, k1: k1)
  s = __sip_compress(state: s, m: lo)
  var last = LLVM::bit_or(LLVM::shift_left(16_u64, 56_u64), hi)
  s = __sip_compress(state: s, m: last)
  return __sip_finalize(state: s)

# ============================================================================
# Hashing
# ============================================================================

### Returns a SipHash-2-4 keyed hash of this SipHash state.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash suitable for denial-of-service-resistant hash tables.
routine SipState.hash(k0: U64, k1: U64) -> U64
  var acc = __hash_round(acc: 0u64, h: __secure_hash_u64(v: me.v0, k0: k0, k1: k1))
  acc = __hash_round(acc: acc, h: __secure_hash_u64(v: me.v1, k0: k0, k1: k1))
  acc = __hash_round(acc: acc, h: __secure_hash_u64(v: me.v2, k0: k0, k1: k1))
  acc = __hash_round(acc: acc, h: __secure_hash_u64(v: me.v3, k0: k0, k1: k1))
  return __hash_finalize(h: acc)
