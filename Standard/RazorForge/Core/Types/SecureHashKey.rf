module Core

### Represents a 128-bit keyed-hash seed for secure hash tables.
### `SecureHashKey` is used by `SecureSet` and `SecureDict` to randomize
### SipHash state per table instance and reduce collision-based attacks.
record SecureHashKey
  ### Stores the first 64-bit SipHash key word.
  k0: U64
  ### Stores the second 64-bit SipHash key word.
  k1: U64

### Generates a fresh key from OS entropy (BCryptGenRandom / getrandom).
### Each generated key is suitable for seeding an independent secure hash table
### instance.
### :returns: The resulting `SecureHashKey` value.
common routine SecureHashKey.random() -> SecureHashKey
  return SecureHashKey(k0: rf_random_u64(), k1: rf_random_u64())
