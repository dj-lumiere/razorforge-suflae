module Core

### Represents the zero-sized placeholder value.
### `Blank` is used where an explicit unit-like value is needed to signal
### "there is no meaningful payload here" while still remaining type-safe.
@llvm("void")
record Blank
  pass

# ============================================================================
# Text Representation
# ============================================================================

### Returns the display form of `Blank`.
### :returns: The resulting `Text` value.
@readonly
routine Blank.$represent() -> ?Text
  return "Blank"

### Returns the diagnostic form of `Blank`.
### For this type, the display and diagnostic forms are identical.
### :returns: The resulting `Text` value.
@readonly
routine Blank.$diagnose() -> ?Text
  return "Blank"
