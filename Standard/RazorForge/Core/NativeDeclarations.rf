module Core

# ============================================================================
# Memory Management
# ============================================================================

### Initializes the RazorForge runtime.
### This routine must run before runtime services that depend on global runtime state.
external("C") routine rf_runtime_init()

### Hardware 128/64 -> 64 unsigned divide: computes (hi:lo) / d, returns the quotient
### and writes the remainder through `rem`. PRECONDITION: hi < d (so the 64-bit quotient
### cannot overflow). The base-2^64 estimation primitive for Knuth-D wide division — one
### x86-64 `DIV r64` (or MSVC `_udiv128`), with a portable fallback on arm64/wasm.
### :param hi: High 64 bits of the dividend.
### :param lo: Low 64 bits of the dividend.
### :param d: The 64-bit divisor (must exceed `hi`).
### :param rem: Pointer to a `U64` slot that receives the remainder.
### :returns: The 64-bit quotient.
dangerous external("C") routine rf_udivrem_128_64(hi: U64, lo: U64, d: U64, rem: Hijacked[U64]) -> U64
### Allocates zero-initialized dynamic memory.
### :param size: The number of bytes to allocate.
### :returns: The resulting `Address` value.
dangerous external("C") routine rf_allocate_dynamic(size: U64) -> Address
### Allocates zero-initialized dynamic memory.
### :param size: The number of bytes to allocate.
### :returns: The resulting `Address` value.
dangerous routine rf_allocate_dynamic(size: ByteSize) -> Address
  return rf_allocate_dynamic(size: size.byte_size())
### Returns uninitialized dynamic memory — caller must write before reading.
### :param size: The byte count to allocate.
### :returns: The resulting `Address` value.
dangerous external("C") routine rf_allocate_dynamic_uninit(size: U64) -> Address
### Returns uninitialized dynamic memory — caller must write before reading.
### :param size: The byte count to allocate.
### :returns: The resulting `Address` value.
dangerous routine rf_allocate_dynamic_uninit(size: ByteSize) -> Address
  return rf_allocate_dynamic_uninit(size: size.byte_size())
### Reallocates a dynamic memory block to a new size.
### :param ptr: The existing allocation to resize.
### :param size: The new allocation size in bytes.
### :returns: The resulting `Address` value.
dangerous external("C") routine rf_reallocate_dynamic(ptr: Address, size: U64) -> Address
### Reallocates a dynamic memory block to a new size.
### :param ptr: The existing allocation to resize.
### :param size: The new allocation size.
### :returns: The resulting `Address` value.
dangerous routine rf_reallocate_dynamic(ptr: Address, size: ByteSize) -> Address
  return rf_reallocate_dynamic(ptr: ptr, size: size.byte_size())
### Frees a dynamic memory block previously returned by the runtime allocator.
### :param ptr: The allocation to release.
dangerous external("C") routine rf_invalidate(ptr: Address)

# ============================================================================
# Threaded tasks (v0.1 concurrency)
# ============================================================================

### Creates a task control block. `kind` is 1 for an OS thread (RF_TASK_THREADED).
### :returns: The `rf_task*` handle as an `Address` (null on allocation failure).
dangerous external("C") routine rf_task_create(kind: U32) -> Address
### Spawns an OS thread running `entry(task, userdata)`.
### :returns: 0 on success, non-zero on failure.
dangerous external("C") routine rf_task_spawn_threaded(task: Address, entry: Address, userdata: Address) -> S32
### Blocks until the task completes. :returns: the completion kind (1 = value).
dangerous external("C") routine rf_task_wait(task: Address) -> S32
### Blocks until the task completes or the deadline elapses.
### :returns: the completion kind (1 = value, 4 = timeout).
dangerous external("C") routine rf_task_wait_within(task: Address, secs: S64, ns: U32) -> S32
### :returns: the boxed result payload pointer set by the task's entry thunk.
dangerous external("C") routine rf_task_result_payload(task: Address) -> Address
### Releases a task control block.
dangerous external("C") routine rf_task_destroy(task: Address)
### Opaque, stable identifier for the calling OS thread (lock re-entrancy detection). Safe: takes
### no pointers and only reads the OS thread id. :returns: a per-thread id, equal across calls on
### the same thread.
external("C") routine rf_current_thread_id() -> U64
### Copies `size` bytes from `src` to `dest`.
### :param dest: The destination location.
### :param src: The source location.
### :param size: The number of bytes to copy.
dangerous external("C") routine rf_copy_bytes_at(dest: Address, src: Address, size: U64)
### Copies `size` bytes from `src` to `dest`.
### :param dest: The destination location.
### :param src: The source location.
### :param size: The number of bytes to copy.
dangerous routine rf_copy_bytes_at(dest: Address, src: Address, size: ByteSize)
  rf_copy_bytes_at(dest: dest, src: src, size: size.byte_size())
  return
### Fills `size` bytes at `dest` with `value`.
### :param dest: The destination location.
### :param value: The byte value to write.
### :param size: The number of bytes to set.
dangerous external("C") routine rf_set_bytes_at(dest: Address, value: U8, size: U64)
### Fills `size` bytes at `dest` with `value`.
### :param dest: The destination location.
### :param value: The byte value to write.
### :param size: The number of bytes to set.
dangerous routine rf_set_bytes_at(dest: Address, value: U8, size: ByteSize)
  rf_set_bytes_at(dest: dest, value: value, size: size.byte_size())
  return


# ============================================================================
# F128 (Quadruple Precision) - LibBF Runtime
#
# ABI note: the C runtime represents F128 as a 16-byte `f128_t` struct, whose
# by-value call ABI does not match the scalar `fp128` ABI RazorForge emits
# for `F128` parameters and returns. All bridges below therefore take F128
# inputs as (low, high) `U64` pairs and write F128 results through an
# `out: Hijacked[F128]` pointer — both forms are ABI-stable everywhere.
# ============================================================================

### Returns the sine of an `F128` value interpreted as radians.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_sin_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns the cosine of an `F128` value interpreted as radians.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_cos_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns the tangent of an `F128` value interpreted as radians.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_tan_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns the inverse sine of an `F128` value.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_asin_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns the inverse cosine of an `F128` value.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_acos_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns the inverse tangent of an `F128` value.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_atan_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns the quadrant-aware angle of the point `(x, y)`.
### :param y_low: The low 64 bits of the y-coordinate.
### :param y_high: The high 64 bits of the y-coordinate.
### :param x_low: The low 64 bits of the x-coordinate.
### :param x_high: The high 64 bits of the x-coordinate.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_atan2_parts(y_low: U64, y_high: U64, x_low: U64, x_high: U64, out: Hijacked[F128])

### Returns the hyperbolic sine of an `F128` value.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_sinh_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns the hyperbolic cosine of an `F128` value.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_cosh_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns the hyperbolic tangent of an `F128` value.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_tanh_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns the inverse hyperbolic sine of an `F128` value.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_asinh_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns the inverse hyperbolic cosine of an `F128` value.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_acosh_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns the inverse hyperbolic tangent of an `F128` value.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_atanh_parts(low: U64, high: U64, out: Hijacked[F128])

### Returns `e` raised to an `F128` value.
### :param low: The low 64 bits of the exponent.
### :param high: The high 64 bits of the exponent.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_exp_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns `2` raised to an `F128` value.
### :param low: The low 64 bits of the exponent.
### :param high: The high 64 bits of the exponent.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_exp2_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns `exp(value) - 1` with high precision for small inputs.
### :param low: The low 64 bits of the exponent.
### :param high: The high 64 bits of the exponent.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_expm1_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns the natural logarithm of an `F128` value.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_log_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns the base-2 logarithm of an `F128` value.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_log2_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns the base-10 logarithm of an `F128` value.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_log10_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns `log(1 + value)` with high precision for small inputs.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_log1p_parts(low: U64, high: U64, out: Hijacked[F128])

### Raises an `F128` base to an `F128` exponent.
### :param base_low: The low 64 bits of the base value.
### :param base_high: The high 64 bits of the base value.
### :param exp_low: The low 64 bits of the exponent value.
### :param exp_high: The high 64 bits of the exponent value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_pow_parts(base_low: U64, base_high: U64, exp_low: U64, exp_high: U64, out: Hijacked[F128])
### Returns the real cube root of an `F128` value.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_cbrt_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns the Euclidean length of the vector `(x, y)`.
### :param x_low: The low 64 bits of the x-coordinate.
### :param x_high: The high 64 bits of the x-coordinate.
### :param y_low: The low 64 bits of the y-coordinate.
### :param y_high: The high 64 bits of the y-coordinate.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_hypot_parts(x_low: U64, x_high: U64, y_low: U64, y_high: U64, out: Hijacked[F128])
### Returns `value` with its sign copied from `sign`.
### :param value_low: The low 64 bits of the magnitude source.
### :param value_high: The high 64 bits of the magnitude source.
### :param sign_low: The low 64 bits of the sign source.
### :param sign_high: The high 64 bits of the sign source.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_copysign_parts(value_low: U64, value_high: U64, sign_low: U64, sign_high: U64, out: Hijacked[F128])

# ----------------------------------------------------------------------------
# F128 core operations. F128 carries its bits as an LLVM i128 (never fp128),
# so arithmetic, comparison, conversion and rounding all route through these
# bridges instead of native LLVM float instructions.
# ----------------------------------------------------------------------------

### Returns the sum `a + b` of two `F128` values.
### :param a_low: The low 64 bits of the left operand.
### :param a_high: The high 64 bits of the left operand.
### :param b_low: The low 64 bits of the right operand.
### :param b_high: The high 64 bits of the right operand.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_add_parts(a_low: U64, a_high: U64, b_low: U64, b_high: U64, out: Hijacked[F128])
### Returns the difference `a - b` of two `F128` values.
### :param a_low: The low 64 bits of the left operand.
### :param a_high: The high 64 bits of the left operand.
### :param b_low: The low 64 bits of the right operand.
### :param b_high: The high 64 bits of the right operand.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_sub_parts(a_low: U64, a_high: U64, b_low: U64, b_high: U64, out: Hijacked[F128])
### Returns the product `a * b` of two `F128` values.
### :param a_low: The low 64 bits of the left operand.
### :param a_high: The high 64 bits of the left operand.
### :param b_low: The low 64 bits of the right operand.
### :param b_high: The high 64 bits of the right operand.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_mul_parts(a_low: U64, a_high: U64, b_low: U64, b_high: U64, out: Hijacked[F128])
### Returns the quotient `a / b` of two `F128` values.
### :param a_low: The low 64 bits of the left operand.
### :param a_high: The high 64 bits of the left operand.
### :param b_low: The low 64 bits of the right operand.
### :param b_high: The high 64 bits of the right operand.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_div_parts(a_low: U64, a_high: U64, b_low: U64, b_high: U64, out: Hijacked[F128])
### Returns the square root of an `F128` value.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_sqrt_parts(low: U64, high: U64, out: Hijacked[F128])
### Rounds an `F128` value toward negative infinity.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_floor_parts(low: U64, high: U64, out: Hijacked[F128])
### Rounds an `F128` value toward positive infinity.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_ceil_parts(low: U64, high: U64, out: Hijacked[F128])
### Rounds an `F128` value to the nearest integer, ties away from zero.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_round_parts(low: U64, high: U64, out: Hijacked[F128])
### Discards the fractional part of an `F128` value (rounds toward zero).
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f128_trunc_parts(low: U64, high: U64, out: Hijacked[F128])
### Returns whether two `F128` values compare equal (IEEE: false for NaN).
### :param a_low: The low 64 bits of the left operand.
### :param a_high: The high 64 bits of the left operand.
### :param b_low: The low 64 bits of the right operand.
### :param b_high: The high 64 bits of the right operand.
### :returns: `1` when equal, `0` otherwise.
external("C") routine rf_f128_eq_parts(a_low: U64, a_high: U64, b_low: U64, b_high: U64) -> S32
### Returns whether `a < b` (IEEE ordered: false when either is NaN).
### :param a_low: The low 64 bits of the left operand.
### :param a_high: The high 64 bits of the left operand.
### :param b_low: The low 64 bits of the right operand.
### :param b_high: The high 64 bits of the right operand.
### :returns: `1` when `a < b`, `0` otherwise.
external("C") routine rf_f128_lt_parts(a_low: U64, a_high: U64, b_low: U64, b_high: U64) -> S32
### Returns whether `a > b` (IEEE ordered: false when either is NaN).
### :param a_low: The low 64 bits of the left operand.
### :param a_high: The high 64 bits of the left operand.
### :param b_low: The low 64 bits of the right operand.
### :param b_high: The high 64 bits of the right operand.
### :returns: `1` when `a > b`, `0` otherwise.
external("C") routine rf_f128_gt_parts(a_low: U64, a_high: U64, b_low: U64, b_high: U64) -> S32
### Converts a signed 64-bit integer to `F128`.
### :param x: The integer to convert.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_s64_to_f128_parts(x: S64, out: Hijacked[F128])
### Converts an unsigned 64-bit integer to `F128`.
### :param x: The integer to convert.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_u64_to_f128_parts(x: U64, out: Hijacked[F128])
### Converts a signed 128-bit integer (as low/high words) to `F128`.
### :param low: The low 64 bits of the integer.
### :param high: The high 64 bits of the integer.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_s128_to_f128_parts(low: U64, high: U64, out: Hijacked[F128])
### Converts an unsigned 128-bit integer (as low/high words) to `F128`.
### :param low: The low 64 bits of the integer.
### :param high: The high 64 bits of the integer.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_u128_to_f128_parts(low: U64, high: U64, out: Hijacked[F128])
### Widens an `F32` to `F128` exactly.
### :param x: The single-precision value to widen.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f32_to_f128_parts(x: F32, out: Hijacked[F128])
### Widens an `F64` to `F128` exactly.
### :param x: The double-precision value to widen.
### :param out: Storage receiving the resulting `F128` value.
external("C") routine rf_f64_to_f128_parts(x: F64, out: Hijacked[F128])
### Narrows an `F128` to the nearest `F32`.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :returns: The nearest single-precision value.
external("C") routine rf_f128_to_f32_parts(low: U64, high: U64) -> F32
### Narrows an `F128` to the nearest `F64`.
### :param low: The low 64 bits of the input value.
### :param high: The high 64 bits of the input value.
### :returns: The nearest double-precision value.
external("C") routine rf_f128_to_f64_parts(low: U64, high: U64) -> F64

# ============================================================================
# Moment - System Clock
# ============================================================================

### Returns the current system clock timestamp as a `Moment`.
### :returns: The current wall-clock time.
external("C") routine rf_moment_now() -> Moment

# ============================================================================
# Cryptographic Random
# ============================================================================

### Returns a cryptographically-random 64-bit value from OS entropy.
### :returns: The resulting `U64` value.
external("C") routine rf_random_u64() -> U64

# ============================================================================
# C String Operations (CStr / char*)
# ============================================================================

### Returns the length of a null-terminated C string in code units.
### :param ptr: The C string pointer to measure.
### :returns: The number of `char` code units before the terminator.
external("C") routine rf_cstr_count(ptr: CStr) -> U64
### Compares two null-terminated C strings lexicographically.
### :param a: The left-hand string.
### :param b: The right-hand string.
### :returns: A negative, zero, or positive comparison result.
external("C") routine rf_cstr_compare(a: CStr, b: CStr) -> S32
### Copies a null-terminated C string into destination storage.
### :param dest: The destination buffer.
### :param src: The source string.
external("C") routine rf_cstr_copy(dest: CStr, src: CStr) -> CStr

# ============================================================================
# Stack Trace + Crash Reporting
# ============================================================================

### Pushes one frame onto the runtime crash trace.
### :param routine_name: The routine name text.
### :param file: The source file path or file name text.
### :param line: The source line number.
### :param col: The source column number.
external("C") routine rf_trace_push(routine_name: Address, file: Address, line: S32, col: S32)
### Executes `rf trace pop`.
external("C") routine rf_trace_pop()
### Terminates execution and reports a structured runtime crash.
### :param type_name: The crash type name text.
### :param type_len: The length of the crash type name text.
### :param file: The source file path or file name text.
### :param file_len: The length of the file path text.
### :param line: The source line number.
### :param col: The source column number.
### :param message: The crash message text.
### :param message_len: The length of the crash message text.
external("C") routine rf_crash(type_name: Address, type_len: U64, file: Address, file_len: U64, line: S32, col: S32, message: Address, message_len: U64)

# ============================================================================
# Console I/O
# ============================================================================

### Writes a UTF-8 byte buffer to standard output.
### :param ptr: Pointer to the bytes to write.
### :param len: Number of bytes to write.
external("C") routine rf_console_show(ptr: Hijacked[Byte], len: U64)
### Writes a UTF-8 byte buffer to the console's alert or error stream.
### :param ptr: Pointer to the bytes to write.
### :param len: Number of bytes to write.
external("C") routine rf_console_alert(ptr: Hijacked[Byte], len: U64)

### Reads one line of console input and returns its bytes.
### :returns: A runtime-managed byte buffer containing the captured line.
external("C") routine rf_console_ask_line() -> Hijacked[Byte]
### Reads one whitespace-delimited token from console input.
### :returns: A runtime-managed byte buffer containing the captured token.
external("C") routine rf_console_ask_word() -> Hijacked[Byte]
### Reads the remaining console input as text bytes.
### :returns: A runtime-managed byte buffer containing the captured input.
external("C") routine rf_console_ask_all() -> Hijacked[Byte]
### Reads exactly `count` bytes from console input when available.
### :param count: The requested number of bytes to read.
### :returns: A runtime-managed byte buffer containing the captured bytes.
external("C") routine rf_console_ask_bytes(count: U64) -> Hijacked[Byte]

# ============================================================================
# Integer (Arbitrary Precision) - LibTomMath
# All functions use opaque handles to mp_int structures
# ============================================================================

### Allocates and initializes a new arbitrary-precision integer handle.
### :returns: A live `CPtr` ready for use with the bigint runtime.
external("C") routine rf_bigint_new() -> CPtr
### Releases the storage owned by an arbitrary-precision integer handle.
### :param handle: The bigint handle to destroy.
external("C") routine rf_bigint_clear(handle: CPtr)
### Copies the value stored in `src` into `dest`.
### :param dest: The destination bigint handle.
### :param src: The source bigint handle.
external("C") routine rf_bigint_copy(dest: CPtr, src: CPtr)

### Replaces a bigint handle with the signed 64-bit value `value`.
### :param handle: The bigint handle to update.
### :param value: The signed integer value to assign.
external("C") routine rf_bigint_set_i64(handle: CPtr, value: S64)
### Replaces a bigint handle with the unsigned 64-bit value `value`.
### :param handle: The bigint handle to update.
### :param value: The unsigned integer value to assign.
external("C") routine rf_bigint_set_u64(handle: CPtr, value: U64)
### Parses `str` in the requested radix and stores the result in `handle`.
### :param handle: The bigint handle to update.
### :param str: The null-terminated integer text to parse.
### :param radix: The numeric base used to interpret the digits.
### :returns: A runtime status code indicating parse success or failure.
external("C") routine rf_bigint_set_str(handle: CPtr, str: CStr, radix: S32) -> S32

### Converts a bigint handle to `S64`.
### :param handle: The bigint handle to read.
### :returns: The converted `S64` value.
external("C") routine rf_bigint_get_i64(handle: CPtr) -> S64
### Converts a bigint handle to `U64`.
### :param handle: The bigint handle to read.
### :returns: The converted `U64` value.
external("C") routine rf_bigint_get_u64(handle: CPtr) -> U64
### Formats a bigint handle as a null-terminated string in the requested radix.
### :param handle: The bigint handle to render.
### :param radix: The numeric base to use for formatting.
### :returns: A pointer to the formatted C string.
external("C") routine rf_bigint_get_str(handle: CPtr, radix: S32) -> CStr

### Stores the sum of `a` and `b` into `result`.
### :param result: The destination bigint handle.
### :param a: The left-hand operand.
### :param b: The right-hand operand.
external("C") routine rf_bigint_add(result: CPtr, a: CPtr, b: CPtr)
### Stores the difference `a - b` into `result`.
### :param result: The destination bigint handle.
### :param a: The left-hand operand.
### :param b: The right-hand operand.
external("C") routine rf_bigint_sub(result: CPtr, a: CPtr, b: CPtr)
### Stores the product of `a` and `b` into `result`.
### :param result: The destination bigint handle.
### :param a: The left-hand operand.
### :param b: The right-hand operand.
external("C") routine rf_bigint_mul(result: CPtr, a: CPtr, b: CPtr)
### Divides `a` by `b` and writes both quotient and remainder.
### :param quotient: The destination handle for the quotient.
### :param remainder: The destination handle for the remainder.
### :param a: The dividend.
### :param b: The divisor.
external("C") routine rf_bigint_div(quotient: CPtr, remainder: CPtr, a: CPtr, b: CPtr)
### Stores the remainder of `a mod b` into `result`.
### :param result: The destination bigint handle.
### :param a: The dividend.
### :param b: The divisor.
external("C") routine rf_bigint_mod(result: CPtr, a: CPtr, b: CPtr)
### Stores the arithmetic negation of `a` into `result`.
### :param result: The destination bigint handle.
### :param a: The source operand.
external("C") routine rf_bigint_neg(result: CPtr, a: CPtr)

### Compares two bigint handles numerically.
### :param a: The left-hand operand.
### :param b: The right-hand operand.
### :returns: A negative, zero, or positive comparison result.
external("C") routine rf_bigint_cmp(a: CPtr, b: CPtr) -> S32

### Stores the bitwise AND of `a` and `b` into `result`.
### :param result: The destination bigint handle.
### :param a: The left-hand operand.
### :param b: The right-hand operand.
external("C") routine rf_bigint_and(result: CPtr, a: CPtr, b: CPtr)
### Stores the bitwise OR of `a` and `b` into `result`.
### :param result: The destination bigint handle.
### :param a: The left-hand operand.
### :param b: The right-hand operand.
external("C") routine rf_bigint_or(result: CPtr, a: CPtr, b: CPtr)
### Stores the bitwise XOR of `a` and `b` into `result`.
### :param result: The destination bigint handle.
### :param a: The left-hand operand.
### :param b: The right-hand operand.
external("C") routine rf_bigint_xor(result: CPtr, a: CPtr, b: CPtr)
### Stores `a` shifted left by `bits` into `result`.
### :param result: The destination bigint handle.
### :param a: The source operand.
### :param bits: The shift amount in bits.
external("C") routine rf_bigint_shl(result: CPtr, a: CPtr, bits: S32)
### Stores `a` shifted right by `bits` into `result`.
### :param result: The destination bigint handle.
### :param a: The source operand.
### :param bits: The shift amount in bits.
external("C") routine rf_bigint_shr(result: CPtr, a: CPtr, bits: S32)

### Stores the absolute value of `a` into `result`.
### :param result: The destination bigint handle.
### :param a: The source operand.
external("C") routine rf_bigint_abs(result: CPtr, a: CPtr)
### Raises `base` to the unsigned exponent `exp` and stores the result.
### :param result: The destination bigint handle.
### :param base: The base value.
### :param exp: The exponent value.
external("C") routine rf_bigint_pow(result: CPtr, base: CPtr, exp: U32)
### Stores the integer square root of `a` into `result`.
### :param result: The destination bigint handle.
### :param a: The source operand.
external("C") routine rf_bigint_sqrt(result: CPtr, a: CPtr)
### Stores the greatest common divisor of `a` and `b` into `result`.
### :param result: The destination bigint handle.
### :param a: The left-hand operand.
### :param b: The right-hand operand.
external("C") routine rf_bigint_gcd(result: CPtr, a: CPtr, b: CPtr)
### Stores the least common multiple of `a` and `b` into `result`.
### :param result: The destination bigint handle.
### :param a: The left-hand operand.
### :param b: The right-hand operand.
external("C") routine rf_bigint_lcm(result: CPtr, a: CPtr, b: CPtr)

### Returns whether the bigint handle currently stores zero.
### :param handle: The bigint handle to inspect.
### :returns: A non-zero runtime truth value when the number is zero.
external("C") routine rf_bigint_is_zero(handle: CPtr) -> S32
### Returns whether the bigint handle currently stores a negative value.
### :param handle: The bigint handle to inspect.
### :returns: A non-zero runtime truth value when the number is negative.
external("C") routine rf_bigint_is_neg(handle: CPtr) -> S32

# ============================================================================
# Text Parsing (CStr -> primitive values)
# Native C functions that parse null-terminated UTF-8 strings
# Integer parsing is pure RazorForge (in each type's .rf file)
# ============================================================================

### Parses a null-terminated UTF-8 string as `F16`.
### :param cstr: The text to parse.
### :returns: The parsed `F16` value.
external("C") routine rf_parse_F16(cstr: CStr) -> F16
### Parses a null-terminated UTF-8 string as `F32`.
### :param cstr: The text to parse.
### :returns: The parsed `F32` value.
external("C") routine rf_parse_F32(cstr: CStr) -> F32
### Parses a null-terminated UTF-8 string as `F64`.
### :param cstr: The text to parse.
### :returns: The parsed `F64` value.
external("C") routine rf_parse_F64(cstr: CStr) -> F64
### Parses a null-terminated UTF-8 string as `F128`, writing the result through `out`.
### :param cstr: The text to parse.
### :param out: Storage receiving the parsed `F128` value.
### :note: Out-param ABI — the C function `void rf_parse_F128(const char*, f128_t*)`
###        avoids the Windows x64 sret/xmm0 mismatch that breaks an f128_t return value.
external("C") routine rf_parse_F128(cstr: CStr, out: Hijacked[F128])

# ============================================================================
# Text Formatting (primitive values -> heap-allocated CStr pointer)
# Returns Address to heap-allocated null-terminated UTF-8 string
# Integer formatting is pure RazorForge (in each type's .rf file)
# ============================================================================

### Formats an `F16` value as a heap-allocated null-terminated UTF-8 string.
### :param value: The value to format.
### :returns: A pointer to the formatted string.
external("C") routine rf_format_F16(value: F16) -> Address
### Formats an `F32` value as a heap-allocated null-terminated UTF-8 string.
### :param value: The value to format.
### :returns: A pointer to the formatted string.
external("C") routine rf_format_F32(value: F32) -> Address
### Formats an `F64` value as a heap-allocated null-terminated UTF-8 string.
### :param value: The value to format.
### :returns: A pointer to the formatted string.
external("C") routine rf_format_F64(value: F64) -> Address
### Formats an `F128` value as a heap-allocated null-terminated UTF-8 string.
### :param low: The low 64 bits of the value to format.
### :param high: The high 64 bits of the value to format.
### :returns: A pointer to the formatted string.
### :note: Parts ABI — passing the 16-byte `f128_t` by value does not match
###        the scalar `fp128` ABI emitted for `F128` parameters.
external("C") routine rf_format_F128_parts(low: U64, high: U64) -> Address

# ============================================================================
# File I/O
# ============================================================================

### Returns the byte length associated with the most recent runtime buffer result.
### This is used by higher-level wrappers after calls that return raw byte pointers.
### :returns: The length of the current result buffer in bytes.
external("C") routine rf_get_result_len() -> U64
### Opens a file and returns the runtime file descriptor.
### :param path: The null-terminated file path.
### :param path_len: The path length in bytes.
### :param mode: The runtime file-open mode code.
### :returns: A runtime file descriptor, or a failure code defined by the runtime.
external("C") routine rf_file_open(path: CStr, path_len: S32, mode: S32) -> S32
### Closes an open runtime file descriptor.
### :param fd: The file descriptor to close.
external("C") routine rf_file_close(fd: S32)
### Reads the remaining contents of a file into a runtime-managed byte buffer.
### :param fd: The file descriptor to read from.
### :returns: A pointer to the captured byte buffer.
external("C") routine rf_file_read_all(fd: S32) -> Hijacked[Byte]
### Reads one line from a file into a runtime-managed byte buffer.
### :param fd: The file descriptor to read from.
### :returns: A pointer to the captured byte buffer.
external("C") routine rf_file_read_line(fd: S32) -> Hijacked[Byte]
### Reads up to `count` bytes from a file into a runtime-managed buffer.
### :param fd: The file descriptor to read from.
### :param count: The maximum number of bytes to read.
### :returns: A pointer to the captured byte buffer.
external("C") routine rf_file_read_bytes(fd: S32, count: U64) -> Hijacked[Byte]
### Writes `len` bytes from `ptr` to an open file descriptor.
### :param fd: The file descriptor to write to.
### :param ptr: Pointer to the bytes to write.
### :param len: Number of bytes to write.
### :returns: The number of bytes written.
external("C") routine rf_file_write(fd: S32, ptr: Hijacked[Byte], len: U64) -> U64
### Flushes buffered output associated with a file descriptor.
### :param fd: The file descriptor to flush.
external("C") routine rf_file_flush(fd: S32)
### Returns whether a file descriptor has reached end-of-file.
### :param fd: The file descriptor to inspect.
### :returns: `true` when no more data can be read.
external("C") routine rf_file_is_eof(fd: S32) -> Bool

# ============================================================================
# FileSystem
# ============================================================================

### Returns whether a filesystem path exists.
### :param path: The null-terminated path to inspect.
### :param len: The path length in bytes.
### :returns: `true` when the path exists.
external("C") routine rf_fs_exists(path: CStr, len: S32) -> Bool
### Returns whether a filesystem path refers to a regular file.
### :param path: The null-terminated path to inspect.
### :param len: The path length in bytes.
### :returns: `true` when the path exists and is a regular file.
external("C") routine rf_fs_is_file(path: CStr, len: S32) -> Bool
### Returns whether a filesystem path refers to a directory.
### :param path: The null-terminated path to inspect.
### :param len: The path length in bytes.
### :returns: `true` when the path exists and is a directory.
external("C") routine rf_fs_is_directory(path: CStr, len: S32) -> Bool
### Creates one directory at `path`.
### :param path: The null-terminated directory path.
### :param len: The path length in bytes.
### :returns: A runtime status code.
external("C") routine rf_fs_create_dir(path: CStr, len: S32) -> S32
### Creates a directory path recursively, including missing parents.
### :param path: The null-terminated directory path.
### :param len: The path length in bytes.
### :returns: A runtime status code.
external("C") routine rf_fs_create_dir_all(path: CStr, len: S32) -> S32
### Removes a file or empty directory at `path`.
### :param path: The null-terminated path to remove.
### :param len: The path length in bytes.
### :returns: A runtime status code.
external("C") routine rf_fs_remove(path: CStr, len: S32) -> S32
### Removes a directory tree or path recursively.
### :param path: The null-terminated path to remove.
### :param len: The path length in bytes.
### :returns: A runtime status code.
external("C") routine rf_fs_remove_all(path: CStr, len: S32) -> S32
### Copies a filesystem object from `src` to `dst`.
### :param src: The null-terminated source path.
### :param src_len: The source path length in bytes.
### :param dst: The null-terminated destination path.
### :param dst_len: The destination path length in bytes.
### :returns: A runtime status code.
external("C") routine rf_fs_copy(src: CStr, src_len: S32, dst: CStr, dst_len: S32) -> S32
### Moves or renames a filesystem object from `src` to `dst`.
### :param src: The null-terminated source path.
### :param src_len: The source path length in bytes.
### :param dst: The null-terminated destination path.
### :param dst_len: The destination path length in bytes.
### :returns: A runtime status code.
external("C") routine rf_fs_move(src: CStr, src_len: S32, dst: CStr, dst_len: S32) -> S32
### Returns the file size for a regular file path.
### :param path: The null-terminated path to inspect.
### :param len: The path length in bytes.
### :returns: The file size in bytes.
external("C") routine rf_fs_file_size(path: CStr, len: S32) -> S64
### Joins two path fragments using the platform path separator rules.
### :param a: The left-hand path fragment.
### :param a_len: The length of `a` in bytes.
### :param b: The right-hand path fragment.
### :param b_len: The length of `b` in bytes.
### :returns: A runtime-managed byte buffer containing the joined path.
external("C") routine rf_fs_join_path(a: CStr, a_len: S32, b: CStr, b_len: S32) -> Hijacked[Byte]
### Returns the parent directory portion of a path.
### :param path: The null-terminated path to inspect.
### :param len: The path length in bytes.
### :returns: A runtime-managed byte buffer containing the parent path.
external("C") routine rf_fs_parent_path(path: CStr, len: S32) -> Hijacked[Byte]
### Returns the final path component of a path.
### :param path: The null-terminated path to inspect.
### :param len: The path length in bytes.
### :returns: A runtime-managed byte buffer containing the file name.
external("C") routine rf_fs_file_name(path: CStr, len: S32) -> Hijacked[Byte]
### Returns the file name without its final extension.
### :param path: The null-terminated path to inspect.
### :param len: The path length in bytes.
### :returns: A runtime-managed byte buffer containing the stem text.
external("C") routine rf_fs_file_stem(path: CStr, len: S32) -> Hijacked[Byte]
### Returns the final extension component of a path.
### :param path: The null-terminated path to inspect.
### :param len: The path length in bytes.
### :returns: A runtime-managed byte buffer containing the extension text.
external("C") routine rf_fs_extension(path: CStr, len: S32) -> Hijacked[Byte]
### Returns an absolute version of a path without necessarily resolving symlinks.
### :param path: The null-terminated path to normalize.
### :param len: The path length in bytes.
### :returns: A runtime-managed byte buffer containing the absolute path.
external("C") routine rf_fs_absolute_path(path: CStr, len: S32) -> Hijacked[Byte]
### Returns the canonicalized path with platform-specific resolution applied.
### :param path: The null-terminated path to canonicalize.
### :param len: The path length in bytes.
### :returns: A runtime-managed byte buffer containing the canonical path.
external("C") routine rf_fs_canonical_path(path: CStr, len: S32) -> Hijacked[Byte]
### Returns whether the current process can read the path.
### :param path: The null-terminated path to inspect.
### :param len: The path length in bytes.
### :returns: `true` when read access is available.
external("C") routine rf_fs_can_read(path: CStr, len: S32) -> Bool
### Returns whether the current process can write to the path.
### :param path: The null-terminated path to inspect.
### :param len: The path length in bytes.
### :returns: `true` when write access is available.
external("C") routine rf_fs_can_write(path: CStr, len: S32) -> Bool
### Returns whether the current process can execute the path.
### :param path: The null-terminated path to inspect.
### :param len: The path length in bytes.
### :returns: `true` when execute access is available.
external("C") routine rf_fs_can_execute(path: CStr, len: S32) -> Bool
### Sets or clears the readonly attribute for a filesystem path.
### :param path: The null-terminated path to update.
### :param len: The path length in bytes.
### :param readonly_flag: `true` to mark readonly, `false` to clear it.
### :returns: A runtime status code.
external("C") routine rf_fs_set_readonly(path: CStr, len: S32, readonly_flag: Bool) -> S32

# ============================================================================
# Real (arbitrary-precision binary float, libbf-backed) — handle lifecycle +
# operations. Mirrors the rf_bigint_* surface; handles are heap bf_t pointers.
# ============================================================================
### Allocates a new zero-initialized Real handle.
external("C") routine rf_real_new() -> CPtr
### Frees a Real handle and its backing storage.
external("C") routine rf_real_clear(handle: CPtr)
### Sets the handle to a signed 64-bit integer value.
external("C") routine rf_real_set_i64(handle: CPtr, value: S64)
### Sets the handle to an F64 value (exact).
external("C") routine rf_real_set_f64(handle: CPtr, value: F64)
### Parses a decimal string into the handle (radix 10). Returns a libbf status.
external("C") routine rf_real_set_str(handle: CPtr, str: CPtr, radix: S32) -> S32
### Rounds the value to the nearest F64.
external("C") routine rf_real_get_f64(handle: CPtr) -> F64
### Formats the value as a freshly-allocated decimal C string (free with rf_invalidate).
external("C") routine rf_real_to_str(handle: CPtr) -> CStr
### Stores a + b (exact) into result.
external("C") routine rf_real_add(result: CPtr, a: CPtr, b: CPtr)
### Stores a - b (exact) into result.
external("C") routine rf_real_sub(result: CPtr, a: CPtr, b: CPtr)
### Stores a * b (exact) into result.
external("C") routine rf_real_mul(result: CPtr, a: CPtr, b: CPtr)
### Stores a / b (rounded to the working precision) into result.
external("C") routine rf_real_div(result: CPtr, a: CPtr, b: CPtr)
### Stores -a into result.
external("C") routine rf_real_neg(result: CPtr, a: CPtr)
### Stores sqrt(a) into result.
external("C") routine rf_real_sqrt(result: CPtr, a: CPtr)
### Stores exp(a) into result.
external("C") routine rf_real_exp(result: CPtr, a: CPtr)
### Stores log(a) into result.
external("C") routine rf_real_log(result: CPtr, a: CPtr)
### Stores a ** b into result.
external("C") routine rf_real_pow(result: CPtr, a: CPtr, b: CPtr)
### Stores sin(a) into result.
external("C") routine rf_real_sin(result: CPtr, a: CPtr)
### Stores cos(a) into result.
external("C") routine rf_real_cos(result: CPtr, a: CPtr)
### Stores tan(a) into result.
external("C") routine rf_real_tan(result: CPtr, a: CPtr)
### Stores asin(a) into result.
external("C") routine rf_real_asin(result: CPtr, a: CPtr)
### Stores acos(a) into result.
external("C") routine rf_real_acos(result: CPtr, a: CPtr)
### Stores atan(a) into result.
external("C") routine rf_real_atan(result: CPtr, a: CPtr)
### Stores atan2(y, x) into result.
external("C") routine rf_real_atan2(result: CPtr, y: CPtr, x: CPtr)
### Stores sinh(a) into result.
external("C") routine rf_real_sinh(result: CPtr, a: CPtr)
### Stores cosh(a) into result.
external("C") routine rf_real_cosh(result: CPtr, a: CPtr)
### Stores tanh(a) into result.
external("C") routine rf_real_tanh(result: CPtr, a: CPtr)
### Stores asinh(a) into result.
external("C") routine rf_real_asinh(result: CPtr, a: CPtr)
### Stores acosh(a) into result.
external("C") routine rf_real_acosh(result: CPtr, a: CPtr)
### Stores atanh(a) into result.
external("C") routine rf_real_atanh(result: CPtr, a: CPtr)
### Stores log2(a) into result.
external("C") routine rf_real_log2(result: CPtr, a: CPtr)
### Stores log10(a) into result.
external("C") routine rf_real_log10(result: CPtr, a: CPtr)
### Stores hypot(a, b) into result.
external("C") routine rf_real_hypot(result: CPtr, a: CPtr, b: CPtr)
### Stores cbrt(a) into result.
external("C") routine rf_real_cbrt(result: CPtr, a: CPtr)
### Precision-aware variants (prec = decimal significant digits).
external("C") routine rf_real_div_p(result: CPtr, a: CPtr, b: CPtr, prec: S32)
external("C") routine rf_real_sqrt_p(result: CPtr, a: CPtr, prec: S32)
external("C") routine rf_real_exp_p(result: CPtr, a: CPtr, prec: S32)
external("C") routine rf_real_log_p(result: CPtr, a: CPtr, prec: S32)
external("C") routine rf_real_pow_p(result: CPtr, a: CPtr, b: CPtr, prec: S32)
external("C") routine rf_real_sin_p(result: CPtr, a: CPtr, prec: S32)
external("C") routine rf_real_cos_p(result: CPtr, a: CPtr, prec: S32)
external("C") routine rf_real_tan_p(result: CPtr, a: CPtr, prec: S32)
external("C") routine rf_real_asin_p(result: CPtr, a: CPtr, prec: S32)
external("C") routine rf_real_acos_p(result: CPtr, a: CPtr, prec: S32)
external("C") routine rf_real_atan_p(result: CPtr, a: CPtr, prec: S32)
external("C") routine rf_real_atan2_p(result: CPtr, y: CPtr, x: CPtr, prec: S32)
external("C") routine rf_real_sinh_p(result: CPtr, a: CPtr, prec: S32)
external("C") routine rf_real_cosh_p(result: CPtr, a: CPtr, prec: S32)
external("C") routine rf_real_tanh_p(result: CPtr, a: CPtr, prec: S32)
external("C") routine rf_real_asinh_p(result: CPtr, a: CPtr, prec: S32)
external("C") routine rf_real_acosh_p(result: CPtr, a: CPtr, prec: S32)
external("C") routine rf_real_atanh_p(result: CPtr, a: CPtr, prec: S32)
external("C") routine rf_real_log2_p(result: CPtr, a: CPtr, prec: S32)
external("C") routine rf_real_log10_p(result: CPtr, a: CPtr, prec: S32)
external("C") routine rf_real_hypot_p(result: CPtr, a: CPtr, b: CPtr, prec: S32)
external("C") routine rf_real_cbrt_p(result: CPtr, a: CPtr, prec: S32)
### Compares two Real handles: -1 / 0 / 1 (2 = unordered/NaN).
external("C") routine rf_real_cmp(a: CPtr, b: CPtr) -> S32
