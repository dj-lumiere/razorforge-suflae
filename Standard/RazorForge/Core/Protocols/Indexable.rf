module Core

### Represents the `Indexable` protocol.
### Indexable values expose keyed read and write access through bracket syntax.
### :typeparam K: The key type accepted by the indexer.
### :typeparam V: The value type returned or assigned by the indexer.
protocol Indexable[K, V]
  ### Returns the value addressed by `key`.
  ### Implementations define whether missing keys throw, return absent, or use another contract.
  ### :param key: The key to resolve.
  ### :returns: The element at the given index.
  @readonly
  routine Me.$getitem!(key: K) -> V

  ### Stores `value` at `key`.
  ### The write semantics are defined by the conforming type.
  ### :param key: The key to resolve.
  ### :param value: The value to use.
  routine Me.$setitem!(key: K, value: V)
