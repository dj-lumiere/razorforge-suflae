module Core

import BuilderService

### Represents the success-or-crash carrier used by `check_` routines.
### A `Result[T]` stores either a successful `T` payload or a crashable error
### payload inline. The full layout is codegen-controlled:
###   { U64 type_id, [max(sizeof(T), 8) x U8] payload }
### `type_id == 0` is the Blank state with don't-care payload bytes.
### :typeparam T: The successful return value type.
record Result[T]
  ### Identifies the stored payload type.
  ### The runtime uses this to distinguish successful payloads from crashables.
  secret type_id: U64

### Returns the display form of this result: the payload's own `$represent`.
### Both the success (`T`) and crashable arms delegate to their payload — the
### `Result[T]` wrapper does not add any framing of its own.
### :returns: The resulting `Text` value.
routine Result[T].$represent() -> Text
  when me
    is Crashable v =>
      return v.$represent()
    else v =>
      return v.$represent()

### Returns the diagnostic form of this result.
### Format: `f"{full_type_name}(type_id: {type_id}, {payload.$diagnose()})"`.
### :returns: The resulting `Text` value.
routine Result[T].$diagnose() -> Text
  when me
    is Crashable v =>
      return f"{me.full_type_name()}(type_id: {me.type_id}, {v.$diagnose()})"
    else v =>
      return f"{me.full_type_name()}(type_id: {me.type_id}, {v.$diagnose()})"
