module Core

### Represents the protocol implemented by all crashable error types.
### Crashables are produced by `throw` and transported by `Result[T]` and
### `Lookup[T]`, where they can be inspected without immediately terminating control flow.
protocol Crashable
  ### Returns the human-readable error message for this crashable value.
  ### This should describe the specific failure in terms suitable for end users,
  ### logs, or surfaced diagnostics.
  ### :returns: The resulting `Text` value.
  @readonly
  routine Me.crash_message() -> Text

  ### Returns a short title for this crashable value.
  ### The title should name the crash type in sentence case and stay stable
  ### across instances so tooling can group similar failures.
  ### :returns: The resulting `Text` value.
  @readonly
  routine Me.crash_title() -> Text
