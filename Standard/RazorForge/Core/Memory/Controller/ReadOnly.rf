module Core

### Represents the lock policy for shared data that never permits mutation.
### `ReadOnly` models the trivial concurrency case where no lock state needs to be tracked.
### :see: {Exclusive}, {MultiRead}, {Lock-Policies}
record ReadOnly obeys LockPolicy
  pass # Empty - no lock state needed for unmodifiable data

### Creates the read-only lock policy value.
### :returns: The resulting `ReadOnly` value.
routine ReadOnly.$create() -> ReadOnly
  return ReadOnly()

# No lock/unlock methods needed - data is unmodifiable
# Direct member variable access is allowed for Shared[T, ReadOnly]

### Returns the current lock state for this policy.
### Read-only access never enters reading or writing lock states.
### :returns: The resulting `LockState` value.
routine ReadOnly.state() -> LockState
  return IDLE
