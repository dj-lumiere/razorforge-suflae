module Core

### Represents a reader-writer lock policy with shared reads and exclusive writes.
### `MultiRead` allows multiple concurrent readers or one writer, but never both at the same time.
### :see: {Exclusive}, {ReadOnly}, {Lock-Policies}
record MultiRead obeys LockPolicy
  ### Stores the number of active readers.
  secret readers: Atomic[S32]  # Number of active readers
  ### Stores whether a writer currently holds the lock.
  secret writer: Atomic[Bool]  # Is a writer active?

### Creates an unlocked reader-writer policy.
### :returns: The resulting `MultiRead` value.
routine MultiRead.$create() -> MultiRead
  return MultiRead(
    readers: Atomic(0),
    writer: Atomic(false)
  )

### Blocks until a shared read lock is acquired.
routine MultiRead.acquire_read()
  loop
    # Wait for no writer
    when me.writer.load()
      == false =>
        # Try to increment reader count
        me.readers.fetch_add(1)

        # Double-check writer didn't sneak in
        when me.writer.load()
          == false => break  # Success!
          == true =>
            # Writer appeared, back out
            me.readers.fetch_sub(1)
      == true => pass  # Writer active, keep waiting
  return

### Tries to acquire a shared read lock without blocking.
### :returns: `true` if the read lock was acquired, `false` if a writer is currently active.
routine MultiRead.acquire_read!() -> Bool
  when me.writer.load()
    == false =>
      me.readers.fetch_add(1)
      when me.writer.load()
        == false => return true
        == true =>
          me.readers.fetch_sub(1)
          return false
    == true => return false

### Releases one held read lock.
routine MultiRead.release_read()
  me.readers.fetch_sub(1)
  return

### Blocks until an exclusive write lock is acquired.
routine MultiRead.acquire_write()
  # First, acquire writer flag
  loop
    when me.writer.compare_exchange(expected: false, desired: true)
      == true => break   # Got writer flag
      == false => pass   # Keep trying

  # Wait for all readers to finish
  loop
    when me.readers.load()
      == 0 => break  # No readers, we can proceed
      else => pass    # Wait for readers to finish
  return

### Tries to acquire an exclusive write lock without blocking.
### :returns: `true` if the write lock was acquired, `false` if a writer is active or readers are present.
routine MultiRead.acquire_write!() -> Bool
  # Try to acquire writer flag
  when me.writer.compare_exchange(expected: false, desired: true)
    == true =>
      # Got writer flag, check for readers
      when me.readers.load()
        == 0 => return true  # Success!
        else =>
          # Readers present, back out
          me.writer.store(false)
          return false
    == false => return false  # Another writer has it

### Releases the held write lock.
routine MultiRead.release_write()
  me.writer.store(false)
  return

### Returns the number of threads currently holding a shared read lock.
### :returns: The active reader count.
routine MultiRead.reader_count() -> S32
  return me.readers.load()

### Returns `true` if a writer currently holds the exclusive write lock.
### :returns: `true` if the write lock is active.
routine MultiRead.is_write_locked() -> Bool
  return me.writer.load()

### Returns the current lock state for this policy.
### :returns: The resulting `LockState` value.
routine MultiRead.state() -> LockState
  if me.writer.load()
    return WRITING
  if me.readers.load() > 0
    return READING
  return IDLE
