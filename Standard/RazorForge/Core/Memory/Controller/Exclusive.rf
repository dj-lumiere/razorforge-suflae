module Core

### Represents an exclusive-write lock policy.
### `Exclusive` allows exactly one mutable accessor at a time and does not permit concurrent readers.
### :see: {ReadOnly}, {MultiRead}, {Lock-Policies}
record Exclusive obeys LockPolicy
  ### Stores whether the lock is currently held.
  secret locked: Atomic[Bool]

### Blocks until the exclusive lock is acquired.
routine Exclusive.acquire()
  # Spin until we can acquire the lock
  loop
    when me.locked.compare_exchange(expected: false, desired: true)
      == true => break  # Successfully acquired
      == false => pass  # Someone else has it, keep trying
  return

### Tries to acquire the exclusive lock without blocking.
### :returns: `true` if the lock was acquired, `false` if it is already held by another caller.
routine Exclusive.acquire!() -> Bool
  return me.locked.compare_exchange(expected: false, desired: true)

### Releases the exclusive lock.
routine Exclusive.release()
  me.locked.store(false)
  return

### Returns `true` if the lock is currently held by a writer.
### :returns: `true` if the lock is currently held.
routine Exclusive.is_locked() -> Bool
  return me.locked.load()

### Returns the current lock state for this policy.
### :returns: The resulting `LockState` value.
routine Exclusive.state() -> LockState
  if me.locked.load()
    return WRITING
  return IDLE
