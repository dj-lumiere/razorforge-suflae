module Core

### Mutual-exclusion discipline — one accessor at a time, granting a single `Claiming[T]`.
### A spinlock over an atomic flag: `acquire()` busy-waits on a `compare_exchange` until the flag
### flips free→held. Spin-based (no OS parking), so it suits short critical sections; a future
### blocking variant would park the thread via a runtime futex primitive.
### :see: {LockPolicy}, {MultiRead}, {Shared}, {Atomic}
record Exclusive obeys LockPolicy
  ### The lock flag: `0` = free, `1` = held.
  secret locked: Atomic[U8]
  ### Thread id of the current holder, `0` when free. Tracked to detect a re-entrant acquire
  ### (the holding thread asking for the lock again — a self-deadlock).
  secret owner: Atomic[U64]

### Creates an unlocked exclusive policy.
### :returns: The resulting `Exclusive` value.
routine Exclusive.create() -> Exclusive
  return Exclusive(locked: Atomic[U8](initial: 0_u8), owner: Atomic[U64](initial: 0_u64))

### Acquires the lock, spinning until it is free. Blocking, not failing: a contended lock waits.
### The ONE failure it does report is a re-entrant acquire — if the spin finds the lock held by the
### CALLING thread, that can never resolve, so it crashes with {ReentrantLockError} instead of
### hanging. Detection is best-effort (owner is read only on a failed CAS), so it never false-fires.
routine Exclusive.acquire()
  var tid = rf_current_thread_id()
  loop
    if me.locked.compare_exchange(expected: 0_u8, desired: 1_u8)
      me.owner.store(desired: tid)
      break
    if me.owner.load() == tid
      crash_reentrant_lock()
  return

### Releases the lock. Clears the owner before the flag so a waiter that wins the next CAS never
### observes the previous holder's id.
routine Exclusive.release()
  me.owner.store(desired: 0_u64)
  me.locked.store(desired: 0_u8)
  return

### Returns whether the lock is currently held. Snapshot only.
### :returns: `true` if held.
@readonly
routine Exclusive.is_locked() -> Bool
  return me.locked.load() != 0_u8

### Tries to acquire the lock with a SINGLE non-blocking attempt: returns `true` if the flag flipped
### free→held (now owned by this thread), `false` if it was already held. No spin, so no re-entrant
### self-deadlock to detect — a re-entrant try simply returns `false`.
### :returns: `true` if the lock was acquired.
routine Exclusive.try_acquire() -> Bool
  if me.locked.compare_exchange(expected: 0_u8, desired: 1_u8)
    me.owner.store(desired: rf_current_thread_id())
    return true
  return false

# ============================================================================
# Uniform LockPolicy interface — there is one lock, so inspector == claimer.
# ============================================================================

### Admits an inspector by taking the single lock (no distinct reader mode under exclusion).
routine Exclusive.add_inspector()
  me.acquire()
  return

### Removes the inspector by releasing the single lock.
routine Exclusive.remove_inspector()
  me.release()
  return

### Admits the claimer by taking the single lock for exclusive access.
routine Exclusive.add_claimer()
  me.acquire()
  return

### Removes the claimer by releasing the single lock.
routine Exclusive.remove_claimer()
  me.release()
  return

### Non-blocking inspector admission — there is one lock, so it is just `try_acquire`.
### :returns: `true` if admitted.
routine Exclusive.try_add_inspector() -> Bool
  return me.try_acquire()

### Non-blocking claimer admission — one lock, so just `try_acquire`.
### :returns: `true` if admitted.
routine Exclusive.try_add_claimer() -> Bool
  return me.try_acquire()
