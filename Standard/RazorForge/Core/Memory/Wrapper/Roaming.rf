module Core

import BuilderService

### Scope-bound access guard over a {Roamed[T]} — the `Roamed` analogue of {Claiming[T, P]}. A
### non-storable token produced by `Roamed.claim_roam()`; it holds the {RoamController[T]} pointer.
### Entering its `using` scope (`$enter`) acquires the mode-checked reentrant lock (a no-op while the
### object is LOCAL, a task-keyed exclusive acquire once ESCAPED) and exiting (`$exit`) releases it, so
### the lock spans exactly the `using` block — on EVERY exit path, including a failable throw. While
### held, it forwards the guarded entity's methods (via `$control`), which is safe because the inner
### reference is only reachable inside the lock. `Roamed` itself deliberately has NO `$control`/`$refer`
### (that would bypass the lock); the guard is the ONLY lock-safe path to the inner entity.
### :typeparam T: The guarded entity type.
### :see: {Roamed[T]}, {RoamController[T]}, {Claiming[T, P]}
@llvm("ptr")
record Roaming[T] obeys Controlling[T], Enterable
needs T is EntityType
  pass

# NOTE: No user creators — produced only by `Roamed.claim_roam()`, which reinterprets the shared
# controller pointer. Users never construct one directly.

# ============================================================================
# Resource management — enables `using roamed.claim_roam() as g`
# ============================================================================

### Called on entry to the `using` block: acquires the mode-checked reentrant lock (no-op in LOCAL
### mode), then passes the token through as the bound value. Pairs with `$exit`.
### :returns: This token as `Roaming[T]`.
routine Roaming[T].$enter() -> Roaming[T]
  danger!
    var ctrl = Hijacked[RoamController[T]](me).as_entity()
    ctrl.guard_enter()
  return me

### Called on exit from the `using` block (and on every escape — normal, early, or throw): releases
### the mode-checked reentrant lock.
routine Roaming[T].$exit()
  danger!
    var ctrl = Hijacked[RoamController[T]](me).as_entity()
    ctrl.guard_exit()
  return

# ============================================================================
# Marker-protocol coercion ($refer / $control) — yields the guarded entity as ?T (lock held)
# ============================================================================

### Yields the guarded entity as an in-flight `T` reference for read-only access. Inserted implicitly
### at call sites whose parameter is `Referring[T]`. Safe: only reachable while the lock is held.
### :returns: The guarded entity.
@[readonly, inline]
routine Roaming[T].$refer() -> T
  danger!
    var ctrl = Hijacked[RoamController[T]](me).as_entity()
    return ctrl.data_ptr().as_entity()

### Yields the guarded entity as an in-flight `T` reference for read/write access. Inserted implicitly
### at call sites whose parameter is `Controlling[T]`. Safe: only reachable while the lock is held.
### :returns: The guarded entity.
@inline
routine Roaming[T].$control() -> T
  danger!
    var ctrl = Hijacked[RoamController[T]](me).as_entity()
    return ctrl.data_ptr().as_entity()

# ============================================================================
# Display (transparent — delegates to the guarded entity through the controller)
# ============================================================================

### Returns the display form of the guarded entity.
### :returns: The resulting `Text` value.
@readonly
routine Roaming[T].$represent() -> Text
  danger!
    var ctrl = Hijacked[RoamController[T]](me).as_entity()
    return ctrl.data_ptr().as_entity().$represent()

### Returns the diagnostic form of the guarded entity.
### :returns: The resulting `Text` value.
@readonly
routine Roaming[T].$diagnose() -> Text
  danger!
    var ctrl = Hijacked[RoamController[T]](me).as_entity()
    return me.type_name() + "(" + ctrl.data_ptr().as_entity().$diagnose() + ")"

### No-op: the token owns no heap (it only aliases the controller); the lock is released by `$exit`.
### Releasing here too would double-release.
dangerous routine Roaming[T].$destroy()
  return
