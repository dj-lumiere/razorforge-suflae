module Core

### Represents temporary mutable access acquired under a shared lock policy.
### `Claimed[T]` is the non-storable access token produced by `.claim!()` when write access has been granted.
### :typeparam T: The exclusively owned entity type.
### :see: {Inspected[T]}, {Viewed[T]}, {Access-Types}
@llvm("ptr")
record Claimed[T] obeys Controlling[T]
needs T is EntityType
  pass

# NOTE: No creators, no manual methods - all operations handled by compiler
# The `.claim!()` syntax acquires the Exclusive or MultiRead write lock and creates this token
# The lock is automatically released when the scope exits via compiler-managed hidden guard state
# Only ONE thread can hold a write lock at a time
#
# Lock acquisition can fail (e.g., poisoned lock) - use `try_claim()` / `check_claim()` for fallible acquisition

# ============================================================================
# Resource management — enables `using shared.claim!() as s`
# ============================================================================

### Called on entry to a `using` block; no-op here because lock acquisition happens before this token is produced.
routine Claimed[T].$enter()
  return

### Called on exit from a `using` block; the compiler emits the actual unlock via its hidden guard state.
routine Claimed[T].$exit()
  # Lock release is driven by compiler-owned hidden guard state, not a field on this value.
  # When the lock runtime is implemented, the compiler will emit unlock via the hidden guard.
  return

# ============================================================================
# Display (transparent - delegates to inner value, lock already held)
# ============================================================================

### Returns the display form of the claimed entity.
### :returns: The resulting `Text` value.
@readonly
routine Claimed[T].$represent() -> Text
  danger!
    return reinterpret_bits[Claimed[T], Hijacked[T]](me).extract().$represent()

### Returns the diagnostic form of the claimed entity, including its write-lock state.
### :returns: The resulting `Text` value.
@readonly
routine Claimed[T].$diagnose() -> Text
  danger!
    return me.type_name() + "(state: " + WRITING.$represent() + ", " + reinterpret_bits[Claimed[T], Hijacked[T]](me).extract().$diagnose() + ")"
