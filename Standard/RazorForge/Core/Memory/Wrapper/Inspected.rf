module Core

### Represents temporary read access acquired under a shared lock policy.
### `Inspected[T]` is the non-storable access token produced by `.inspect!()` when a read lock has been granted.
### :typeparam T: The exclusively owned entity type.
### :see: {Claimed[T]}, {Viewed[T]}, {Access-Types}
@llvm("ptr")
record Inspected[T] obeys Referring[T]
needs T is EntityType
  pass

# NOTE: No creators, no manual methods - all operations handled by compiler
# The `.inspect!()` syntax acquires the MultiRead read lock and creates this token
# The lock is automatically released when the scope exits via compiler-managed hidden guard state
# Multiple threads can hold read locks simultaneously (MultiRead semantics)
#
# Lock acquisition can fail (e.g., poisoned lock) - use `try_inspect()` / `check_inspect()` for fallible acquisition

# ============================================================================
# Resource management — enables `using shared.inspect!() as obs`
# ============================================================================

### Called on entry to a `using` block; no-op here because lock acquisition happens before this token is produced.
routine Inspected[T].$enter()
  return

### Called on exit from a `using` block; the compiler emits the actual unlock via its hidden guard state.
routine Inspected[T].$exit()
  # Lock release is driven by compiler-owned hidden guard state, not a field on this value.
  # When the lock runtime is implemented, the compiler will emit unlock via the hidden guard.
  return

# ============================================================================
# Display (transparent - delegates to inner value, lock already held)
# ============================================================================

### Returns the display form of the inspected entity.
### :returns: The resulting `Text` value.
@readonly
routine Inspected[T].$represent() -> Text
  danger!
    return reinterpret_bits[Inspected[T], Hijacked[T]](me).extract().$represent()

### Returns the diagnostic form of the inspected entity, including its read-lock state.
### :returns: The resulting `Text` value.
@readonly
routine Inspected[T].$diagnose() -> Text
  danger!
    return me.type_name() + "(state: " + READING.$represent() + ", " + reinterpret_bits[Inspected[T], Hijacked[T]](me).extract().$diagnose() + ")"
