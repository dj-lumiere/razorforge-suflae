module Core

import BuilderService

### Multi-threaded strong reference to shared data. Thin pointer to {ShareController[T]}.
### The atomic-refcount twin of {Retained[T]} — equivalent to `Arc[T]` in Rust. Cloning bumps the
### strong count atomically (`.share()`); dropping decrements it. Safe to hold across threads.
###
### Unlike {Retained[T]}, `Shared[T]` does NOT obey `Controlling[T]`: multi-threaded access to the
### guarded data is granted exclusively through the `Claiming[T]` / `Inspecting[T]` tokens (and the
### readers-XOR-writer borrow checker), which arrive in a later phase. A `Shared` is therefore an
### ownership handle only — it refcounts and hands out weak references, but reaching the inner value
### goes through a token, never a single-threaded `Referring`/`Controlling` borrow.
### :typeparam T: The exclusively owned entity type.
@llvm("ptr")
record Shared[T]
needs T is EntityType
  pass

# ============================================================================
# Construction
# ============================================================================

### Wraps this entity in an atomically reference-counted {Shared[T]}.
### Ownership transfers to the RC system; the original binding is invalidated.
### :returns: The resulting `Shared[T]` value.
routine T.share() -> Shared[T]
needs T is EntityType
  danger!
    var ctrl = ShareController[T](data: me.hijack()).hijack()
    return Shared[T](ctrl)

# ============================================================================
# Reference counting
# ============================================================================

### Returns a new strong reference to the same entity, atomically incrementing the strong count.
### :returns: A new strong handle sharing the same underlying entity.
routine Shared[T].share() -> Shared[T]
  danger!
    var ctrl = Hijacked[ShareController[T]](me).as_entity()
    ctrl.increase_strong_count()
  return me

### Decrements the strong count, destroying the entity when it reaches zero.
### Destroys the controller when both strong and weak counts reach zero.
dangerous routine Shared[T].release()
  var ctrl_ptr = Hijacked[ShareController[T]](me)
  var ctrl = ctrl_ptr.as_entity()
  ctrl.decrease_strong_count()
  return

### Creates a weak reference to the same entity.
### :returns: A new weak handle to the same entity's controller.
routine Shared[T].watch() -> Watched[T]
  danger!
    var ctrl = Hijacked[ShareController[T]](me).as_entity()
    ctrl.increase_weak_count()
    return Watched[T](me)

# ============================================================================
# Inspection
# ============================================================================

### Returns the current strong reference count.
### :returns: The number of live strong handles to this entity.
routine Shared[T].strong_count() -> U64
  danger!
    var ctrl = Hijacked[ShareController[T]](me).as_entity()
    return ctrl.strong_count()

### Returns the current weak reference count.
### :returns: The number of live weak handles to this entity's controller.
routine Shared[T].weak_count() -> U64
  danger!
    var ctrl = Hijacked[ShareController[T]](me).as_entity()
    return ctrl.weak_count()

# ============================================================================
# Display (opaque — the inner value is reachable only through a Phase-3 token)
# ============================================================================

### Returns the textual representation of this value.
### :returns: The resulting `Text` value.
@readonly
routine Shared[T].$represent() -> Text
  danger!
    return me.type_name()

### Returns the diagnostic representation of this value.
### :returns: The resulting `Text` value.
@readonly
routine Shared[T].$diagnose() -> Text
  danger!
    var ctrl = Hijacked[ShareController[T]](me).as_entity()
    var rc = ctrl.strong_count()
    var weak = ctrl.weak_count()
    var addr = ctrl.borrow_data().get_address()
    return me.type_name() + "(holding: " + rc.$represent() + ", observing: " + weak.$represent() + ", addr: " + addr.$represent() + ")"

dangerous routine Shared[T].$destroy()
  me.release()
  return