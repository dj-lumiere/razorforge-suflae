module Core

import BuilderService

### Represents temporary read-only access to an entity.
### `Viewed[T]` is the non-storable borrow type produced by `.view()` for single-threaded observation.
### :typeparam T: The entity type being viewed.
### :see: {Grasped[T]}, {Claimed[T]}, {Inspected[T]}, {Access-Types}
@llvm("ptr")
record Viewed[T] obeys Referring[T]
  pass

### Produces a temporary read-only view of `me`.
### :returns: The resulting `Viewed[T]` value.
routine T.view() -> Viewed[T]
  danger!
    return Viewed[T](me.hijack())

# NOTE: No creators, no manual methods - all operations handled by compiler
# The address member variable is managed internally by the `.view()` implementation
# Users should NEVER create Viewed[T] values directly

# ============================================================================
# Resource management — enables `using entity.view() as v`
# ============================================================================

### Called on entry to a `using` block; no-op for a view (access is already established).
routine Viewed[T].$enter()
  return

### Called on exit from a `using` block; no-op for a view (the compiler handles scope cleanup).
routine Viewed[T].$exit()
  return

# ============================================================================
# Display (transparent - delegates to inner value)
# ============================================================================

### Returns the display form of the viewed entity.
### :returns: The resulting `Text` value.
@readonly
routine Viewed[T].$represent() -> Text
  danger!
    var hijacked = Hijacked[T](me)
    return hijacked.reveal().$represent()

### Returns the diagnostic form of the viewed entity.
### :returns: The resulting `Text` value.
@readonly
routine Viewed[T].$diagnose() -> Text
  danger!
    var hijacked = Hijacked[T](me)
    return me.type_name() + "(" + hijacked.reveal().$diagnose() + ")"
