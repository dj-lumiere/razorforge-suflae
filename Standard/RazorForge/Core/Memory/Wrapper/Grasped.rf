module Core

import BuilderService

### Represents temporary unmanaged mutable access to an entity.
### `Grasped[T]` is the non-storable access type used for explicit low-level manipulation outside the borrow-safe wrappers.
### :typeparam T: The entity type being accessed.
### :see: {Viewed[T]}, {Hijacked[T]}, {Access-Types}
@llvm("ptr")
record Grasped[T] obeys Controlling[T]
  pass

### Produces a temporary unmanaged mutable view of `me`.
### :returns: The resulting `Grasped[T]` value.
### :note: Entity-only. Records are value-typed — `me` would be a by-value copy, so mutating
###        through the returned `Grasped[T]` would write to a stack temporary rather than the
###        caller's storage. Use `entity` for borrowed mutation.
routine T.grasp() -> Grasped[T]
needs T is EntityType
  danger!
    return Grasped[T](me.hijack())

# NOTE: No creators, no manual methods - all operations handled by compiler
# The address member variable is managed internally by the `.grasp()` implementation
# Users should NEVER create Grasped[T] values directly

# ============================================================================
# Resource management — enables `using entity.grasp() as h`
# ============================================================================

### Called on entry to a `using` block; no-op for a grasp (access is already established).
routine Grasped[T].$enter()
  return

### Called on exit from a `using` block; no-op for a grasp (the compiler handles scope cleanup).
routine Grasped[T].$exit()
  return

# ============================================================================
# Display (transparent - delegates to inner value)
# ============================================================================

### Returns the display form of the grasped entity.
### :returns: The resulting `Text` value.
@readonly
routine Grasped[T].$represent() -> Text
  danger!
    var hijacked = Hijacked[T](me)
    return hijacked.reveal().$represent()

### Returns the diagnostic form of the grasped entity.
### :returns: The resulting `Text` value.
@readonly
routine Grasped[T].$diagnose() -> Text
  danger!
    var hijacked = Hijacked[T](me)
    return me.type_name() + "(" + hijacked.reveal().$diagnose() + ")"
