module Math3D

### A double-precision quaternion `w + x·i + y·j + z·k` with `B64` components.
### `Q256` is the high-precision rotation type; use `Q128` for graphics-facing code
### that prefers single precision. A quaternion is a value record (four `B64`
### fields), trivially copyable.
###
### Quaternions form a (non-commutative) division ring, so `Q256` obeys the
### arithmetic protocols `Addable`, `Subtractable`, `Multiplicable` (the Hamilton
### product — note `a·b ≠ b·a`), `Divisible`, `Negatable`, plus `Equatable`.
### Geometry interop uses the shared `B32` `Vector3D`, converting at the boundary.
record Q256 obeys Addable, Subtractable, Multiplicable, Divisible, Negatable, Equatable, Hashable
  ### The real (scalar) component.
  w: B64
  ### The i (x) component.
  x: B64
  ### The j (y) component.
  y: B64
  ### The k (z) component.
  z: B64

# Math routines use the component B64's `_unchecked` ops (raw IEEE, no overflow
# checks); NaN/±inf therefore propagate through the quaternion result per IEEE 754.

# Quaternion constants
preset Q256_ZERO: Q256 = Q256(w: 0.0_b64, x: 0.0_b64, y: 0.0_b64, z: 0.0_b64)
preset Q256_IDENTITY: Q256 = Q256(w: 1.0_b64, x: 0.0_b64, y: 0.0_b64, z: 0.0_b64)

# ============================================================================
# Creators
# ============================================================================

### Constructs a real quaternion `w + 0i + 0j + 0k` from a scalar.
### :param from: The scalar value.
### :returns: The corresponding real quaternion.
routine Q256(from: B64) -> Q256
  return Q256(w: from, x: 0.0_b64, y: 0.0_b64, z: 0.0_b64)

### Widens a `Q128` to `Q256` by extending each component to `B64`.
### :param from: The single-precision quaternion to widen.
### :returns: A `Q256` carrying the same numeric value.
routine Q256(from: Q128) -> Q256
  return Q256(w: B64(from.w), x: B64(from.x), y: B64(from.y), z: B64(from.z))

### Builds a unit rotation quaternion from an axis and an angle (right-hand rule).
### The axis is normalized internally; a zero-length axis yields the identity.
### :param axis: The rotation axis (need not be unit length).
### :param angle: The rotation angle in radians.
### :returns: The unit quaternion representing that rotation.
routine Q256.from_axis_angle(axis: Vector3D, angle: B64) -> Q256
  var ax = B64(axis.x)
  var ay = B64(axis.y)
  var az = B64(axis.z)
  var len = (ax * ax + ay * ay + az * az).sqrt_unchecked()
  if len == 0.0_b64
    return Q256_IDENTITY
  var half = angle * 0.5_b64
  var s = half.sin() / len
  return Q256(w: half.cos(), x: ax * s, y: ay * s, z: az * s)

# ============================================================================
# Arithmetic Operations
# ============================================================================

### Returns the component-wise sum `me + you`.
### :param you: The addend.
### :returns: A `Q256` whose components are the sums.
routine Q256.add(you: Q256) -> Q256
  return Q256(w: me.w + you.w, x: me.x + you.x, y: me.y + you.y, z: me.z + you.z)

### Returns the component-wise difference `me - you`.
### :param you: The value to subtract.
### :returns: A `Q256` whose components are the differences.
routine Q256.sub(you: Q256) -> Q256
  return Q256(w: me.w - you.w, x: me.x - you.x, y: me.y - you.y, z: me.z - you.z)

### Returns the Hamilton product `me · you`. Quaternion multiplication is NOT
### commutative: `me · you` composes `you`'s rotation followed by `me`'s.
### :param you: The right operand.
### :returns: The Hamilton product.
routine Q256.mul(you: Q256) -> Q256
  # Hamilton product of (w1,x1,y1,z1)·(w2,x2,y2,z2).
  return Q256(w: me.w * you.w - me.x * you.x - me.y * you.y - me.z * you.z, x: me.w * you.x + me.x * you.w + me.y * you.z - me.z * you.y, y: me.w * you.y - me.x * you.z + me.y * you.w + me.z * you.x, z: me.w * you.z + me.x * you.y - me.y * you.x + me.z * you.w)

### Returns the quotient `me / you = me · you⁻¹`.
### :param you: The divisor.
### :returns: The quaternion quotient.
routine Q256.truediv(you: Q256) -> Q256
  return me * you.reciprocal()

### Returns this quaternion scaled by a real scalar `factor`.
### :param factor: The scalar multiplier.
### :returns: `factor · me`, component-wise.
routine Q256.scale(factor: B64) -> Q256
  return Q256(w: me.w * factor, x: me.x * factor, y: me.y * factor, z: me.z * factor)

### Returns `me * you` for a real `you` (the same as `scale`).
### :param you: The scalar factor.
### :returns: `you · me`, component-wise.
routine Q256.mul(you: B64) -> Q256
  return me.scale(factor: you)

### Returns `me / you` for a real `you`.
### :param you: The scalar divisor.
### :returns: `me / you`, component-wise.
routine Q256.truediv(you: B64) -> Q256
  return Q256(w: me.w / you, x: me.x / you, y: me.y / you, z: me.z / you)

### Returns the arithmetic negation of this quaternion.
### :returns: A `Q256` with all components negated.
routine Q256.neg() -> Q256
  return Q256(w: -me.w, x: -me.x, y: -me.y, z: -me.z)

# ============================================================================
# Comparison
# ============================================================================

### Returns `true` if all four components compare equal.
### :param you: The value to compare against.
### :returns: `true` if every component of `me` equals the matching component of `you`.
routine Q256.eq(you: Q256) -> Bool
  return me.w == you.w and me.x == you.x and me.y == you.y and me.z == you.z

# ============================================================================
# Properties
# ============================================================================

### Returns the conjugate (negates the vector part).
### :returns: `w − x·i − y·j − z·k`.
routine Q256.conjugate() -> Q256
  return Q256(w: me.w, x: -me.x, y: -me.y, z: -me.z)

### Returns the squared norm (avoids the square root of `abs`).
### :returns: `w² + x² + y² + z²`.
routine Q256.norm() -> B64
  return me.w * me.w + me.x * me.x + me.y * me.y + me.z * me.z

### Returns the norm (magnitude) of this quaternion.
### :returns: `√(w² + x² + y² + z²)`.
routine Q256.abs() -> B64
  return me.norm().sqrt_unchecked()

### Returns the unit quaternion in the same direction. A zero quaternion is
### returned unchanged (its norm is zero).
### :returns: `me / |me|`, or `me` when `|me| == 0`.
routine Q256.normalize() -> Q256
  var n = me.abs()
  if n == 0.0_b64
    return me
  return me.scale(factor: 1.0_b64 / n)

### Returns the multiplicative inverse `me⁻¹ = conj(me) / |me|²`.
### :returns: The quaternion inverse.
routine Q256.reciprocal() -> Q256
  var n = me.norm()
  return me.conjugate().scale(factor: 1.0_b64 / n)

### Returns the dot product of the two quaternions viewed as 4-vectors.
### :param you: The right operand.
### :returns: `w₁w₂ + x₁x₂ + y₁y₂ + z₁z₂`.
routine Q256.dot(you: Q256) -> B64
  return me.w * you.w + me.x * you.x + me.y * you.y + me.z * you.z

# ============================================================================
# Rotation
# ============================================================================

### Rotates a `Vector3D` by this quaternion (assumed unit length), computing
### `q · (0, v) · q⁻¹` via the conjugate. The vector is widened to `B64` for the
### product and narrowed back to `B32` on return.
### :param v: The vector to rotate.
### :returns: The rotated vector.
routine Q256.rotate(v: Vector3D) -> Vector3D
  var p = Q256(w: 0.0_b64, x: B64(v.x), y: B64(v.y), z: B64(v.z))
  var r = me * p * me.conjugate()
  return Vector3D(x: B32(r.x), y: B32(r.y), z: B32(r.z))

### Returns the spherical linear interpolation between `me` (at `t = 0`) and
### `you` (at `t = 1`). Both operands are assumed to be unit quaternions; the
### shorter arc is chosen. Falls back to linear interpolation for nearly
### parallel inputs.
### :param you: The endpoint rotation.
### :param t: The interpolation parameter.
### :returns: The interpolated unit quaternion.
routine Q256.slerp(you: Q256, t: B64) -> Q256
  var d = me.dot(you: you)
  # Choose the shorter arc: if the dot is negative, negate one endpoint.
  var target = you
  if d < 0.0_b64
    target = you.neg()
    d = -d
  # Near-parallel: fall back to normalized linear interpolation to avoid a
  # division by sin(θ) ≈ 0.
  if d > 0.9995_b64
    return (me + (target - me).scale(factor: t)).normalize()
  var theta = d.acos_unchecked()
  var sin_theta = theta.sin()
  var wa = ((1.0_b64 - t) * theta).sin() / sin_theta
  var wb = (t * theta).sin() / sin_theta
  return me.scale(factor: wa) + target.scale(factor: wb)

### Returns the rotation angle encoded by this unit quaternion, in radians.
### :returns: `2·acos(w)`, in the range [0, 2π).
routine Q256.angle() -> B64
  return 2.0_b64 * q256_clamp_unit(v: me.w).acos_unchecked()

### Clamps `v` into [-1, 1], so a unit quaternion whose `w` drifted just past 1 by rounding still has
### a real `acos` (instead of NaN).
routine q256_clamp_unit(v: B64) -> B64
  if v > 1.0_b64
    return 1.0_b64
  if v < -1.0_b64
    return -1.0_b64
  return v

### Returns the rotation axis (unit length) and angle (radians) of this unit quaternion, the inverse of
### `from_axis_angle`. A rotation by 0 has no axis; it reports the x axis with angle 0.
### :returns: A tuple `(axis, angle)`.
routine Q256.to_axis_angle() -> (Vector3D, B64)
  var w = q256_clamp_unit(v: me.w)
  var angle = 2.0_b64 * w.acos_unchecked()
  var s = (1.0_b64 - w * w).sqrt_unchecked()
  if s < 0.000000000001_b64
    return (Vector3D(x: 1.0_b32, y: 0.0_b32, z: 0.0_b32), angle)
  return (Vector3D(x: B32(me.x / s), y: B32(me.y / s), z: B32(me.z / s)), angle)

### Returns the shortest rotation that turns direction `from` onto direction `target` (neither needs to be
### unit length). Opposite directions turn vy half a turn about an axis perpendicular to `from`.
### :param from: The starting direction.
### :param target: The target direction.
### :returns: The unit rotation quaternion.
common routine Q256.from_to(from: Vector3D, target: Vector3D) -> Q256
  var ux = B64(from.x)
  var uy = B64(from.y)
  var uz = B64(from.z)
  var vx = B64(target.x)
  var vy = B64(target.y)
  var vz = B64(target.z)
  var la = (ux * ux + uy * uy + uz * uz).sqrt_unchecked()
  var lb = (vx * vx + vy * vy + vz * vz).sqrt_unchecked()
  if la == 0.0_b64 or lb == 0.0_b64
    return Q256_IDENTITY
  ux = ux / la
  uy = uy / la
  uz = uz / la
  vx = vx / lb
  vy = vy / lb
  vz = vz / lb
  var d = ux * vx + uy * vy + uz * vz
  if d >= 1.0_b64 - 0.000000000001_b64
    return Q256_IDENTITY
  if d <= -1.0_b64 + 0.000000000001_b64
    # Half a turn about an axis perpendicular to `from`: x-axis cross `from`, else y-axis cross `from`.
    var px = 0.0_b64
    var py = -uz
    var pz = uy
    if py * py + pz * pz < 0.000000000001_b64
      px = uz
      py = 0.0_b64
      pz = -ux
    var pl = (px * px + py * py + pz * pz).sqrt_unchecked()
    return Q256(w: 0.0_b64, x: px / pl, y: py / pl, z: pz / pl)
  # (1 + a.b, a cross b), normalized, is the rotation from a to b.
  return Q256(w: 1.0_b64 + d, x: uy * vz - uz * vy, y: uz * vx - ux * vz, z: ux * vy - uy * vx).normalize()

### Returns the normalized linear interpolation between `me` (at `t = 0`) and `you` (at `t = 1`) along
### the shorter arc: cheaper than `slerp`, with a non-constant angular speed.
### :param you: The endpoint rotation.
### :param t: The interpolation parameter.
### :returns: The interpolated unit quaternion.
routine Q256.nlerp(you: Q256, t: B64) -> Q256
  var target = you
  if me.dot(you: you) < 0.0_b64
    target = you.neg()
  return (me + (target - me).scale(factor: t)).normalize()

### Returns `true` if this quaternion has unit length within rounding (`|norm - 1| <= 0.000000000001`).
routine Q256.is_unit() -> Bool
  var d = me.norm() - 1.0_b64
  return d <= 0.000000000001_b64 and d >= -0.000000000001_b64

### Returns the rotation of the upper-left 3x3 part of `m` (assumed a pure rotation), the inverse of
### `Matrix4R4C.from_quaternion`.
### :param m: The rotation matrix.
### :returns: The unit rotation quaternion.
common routine Q256.from_matrix(m: Matrix4R4C) -> Q256
  var m00 = B64(m.get(row: 0u64, col: 0u64))
  var m01 = B64(m.get(row: 0u64, col: 1u64))
  var m02 = B64(m.get(row: 0u64, col: 2u64))
  var m10 = B64(m.get(row: 1u64, col: 0u64))
  var m11 = B64(m.get(row: 1u64, col: 1u64))
  var m12 = B64(m.get(row: 1u64, col: 2u64))
  var m20 = B64(m.get(row: 2u64, col: 0u64))
  var m21 = B64(m.get(row: 2u64, col: 1u64))
  var m22 = B64(m.get(row: 2u64, col: 2u64))
  var trace = m00 + m11 + m22
  # Shepperd: divide by the largest of 4w, 4x, 4y, 4z to stay well conditioned.
  if trace > 0.0_b64
    var sw = (trace + 1.0_b64).sqrt_unchecked() * 2.0_b64
    return Q256(w: 0.25_b64 * sw, x: (m21 - m12) / sw, y: (m02 - m20) / sw, z: (m10 - m01) / sw)
  if m00 > m11 and m00 > m22
    var sx = (1.0_b64 + m00 - m11 - m22).sqrt_unchecked() * 2.0_b64
    return Q256(w: (m21 - m12) / sx, x: 0.25_b64 * sx, y: (m01 + m10) / sx, z: (m02 + m20) / sx)
  if m11 > m22
    var sy = (1.0_b64 + m11 - m00 - m22).sqrt_unchecked() * 2.0_b64
    return Q256(w: (m02 - m20) / sy, x: (m01 + m10) / sy, y: 0.25_b64 * sy, z: (m12 + m21) / sy)
  var sz = (1.0_b64 + m22 - m00 - m11).sqrt_unchecked() * 2.0_b64
  return Q256(w: (m10 - m01) / sz, x: (m02 + m20) / sz, y: (m12 + m21) / sz, z: 0.25_b64 * sz)

### Builds a rotation from Euler angles in radians, applied as yaw about z, then pitch about y, then
### roll about x (the aerospace Z-Y-X order; the rotation is `yaw * pitch * roll`).
### :param roll: The rotation about the x axis.
### :param pitch: The rotation about the y axis.
### :param yaw: The rotation about the z axis.
### :returns: The unit rotation quaternion.
common routine Q256.from_euler(roll: B64, pitch: B64, yaw: B64) -> Q256
  var cr = (roll * 0.5_b64).cos()
  var sr = (roll * 0.5_b64).sin()
  var cp = (pitch * 0.5_b64).cos()
  var sp = (pitch * 0.5_b64).sin()
  var cy = (yaw * 0.5_b64).cos()
  var sy = (yaw * 0.5_b64).sin()
  return Q256(w: cr * cp * cy + sr * sp * sy, x: sr * cp * cy - cr * sp * sy, y: cr * sp * cy + sr * cp * sy, z: cr * cp * sy - sr * sp * cy)

### Returns the Z-Y-X Euler angles `(roll, pitch, yaw)` of this unit quaternion, the inverse of
### `from_euler`. At pitch +-90 degrees (gimbal lock) roll and yaw are not unique; pitch is clamped there.
### :returns: A tuple `(roll, pitch, yaw)` in radians.
routine Q256.to_euler() -> (B64, B64, B64)
  var roll = atan2(y: 2.0_b64 * (me.w * me.x + me.y * me.z), x: 1.0_b64 - 2.0_b64 * (me.x * me.x + me.y * me.y))
  var pitch = q256_clamp_unit(v: 2.0_b64 * (me.w * me.y - me.z * me.x)).asin_unchecked()
  var yaw = atan2(y: 2.0_b64 * (me.w * me.z + me.x * me.y), x: 1.0_b64 - 2.0_b64 * (me.y * me.y + me.z * me.z))
  return (roll, pitch, yaw)

# ============================================================================
# Text Representation
# ============================================================================

### Formats this quaternion as `w+xi+yj+zk` (signs collapse for negatives).
### :returns: The resulting `Text` value.
@override
routine Q256.represent() -> Text
  return me.w.represent() + __q64_term(v: me.x, unit: "i") + __q64_term(v: me.y, unit: "j") + __q64_term(v: me.z, unit: "k")

### Formats this quaternion as `w+xi+yj+zk` with exactly `places` digits after the point in each part
### (see `B64.fixed`).
### :param places: The number of digits after the point.
### :returns: The resulting `Text` value.
routine Q256.fixed(places: U64) -> Text
  return me.w.fixed(places) + q256_fixed_term(v: me.x, unit: "i", places: places) + q256_fixed_term(v: me.y, unit: "j", places: places) + q256_fixed_term(v: me.z, unit: "k", places: places)

### One imaginary term of `fixed`, with an explicit leading sign.
routine q256_fixed_term(v: B64, unit: Text, places: U64) -> Text
  if v < 0.0_b64
    return "-" + v.abs().fixed(places) + unit
  return "+" + v.abs().fixed(places) + unit

### Formats one imaginary term with an explicit leading sign.
### :param v: The component value.
### :param unit: The imaginary unit label (`i`, `j`, or `k`).
### :returns: A `Text` like `+2i` or `-3j`.
routine __q64_term(v: B64, unit: Text) -> Text
  if v < 0.0_b64
    return "-" + v.abs().represent() + unit
  # abs() also collapses negative zero so it prints as `+0`, not `+-0`.
  return "+" + v.abs().represent() + unit

### Returns a diagnostic string wrapping the value with its type name.
### :returns: The resulting `Text` value.
@override
routine Q256.diagnose() -> Text
  return "Q256(" + me.represent() + ")"

# ============================================================================
# Hashing
# ============================================================================

### Returns a SipHash-2-4 keyed hash of this quaternion.
### :param k0: The first 64-bit key word.
### :param k1: The second 64-bit key word.
### :returns: A `U64` keyed hash.
routine Q256.hash(k0: U64, k1: U64) -> U64
  var acc = __hash_round(acc: 0u64, h: me.w.hash(k0: k0, k1: k1))
  acc = __hash_round(acc: acc, h: me.x.hash(k0: k0, k1: k1))
  acc = __hash_round(acc: acc, h: me.y.hash(k0: k0, k1: k1))
  acc = __hash_round(acc: acc, h: me.z.hash(k0: k0, k1: k1))
  return __hash_finalize(h: acc)
