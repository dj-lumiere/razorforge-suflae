module Numerics

### Represents an arbitrary-precision signed integer backed by LibTomMath.
### `Integer` is the unbounded integer type for workloads where fixed-width overflow is not acceptable.
### It preserves exact integer semantics across arithmetic, parsing, and formatting operations.
### :see: {Decimal}, {Complex}, {Numeric-Types}
entity Integer obeys Integral, Divisible, Negatable, Ordered
  ### Stores the native big-integer handle managed by the runtime.
  secret handle: CPtr

# ============================================================================
# Lifecycle Management
# ============================================================================

### Creates the integer value `0`.
### Use this overload when the surrounding context needs an explicit `Integer`
### instead of a fixed-width literal.
### :returns: The resulting `Integer` value.
routine Integer.$create() -> ?Integer
  var int = Integer(handle: rf_bigint_new())
  return int

### Creates an `Integer` from a signed 64-bit source value.
### The numeric payload is copied into the arbitrary-precision runtime handle,
### so the result is no longer limited by `S64` range after construction.
### :param value: The initial signed value.
### :returns: The resulting `Integer` value.
routine Integer.$create(value: S64) -> ?Integer
  var int = Integer(handle: rf_bigint_new())
  rf_bigint_set_i64(int.handle, value)
  return int

### Creates an `Integer` from an unsigned 64-bit source value.
### This is the direct widening entry point for exact conversion from native
### unsigned integer data.
### :param value: The initial unsigned value.
### :returns: The resulting `Integer` value.
routine Integer.$create(value: U64) -> ?Integer
  var int = Integer(handle: rf_bigint_new())
  rf_bigint_set_u64(int.handle, value)
  return int

### Parses an integer from text using the requested radix.
### The input may include the sign and digits accepted by the selected base.
### :param text: The textual integer representation.
### :param radix: The numeric base to use.
### :returns: The resulting `Integer` value.
### :throws: {ValueError} if `text` is not a valid integer in `radix`.
routine Integer.$create!(text: Referring[Text], radix: S32 = 10) -> ?Integer
  var int = Integer(handle: rf_bigint_new())
  var result = rf_bigint_set_str(int.handle, text.to_cstr(), radix)
  if result != 0
    throw ValueError(f"Invalid integer string: {text}")
  return int

### Releases the native big-integer storage owned by this value.
routine Integer.$destroy()
  rf_bigint_clear(me.handle)
  return

### Returns an independent copy of `other`.
### The new value owns its own runtime handle, so later mutations and lifetime
### changes do not affect the source value.
### :param other: The integer value to duplicate.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.$copy(other: Integer) -> ?Integer
  var int = Integer(handle: rf_bigint_new())
  rf_bigint_copy(int.handle, other.handle)
  return int

# ============================================================================
# Arithmetic Operations
# ============================================================================

### Adds `other` to this value using exact integer arithmetic.
### No overflow occurs; the runtime grows the backing storage as needed.
### :param other: The value to add.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.$add(other: Integer) -> ?Integer
  var result = Integer(handle: rf_bigint_new())
  rf_bigint_add(result.handle, me.handle, other.handle)
  return result

### Subtracts `other` from this value using exact integer arithmetic.
### :param other: The value to subtract.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.$sub(other: Integer) -> ?Integer
  var result = Integer(handle: rf_bigint_new())
  rf_bigint_sub(result.handle, me.handle, other.handle)
  return result

### Multiplies this value by `other` using exact integer arithmetic.
### :param other: The value to multiply by.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.$mul(other: Integer) -> ?Integer
  var result = Integer(handle: rf_bigint_new())
  rf_bigint_mul(result.handle, me.handle, other.handle)
  return result

### Divides this value by `other` and returns the Euclidean quotient.
### The remainder is computed internally and discarded.
### :param other: The non-zero divisor.
### :returns: The integer quotient.
@readonly
routine Integer.$floordiv(other: Integer) -> ?Integer
  var quotient = Integer(handle: rf_bigint_new())
  var remainder = Integer(handle: rf_bigint_new())
  rf_bigint_div(quotient.handle, remainder.handle, me.handle, other.handle)
  rf_bigint_clear(remainder.handle)
  return quotient

### Divides this value by `other` and returns the Euclidean remainder.
### :param other: The non-zero divisor.
### :returns: The remainder value associated with `//`.
@readonly
routine Integer.$mod(other: Integer) -> ?Integer
  var result = Integer(handle: rf_bigint_new())
  rf_bigint_mod(result.handle, me.handle, other.handle)
  return result

### Returns the additive inverse of this value.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.$neg() -> ?Integer
  var result = Integer(handle: rf_bigint_new())
  rf_bigint_neg(result.handle, me.handle)
  return result

# ============================================================================
# Comparison Operations
# ============================================================================

### Returns `true` when both values represent the same mathematical integer.
### :param you: The other value to compare against.
### :returns: The resulting `Bool` value.
@readonly
routine Integer.$eq(you: Integer) -> Bool
  return rf_bigint_cmp(me.handle, you.handle) == 0

### Compares this value with `you` using numeric ordering.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@readonly
routine Integer.$cmp(you: Integer) -> ComparisonSign
  var comparison_value = rf_bigint_cmp(me.handle, you.handle)
  if comparison_value < 0
    return ME_SMALL
  elseif comparison_value > 0
    return ME_LARGE
  else
    return SAME

# ============================================================================
# Bitwise Operations
# ============================================================================

### Computes the bitwise AND of this value and `other`.
### :param other: The other operand.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.$bitand(other: Integer) -> ?Integer
  var result = Integer(handle: rf_bigint_new())
  rf_bigint_and(result.handle, me.handle, other.handle)
  return result

### Computes the bitwise OR of this value and `other`.
### :param other: The other operand.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.$bitor(other: Integer) -> ?Integer
  var result = Integer(handle: rf_bigint_new())
  rf_bigint_or(result.handle, me.handle, other.handle)
  return result

### Computes the bitwise XOR of this value and `other`.
### :param other: The other operand.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.$bitxor(other: Integer) -> ?Integer
  var result = Integer(handle: rf_bigint_new())
  rf_bigint_xor(result.handle, me.handle, other.handle)
  return result

### Shifts this value left by `bits` positions.
### Positive left shifts are equivalent to multiplication by powers of two.
### :param bits: The number of bit positions to shift.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.$shl(bits: S32) -> ?Integer
  var result = Integer(handle: rf_bigint_new())
  rf_bigint_shl(result.handle, me.handle, bits)
  return result

### Shifts this value right by `bits` positions.
### :param bits: The number of bit positions to shift.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.$shr(bits: S32) -> ?Integer
  var result = Integer(handle: rf_bigint_new())
  rf_bigint_shr(result.handle, me.handle, bits)
  return result

# ============================================================================
# Math Operations
# ============================================================================

### Returns the absolute magnitude of this value.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.abs() -> ?Integer
  var result = Integer(handle: rf_bigint_new())
  rf_bigint_abs(result.handle, me.handle)
  return result

### Raises this value to a non-negative integer exponent.
### :param exp: The exponent value.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.$pow(exp: U32) -> ?Integer
  var result = Integer(handle: rf_bigint_new())
  rf_bigint_pow(result.handle, me.handle, exp)
  return result

### Returns the integer square root of this value.
### The result is the greatest integer whose square does not exceed the input.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.sqrt() -> ?Integer
  var result = Integer(handle: rf_bigint_new())
  rf_bigint_sqrt(result.handle, me.handle)
  return result

### Computes the greatest common divisor of this value and `other`.
### :param other: The other operand.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.gcd(other: Integer) -> ?Integer
  var result = Integer(handle: rf_bigint_new())
  rf_bigint_gcd(result.handle, me.handle, other.handle)
  return result

### Computes the least common multiple of this value and `other`.
### :param other: The other operand.
### :returns: The resulting `Integer` value.
@readonly
routine Integer.lcm(other: Integer) -> ?Integer
  var result = Integer(handle: rf_bigint_new())
  rf_bigint_lcm(result.handle, me.handle, other.handle)
  return result

# ============================================================================
# Utility Methods
# ============================================================================

### Returns `true` when this value is exactly zero.
### :returns: The resulting `Bool` value.
@readonly
routine Integer.is_zero() -> Bool
  return rf_bigint_is_zero(me.handle) != 0

### Returns `true` when this value is less than zero.
### :returns: The resulting `Bool` value.
@readonly
routine Integer.is_negative() -> Bool
  return rf_bigint_is_neg(me.handle) != 0

### Returns `true` when this value is greater than zero.
### :returns: The resulting `Bool` value.
@readonly
routine Integer.is_positive() -> Bool
  return not me.is_zero() and not me.is_negative()

### Returns the sign of this value as `-1`, `0`, or `1`.
### :returns: The resulting `S32` value.
@readonly
routine Integer.signum() -> S32
  return when
    me.is_positive() => 1
    me.is_negative() => -1
    else => 0

# ============================================================================
# Conversions
# ============================================================================

### Converts an arbitrary-precision integer to `S64`.
### This conversion is intended for values that are known to fit the target
### range.
### :param from: The source value to convert.
### :returns: The resulting `S64` value.
routine S64.$create!(from: Integer) -> S64
  return rf_bigint_get_i64(from.handle)

### Converts an arbitrary-precision integer to `U64`.
### This conversion is intended for non-negative values that fit the target
### range.
### :param from: The source value to convert.
### :returns: The resulting `U64` value.
routine U64.$create!(from: Integer) -> U64
  return rf_bigint_get_u64(from.handle)

### Formats this value as base-10 text. Standard `$represent` shape (no args)
### so the f-string machinery can dispatch without supplying a radix.
### :returns: The resulting `Text` value.
@readonly
routine Integer.$represent() -> ?Text
  return me.represent_radix(radix: 10_s32)

### Formats this value as text in the requested radix.
### Use when base-10 is not sufficient (e.g. hex/binary debugging).
### :param radix: The numeric base to use.
### :returns: The resulting `Text` value.
@readonly
routine Integer.represent_radix(radix: S32) -> ?Text
  var CStr = rf_bigint_get_str(me.handle, radix)
  var text = Text(from: CStr)
  rf_invalidate(pointer_to_int[Byte, Address](CStr.ptr))
  return text

# ============================================================================
# Factory Methods
# ============================================================================

### Parses a base-10 integer from text.
### This is the canonical text-to-`Integer` conversion used by generic parsing
### surfaces.
### :param text: The text to parse.
### :returns: The resulting `Integer` value.
### :throws: May throw {ParseError}.
routine Integer.$create!(text: Referring[Text]) -> ?Integer
  var int = Integer(handle: rf_bigint_new())
  var result = rf_bigint_set_str(int.handle, text.to_cstr(), 10)
  if result != 0
    rf_bigint_clear(int.handle)
    throw ParseError("Invalid integer form")
  return int

### Parses a base-2 integer from text.
### :param text: The binary digits to parse.
### :returns: The resulting `Integer` value.
### :throws: May throw {ParseError}.
@readonly
common routine Integer.from_binary!(text: Referring[Text]) -> ?Integer
  var int = Integer(handle: rf_bigint_new())
  var result = rf_bigint_set_str(int.handle, text.to_cstr(), 2)
  if result != 0
    rf_bigint_clear(int.handle)
    throw ParseError("Invalid integer form")
  return int

### Parses a base-16 integer from text.
### :param text: The hexadecimal digits to parse.
### :returns: The resulting `Integer` value.
### :throws: May throw {ParseError}.
@readonly
common routine Integer.from_hex!(text: Referring[Text]) -> ?Integer
  var int = Integer(handle: rf_bigint_new())
  var result = rf_bigint_set_str(int.handle, text.to_cstr(), 16)
  if result != 0
    rf_bigint_clear(int.handle)
    throw ParseError("Invalid integer form")
  return int

### Returns the additive identity for `Integer`.
### :returns: The resulting `Integer` value.
@readonly
common routine Integer.zero() -> ?Integer
  return Integer(0_s64)

### Returns the multiplicative identity for `Integer`.
### :returns: The resulting `Integer` value.
@readonly
common routine Integer.one() -> ?Integer
  return Integer(1_s64)

# ============================================================================
# Examples
# ============================================================================

### Computes `n!` using iterative multiplication.
### This routine is included as a worked example for larger integer workloads.
### :param n: The non-negative input value.
### :returns: The resulting `Integer` value.
routine factorial(n: Integer) -> ?Integer
  if n.is_zero() or n == Integer.one()
    return Integer.one()

  var result = Integer.one()
  var i = Integer(2_s64)

  while i <= n
    result = result * i
    i = i + Integer.one()

  return result

### Computes the `n`th Fibonacci number using arbitrary-precision integers.
### This routine demonstrates growth beyond fixed-width integer range.
### :param n: The zero-based sequence index.
### :returns: The resulting `Integer` value.
routine fibonacci_big(n: S64) -> ?Integer
  if n <= 1
    return Integer(n)

  var a = Integer.zero()
  var b = Integer.one()

  var i: S64 = 2
  while i <= n
    var temp = a + b
    a = b
    b = temp
    i = i + 1

  return b
