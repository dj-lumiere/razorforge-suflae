# ============================================================================
# Trigonometric Functions (with precision parameter)
# ============================================================================

### Computes the sine of this value, treating it as radians.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.sin(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_sin(result.handle, precision, me.handle)
  return result

### Computes the cosine of this value, treating it as radians.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.cos(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_cos(result.handle, precision, me.handle)
  return result

### Computes the tangent of this value, treating it as radians.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.tan(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_tan(result.handle, precision, me.handle)
  return result

### Computes the principal inverse sine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.asin(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_asin(result.handle, precision, me.handle)
  return result

### Computes the principal inverse cosine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.acos(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_acos(result.handle, precision, me.handle)
  return result

### Computes the principal inverse tangent of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.atan(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_atan(result.handle, precision, me.handle)
  return result

### Computes the polar angle of the point `(x, y)` where this value is `y`.
### This overload preserves quadrant information, unlike `atan(y / x)`.
### :param x: The horizontal coordinate.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.atan2(x: Decimal, precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Decimal
  if x.is_zero()
    return when
      me.is_positive() => Decimal.pi(precision).divide(Decimal(2_s64), precision)
      me.is_negative() => -Decimal.pi(precision).divide(Decimal(2_s64), precision)
      else => Decimal.zero()

  var theta = me.divide(x, precision + 4).atan(precision)
  if x.is_positive()
    return theta

  var pi = Decimal.pi(precision)
  if me.is_negative()
    return theta - pi
  return theta + pi

### Computes the hyperbolic sine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.sinh(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_sinh(result.handle, precision, me.handle)
  return result

### Computes the hyperbolic cosine of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.cosh(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_cosh(result.handle, precision, me.handle)
  return result

### Computes the hyperbolic tangent of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.tanh(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_tanh(result.handle, precision, me.handle)
  return result

# ============================================================================
# Rounding Operations
# ============================================================================

### Rounds this value upward to the next integral decimal value.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.ceil() -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_ceil(result.handle, me.handle)
  return result

### Rounds this value downward to the previous integral decimal value.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.floor() -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_floor(result.handle, me.handle)
  return result

### Rounds this value to the requested number of decimal places.
### :param decimal_places: The number of digits to keep after the decimal point.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.round(decimal_places: S32 = 0) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_round(result.handle, decimal_places, me.handle)
  return result

### Truncates this value toward zero at the requested decimal place.
### :param decimal_places: The number of digits to keep after the decimal point.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.trunc(decimal_places: S32 = 0) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_trunc(result.handle, decimal_places, me.handle)
  return result

# ============================================================================
# Utility Methods
# ============================================================================

### Returns `true` when this value is exactly zero.
### :returns: The resulting `Bool` value.
@readonly
routine Decimal.is_zero() -> Bool
  return rf_bigdec_is_zero(me.handle) != 0

### Returns `true` when this value is less than zero.
### :returns: The resulting `Bool` value.
@readonly
routine Decimal.is_negative() -> Bool
  return rf_bigdec_is_neg(me.handle) != 0

### Returns `true` when this value is greater than zero.
### :returns: The resulting `Bool` value.
@readonly
routine Decimal.is_positive() -> Bool
  return not me.is_zero() and not me.is_negative()

### Returns the sign of this value as `-1`, `0`, or `1`.
### :returns: The resulting `S32` value.
@readonly
routine Decimal.signum() -> S32
  return when
    me.is_positive() => 1
    me.is_negative() => -1
    else => 0

# ============================================================================
# Conversions
# ============================================================================

### Converts this decimal to `S64`.
### This is intended for integral decimal values that fit the target range.
### :param from: The source value to convert.
### :returns: The resulting `S64` value.
routine S64.$create(from: Decimal) -> S64
  return rf_bigdec_get_i64(from.handle)

### Converts this decimal to `F64`.
### This may round because the target uses binary floating-point representation.
### :param from: The source value to convert.
### :returns: The resulting `F64` value.
routine F64.$create(from: Decimal) -> F64
  return rf_bigdec_get_f64(from.handle)

### Formats this decimal as text with the requested fractional precision.
### :param decimal_places: The number of decimal places to emit.
### :returns: The resulting `Text` value.
@readonly
routine Decimal.$represent(decimal_places: S32 = 10) -> Text
  var CStr = rf_bigdec_get_str(me.handle, decimal_places)
  var text = Text.from_cstr(CStr)
  rf_invalidate(pointer_to_int[Byte, Address](CStr.ptr))
  return text

# ============================================================================
# Constants (computed with high precision)
# ============================================================================

### Returns the constant pi computed to the requested decimal precision.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.pi(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_pi(result.handle, precision)
  return result

### Returns Euler's number computed to the requested precision.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.e(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_e(result.handle, precision)
  return result

# ============================================================================
# Factory Methods
# ============================================================================

### Parses a decimal value and returns it in `Maybe` form.
### This surface matches parsing APIs that communicate failure through absence
### rather than exceptions.
### :param text: The text to parse.
### :returns: The resulting `Maybe[Owned[Decimal]]` value.
@readonly
routine Decimal.parse(text: Referring[Text]) -> Maybe[Owned[Decimal]]
  var dec = Decimal(handle: rf_bigdec_new())
  rf_bigdec_set_str(dec.handle, text.to_cstr())
  # MAPM doesn't return error codes for parsing, so we just return the result
  return dec

### Returns the additive identity for `Decimal`.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.zero() -> Decimal
  return Decimal(0_s64)

### Returns the multiplicative identity for `Decimal`.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.one() -> Decimal
  return Decimal(1_s64)

# ============================================================================
# Examples
# ============================================================================

### Approximates `e^x` with a Taylor-series expansion.
### This routine is included as a reference implementation, not as the preferred
### production path over the built-in runtime binding.
### :param x: The exponent input.
### :param terms: The number of series terms to accumulate.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
routine exp_taylor(x: Decimal, terms: S32 = 20, precision: S32 = 50) -> Decimal
  var result = Decimal.one()
  var term = Decimal.one()

  var i: S32 = 1
  while i <= terms
    term = term * x
    term = term.divide(Decimal(S64!(i)), precision)
    result = result + term
    i = i + 1

  return result

### Approximates `sqrt(x)` with Newton iteration.
### This routine is included as an educational example of user-space decimal
### algorithms.
### :param x: The input value.
### :param iterations: The number of refinement steps to perform.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
routine sqrt_newton(x: Decimal, iterations: S32 = 20, precision: S32 = 50) -> Decimal
  if x.is_zero() or x.is_negative()
    return Decimal.zero()

  var guess = x.divide(Decimal(2_s64), precision)
  var two = Decimal(2_s64)

  var i: S32 = 0
  while i < iterations
    # Newton-Raphson: guess = (guess + x/guess) / 2
    var quotient = x.divide(guess, precision)
    var sum = guess + quotient
    guess = sum.divide(two, precision)
    i = i + 1

  return guess

### Computes pi with a Machin-style arctangent identity.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
routine compute_pi(precision: S32 = 50) -> Decimal
  var one = Decimal.one()
  var four = Decimal(4_s64)
  var five = Decimal(5_s64)
  var two_thirty_nine = Decimal(239_s64)

  var atan_1_5 = one.divide(five, precision + 10).atan(precision + 10)
  var atan_1_239 = one.divide(two_thirty_nine, precision + 10).atan(precision + 10)

  var pi_over_4 = four * atan_1_5 - atan_1_239
  return four * pi_over_4
