### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.sqrt(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_sqrt(result.handle, precision, me.handle)
  return result

### Raises this value to the power `exp`.
### :param exp: The exponent value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.pow(exp: Decimal, precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_pow(result.handle, precision, me.handle, exp.handle)
  return result

### Computes `e^x` for this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.exp(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_exp(result.handle, precision, me.handle)
  return result

### Computes the natural logarithm of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.log(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_log(result.handle, precision, me.handle)
  return result

### Computes the base-10 logarithm of this value.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.log10(precision: S32 = DECIMAL_DEFAULT_PRECISION) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_log10(result.handle, precision, me.handle)
