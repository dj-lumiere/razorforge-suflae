module Numerics
preset DECIMAL_DEFAULT_PRECISION: S32 = 50

### Represents an arbitrary-precision decimal floating-point value backed by decNumber.
### `Decimal` is intended for exact decimal-domain workloads such as finance, formatting, and high-precision analysis.
### It trades fixed-size machine arithmetic for controllable precision and decimal-oriented behavior.
### :see: {Integer}, {Complex}, {Numeric-Types}
entity Decimal obeys Numeric, Ordered
  ### Stores the native decimal handle managed by the runtime.
  secret handle: BigDecHandle

# ============================================================================
# Lifecycle Management
# ============================================================================

### Creates the decimal value `0`.
### :returns: The resulting `Decimal` value.
routine Decimal.$create() -> Decimal
  var dec = Decimal(handle: rf_bigdec_new())
  rf_bigdec_set_i64(dec.handle, 0)
  return dec

### Creates a decimal from a signed 64-bit integer.
### This conversion is exact because every `S64` value has a finite decimal
### representation.
### :param value: The initial integer value.
### :returns: The resulting `Decimal` value.
routine Decimal.$create(value: S64) -> Decimal
  var dec = Decimal(handle: rf_bigdec_new())
  rf_bigdec_set_i64(dec.handle, value)
  return dec

### Creates a decimal from a 64-bit floating-point value.
### The source binary float is converted to decimal form, so the resulting
### value reflects the exact `F64` payload rather than an idealized decimal
### literal.
### :param value: The initial floating-point value.
### :returns: The resulting `Decimal` value.
routine Decimal.$create(value: F64) -> Decimal
  var dec = Decimal(handle: rf_bigdec_new())
  rf_bigdec_set_f64(dec.handle, value)
  return dec

### Parses a decimal value from text.
### The accepted syntax follows the runtime decimal parser and is intended for
### exact decimal-domain input rather than binary floating-point notation rules.
### :param text: The textual decimal representation.
### :returns: The resulting `Decimal` value.
routine Decimal.$create!(text: Referring[Text]) -> Decimal
  var dec = Decimal(handle: rf_bigdec_new())
  rf_bigdec_set_str(dec.handle, text.to_cstr())
  return dec

### Releases the native decimal storage owned by this value.
routine Decimal.$destroy()
  rf_bigdec_free(me.handle)
  return

### Returns an independent copy of `other`.
### The returned value owns its own runtime handle and precision state.
### :param other: The decimal value to duplicate.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.$copy(other: Decimal) -> Decimal
  var dec = Decimal(handle: rf_bigdec_copy(other.handle))
  return dec

# ============================================================================
# Arithmetic Operations
# ============================================================================

### Adds `other` to this value.
### :param other: The value to add.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.$add(other: Decimal) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_add(result.handle, me.handle, other.handle)
  return result

### Subtracts `other` from this value.
### :param other: The value to subtract.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.$sub(other: Decimal) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_sub(result.handle, me.handle, other.handle)
  return result

### Multiplies this value by `other`.
### :param other: The value to multiply by.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.$mul(other: Decimal) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_mul(result.handle, me.handle, other.handle)
  return result

### Divides this value by `other` using the default decimal precision policy.
### Use `divide` when the caller needs explicit control over produced scale.
### :param other: The non-zero divisor.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.$truediv(other: Decimal) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_div(result.handle, DECIMAL_DEFAULT_PRECISION, me.handle, other.handle)
  return result

### Divides this value by `other` using an explicit precision budget.
### The precision argument controls how many decimal places the runtime should
### preserve in the produced quotient.
### :param other: The non-zero divisor.
### :param precision: The decimal precision to use.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.divide(other: Decimal, precision: S32) -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_div(result.handle, precision, me.handle, other.handle)
  return result

### Returns the additive inverse of this value.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.$neg() -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_neg(result.handle, me.handle)
  return result

# ============================================================================
# Comparison Operations
# ============================================================================

### Returns `true` when both values represent the same decimal quantity.
### :param other: The other value to compare against.
### :returns: The resulting `Bool` value.
@readonly
routine Decimal.$eq(other: Decimal) -> Bool
  return rf_bigdec_cmp(me.handle, other.handle) == 0

### Compares this value with `you` using numeric ordering.
### :param you: The other value to compare against.
### :returns: The resulting `ComparisonSign` value.
@readonly
routine Decimal.$cmp(you: Decimal) -> ComparisonSign
  var value = rf_bigdec_cmp(me.handle, you.handle)
  if value < 0
    return ME_SMALL
  elseif value > 0
    return ME_LARGE
  return SAME

# ============================================================================
# Math Operations (with precision parameter)
# ============================================================================

### Returns the absolute magnitude of this value.
### :returns: The resulting `Decimal` value.
@readonly
routine Decimal.abs() -> Decimal
  var result = Decimal(handle: rf_bigdec_new())
  rf_bigdec_abs(result.handle, me.handle)
  return result

