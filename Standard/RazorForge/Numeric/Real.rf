routine Real.sin(precision: S32) -> Real
  danger
    var mark = C::rf_region_mark()
    var r = real_from_bf(x: bf_sin(a: real_bf(r: me), prec: real_prec_bits(digits: precision), fl: 0u32))
    C::rf_region_release(mark: mark)
    return r

