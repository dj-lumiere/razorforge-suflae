# --- Precision-aware variants (precision = decimal significant digits) ---

### Divides this value by `other`, rounding to `precision` decimal digits.
@readonly
routine Real.divide(other: Real, precision: S32) -> Real
  var result = Real(handle: rf_real_new(), ctrl: ImmutableSharedController().hijack())
  rf_real_div_p(result: result.handle, a: me.handle, b: other.handle, prec: precision)
  return result

### Square root to `precision` decimal digits.
@readonly
routine Real.sqrt(precision: S32) -> Real
  var result = Real(handle: rf_real_new(), ctrl: ImmutableSharedController().hijack())
  rf_real_sqrt_p(result: result.handle, a: me.handle, prec: precision)
  return result

