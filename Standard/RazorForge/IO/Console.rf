module IO/Console

# ============================================================================
# Output: show() - Standard Output (stdout)
# ============================================================================
### Writes one or more values to standard output.
### The variadic overload inserts `sep` between values and appends `end` after the last value.
### :param value...: The values to write.
### :param sep: The separator written between successive values.
### :param end: The trailing text written after the last value.
#   routine show(value...: Representable, sep: Text = " ", end: Text = "\n")           # Automatic dispatch

### Writes text to standard output.
### `end` is appended after `value`.
### :param value: The text to write.
### :param end: The trailing text to append.
routine show(value: Referring[Text], end: Referring[Text] = "\n")
  var value_cstr = CStr(from: value)
  rf_console_show(value_cstr.ptr, value_cstr.count())
  var end_cstr = CStr(from: end)
  rf_console_show(end_cstr.ptr, end_cstr.count())
  return

### Writes raw bytes to standard output.
### `end` is appended after `value`.
### :param value: The bytes to write.
### :param end: The trailing text to append.
routine show(value: Referring[Bytes], end: Referring[Text] = "\n")
  var value_cstr = CStr(from: value)
  rf_console_show(value_cstr.ptr, value_cstr.count())
  var end_cstr = CStr(from: end)
  rf_console_show(end_cstr.ptr, end_cstr.count())
  return

### Writes a single value to standard output using its representable form.
### :param value: The value to render and write.
### :param end: The trailing text to append.
routine show[T](value: T, end: Text = "\n")
  var text = value.$represent()
  var value_cstr = CStr(from: text)
  rf_console_show(value_cstr.ptr, value_cstr.count())
  var end_cstr = CStr(from: end)
  rf_console_show(end_cstr.ptr, end_cstr.count())
  return

### Writes multiple values to standard output.
### Values are rendered one by one with `sep` inserted between them.
### :param values...: The values to render and write.
### :param sep: The separator written between values.
### :param end: The trailing text written after the final value.
routine show[T](values...: T, sep: Text = " ", end: Text = "\n")
  var first = true
  for v in values
    if not first
      show(sep, end: "")
    show(v, end: "")
    first = false
  show("", end: end)
  return

# ============================================================================
# Output: alert() - Standard Error (stderr)
# ============================================================================

### Writes text to standard error.
### :param value: The text to write.
### :param end: The trailing text to append.
routine alert(value: Referring[Text], end: Referring[Text] = "\n")
  var value_cstr = CStr(from: value)
  rf_console_alert(value_cstr.ptr, value_cstr.count())
  var end_cstr = CStr(from: end)
  rf_console_alert(end_cstr.ptr, end_cstr.count())
  return

### Writes raw bytes to standard error.
### :param value: The bytes to write.
### :param end: The trailing text to append.
routine alert(value: Referring[Bytes], end: Referring[Text] = "\n")
  var value_cstr = CStr(from: value)
  rf_console_alert(value_cstr.ptr, value_cstr.count())
  var end_cstr = CStr(from: end)
  rf_console_alert(end_cstr.ptr, end_cstr.count())
  return

### Writes a single value to standard error using its diagnostic form.
### :param value: The value to render and write.
### :param end: The trailing text to append.
routine alert[T](value: T, end: Text = "\n")
  var text = value.$diagnose()
  var value_cstr = CStr(from: text)
  rf_console_alert(value_cstr.ptr, value_cstr.count())
  var end_cstr = CStr(from: end)
  rf_console_alert(end_cstr.ptr, end_cstr.count())
  return

### Writes multiple values to standard error.
### Values are rendered one by one with `sep` inserted between them.
### :param values...: The values to render and write.
### :param sep: The separator written between values.
### :param end: The trailing text written after the final value.
routine alert[T](values...: T, sep: Text = " ", end: Text = "\n")
  var first = true
  for v in values
    if not first
      alert(sep, end: "")
    alert(v, end: "")
    first = false
  alert("", end: end)
  return

# ============================================================================
# Input: Text functions (default)
# ============================================================================

### Reads one line of text from standard input.
### Line termination is not included in the returned text.
### :returns: The resulting `Text` value.
routine ask_line() -> Text
  var ptr = rf_console_ask_line()
  if ptr.is_none()
    return ""
  var bytes = Bytes(ptr: ptr)
  return bytes.decode_as_utf8_lossy()

### Reads one whitespace-delimited word from standard input.
### :returns: The resulting `Text` value.
routine ask_word() -> Text
  var ptr = rf_console_ask_word()
  if ptr.is_none()
    return ""
  var bytes = Bytes(ptr: ptr)
  return bytes.decode_as_utf8_lossy()

### Reads all remaining text from standard input.
### :returns: The resulting `Text` value.
routine ask_all() -> Text
  var ptr = rf_console_ask_all()
  if ptr.is_none()
    return ""
  var bytes = Bytes(ptr: ptr)
  return bytes.decode_as_utf8_lossy()

### Reads all remaining input and splits it into lines.
### Windows line endings are normalized before splitting.
### :returns: The resulting `List[Owned[Text]]` value.
routine ask_lines() -> List[Owned[Text]]
  var all = ask_all()
  var normalized = all.replace("\r\n", "\n")
  return normalized.split(CHARACTER_NEWLINE)

### Reads all remaining input and splits it into whitespace-delimited words.
### :returns: The resulting `List[Owned[Text]]` value.
routine ask_words() -> List[Owned[Text]]
  var all = ask_all()
  return all.words()

# ============================================================================
# Input: Bytes functions (opt-in)
# ============================================================================

### Reads all remaining standard input as raw bytes.
### :returns: The resulting `Bytes` value.
routine ask_raw() -> Bytes
  var ptr = rf_console_ask_all()
  if ptr.is_none()
    return Bytes()
  return Bytes(ptr: ptr)

### Reads up to `count` bytes from standard input.
### :param count: The maximum number of bytes to read.
### :returns: The resulting `Bytes` value.
routine ask_bytes(count: U64) -> Bytes
  var ptr = rf_console_ask_bytes(count)
  if ptr.is_none()
    return Bytes()
  return Bytes(ptr: ptr)
