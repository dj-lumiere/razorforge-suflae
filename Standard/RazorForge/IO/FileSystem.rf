module IO/FileSystem
import IO/Errors

# ============================================================================
# Existence checks (pure, no crash)
# ============================================================================

### Returns whether a path exists.
### This performs a non-throwing existence check suitable for preflight logic.
### :param path: The path to test.
### :returns: The resulting `Bool` value.
routine exists(path: Text) -> Bool
  var cstr = CStr(from: path)
  return rf_fs_exists(path: cstr, len: cstr.count().S32())

### Returns whether a path refers to a regular file.
### Missing paths return `false`.
### :param path: The path to test.
### :returns: The resulting `Bool` value.
routine is_file(path: Text) -> Bool
  var cstr = CStr(from: path)
  return rf_fs_is_file(path: cstr, len: cstr.count().S32())

### Returns whether a path refers to a directory.
### Missing paths return `false`.
### :param path: The path to test.
### :returns: The resulting `Bool` value.
routine is_directory(path: Text) -> Bool
  var cstr = CStr(from: path)
  return rf_fs_is_directory(path: cstr, len: cstr.count().S32())

# ============================================================================
# Directory operations (failable)
# ============================================================================

### Creates a single directory.
### Parent directories must already exist.
### :param path: The directory path to create.
### :throws: May throw {IOError}.
routine create_dir!(path: Text)
  var cstr = CStr(from: path)
  var result = rf_fs_create_dir(path: cstr, len: cstr.count().S32())
  if result == -1
    throw IOError(description: f"Cannot create directory: {path}")
  return

### Creates a directory and any missing parents.
### This is the recursive directory-creation helper.
### :param path: The directory path to create.
### :throws: May throw {IOError}.
routine create_dir_all!(path: Text)
  var cstr = CStr(from: path)
  var result = rf_fs_create_dir_all(path: cstr, len: cstr.count().S32())
  if result == -1
    throw IOError(description: f"Cannot create directories: {path}")
  return

# ============================================================================
# File operations (failable)
# ============================================================================

### Copies a single filesystem entry (a file) to a new location.
### Existing destination handling follows the runtime's native copy semantics.
### Named `copy_path!` (not `copy!`) because a bare `copy` collides with the
### structural `copy` derive verb. Use `copy_path_all!` for a directory tree.
### :param source: The source path.
### :param destination: The destination path.
### :throws: May throw {IOError}.
routine copy_path!(source: Text, destination: Text)
  var src_cstr = CStr(from: source)
  var dst_cstr = CStr(from: destination)
  var result = rf_fs_copy(src_cstr, src_cstr.count().S32(), dst_cstr, dst_cstr.count().S32())
  if result == -1
    throw IOError(description: f"Cannot copy '{source}' to '{destination}'")
  return

### Recursively copies a file or directory tree to a new location.
### When `source` is a file this is a single copy; when it is a directory the tree
### is recreated under `destination` (created if missing), copying every descendant.
### This is the recursive counterpart to `copy_path!`, mirroring `delete_path_all!`.
### Symlinks are NOT followed, so this cannot loop on link cycles. Existing
### destination files are overwritten following `copy_path!`'s native semantics.
### :param source: The source path.
### :param destination: The destination path.
### :throws: May throw {IOError} when any entry cannot be copied.
routine copy_path_all!(source: Text, destination: Text)
  if is_directory(path: source)
    create_dir_all!(path: destination)
    each entry in list_dir_entries!(path: source)
      var src_child = join_path(a: source, b: entry.name)
      var dst_child = join_path(a: destination, b: entry.name)
      copy_path_all!(source: src_child, destination: dst_child)
  else
    copy_path!(source: source, destination: destination)
  return

### Moves or renames a filesystem entry.
### This may behave as a rename within one filesystem or as a move across locations.
### :param source: The source path.
### :param destination: The destination path.
### :throws: May throw {IOError}.
routine move!(source: Text, destination: Text)
  var src_cstr = CStr(from: source)
  var dst_cstr = CStr(from: destination)
  var result = rf_fs_move(src_cstr, src_cstr.count().S32(), dst_cstr, dst_cstr.count().S32())
  if result == -1
    throw IOError(description: f"Cannot move '{source}' to '{destination}'")
  return

### Removes a file or empty directory.
### Use `delete_path_all!` when recursive removal is required.
### :param path: The path to remove.
### :throws: May throw {IOError}.
routine delete_path!(path: Text)
  var cstr = CStr(from: path)
  var result = rf_fs_remove(path: cstr, len: cstr.count().S32())
  if result == -1
    throw IOError(description: "Cannot remove path")
  return

### Removes a directory tree recursively.
### This is the destructive removal helper for non-empty paths.
### :param path: The path to remove.
### :throws: May throw {IOError}.
routine delete_path_all!(path: Text)
  var cstr = CStr(from: path)
  var result = rf_fs_remove_all(path: cstr, len: cstr.count().S32())
  if result == -1
    throw IOError(description: "Cannot remove directory tree")
  return

# ============================================================================
# Path utilities (pure, no OS calls)
# ============================================================================

### Joins two path segments.
### This uses the platform path separator rules implemented by the runtime.
### :param a: The left-hand path segment.
### :param b: The right-hand path segment.
### :returns: The resulting `Text` value.
routine join_path(a: Text, b: Text) -> Text
  var a_cstr = CStr(from: a)
  var b_cstr = CStr(from: b)
  var ptr = rf_fs_join_path(a_cstr, a_cstr.count().S32(), b_cstr, b_cstr.count().S32())
  var len = rf_get_result_len()
  var bytes = Bytes(ptr: ptr, count: len)
  return bytes.decode_as_utf8_lossy()

### Returns the parent directory path.
### Paths without a parent return the runtime's normalized empty-parent representation.
### :param path: The path to inspect.
### :returns: The resulting `Text` value.
routine parent_path(path: Text) -> Text
  var cstr = CStr(from: path)
  var ptr = rf_fs_parent_path(path: cstr, len: cstr.count().S32())
  var len = rf_get_result_len()
  var bytes = Bytes(ptr: ptr, count: len)
  return bytes.decode_as_utf8_lossy()

### Returns the final path component.
### Directory separators are removed from the returned value.
### :param path: The path to inspect.
### :returns: The resulting `Text` value.
routine file_name(path: Text) -> Text
  var cstr = CStr(from: path)
  var ptr = rf_fs_file_name(path: cstr, len: cstr.count().S32())
  var len = rf_get_result_len()
  var bytes = Bytes(ptr: ptr, count: len)
  return bytes.decode_as_utf8_lossy()

### Returns the final path component without its extension.
### Hidden-file semantics follow the runtime path parser.
### :param path: The path to inspect.
### :returns: The resulting `Text` value.
routine file_stem(path: Text) -> Text
  var cstr = CStr(from: path)
  var ptr = rf_fs_file_stem(path: cstr, len: cstr.count().S32())
  var len = rf_get_result_len()
  var bytes = Bytes(ptr: ptr, count: len)
  return bytes.decode_as_utf8_lossy()

### Returns the file extension.
### The returned value omits the leading dot when an extension is present.
### :param path: The path to inspect.
### :returns: The resulting `Text` value.
routine extension(path: Text) -> Text
  var cstr = CStr(from: path)
  var ptr = rf_fs_extension(path: cstr, len: cstr.count().S32())
  var len = rf_get_result_len()
  var bytes = Bytes(ptr: ptr, count: len)
  return bytes.decode_as_utf8_lossy()

# ============================================================================
# Path resolution (OS calls, failable)
# ============================================================================

### Resolves a path to an absolute path.
### This preserves symbolic links and other non-canonical path components.
### :param path: The path to resolve.
### :returns: The resulting `Text` value.
### :throws: May throw {IOError}.
routine absolute_path!(path: Text) -> Text
  var cstr = CStr(from: path)
  var ptr = rf_fs_absolute_path(path: cstr, len: cstr.count().S32())
  var len = rf_get_result_len()
  if ptr.is_none()
    throw IOError(description: f"Cannot resolve absolute path: {path}")
  var bytes = Bytes(ptr: ptr, count: len)
  return bytes.decode_as_utf8_lossy()

### Resolves a path to its canonical filesystem location.
### The returned path reflects the filesystem's normalized casing and link resolution rules.
### This follows the runtime's normalization rules for links and relative segments.
### :param path: The path to resolve.
### :returns: The resulting `Text` value.
### :throws: May throw {IOError}.
routine canonical_path!(path: Text) -> Text
  var cstr = CStr(from: path)
  var ptr = rf_fs_canonical_path(path: cstr, len: cstr.count().S32())
  var len = rf_get_result_len()
  if ptr.is_none()
    throw IOError(description: f"Cannot resolve canonical path: {path}")
  var bytes = Bytes(ptr: ptr, count: len)
  return bytes.decode_as_utf8_lossy()

# ============================================================================
# Permissions
# ============================================================================

### Returns whether the current process can read a path.
### This check is non-throwing and is intended for capability probes.
### :param path: The path to test.
### :returns: The resulting `Bool` value.
routine can_read(path: Text) -> Bool
  var cstr = CStr(from: path)
  return rf_fs_can_read(path: cstr, len: cstr.count().S32())

### Returns whether the current process can write to a path.
### This check is non-throwing and is intended for capability probes.
### :param path: The path to test.
### :returns: The resulting `Bool` value.
routine can_write(path: Text) -> Bool
  var cstr = CStr(from: path)
  return rf_fs_can_write(path: cstr, len: cstr.count().S32())

### Returns whether the current process can execute a path.
### This check is non-throwing and is intended for capability probes.
### :param path: The path to test.
### :returns: The resulting `Bool` value.
routine can_execute(path: Text) -> Bool
  var cstr = CStr(from: path)
  return rf_fs_can_execute(path: cstr, len: cstr.count().S32())

### Enables or disables the readonly attribute for a path.
### This adjusts filesystem metadata rather than keeping an in-memory flag.
### :param path: The path to modify.
### :param readonly: `true` to enable readonly mode; `false` to disable it.
### :throws: May throw {IOError}.
routine set_readonly!(path: Text, readonly: Bool = true)
  var cstr = CStr(from: path)
  var result = rf_fs_set_readonly(cstr, cstr.count().S32(), readonly)
  if result == -1
    throw IOError(description: f"Cannot set readonly on: {path}")
  return

# ============================================================================
# Directory listing
# ============================================================================

### Returns the direct entries of a directory as bare names.
### The final path component only is returned for each entry; join onto `path`
### for a full path. Order follows the platform directory-iteration order, and
### `.` / `..` are omitted. An empty directory yields an empty list.
### :param path: The directory to list.
### :returns: The resulting `List[Text]` of entry names.
### :throws: May throw {IOError} when the path cannot be listed.
routine list_dir!(path: Text) -> List[Text]
  var cstr = CStr(from: path)
  var ptr = rf_fs_list_dir(path: cstr, len: cstr.count().S32())
  var len = rf_get_result_len()
  if ptr.is_none()
    throw IOError(description: f"Cannot list directory: {path}")
  if len == 0u64
    return List[Text]()
  var bytes = Bytes(ptr: ptr, count: len)
  var joined = bytes.decode_as_utf8_lossy()
  return joined.split(separator: '\n')

### One directory entry: its bare name and whether it is a directory.
record DirEntry
  name: Text               # The final path component
  is_directory: Bool       # Whether the entry is a directory

### Returns the direct entries of a directory WITH their kind, in one directory read.
### Prefer this over `list_dir!` + `is_directory` when walking a tree: the kind comes
### for free from the OS directory read, so no extra `stat` per entry is needed.
### `.` / `..` are omitted; an empty directory yields an empty list.
### :param path: The directory to list.
### :returns: The resulting `List[DirEntry]`.
### :throws: May throw {IOError} when the path cannot be listed.
routine list_dir_entries!(path: Text) -> List[DirEntry]
  var cstr = CStr(from: path)
  var ptr = rf_fs_list_dir_typed(path: cstr, len: cstr.count().S32())
  var len = rf_get_result_len()
  if ptr.is_none()
    throw IOError(description: f"Cannot list directory: {path}")
  var result = List[DirEntry]()
  if len == 0u64
    return result
  var bytes = Bytes(ptr: ptr, count: len)
  var joined = bytes.decode_as_utf8_lossy()
  each line in joined.split(separator: '\n')
    # Each line is `<kind><name>` — 'd' for a directory, 'f' otherwise.
    var is_dir = line[0u64] == 'd'
    var name = line[1u64 til ^0]
    result.add_last(value: DirEntry(name: name, is_directory: is_dir))
  return result

# ============================================================================
# Metadata
# ============================================================================

### Filesystem metadata for a path, captured in a single stat.
record FileMetadata
  size: S64                # Size in bytes
  modified: Moment         # Last-modification time
  created: Moment          # Creation time (inode-change time on POSIX, best-effort)
  is_directory: Bool       # Whether the path is a directory
  readonly: Bool           # Whether the path is marked readonly

### Reads filesystem metadata for a path in a single stat.
### :param path: The path to inspect.
### :returns: The resulting `FileMetadata` value.
### :throws: May throw {IOError} when the path cannot be inspected.
routine metadata!(path: Text) -> FileMetadata
  var cstr = CStr(from: path)
  var status = rf_fs_metadata(path: cstr, len: cstr.count().S32())
  if status == -1
    throw IOError(description: f"Cannot read metadata: {path}")
  return FileMetadata(
    size: rf_fs_meta_size(),
    modified: Moment.from_timestamp(seconds: rf_fs_meta_modified()),
    created: Moment.from_timestamp(seconds: rf_fs_meta_created()),
    is_directory: rf_fs_meta_is_directory(),
    readonly: rf_fs_meta_readonly())

### Returns the size of a regular file in bytes.
### This is a convenience over `metadata!` when only the size is needed.
### :param path: The file path to inspect.
### :returns: The resulting size in bytes.
### :throws: May throw {IOError} when the path cannot be inspected.
routine file_size!(path: Text) -> S64
  var cstr = CStr(from: path)
  var size = rf_fs_file_size(path: cstr, len: cstr.count().S32())
  if size == -1s64
    throw IOError(description: f"Cannot read file size: {path}")
  return size

# ============================================================================
# Working directory & standard directories (OS calls)
# ============================================================================

### Returns the current working directory of the process.
### :returns: The resulting `Text` value.
### :throws: May throw {IOError} when the working directory cannot be read.
routine current_dir!() -> Text
  var ptr = rf_fs_current_dir()
  var len = rf_get_result_len()
  if ptr.is_none()
    throw IOError(description: "Cannot read current working directory")
  var bytes = Bytes(ptr: ptr, count: len)
  return bytes.decode_as_utf8_lossy()

### Changes the current working directory of the process.
### :param path: The directory to switch to.
### :throws: May throw {IOError} when the directory cannot be entered.
routine set_current_dir!(path: Text)
  var cstr = CStr(from: path)
  var result = rf_fs_set_current_dir(path: cstr, len: cstr.count().S32())
  if result == -1
    throw IOError(description: f"Cannot change directory to: {path}")
  return

### Returns the platform temporary directory.
### This honors the usual environment variables and never fails.
### :returns: The resulting `Text` value.
routine temp_dir() -> Text
  var ptr = rf_fs_temp_dir()
  var len = rf_get_result_len()
  var bytes = Bytes(ptr: ptr, count: len)
  return bytes.decode_as_utf8_lossy()

### Returns the current user's home directory.
### :returns: The resulting `Text` value.
### :throws: May throw {IOError} when the home directory cannot be determined.
routine home_dir!() -> Text
  var ptr = rf_fs_home_dir()
  var len = rf_get_result_len()
  if ptr.is_none()
    throw IOError(description: "Cannot determine home directory")
  var bytes = Bytes(ptr: ptr, count: len)
  return bytes.decode_as_utf8_lossy()

### Creates an empty file, or updates its modification time when it already exists.
### Parent directories must already exist.
### :param path: The file path to touch.
### :throws: May throw {IOError} when the file cannot be created or updated.
routine touch!(path: Text)
  var cstr = CStr(from: path)
  var result = rf_fs_touch(path: cstr, len: cstr.count().S32())
  if result == -1
    throw IOError(description: f"Cannot touch: {path}")
  return

# ============================================================================
# Path builders (pure, no OS calls)
# ============================================================================

### Splits a path into its file stem and extension.
### The stem is the final component without its extension; the extension omits
### the leading dot. A path without an extension yields an empty extension.
### The extension is returned WITHOUT a leading dot, so it round-trips through
### `with_extension` (`with_extension(p, split_extension(p).extension)`).
### :param path: The path to split.
### :returns: A `(stem, extension)` tuple.
routine split_extension(path: Text) -> (Text, Text)
  return (file_stem(path: path), extension(path: path))

### Returns the path with its extension replaced.
### An empty `ext` drops the extension entirely. The directory portion is preserved.
### :param path: The path to rebuild.
### :param ext: The new extension WITHOUT a leading dot (e.g. `"png"`).
### :returns: The resulting `Text` value.
routine with_extension(path: Text, ext: Text) -> Text
  var stem = file_stem(path: path)
  var base = if ext.is_empty() then stem else f"{stem}.{ext}"
  var dir = parent_path(path: path)
  return if dir.is_empty() then base else join_path(a: dir, b: base)

### Returns the path with its final component replaced.
### The directory portion is preserved.
### :param path: The path to rebuild.
### :param name: The new final component.
### :returns: The resulting `Text` value.
routine with_file_name(path: Text, name: Text) -> Text
  var dir = parent_path(path: path)
  return if dir.is_empty() then name else join_path(a: dir, b: name)

# ============================================================================
# Recursive traversal
# ============================================================================

### Returns every descendant path under a directory, recursively.
### Each returned path is a full path built by joining onto `path`; directories
### are included alongside files, in the platform directory-iteration order
### (a directory appears before its own contents). An empty directory yields an
### empty list. Symlinks are NOT followed, so this cannot loop on link cycles.
### :param path: The root directory to walk.
### :returns: The resulting `List[Text]` of descendant paths.
### :throws: May throw {IOError} when any directory in the tree cannot be listed.
routine walk_dir!(path: Text) -> List[Text]
  var result = List[Text]()
  each entry in list_dir_entries!(path: path)
    var full = join_path(a: path, b: entry.name)
    result.add_last(value: full)
    if entry.is_directory
      each descendant in walk_dir!(path: full)
        result.add_last(value: descendant)
  return result
