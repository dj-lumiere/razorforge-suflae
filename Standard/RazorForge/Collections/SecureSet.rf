module Collections

import BuilderService
import Core.SecureHashKey

preset SECURE_SET_INITIAL_CAPACITY: U64 = 16u64
preset CTRL_EMPTY: U8 = 128_u8
preset CTRL_DELETED: U8 = 254_u8
preset CTRL_H2_MASK: U8 = 127_u8

### A set of unique values backed by an open-addressed hash table hardened against hash-flooding attacks.
###
### `SecureSet[T]` works like {Set[T]} but uses SipHash-2-4 keyed with a per-instance secret
### to make the probe sequence unpredictable to external attackers. This prevents
### worst-case O(n) behaviour that arises when an adversary can craft inputs that all collide
### in an ordinary set.
###
### Each `SecureSet` instance carries its own randomly generated (or caller-supplied) hash
### key, so two sets holding the same elements will generally have different probe structures.
### Iteration order is not sorted and is not stable across instances or rehashes.
###
### **When to use**
### - You are storing data derived from untrusted input (e.g. tokens, user-supplied strings, request IDs).
### - You need membership testing with a security guarantee against hash-flooding.
### - Use plain {Set[T]} instead when the element space is fully trusted and throughput matters more.
###
### **Complexity**
### | Operation | Average | Worst case |
### |---|---|---|
### | `add` | O(1) | O(n) (rehash) |
### | `remove` | O(1) | O(n) |
### | `$contains` | O(1) | O(n) |
### | Iteration | O(capacity) | O(capacity) |
###
### :typeparam T: The element type. Must obey {SecureHashable} and {Equatable}.
### :see: {Set[T]} for an unsecured but faster general-purpose set.
### :see: {SecureDict[K, V]} for the dictionary counterpart.
entity SecureSet[T] obeys Iterable[T]
needs T obeys SecureHashable, Equatable
  secret ctrl: Hijacked[U8]
  secret slots: Hijacked[T]
  secret count: U64
  secret deleted: U64
  secret capacity: U64
  secret k0: U64
  secret k1: U64

# ============================================================================
# Creators
# ============================================================================

### Creates an empty secure set with a freshly generated secure-hash key.
routine SecureSet[T].$create() -> SecureSet[T]
  return SecureSet[T](key: SecureHashKey.random())

### Creates an empty secure set with the supplied secure-hash key.
### :param key: The SipHash-2-4 key used for all hash computations in this instance.
routine SecureSet[T].$create(key: SecureHashKey) -> SecureSet[T]
  var cap = SECURE_SET_INITIAL_CAPACITY
  var set = SecureSet[T](
    ctrl: hijacked_none[U8](),
    slots: hijacked_none[T](),
    count: 0u64,
    deleted: 0u64,
    capacity: cap,
    k0: key.k0,
    k1: key.k1
  )
  danger!
    set.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](set.ctrl), value: CTRL_EMPTY, size: cap)
    set.slots = hijacked_from[T](rf_allocate_dynamic_uninit(T.data_size() * cap))
  return set

### Creates an empty secure set pre-sized to hold at least `capacity` live elements without rehashing.
### The actual slot count is rounded up to the next power-of-two.
### :param key: The SipHash-2-4 key used for all hash computations in this instance.
### :param capacity: Minimum number of live elements to accommodate before the first rehash.
routine SecureSet[T].$create(key: SecureHashKey, capacity: U64) -> SecureSet[T]
  var cap = SECURE_SET_INITIAL_CAPACITY
  while cap < capacity
    cap = cap *% 2u64
  var set = SecureSet[T](
    ctrl: hijacked_none[U8](),
    slots: hijacked_none[T](),
    count: 0u64,
    deleted: 0u64,
    capacity: cap,
    k0: key.k0,
    k1: key.k1
  )
  danger!
    set.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](set.ctrl), value: CTRL_EMPTY, size: cap)
    set.slots = hijacked_from[T](rf_allocate_dynamic_uninit(T.data_size() * cap))
  return set

### Releases the raw control and element buffers owned by this set.
routine SecureSet[T].$destroy()
  danger!
    if not me.ctrl.is_none()
      rf_invalidate(pointer_to_int[U8, Address](me.ctrl))
    if not me.slots.is_none()
      rf_invalidate(pointer_to_int[T, Address](me.slots))
  return

# ============================================================================
# Internal Helpers
# ============================================================================

### Extracts the 7-bit control-byte fingerprint from a raw hash value.
### :param hash: The raw SipHash output.
### :returns: The low 7 bits of `hash`, used to filter candidate slots before a full equality check.
routine SecureSet[T].h2(hash: U64) -> U8
  return U8(hash & U64(CTRL_H2_MASK))

### Derives the primary probe slot index from a raw hash value.
### :param hash: The raw SipHash output.
### :returns: The upper bits of `hash`, used as the starting slot before masking to the table size.
routine SecureSet[T].h1(hash: U64) -> U64
  return hash >> 7u32

### Searches for `value` by linear probing from its primary secure-hash slot.
### Control-byte fingerprints are checked before full element equality to reduce element loads.
### :param value: The element to find.
### :returns: The slot index of `value` if found, or `capacity` if the element is absent.
routine SecureSet[T].find_slot(value: T) -> U64
  var h = value.$secure_hash(k0: me.k0, k1: me.k1)
  var target = me.h2(h)
  var mask = me.capacity -% 1u64
  var i = me.h1(h) & mask
  danger!
    loop
      var c = me.ctrl.offset(U8.data_size() * i).extract()
      if c == CTRL_EMPTY
        return me.capacity
      if c == target
        if me.slots.offset(T.data_size() * i).extract() == value
          return i
      i = (i +% 1u64) & mask
  return me.capacity

### Writes `val` into the first empty or deleted slot reached from the probe position of `h`.
### Assumes the caller has already checked for duplicates and will update `count` separately.
### :param h: The raw SipHash output for `val`.
### :param val: The element to write.
routine SecureSet[T].insert_raw(h: U64, val: T)
  var h2_val = me.h2(h)
  var mask = me.capacity -% 1u64
  var i = me.h1(h) & mask
  danger!
    loop
      var c = me.ctrl.offset(U8.data_size() * i).extract()
      if c == CTRL_EMPTY
        me.ctrl.offset(U8.data_size() * i).inject(h2_val)
        me.slots.offset(T.data_size() * i).inject(val)
        return
      if c == CTRL_DELETED
        me.ctrl.offset(U8.data_size() * i).inject(h2_val)
        me.slots.offset(T.data_size() * i).inject(val)
        me.deleted = me.deleted -% 1u64
        return
      i = (i +% 1u64) & mask
  return

### Returns true when the combined live and tombstone load exceeds 87.5% of capacity.
### Both live elements and tombstones occupy probe space, so both count toward the load threshold.
### :returns: `true` if a rehash should happen before the next insertion.
routine SecureSet[T].should_rehash() -> Bool
  return (me.count +% me.deleted) *% 8u64 >= me.capacity *% 7u64

### Doubles the table capacity and reinserts all live elements into the new table.
### Tombstones are discarded during the rebuild; secure hashes are recomputed from the same instance key.
routine SecureSet[T].rehash()
  var old_cap = me.capacity
  var old_ctrl = me.ctrl
  var old_slots = me.slots
  var new_cap = old_cap *% 2u64

  danger!
    me.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(new_cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](me.ctrl), value: CTRL_EMPTY, size: new_cap)
    me.slots = hijacked_from[T](rf_allocate_dynamic_uninit(T.data_size() * new_cap))
  me.capacity = new_cap
  me.count = 0u64
  me.deleted = 0u64

  var i = 0u64
  while i < old_cap
    danger!
      var c = old_ctrl.offset(U8.data_size() * i).extract()
      if c != CTRL_EMPTY and c != CTRL_DELETED
        var val = old_slots.offset(T.data_size() * i).extract()
        me.insert_raw(h: val.$secure_hash(k0: me.k0, k1: me.k1), val: val)
        me.count = me.count +% 1u64
    i = i +% 1u64

  danger!
    if not old_ctrl.is_none()
      rf_invalidate(pointer_to_int[U8, Address](old_ctrl))
    if not old_slots.is_none()
      rf_invalidate(pointer_to_int[T, Address](old_slots))
  return

# ============================================================================
# Core Operations
# ============================================================================

### Returns the number of live elements currently stored.
### :returns: The live element count.
routine SecureSet[T].count() -> U64
  return me.count

### Returns true if this set contains no live elements.
### :returns: `true` when `count()` is zero.
routine SecureSet[T].is_empty() -> Bool
  return me.count == 0u64

### Removes every element while preserving the current slot capacity and hash key.
routine SecureSet[T].clear()
  danger!
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](me.ctrl), value: CTRL_EMPTY, size: me.capacity)
  me.count = 0u64
  me.deleted = 0u64
  return

### Returns true if `value` is present in the set.
### :param value: The element to look up.
### :returns: `true` if the element exists.
@readonly
routine SecureSet[T].$contains(value: T) -> Bool
  return me.find_slot(value) < me.capacity

### Inserts `value` if it is not already present.
### :param value: The element to insert.
### :returns: `true` if the element was inserted; `false` if it was already present.
routine SecureSet[T].add(value: T) -> Bool
  if me.should_rehash()
    me.rehash()
  if me.find_slot(value) < me.capacity
    return false
  me.insert_raw(h: value.$secure_hash(k0: me.k0, k1: me.k1), val: value)
  me.count = me.count +% 1u64
  return true

### Removes `value` if it is present in the set.
### :param value: The element to remove.
### :returns: `true` if the element was found and removed; `false` if not present.
routine SecureSet[T].remove(value: T) -> Bool
  var slot = me.find_slot(value)
  if slot >= me.capacity
    return false
  danger!
    me.ctrl.offset(U8.data_size() * slot).inject(CTRL_DELETED)
  me.count = me.count -% 1u64
  me.deleted = me.deleted +% 1u64
  return true

# ============================================================================
# Iteration
# ============================================================================

### Returns an iterator over all live elements in slot order.
### Iteration order is not sorted and is not stable across rehashes or across different instances.
@readonly
routine SecureSet[T].$iter() -> SecureSetIterator[T]
  danger!
    return SecureSetIterator[T](
      ctrl: me.ctrl,
      slots: me.slots,
      capacity: me.capacity,
      slot: 0u64
    )

### Iterator that walks the raw slot array of a {SecureSet[T]} and yields only live elements.
### Empty and deleted (tombstone) slots are silently skipped.
### :typeparam T: The element type yielded by the iterator.
entity SecureSetIterator[T] obeys Iterator[T]
  secret ctrl: Hijacked[U8]
  secret slots: Hijacked[T]
  secret capacity: U64
  secret slot: U64

### Advances to the next live slot and returns its element.
### :returns: The next live element.
### :absent: No live slots remain.
@writable
routine SecureSetIterator[T].$next!() -> T
  danger!
    while me.slot < me.capacity
      var s = me.slot
      me.slot = me.slot + 1u64
      var c = me.ctrl.offset(U8.data_size() * s).extract()
      if c != CTRL_EMPTY and c != CTRL_DELETED
        return me.slots.offset(T.data_size() * s).extract()
  absent

# ============================================================================
# Display
# ============================================================================

### Returns a compact text representation of the set contents.
### Elements are rendered in iteration (slot) order, enclosed in braces.
routine SecureSet[T].$represent() -> Text
  if me.is_empty()
    return "{}"
  var result = "{"
  var first = true
  for val in me
    if not first
      result = result + ", "
    result = result + val.$represent()
    first = false
  result = result + "}"
  return result

### Returns a diagnostic form that includes the runtime type name and live element count.
routine SecureSet[T].$diagnose() -> Text
  var result = me.type_name() + "(count: " + me.count().$represent() + ", {"
  var first = true
  for val in me
    if not first
      result = result + ", "
    result = result + val.$represent()
    first = false
  result = result + "})"
  return result

# ============================================================================
# Comparison
# ============================================================================

### Returns true if both sets contain exactly the same elements.
### :param other: The other set to compare against.
### :returns: `true` if both have the same count and every element in this set is also in `other`.
routine SecureSet[T].$eq(other: SecureSet[T]) -> Bool
  if me.count != other.count
    return false
  for val in me
    if val notin other
      return false
  return true
