module Collections

import BuilderService

preset FAST_DICT_INITIAL_CAPACITY: U64 = 16u64
preset FAST_DICT_INITIAL_ENTRIES: U64 = 16u64
preset CTRL_EMPTY: U8 = 128_u8
preset CTRL_TOMBSTONED: U8 = 254_u8
preset CTRL_H2_MASK: U8 = 127_u8
preset ENTRY_DEAD: U8 = 0_u8
preset ENTRY_LIVE: U8 = 1_u8

### An insertion-ordered key-value dictionary backed by an open-addressed hash table.
###
### `FastDict[K, V]` maps each unique key to exactly one value. Inserting a key that
### already exists replaces its value in place without changing its position in
### iteration order. Lookup, insertion, and removal all run in O(1) average time.
### Iteration visits live entries in the order they were first inserted, and is
### stable across lookups, updates, and rehashes. Removing a key and re-adding it
### places the entry at the new end of the iteration order.
###
### The table uses Python-style "compact dict" layout: a probe array of indices
### into a dense, append-only entries array. The probe array carries the
### SwissTable-style H1/H2 control bytes; the entries array carries the keys,
### values, and a per-entry live byte so removed entries can be skipped without
### shifting later entries.
###
### **When to use**
### - You need O(1) average key lookup, insertion, or removal.
### - You need to associate values with arbitrary keys.
### - You want iteration to follow the order keys were first added.
### - Use {SortedDict[K, V]} instead when you need entries in key order.
### - Use {Dict[K, V]} (the default) for any keys coming from untrusted input.
###
### **Complexity**
### | Operation | Average | Worst case |
### |---|---|---|
### | `add` | O(1) | O(n) (rehash) |
### | `remove` | O(1) | O(n) |
### | `$contains` / `get_or_default` | O(1) | O(n) |
### | `keys()` / `values()` / `entries()` | O(n) | O(n) |
### | Iteration | O(n + tombstones) | O(n + tombstones) |
###
### :typeparam K: The key type. Must obey {Hashable} and {Equatable}.
### :typeparam V: The value type associated with each key.
### :see: {Set[K]} for key-only storage with the same hash table design.
### :see: {SortedDict[K, V]} for sorted key-value storage.
### :see: {Dict[K, V]} for the safe-by-default counterpart used with untrusted input.
entity FastDict[K, V] obeys Iterable[DictEntry[K, V]]
needs K obeys FastHashable, Equatable
  secret ctrl: Hijacked[U8]         # 1 byte/probe slot: 128=empty, 254=deleted, 0-127=H2
  secret indices: Hijacked[U64]     # probe slot -> entry index
  secret keys: Hijacked[K]          # dense entries array, insertion-ordered
  secret vals: Hijacked[V]          # dense entries array, insertion-ordered
  secret entry_live: Hijacked[U8]   # 1 byte/entry: 1=live, 0=tombstoned
  secret count: U64                 # live entry count
  secret deleted: U64               # ctrl tombstone count (probe-space pressure)
  secret entries_used: U64          # high-water mark in entries (live + tombstoned)
  secret capacity: U64              # probe table length, always a power of two
  secret entries_cap: U64           # entries array length, always a power of two

# ============================================================================
# Creators
# ============================================================================

### Creates an empty dictionary using the default initial table size.
routine FastDict[K, V].$create() -> FastDict[K, V]
  var cap = FAST_DICT_INITIAL_CAPACITY
  var ecap = FAST_DICT_INITIAL_ENTRIES
  var dict = FastDict[K, V](
    ctrl: hijacked_none[U8](),
    indices: hijacked_none[U64](),
    keys: hijacked_none[K](),
    vals: hijacked_none[V](),
    entry_live: hijacked_none[U8](),
    count: 0u64,
    deleted: 0u64,
    entries_used: 0u64,
    capacity: cap,
    entries_cap: ecap
  )
  danger!
    dict.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](dict.ctrl), value: CTRL_EMPTY, size: cap)
    dict.indices = Hijacked[U64](rf_allocate_dynamic_uninit(U64.data_size() * cap))
    dict.keys = hijacked_from[K](rf_allocate_dynamic_uninit(K.data_size() * ecap))
    dict.vals = hijacked_from[V](rf_allocate_dynamic_uninit(V.data_size() * ecap))
    dict.entry_live = Hijacked[U8](rf_allocate_dynamic_uninit(ecap))
  return dict

### Creates an empty dictionary pre-sized to hold at least `capacity` live entries without rehashing.
### Both the probe table and the entries array are rounded up to the next power-of-two.
### :param capacity: Minimum number of live entries to accommodate before the first rehash.
routine FastDict[K, V].$create(capacity: U64) -> FastDict[K, V]
  var cap = FAST_DICT_INITIAL_CAPACITY
  while cap < capacity
    cap = cap *% 2u64
  var ecap = FAST_DICT_INITIAL_ENTRIES
  while ecap < capacity
    ecap = ecap *% 2u64
  var dict = FastDict[K, V](
    ctrl: hijacked_none[U8](),
    indices: hijacked_none[U64](),
    keys: hijacked_none[K](),
    vals: hijacked_none[V](),
    entry_live: hijacked_none[U8](),
    count: 0u64,
    deleted: 0u64,
    entries_used: 0u64,
    capacity: cap,
    entries_cap: ecap
  )
  danger!
    dict.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](dict.ctrl), value: CTRL_EMPTY, size: cap)
    dict.indices = Hijacked[U64](rf_allocate_dynamic_uninit(U64.data_size() * cap))
    dict.keys = hijacked_from[K](rf_allocate_dynamic_uninit(K.data_size() * ecap))
    dict.vals = hijacked_from[V](rf_allocate_dynamic_uninit(V.data_size() * ecap))
    dict.entry_live = Hijacked[U8](rf_allocate_dynamic_uninit(ecap))
  return dict

### Releases the raw probe, index, key, value, and entry-liveness buffers owned by this dictionary.
routine FastDict[K, V].$destroy()
  danger!
    if not me.ctrl.is_none()
      rf_invalidate(pointer_to_int[U8, Address](me.ctrl))
    if not me.indices.is_none()
      rf_invalidate(pointer_to_int[U64, Address](me.indices))
    if not me.keys.is_none()
      rf_invalidate(pointer_to_int[K, Address](me.keys))
    if not me.vals.is_none()
      rf_invalidate(pointer_to_int[V, Address](me.vals))
    if not me.entry_live.is_none()
      rf_invalidate(pointer_to_int[U8, Address](me.entry_live))
  return

# ============================================================================
# Internal Helpers
# ============================================================================

### Extracts the 7-bit control-byte fingerprint from a raw hash value.
### :param hash: The raw hash output from `$hash`.
### :returns: The low 7 bits of `hash`, used to filter candidate probe slots before a full key comparison.
@readonly
routine FastDict[K, V].h2(hash: U64) -> U8
  return U8(hash & U64(CTRL_H2_MASK))

### Derives the primary probe slot index from a raw hash value.
### :param hash: The raw hash output from `$hash`.
### :returns: The upper bits of `hash`, used as the starting slot before masking to the table size.
@readonly
routine FastDict[K, V].h1(hash: U64) -> U64
  return hash >> 7u32

### Returns the entry index referenced by probe slot `slot`.
### Assumes the caller has already confirmed the slot is occupied.
### :param slot: The probe slot index.
### :returns: The entry index stored in that probe slot.
@readonly
routine FastDict[K, V].read_index(slot: U64) -> U64
  danger!
    return me.indices.offset(U64.data_size() * slot).extract()

### Returns the key stored at entry index `ei` without checking whether the entry is live.
### :param ei: The entry index to read from.
### :returns: The key at that entry.
@readonly
routine FastDict[K, V].read_key_at(ei: U64) -> K
  danger!
    return me.keys.offset(K.data_size() * ei).extract()

### Returns the value stored at entry index `ei` without checking whether the entry is live.
### :param ei: The entry index to read from.
### :returns: The value at that entry.
@readonly
routine FastDict[K, V].read_val_at(ei: U64) -> V
  danger!
    return me.vals.offset(V.data_size() * ei).extract()

### Overwrites the value at entry index `ei`.
### :param ei: The entry index to write to.
### :param val: The new value to store.
routine FastDict[K, V].write_val_at(ei: U64, val: V)
  danger!
    me.vals.offset(V.data_size() * ei).inject(val)
  return

### Searches for `key` by linear probing from its primary slot.
### Control-byte fingerprints are checked before the index dereference + key equality.
### :param key: The key to find.
### :returns: The probe slot index of `key` if found, or `capacity` if the key is absent.
@readonly
routine FastDict[K, V].find_slot(key: K) -> U64
  var h = key.$hash()
  var target = me.h2(h)
  var mask = me.capacity -% 1u64
  var i = me.h1(h) & mask
  danger!
    loop
      var c = me.ctrl.offset(i).extract()
      if c == CTRL_EMPTY
        return me.capacity
      if c == target
        var ei = me.indices.offset(U64.data_size() * i).extract()
        if me.keys.offset(K.data_size() * ei).extract() == key
          return i
      i = (i +% 1u64) & mask
  return me.capacity

### Writes `entry_index` into the first empty or deleted probe slot reached from the probe position of `h`.
### Assumes the caller has already checked for duplicates and will update `count` separately.
### :param h: The raw hash output for the key at `entry_index`.
### :param entry_index: The index into the entries array to record.
routine FastDict[K, V].insert_index_raw(h: U64, entry_index: U64)
  var h2_val = me.h2(h)
  var mask = me.capacity -% 1u64
  var i = me.h1(h) & mask
  danger!
    loop
      var c = me.ctrl.offset(i).extract()
      if c == CTRL_EMPTY
        me.ctrl.offset(i).inject(h2_val)
        me.indices.offset(U64.data_size() * i).inject(entry_index)
        return
      if c == CTRL_TOMBSTONED
        me.ctrl.offset(i).inject(h2_val)
        me.indices.offset(U64.data_size() * i).inject(entry_index)
        me.deleted = me.deleted -% 1u64
        return
      i = (i +% 1u64) & mask
  return

### Returns true when probe-table or entries-array pressure crosses the rehash threshold.
### The probe table rehashes at 87.5% combined live+tombstone load; the entries array compacts
### when it has no room for a new append.
### :returns: `true` if a rehash should happen before the next insertion.
@readonly
routine FastDict[K, V].should_rehash() -> Bool
  if (me.count +% me.deleted) *% 8u64 >= me.capacity *% 7u64
    return true
  if me.entries_used >= me.entries_cap
    return true
  return false

### Rebuilds the probe table and compacts the entries array, preserving insertion order.
### The probe table doubles when its load is the trigger; the entries array doubles when
### compacting alone would leave less than half its slots free. Tombstones are discarded.
@migratable
routine FastDict[K, V].rehash()
  var old_cap = me.capacity
  var old_ecap = me.entries_cap
  var old_ctrl = me.ctrl
  var old_indices = me.indices
  var old_keys = me.keys
  var old_vals = me.vals
  var old_entry_live = me.entry_live
  var old_entries_used = me.entries_used

  var table_pressured = (me.count +% me.deleted) *% 8u64 >= old_cap *% 7u64
  var new_cap = old_cap
  if table_pressured
    new_cap = old_cap *% 2u64

  var new_ecap = old_ecap
  if me.count *% 2u64 >= old_ecap
    new_ecap = old_ecap *% 2u64

  danger!
    me.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(new_cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](me.ctrl), value: CTRL_EMPTY, size: new_cap)
    me.indices = Hijacked[U64](rf_allocate_dynamic_uninit(U64.data_size() * new_cap))
    me.keys = hijacked_from[K](rf_allocate_dynamic_uninit(K.data_size() * new_ecap))
    me.vals = hijacked_from[V](rf_allocate_dynamic_uninit(V.data_size() * new_ecap))
    me.entry_live = Hijacked[U8](rf_allocate_dynamic_uninit(new_ecap))
  me.capacity = new_cap
  me.entries_cap = new_ecap
  me.count = 0u64
  me.deleted = 0u64
  me.entries_used = 0u64

  var i = 0u64
  while i < old_entries_used
    danger!
      var live = old_entry_live.offset(i).extract()
      if live == ENTRY_LIVE
        var k = old_keys.offset(K.data_size() * i).extract()
        var v = old_vals.offset(V.data_size() * i).extract()
        var new_ei = me.entries_used
        me.keys.offset(K.data_size() * new_ei).inject(k)
        me.vals.offset(V.data_size() * new_ei).inject(v)
        me.entry_live.offset(new_ei).inject(ENTRY_LIVE)
        me.entries_used = me.entries_used +% 1u64
        me.insert_index_raw(h: k.$hash(), entry_index: new_ei)
        me.count = me.count +% 1u64
    i = i +% 1u64

  danger!
    if not old_ctrl.is_none()
      rf_invalidate(pointer_to_int[U8, Address](old_ctrl))
    if not old_indices.is_none()
      rf_invalidate(pointer_to_int[U64, Address](old_indices))
    if not old_keys.is_none()
      rf_invalidate(pointer_to_int[K, Address](old_keys))
    if not old_vals.is_none()
      rf_invalidate(pointer_to_int[V, Address](old_vals))
    if not old_entry_live.is_none()
      rf_invalidate(pointer_to_int[U8, Address](old_entry_live))
  return

# ============================================================================
# Core Operations
# ============================================================================

### Returns the number of live key-value entries currently stored.
### :returns: The live entry count.
@readonly
routine FastDict[K, V].count() -> U64
  return me.count

### Returns true if this dictionary contains no live entries.
### :returns: `true` when `count()` is zero.
@readonly
routine FastDict[K, V].is_empty() -> Bool
  return me.count == 0u64

### Removes every entry while preserving the current probe and entries capacities.
### Resets the probe control array to all-empty in one pass and rewinds the entries
### high-water mark; per-entry live bytes are implicitly invalidated.
@migratable
routine FastDict[K, V].clear()
  danger!
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](me.ctrl), value: CTRL_EMPTY, size: me.capacity)
  me.count = 0u64
  me.deleted = 0u64
  me.entries_used = 0u64
  return

### Returns true if `key` is present in the dictionary.
### :param key: The key to look up.
### :returns: `true` if the key exists.
@readonly
routine FastDict[K, V].$contains(key: K) -> Bool
  return me.find_slot(key) < me.capacity

### Inserts `key` with `value`, or updates the existing entry's value when `key` is already present.
### Updates leave the entry's position in iteration order unchanged.
### :param key: The key to insert or update.
### :param value: The value to associate with `key`.
### :returns: `true` if a new entry was inserted; `false` if an existing entry was updated.
@migratable
routine FastDict[K, V].add(key: K, value: V) -> Bool
  if me.should_rehash()
    me.rehash()
  var slot = me.find_slot(key)
  if slot < me.capacity
    var existing_ei = me.read_index(slot)
    me.write_val_at(ei: existing_ei, val: value)
    return false
  var ei = me.entries_used
  danger!
    me.keys.offset(K.data_size() * ei).inject(key)
    me.vals.offset(V.data_size() * ei).inject(value)
    me.entry_live.offset(ei).inject(ENTRY_LIVE)
  me.entries_used = me.entries_used +% 1u64
  me.insert_index_raw(h: key.$hash(), entry_index: ei)
  me.count = me.count +% 1u64
  return true

### Removes the entry associated with `key`, if present.
### The entry's slot in the entries array becomes a tombstone and is reclaimed on the next rehash.
### :param key: The key to remove.
### :returns: `true` if the key was found and removed; `false` if not present.
@migratable
routine FastDict[K, V].remove(key: K) -> Bool
  var slot = me.find_slot(key)
  if slot >= me.capacity
    return false
  var ei = me.read_index(slot)
  danger!
    me.ctrl.offset(slot).inject(CTRL_TOMBSTONED)
    me.entry_live.offset(ei).inject(ENTRY_DEAD)
  me.count = me.count -% 1u64
  me.deleted = me.deleted +% 1u64
  return true

### Returns the value associated with `key`, or `default_value` when the key is absent.
### :param key: The key to look up.
### :param default_value: The fallback value returned when `key` is not present.
### :returns: The mapped value if found, otherwise `default_value`.
@readonly
routine FastDict[K, V].get_or_default(key: K, default_value: V) -> V
  var slot = me.find_slot(key)
  if slot >= me.capacity
    return default_value
  return me.read_val_at(me.read_index(slot))

# ============================================================================
# Indexing
# ============================================================================

### Returns the value associated with `key`.
### :param key: The key to look up.
### :returns: The value mapped to `key`.
### :absent: The key is not present in the dictionary.
@readonly
routine FastDict[K, V].$getitem!(key: K) -> V
  var slot = me.find_slot(key)
  if slot >= me.capacity
    absent
  return me.read_val_at(me.read_index(slot))

### Updates the value associated with `key`.
### Leaves the entry's position in iteration order unchanged.
### :param key: The key to update.
### :param value: The replacement value.
### :absent: The key is not present in the dictionary.
routine FastDict[K, V].$setitem!(key: K, value: V)
  if key notin me
    absent
  var slot = me.find_slot(key)
  me.write_val_at(ei: me.read_index(slot), val: value)
  return

# ============================================================================
# Keys / Values / Entries
# ============================================================================

### Returns all live keys in insertion order.
### :returns: A {List[K]} of every key; order matches the sequence in which the keys were first added.
@readonly
routine FastDict[K, V].keys() -> List[K]
  var result = List[K](me.count)
  var i = 0u64
  while i < me.entries_used
    danger!
      if me.entry_live.offset(i).extract() == ENTRY_LIVE
        result.add_last(me.keys.offset(K.data_size() * i).extract())
    i = i +% 1u64
  return result

### Returns all live values in insertion order.
### :returns: A {List[V]} of every value; order matches the corresponding `keys()` call.
@readonly
routine FastDict[K, V].values() -> List[V]
  var result = List[V](me.count)
  var i = 0u64
  while i < me.entries_used
    danger!
      if me.entry_live.offset(i).extract() == ENTRY_LIVE
        result.add_last(me.vals.offset(V.data_size() * i).extract())
    i = i +% 1u64
  return result

### Returns all live entries in insertion order.
### :returns: A {List[DictEntry[K, V]]} of every key-value pair; order matches the sequence in which the keys were first added.
@readonly
routine FastDict[K, V].entries() -> List[DictEntry[K, V]]
  var result = List[DictEntry[K, V]](me.count)
  var i = 0u64
  while i < me.entries_used
    danger!
      if me.entry_live.offset(i).extract() == ENTRY_LIVE
        var k = me.keys.offset(K.data_size() * i).extract()
        var v = me.vals.offset(V.data_size() * i).extract()
        result.add_last(DictEntry[K, V](key: k, value: v))
    i = i +% 1u64
  return result

# ============================================================================
# Iteration
# ============================================================================

### Returns an iterator over all live entries in insertion order.
### Order is stable across lookups and value updates; removing and re-adding a key places the entry at the new end.
@readonly
routine FastDict[K, V].$iter() -> FastDictIterator[K, V]
  danger!
    return FastDictIterator[K, V](
      keys: me.keys,
      vals: me.vals,
      entry_live: me.entry_live,
      entries_used: me.entries_used,
      pos: 0u64
    )

### Iterator that walks the dense entries array of a {FastDict[K, V]} in insertion order.
### Tombstoned (removed) entries are silently skipped.
### :typeparam K: The key type yielded by each entry.
### :typeparam V: The value type yielded by each entry.
entity FastDictIterator[K, V] obeys Iterator[DictEntry[K, V]]
  ### Raw pointer into the source dict's key entries array.
  secret keys: Hijacked[K]
  ### Raw pointer into the source dict's value entries array.
  secret vals: Hijacked[V]
  ### Raw pointer into the source dict's per-entry live byte array.
  secret entry_live: Hijacked[U8]
  ### Entries-array high-water mark captured at iterator creation.
  secret entries_used: U64
  ### Current entry index; advances on each call to `$next!`.
  secret pos: U64

### Advances to the next live entry and returns it.
### :returns: The next live {DictEntry[K, V]} in insertion order.
### :absent: No live entries remain.
routine FastDictIterator[K, V].$next!() -> DictEntry[K, V]
  danger!
    while me.pos < me.entries_used
      var p = me.pos
      me.pos = me.pos + 1u64
      if me.entry_live.offset(p).extract() == ENTRY_LIVE
        var k = me.keys.offset(K.data_size() * p).extract()
        var v = me.vals.offset(V.data_size() * p).extract()
        return DictEntry[K, V](key: k, value: v)
  absent

# ============================================================================
# Display
# ============================================================================

### Returns a compact text representation of the dictionary contents.
### Entries are rendered as `key: value` pairs in insertion order.
@readonly
routine FastDict[K, V].$represent() -> Text
  if me.is_empty()
    return "{:}"
  var result = "{"
  var first = true
  for entry in me
    if not first
      result = result + ", "
    result = result + entry.key.$represent() + ": " + entry.value.$represent()
    first = false
  result = result + "}"
  return result

### Returns a diagnostic form that includes the runtime type name and live entry count.
@readonly
routine FastDict[K, V].$diagnose() -> Text
  var result = me.type_name() + "(count: " + me.count().$represent() + ", {"
  var first = true
  for entry in me
    if not first
      result = result + ", "
    result = result + entry.key.$represent() + ": " + entry.value.$represent()
    first = false
  result = result + "})"
  return result

# ============================================================================
# Comparison
# ============================================================================

### Returns true if both dictionaries contain exactly the same keys with the same associated values.
### Comparison is order-independent: two dictionaries with the same key/value pairs are equal
### regardless of the insertion order they were built in.
### :param other: The other dictionary to compare against.
### :returns: `true` if both have the same count and every key-value pair is equal.
@readonly
routine FastDict[K, V].$eq(other: FastDict[K, V]) -> Bool
  if me.count != other.count
    return false
  var i = 0u64
  while i < me.entries_used
    danger!
      if me.entry_live.offset(i).extract() == ENTRY_LIVE
        var k = me.keys.offset(K.data_size() * i).extract()
        var v = me.vals.offset(V.data_size() * i).extract()
        var slot = other.find_slot(k)
        if slot >= other.capacity
          return false
        var other_ei = other.indices.offset(U64.data_size() * slot).extract()
        var other_v = other.vals.offset(V.data_size() * other_ei).extract()
        if v != other_v
          return false
    i = i +% 1u64
  return true