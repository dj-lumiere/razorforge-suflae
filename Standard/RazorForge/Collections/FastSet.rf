module Collections

import BuilderService

secret preset FAST_SET_INITIAL_CAPACITY: U64 = 16u64
secret preset FAST_SET_INITIAL_ENTRIES: U64 = 16u64
secret preset CTRL_EMPTY: U8 = 128_u8
secret preset CTRL_TOMBSTONED: U8 = 254_u8
secret preset CTRL_H2_MASK: U8 = 127_u8
secret preset ENTRY_DEAD: U8 = 0_u8
secret preset ENTRY_LIVE: U8 = 1_u8

### An insertion-ordered collection of unique values backed by an open-addressed hash table.
###
### `FastSet[T]` stores each value at most once. Inserting a duplicate is a no-op and leaves the
### existing element's position in iteration order unchanged. Membership testing, insertion,
### and removal all run in O(1) average time. Iteration visits live elements in the order they
### were first inserted, stable across lookups and rehashes. Removing an element and re-adding
### it places it at the new end of the iteration order.
###
### The table uses Python-style "compact dict" layout: a probe array of indices into a dense,
### append-only entries array. The probe array carries the SwissTable-style H1/H2 control bytes;
### the entries array carries the elements and a per-entry live byte so removed entries can be
### skipped without shifting later ones.
###
### **When to use**
### - You need fast membership testing (`value in set`).
### - You need to deduplicate a sequence of values.
### - You need set algebra: `union`, `intersection`, `difference`, `symmetric_difference`.
### - You want iteration to follow the order values were first added.
### - Use {SortedSet[T]} instead when you need elements in a defined sort order.
### - Use {Set[T]} (the default) for any keys coming from untrusted input.
###
### **Complexity**
### | Operation | Average | Worst case |
### |---|---|---|
### | `add` | O(1) | O(n) (rehash) |
### | `remove` | O(1) | O(n) |
### | `$contains` | O(1) | O(n) |
### | `union` / `intersection` / `difference` | O(n) | O(n²) |
### | Iteration | O(n + tombstones) | O(n + tombstones) |
###
### :typeparam T: The element type. Must obey {Hashable} and {Equatable}.
### :see: {Dict[K, V]} for key-value storage with the same hash table design.
### :see: {SortedSet[T]} for a sorted, duplicate-free collection.
### :see: {Set[T]} for the safe-by-default counterpart used with untrusted input.
entity FastSet[T] obeys Iterable[T]
needs T obeys FastHashable, Equatable
relates FastSetEmittable[T] as Iter
  secret ctrl: Hijacked[U8]
  secret indices: Hijacked[U64]
  secret slots: Hijacked[T]
  secret entry_live: Hijacked[U8]
  secret count: U64
  secret deleted: U64
  secret entries_used: U64
  secret capacity: U64
  secret entries_cap: U64

# ============================================================================
# Creators
# ============================================================================

### Creates an empty set using the default initial table size.
routine FastSet[T].$create() -> FastSet[T]
  var cap = FAST_SET_INITIAL_CAPACITY
  var ecap = FAST_SET_INITIAL_ENTRIES
  var set = FastSet[T](
    ctrl: hijacked_none[U8](),
    indices: hijacked_none[U64](),
    slots: hijacked_none[T](),
    entry_live: hijacked_none[U8](),
    count: 0u64,
    deleted: 0u64,
    entries_used: 0u64,
    capacity: cap,
    entries_cap: ecap
  )
  danger!
    set.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](set.ctrl), value: CTRL_EMPTY, size: cap)
    set.indices = Hijacked[U64](rf_allocate_dynamic_uninit(U64.data_size() * cap))
    set.slots = hijacked_from[T](rf_allocate_dynamic_uninit(T.data_size() * ecap))
    set.entry_live = Hijacked[U8](rf_allocate_dynamic_uninit(ecap))
  return steal set

### Creates an empty set pre-sized to hold at least `capacity` live elements without rehashing.
### :param capacity: Minimum number of live elements to accommodate before the first rehash.
routine FastSet[T].$create(capacity: U64) -> FastSet[T]
  var cap = FAST_SET_INITIAL_CAPACITY
  while cap < capacity
    cap = cap *% 2u64
  var ecap = FAST_SET_INITIAL_ENTRIES
  while ecap < capacity
    ecap = ecap *% 2u64
  var set = FastSet[T](
    ctrl: hijacked_none[U8](),
    indices: hijacked_none[U64](),
    slots: hijacked_none[T](),
    entry_live: hijacked_none[U8](),
    count: 0u64,
    deleted: 0u64,
    entries_used: 0u64,
    capacity: cap,
    entries_cap: ecap
  )
  danger!
    set.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](set.ctrl), value: CTRL_EMPTY, size: cap)
    set.indices = Hijacked[U64](rf_allocate_dynamic_uninit(U64.data_size() * cap))
    set.slots = hijacked_from[T](rf_allocate_dynamic_uninit(T.data_size() * ecap))
    set.entry_live = Hijacked[U8](rf_allocate_dynamic_uninit(ecap))
  return steal set

# ============================================================================
# Internal Helpers
# ============================================================================

@readonly
routine FastSet[T].h2(hash: U64) -> U8
  return U8(hash & U64(CTRL_H2_MASK))

@readonly
routine FastSet[T].h1(hash: U64) -> U64
  return hash >> 7u32

@readonly
routine FastSet[T].read_index(slot: U64) -> U64
  danger!
    return me.indices.offset(U64.data_size() * slot).peek()

@readonly
routine FastSet[T].read_value_at(ei: U64) -> T
  danger!
    return me.slots.offset(T.data_size() * ei).peek()

@readonly
routine FastSet[T].find_slot(value: T) -> U64
  var h = value.$fast_hash()
  var target = me.h2(h)
  var mask = me.capacity -% 1u64
  var i = me.h1(h) & mask
  danger!
    loop
      var c = me.ctrl.offset(ByteSize(bytes: i)).peek()
      if c == CTRL_EMPTY
        return me.capacity
      if c == target
        var ei = me.indices.offset(U64.data_size() * i).peek()
        if me.slots.offset(T.data_size() * ei).peek() == value
          return i
      i = (i +% 1u64) & mask
  return me.capacity

routine FastSet[T].insert_index_raw(h: U64, entry_index: U64)
  var h2_val = me.h2(h)
  var mask = me.capacity -% 1u64
  var i = me.h1(h) & mask
  danger!
    loop
      var c = me.ctrl.offset(ByteSize(bytes: i)).peek()
      if c == CTRL_EMPTY
        me.ctrl.offset(ByteSize(bytes: i)).poke(h2_val)
        me.indices.offset(U64.data_size() * i).poke(entry_index)
        return
      if c == CTRL_TOMBSTONED
        me.ctrl.offset(ByteSize(bytes: i)).poke(h2_val)
        me.indices.offset(U64.data_size() * i).poke(entry_index)
        me.deleted = me.deleted -% 1u64
        return
      i = (i +% 1u64) & mask
  return

@readonly
routine FastSet[T].should_rehash() -> Bool
  if (me.count +% me.deleted) *% 8u64 >= me.capacity *% 7u64
    return true
  if me.entries_used >= me.entries_cap
    return true
  return false

@migratable
routine FastSet[T].rehash()
  var old_cap = me.capacity
  var old_ecap = me.entries_cap
  var old_ctrl = me.ctrl
  var old_indices = me.indices
  var old_slots = me.slots
  var old_entry_live = me.entry_live
  var old_entries_used = me.entries_used

  var table_pressured = (me.count +% me.deleted) *% 8u64 >= old_cap *% 7u64
  var new_cap = old_cap
  if table_pressured
    new_cap = old_cap *% 2u64

  var new_ecap = old_ecap
  if me.count *% 2u64 >= old_ecap
    new_ecap = old_ecap *% 2u64

  danger!
    me.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(new_cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](me.ctrl), value: CTRL_EMPTY, size: new_cap)
    me.indices = Hijacked[U64](rf_allocate_dynamic_uninit(U64.data_size() * new_cap))
    me.slots = hijacked_from[T](rf_allocate_dynamic_uninit(T.data_size() * new_ecap))
    me.entry_live = Hijacked[U8](rf_allocate_dynamic_uninit(new_ecap))
  me.capacity = new_cap
  me.entries_cap = new_ecap
  me.count = 0u64
  me.deleted = 0u64
  me.entries_used = 0u64

  var i = 0u64
  while i < old_entries_used
    danger!
      var live = old_entry_live.offset(ByteSize(bytes: i)).peek()
      if live == ENTRY_LIVE
        var val = old_slots.offset(T.data_size() * i).peek()
        var new_ei = me.entries_used
        me.slots.offset(T.data_size() * new_ei).poke(val)
        me.entry_live.offset(ByteSize(bytes: new_ei)).poke(ENTRY_LIVE)
        me.entries_used = me.entries_used +% 1u64
        me.insert_index_raw(h: val.$fast_hash(), entry_index: new_ei)
        me.count = me.count +% 1u64
    i = i +% 1u64

  danger!
    if not old_ctrl.is_none()
      rf_invalidate(pointer_to_int[U8, Address](old_ctrl))
    if not old_indices.is_none()
      rf_invalidate(pointer_to_int[U64, Address](old_indices))
    if not old_slots.is_none()
      rf_invalidate(pointer_to_int[T, Address](old_slots))
    if not old_entry_live.is_none()
      rf_invalidate(pointer_to_int[U8, Address](old_entry_live))
  return

# ============================================================================
# Core Operations
# ============================================================================

@readonly
routine FastSet[T].count() -> U64
  return me.count

@readonly
routine FastSet[T].is_empty() -> Bool
  return me.count == 0u64

@migratable
routine FastSet[T].clear()
  danger!
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](me.ctrl), value: CTRL_EMPTY, size: me.capacity)
  me.count = 0u64
  me.deleted = 0u64
  me.entries_used = 0u64
  return

@readonly
routine FastSet[T].$contains(value: T) -> Bool
  return me.find_slot(value) < me.capacity

### Inserts `value` if it is not already present.
### :param value: The element to insert.
### :returns: `true` if the element was inserted; `false` if it was already present.
@migratable
routine FastSet[T].add(value: T) -> Bool
  if me.should_rehash()
    me.rehash()
  if me.find_slot(value) < me.capacity
    return false
  var ei = me.entries_used
  danger!
    me.slots.offset(T.data_size() * ei).poke(value)
    me.entry_live.offset(ByteSize(bytes: ei)).poke(ENTRY_LIVE)
  me.entries_used = me.entries_used +% 1u64
  me.insert_index_raw(h: value.$fast_hash(), entry_index: ei)
  me.count = me.count +% 1u64
  return true

### Removes `value` if it is present in the set.
### :param value: The element to remove.
### :returns: `true` if the element was found and removed; `false` if not present.
@migratable
routine FastSet[T].remove(value: T) -> Bool
  var slot = me.find_slot(value)
  if slot >= me.capacity
    return false
  var ei = me.read_index(slot)
  danger!
    me.ctrl.offset(ByteSize(bytes: slot)).poke(CTRL_TOMBSTONED)
    me.entry_live.offset(ByteSize(bytes: ei)).poke(ENTRY_DEAD)
  me.count = me.count -% 1u64
  me.deleted = me.deleted +% 1u64
  return true

# ============================================================================
# FastSet Operations
# ============================================================================

@readonly
routine FastSet[T].union(other: Referring[FastSet[T]]) -> FastSet[T]
  var result = FastSet[T](me.count +% other.count)
  for val in me
    discard result.add(val)
  for val in other
    discard result.add(val)
  return steal result

@readonly
routine FastSet[T].intersection(other: Referring[FastSet[T]]) -> FastSet[T]
  var result = FastSet[T]()
  for val in me
    if val in other
      discard result.add(val)
  return steal result

@readonly
routine FastSet[T].difference(other: Referring[FastSet[T]]) -> FastSet[T]
  var result = FastSet[T]()
  for val in me
    if val notin other
      discard result.add(val)
  return steal result

@readonly
routine FastSet[T].symmetric_difference(other: Referring[FastSet[T]]) -> FastSet[T]
  var result = FastSet[T]()
  for val in me
    if val notin other
      discard result.add(val)
  for val in other
    if val notin me
      discard result.add(val)
  return steal result

@readonly
routine FastSet[T].is_subset(other: Referring[FastSet[T]]) -> Bool
  if me.count > other.count
    return false
  for val in me
    if val notin other
      return false
  return true

@readonly
routine FastSet[T].is_superset(other: Referring[FastSet[T]]) -> Bool
  return other.is_subset(me)

@readonly
routine FastSet[T].is_disjoint(other: Referring[FastSet[T]]) -> Bool
  for val in me
    if val in other
      return false
  return true

# ============================================================================
# Conversion
# ============================================================================

### Creates a {List[T]} from all elements of `from` in insertion order.
### :param from: The set to copy elements from.
### :returns: A new {List[T]} containing all elements of `from`.
routine List[T].$create(from: Referring[FastSet[T]]) -> List[T]
  var result = List[T](capacity: from.count)
  for val in from
    result.add_last(val)
  return steal result

# ============================================================================
# Iteration
# ============================================================================

@readonly
routine FastSet[T].$iter() -> FastSetEmittable[T]
  danger!
    return FastSetEmittable[T](
      slots: me.slots,
      entry_live: me.entry_live,
      entries_used: me.entries_used,
      pos: 0u64
    )

### Emittable that walks the dense entries array of a {FastSet[T]} in insertion order.
### Tombstoned (removed) entries are silently skipped.
entity FastSetEmittable[T] obeys Emittable[T]
  secret slots: Hijacked[T]
  secret entry_live: Hijacked[U8]
  secret entries_used: U64
  secret pos: U64

routine FastSetEmittable[T].$emit!() -> T
  danger!
    while me.pos < me.entries_used
      var p = me.pos
      me.pos = me.pos + 1u64
      if me.entry_live.offset(ByteSize(bytes: p)).peek() == ENTRY_LIVE
        return me.slots.offset(T.data_size() * p).peek()
  absent

# ============================================================================
# Display
# ============================================================================

@readonly
routine FastSet[T].$represent() -> Text
  var result = "FastSet({"
  var first = true
  for val in me
    if not first
      result = result + ", "
    result = result + val.$represent()
    first = false
  result = result + "})"
  return steal result

@readonly
routine FastSet[T].$diagnose() -> Text
  var result = me.full_type_name() + "(count: " + me.count().$represent() + ", {"
  var first = true
  for val in me
    if not first
      result = result + ", "
    result = result + val.$represent()
    first = false
  result = result + "})"
  return steal result

# ============================================================================
# Comparison
# ============================================================================

### Returns true if both sets contain exactly the same elements (order-independent).
@readonly
routine FastSet[T].$eq(other: Referring[FastSet[T]]) -> Bool
  if me.count != other.count
    return false
  return me.is_subset(other)

dangerous routine FastSet[T].$destroy()
  # Tear down each live element before freeing the buffers (mirrors FastSetEmittable.$emit!).
  # No-op for value types; frees owned entity elements.
  var p = 0u64
  while p < me.entries_used
    if me.entry_live.offset(ByteSize(bytes: p)).peek() == ENTRY_LIVE
      me.slots.offset(T.data_size() * p).peek().$destroy()
    p = p + 1u64
  me.ctrl.invalidate()
  me.indices.invalidate()
  me.slots.invalidate()
  me.entry_live.invalidate()
  me.hijack().invalidate()
  return

### Serializes this collection to a `SerialValue.List`, serializing each element.
### :returns: The `SerialValue.List` of each element's serialized form.
@[readonly, generated]
routine FastSet[T].serialize() -> SerialValue
needs T obeys Serializable
  var __sv = List[SerialValue]()
  for __x in me
    __sv.add_last(value: __x.serialize())
  return SerialValue(steal __sv)
