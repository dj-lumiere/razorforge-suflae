module Core

import BuilderService

preset SET_INITIAL_CAPACITY: U64 = 16u64
preset CTRL_EMPTY: U8 = 128_u8
preset CTRL_DELETED: U8 = 254_u8
preset CTRL_H2_MASK: U8 = 127_u8

### An unordered collection of unique values backed by an open-addressed hash table.
###
### `Set[T]` stores each value at most once. Inserting a duplicate is a no-op.
### Membership testing, insertion, and removal all run in O(1) average time.
### Iteration visits live elements in slot order, which reflects the current table
### layout rather than insertion order and may change after a rehash.
###
### **When to use**
### - You need fast membership testing (`value in set`).
### - You need to deduplicate a sequence of values.
### - You need set algebra: `union`, `intersection`, `difference`, `symmetric_difference`.
### - Use {SortedSet[T]} instead when you need elements in a defined order.
### - Use {SecureSet[T]} instead when values come from untrusted input.
###
### **Complexity**
### | Operation | Average | Worst case |
### |---|---|---|
### | `add` | O(1) | O(n) (rehash) |
### | `remove` | O(1) | O(n) |
### | `$contains` | O(1) | O(n) |
### | `union` / `intersection` / `difference` | O(n) | O(n²) |
### | Iteration | O(capacity) | O(capacity) |
###
### :typeparam T: The element type. Must obey {Hashable} and {Equatable}.
### :see: {Dict[K, V]} for key-value storage with the same hash table design.
### :see: {SortedSet[T]} for a sorted, duplicate-free collection.
### :see: {SecureSet[T]} for hash-flooding-resistant membership testing.
entity Set[T] obeys Iterable[T]
needs T obeys Hashable, Equatable
  secret ctrl: Hijacked[U8]  # 1 byte/slot: 128=empty, 254=deleted, 0-127=H2
  secret slots: Hijacked[T]  # element storage, capacity slots
  secret count: U64          # live element count
  secret deleted: U64        # tombstone count
  secret capacity: U64       # always a power of two

# ============================================================================
# Creators
# ============================================================================

### Creates an empty set using the default initial table size.
routine Set[T].$create() -> Set[T]
  var cap = SET_INITIAL_CAPACITY
  var set = Set[T](
    ctrl: hijacked_none[U8](),
    slots: hijacked_none[T](),
    count: 0u64,
    deleted: 0u64,
    capacity: cap
  )
  danger!
    set.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](set.ctrl), value: CTRL_EMPTY, size: cap)
    set.slots = hijacked_from[T](rf_allocate_dynamic_uninit(T.data_size() * cap))
  return set

### Creates an empty set pre-sized to hold at least `capacity` live elements without rehashing.
### The actual slot count is rounded up to the next power-of-two.
### :param capacity: Minimum number of live elements to accommodate before the first rehash.
routine Set[T].$create(capacity: U64) -> Set[T]
  var cap = SET_INITIAL_CAPACITY
  while cap < capacity
    cap = cap *% 2u64
  var set = Set[T](
    ctrl: hijacked_none[U8](),
    slots: hijacked_none[T](),
    count: 0u64,
    deleted: 0u64,
    capacity: cap
  )
  danger!
    set.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](set.ctrl), value: CTRL_EMPTY, size: cap)
    set.slots = hijacked_from[T](rf_allocate_dynamic_uninit(T.data_size() * cap))
  return set

### Releases the raw control and element buffers owned by this set.
routine Set[T].$destroy()
  danger!
    if not me.ctrl.is_none()
      rf_invalidate(pointer_to_int[U8, Address](me.ctrl))
    if not me.slots.is_none()
      rf_invalidate(pointer_to_int[T, Address](me.slots))
  return

# ============================================================================
# Internal Helpers
# ============================================================================

### Extracts the 7-bit control-byte fingerprint from a raw hash value.
### :param hash: The raw hash output from `$hash`.
### :returns: The low 7 bits of `hash`, used to filter candidate slots before a full equality check.
@readonly
routine Set[T].h2(hash: U64) -> U8
  return U8(hash & U64(CTRL_H2_MASK))

### Derives the primary probe slot index from a raw hash value.
### :param hash: The raw hash output from `$hash`.
### :returns: The upper bits of `hash`, used as the starting slot before masking to the table size.
@readonly
routine Set[T].h1(hash: U64) -> U64
  return hash >> 7u32

### Searches for `value` by linear probing from its primary slot.
### Control-byte fingerprints are checked before full element equality to reduce element loads.
### :param value: The element to find.
### :returns: The slot index of `value` if found, or `capacity` if the element is absent.
@readonly
routine Set[T].find_slot(value: T) -> U64
  var h = value.$hash()
  var target = me.h2(h)
  var mask = me.capacity -% 1u64
  var i = me.h1(h) & mask
  danger!
    loop
      var c = me.ctrl.offset(U8.data_size() * i).extract()
      if c == CTRL_EMPTY
        return me.capacity
      if c == target
        if me.slots.offset(T.data_size() * i).extract() == value
          return i
      i = (i +% 1u64) & mask
  return me.capacity

### Writes `val` into the first empty or deleted slot reached from the probe position of `h`.
### Assumes the caller has already checked for duplicates and will update `count` separately.
### :param h: The raw hash output for `val`.
### :param val: The element to write.
routine Set[T].insert_raw(h: U64, val: T)
  var h2_val = me.h2(h)
  var mask = me.capacity -% 1u64
  var i = me.h1(h) & mask
  danger!
    loop
      var c = me.ctrl.offset(U8.data_size() * i).extract()
      if c == CTRL_EMPTY
        me.ctrl.offset(U8.data_size() * i).inject(h2_val)
        me.slots.offset(T.data_size() * i).inject(val)
        return
      if c == CTRL_DELETED
        me.ctrl.offset(U8.data_size() * i).inject(h2_val)
        me.slots.offset(T.data_size() * i).inject(val)
        me.deleted = me.deleted -% 1u64
        return
      i = (i +% 1u64) & mask
  return

### Returns true when the combined live and tombstone load exceeds 87.5% of capacity.
### Both live elements and tombstones occupy probe space, so both count toward the load threshold.
### :returns: `true` if a rehash should happen before the next insertion.
@readonly
routine Set[T].should_rehash() -> Bool
  return (me.count +% me.deleted) *% 8u64 >= me.capacity *% 7u64

### Doubles the table capacity and reinserts all live elements into the new table.
### Tombstones are discarded during the rebuild.
@migratable
routine Set[T].rehash()
  var old_cap = me.capacity
  var old_ctrl = me.ctrl
  var old_slots = me.slots
  var new_cap = old_cap *% 2u64

  danger!
    me.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(new_cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](me.ctrl), value: CTRL_EMPTY, size: new_cap)
    me.slots = hijacked_from[T](rf_allocate_dynamic_uninit(T.data_size() * new_cap))
  me.capacity = new_cap
  me.count = 0u64
  me.deleted = 0u64

  var i = 0u64
  while i < old_cap
    danger!
      var c = old_ctrl.offset(U8.data_size() * i).extract()
      if c != CTRL_EMPTY and c != CTRL_DELETED
        var val = old_slots.offset(T.data_size() * i).extract()
        me.insert_raw(h: val.$hash(), val: val)
        me.count = me.count +% 1u64
    i = i +% 1u64

  danger!
    if not old_ctrl.is_none()
      rf_invalidate(pointer_to_int[U8, Address](old_ctrl))
    if not old_slots.is_none()
      rf_invalidate(pointer_to_int[T, Address](old_slots))
  return

# ============================================================================
# Core Operations
# ============================================================================

### Returns the number of live elements currently stored.
### :returns: The live element count.
@readonly
routine Set[T].count() -> U64
  return me.count

### Returns true if this set contains no live elements.
### :returns: `true` when `count()` is zero.
@readonly
routine Set[T].is_empty() -> Bool
  return me.count == 0u64

### Removes every element while preserving the current slot capacity.
### Resets the control array to all-empty in one pass, discarding all tombstones.
@migratable
routine Set[T].clear()
  danger!
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](me.ctrl), value: CTRL_EMPTY, size: me.capacity)
  me.count = 0u64
  me.deleted = 0u64
  return

### Returns true if `value` is present in the set.
### :param value: The element to look up.
### :returns: `true` if the element exists.
@readonly
routine Set[T].$contains(value: T) -> Bool
  return me.find_slot(value) < me.capacity

### Inserts `value` if it is not already present.
### :param value: The element to insert.
### :returns: `true` if the element was inserted; `false` if it was already present.
@migratable
routine Set[T].add(value: T) -> Bool
  if me.should_rehash()
    me.rehash()
  if me.find_slot(value) < me.capacity
    return false
  me.insert_raw(h: value.$hash(), val: value)
  me.count = me.count +% 1u64
  return true

### Removes `value` if it is present in the set.
### :param value: The element to remove.
### :returns: `true` if the element was found and removed; `false` if not present.
@migratable
routine Set[T].remove(value: T) -> Bool
  var slot = me.find_slot(value)
  if slot >= me.capacity
    return false
  danger!
    me.ctrl.offset(U8.data_size() * slot).inject(CTRL_DELETED)
  me.count = me.count -% 1u64
  me.deleted = me.deleted +% 1u64
  return true

# ============================================================================
# Set Operations
# ============================================================================

### Returns a new set containing every element that appears in either this set or `other`.
### :param other: The other set to combine with.
### :returns: A new {Set[T]} with the union of both sets' elements.
@readonly
routine Set[T].union(other: Set[T]) -> Set[T]
  var result = Set[T](me.count +% other.count)
  for val in me
    discard result.add(val)
  for val in other
    discard result.add(val)
  return result

### Returns a new set containing only elements shared by both this set and `other`.
### :param other: The other set to intersect with.
### :returns: A new {Set[T]} containing only elements present in both sets.
@readonly
routine Set[T].intersection(other: Set[T]) -> Set[T]
  var result = Set[T]()
  for val in me
    if val in other
      discard result.add(val)
  return result

### Returns a new set containing elements of this set that are absent from `other`.
### :param other: The set of elements to exclude.
### :returns: A new {Set[T]} with elements of this set that do not appear in `other`.
@readonly
routine Set[T].difference(other: Set[T]) -> Set[T]
  var result = Set[T]()
  for val in me
    if val notin other
      discard result.add(val)
  return result

### Returns a new set containing elements that appear in exactly one of the two sets.
### :param other: The other set to compare against.
### :returns: A new {Set[T]} with elements exclusive to each set.
@readonly
routine Set[T].symmetric_difference(other: Set[T]) -> Set[T]
  var result = Set[T]()
  for val in me
    if val notin other
      discard result.add(val)
  for val in other
    if val notin me
      discard result.add(val)
  return result

### Returns true if every element of this set is also present in `other`.
### :param other: The set to check containment against.
### :returns: `true` if this set is a subset of `other`.
@readonly
routine Set[T].is_subset(other: Set[T]) -> Bool
  if me.count > other.count
    return false
  for val in me
    if val notin other
      return false
  return true

### Returns true if this set contains every element of `other`.
### :param other: The set to check containment of.
### :returns: `true` if this set is a superset of `other`.
@readonly
routine Set[T].is_superset(other: Set[T]) -> Bool
  return other.is_subset(me)

### Returns true if this set and `other` share no elements.
### :param other: The set to check for overlap with.
### :returns: `true` if the two sets have no elements in common.
@readonly
routine Set[T].is_disjoint(other: Set[T]) -> Bool
  for val in me
    if val in other
      return false
  return true

# ============================================================================
# Conversion
# ============================================================================

### Creates a {List[T]} from all elements of `from` in slot iteration order.
### The order reflects the current table layout and is not guaranteed to match insertion order.
### :param from: The set to copy elements from.
### :returns: A new {List[T]} containing all elements of `from`.
routine List[T].$create(from: Set[T]) -> List[T]
  var result = List[T](capacity: from.count)
  for val in from
    result.add_last(val)
  return result

# ============================================================================
# Iteration
# ============================================================================

### Returns an iterator over all live elements in slot order.
### Iteration order is not sorted and is not stable across rehashes.
@readonly
routine Set[T].$iter() -> SetIterator[T]
  danger!
    return SetIterator[T](
      ctrl: me.ctrl,
      slots: me.slots,
      capacity: me.capacity,
      slot: 0u64
    )

### Iterator that walks the raw slot array of a {Set[T]} and yields only live elements.
### Empty and deleted (tombstone) slots are silently skipped.
### :typeparam T: The element type yielded by the iterator.
entity SetIterator[T] obeys Iterator[T]
  ### Raw pointer into the source set's control byte array.
  secret ctrl: Hijacked[U8]
  ### Raw pointer into the source set's element storage.
  secret slots: Hijacked[T]
  ### Slot capacity captured at iterator creation.
  secret capacity: U64
  ### Current slot index; advances on each call to `$next!`.
  secret slot: U64

### Advances to the next live slot and returns its element.
### :returns: The next live element.
### :absent: No live slots remain.
routine SetIterator[T].$next!() -> T
  danger!
    while me.slot < me.capacity
      var s = me.slot
      me.slot = me.slot + 1u64
      var c = me.ctrl.offset(U8.data_size() * s).extract()
      if c != CTRL_EMPTY and c != CTRL_DELETED
        return me.slots.offset(T.data_size() * s).extract()
  absent

# ============================================================================
# Display
# ============================================================================

### Returns a compact text representation of the set contents.
### Elements are rendered in iteration (slot) order, enclosed in braces.
@readonly
routine Set[T].$represent() -> Text
  if me.is_empty()
    return "{}"
  var result = "{"
  var first = true
  for val in me
    if not first
      result = result + ", "
    result = result + val.$represent()
    first = false
  result = result + "}"
  return result

### Returns a diagnostic form that includes the runtime type name and live element count.
@readonly
routine Set[T].$diagnose() -> Text
  var result = me.type_name() + "(count: " + me.count().$represent() + ", {"
  var first = true
  for val in me
    if not first
      result = result + ", "
    result = result + val.$represent()
    first = false
  result = result + "})"
  return result

# ============================================================================
# Comparison
# ============================================================================

### Returns true if both sets contain exactly the same elements.
### :param other: The other set to compare against.
### :returns: `true` if both sets have equal count and this set is a subset of `other`.
@readonly
routine Set[T].$eq(other: Set[T]) -> Bool
  if me.count != other.count
    return false
  return me.is_subset(other)
