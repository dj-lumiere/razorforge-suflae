module Core

import BuilderService

preset DICT_INITIAL_CAPACITY: U64 = 16u64
preset CTRL_EMPTY: U8 = 128_u8
preset CTRL_DELETED: U8 = 254_u8
preset CTRL_H2_MASK: U8 = 127_u8

### An unordered key-value dictionary backed by an open-addressed hash table.
###
### `Dict[K, V]` maps each unique key to exactly one value. Inserting a key that
### already exists replaces its value. Lookup, insertion, and removal all run in O(1)
### average time. Iteration visits live entries in slot order, which reflects the
### current table layout and may change after a rehash.
###
### **When to use**
### - You need O(1) average key lookup, insertion, or removal.
### - You need to associate values with arbitrary keys.
### - Use {SortedDict[K, V]} instead when you need entries in key order.
### - Use {SecureDict[K, V]} instead when keys come from untrusted input.
###
### **Complexity**
### | Operation | Average | Worst case |
### |---|---|---|
### | `add` | O(1) | O(n) (rehash) |
### | `remove` | O(1) | O(n) |
### | `$contains` / `get_or_default` | O(1) | O(n) |
### | `keys()` / `values()` / `entries()` | O(n) | O(n) |
### | Iteration | O(capacity) | O(capacity) |
###
### :typeparam K: The key type. Must obey {Hashable} and {Equatable}.
### :typeparam V: The value type associated with each key.
### :see: {Set[K]} for key-only storage with the same hash table design.
### :see: {SortedDict[K, V]} for sorted key-value storage.
### :see: {SecureDict[K, V]} for hash-flooding-resistant key-value storage.
entity Dict[K, V] obeys Iterable[DictEntry[K, V]]
needs K obeys Hashable, Equatable
  secret ctrl: Hijacked[U8]     # 1 byte/slot: 128=empty, 254=deleted, 0-127=H2
  secret keys: Hijacked[K]      # raw key storage, capacity slots
  secret vals: Hijacked[V]      # raw value storage, capacity slots
  secret count: U64             # live entry count
  secret deleted: U64           # tombstone count
  secret capacity: U64          # always a power of two

# ============================================================================
# Creators
# ============================================================================

### Creates an empty dictionary using the default initial table size.
routine Dict[K, V].$create() -> Dict[K, V]
  var cap = DICT_INITIAL_CAPACITY
  var dict = Dict[K, V](
    ctrl: hijacked_none[U8](),
    keys: hijacked_none[K](),
    vals: hijacked_none[V](),
    count: 0u64,
    deleted: 0u64,
    capacity: cap
  )
  danger!
    dict.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](dict.ctrl), value: CTRL_EMPTY, size: cap)
    dict.keys = hijacked_from[K](rf_allocate_dynamic_uninit(K.data_size() * cap))
    dict.vals = hijacked_from[V](rf_allocate_dynamic_uninit(V.data_size() * cap))
  return dict

### Creates an empty dictionary pre-sized to hold at least `capacity` live entries without rehashing.
### The actual slot count is rounded up to the next power-of-two.
### :param capacity: Minimum number of live entries to accommodate before the first rehash.
routine Dict[K, V].$create(capacity: U64) -> Dict[K, V]
  var cap = DICT_INITIAL_CAPACITY
  while cap < capacity
    cap = cap *% 2u64
  var dict = Dict[K, V](
    ctrl: hijacked_none[U8](),
    keys: hijacked_none[K](),
    vals: hijacked_none[V](),
    count: 0u64,
    deleted: 0u64,
    capacity: cap
  )
  danger!
    dict.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](dict.ctrl), value: CTRL_EMPTY, size: cap)
    dict.keys = hijacked_from[K](rf_allocate_dynamic_uninit(K.data_size() * cap))
    dict.vals = hijacked_from[V](rf_allocate_dynamic_uninit(V.data_size() * cap))
  return dict

### Releases the raw control, key, and value buffers owned by this dictionary.
routine Dict[K, V].$destroy()
  danger!
    if not me.ctrl.is_none()
      rf_invalidate(pointer_to_int[U8, Address](me.ctrl))
    if not me.keys.is_none()
      rf_invalidate(pointer_to_int[K, Address](me.keys))
    if not me.vals.is_none()
      rf_invalidate(pointer_to_int[V, Address](me.vals))
  return

# ============================================================================
# Internal Helpers
# ============================================================================

### Extracts the 7-bit control-byte fingerprint from a raw hash value.
### :param hash: The raw hash output from `$hash`.
### :returns: The low 7 bits of `hash`, used to filter candidate slots before a full key comparison.
@readonly
routine Dict[K, V].h2(hash: U64) -> U8
  return U8(hash & U64(CTRL_H2_MASK))

### Derives the primary probe slot index from a raw hash value.
### :param hash: The raw hash output from `$hash`.
### :returns: The upper bits of `hash`, used as the starting slot before masking to the table size.
@readonly
routine Dict[K, V].h1(hash: U64) -> U64
  return hash >> 7u32

### Returns the key stored at `slot` without checking whether the slot is live.
### :param slot: The slot index to read from.
### :returns: The key at that slot.
@readonly
routine Dict[K, V].read_key(slot: U64) -> K
  danger!
    return me.keys.offset(K.data_size() * slot).extract()

### Overwrites the key at `slot` without changing the control byte.
### :param slot: The slot index to write to.
### :param key: The new key to store.
routine Dict[K, V].write_key(slot: U64, key: K)
  danger!
    me.keys.offset(K.data_size() * slot).inject(key)
  return

### Returns the value stored at `slot` without checking whether the slot is live.
### :param slot: The slot index to read from.
### :returns: The value at that slot.
@readonly
routine Dict[K, V].read_val(slot: U64) -> V
  danger!
    return me.vals.offset(V.data_size() * slot).extract()

### Overwrites the value at `slot` without changing the control byte.
### :param slot: The slot index to write to.
### :param val: The new value to store.
routine Dict[K, V].write_val(slot: U64, val: V)
  danger!
    me.vals.offset(V.data_size() * slot).inject(val)
  return

### Searches for `key` by linear probing from its primary slot.
### Control-byte fingerprints are checked before full key equality to avoid unnecessary key loads.
### :param key: The key to find.
### :returns: The slot index of `key` if found, or `capacity` if the key is absent.
@readonly
routine Dict[K, V].find_slot(key: K) -> U64
  var h = key.$hash()
  var target = me.h2(h)
  var mask = me.capacity -% 1u64
  var i = me.h1(h) & mask
  danger!
    loop
      var c = me.ctrl.offset(U8.data_size() * i).extract()
      if c == CTRL_EMPTY
        return me.capacity
      if c == target
        if me.keys.offset(K.data_size() * i).extract() == key
          return i
      i = (i +% 1u64) & mask
  return me.capacity

### Writes `key` and `val` into the first empty or deleted slot reached from the probe position of `h`.
### Assumes the caller has already checked for duplicates and will update `count` separately.
### :param h: The raw hash output for `key`.
### :param key: The key to write.
### :param val: The value to write.
routine Dict[K, V].insert_raw(h: U64, key: K, val: V)
  var h2_val = me.h2(h)
  var mask = me.capacity -% 1u64
  var i = me.h1(h) & mask
  danger!
    loop
      var c = me.ctrl.offset(U8.data_size() * i).extract()
      if c == CTRL_EMPTY
        me.ctrl.offset(U8.data_size() * i).inject(h2_val)
        me.keys.offset(K.data_size() * i).inject(key)
        me.vals.offset(V.data_size() * i).inject(val)
        return
      if c == CTRL_DELETED
        me.ctrl.offset(U8.data_size() * i).inject(h2_val)
        me.keys.offset(K.data_size() * i).inject(key)
        me.vals.offset(V.data_size() * i).inject(val)
        me.deleted = me.deleted -% 1u64
        return
      i = (i +% 1u64) & mask
  return

### Marks `slot` as a tombstone in the control array.
### The stored key and value bytes are left in place; callers must update live and deleted counts separately.
### :param slot: The occupied slot to vacate.
routine Dict[K, V].delete_at(slot: U64)
  danger!
    me.ctrl.offset(U8.data_size() * slot).inject(CTRL_DELETED)
  return

### Returns true when the combined live and tombstone load exceeds 87.5% of capacity.
### Both live entries and tombstones occupy probe space, so both count toward the load threshold.
### :returns: `true` if a rehash should happen before the next insertion.
@readonly
routine Dict[K, V].should_rehash() -> Bool
  return (me.count +% me.deleted) *% 8u64 >= me.capacity *% 7u64

### Doubles the table capacity and reinserts all live entries into the new table.
### Tombstones are discarded during the rebuild.
@migratable
routine Dict[K, V].rehash()
  var old_cap = me.capacity
  var old_ctrl = me.ctrl
  var old_keys = me.keys
  var old_vals = me.vals
  var new_cap = old_cap *% 2u64

  danger!
    me.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(new_cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](me.ctrl), value: CTRL_EMPTY, size: new_cap)
    me.keys = hijacked_from[K](rf_allocate_dynamic_uninit(K.data_size() * new_cap))
    me.vals = hijacked_from[V](rf_allocate_dynamic_uninit(V.data_size() * new_cap))
  me.capacity = new_cap
  me.count = 0u64
  me.deleted = 0u64

  var i = 0u64
  while i < old_cap
    danger!
      var c = old_ctrl.offset(U8.data_size() * i).extract()
      if c != CTRL_EMPTY and c != CTRL_DELETED
        var k = old_keys.offset(K.data_size() * i).extract()
        var v = old_vals.offset(V.data_size() * i).extract()
        me.insert_raw(h: k.$hash(), key: k, val: v)
        me.count = me.count +% 1u64
    i = i +% 1u64

  danger!
    if not old_ctrl.is_none()
      rf_invalidate(pointer_to_int[U8, Address](old_ctrl))
    if not old_keys.is_none()
      rf_invalidate(pointer_to_int[K, Address](old_keys))
    if not old_vals.is_none()
      rf_invalidate(pointer_to_int[V, Address](old_vals))
  return

# ============================================================================
# Core Operations
# ============================================================================

### Returns the number of live key-value entries currently stored.
### :returns: The live entry count.
@readonly
routine Dict[K, V].count() -> U64
  return me.count

### Returns true if this dictionary contains no live entries.
### :returns: `true` when `count()` is zero.
@readonly
routine Dict[K, V].is_empty() -> Bool
  return me.count == 0u64

### Removes every entry while preserving the current slot capacity.
### Resets the control array to all-empty in one pass, discarding all tombstones.
@migratable
routine Dict[K, V].clear()
  danger!
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](me.ctrl), value: CTRL_EMPTY, size: me.capacity)
  me.count = 0u64
  me.deleted = 0u64
  return

### Returns true if `key` is present in the dictionary.
### :param key: The key to look up.
### :returns: `true` if the key exists.
@readonly
routine Dict[K, V].$contains(key: K) -> Bool
  return me.find_slot(key) < me.capacity

### Inserts `key` with `value`, or updates the existing entry when `key` is already present.
### :param key: The key to insert or update.
### :param value: The value to associate with `key`.
### :returns: `true` if a new entry was inserted; `false` if an existing entry was updated.
@migratable
routine Dict[K, V].add(key: K, value: V) -> Bool
  if me.should_rehash()
    me.rehash()
  var slot = me.find_slot(key)
  if slot < me.capacity
    me.write_val(slot: slot, val: value)
    return false
  me.insert_raw(h: key.$hash(), key: key, val: value)
  me.count = me.count +% 1u64
  return true

### Removes the entry associated with `key`, if present.
### :param key: The key to remove.
### :returns: `true` if the key was found and removed; `false` if not present.
@migratable
routine Dict[K, V].remove(key: K) -> Bool
  var slot = me.find_slot(key)
  if slot >= me.capacity
    return false
  me.delete_at(slot)
  me.count = me.count -% 1u64
  me.deleted = me.deleted +% 1u64
  return true

### Returns the value associated with `key`, or `default_value` when the key is absent.
### :param key: The key to look up.
### :param default_value: The fallback value returned when `key` is not present.
### :returns: The mapped value if found, otherwise `default_value`.
@readonly
routine Dict[K, V].get_or_default(key: K, default_value: V) -> V
  var slot = me.find_slot(key)
  if slot >= me.capacity
    return default_value
  return me.read_val(slot)

# ============================================================================
# Indexing
# ============================================================================

### Returns the value associated with `key`.
### :param key: The key to look up.
### :returns: The value mapped to `key`.
### :absent: The key is not present in the dictionary.
@readonly
routine Dict[K, V].$getitem!(key: K) -> V
  var slot = me.find_slot(key)
  if slot >= me.capacity
    absent
  return me.read_val(slot)

### Updates the value associated with `key`.
### :param key: The key to update.
### :param value: The replacement value.
### :absent: The key is not present in the dictionary.
routine Dict[K, V].$setitem!(key: K, value: V)
  if key notin me
    absent
  var slot = me.find_slot(key)
  me.write_val(slot: slot, val: value)
  return

# ============================================================================
# Keys / Values / Entries
# ============================================================================

### Returns all live keys in slot iteration order.
### :returns: A {List[K]} of every key; order reflects the current table layout.
@readonly
routine Dict[K, V].keys() -> List[K]
  var result = List[K](me.count)
  var i = 0u64
  while i < me.capacity
    danger!
      var c = me.ctrl.offset(U8.data_size() * i).extract()
      if c != CTRL_EMPTY and c != CTRL_DELETED
        result.add_last(me.read_key(i))
    i = i +% 1u64
  return result

### Returns all live values in slot iteration order.
### :returns: A {List[V]} of every value; order matches the corresponding `keys()` call only within a single unmodified table.
@readonly
routine Dict[K, V].values() -> List[V]
  var result = List[V](me.count)
  var i = 0u64
  while i < me.capacity
    danger!
      var c = me.ctrl.offset(U8.data_size() * i).extract()
      if c != CTRL_EMPTY and c != CTRL_DELETED
        result.add_last(me.read_val(i))
    i = i +% 1u64
  return result

### Returns all live entries in slot iteration order.
### :returns: A {List[DictEntry[K, V]]} of every key-value pair; order reflects the current table layout.
@readonly
routine Dict[K, V].entries() -> List[DictEntry[K, V]]
  var result = List[DictEntry[K, V]](me.count)
  var i = 0u64
  while i < me.capacity
    danger!
      var c = me.ctrl.offset(U8.data_size() * i).extract()
      if c != CTRL_EMPTY and c != CTRL_DELETED
        result.add_last(DictEntry[K, V](key: me.read_key(i), value: me.read_val(i)))
    i = i +% 1u64
  return result

# ============================================================================
# Iteration
# ============================================================================

### Returns an iterator over all live entries in slot order.
### Iteration order is not sorted and is not stable across rehashes.
@readonly
routine Dict[K, V].$iter() -> DictIterator[K, V]
  danger!
    return DictIterator[K, V](
      ctrl: me.ctrl,
      keys: me.keys,
      vals: me.vals,
      capacity: me.capacity,
      slot: 0u64
    )

### Iterator that walks the raw slot array of a {Dict[K, V]} and yields only live entries.
### Empty and deleted (tombstone) slots are silently skipped.
### :typeparam K: The key type yielded by each entry.
### :typeparam V: The value type yielded by each entry.
entity DictIterator[K, V] obeys Iterator[DictEntry[K, V]]
  ### Raw pointer into the source dict's control byte array.
  secret ctrl: Hijacked[U8]
  ### Raw pointer into the source dict's key storage.
  secret keys: Hijacked[K]
  ### Raw pointer into the source dict's value storage.
  secret vals: Hijacked[V]
  ### Slot capacity captured at iterator creation.
  secret capacity: U64
  ### Current slot index; advances on each call to `$next!`.
  secret slot: U64

### Advances to the next live slot and returns its entry.
### :returns: The next live {DictEntry[K, V]}.
### :absent: No live slots remain.
routine DictIterator[K, V].$next!() -> DictEntry[K, V]
  danger!
    while me.slot < me.capacity
      var s = me.slot
      me.slot = me.slot + 1u64
      var c = me.ctrl.offset(U8.data_size() * s).extract()
      if c != CTRL_EMPTY and c != CTRL_DELETED
        var k = me.keys.offset(K.data_size() * s).extract()
        var v = me.vals.offset(V.data_size() * s).extract()
        return DictEntry[K, V](key: k, value: v)
  absent

# ============================================================================
# Display
# ============================================================================

### Returns a compact text representation of the dictionary contents.
### Entries are rendered as `key: value` pairs in iteration (slot) order.
@readonly
routine Dict[K, V].$represent() -> Text
  if me.is_empty()
    return "{:}"
  var result = "{"
  var first = true
  for entry in me
    if not first
      result = result + ", "
    result = result + entry.key.$represent() + ": " + entry.value.$represent()
    first = false
  result = result + "}"
  return result

### Returns a diagnostic form that includes the runtime type name and live entry count.
@readonly
routine Dict[K, V].$diagnose() -> Text
  var result = me.type_name() + "(count: " + me.count().$represent() + ", {"
  var first = true
  for entry in me
    if not first
      result = result + ", "
    result = result + entry.key.$represent() + ": " + entry.value.$represent()
    first = false
  result = result + "})"
  return result

# ============================================================================
# Comparison
# ============================================================================

### Returns true if both dictionaries contain exactly the same keys with the same associated values.
### :param other: The other dictionary to compare against.
### :returns: `true` if both have the same count and every key-value pair is equal.
@readonly
routine Dict[K, V].$eq(other: Dict[K, V]) -> Bool
  if me.count != other.count
    return false
  var i = 0u64
  while i < me.capacity
    danger!
      var c = me.ctrl.offset(U8.data_size() * i).extract()
      if c != CTRL_EMPTY and c != CTRL_DELETED
        var slot = other.find_slot(me.read_key(i))
        if slot >= other.capacity
          return false
        if me.read_val(i) != other.read_val(slot)
          return false
    i = i +% 1u64
  return true
