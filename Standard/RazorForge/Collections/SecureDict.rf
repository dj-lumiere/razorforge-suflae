module Collections

import BuilderService
import Core.SecureHashKey

preset SECURE_DICT_INITIAL_CAPACITY: U64 = 16u64
preset SECURE_DICT_INITIAL_ENTRIES: U64 = 16u64
preset CTRL_EMPTY: U8 = 128_u8
preset CTRL_TOMBSTONED: U8 = 254_u8
preset CTRL_H2_MASK: U8 = 127_u8
preset ENTRY_DEAD: U8 = 0_u8
preset ENTRY_LIVE: U8 = 1_u8

### A hash-flooding-resistant insertion-ordered key-value dictionary.
###
### `SecureDict[K, V]` works like {Dict[K, V]} (insertion-ordered iteration, O(1) average
### operations) but uses SipHash-2-4 keyed with a per-instance secret to make the probe
### sequence unpredictable to external attackers. Iteration order follows insertion order;
### the secure key only affects the probe-array layout, not the entries array.
###
### **When to use**
### - You are storing data derived from untrusted input (e.g. HTTP headers, user IDs, file names).
### - You need the same insert/lookup/remove interface as {Dict[K, V]} with a security guarantee.
### - Use plain {Dict[K, V]} instead when the key space is fully trusted and throughput matters more.
###
### **Complexity**
### | Operation | Average | Worst case |
### |---|---|---|
### | `add` | O(1) | O(n) (rehash) |
### | `remove` | O(1) | O(n) |
### | `$contains` / `get_or_default` | O(1) | O(n) |
### | Iteration | O(n + tombstones) | O(n + tombstones) |
###
### :typeparam K: The key type. Must obey {SecureHashable} and {Equatable}.
### :typeparam V: The value type associated with each key.
### :see: {Dict[K, V]} for an unsecured but faster general-purpose dictionary.
### :see: {SecureSet[T]} for the set counterpart.
entity SecureDict[K, V] obeys Iterable[DictEntry[K, V]]
needs K obeys SecureHashable, Equatable
  secret ctrl: Hijacked[U8]
  secret indices: Hijacked[U64]
  secret keys: Hijacked[K]
  secret vals: Hijacked[V]
  secret entry_live: Hijacked[U8]
  secret count: U64
  secret deleted: U64
  secret entries_used: U64
  secret capacity: U64
  secret entries_cap: U64
  secret k0: U64
  secret k1: U64

# ============================================================================
# Creators
# ============================================================================

routine SecureDict[K, V].$create() -> SecureDict[K, V]
  return SecureDict[K, V](key: SecureHashKey.random())

routine SecureDict[K, V].$create(key: SecureHashKey) -> SecureDict[K, V]
  var cap = SECURE_DICT_INITIAL_CAPACITY
  var ecap = SECURE_DICT_INITIAL_ENTRIES
  var dict = SecureDict[K, V](
    ctrl: hijacked_none[U8](),
    indices: hijacked_none[U64](),
    keys: hijacked_none[K](),
    vals: hijacked_none[V](),
    entry_live: hijacked_none[U8](),
    count: 0u64,
    deleted: 0u64,
    entries_used: 0u64,
    capacity: cap,
    entries_cap: ecap,
    k0: key.k0,
    k1: key.k1
  )
  danger!
    dict.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](dict.ctrl), value: CTRL_EMPTY, size: cap)
    dict.indices = Hijacked[U64](rf_allocate_dynamic_uninit(U64.data_size() * cap))
    dict.keys = hijacked_from[K](rf_allocate_dynamic_uninit(K.data_size() * ecap))
    dict.vals = hijacked_from[V](rf_allocate_dynamic_uninit(V.data_size() * ecap))
    dict.entry_live = Hijacked[U8](rf_allocate_dynamic_uninit(ecap))
  return dict

routine SecureDict[K, V].$create(key: SecureHashKey, capacity: U64) -> SecureDict[K, V]
  var cap = SECURE_DICT_INITIAL_CAPACITY
  while cap < capacity
    cap = cap *% 2u64
  var ecap = SECURE_DICT_INITIAL_ENTRIES
  while ecap < capacity
    ecap = ecap *% 2u64
  var dict = SecureDict[K, V](
    ctrl: hijacked_none[U8](),
    indices: hijacked_none[U64](),
    keys: hijacked_none[K](),
    vals: hijacked_none[V](),
    entry_live: hijacked_none[U8](),
    count: 0u64,
    deleted: 0u64,
    entries_used: 0u64,
    capacity: cap,
    entries_cap: ecap,
    k0: key.k0,
    k1: key.k1
  )
  danger!
    dict.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](dict.ctrl), value: CTRL_EMPTY, size: cap)
    dict.indices = Hijacked[U64](rf_allocate_dynamic_uninit(U64.data_size() * cap))
    dict.keys = hijacked_from[K](rf_allocate_dynamic_uninit(K.data_size() * ecap))
    dict.vals = hijacked_from[V](rf_allocate_dynamic_uninit(V.data_size() * ecap))
    dict.entry_live = Hijacked[U8](rf_allocate_dynamic_uninit(ecap))
  return dict

routine SecureDict[K, V].$destroy()
  danger!
    if not me.ctrl.is_none()
      rf_invalidate(pointer_to_int[U8, Address](me.ctrl))
    if not me.indices.is_none()
      rf_invalidate(pointer_to_int[U64, Address](me.indices))
    if not me.keys.is_none()
      rf_invalidate(pointer_to_int[K, Address](me.keys))
    if not me.vals.is_none()
      rf_invalidate(pointer_to_int[V, Address](me.vals))
    if not me.entry_live.is_none()
      rf_invalidate(pointer_to_int[U8, Address](me.entry_live))
  return

# ============================================================================
# Internal Helpers
# ============================================================================

@readonly
routine SecureDict[K, V].h2(hash: U64) -> U8
  return U8(hash & U64(CTRL_H2_MASK))

@readonly
routine SecureDict[K, V].h1(hash: U64) -> U64
  return hash >> 7u32

@readonly
routine SecureDict[K, V].read_index(slot: U64) -> U64
  danger!
    return me.indices.offset(U64.data_size() * slot).extract()

@readonly
routine SecureDict[K, V].read_key_at(ei: U64) -> K
  danger!
    return me.keys.offset(K.data_size() * ei).extract()

@readonly
routine SecureDict[K, V].read_val_at(ei: U64) -> V
  danger!
    return me.vals.offset(V.data_size() * ei).extract()

routine SecureDict[K, V].write_val_at(ei: U64, val: V)
  danger!
    me.vals.offset(V.data_size() * ei).inject(val)
  return

@readonly
routine SecureDict[K, V].find_slot(key: K) -> U64
  var h = key.$secure_hash(k0: me.k0, k1: me.k1)
  var target = me.h2(h)
  var mask = me.capacity -% 1u64
  var i = me.h1(h) & mask
  danger!
    loop
      var c = me.ctrl.offset(i).extract()
      if c == CTRL_EMPTY
        return me.capacity
      if c == target
        var ei = me.indices.offset(U64.data_size() * i).extract()
        if me.keys.offset(K.data_size() * ei).extract() == key
          return i
      i = (i +% 1u64) & mask
  return me.capacity

routine SecureDict[K, V].insert_index_raw(h: U64, entry_index: U64)
  var h2_val = me.h2(h)
  var mask = me.capacity -% 1u64
  var i = me.h1(h) & mask
  danger!
    loop
      var c = me.ctrl.offset(i).extract()
      if c == CTRL_EMPTY
        me.ctrl.offset(i).inject(h2_val)
        me.indices.offset(U64.data_size() * i).inject(entry_index)
        return
      if c == CTRL_TOMBSTONED
        me.ctrl.offset(i).inject(h2_val)
        me.indices.offset(U64.data_size() * i).inject(entry_index)
        me.deleted = me.deleted -% 1u64
        return
      i = (i +% 1u64) & mask
  return

@readonly
routine SecureDict[K, V].should_rehash() -> Bool
  if (me.count +% me.deleted) *% 8u64 >= me.capacity *% 7u64
    return true
  if me.entries_used >= me.entries_cap
    return true
  return false

@migratable
routine SecureDict[K, V].rehash()
  var old_cap = me.capacity
  var old_ecap = me.entries_cap
  var old_ctrl = me.ctrl
  var old_indices = me.indices
  var old_keys = me.keys
  var old_vals = me.vals
  var old_entry_live = me.entry_live
  var old_entries_used = me.entries_used

  var table_pressured = (me.count +% me.deleted) *% 8u64 >= old_cap *% 7u64
  var new_cap = old_cap
  if table_pressured
    new_cap = old_cap *% 2u64

  var new_ecap = old_ecap
  if me.count *% 2u64 >= old_ecap
    new_ecap = old_ecap *% 2u64

  danger!
    me.ctrl = Hijacked[U8](rf_allocate_dynamic_uninit(new_cap))
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](me.ctrl), value: CTRL_EMPTY, size: new_cap)
    me.indices = Hijacked[U64](rf_allocate_dynamic_uninit(U64.data_size() * new_cap))
    me.keys = hijacked_from[K](rf_allocate_dynamic_uninit(K.data_size() * new_ecap))
    me.vals = hijacked_from[V](rf_allocate_dynamic_uninit(V.data_size() * new_ecap))
    me.entry_live = Hijacked[U8](rf_allocate_dynamic_uninit(new_ecap))
  me.capacity = new_cap
  me.entries_cap = new_ecap
  me.count = 0u64
  me.deleted = 0u64
  me.entries_used = 0u64

  var i = 0u64
  while i < old_entries_used
    danger!
      var live = old_entry_live.offset(i).extract()
      if live == ENTRY_LIVE
        var k = old_keys.offset(K.data_size() * i).extract()
        var v = old_vals.offset(V.data_size() * i).extract()
        var new_ei = me.entries_used
        me.keys.offset(K.data_size() * new_ei).inject(k)
        me.vals.offset(V.data_size() * new_ei).inject(v)
        me.entry_live.offset(new_ei).inject(ENTRY_LIVE)
        me.entries_used = me.entries_used +% 1u64
        me.insert_index_raw(h: k.$secure_hash(k0: me.k0, k1: me.k1), entry_index: new_ei)
        me.count = me.count +% 1u64
    i = i +% 1u64

  danger!
    if not old_ctrl.is_none()
      rf_invalidate(pointer_to_int[U8, Address](old_ctrl))
    if not old_indices.is_none()
      rf_invalidate(pointer_to_int[U64, Address](old_indices))
    if not old_keys.is_none()
      rf_invalidate(pointer_to_int[K, Address](old_keys))
    if not old_vals.is_none()
      rf_invalidate(pointer_to_int[V, Address](old_vals))
    if not old_entry_live.is_none()
      rf_invalidate(pointer_to_int[U8, Address](old_entry_live))
  return

# ============================================================================
# Core Operations
# ============================================================================

@readonly
routine SecureDict[K, V].count() -> U64
  return me.count

@readonly
routine SecureDict[K, V].is_empty() -> Bool
  return me.count == 0u64

routine SecureDict[K, V].clear()
  danger!
    rf_set_bytes_at(dest: pointer_to_int[U8, Address](me.ctrl), value: CTRL_EMPTY, size: me.capacity)
  me.count = 0u64
  me.deleted = 0u64
  me.entries_used = 0u64
  return

@readonly
routine SecureDict[K, V].$contains(key: K) -> Bool
  return me.find_slot(key) < me.capacity

routine SecureDict[K, V].add(key: K, value: V) -> Bool
  if me.should_rehash()
    me.rehash()
  var slot = me.find_slot(key)
  if slot < me.capacity
    var existing_ei = me.read_index(slot)
    me.write_val_at(ei: existing_ei, val: value)
    return false
  var ei = me.entries_used
  danger!
    me.keys.offset(K.data_size() * ei).inject(key)
    me.vals.offset(V.data_size() * ei).inject(value)
    me.entry_live.offset(ei).inject(ENTRY_LIVE)
  me.entries_used = me.entries_used +% 1u64
  me.insert_index_raw(h: key.$secure_hash(k0: me.k0, k1: me.k1), entry_index: ei)
  me.count = me.count +% 1u64
  return true

routine SecureDict[K, V].remove(key: K) -> Bool
  var slot = me.find_slot(key)
  if slot >= me.capacity
    return false
  var ei = me.read_index(slot)
  danger!
    me.ctrl.offset(slot).inject(CTRL_TOMBSTONED)
    me.entry_live.offset(ei).inject(ENTRY_DEAD)
  me.count = me.count -% 1u64
  me.deleted = me.deleted +% 1u64
  return true

@readonly
routine SecureDict[K, V].get_or_default(key: K, default_value: V) -> V
  var slot = me.find_slot(key)
  if slot >= me.capacity
    return default_value
  return me.read_val_at(me.read_index(slot))

# ============================================================================
# Indexing
# ============================================================================

@readonly
routine SecureDict[K, V].$getitem!(key: K) -> V
  var slot = me.find_slot(key)
  if slot >= me.capacity
    absent
  return me.read_val_at(me.read_index(slot))

routine SecureDict[K, V].$setitem!(key: K, value: V)
  if key notin me
    absent
  var slot = me.find_slot(key)
  me.write_val_at(ei: me.read_index(slot), val: value)
  return

# ============================================================================
# Iteration
# ============================================================================

@readonly
routine SecureDict[K, V].$iter() -> SecureDictIterator[K, V]
  danger!
    return SecureDictIterator[K, V](
      keys: me.keys,
      vals: me.vals,
      entry_live: me.entry_live,
      entries_used: me.entries_used,
      pos: 0u64
    )

### Iterator that walks the dense entries array of a {SecureDict[K, V]} in insertion order.
entity SecureDictIterator[K, V] obeys Iterator[DictEntry[K, V]]
  secret keys: Hijacked[K]
  secret vals: Hijacked[V]
  secret entry_live: Hijacked[U8]
  secret entries_used: U64
  secret pos: U64

routine SecureDictIterator[K, V].$next!() -> DictEntry[K, V]
  danger!
    while me.pos < me.entries_used
      var p = me.pos
      me.pos = me.pos + 1u64
      if me.entry_live.offset(p).extract() == ENTRY_LIVE
        var k = me.keys.offset(K.data_size() * p).extract()
        var v = me.vals.offset(V.data_size() * p).extract()
        return DictEntry[K, V](key: k, value: v)
  absent

# ============================================================================
# Display
# ============================================================================

@readonly
routine SecureDict[K, V].$represent() -> Text
  if me.is_empty()
    return "{:}"
  var result = "{"
  var first = true
  for entry in me
    if not first
      result = result + ", "
    result = result + entry.key.$represent() + ": " + entry.value.$represent()
    first = false
  result = result + "}"
  return result

@readonly
routine SecureDict[K, V].$diagnose() -> Text
  var result = me.type_name() + "(count: " + me.count().$represent() + ", {"
  var first = true
  for entry in me
    if not first
      result = result + ", "
    result = result + entry.key.$represent() + ": " + entry.value.$represent()
    first = false
  result = result + "})"
  return result

# ============================================================================
# Comparison
# ============================================================================

@readonly
routine SecureDict[K, V].$eq(other: SecureDict[K, V]) -> Bool
  if me.count != other.count
    return false
  var i = 0u64
  while i < me.entries_used
    danger!
      if me.entry_live.offset(i).extract() == ENTRY_LIVE
        var k = me.keys.offset(K.data_size() * i).extract()
        var v = me.vals.offset(V.data_size() * i).extract()
        var slot = other.find_slot(k)
        if slot >= other.capacity
          return false
        var other_ei = other.indices.offset(U64.data_size() * slot).extract()
        var other_v = other.vals.offset(V.data_size() * other_ei).extract()
        if v != other_v
          return false
    i = i +% 1u64
  return true
